# Godot
.godot/
*.import

# C# / .NET
.mono/
data_*/
mono_crash.*.json
*.user
.vs/
bin/
obj/

# Local Obsidian AI transcript exports
AI Chats/

# Oversized GLB (exceeds GitHub 100MB limit) — keep on disk, out of git
assets/all_dmc2_swords_remade.glb

# Build artifacts — exported binaries and node deps should never be committed
build/
*.exe
*.pck
server/node_modules/

# Original un-decimated Tripo3D prop GLBs (~626MB, ~1.4M tris each). Kept on
# disk as the regeneration-free source for re-decimation (they cost credits),
# but never committed and never imported by Godot (see the .gdignore inside).
assets/glb/props_hires/

# Python bytecode from the godogen skill tools
__pycache__/
*.pyc

# Exported builds and distributable archives. Regenerated by the export, and
# individually far past GitHub's 100MB hard limit (Corners.exe is 756MB,
# Corners-Windows.zip is 513MB) — they cannot be pushed even if committed.
builds/
*.zip

# QA capture frames — ~1.5GB across 3000+ per-task screenshots and .wav movie
# sidecars. Every one is regenerated on demand by its test harness, and
# CLAUDE.md already describes this directory as throwaway.
screenshots/

# Scratch copies of Godot's imported .scn files kept during an asset recovery.
# Regenerated by a reimport; nothing here is a source of truth.
recovery/
