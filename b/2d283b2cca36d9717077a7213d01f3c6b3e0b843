using Godot;
using System;
using System.Reflection;
using System.Threading.Tasks;

/// test/TestOnlineFlow.cs
/// Two-client end-to-end check of the online flow over a REAL relay: lobby
/// maze-pick sync, doorway signs (author + live occupant), rematch.
///
/// Run a relay, then two instances (throwaway accounts — writes maze slot 3):
///   PORT=3137 node server/relay.js
///   ..._console.exe --path . --headless res://test/TestOnlineFlow.tscn --account __test_online_host   --relay ws://localhost:3137 --role host
///   ..._console.exe --path . --headless res://test/TestOnlineFlow.tscn --account __test_online_client --relay ws://localhost:3137 --role client
///
/// The host challenges, so the relay makes it the room host. The client
/// enters the pre-game lobby 1.5 s late (a slower machine) — that is the case
/// where its opponent's first maze pick used to be dropped.
///
/// The driver parks itself on the tree root so it survives every
/// ChangeSceneToFile, and drives the real scenes through their own handlers.
public partial class TestOnlineFlow : Node
{
    const int    TestSlot   = 3;
    const double TimeoutSec = 150;

    bool   _isHost;
    string[] args = System.Array.Empty<string>();
    int    _fail;
    string _me = "";
    NetworkManager _nm = null!;

    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + $"[{(_isHost ? "host" : "client")}] " + label);
        if (!ok) _fail++;
    }

    public override void _Ready()
    {
        if (!AccountManager.ActiveAccount.StartsWith("__test_online"))
        {
            GD.PushError("Refusing to run: pass --account __test_online_host / __test_online_client");
            GetTree().Quit(2);
            return;
        }
        args = OS.GetCmdlineArgs();
        for (int i = 0; i < args.Length - 1; i++)
            if (args[i] == "--role") _isHost = args[i + 1] == "host";

        // Survive scene changes: move to the root beside the current scene.
        CallDeferred(nameof(Detach));
    }

    void Detach()
    {
        var root = GetTree().Root;
        GetParent().RemoveChild(this);
        root.AddChild(this);
        _ = Run();
    }

    async Task Run()
    {
        var watchdog = GetTree().CreateTimer(TimeoutSec);
        watchdog.Timeout += () => { GD.PrintErr("TIMEOUT"); GetTree().Quit(3); };

        PlayerProfile.Load();
        _me = OnlineGameState.PlayerName;
        var test = DefaultMaze.Build();
        test.Name = $"{_me} test maze";
        MazeSerializer.Save(TestSlot, test);
        OnlineGameState.SelectedMazeSlot = DefaultMaze.SentinelSlot;

        _nm = GetNode<NetworkManager>("/root/NetworkManager");

        // ── Matchmaking ────────────────────────────────────────────────────
        bool made = false, challenged = false;
        _nm.MatchMade += _ => made = true;
        _nm.IncomingChallenge += (from, _) => _nm.RespondChallenge(from, true);
        _nm.LobbyUpdated += json =>
        {
            if (!_isHost || challenged) return;
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            foreach (var p in doc.RootElement.GetProperty("players").EnumerateArray())
            { challenged = true; _nm.SendChallenge(p.GetProperty("id").GetString()!); break; }
        };
        if (!_isHost) await Wait(0.5);   // host first in the lobby is not required, just tidy
        _nm.ConnectAndJoinLobby(_me);
        await Until(() => made, "match_made");
        Check(OnlineGameState.IsHost == _isHost, $"relay role matches ({OnlineGameState.IsHost})");

        // ── Pre-game lobby: maze pick sync ─────────────────────────────────
        if (!_isHost) await Wait(1.5);   // slow loader: host's first pick lands before we exist
        GetTree().ChangeSceneToFile("res://scenes/PreGameLobby.tscn");
        await Until(() => GetTree().CurrentScene is PreGameLobby, "lobby scene");
        var lobby = (PreGameLobby)GetTree().CurrentScene;
        // Both lobbies are up once the opponent's name has arrived (intro).
        var remoteName = Field<Label>(lobby, "_remoteNameLabel");
        await Until(() => remoteName.Text != "Connecting…", "opponent intro");
        await Wait(0.5);
        var remoteMaze = Field<Label>(lobby, "_remoteMazeLabel");
        string expectInitial = DefaultMaze.DisplayName;
        Check(remoteMaze.Text == expectInitial,
              $"opponent's initial pick visible without anyone touching the picker ('{remoteMaze.Text}')");

        // Client changes its pick; host must see it live.
        if (!_isHost)
        {
            await Wait(1.5);   // after the host's initial-pick check above
            var dd = Field<OptionButton>(lobby, "_mazeDropdown");
            int idx = -1;
            for (int i = 0; i < dd.ItemCount; i++) if (dd.GetItemId(i) == TestSlot) idx = i;
            Check(idx >= 0, "test maze listed in own picker");
            dd.Select(idx);
            dd.EmitSignal(OptionButton.SignalName.ItemSelected, (long)idx);
        }
        if (_isHost)
        {
            await Until(() => remoteMaze.Text.Contains("test maze"), "opponent's pick change", limit: 5);
            Check(remoteMaze.Text.Contains($"Slot {TestSlot}"), $"opponent's pick change shows live ('{remoteMaze.Text}')");
        }
        await Wait(0.5);

        Field<Button>(lobby, "_readyBtn").EmitSignal(Button.SignalName.Pressed);
        await Until(() => GetTree().CurrentScene is OnlineDungeonArena, "arena scene");

        // ── Match 1 ────────────────────────────────────────────────────────
        var arena = (OnlineDungeonArena)GetTree().CurrentScene;
        await UntilGo(arena);
        await Wait(1.0);   // zone messages cross
        string host   = _isHost ? _me : OnlineGameState.OpponentName;
        string client = _isHost ? OnlineGameState.OpponentName : _me;
        CheckSigns(arena, "match 1", host, client, aOcc: client, bOcc: host);

        // Live occupant: client steps into the arena gap, then into MazeB.
        var me = Field<PlayerController>(arena, "_localPlayer");
        float midZ = 100f + ArenaBuilder.Apothem;
        if (!_isHost) await Wait(3.0);   // a slower (windowed) host finishes its sign check first
        if (!_isHost) me.GlobalPosition = new Vector3(me.GlobalPosition.X, me.GlobalPosition.Y, midZ);
        await Wait(1.0);
        await CheckOcc(arena, "SignAStart", "nobody", "client left MazeA");
        if (!_isHost) me.GlobalPosition = new Vector3(me.GlobalPosition.X, me.GlobalPosition.Y, midZ + ArenaBuilder.Apothem + 20f);
        await Wait(1.0);
        await CheckOcc(arena, "SignBExit", $"{host} & {client}", "both in MazeB (host view)", hostOnly: true);
        await CheckOcc(arena, "SignBExit", $"{client} & {host}", "both in MazeB (client view)", clientOnly: true);

        int s1 = Field<int>(arena, "_rolledStarterIdx"), a1 = Field<int>(arena, "_rolledArenaIdx");
        GD.Print($"ROLL1 {s1} {a1}");

        // End it: the client dies; host wins.
        if (!_isHost) me.GetNode<PlayerHealth>("PlayerHealth").TakeDamage(1000f, Vector3.Zero);
        await Until(() => Field<Button?>(arena, "_rematchBtn") != null, "end overlay with Rematch");
        Check(_nm.IsOpen, "relay still open on the end screen");

        // Host accepts first; client sees the offer, then accepts.
        var status = Field<Label>(arena, "_rematchStatus");
        if (_isHost)
        {
            Field<Button>(arena, "_rematchBtn").EmitSignal(Button.SignalName.Pressed);
            Check(Field<Button>(arena, "_rematchBtn").Text.StartsWith("Waiting"), "host button shows waiting");
        }
        else
        {
            await Until(() => status.Text.Contains("wants a rematch"), "offer shown to client");
            Check(status.Text == $"{host} wants a rematch", $"client sees '{status.Text}'");
            await Wait(0.5);
            Field<Button>(arena, "_rematchBtn").EmitSignal(Button.SignalName.Pressed);
        }
        ulong t0 = Time.GetTicksMsec();

        // ── Match 2 (rematch) ──────────────────────────────────────────────
        await Until(() => GetTree().CurrentScene is OnlineDungeonArena a && a != arena, "rematch arena");
        var arena2 = (OnlineDungeonArena)GetTree().CurrentScene;
        await Until(() => Field<bool>(arena2, "_countdownStarted"), "rematch countdown");
        double toCountdown = (Time.GetTicksMsec() - t0) / 1000.0;
        Check(Field<int>(arena2, "_clientMazeRetries") == 0,
              $"rematch maze exchange needed no 2 s retry (countdown after {toCountdown:F2}s)");
        await UntilGo(arena2);
        int s2 = Field<int>(arena2, "_rolledStarterIdx"), a2 = Field<int>(arena2, "_rolledArenaIdx");
        GD.Print($"ROLL2 {s2} {a2}");
        Check(s2 != s1 && a2 != a1, $"rematch dealt new guns ({s1},{a1}) → ({s2},{a2})");
        await Wait(1.0);
        CheckSigns(arena2, "rematch", host, client, aOcc: client, bOcc: host);   // same mazes, same authors

        // Optional visual capture (windowed host only): --shot <dir>
        var me2 = Field<PlayerController>(arena2, "_localPlayer");
        string? shotDir = null;
        for (int i = 0; i < args.Length - 1; i++) if (args[i] == "--shot") shotDir = args[i + 1];
        if (_isHost && shotDir != null)
        {
            me2.Frozen = true;
            me2.DebugSetPitch(0.75f);                 // from spawn, up at the Start sign
            await Wait(0.5);
            GetViewport().GetTexture().GetImage().SavePng($"{shotDir}/sign_start.png");
            var exitSign = arena2.GetNode<MazeSign>("SignBExit");
            me2.GlobalPosition = exitSign.GlobalPosition + new Vector3(0f, -MazeSign.HangHeight + 1f, 9f);
            typeof(PlayerController).GetField("_yaw", BindingFlags.NonPublic | BindingFlags.Instance)!
                .SetValue(me2, 0f);                   // face north, out toward the arena
            me2.DebugSetPitch(0.45f);
            await Wait(0.5);
            GetViewport().GetTexture().GetImage().SavePng($"{shotDir}/sign_exit.png");
        }

        // Match 2 ends; host offers again, client walks out → host's offer dies.
        if (!_isHost) { await Wait(5.0); me2.GetNode<PlayerHealth>("PlayerHealth").TakeDamage(1000f, Vector3.Zero); }
        await Until(() => Field<Button?>(arena2, "_rematchBtn") != null, "end overlay 2");
        if (_isHost)
        {
            Field<Button>(arena2, "_rematchBtn").EmitSignal(Button.SignalName.Pressed);
            var st2 = Field<Label>(arena2, "_rematchStatus");
            await Until(() => st2.Text == "Opponent left.", "opponent-left notice");
            Check(Field<Button>(arena2, "_rematchBtn").Disabled, "rematch disabled after opponent left");
        }
        else
        {
            await Wait(1.0);
            // Press "Exit to Menu" — the last button in the overlay.
            var overlay = arena2.GetNode("EndOverlay");
            Button? exit = null;
            foreach (var n in overlay.FindChildren("*", "Button", true, false))
                if (n is Button b && b.Text == "Exit to Menu") exit = b;
            exit!.EmitSignal(Button.SignalName.Pressed);
            await Wait(0.5);
        }

        DirAccess.RemoveAbsolute(ProjectSettings.GlobalizePath(AccountManager.MazeSlotPath(TestSlot)));
        DirAccess.RemoveAbsolute(ProjectSettings.GlobalizePath(AccountManager.ProfilePath()));
        GD.Print(_fail == 0 ? "ALL PASS" : $"{_fail} FAILED");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }

    // ── Checks ─────────────────────────────────────────────────────────────

    void CheckSigns(Node arena, string tag, string host, string client, string aOcc, string bOcc)
    {
        foreach (var (name, author, occ) in new[]
                 {
                     ("SignAStart", "Corners", aOcc), ("SignAExit", "Corners", aOcc),   // host picked the default maze
                     ("SignBStart", client,    bOcc), ("SignBExit", client,    bOcc),   // client's test slot
                 })
        {
            var sign = arena.GetNodeOrNull<MazeSign>(name);
            Check(sign != null, $"{tag}: {name} exists");
            if (sign == null) continue;
            var labels = sign.FindChildren("*", "Label3D", true, false);
            string all = string.Join(" | ", System.Linq.Enumerable.Select(labels, l => ((Label3D)l).Text));
            Check(all.Contains($"Made by {author}") && all.Contains($"Currently in: {occ}"),
                  $"{tag}: {name} reads '{all}'");
        }
    }

    async Task CheckOcc(Node arena, string sign, string expect, string what, bool hostOnly = false, bool clientOnly = false)
    {
        if ((hostOnly && !_isHost) || (clientOnly && _isHost)) return;
        var s = arena.GetNode<MazeSign>(sign);
        var occ = (Label3D)s.FindChildren("*", "Label3D", true, false)[1];
        // The opponent moves on its own clock; wait (bounded) for its zone message.
        double t = 0;
        while (occ.Text != $"Currently in: {expect}" && t < 5) { await Wait(0.1); t += 0.1; }
        string text = ((Label3D)s.FindChildren("*", "Label3D", true, false)[1]).Text;
        Check(text == $"Currently in: {expect}", $"{what}: {sign} '{text}'");
    }

    // ── Plumbing ───────────────────────────────────────────────────────────

    async Task UntilGo(OnlineDungeonArena arena)
    {
        await Until(() => Field<PlayerController?>(arena, "_localPlayer") is PlayerController p && !p.Frozen,
                    "countdown GO");
    }

    static T Field<T>(object o, string name)
    {
        var f = o.GetType().GetField(name, BindingFlags.NonPublic | BindingFlags.Instance)
                ?? throw new MissingFieldException(o.GetType().Name, name);
        return (T)f.GetValue(o)!;
    }

    async Task Wait(double s) => await ToSignal(GetTree().CreateTimer(s), SceneTreeTimer.SignalName.Timeout);

    async Task Until(Func<bool> cond, string what, double limit = 30)
    {
        double t = 0;
        while (!cond())
        {
            await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame);
            t += GetProcessDeltaTime();
            if (t > limit) { Check(false, $"timed out waiting for {what}"); GD.Print($"{_fail} FAILED"); GetTree().Quit(1); await Wait(999); }
        }
    }
}
