using System.Collections.Generic;
using System.Linq;
using Godot;

/// test/TestPlusLayout.cs — per-match hallway sizing and the seat-zone query.
public partial class TestPlusLayout : Node
{
    int _fail;
    void Check(bool ok, string label) { GD.Print((ok ? "PASS  " : "FAIL  ") + label); if (!ok) _fail++; }

    static List<MazeFootprint> Fps(params MazeData[] ms) => ms.Select(MazeFootprint.From).ToList();

    void Case(string name, List<MazeFootprint> fps, int expectCells)
    {
        var r = PlusLayout.Compute(fps, ArenaBuilder.Apothem, margin: 1f);
        Check(r.HallCells == expectCells, $"{name}: hall = {r.HallCells} cells (expected {expectCells})");
        Check(!PlusLayout.Collides(r, 1f), $"{name}: no collision at chosen length");
        if (r.HallCells > 0)
        {
            var shorter = PlusLayout.WithHall(r, r.HallCells - 1);
            Check(PlusLayout.Collides(shorter, 1f), $"{name}: one cell shorter DOES collide (minimal)");
        }
        // Exit cell centre sits on its door axis at apothem + L + half a cell.
        foreach (var s in r.Seats)
        {
            var u = PlusLayout.DoorDir(s.Door);
            var exitCentre = s.Offset + new Vector3((s.Rotated.ExitX + 0.5f) * 10f, 0f, (s.Rotated.ExitY + 0.5f) * 10f);
            var want = u * (ArenaBuilder.Apothem + r.HallLength + 5f);
            Check(new Vector2(exitCentre.X - want.X, exitCentre.Z - want.Z).Length() < 0.01f,
                  $"{name}: seat {s.Door} exit centred on its door axis");
        }
    }

    public override void _Ready()
    {
        Check(PlusLayout.DoorsFor(2).SequenceEqual(new[] { Door.N, Door.S }), "2 seats → N,S");
        Check(PlusLayout.DoorsFor(3).SequenceEqual(new[] { Door.N, Door.E, Door.W }), "3 seats → N,E,W");
        Check(PlusLayout.DoorsFor(4).SequenceEqual(new[] { Door.N, Door.E, Door.S, Door.W }), "4 seats → N,E,S,W");

        var S = (System.Func<int, MazeData>)(c => FfaFixtures.Slab(c));
        Case("worst 0/9/0/9",          Fps(S(0), S(9), S(0), S(9)), 7);
        Case("all col 0 (C4-symmetric)", Fps(S(0), S(0), S(0), S(0)), 0);
        Case("central all 4",          Fps(S(4), S(4), S(4), S(4)), 2);
        Case("central 4/5/4/5",        Fps(S(4), S(5), S(4), S(5)), 3);
        Case("mixed 0/4/9/5",          Fps(S(0), S(4), S(9), S(5)), 3);
        Case("T worst 0/9/9",          Fps(S(0), S(9), S(9)), 7);
        Case("T central 4/4/4",        Fps(S(4), S(4), S(4)), 2);
        Case("2 seats forced 0",       Fps(S(0), S(9)), 0);
        // Vertical separation: E/W slabs two floors up clear N/S entirely…
        Case("worst but E/W two floors up", Fps(S(0), FfaFixtures.Slab(9, 0, 2), S(0), FfaFixtures.Slab(9, 0, 2)), 0);
        // …but ONE floor up still touches (ceiling vault meets floor) → full hall.
        Case("worst but E/W one floor up",  Fps(S(0), FfaFixtures.Slab(9, 0, 1), S(0), FfaFixtures.Slab(9, 0, 1)), 7);

        // Seat zones
        var z = PlusLayout.Compute(Fps(S(0), S(9), S(0), S(9)), ArenaBuilder.Apothem, 1f);
        Check(z.MazeAt(new Vector3(0f, 1f, 0f)) == -1, "arena centre → -1");
        for (int i = 0; i < 4; i++)
        {
            var s = z.Seats[i]; var u = PlusLayout.DoorDir(s.Door);
            Check(z.MazeAt(u * (ArenaBuilder.Apothem + z.HallLength * 0.5f) + Vector3.Up) == i, $"seat {i} hallway midpoint → {i}");
            Check(z.MazeAt(u * (ArenaBuilder.Apothem + z.HallLength + 50f) + Vector3.Up) == i, $"seat {i} maze interior → {i}");
        }
        Check(z.MazeAt(new Vector3(0f, 500f, 0f)) == -1, "far above → -1");

        // (a) Exit on a non-zero floor
        {
            var fx = (System.Func<int, MazeData>)(c => FfaFixtures.Slab(c, exitFloor: 2, slabFloor: 2));
            var r = PlusLayout.Compute(Fps(fx(0), fx(9), fx(0), fx(9)), ArenaBuilder.Apothem, 1f);
            for (int i = 0; i < 4; i++)
                Check(Mathf.Abs(r.Seats[i].Offset.Y - (-36f)) < 0.01f, $"exit floor 2: seat {i} Offset.Y = {r.Seats[i].Offset.Y}");
            Check(r.HallCells == 7, $"exit floor 2: hall = {r.HallCells} (expected 7)");
            var off = r.Seats[0].Offset;
            Vector3 Cell(int gx, int gy, float y) => new Vector3(off.X + (gx + 0.5f) * 10f, y, off.Z + (gy + 0.5f) * 10f);
            Check(r.MazeAt(Cell(5, 5, 1f)) == 0, "exit floor 2: N maze body at y=1 (maze floor 2) → 0");
            Check(r.MazeAt(Cell(4, 0, -35f)) == 0, "exit floor 2: Start column at y=-35 (maze floor 0) → 0");
            Check(r.MazeAt(Cell(5, 5, -35f)) == -1, "exit floor 2: non-Start column at y=-35 → -1");
        }

        // (b) Door plane belongs to its seat
        for (int i = 0; i < 4; i++)
        {
            var u = PlusLayout.DoorDir(z.Seats[i].Door);
            Check(z.HallCells > 0 && z.MazeAt(u * ArenaBuilder.Apothem + Vector3.Up) == i, $"door plane seat {i} → {i}");
        }

        // (c) Irregular L-shaped maze: bounding square is not the footprint
        {
            var l = new MazeData { Name = "L", IsOnline = false };
            l.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 4, Y = 0, Floor = 0, Rotation = 0 });
            l.Pieces.Add(new MazePiece { Type = PieceType.Exit, X = 0, Y = 9, Floor = 0, Rotation = 0 });
            for (int y = 0; y < 9; y++) l.Pieces.Add(new MazePiece { Type = PieceType.Room, X = 0, Y = y, Floor = 0, RoomGroup = 1 });
            for (int x = 1; x < 10; x++) l.Pieces.Add(new MazePiece { Type = PieceType.Room, X = x, Y = 9, Floor = 0, RoomGroup = 1 });
            var r = PlusLayout.Compute(Fps(l, FfaFixtures.Slab(9), FfaFixtures.Slab(9), FfaFixtures.Slab(9)), ArenaBuilder.Apothem, 1f);
            var off = r.Seats[0].Offset;
            var mid = new Vector3(off.X + 5.5f * 10f, 1f, off.Z + 5.5f * 10f);   // grid cell (5,5) centre
            Check(r.MazeAt(mid) == -1, "L maze: bounding-square interior outside columns → -1");
        }

        GD.Print(_fail == 0 ? "ALL PASS" : $"{_fail} FAILED");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
