using Godot;
using System.Collections.Generic;

/// res://scripts/PieceVariants.cs
/// Deterministic per-piece visual variants. Applied AFTER DungeonBuilder
/// builds each cell: swaps mesh materials and adds decorative child nodes.
/// NEVER touches piece geometry or collision (fragile — see CLAUDE.md).
/// Determinism: both multiplayer clients hold identical MazeData, so a pure
/// hash of piece fields yields identical variants with no shared seed.
public partial class PieceVariants : Node
{
    public const int VariantCount = 4;

    // FNV-1a — stable across runs and machines (never use GetHashCode here).
    public static int Fnv(params int[] values)
    {
        unchecked
        {
            uint h = 2166136261;
            foreach (int v in values) { h ^= (uint)v; h *= 16777619; }
            return (int)(h & 0x7FFFFFFF);
        }
    }

    public static int VariantIndex(MazePiece p, int count, int salt = 0)
        => Fnv(p.X, p.Y, p.Floor, (int)p.Type, p.Rotation, salt) % count;

    /// Entry point — called once from DungeonBuilder.Build. `torchByCell` is
    /// DungeonBuilder's light-lookup dictionary (read by TorchSignalSystem and
    /// VisualFlair): AddSconces registers each cell's lit sconce light into it
    /// so sconces act as the primary corridor light source (Polish Pass Task 2)
    /// — DungeonBuilder.AddTorches only fills in a dim fallback for cells that
    /// end up with no lit sconce (e.g. open 4-way crossings with no closed wall
    /// to mount one on, or an unlucky run of unlit rolls).
    public static void Apply(Node3D builder, IEnumerable<MazePiece> pieces,
        Dictionary<(int X, int Y, int Floor), OmniLight3D> torchByCell)
    {
        foreach (var p in pieces)
        {
            var body = builder.GetNodeOrNull<StaticBody3D>($"Cell_{p.X}_{p.Y}_{p.Floor}");
            if (body == null) continue;
            int v = VariantIndex(p, VariantCount);
            ApplyVariant(builder, body, p, v, torchByCell);
        }
    }

    /// Task 3 adds rug-runner decor; Task 4/6 extend this with further material
    /// sets and props keyed off `variant`.
    static void ApplyVariant(Node3D builder, StaticBody3D body, MazePiece p, int variant,
        Dictionary<(int X, int Y, int Floor), OmniLight3D> torchByCell)
    {
        // ── Room/Pit geometry guard ──────────────────────────────────────────
        // Cell_{x}_{y}_{floor} naming (see Apply's lookup above) is shared by
        // every piece type, but PitBuilder/RoomBuilder build geometry that
        // doesn't match what the decor functions below assume about a "cell":
        //
        //   Pit (PieceDB.IsMultiCell): one MazePiece represents a whole 3x3
        //   shaft, stored at the shaft's CENTRE cell on its ANCHOR floor
        //   (p.X/p.Y/p.Floor). PitBuilder only puts a floor slab at the
        //   shaft's BOTTOM occupied floor (see PitBuilder.Build's `f ==
        //   botFloor` check) — the anchor floor is usually one level above
        //   that: open shaft, nothing underneath. Every function below
        //   positions props relative to p.X/p.Y/p.Floor, so anything placed
        //   here (rug, dropped clutter) hangs in mid-air over the shaft —
        //   confirmed via capture. Skip entirely.
        //
        //   Room: unlike Pit, the per-piece body DOES line up 1:1 with real
        //   floor geometry (RoomBuilder emits exactly one body per room cell,
        //   at that cell's own floor height), so floor-anchored decor below
        //   (AddRugSlab, AddClutterProps' floor-drop branch) stays on and
        //   lands correctly. But PieceDB.GetOpenings(Room, _) always reports
        //   all four directions open (see BaseOpenings) — a fiction used
        //   elsewhere for connectivity matching, NOT what RoomBuilder actually
        //   built (real walls sit only on the room GROUP's outer boundary,
        //   computed per-cell by RoomGroup/HasCorridorThrough, never consulted
        //   here). Wall-anchored decor (sconces, corner props, mid-corridor
        //   prop, coffer beams) reads "all open" as "no wall anywhere to
        //   mount on" and already no-ops as a result today — skip it
        //   explicitly so that stays true even if a future change makes
        //   GetOpenings Room-instance-aware instead of a static per-type
        //   table. (AddManorFurniture/AddPaintings are already restricted to
        //   PieceType.Straight, so Room never reaches them regardless.)
        if (PieceDB.IsMultiCell(p.Type)) return;

        // Trapdoor's floor — and, once triggered, the fake hatch standing in for
        // it — can vanish out from under floor-anchored decor placed here.
        // TrapBehaviours.AddTrapdoor only knows how to hide DungeonBuilder's own
        // "Floor_X_Y" mesh, and it runs (from BuildFloor) BEFORE this method, so
        // it can never retroactively find decor Apply adds afterward. A rug, or
        // AddMidCorridorProp's floor-standing LIT candelabra, would be left
        // hovering over the hole once the hatch drops — and a lit candelabra in
        // the middle of the corridor would also give the "looks like ordinary
        // floor" bluff away well before that. Skip both for TrapDoor; everything
        // else here is wall/ceiling-anchored (unaffected by the floor vanishing)
        // or, for AddClutterProps' dropped items, physics-driven — it falls
        // through with the player instead of floating.
        bool skipFloorDecor = p.Type == PieceType.TrapDoor;
        if (!skipFloorDecor) AddRugSlab(body, p, variant);
        if (p.Type != PieceType.Room)
        {
            AddCofferBeams(body, p, variant);
            // Darkness Zone deliberately gets no light — a sconce here would
            // relight a cell DungeonBuilder.AddTorches already leaves dark on
            // purpose (see that method's matching guard on PieceType.TrapDark).
            if (p.Type != PieceType.TrapDark) AddSconces(body, p, variant, torchByCell);
            AddCornerProps(body, p, variant);
            // Same reasoning as the AddSconces guard above, and a separate bug
            // from the TrapDoor case skipFloorDecor already covers: on a
            // variant==1 roll AddMidCorridorProp spawns PropLibrary.Instance(
            // "candelabra_a", withLight: true) — a REAL light — on any straight
            // N|S/E|W corridor, and TrapDark IS one (PieceDB fixes it to
            // Dir.N|Dir.S). Left unguarded, ~1-in-4 Darkness Zone cells got a
            // lit candelabra standing in the middle of the cell it's supposed
            // to make unreadable. AddRugSlab above is intentionally left
            // unguarded for TrapDark: a rug carries no light of its own and is
            // just as invisible in the dark as the floor mesh underneath it.
            if (!skipFloorDecor && p.Type != PieceType.TrapDark) AddMidCorridorProp(body, p, variant);
        }
        var furniture = AddManorFurniture(body, p, variant);
        AddPaintings(body, p, variant, furniture.WallUsed);
        AddClutterProps(body, p, variant, furniture.TableTop);
    }

    // ── Knockable clutter: books/goblets/pots, physics-driven (Task 9) ──────
    // GLB-gated like the other PropLibrary.Instance callers — PhysicsProp.Spawn
    // returns null when assets/glb/props is empty, so this silently adds
    // nothing until Task 5's asset pipeline unblocks it.
    //
    // Task 7 (Polish) rework — playtest: "the items don't make much sense"
    // (clutter floating/scattered on bare floor with no reason to be there).
    // When this piece got a table (AddManorFurniture), clutter now rides the
    // tabletop instead: same clutter set, positioned within the table's
    // measured footprint so it reads as "someone left their stuff on the
    // table," not random floor litter. Pieces WITHOUT a table keep only a
    // rare "dropped item" floor spawn (was: 0-2 items on every non-stair
    // cell, unconditionally) — cutting that default is most of the fix.
    static void AddClutterProps(StaticBody3D body, MazePiece p, int variant, TableTopInfo? tableTop)
    {
        if (PieceDB.IsStair(p.Type)) return;
        string[] clutter = { "clutter_bookstack", "clutter_goblet", "clutter_pot" };

        if (tableTop.HasValue)
        {
            var t = tableTop.Value;
            int count = 1 + Fnv(p.X, p.Y, p.Floor, 21) % 2;    // 1..2 items on the table
            for (int i = 0; i < count; i++)
            {
                string prop = clutter[Fnv(p.X, p.Y, i, 22) % clutter.Length];
                // Offsets stay within 50% of the table's own half-extents so
                // a clutter item's own footprint (~0.15m radius) never tips
                // over the tabletop edge.
                float ox = ((Fnv(p.X, p.Y, i, 23) % 100) / 100f * 2f - 1f) * t.HalfOutward * 0.5f;
                float oz = ((Fnv(p.X, p.Y, i, 24) % 100) / 100f * 2f - 1f) * t.HalfTangent * 0.5f;
                var pos = t.Center + t.Outward * ox + t.Tangent * oz + Vector3.Up * 0.08f;
                var prop3d = PhysicsProp.Spawn(prop, pos);
                if (prop3d != null) body.AddChild(prop3d);
            }
            return;
        }

        // No table this piece — rare dropped-item floor spawn only.
        bool dropped = Fnv(p.X, p.Y, p.Floor, 25) % 100 < 12;   // ~12% of cells
        if (!dropped) return;
        float cs2 = DungeonBuilder.CellSize;
        string dprop = clutter[Fnv(p.X, p.Y, p.Floor, 26) % clutter.Length];
        float dox = (Fnv(p.X, p.Y, 0, 27) % 100) / 100f * 3f - 1.5f;
        float doz = (Fnv(p.X, p.Y, 0, 28) % 100) / 100f * 3f - 1.5f;
        var dprop3d = PhysicsProp.Spawn(dprop,
            new Vector3(p.X * cs2 + cs2 * 0.5f + dox,
                        p.Floor * DungeonBuilder.FloorHeight + 0.4f,
                        p.Y * cs2 + cs2 * 0.5f + doz));
        if (dprop3d != null) body.AddChild(dprop3d);
    }

    // ══════════════════════════════════════════════════════════════════════
    //  MANOR FURNITURE — Task 7 (Polish). Tables + collidable corridor
    //  bookshelves, deterministically placed against closed walls.
    //
    //  Scope cut: restricted to PieceType.Straight only (not corners/
    //  junctions). A Straight piece's two closed side walls run its full
    //  CellSize (10m) length — see DungeonBuilder.AddPiece's NSWall/EWWall +
    //  CapWallNS/CapWallEW calls, which together tile the arm side walls and
    //  the centre-square cap into one continuous 10m plane per closed
    //  direction. That gives enough room to offset furniture away from both
    //  the sconce mounted dead-centre on the same wall (AddSconces) and the
    //  openings 5m from centre (clearance rule: >=1.5m from any opening). A
    //  corner (LHall) piece's closed walls are only the 6m centre-square
    //  stub — already shared with a corner plant (AddCornerProps, variant 0)
    //  and its own sconce — too little room to add furniture without a real
    //  risk of overlap. Junctions (THall/Cross) and stairs get nothing per
    //  the clearance rule; Start/Exit are doorway cells. See
    //  .superpowers/sdd/polish-t7-report.md for the full writeup.
    // ══════════════════════════════════════════════════════════════════════

    readonly struct TableTopInfo
    {
        public readonly Vector3 Center;      // world-space table-TOP surface centre
        public readonly Vector3 Outward;     // unit vector, wall-perpendicular (centre -> wall)
        public readonly Vector3 Tangent;     // unit vector, along the wall
        public readonly float HalfOutward;   // safe half-extent for clutter along Outward
        public readonly float HalfTangent;   // safe half-extent for clutter along Tangent
        public TableTopInfo(Vector3 c, Vector3 o, Vector3 t, float ho, float ht)
        { Center = c; Outward = o; Tangent = t; HalfOutward = ho; HalfTangent = ht; }
    }

    readonly struct FurnitureResult
    {
        public readonly TableTopInfo? TableTop;
        public readonly Dir? WallUsed;
        public FurnitureResult(TableTopInfo? t, Dir? w) { TableTop = t; WallUsed = w; }
        public static readonly FurnitureResult None = new(null, null);
    }

    static readonly Dir[] AllDirs = { Dir.N, Dir.S, Dir.E, Dir.W };

    static List<Dir> ClosedDirs(Dir openings)
    {
        var list = new List<Dir>(4);
        foreach (var d in AllDirs) if ((openings & d) == 0) list.Add(d);
        return list;
    }

    static Vector3 OutwardOf(Dir dir) => dir switch
    {
        Dir.N => new Vector3(0, 0, -1), Dir.S => new Vector3(0, 0, 1),
        Dir.E => new Vector3(1, 0, 0),  _     => new Vector3(-1, 0, 0),
    };
    static Vector3 TangentOf(Dir dir) => (dir == Dir.N || dir == Dir.S) ? new Vector3(1, 0, 0) : new Vector3(0, 0, 1);

    static FurnitureResult AddManorFurniture(StaticBody3D body, MazePiece p, int variant)
    {
        if (p.Type != PieceType.Straight) return FurnitureResult.None;   // see class-level doc comment
        bool eligible = Fnv(p.X, p.Y, p.Floor, 30) % 100 < 40;           // ~40% of eligible pieces
        if (!eligible) return FurnitureResult.None;

        var closed = ClosedDirs(PieceDB.GetOpenings(p.Type, p.Rotation));
        if (closed.Count == 0) return FurnitureResult.None;
        Dir dir = closed[Fnv(p.X, p.Y, p.Floor, 31) % closed.Count];
        bool wantBookshelf = Fnv(p.X, p.Y, p.Floor, 32) % 2 == 0;

        if (wantBookshelf)
        {
            AddCorridorBookshelf(body, p, dir);
            return new FurnitureResult(null, dir);
        }
        var top = AddCorridorTable(body, p, dir);
        return top.HasValue ? new FurnitureResult(top, dir) : FurnitureResult.None;
    }

    // Table, backed 5cm off the wall, long raw axis oriented along the wall.
    // Collidable (StaticBody box from the measured+scaled AABB). Returns the
    // tabletop surface info so AddClutterProps can ride items on it.
    static TableTopInfo? AddCorridorTable(StaticBody3D body, MazePiece p, Dir dir)
    {
        // table_b.glb isn't generated yet (Tripo credits ran out mid-task) —
        // falls back to table_a. Forward-compatible: zero changes needed
        // here once table_b lands.
        var node = PropLibrary.Instance("table_b") ?? PropLibrary.Instance("table_a");
        if (node == null) return null;                       // GLBs absent entirely → skip

        // GetLocalAabb walks the node's OWN Transform too (see its doc
        // comment), and PropLibrary.Instance already baked the _scale-table
        // factor into node.Scale before this call — so `aabb` here is
        // ALREADY the final scaled size/offset. Do NOT multiply by scale
        // again (caught via TestFurnitureCollision's [DISCOVER] log printing
        // a visibly-undersized table box — 0.65m instead of the intended
        // 0.75m tall — before this comment/fix landed).
        var aabb = PropLibrary.GetLocalAabb(node);
        if (aabb.Size.X < 0.001f || aabb.Size.Y < 0.001f || aabb.Size.Z < 0.001f) return null;
        float scale = node.Scale.X;   // still needed below, to scale the RAW mesh in the new Transform
        float sizeX = aabb.Size.X, sizeY = aabb.Size.Y, sizeZ = aabb.Size.Z;
        // Raw AABB isn't guaranteed floor-anchored (Tripo3D centres some
        // meshes vertically — table_a's raw Y spans roughly [-0.43,+0.43],
        // not [0,0.86]) — correct so the mesh's lowest point lands exactly
        // at floor height regardless of the source model's local origin.
        float bottomLocalY = aabb.Position.Y;

        float cs = DungeonBuilder.CellSize, half = DungeonBuilder.OpeningW * 0.5f;
        float cx = p.X * cs + cs * 0.5f, cz = p.Y * cs + cs * 0.5f;
        float y0 = p.Floor * DungeonBuilder.FloorHeight;
        Vector3 outward = OutwardOf(dir), tangent = TangentOf(dir);

        // Orient the model's longer raw horizontal axis along the wall
        // (tangent) rather than protruding into the room (brief: "long axis
        // parallel to wall"). table_a's longest raw axis is Z (see
        // PropLibrary._scale comment) but this stays general for whatever
        // table_b eventually measures as.
        bool longAxisIsZ = aabb.Size.Z >= aabb.Size.X;
        float halfAlongWall  = (longAxisIsZ ? sizeZ : sizeX) * 0.5f;
        float halfProtrusion = (longAxisIsZ ? sizeX : sizeZ) * 0.5f;

        // Tangential offset keeps the table clear of both the sconce mounted
        // dead-centre on this wall and the openings 5m from centre (needs
        // >=1.5m clearance — offset 2.0 + halfAlongWall well under 3.5).
        bool sideA = Fnv(p.X, p.Y, p.Floor, (int)dir, 33) % 2 == 0;
        float tangentOffset = (sideA ? 1f : -1f) * 2.0f;
        float outwardOffset = half - 0.05f - halfProtrusion;   // 5cm gap off the wall

        Vector3 basePos = new Vector3(cx, 0, cz) + outward * outwardOffset + tangent * tangentOffset;

        Vector3 basisX = longAxisIsZ ? outward : tangent;
        Vector3 basisZ = basisX.Cross(Vector3.Up);   // guaranteed right-handed companion axis
        node.Transform = new Transform3D(new Basis(basisX * scale, Vector3.Up * scale, basisZ * scale),
            new Vector3(basePos.X, y0 - bottomLocalY, basePos.Z));
        node.AddToGroup("ManorFurnitureVisual");
        body.AddChild(node);

        // Collision: world-axis-aligned box (outward/tangent are always
        // exactly +-X or +-Z since dir is one of N/S/E/W — no rotation
        // needed on the collider itself).
        bool tangentIsX = (dir == Dir.N || dir == Dir.S);
        float extentAlongWall = halfAlongWall * 2f, extentProtrusion = halfProtrusion * 2f;
        Vector3 boxSize = tangentIsX
            ? new Vector3(extentAlongWall, sizeY, extentProtrusion)
            : new Vector3(extentProtrusion, sizeY, extentAlongWall);
        Vector3 boxCenter = new Vector3(basePos.X, y0 + sizeY * 0.5f, basePos.Z);

        var col = new StaticBody3D { Name = "TableCollision" };
        col.AddToGroup("ManorFurnitureCollider");
        col.AddChild(new CollisionShape3D { Name = "Box", Shape = new BoxShape3D { Size = boxSize }, Position = boxCenter });
        body.AddChild(col);

        return new TableTopInfo(
            new Vector3(basePos.X, y0 + sizeY, basePos.Z),
            outward, tangent,
            halfProtrusion, halfAlongWall);
    }

    // Collidable procedural bookshelf bay, flush against the wall. <=1 per
    // piece (this is the only call site), Straight pieces only (see
    // class-level doc comment).
    static void AddCorridorBookshelf(StaticBody3D body, MazePiece p, Dir dir)
    {
        var shelf = ManorFurniture.BuildBookshelf();

        float cs = DungeonBuilder.CellSize, half = DungeonBuilder.OpeningW * 0.5f;
        float cx = p.X * cs + cs * 0.5f, cz = p.Y * cs + cs * 0.5f;
        float y0 = p.Floor * DungeonBuilder.FloorHeight;
        Vector3 outward = OutwardOf(dir), tangent = TangentOf(dir);

        bool sideA = Fnv(p.X, p.Y, p.Floor, (int)dir, 34) % 2 == 0;
        float tangentOffset = (sideA ? 1f : -1f) * 2.0f;   // same margin reasoning as the table

        Vector3 pos = new Vector3(cx, y0, cz) + outward * half + tangent * tangentOffset;   // flush — no gap
        shelf.Transform = new Transform3D(ManorFurniture.WallBasis(outward), pos);
        shelf.AddToGroup("ManorFurnitureVisual");
        body.AddChild(shelf);
    }

    // ── Wall-hung paintings: visual only, no clearance cost ─────────────────
    // Independent Fnv roll from AddManorFurniture (a piece can have both a
    // table on one wall and a painting on the other, or a painting alone).
    // When this piece's furniture claimed a wall, the painting is steered to
    // the OTHER closed wall (Straight pieces always have exactly 2) so it
    // never overlaps the table/bookshelf.
    static void AddPaintings(StaticBody3D body, MazePiece p, int variant, Dir? avoidDir)
    {
        if (p.Type != PieceType.Straight) return;
        bool eligible = Fnv(p.X, p.Y, p.Floor, 40) % 100 < 35;
        if (!eligible) return;

        var closed = ClosedDirs(PieceDB.GetOpenings(p.Type, p.Rotation));
        if (closed.Count == 0) return;
        Dir dir = closed[Fnv(p.X, p.Y, p.Floor, 41) % closed.Count];
        if (avoidDir.HasValue && dir == avoidDir.Value && closed.Count > 1)
            dir = closed[0] == dir ? closed[1] : closed[0];

        int pick = 1 + Fnv(p.X, p.Y, p.Floor, (int)dir, 42) % 6;
        var tex = ManorFurniture.LoadPaintingTexture($"painting_{pick}");
        if (tex == null) return;                              // images absent → skip

        float aspect = (float)tex.GetWidth() / tex.GetHeight();
        float h = aspect >= 1f ? 0.9f : 1.2f;
        float w = h * aspect;
        var frame = ManorFurniture.BuildPaintingFrame(tex, w, h);

        float cs = DungeonBuilder.CellSize, half = DungeonBuilder.OpeningW * 0.5f;
        float cx = p.X * cs + cs * 0.5f, cz = p.Y * cs + cs * 0.5f;
        float y0 = p.Floor * DungeonBuilder.FloorHeight;
        Vector3 outward = OutwardOf(dir), tangent = TangentOf(dir);

        bool sideA = Fnv(p.X, p.Y, p.Floor, (int)dir, 43) % 2 == 0;
        float tangentOffset = (sideA ? 1f : -1f) * 2.5f;   // offset from the sconce at wall centre

        Vector3 pos = new Vector3(cx, y0 + 3.2f, cz) + outward * half + tangent * tangentOffset;
        frame.Transform = new Transform3D(ManorFurniture.WallBasis(outward), pos);
        frame.AddToGroup("ManorFurnitureVisual");
        frame.AddToGroup("ManorPainting");
        body.AddChild(frame);
    }

    // ── Trim geometry: shared beveled-box mesh + wood shader ────────────────
    static ArrayMesh? _trimMesh;
    static ArrayMesh TrimMesh()
    {
        if (_trimMesh != null) return _trimMesh;
        var st = new SurfaceTool();
        st.Begin(Mesh.PrimitiveType.Triangles);
        // simple box (visual trim only; bevel via normal softness not needed at this size)
        Vector3[] c = {
            new(-0.5f,-0.5f,-0.5f), new(0.5f,-0.5f,-0.5f), new(0.5f,0.5f,-0.5f), new(-0.5f,0.5f,-0.5f),
            new(-0.5f,-0.5f, 0.5f), new(0.5f,-0.5f, 0.5f), new(0.5f,0.5f, 0.5f), new(-0.5f,0.5f, 0.5f) };
        int[][] faces = { new[]{0,1,2,3}, new[]{5,4,7,6}, new[]{4,0,3,7}, new[]{1,5,6,2}, new[]{3,2,6,7}, new[]{4,5,1,0} };
        foreach (var f in faces)
        {
            st.AddVertex(c[f[0]]); st.AddVertex(c[f[1]]); st.AddVertex(c[f[2]]);
            st.AddVertex(c[f[0]]); st.AddVertex(c[f[2]]); st.AddVertex(c[f[3]]);
        }
        st.GenerateNormals();      // fine here: trim boxes don't need welding
        _trimMesh = st.Commit();
        return _trimMesh;
    }

    const string TrimShaderSrc = @"
shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;
varying vec3 wpos;
void vertex(){ wpos=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz; }
float hash13(vec3 p){ p=fract(p*0.1031); p+=dot(p,p.zyx+31.32); return fract((p.x+p.y)*p.z); }
float vnoise(vec3 p){
    vec3 i=floor(p), f=fract(p); f=f*f*(3.0-2.0*f);
    float a=hash13(i),b=hash13(i+vec3(1,0,0)),c=hash13(i+vec3(0,1,0)),d=hash13(i+vec3(1,1,0));
    float e=hash13(i+vec3(0,0,1)),g=hash13(i+vec3(1,0,1)),h=hash13(i+vec3(0,1,1)),k=hash13(i+vec3(1,1,1));
    return mix(mix(mix(a,b,f.x),mix(c,d,f.x),f.y),mix(mix(e,g,f.x),mix(h,k,f.x),f.y),f.z);
}
void fragment(){
    float grain = vnoise(vec3(wpos.x*5.0, wpos.y*0.8, wpos.z*5.0));
    ALBEDO = mix(vec3(0.12,0.07,0.045), vec3(0.26,0.16,0.09), grain);
    ROUGHNESS = 0.8;
}";
    static ShaderMaterial? _trimMat;
    static ShaderMaterial TrimMat() =>
        _trimMat != null && GodotObject.IsInstanceValid(_trimMat)
            ? _trimMat
            : _trimMat = new ShaderMaterial { Shader = new Shader { Code = TrimShaderSrc } };

    static MeshInstance3D Trim(Vector3 center, Vector3 size)
        => new()
        {
            Mesh = TrimMesh(),
            MaterialOverride = TrimMat(),
            Position = center,
            Scale = size,
            Name = "Trim",
        };

    static Vector3 Abs(Vector3 v) => new(Mathf.Abs(v.X), Mathf.Abs(v.Y), Mathf.Abs(v.Z));

    // Coffer beam grid on flat ceiling strips flanking corridor barrel vaults.
    // Corridors only (an open N/S or E/W pair) — rooms/junctions skip beams.
    static void AddCofferBeams(StaticBody3D body, MazePiece p, int variant)
    {
        if (PieceDB.IsStair(p.Type) || variant == 2) return;   // variant 2 = plain ceiling
        var op = PieceDB.GetOpenings(p.Type, p.Rotation);
        bool ns = (op & Dir.N) != 0 && (op & Dir.S) != 0;
        bool ew = (op & Dir.E) != 0 && (op & Dir.W) != 0;
        // Straight corridors ONLY: a THall/Cross also has a perpendicular opening,
        // and a beam spanning the corridor width would cut through that doorway.
        bool nsOnly = ns && (op & Dir.E) == 0 && (op & Dir.W) == 0;
        bool ewOnly = ew && (op & Dir.N) == 0 && (op & Dir.S) == 0;
        if (!nsOnly && !ewOnly) return;
        float cs = DungeonBuilder.CellSize;
        float cx = p.X * cs + cs * 0.5f, cz = p.Y * cs + cs * 0.5f;
        float yCeil = p.Floor * DungeonBuilder.FloorHeight + DungeonBuilder.CellHeight - 0.15f;
        Vector3 along = nsOnly ? new Vector3(0, 0, 1) : new Vector3(1, 0, 0);
        Vector3 across = nsOnly ? new Vector3(1, 0, 0) : new Vector3(0, 0, 1);
        // cross beams every 2.5m spanning the corridor width
        for (int i = -1; i <= 1; i++)
            body.AddChild(Trim(new Vector3(cx, yCeil, cz) + along * (i * 2.5f),
                Abs(across * DungeonBuilder.OpeningW + along * 0.22f + Vector3.Up * 0.30f)));
    }

    // ── Sconces: one torch prop per closed wall — the PRIMARY corridor light
    // source (Polish Pass Task 2). GLBs are asset-pipeline output (Task 5) and
    // may not exist yet; PropLibrary.Instance returns null in that case and we
    // bail out of the whole loop on the first miss — no partial/inconsistent
    // prop sets.
    static void AddSconces(StaticBody3D body, MazePiece p, int variant,
        Dictionary<(int X, int Y, int Floor), OmniLight3D> torchByCell)
    {
        if (PieceDB.IsStair(p.Type)) return;
        // Exit chambers sit flush against the arena doorway (their opening aligns
        // with the arena arch), so sconces on their side walls read as "candles
        // in front of the arena doorway". Skip them — the arena's own lighting
        // plus AddTorches' dim fallback keep the chamber lit and TorchByCell
        // populated for TorchSignalSystem.
        if (p.Type == PieceType.Exit) return;
        var op = PieceDB.GetOpenings(p.Type, p.Rotation);
        float cs = DungeonBuilder.CellSize, half = DungeonBuilder.OpeningW * 0.5f;
        float cx = p.X * cs + cs * 0.5f, cz = p.Y * cs + cs * 0.5f;
        float y0 = p.Floor * DungeonBuilder.FloorHeight;
        string prop = (variant % 2 == 0) ? "torch_a" : "torch_b";
        // one sconce per closed wall (every eligible wall — no placement skip);
        // REAL light on a 1-in-2 roll (salt 17, distinct from every other Fnv
        // roll in this file — placement itself never rolls, so this only needs
        // to avoid colliding with prop-choice/position salts used elsewhere).
        foreach (var (dir, open) in new[] {
            (Dir.N, (op & Dir.N) != 0), (Dir.S, (op & Dir.S) != 0),
            (Dir.E, (op & Dir.E) != 0), (Dir.W, (op & Dir.W) != 0) })
        {
            if (open) continue;
            bool lit = Fnv(p.X, p.Y, p.Floor, (int)dir, 17) % 2 == 0;
            var node = PropLibrary.Instance(prop, withLight: lit);
            if (node == null) return;                    // GLBs absent → skip all
            Vector3 n = dir switch {
                Dir.N => new Vector3(0, 0, -1), Dir.S => new Vector3(0, 0, 1),
                Dir.E => new Vector3(1, 0, 0),  _     => new Vector3(-1, 0, 0) };
            // Mount ~2.6m up (backplate against the wall, flame side into the
            // corridor) — lowered slightly from the old 2.9m now that the prop
            // is bigger (1.1m tall) so it stays centred on the wall face.
            node.Position = new Vector3(cx, y0 + 2.6f, cz) + n * (half - 0.15f);
            body.AddChild(node);   // AddChild before LookAt: LookAt on a not-yet-in-tree
                                    // node can misbehave (see CLAUDE.md task note)
            node.LookAt(node.Position - n, Vector3.Up);   // face into the corridor

            // Register this cell's light (if lit) as the primary source that
            // TorchSignalSystem/VisualFlair read via TorchByCell. If a piece
            // has two lit sconces (e.g. a straight corridor's two closed
            // walls), the later one wins — either is a fine representative.
            if (lit)
            {
                var flame = node.GetNodeOrNull<OmniLight3D>("FlameLight");
                if (flame != null) torchByCell[(p.X, p.Y, p.Floor)] = flame;
            }
        }
    }

    // Variant 0 extra: a potted plant tucked into each real wall corner (both
    // adjacent sides closed). Straight corridors have no such corner, so this
    // only fires on turns / dead-ends / rooms — reads as "junction corners".
    static void AddCornerProps(StaticBody3D body, MazePiece p, int variant)
    {
        if (PieceDB.IsStair(p.Type) || variant != 0) return;
        var op = PieceDB.GetOpenings(p.Type, p.Rotation);
        float cs = DungeonBuilder.CellSize, half = DungeonBuilder.OpeningW * 0.5f;
        float cx = p.X * cs + cs * 0.5f, cz = p.Y * cs + cs * 0.5f;
        float y0 = p.Floor * DungeonBuilder.FloorHeight;
        var corners = new[] {
            (Dir.N, Dir.W, new Vector3(-1, 0, -1)),
            (Dir.N, Dir.E, new Vector3( 1, 0, -1)),
            (Dir.S, Dir.W, new Vector3(-1, 0,  1)),
            (Dir.S, Dir.E, new Vector3( 1, 0,  1)),
        };
        foreach (var (d1, d2, offset) in corners)
        {
            if ((op & d1) != 0 || (op & d2) != 0) continue;   // needs both walls closed
            var node = PropLibrary.Instance("plant_a");
            if (node == null) return;                          // GLBs absent → skip all
            node.Position = new Vector3(cx, y0, cz) + offset * (half - 0.4f);
            body.AddChild(node);
        }
    }

    // Variant 1 extra: a candelabra at the midpoint of straight corridors,
    // set against whichever side wall Fnv picks so runs don't all line up.
    static void AddMidCorridorProp(StaticBody3D body, MazePiece p, int variant)
    {
        if (PieceDB.IsStair(p.Type) || variant != 1) return;
        var op = PieceDB.GetOpenings(p.Type, p.Rotation);
        bool ns = (op & Dir.N) != 0 && (op & Dir.S) != 0;
        bool ew = (op & Dir.E) != 0 && (op & Dir.W) != 0;
        bool nsOnly = ns && (op & Dir.E) == 0 && (op & Dir.W) == 0;
        bool ewOnly = ew && (op & Dir.N) == 0 && (op & Dir.S) == 0;
        if (!nsOnly && !ewOnly) return;
        float cs = DungeonBuilder.CellSize, half = DungeonBuilder.OpeningW * 0.5f;
        float cx = p.X * cs + cs * 0.5f, cz = p.Y * cs + cs * 0.5f;
        float y0 = p.Floor * DungeonBuilder.FloorHeight;
        bool sideA = Fnv(p.X, p.Y, p.Floor, 11) % 2 == 0;
        Vector3 n = nsOnly ? new Vector3(sideA ? 1 : -1, 0, 0)
                            : new Vector3(0, 0, sideA ? 1 : -1);
        var node = PropLibrary.Instance("candelabra_a", withLight: true);
        if (node == null) return;                              // GLBs absent → skip
        node.Position = new Vector3(cx, y0, cz) + n * (half - 0.2f);
        body.AddChild(node);   // AddChild before LookAt (see AddSconces note)
        node.LookAt(node.Position - n, Vector3.Up);
    }

    const string RugShaderSrc = @"
shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;
uniform sampler2D rug_tex : filter_linear_mipmap, repeat_enable;
uniform vec3 border_col : source_color = vec3(0.10, 0.04, 0.03);
uniform vec3 tint : source_color = vec3(1.0, 1.0, 1.0);
void fragment() {
    // UV laid out 0..1 across the slab; border band 8% in from each edge
    vec2 e = min(UV, 1.0 - UV);
    float border = 1.0 - smoothstep(0.06, 0.085, min(e.x, e.y));
    vec3 rug = texture(rug_tex, UV * vec2(2.0, 6.0)).rgb * tint;
    ALBEDO = mix(rug, border_col, border * 0.85);
    ROUGHNESS = 0.97;
}";

    // Per-variant material cache: building a rug material loads a JPG from disk and
    // compiles a shader, so do it once per variant instead of once per corridor cell.
    // IsInstanceValid guard matches the codebase's other material caches — Godot frees
    // resources on scene unload while the C# handle stays non-null (see DungeonBuilder).
    static readonly ShaderMaterial?[] _rugMats = new ShaderMaterial?[VariantCount];

    static ShaderMaterial? RugMat(int variant)
    {
        int slot = variant % _rugMats.Length;
        var cached = _rugMats[slot];
        if (cached != null && GodotObject.IsInstanceValid(cached)) return cached;

        // Per-variant tint over the same carpet texture
        var tints = new[] { new Color(1,1,1), new Color(0.7f,0.85f,1.1f),
                            new Color(1.1f,0.9f,0.7f), new Color(0.85f,1.0f,0.85f) };
        var abs = ProjectSettings.GlobalizePath("res://assets/img/mats/carpet/Carpet3_BaseColor.jpg.jpg");
        var img = new Image();
        if (img.Load(abs) != Error.Ok) return null;
        img.SrgbToLinear(); img.GenerateMipmaps();
        var m = new ShaderMaterial { Shader = new Shader { Code = RugShaderSrc } };
        m.SetShaderParameter("rug_tex", ImageTexture.CreateFromImage(img));
        m.SetShaderParameter("tint", tints[slot % tints.Length]);
        _rugMats[slot] = m;
        return m;
    }

    static void AddRugSlab(StaticBody3D body, MazePiece p, int variant)
    {
        if (PieceDB.IsStair(p.Type)) return;
        var mat = RugMat(variant);
        if (mat == null) return;                       // texture missing → skip
        var op = PieceDB.GetOpenings(p.Type, p.Rotation);
        // Corridor axis: N/S pair or E/W pair. Rooms/junctions get a centered square rug.
        bool ns = (op & Dir.N) != 0 && (op & Dir.S) != 0;
        bool ew = (op & Dir.E) != 0 && (op & Dir.W) != 0;
        float cs = DungeonBuilder.CellSize;
        float len = cs * 0.96f, wid = DungeonBuilder.OpeningW * 0.55f;
        if (ns == ew)   // junction (neither axis) or 4-way crossing (both): square rug
        {
            len = wid = DungeonBuilder.OpeningW * 0.8f;
            ns = false;  // square — orientation irrelevant, use the len-along-X layout
        }

        var mesh = new BoxMesh { Size = new Vector3(ns ? wid : len, 0.05f, ns ? len : wid) };
        mesh.Material = mat;
        // Cell bodies sit at the builder origin with geometry in world-relative
        // coords, so a child's local position == piece coordinates.
        var mi = new MeshInstance3D
        {
            Name = "RugSlab",
            Mesh = mesh,
            Position = new Vector3(p.X * cs + cs * 0.5f,
                                   p.Floor * DungeonBuilder.FloorHeight + 0.03f,
                                   p.Y * cs + cs * 0.5f),
        };
        body.AddChild(mi);
    }
}
