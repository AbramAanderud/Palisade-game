test('invite: host disconnect cancels pending invite; late accept gets gone', async () => {
  const host = await Client.open('HC');
  const x = await Client.open('XC');
  host.send({ type: 'party_create' });
  await host.next(m => m.type === 'party_created');
  host.send({ type: 'party_invite', targetId: x.id });
  const inv = await x.next(m => m.type === 'party_invited');
  host.close();
  const canc = await x.next(m => m.type === 'party_invite_cancelled');
  assert.equal(canc.code, inv.code);
  x.send({ type: 'party_response', code: inv.code, accepted: true });
  const f = await x.next(m => m.type === 'party_invite_failed');
  assert.equal(f.reason, 'gone');
  assert.equal(f.code, inv.code);
  x.close();
});

test('invite: party_start cancels invites still pending', async () => {
  const { host, members } = await makeParty('HS', ['A5', 'B5', 'C5']);
  const x = await Client.open('XS');
  // party is 4/4 so invite fails; use a 3-member party instead
  members[2].send({ type: 'party_leave' });
  await host.next(m => m.type === 'party_update' && m.roster.length === 3);
  host.send({ type: 'party_invite', targetId: x.id });
  const inv = await x.next(m => m.type === 'party_invited');
  host.send({ type: 'party_start' });
  const canc = await x.next(m => m.type === 'party_invite_cancelled');
  assert.equal(canc.code, inv.code);
  x.send({ type: 'party_response', code: inv.code, accepted: true });
  assert.equal((await x.next(m => m.type === 'party_invite_failed')).reason, 'gone');
  for (const c of [host, ...members, x]) c.close();
});

test('robustness: non-object JSON payloads do not crash the relay', async () => {
  const c = await Client.open();
  for (const raw of ['null', '42', '"x"', '[1,2]']) c.send(raw);
  c.send({ type: 'stats' });
  const st = await c.next(m => m.type === 'stats');
  assert.equal(typeof st.online, 'number');
  c.close();
});

test('busy guard: party member cannot create; second create on same socket is busy', async () => {
  const { host, members: [p1, p2] } = await makeParty('HB', ['A6', 'B6']);
  p1.send({ type: 'create' });
  assert.equal((await p1.next(m => m.type === 'error')).reason, 'busy');
  p1.send({ type: 'join', code: '123' });
  assert.equal((await p1.next(m => m.type === 'error')).reason, 'busy');

  const raw = await Client.open();
  raw.send({ type: 'create' });
  await raw.next(m => m.type === 'room_created');
  raw.send({ type: 'create' });
  assert.equal((await raw.next(m => m.type === 'error')).reason, 'busy');
  for (const c of [host, p1, p2, raw]) c.close();
});

test('party: non-integer `to` is dropped, not broadcast', async () => {
  const { host, members: [p1, p2] } = await makeParty('HT', ['A7', 'B7']);
  host.send({ t: 'x1', to: '2' });
  host.send({ t: 'x2', to: 2.5 });
  for (const c of [p1, p2]) {
    await c.none(m => m.t === 'x1' || m.t === 'x2');
  }
  for (const c of [host, p1, p2]) c.close();
});

test('start cleans pending challenges involving starting members; 1v1 survivor freed', async () => {
  const { host, members: [p1, p2] } = await makeParty('HP', ['A8', 'B8']);
  const b = await Client.open('Bch');
  const d = await Client.open('Dch');
  const t = await Client.open('Tch');
  // b challenges p1 (not yet... p1 is already in party -> busy). So challenge first with fresh players.
  b.send({ type: 'challenge', targetId: p1.id });
  assert.equal((await b.next(m => m.type === 'challenge_failed')).reason, 'busy');
  for (const c of [host, p1, p2, b, d, t]) c.close();

  // Real scenario: challenge lands before target joins a party.
  const h = await Client.open('HP2');
  const m1 = await Client.open('M1');
  const m2 = await Client.open('M2');
  const ch = await Client.open('Chal');
  h.send({ type: 'party_create' });
  await h.next(m => m.type === 'party_created');
  ch.send({ type: 'challenge', targetId: m1.id });
  await m1.next(m => m.type === 'incoming_challenge');
  for (const p of [m1, m2]) {
    h.send({ type: 'party_invite', targetId: p.id });
    const inv = await p.next(m => m.type === 'party_invited');
    p.send({ type: 'party_response', code: inv.code, accepted: true });
    await p.next(m => m.type === 'party_joined');
  }
  h.send({ type: 'party_start' });
  await m1.next(m => m.type === 'ffa_start');
  await ch.next(m => m.type === 'challenge_declined');
  const other = await Client.open('Other');
  ch.send({ type: 'challenge', targetId: other.id });
  await other.next(m => m.type === 'incoming_challenge');
  for (const c of [h, m1, m2, ch, other]) c.close();
});

test('start cleans pending challenges where a member is the challenger', async () => {
  const h = await Client.open('HQ');
  const m1 = await Client.open('Q1');
  const m2 = await Client.open('Q2');
  const tgt = await Client.open('Qt');
  m1.send({ type: 'challenge', targetId: tgt.id });
  await tgt.next(m => m.type === 'incoming_challenge');
  h.send({ type: 'party_create' });
  await h.next(m => m.type === 'party_created');
  for (const p of [m1, m2]) {
    h.send({ type: 'party_invite', targetId: p.id });
    const inv = await p.next(m => m.type === 'party_invited');
    p.send({ type: 'party_response', code: inv.code, accepted: true });
    await p.next(m => m.type === 'party_joined');
  }
  h.send({ type: 'party_start' });
  await m1.next(m => m.type === 'ffa_start');
  const c = await tgt.next(m => m.type === 'challenge_cancelled');
  assert.equal(c.fromId, m1.id);
  for (const x of [h, m1, m2, tgt]) x.close();
});

test('1v1: survivor of a closed room is no longer busy', async () => {
  const a = await Client.open('SA');
  const b = await Client.open('SB');
  a.send({ type: 'challenge', targetId: b.id });
  await b.next(m => m.type === 'incoming_challenge');
  b.send({ type: 'challenge_response', challengerId: a.id, accepted: true });
  await a.next(m => m.type === 'match_made');
  await b.next(m => m.type === 'match_made');
  a.close();
  await b.next(m => m.type === 'peer_disconnected');
  b.send({ type: 'create' });
  await b.next(m => m.type === 'room_created');
  b.close();
});
