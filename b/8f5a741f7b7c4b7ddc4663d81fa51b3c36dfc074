});

// ── FFA parties ─────────────────────────────────────────────────────────────

async function makeParty(hostName, memberNames) {
  const host = await Client.open(hostName);
  const members = [];
  for (const n of memberNames) members.push(await Client.open(n));
  host.send({ type: 'party_create' });
  const created = await host.next(m => m.type === 'party_created');
  for (const m of members) {
    host.send({ type: 'party_invite', targetId: m.id });
    const inv = await m.next(x => x.type === 'party_invited');
    m.send({ type: 'party_response', code: inv.code, accepted: true });
    await m.next(x => x.type === 'party_joined');
  }
  return { host, members, code: created.code };
}

test('party: create, decline, too_few, joins, busy flag, full', async () => {
  const h  = await Client.open('Host');
  const p1 = await Client.open('P1');
  const p2 = await Client.open('P2');
  const p3 = await Client.open('P3');
  const p4 = await Client.open('P4');

  h.send({ type: 'party_create' });
  const created = await h.next(m => m.type === 'party_created');
  assert.equal(created.seat, 0);
  assert.equal(created.hostSeat, 0);
  assert.equal(created.cap, 4);
  assert.deepEqual(created.roster.map(r => r.seat), [0]);

  h.send({ type: 'party_invite', targetId: p4.id });
  const inv4 = await p4.next(m => m.type === 'party_invited');
  assert.equal(inv4.fromName, 'Host');
  p4.send({ type: 'party_response', code: inv4.code, accepted: false });
  const dec = await h.next(m => m.type === 'party_declined');
  assert.equal(dec.targetId, p4.id);

  h.send({ type: 'party_start' });
  assert.equal((await h.next(m => m.type === 'party_error')).reason, 'too_few');

  let seat = 1;
  for (const p of [p1, p2, p3]) {
    h.send({ type: 'party_invite', targetId: p.id });
    const inv = await p.next(m => m.type === 'party_invited');
    p.send({ type: 'party_response', code: inv.code, accepted: true });
    const joined = await p.next(m => m.type === 'party_joined');
    assert.equal(joined.seat, seat++);
  }
  // Everyone's most recent party_update shows 4 seats
  for (const c of [h, p1, p2, p3]) {
    const upd = await latestOf(c, 'party_update');
    assert.deepEqual(upd.roster.map(r => r.seat).sort(), [0, 1, 2, 3]);
  }

  const lob = await latestLobby(p4);
  for (const who of [h, p1, p2, p3])
    assert.equal(lob.players.find(p => p.id === who.id).busy, true, 'party members are busy');

  p4.send({ type: 'challenge', targetId: h.id });
  assert.equal((await p4.next(m => m.type === 'challenge_failed')).reason, 'busy');

  h.send({ type: 'party_invite', targetId: p4.id });
  assert.equal((await h.next(m => m.type === 'party_invite_failed')).reason, 'full');

  for (const c of [h, p1, p2, p3, p4]) c.close();
});

test('party: from-stamped broadcast, directed `to`, spoofed from overwritten', async () => {
  const { host, members: [p1, p2, p3] } = await makeParty('H2', ['A2', 'B2', 'C2']);
  p2.send({ t: 'intro', name: 'B2' });
  for (const c of [host, p1, p3]) {
    const m = await c.next(x => x.t === 'intro');
    assert.equal(m.from, 2);
    assert.equal(m.name, 'B2');
  }
  await p2.none(x => x.t === 'intro');

  p1.send({ t: 'hit', dmg: 7, to: 3, from: 0 });
  const hit = await p3.next(x => x.t === 'hit');
  assert.equal(hit.from, 1, 'relay overwrites a client-supplied from');
  await host.none(x => x.t === 'hit');
  await p2.none(x => x.t === 'hit');
  for (const c of [host, p1, p2, p3]) c.close();
});

test('party: start → ffa_start per seat, lobby cleared, host leave hands over, empty party deleted', async () => {
  const { host, members: [p1, p2, p3] } = await makeParty('H3', ['A3', 'B3', 'C3']);
  const watcher = await Client.open('Watcher');

  p1.send({ type: 'party_start' });
  assert.equal((await p1.next(m => m.type === 'party_error')).reason, 'not_host');

  host.send({ type: 'party_start' });
  const starts = await Promise.all([host, p1, p2, p3].map(c => c.next(m => m.type === 'ffa_start')));
  assert.deepEqual(starts.map(s => s.seat), [0, 1, 2, 3]);
  for (const s of starts) {
    assert.equal(s.hostSeat, 0);
    assert.equal(s.started, true);
    assert.equal(s.roster.length, 4);
  }
  const lob = await latestLobby(watcher);
  for (const c of [host, p1, p2, p3])
    assert.ok(!lob.players.some(p => p.id === c.id), 'started members leave the lobby list');

  host.close();
  for (const c of [p1, p2, p3]) {
    const left = await c.next(m => m.type === 'peer_left');
    assert.equal(left.seat, 0);
    assert.equal(left.hostSeat, 1);
  }
  p3.send({ t: 'pos', x: 1 });
  assert.equal((await p1.next(x => x.t === 'pos')).from, 3);

  p1.close(); p2.close(); p3.close();
  await new Promise(r => setTimeout(r, 200));
  watcher.send({ type: 'stats' });
  const st = await watcher.next(m => m.type === 'stats');
  assert.equal(st.parties, 0, 'empty party is deleted');
  watcher.close();
});

test('party: pre-start leave by host hands over and frees them', async () => {
  const { host, members: [p1, p2] } = await makeParty('H4', ['A4', 'B4']);
  host.send({ type: 'party_leave' });
  for (const c of [p1, p2]) {
    let upd = await c.next(m => m.type === 'party_update' && m.roster.length === 2 && m.hostSeat === 1);
    assert.equal(upd.hostSeat, 1);
  }
  const lob = await latestLobby(p1);
  assert.equal(lob.players.find(p => p.id === host.id).busy, false, 'left host is free again');
  host.close(); p1.close(); p2.close();
});

