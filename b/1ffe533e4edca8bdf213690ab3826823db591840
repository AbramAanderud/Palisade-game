using Godot;
using System;

/// Spinning arena sword pickup (the powerful "middle sword").
/// Players already spawn with a weaker sword; grabbing this one upgrades them.
/// Hold E within 2.5 m to collect. The hold is deliberately very short
/// (HoldSeconds) — long enough for the radial prompt to read as a fill rather
/// than a flicker, short enough to feel instant. Set HoldSeconds to 0 for a
/// pure single-press claim.
/// On pickup: the pickup vanishes and the player gains middle-sword stats (full damage +
/// lifesteal). Nothing is dropped — the old DroppedSword prop was removed.
public partial class WeaponPickup : Node3D
{
    // Zweihander GLB is a dedicated two-handed greatsword asset — bigger and more distinct
    // than anything in all_dmc2_swords_remade.glb. Falls back to the vendetta mesh if missing.
    const string ZweihanderPath = "res://assets/zweihander.glb";
    const string FallbackPath   = "res://assets/all_dmc2_swords_remade.glb";
    const string FallbackMesh   = "plane_003_vendetta";
    const float  MiddleScale    = 2.2f;   // zweihander is larger — scale up relative to starter

    /// Which gun this pickup grants. Set by the arena from a roll over
    /// GunCombat.ArenaPool — in an online match the host rolls and broadcasts so
    /// both players race toward the same weapon. The roll lands AFTER _Ready
    /// (the loadout message arrives once both clients are in), so the setter
    /// rebuilds the pedestal display — without this every match showed the
    /// default pool entry, never the gun actually being raced for.
    public string ArenaGunId
    {
        get => _arenaGunId;
        set
        {
            if (_arenaGunId == value) return;
            _arenaGunId = value;
            if (IsInsideTree()) RebuildDisplay();
        }
    }
    string _arenaGunId = GunCombat.ArenaPool[0];

    float   _spin    = 0f;
    float   _bob     = 0f;
    Vector3 _basePos;
    bool    _consumed = false;

    /// Fired once when the local player collects the sword (after ConfirmPickup grants it).
    public event Action? PickedUp;

    /// Fired when the local player presses E within range. In online matches the
    /// arena listens for this, asks the host for arbitration, and then calls
    /// ConfirmPickup() or DespawnSilently() based on the answer.
    public event Action? ClaimAttempted;

    PlayerController? _nearPlayer;
    Area3D  _pickupArea = null!;
    AudioStreamPlayer3D _pickupSfx = null!;
    /// Must reach the whole altar platform. The weapon hovers at
    /// AltarBuilder.WeaponAnchor (Height + 1.9 = 4.4m); a player standing at the
    /// platform EDGE (r = TopRadius = 3.0) has their nearest capsule point about
    /// 2.67m from that centre, so the old 2.5m sphere missed the outer ring of
    /// the platform entirely — you could only claim from the middle. 3.2m covers
    /// the full platform and still cannot be reached from the arena floor or the
    /// steps (nearest ground approach is ~4.7m), which preserves "climb the
    /// altar to take the weapon".
    public const float PickupRadius = 3.2f;

    ProximityPrompt _prompt = null!;
    Label3D _label = null!;
    float   _held;       // seconds the interact key has been held in range
    bool    _claimSent;  // one claim per press (see the latch below)

    /// Hold duration to claim. 0 = instant on press (current setting).
    /// The radial prompt still renders; at 0 it simply reads as a full ring.
    public const float HoldSeconds = 0f;

    public static WeaponPickup Spawn(Node parent, Vector3 pos)
    {
        var wp = new WeaponPickup { Name = "SwordPickup" };
        parent.AddChild(wp);
        wp.Position  = pos;
        wp._basePos  = pos;
        return wp;
    }

    public override void _Ready()
    {
        _basePos = Position;

        // Show the actual gun on the pedestal — the whole point of a random arena
        // prize is that you can see what you are racing for once you get eyes on it.
        RebuildDisplay();

        // Beacon — a pillar of blue light over the prize so the objective reads
        // from across the arena; the faint outer shell skips the depth test, so
        // a hint of it pulls you toward the middle even through walls.
        AddBeacon();

        // Blue glow — the visual signature of the powerful arena sword
        var light = new OmniLight3D
        {
            LightColor  = new(0.25f, 0.55f, 1.0f),
            LightEnergy = 3.2f,
            OmniRange   = 9.0f,
        };
        AddChild(light);

        // Radial hold prompt, sitting on the weapon itself.
        _prompt = new ProximityPrompt
        {
            Name     = "PickupPrompt",
            Position = new Vector3(0f, 0f, 0f),
            Visible  = false,
        };
        AddChild(_prompt);
        _prompt.SetKeyFromAction("interact");

        _label = new Label3D
        {
            Name      = "PickupLabel",
            Text      = _prompt_text,
            Position  = new(0f, -0.62f, 0f),
            FontSize  = 22,
            Modulate  = new Color(0.7f, 0.85f, 1f),
            Billboard = BaseMaterial3D.BillboardModeEnum.Enabled,
            Visible   = false,
        };
        AddChild(_label);

        _pickupSfx = new AudioStreamPlayer3D { MaxDistance = 20f };
        var pickupStream = GD.Load<AudioStream>("res://assets/audio/sfx/combat/OnSwordPickUp.wav");
        if (pickupStream != null) _pickupSfx.Stream = pickupStream;
        AddChild(_pickupSfx);

        _pickupArea = new Area3D { Name = "PickupArea" };
        var shape   = new CollisionShape3D { Shape = new SphereShape3D { Radius = PickupRadius } };
        _pickupArea.AddChild(shape);
        _pickupArea.BodyEntered += b =>
        {
            if (b is PlayerController p && !p.IsRemotePuppet)
            {
                _nearPlayer    = p;
                _prompt.Visible = !_consumed;
                _label.Visible  = !_consumed;
            }
        };
        _pickupArea.BodyExited += b =>
        {
            if (b is PlayerController)
            {
                _nearPlayer    = null;
                _prompt.Visible = false;
                _label.Visible  = false;
                _held           = 0f;
                _claimSent      = false;
                _prompt.Progress = 0f;
            }
        };
        AddChild(_pickupArea);
    }

    /// Recentre a rotated+scaled model so its bounding-box CENTRE sits on this
    /// node's origin. Model origins are arbitrary — a grip, a muzzle, a blade
    /// root — so without this each weapon hovers at a different offset above the
    /// altar and the tall ones clip into the platform. Normalising the SIZE
    /// (already done above) is only half the job; the other half is the offset.
    /// Call AFTER rotation and scale are set: the local AABB is pushed through
    /// the node's basis so rotation and scale are both accounted for.
    static void CentreOnOrigin(Node3D model, Aabb localAabb)
    {
        var centreLocal = localAabb.Position + localAabb.Size * 0.5f;
        model.Position  = -(model.Basis * centreLocal);
    }

    Node3D? _displayRoot;

    /// (Re)build the pedestal model for the current ArenaGunId.
    void RebuildDisplay()
    {
        _displayRoot?.QueueFree();
        _displayRoot = new Node3D { Name = "DisplayRoot" };
        AddChild(_displayRoot);
        if (!TryLoadArenaGunMesh(_displayRoot) && !TryLoadSwordMesh(_displayRoot))
            BuildPlaceholderMesh(_displayRoot);
        if (_label != null) _label.Text = _prompt_text;
    }

    void AddBeacon()
    {
        MeshInstance3D Beam(float radius, float height, float alpha, bool throughWalls)
        {
            var mat = new StandardMaterial3D
            {
                AlbedoColor  = new Color(0.35f, 0.62f, 1.0f, alpha),
                ShadingMode  = BaseMaterial3D.ShadingModeEnum.Unshaded,
                Transparency = BaseMaterial3D.TransparencyEnum.Alpha,
                BlendMode    = BaseMaterial3D.BlendModeEnum.Add,
                CullMode     = BaseMaterial3D.CullModeEnum.Disabled,
                NoDepthTest  = throughWalls,
            };
            var mi = new MeshInstance3D
            {
                // Slight taper toward the base so it reads as light, not a pipe.
                Mesh = new CylinderMesh { TopRadius = radius, BottomRadius = radius * 0.7f, Height = height },
                Position   = new Vector3(0f, height * 0.5f, 0f),
                CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
            };
            mi.SetSurfaceOverrideMaterial(0, mat);
            AddChild(mi);
            return mi;
        }

        // Solid core the room reads at a glance + a faint through-wall shell.
        // Additive blend, so where they overlap the column brightens.
        var core = Beam(0.45f, 22f, 0.30f, throughWalls: false);
        Beam(0.95f, 22f, 0.10f, throughWalls: true);

        // Slow breathing pulse, forever — the tween dies with the pickup on claim.
        var tw = CreateTween().SetLoops();
        tw.TweenProperty(core, "scale", new Vector3(1.30f, 1f, 1.30f), 1.1f)
          .SetTrans(Tween.TransitionType.Sine).SetEase(Tween.EaseType.InOut);
        tw.TweenProperty(core, "scale", Vector3.One, 1.1f)
          .SetTrans(Tween.TransitionType.Sine).SetEase(Tween.EaseType.InOut);
    }

    bool TryLoadSwordMesh(Node3D parent)
    {
        // Try the dedicated zweihander GLB first; fall back to the vendetta mesh
        MeshInstance3D? src      = null;
        Node3D?         tempRoot = null;
        bool            isZwei   = false;

        var zweiPacked = GD.Load<PackedScene>(ZweihanderPath);
        if (zweiPacked != null)
        {
            tempRoot = zweiPacked.Instantiate<Node3D>();
            src      = FindFirst<MeshInstance3D>(tempRoot);
            isZwei   = src != null;
        }

        if (src == null)
        {
            tempRoot?.Free();
            var fallback = GD.Load<PackedScene>(FallbackPath);
            if (fallback == null) return false;
            tempRoot = fallback.Instantiate<Node3D>();
            src = FindFirst<MeshInstance3D>(tempRoot, FallbackMesh)
               ?? FindFirst<MeshInstance3D>(tempRoot);
        }

        if (src == null) { tempRoot?.Free(); return false; }

        // Zweihander blade runs along X → roll +90° Z to stand upright (X→Y).
        // DMC swords run along Z → pitch +90° X to stand upright (Z→Y).
        var inst = new MeshInstance3D
        {
            Name            = "SwordMesh",
            Mesh            = src.Mesh,
            RotationDegrees = isZwei ? new(0f, 0f, 90f) : new(90f, 0f, 0f),
        };
        // Scale to MiddleScale relative to its longest axis (~1.8m)
        var aabb = inst.Mesh.GetAabb();
        float maxD = Mathf.Max(aabb.Size.X, Mathf.Max(aabb.Size.Y, aabb.Size.Z));
        inst.Scale = maxD > 0.01f ? Vector3.One * (MiddleScale / maxD) : Vector3.One * MiddleScale;
        CentreOnOrigin(inst, aabb);

        // Blue-tinted emissive material to make the powerful sword visually distinct
        var mat = new StandardMaterial3D
        {
            AlbedoColor      = new Color(0.85f, 0.92f, 1f),
            Metallic         = 0.9f,
            Roughness        = 0.18f,
            EmissionEnabled  = true,
            Emission         = new Color(0.20f, 0.50f, 1.0f),
            EmissionEnergyMultiplier = 1.8f,
        };
        inst.MaterialOverride = mat;

        tempRoot?.Free();
        parent.AddChild(inst);
        return true;
    }

    /// Load the GLB for whichever gun this pickup grants, scaled to a readable
    /// pedestal size. Returns false if the id or model is missing so the caller
    /// can fall back.
    bool TryLoadArenaGunMesh(Node3D parent)
    {
        if (!GunCombat.Defs.TryGetValue(ArenaGunId, out var def))    return false;
        if (!ResourceLoader.Exists(def.Model))                        return false;

        var scene = GD.Load<PackedScene>(def.Model);
        if (scene == null) return false;

        var model = scene.Instantiate<Node3D>();
        model.Name = "ArenaGunMesh";

        // Normalise to ~1.4 m so every gun reads at the same distance.
        var   aabb = GunCombat.MeasureAabb(model);
        float maxD = Mathf.Max(aabb.Size.X, Mathf.Max(aabb.Size.Y, aabb.Size.Z));
        model.Scale = maxD > 0.01f ? Vector3.One * (1.4f / maxD) : Vector3.One * 0.01f;
        CentreOnOrigin(model, aabb);

        parent.AddChild(model);
        _prompt_text = $"Take {def.Display}";
        return true;
    }

    // No "[E]" prefix — the radial prompt renders the key itself, and it
    // renders the ACTUAL bound key, which this string could not.
    string _prompt_text = "Take Weapon";


    void BuildPlaceholderMesh(Node3D parent)
    {
        var blueMat = new StandardMaterial3D
        {
            AlbedoColor      = new(0.4f, 0.55f, 1.0f),
            Metallic         = 0.95f,
            Roughness        = 0.12f,
            EmissionEnabled  = true,
            Emission         = new Color(0.2f, 0.5f, 1.0f),
            EmissionEnergyMultiplier = 1.6f,
        };
        var gripMat = new StandardMaterial3D { AlbedoColor = new(0.35f, 0.20f, 0.08f), Roughness = 0.90f };

        var blade = new MeshInstance3D { Mesh = new BoxMesh { Size = new(0.10f, 1.80f, 0.06f) }, Position = new(0f, 0.90f, 0f) };
        blade.SetSurfaceOverrideMaterial(0, blueMat);
        parent.AddChild(blade);

        var guard = new MeshInstance3D { Mesh = new BoxMesh { Size = new(0.65f, 0.10f, 0.10f) }, Position = new(0f, 0.0f, 0f) };
        guard.SetSurfaceOverrideMaterial(0, blueMat);
        parent.AddChild(guard);

        var grip = new MeshInstance3D { Mesh = new BoxMesh { Size = new(0.08f, 0.36f, 0.08f) }, Position = new(0f, -0.22f, 0f) };
        grip.SetSurfaceOverrideMaterial(0, gripMat);
        parent.AddChild(grip);
    }

    public override void _Process(double delta)
    {
        if (_consumed) return;

        float dt = (float)delta;
        _spin += dt * 1.5f;
        _bob  += dt * 2.0f;
        Position = _basePos + Vector3.Up * (Mathf.Sin(_bob) * 0.22f);
        Rotation = new(0f, _spin, 0f);

        if (_nearPlayer == null || _consumed) { _held = 0f; return; }

        // One claim in flight at a time, PERIOD. Online the verdict is a full
        // round trip to the host, and re-arming on key release let a player
        // machine-gun E — one relay message per press — until the verdict
        // landed. The claim resolves as ConfirmPickup or DespawnSilently, both
        // of which consume the pickup, so the latch never needs to reopen.
        if (_claimSent)
        {
            _prompt.Progress = 1f;
            return;
        }

        // Hold-to-claim. The arena still decides who actually gets it
        // (host-authoritative online), so this only gates when the claim fires.
        if (Input.IsActionPressed("interact"))
        {
            _held += dt;
            _prompt.Progress = HoldSeconds <= 0f ? 1f : _held / HoldSeconds;
            if (_held >= HoldSeconds && !_claimSent)
            {
                _claimSent = true;
                // Immediate local feedback while the host round-trip is in
                // flight — the wait reads as "claiming", not "it ignored me".
                _label.Text = "Claiming...";
                ClaimAttempted?.Invoke();
            }
        }
        else
        {
            if (_held > 0f)
            {
            // Released early — rewind fast rather than snapping, so a fumbled
            // press still reads as "that was doing something".
            _held = Mathf.Max(0f, _held - dt * 3f);
                _prompt.Progress = HoldSeconds <= 0f ? 0f : _held / HoldSeconds;
            }
        }
    }

    /// Award the sword to the local player (called by the arena after host arbitration).
    public void ConfirmPickup()
    {
        if (_consumed || _nearPlayer == null) return;
        _consumed = true;

        _nearPlayer.EquipArenaGun(ArenaGunId);

        _pickupSfx.Play();
        PickedUp?.Invoke();
        FadeOutAndFree();
    }

    /// Remove the pickup without granting it (called when the opponent won the claim).
    public void DespawnSilently()
    {
        if (_consumed) return;
        _consumed = true;
        FadeOutAndFree();
    }

    void FadeOutAndFree()
    {
        _pickupArea.SetDeferred("monitoring",  false);
        _pickupArea.SetDeferred("monitorable", false);
        _prompt.Visible = false;
        _label.Visible  = false;
        var tw = CreateTween();
        tw.TweenProperty(this, "scale", Vector3.Zero, 0.35f);
        tw.TweenCallback(Callable.From(QueueFree));
    }

    static T? FindFirst<T>(Node node, string name) where T : Node
    {
        if (node is T t && node.Name == name) return t;
        foreach (Node child in node.GetChildren())
        {
            var found = FindFirst<T>(child, name);
            if (found != null) return found;
        }
        return null;
    }

    static T? FindFirst<T>(Node node) where T : Node
    {
        if (node is T t) return t;
        foreach (Node child in node.GetChildren())
        {
            var found = FindFirst<T>(child);
            if (found != null) return found;
        }
        return null;
    }
}
