using Godot;
using System.Linq;
using System.Collections.Generic;

/// test/TestPitDoorway.cs
/// Pit-preview doorway markers (mirrors the room-edge open/walled treatment,
/// AddRoomOpenMarker) must agree EXACTLY with PitBuilder.HasEntry — the same
/// predicate the runtime shaft uses to decide which faces actually open. This
/// pins that agreement directly against the real BuildPieceInto output (not a
/// re-derived copy of the rule), at the same (perimeter cell, floor, face)
/// granularity HasEntry itself operates at.
///
/// An open face draws a door-shaped OUTLINE (two jambs + a lintel, in the same
/// bold purple used for the pit's own outer edges) rather than a filled cyan
/// panel — the opening stays visually unfilled, framed like a doorway. This
/// test checks for the jamb/lintel bars at their exact expected positions
/// (mirroring BuildPieceInto's own DoorW/DoorH/FlrT math) and, separately, that
/// the total count of bold-purple bars matches "12 fixed box-outline bars +
/// 3 per open connection" — proof no stray doorway appears anywhere else.
///
/// No live scene tree needed: MazeEditor3D.BuildPieceInto's Pit branch only
/// reads _maze/FlMin/FlMax/PieceDB and writes into the `parent` Node3D handed
/// to it — same "not in the tree" pattern as TestTeleportPairs.cs.
public partial class TestPitDoorway : Node
{
    int _fail;
    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + label);
        if (!ok) _fail++;
    }

    const float CS = DungeonBuilder.CellSize;
    // MazeEditor3D.EdFH/FlMin/FlMax/FlrT are private consts; mirrored here rather
    // than widening their access just for this test (load-bearing constants
    // unlikely to change without every editor test needing a look anyway).
    const float EdFH = 8f;
    const float FlrT = 0.22f;
    const int FlMin = -3, FlMax = 3;

    // Mirrors BuildPieceInto's door-frame proportions exactly (see the Pit
    // branch) — if either drifts, the position checks below will fail loudly
    // instead of silently testing the wrong spot.
    const float DoorW = CS * 0.32f, DoorH = EdFH * 0.68f;
    static readonly Color PitEdgeColor = new(0.42f, 0.10f, 0.66f);

    public override void _Ready()
    {
        GD.Print("── pit doorway markers vs PitBuilder.HasEntry ──");

        var ed = new MazeEditor3D();
        // Pit anchored at (5,5,0) -> occupies floors {-1,0,1} (PieceDB.FloorSpan).
        var pit = new MazePiece { Type = PieceType.Pit, X = 5, Y = 5, Floor = 0 };

        // A) Block connection: Straight at (5,3,0), rot 0 (opens N|S) — its S face
        // opens onto the pit's N-perimeter cell (5,4). Only floor 0's N/dx=0
        // segment should be open; the same face on floors -1/+1 must stay walled,
        // and the OTHER two sub-cells on the N face (dx=-1, dx=+1) must too.
        var straight = new MazePiece { Type = PieceType.Straight, X = 5, Y = 3, Floor = 0, Rotation = 0 };

        // C) Stair connection: StairsUp at (7,5,0) rot 3 -> CrossDir = W (verified
        // against PieceDB.GetStairCrossDir's N->E->S->W rotation table). Its high
        // end lands one floor up (floor 1) facing W, exactly onto the pit's
        // E-perimeter cell (6,5) at floor 1 — HasEntry's "stair one floor below,
        // matching CrossDir" branch.
        var stairUp = new MazePiece { Type = PieceType.StairsUp, X = 7, Y = 5, Floor = 0, Rotation = 3 };

        ed._maze = new MazeData { Name = "PitDoorwayTest",
            Pieces = new List<MazePiece> { pit, straight, stairUp } };

        var geo = new Node3D();
        ed.BuildPieceInto(geo, PieceType.Pit, 0, pit.X * CS, pit.Floor * EdFH, pit.Y * CS, isActive: true);

        var edgeBars = geo.GetChildren().OfType<MeshInstance3D>()
            .Where(mi => mi.MaterialOverride is StandardMaterial3D m && ColorClose(m.AlbedoColor, PitEdgeColor))
            .ToList();

        bool BarNear(float x, float y, float z) => edgeBars.Any(mi =>
            Mathf.Abs(mi.Position.X - x) < 0.3f &&
            Mathf.Abs(mi.Position.Y - y) < 0.3f &&
            Mathf.Abs(mi.Position.Z - z) < 0.3f);

        // A door frame's jamb sits DoorW/2 either side of the segment's tangent
        // centre, at doorMidY; the lintel sits above at doorTopY. Checking for
        // BOTH a jamb and the lintel (not just one bar) confirms the whole frame
        // is drawn, not a stray single box that happens to share the colour.
        bool DoorFrameAt(float tangentWorld, float fixedWorld, int floor, bool tangentIsX)
        {
            float doorBotY = floor * EdFH + FlrT;
            float doorTopY = doorBotY + DoorH;
            float doorMidY = doorBotY + DoorH * 0.5f;
            bool jamb = tangentIsX
                ? BarNear(tangentWorld - DoorW * 0.5f, doorMidY, fixedWorld)
                : BarNear(fixedWorld, doorMidY, tangentWorld - DoorW * 0.5f);
            bool lintel = tangentIsX
                ? BarNear(tangentWorld, doorTopY, fixedWorld)
                : BarNear(fixedWorld, doorTopY, tangentWorld);
            return jamb && lintel;
        }

        // Independent cross-check against HasEntry directly (not just the marker
        // count), using the exact same lookup the editor builds.
        var lookup = MazeLookup.Build(ed._maze.Pieces, FlMin, FlMax);

        // ── A) block connection ──────────────────────────────────────────────
        bool aOpenAtF0 = PitBuilder.HasEntry(lookup, pit, 5, 4, 0, Dir.N, FlMin, FlMax);
        Check(aOpenAtF0, "HasEntry: N face, (5,4), floor 0 is open (Straight connects)");
        float aWorldZ = (pit.Y - 1) * CS;                       // pz0 (north boundary)
        float aWorldX = 5 * CS + CS * 0.5f;                     // sub-cell dx=0 centre
        Check(DoorFrameAt(aWorldX, aWorldZ, 0, tangentIsX: true),
              "editor draws a door frame exactly at (N, dx=0, floor 0)");

        // Same face/sub-cell on floors -1 and +1 must stay walled (per-floor, not
        // whole-face) — no door frame anywhere near that X/Z at the other floors.
        Check(!DoorFrameAt(aWorldX, aWorldZ, -1, tangentIsX: true),
              "N face, dx=0, floor -1 stays WALLED (Straight is only on floor 0)");
        Check(!DoorFrameAt(aWorldX, aWorldZ, 1, tangentIsX: true),
              "N face, dx=0, floor +1 stays WALLED (Straight is only on floor 0)");

        // ── B) no connection (south face, entirely empty) ───────────────────
        int southOpenCount = 0;
        for (int dx = -1; dx <= 1; dx++)
            foreach (int f in new[] { -1, 0, 1 })
                if (PitBuilder.HasEntry(lookup, pit, 5 + dx, 6, f, Dir.S, FlMin, FlMax))
                    southOpenCount++;
        Check(southOpenCount == 0, $"HasEntry: S face has zero open cells (has {southOpenCount})");
        // NOTE: a loose "any purple bar near Z=pz1" check is NOT enough here — the
        // pit's own permanent outer-edge outline legitimately has bars sitting
        // exactly on this same south boundary line (at yBot/yTop). DoorFrameAt
        // checks for a bar at doorMidY specifically, which only a real door frame
        // would produce, so it can't false-positive on the outline's own edges.
        float sWorldZ = (pit.Y + 2) * CS;                       // pz1 (south boundary)
        bool anySouthDoor = false;
        for (int dx = -1; dx <= 1; dx++)
            foreach (int f in new[] { -1, 0, 1 })
                if (DoorFrameAt(5 * CS + CS * 0.5f + dx * CS, sWorldZ, f, tangentIsX: true))
                    anySouthDoor = true;
        Check(!anySouthDoor, "editor draws NO door frame anywhere on the south face (still a plain wall)");

        // ── C) stair connection ──────────────────────────────────────────────
        bool cOpen = PitBuilder.HasEntry(lookup, pit, 6, 5, 1, Dir.E, FlMin, FlMax);
        Check(cOpen, "HasEntry: E face, (6,5), floor 1 is open (StairsUp cross lands here)");
        float cWorldX = (pit.X + 2) * CS;                       // px1 (east boundary)
        float cWorldZ = 5 * CS + CS * 0.5f;                     // sub-cell dy=0 centre
        Check(DoorFrameAt(cWorldZ, cWorldX, 1, tangentIsX: false),
              "editor draws a door frame exactly at (E, dy=0, floor 1)");
        Check(!DoorFrameAt(cWorldZ, cWorldX, 0, tangentIsX: false),
              "E face, dy=0, floor 0 stays WALLED (the stair's high end only lands on floor 1)");

        // 12 fixed bars from the pit's own outer-edge outline (4 corner posts +
        // 2 floors' worth of 4 edge bars each) + 3 bars (2 jambs + 1 lintel) per
        // open connection (A and C) = 18 — proof no stray door frame appears
        // anywhere beyond the two real connections.
        int expected = 12 + 3 * 2;
        GD.Print($"total bold-purple bars drawn: {edgeBars.Count} (expect {expected})");
        Check(edgeBars.Count == expected, $"exactly {expected} purple bars total — no stray door frames");

        GD.Print(_fail == 0 ? "RESULT OK" : $"RESULT {_fail} FAILURE(S)");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }

    static bool ColorClose(Color a, Color b) =>
        Mathf.Abs(a.R - b.R) < 0.01f && Mathf.Abs(a.G - b.G) < 0.01f && Mathf.Abs(a.B - b.B) < 0.01f;
}
