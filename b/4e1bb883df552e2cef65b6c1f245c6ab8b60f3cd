using Godot;

/// Regression harness for the two-slot loadout.
///
/// Bug this locks down: in a maze playtest (DungeonArena) the player spawned
/// armed but with SecondaryGunId still null, because PlayerController.Spawn only
/// calls PickupWeapon() — filling a loadout slot is the owning scene's job, and
/// this scene never did it. Claiming the middle weapon then filled PRIMARY while
/// SECONDARY stayed empty, so HasBothGuns was false, Tab did nothing, and the
/// starter the player was holding silently vanished.
///
/// Both halves are asserted: that a bare spawn really does leave SECONDARY empty
/// (so the fix is not load-bearing on luck), and that the starter survives the
/// arena pickup once the scene registers it.
public partial class TestLoadoutSlots : Node3D
{
    const string Starter = "pew";
    const string Arena   = "awp";

    PlayerController? _p;
    int  _frame;
    bool _done;

    public override void _Ready()
    {
        _p = PlayerController.Spawn(this, Vector3.Zero, 0f);
    }

    public override void _Process(double delta)
    {
        if (_done) return;
        _frame++;
        if (_frame < 3) return;      // let GunCombat._Ready equip its default gun
        _done = true;

        var p = _p;
        if (p == null) { GD.Print("[TestLoadoutSlots] PASS=False (no player)"); GetTree().Quit(); return; }

        bool pass = true;

        // ── 1. A bare spawn, i.e. what DungeonArena used to do ────────────────
        // The player IS holding a gun (GunCombat defaults to "pew"), but no slot
        // knows about it.
        GD.Print($"[TestLoadoutSlots] on spawn: held={Held(p)} primary={p.PrimaryGunId ?? "-"} secondary={p.SecondaryGunId ?? "-"}");
        pass &= Check("bare spawn leaves SECONDARY empty", p.SecondaryGunId == null);

        // Claiming the middle weapon from that state is the actual bug.
        p.EquipArenaGun(Arena);
        pass &= Check("arena gun fills PRIMARY", p.PrimaryGunId == Arena);
        pass &= Check("SECONDARY still empty -> starter lost", p.SecondaryGunId == null);
        pass &= Check("HasBothGuns false -> Tab is a no-op", !p.HasBothGuns);

        // ── 2. The fixed flow, as DungeonArena now does it ────────────────────
        p.EquipStarterGun(Starter);
        pass &= Check("starter fills SECONDARY", p.SecondaryGunId == Starter);
        pass &= Check("starter resets PRIMARY",  p.PrimaryGunId == null);
        pass &= Check("starter is held",         Held(p) == Starter);

        p.EquipArenaGun(Arena);
        GD.Print($"[TestLoadoutSlots] after pickup: held={Held(p)} primary={p.PrimaryGunId ?? "-"} secondary={p.SecondaryGunId ?? "-"}");
        pass &= Check("SECONDARY SURVIVES the middle pickup", p.SecondaryGunId == Starter);
        pass &= Check("PRIMARY is the arena gun",             p.PrimaryGunId == Arena);
        pass &= Check("HasBothGuns",                          p.HasBothGuns);
        pass &= Check("arena gun is now held",                Held(p) == Arena);

        // ── 3. Tab actually swaps between the two ─────────────────────────────
        p.SwitchWeapon();
        pass &= Check("Tab swaps to the starter", Held(p) == Starter);
        p.SwitchWeapon();
        pass &= Check("Tab swaps back to arena",  Held(p) == Arena);

        GD.Print($"[TestLoadoutSlots] PASS={pass}");
        GetTree().Quit();
    }

    static string Held(PlayerController p) => p.Gun?.Def.Id ?? "-";

    static bool Check(string what, bool ok)
    {
        GD.Print($"[TestLoadoutSlots]   {(ok ? "ok  " : "FAIL")} {what}");
        return ok;
    }
}
