using Godot;

/// res://test/TestTask.cs
/// ─────────────────────────────────────────────────────────────────────────────
/// TP gun-tilt repro: one LOCAL player (frozen, driven through
/// DebugDriveThirdPerson so SeatTpGrip runs every frame — the "known good"
/// reference) side by side with one REMOTE PUPPET (real IsRemotePuppet path,
/// ticked only by the engine's normal _PhysicsProcess — no debug driving),
/// both holding the same weapon. Camera framing copied from TestGunHold.tscn,
/// which is proven to render the held gun clearly.
/// ─────────────────────────────────────────────────────────────────────────────
public partial class TestTask : Node3D
{
    const string Gun = "ak47";   // long gun — worst case for a bad hand attachment

    PlayerController? _local;
    PlayerController? _puppet;

    public override void _Ready()
    {
        var env = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0.07f, 0.07f, 0.09f),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(1f, 0.97f, 0.92f),
            AmbientLightEnergy = 0.9f,
        };
        AddChild(new WorldEnvironment { Environment = env });

        var key = new DirectionalLight3D { LightEnergy = 1.4f };
        key.RotationDegrees = new Vector3(-35f, 30f, 0f);
        AddChild(key);

        var floor = new StaticBody3D();
        floor.AddChild(new CollisionShape3D
        { Shape = new BoxShape3D { Size = new Vector3(60f, 1f, 60f) } });
        AddChild(floor);
        floor.GlobalPosition = new Vector3(0f, -0.5f, 0f);

        // Front: real local player, frozen + debug-driven idle — the path that
        // already calls SeatTpGrip every frame (line 1179 in the real Tick).
        _local = PlayerController.Spawn(this, new Vector3(-0.85f, 0.2f, 0f), 0f);
        _local.Frozen = true;
        _local.EquipStarterGun(Gun);

        // Back: real remote puppet. IsRemotePuppet's own _PhysicsProcess branch
        // never calls SeatTpGrip — no debug driving here on purpose, this must
        // reproduce through the exact code path a real opponent uses.
        _puppet = PlayerController.Spawn(this, new Vector3(0.85f, 0.2f, 0f), 0f);
        _puppet.IsRemotePuppet = true;
        _puppet.EnableWorldBars();
        _puppet.EquipStarterGun(Gun);

        AddChild(new Label3D
        {
            Text      = "LOCAL",
            FontSize  = 60,
            Position  = new Vector3(-0.85f, 2.3f, 0f),
            Billboard = BaseMaterial3D.BillboardModeEnum.Enabled,
            Modulate  = new Color(0.6f, 1f, 0.6f),
            PixelSize = 0.0028f,
        });
        AddChild(new Label3D
        {
            Text      = "PUPPET",
            FontSize  = 60,
            Position  = new Vector3(0.85f, 2.3f, 0f),
            Billboard = BaseMaterial3D.BillboardModeEnum.Enabled,
            Modulate  = new Color(1f, 0.6f, 0.6f),
            PixelSize = 0.0028f,
        });

        // Same distance/FOV as TestGunHold.tscn (proven to render the gun clearly).
        var cam = new Camera3D { Fov = 60f, CullMask = ~4u };
        AddChild(cam);
        cam.Position = new Vector3(0f, 1.5f, 3.4f);
        cam.LookAt(new Vector3(0f, 1.1f, 0f), Vector3.Up);
        cam.MakeCurrent();
    }

    public override void _PhysicsProcess(double delta)
    {
        // Hold the reference in a steady idle gun-aim pose so its seat reaches
        // Final. The puppet is NOT touched here — it runs through its own real
        // _PhysicsProcess branch, exactly like an online opponent.
        _local?.DebugDriveThirdPerson("IDLE", (float)delta);
    }
}
