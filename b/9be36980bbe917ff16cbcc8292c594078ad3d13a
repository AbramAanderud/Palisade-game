using Godot;
using System;
using System.Collections.Generic;
using System.Linq;

/// test/TestShelfSlide.cs
/// Wall-run SMOOTHNESS harness for the arena shelf ring.
///
/// TestShelfCollision drives a capsule head-on into one bay and proves the
/// collider is solid. It cannot see what this harness exists for: how the ring
/// behaves when you slide ALONG it, which is what a wall run actually does.
///
/// What this harness found (playtest report: "wall running feels like colliding
/// with the books"):
///
///  - The original suspect was seam lips. The shelf ring was 30 convex
///    BoxShape3D slabs each built `faceLen + 0.1` long, so neighbours
///    overlapped by ~5mm. MEASURED: irrelevant. An A/B of boxes vs a seamless
///    trimesh at the same facet count was byte-identical — a 0.35m capsule
///    rides straight over a 5mm lip. Do not re-litigate this.
///
///  - The real cause was FACET WOBBLE. A collider matching the visual 32-gon
///    shoves the capsule 140mm in and out once per bay — every 5.9m, i.e.
///    every 0.4s at wall-run speed. That is the bump.
///
///  - Fix: subdivide the COLLISION ring independently of the visual facet
///    count (ArenaBuilder ColSubdiv). Measured wobble by subdivision:
///        32 seg 140mm | 64 seg 35mm | 128 seg 9mm | 256 seg 2mm
///
///  - Residual: a concave trimesh always costs a little speed at each triangle
///    boundary (Jolt internal-edge handling), and that cost scales with the
///    angle between adjacent triangles. At 256 segments the angle is 1.4deg and
///    the dip is to ~84% of median for one frame in three — smooth enough that
///    median speed is 14.98 of a commanded 15. It never reaches zero; do not
///    chase it to zero by subdividing further, since more segments means more
///    boundaries.
///
/// Method: drive a player-sized capsule tangentially around the ring while
/// pressing into it, logging radial distance and tangential speed per frame.
/// Stops at the first doorway (the ring is deliberately open north and south).
public partial class TestShelfSlide : Node3D
{
    const float CapsuleRadius = 0.35f;   // mirrors PlayerController
    const float CapsuleHeight = 1.6f;
    const float RunSpeed      = 15.0f;   // PlayerController.WallRunSpeed
    const float PressSpeed    = 2.0f;    // inward hold, keeps contact
    const float TestY         = 5.0f;    // above WallSkirt, inside shelf band
    const float DurationSec   = 8.0f;

    CharacterBody3D _body = null!;
    double _t;
    readonly List<(double t, float radial, float speed)> _log = new();

    public override void _Ready()
    {
        var arena = new ArenaBuilder { Name = "Arena" };
        AddChild(arena);
        arena.Build(Vector3.Zero, openNorth: true, openSouth: true);

        // Start mid-bay on the +X side, well clear of both doorways (which sit
        // due north and due south), pressed against the shelf face.
        float startR = ArenaBuilder.Apothem - 0.55f - CapsuleRadius;
        _body = new CharacterBody3D { Name = "Probe", Position = new Vector3(startR, TestY, 0f) };
        _body.AddChild(new CollisionShape3D
        {
            Shape = new CapsuleShape3D { Radius = CapsuleRadius, Height = CapsuleHeight },
        });
        AddChild(_body);

        GD.Print($"[Slide] shelfFrontR={ArenaBuilder.Apothem - 0.55f:F3} " +
                 $"expectedRadial~{startR:F3} runSpeed={RunSpeed}");
    }

    // Angular half-width around each doorway to exclude. The shelf ring is
    // deliberately open at north and south, so a capsule pressing outward there
    // simply leaves through the arch — real behaviour, but nothing to do with
    // seam smoothness, and it swamps the statistics if logged.
    const float DoorwayGuard = 0.35f;   // radians

    static bool NearDoorway(Vector3 p)
    {
        // North doorway faces -Z, south faces +Z.
        float ang = Mathf.Atan2(p.X, -p.Z);                 // 0 = north
        float toNorth = Mathf.Abs(Mathf.Wrap(ang, -Mathf.Pi, Mathf.Pi));
        float toSouth = Mathf.Abs(Mathf.Wrap(ang - Mathf.Pi, -Mathf.Pi, Mathf.Pi));
        return toNorth < DoorwayGuard || toSouth < DoorwayGuard;
    }

    public override void _PhysicsProcess(double delta)
    {
        _t += delta;

        var p = _body.GlobalPosition;
        var outward = new Vector3(p.X, 0f, p.Z).Normalized();
        // Tangent = 90 deg from outward, so the capsule circles the ring.
        var tangent = new Vector3(-outward.Z, 0f, outward.X);

        // Wall-run motion: travel along the wall while holding into it. Gravity
        // is deliberately off — this isolates horizontal seam behaviour from
        // vertical fall, which is what a wall run does anyway.
        _body.Velocity = tangent * RunSpeed + outward * PressSpeed;
        _body.MoveAndSlide();

        var p2 = _body.GlobalPosition;
        // Stop at the first doorway rather than trying to drive through it —
        // the run from +X to the first arch is ~80m of continuous shelf ring,
        // which crosses ~13 bay seams and is plenty to characterise them.
        if (NearDoorway(p2)) { Report(); GetTree().Quit(); return; }

        float radial = new Vector2(p2.X, p2.Z).Length();
        float speed  = new Vector2(p2.X - p.X, p2.Z - p.Z).Length() / (float)delta;
        _log.Add((_t, radial, speed));

        if (_t >= DurationSec) { Report(); GetTree().Quit(); }
    }

    void Report()
    {
        // Skip the first few frames: the capsule is settling into contact and
        // its speed has not converged yet.
        var s = _log.Skip(20).ToList();
        if (s.Count == 0) { GD.Print("[Slide] no samples"); return; }

        float rMin = s.Min(x => x.radial), rMax = s.Max(x => x.radial);
        var speeds = s.Select(x => x.speed).OrderBy(x => x).ToList();
        float sMed = speeds[speeds.Count / 2];
        float sMin = speeds[0];
        float sP05 = speeds[(int)(speeds.Count * 0.05)];

        // A snag is a frame where the capsule loses a large fraction of its
        // travel speed. On a seamless ring the only speed variation is the
        // small cosine loss from cornering across facets.
        int snags = s.Count(x => x.speed < sMed * 0.75f);
        // Largest single-frame radial jump — a lip shows here.
        float maxJump = 0f;
        for (int i = 1; i < s.Count; i++)
            maxJump = MathF.Max(maxJump, MathF.Abs(s[i].radial - s[i - 1].radial));

        void P(string l) => GD.Print("[Slide] " + l);
        P("──────────────────────────────────────");
        P($"samples          {s.Count}");
        P($"radial min/max   {rMin:F3} / {rMax:F3}  (spread {(rMax - rMin) * 1000f:F0} mm)");
        P($"speed median     {sMed:F2} m/s   (commanded {RunSpeed})");
        P($"speed 5th pct    {sP05:F2} m/s");
        P($"speed min        {sMin:F2} m/s");
        P($"snag frames      {snags}  (frames under 75% of median speed)");
        P($"max radial jump  {maxJump * 1000f:F1} mm/frame");

        // Where are the slow frames? Clustered at the start = the capsule just
        // settling onto the surface (benign). Evenly spaced = catching on
        // something periodic, i.e. a real per-segment defect.
        var slowIdx = new List<int>();
        for (int i = 0; i < s.Count; i++) if (s[i].speed < sMed * 0.92f) slowIdx.Add(i);
        if (slowIdx.Count > 0)
        {
            P($"slow frame idx   {string.Join(",", slowIdx.Take(24))}" +
              (slowIdx.Count > 24 ? " ..." : ""));
            var gaps = new List<int>();
            for (int i = 1; i < slowIdx.Count; i++) gaps.Add(slowIdx[i] - slowIdx[i - 1]);
            if (gaps.Count > 0)
                P($"slow frame gaps  min={gaps.Min()} max={gaps.Max()} " +
                  $"contiguous={gaps.Count(g => g == 1)}/{gaps.Count}");
        }
        // Criteria reflect what the player actually feels, and are set from the
        // measured subdivision sweep documented at the top of this file:
        //   - wobble is the bump. 140mm (32-gon) is the defect; 20mm is a
        //     generous ceiling that only a properly subdivided ring clears.
        //   - snag frames catch a genuine catch-and-release.
        // Deliberately NOT gated on 5th-percentile speed: the per-triangle
        // internal-edge dip is inherent to concave trimesh and cannot be tuned
        // to zero, so gating on it would make this test permanently red.
        float wobbleMm = (rMax - rMin) * 1000f;
        bool pass = snags == 0 && wobbleMm < 20f;
        P($"PASS={pass}   (no snag frames, wobble {wobbleMm:F0}mm < 20mm)");
        P("──────────────────────────────────────");
    }
}
