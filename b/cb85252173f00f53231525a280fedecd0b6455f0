using Godot;
using System.Collections.Generic;

/// Autoload singleton — owns all persisted game settings.
/// Applies them to the engine immediately on load and on every change.
public partial class GameSettings : Node
{
    public static GameSettings? Instance { get; private set; }

    // Local multiplayer testing (test-online.bat / test-local.bat) launches two
    // copies of the game on one monitor; fullscreen would let only one be visible
    // at a time (the other looks frozen because it stops rendering while
    // occluded). "--test-windowed" is a CUSTOM flag, not Godot's own, so it can't
    // collide with an engine-reserved name. Computed once at static init because
    // ApplyWindow can run before _Ready() finishes deferring (see CallDeferred
    // in _Ready). This only changes what ApplyWindow applies -- the Fullscreen
    // setting itself is never touched, so the saved preference is untouched by
    // testing sessions.
    static readonly bool ForceWindowed = System.Array.IndexOf(OS.GetCmdlineArgs(), "--test-windowed") >= 0;

    // Two stores, split by what the setting actually belongs to.
    //   MachinePath  — properties of THIS PC's display. Shared by every account,
    //                  because a second player on the same machine still has the
    //                  same monitor.
    //   account file — the player's own preferences. Follows the account, so
    //                  signing out and back in restores your reticle and binds.
    // There is no server-side profile store (NetworkManager is a match relay
    // only), so account settings are per-account ON THIS MACHINE — they do not
    // travel to another PC.
    const string MachinePath = "user://settings.cfg";

    static string AccountPath() =>
        AccountManager.AccountDir(AccountManager.ActiveAccount) + "settings.cfg";

    /// True when something changed since the last save. Drives the Save Changes
    /// button and the unsaved-changes prompt.
    public bool Dirty { get; private set; }

    // State as of the last save (or of panel-open), so Discard can put it back.
    ConfigFile? _snapMachine, _snapAccount;

    /// The account-scoped defaults, captured from the property initialisers before
    /// anything is loaded. Switching to an account with no settings file restores
    /// THESE rather than leaving the previous account's values in memory.
    ConfigFile? _accountDefaults;

    void Touch() => Dirty = true;

    public bool  Fullscreen { get; private set; } = true;
    public bool  PSXEffect  { get; private set; } = true;
    public bool  VSync      { get; private set; } = true;
    public float FOV        { get; private set; } = 90f;

    // ── Reticle ───────────────────────────────────────────────────────────────
    // The crosshair's gap still tracks live weapon spread; these settings scale
    // and colour it, they do not override the spread feedback.
    public Color ReticleColor   { get; private set; } = new(1f, 1f, 1f, 0.75f);
    public float ReticleSize    { get; private set; } = 9f;    // tick length, px
    public float ReticleGap     { get; private set; } = 5f;    // gap at zero spread, px
    public float ReticleThick   { get; private set; } = 2f;    // line thickness, px
    public bool  ReticleCenterDot { get; private set; } = true;

    /// How much of the live weapon spread the crosshair shows.
    /// Dynamic = full (the default, and the accuracy mechanic at full strength),
    /// Classic = half, Static = none (fixed gap, spread invisible).
    public enum ReticleStyleMode { Dynamic, Classic, Static }

    public ReticleStyleMode ReticleStyle { get; private set; } = ReticleStyleMode.Dynamic;

    // ── Controls ──────────────────────────────────────────────────────────────
    // Player-facing sensitivity number. PlayerController multiplies its base
    // radians-per-pixel by this, and the base was chosen so 2.0 reproduces the
    // old hardcoded 0.002 exactly -- nobody's aim shifts when they update.
    public float MouseSensitivity  { get; private set; } = 2.0f;
    public float AdsSensMultiplier { get; private set; } = 1.0f;
    public bool  InvertY           { get; private set; } = false;

    /// action -> encoded event, for actions the player has rebound. Actions absent
    /// from this map keep whatever project.godot ships.
    readonly Dictionary<string, string> _binds = new();

    /// project.godot's bindings, snapshotted before any override is applied, so
    /// Reset to Defaults can restore them without reloading the project.
    static readonly Dictionary<string, InputEvent> _defaultBinds = new();

    // Black outline under the arms -- what keeps a light reticle readable against
    // a light wall or a muzzle flash.
    public bool  ReticleOutline      { get; private set; } = true;
    public float ReticleOutlineThick { get; private set; } = 1f;   // px per side

    // T-style drops the top arm, clearing the view above the point of aim.
    public bool  ReticleTStyle       { get; private set; } = false;

    // Alpha is separate from ReticleColor so the colour swatches stay directly
    // comparable and transparency can be switched off wholesale.
    public bool  ReticleUseAlpha     { get; private set; } = true;
    public float ReticleAlpha        { get; private set; } = 0.85f;

    public override void _Ready()
    {
        Instance = this;
        SnapshotDefaultBindings();   // must run BEFORE Load() applies overrides

        // Capture defaults now, before Load() overwrites anything: at this point
        // every property still holds its initialiser, so this is a free, always-
        // accurate snapshot with no second copy of the values to keep in sync.
        _accountDefaults = new ConfigFile();
        WriteTo(new ConfigFile(), _accountDefaults);

        Load();
        // Defer by one frame so the display server is fully initialised
        // before we change window mode; avoids the 1220×780 sizing glitch.
        CallDeferred(MethodName.Apply);
    }

    // ── Setters (apply live, mark dirty; disk write happens on SaveChanges) ───
    // Everything still applies the moment you move a slider -- that is what makes
    // the reticle preview and the FOV/fullscreen changes feel live. Only the
    // WRITE is deferred, so Discard can put the old values back.

    public void SetFullscreen(bool v) { Fullscreen = v; ApplyWindow(); Touch(); }
    public void SetPSXEffect(bool v)  { PSXEffect  = v; ApplyPSX();    Touch(); }
    public void SetVSync(bool v)      { VSync      = v; ApplyVSync();  Touch(); }
    public void SetFOV(float v)       { FOV        = v; Touch(); }   // PlayerController reads on next spawn

    // Reticle setters — SpreadCrosshair reads these every frame, so changes are
    // visible live while the settings panel is open.
    public void SetReticleColor(Color v)   { ReticleColor     = v; Touch(); }
    public void SetReticleSize(float v)    { ReticleSize      = v; Touch(); }
    public void SetReticleGap(float v)     { ReticleGap       = v; Touch(); }
    public void SetReticleThick(float v)   { ReticleThick     = v; Touch(); }
    public void SetReticleCenterDot(bool v){ ReticleCenterDot = v; Touch(); }
    public void SetReticleStyle(ReticleStyleMode v) { ReticleStyle        = v; Touch(); }
    public void SetReticleOutline(bool v)           { ReticleOutline      = v; Touch(); }
    public void SetReticleOutlineThick(float v)     { ReticleOutlineThick = v; Touch(); }
    public void SetReticleTStyle(bool v)            { ReticleTStyle       = v; Touch(); }
    public void SetReticleUseAlpha(bool v)          { ReticleUseAlpha     = v; Touch(); }
    public void SetReticleAlpha(float v)            { ReticleAlpha        = v; Touch(); }

    public void SetMouseSensitivity(float v)  { MouseSensitivity  = v; Touch(); }
    public void SetAdsSensMultiplier(float v) { AdsSensMultiplier = v; Touch(); }
    public void SetInvertY(bool v)            { InvertY           = v; Touch(); }

    // ── Editing session (Save Changes / Discard) ──────────────────────────────

    /// Called when the settings screen opens. Snapshots current state so Discard
    /// has something to restore.
    public void BeginEditing()
    {
        _snapMachine = new ConfigFile();
        _snapAccount = new ConfigFile();
        WriteTo(_snapMachine, _snapAccount);
        Dirty = false;
    }

    /// Writes both stores to disk and re-baselines, so the next Discard reverts to
    /// what was just saved rather than to what the panel opened with.
    public void SaveChanges()
    {
        var machine = new ConfigFile();
        var account = new ConfigFile();
        WriteTo(machine, account);
        machine.Save(MachinePath);

        // The account directory exists for any signed-in account; if somehow no
        // account is active the per-account write is skipped rather than creating
        // a stray "user://accounts//settings.cfg".
        if (!string.IsNullOrEmpty(AccountManager.ActiveAccount))
            account.Save(AccountPath());

        BeginEditing();   // re-snapshot at the newly saved state
        GD.Print($"[SETTINGS] Saved (account={AccountManager.ActiveAccount}).");
    }

    /// Puts every value back to the snapshot and re-applies it, including window
    /// mode and key bindings.
    public void DiscardChanges()
    {
        if (_snapMachine == null || _snapAccount == null) { Dirty = false; return; }
        ReadFrom(_snapMachine, _snapAccount);
        Apply();
        Dirty = false;
    }

    /// Re-reads the per-account store after a sign-in / switch-user. Machine
    /// settings are deliberately left alone -- the monitor did not change.
    public void ReloadForAccount()
    {
        // Reset FIRST. Without this, switching to an account that has never saved
        // settings silently keeps the previous account's reticle, sensitivity and
        // key bindings -- the new player inherits a stranger's config.
        if (_accountDefaults != null) ReadAccount(_accountDefaults);

        var account = new ConfigFile();
        if (account.Load(AccountPath()) == Error.Ok) ReadAccount(account);

        Apply();
        BeginEditing();
    }

    // ── Key bindings ──────────────────────────────────────────────────────────

    /// Every non-engine action, in InputMap order. Godot's built-in ui_* actions
    /// are engine plumbing and are never exposed for rebinding.
    public static IEnumerable<string> BindableActionNames()
    {
        foreach (var a in InputMap.GetActions())
        {
            string name = a.ToString();
            if (!name.StartsWith("ui_")) yield return name;
        }
    }

    static void SnapshotDefaultBindings()
    {
        if (_defaultBinds.Count > 0) return;   // autoloads construct once, but be safe
        foreach (var name in BindableActionNames())
            foreach (var ev in InputMap.ActionGetEvents(name))
                if (ev is InputEventKey or InputEventMouseButton)
                {
                    _defaultBinds[name] = ev;
                    break;
                }
    }

    /// Rebinds an action to a single event, replacing whatever it had.
    public void SetBinding(string action, InputEvent ev)
    {
        if (!InputMap.HasAction(action)) return;
        _binds[action] = Encode(ev);
        ApplyBindings();
        Touch();
    }

    /// Removes an action's binding entirely -- used when a key is stolen by another
    /// action, so the loser is visibly unbound rather than silently double-bound.
    public void ClearBinding(string action)
    {
        if (!InputMap.HasAction(action)) return;
        _binds[action] = "";
        ApplyBindings();
        Touch();
    }

    public void ResetBindings()
    {
        _binds.Clear();
        ApplyBindings();   // with no overrides left, this restores project.godot
        Touch();
    }

    /// Compact, human-legible encoding so a hand-edited settings.cfg stays sane.
    /// Keys use the PHYSICAL keycode: a rebind should follow the key's position,
    /// not the layout, or the same config breaks on AZERTY.
    static string Encode(InputEvent ev) => ev switch
    {
        InputEventKey k         => $"k:{(int)(k.PhysicalKeycode != 0 ? k.PhysicalKeycode : k.Keycode)}",
        InputEventMouseButton m => $"m:{(int)m.ButtonIndex}",
        _                       => "",
    };

    static InputEvent? Decode(string enc)
    {
        if (string.IsNullOrEmpty(enc) || enc.Length < 3) return null;
        if (!int.TryParse(enc[2..], out int code)) return null;
        return enc[0] switch
        {
            'k' => new InputEventKey   { PhysicalKeycode = (Key)code },
            'm' => new InputEventMouseButton { ButtonIndex = (MouseButton)code },
            _   => null,
        };
    }

    void ApplyBindings()
    {
        // Rebuild from project.godot's defaults every time. Applying overrides on
        // top of whatever InputMap currently holds would make Discard and Reset
        // no-ops for any key that had already been changed this session.
        foreach (var (action, ev) in _defaultBinds)
        {
            if (!InputMap.HasAction(action)) continue;
            InputMap.ActionEraseEvents(action);
            InputMap.ActionAddEvent(action, ev);
        }

        foreach (var (action, enc) in _binds)
        {
            if (!InputMap.HasAction(action)) continue;
            InputMap.ActionEraseEvents(action);
            // An empty encoding means "deliberately unbound" (lost a conflict),
            // so the action correctly ends up with no events at all.
            var ev = Decode(enc);
            if (ev != null) InputMap.ActionAddEvent(action, ev);
        }
    }

    // ── Apply ─────────────────────────────────────────────────────────────────

    void Apply()
    {
        ApplyWindow();
        ApplyVSync();
        ApplyPSX();
        ApplyBindings();
        // FOV is read by PlayerController at spawn; no runtime push needed here
    }

    void ApplyWindow()
    {
        // ForceWindowed overrides the applied mode only -- Fullscreen (the saved
        // preference) is read as-is everywhere else, so nothing here persists.
        if (ForceWindowed)
        {
            DisplayServer.WindowSetMode(DisplayServer.WindowMode.Windowed);
            // CLI --resolution/--position sizing is unreliable once we re-apply
            // our own window mode above, so pin a small size here instead.
            DisplayServer.WindowSetSize(new Vector2I(960, 540));
            return;
        }

        DisplayServer.WindowSetMode(Fullscreen
            ? DisplayServer.WindowMode.Fullscreen
            : DisplayServer.WindowMode.Windowed);
    }

    void ApplyVSync()
    {
        DisplayServer.WindowSetVsyncMode(VSync
            ? DisplayServer.VSyncMode.Enabled
            : DisplayServer.VSyncMode.Disabled);
    }

    void ApplyPSX()
    {
        // PSXOverlay may not be ready yet on first call from _Ready — null-safe
        PSXOverlay.Instance?.SetUserEnabled(PSXEffect);
    }

    // ── Persistence ───────────────────────────────────────────────────────────

    void Load()
    {
        var machine = new ConfigFile();
        bool haveMachine = machine.Load(MachinePath) == Error.Ok;
        if (haveMachine) ReadMachine(machine);

        var account = new ConfigFile();
        bool haveAccount = !string.IsNullOrEmpty(AccountManager.ActiveAccount)
                        && account.Load(AccountPath()) == Error.Ok;

        if (haveAccount)
        {
            ReadAccount(account);
        }
        else if (haveMachine)
        {
            // Legacy layout: everything used to live in one global settings.cfg.
            // Read the player-preference half out of it so an existing player does
            // not lose their reticle and binds on the first run after the split.
            // The next SaveChanges writes them to the account file.
            ReadAccount(machine);
        }

        BeginEditing();
    }

    void ReadFrom(ConfigFile machine, ConfigFile account)
    {
        ReadMachine(machine);
        ReadAccount(account);
    }

    void ReadMachine(ConfigFile cfg)
    {
        Fullscreen = (bool)cfg.GetValue("display",  "fullscreen", Fullscreen);
        VSync      = (bool)cfg.GetValue("display",  "vsync",      VSync);
        PSXEffect  = (bool)cfg.GetValue("graphics", "psx_effect", PSXEffect);
    }

    void ReadAccount(ConfigFile cfg)
    {
        FOV = (float)cfg.GetValue("graphics", "fov", FOV);

        ReticleColor     = (Color)cfg.GetValue("reticle", "color",      ReticleColor);
        ReticleSize      = (float)cfg.GetValue("reticle", "size",       ReticleSize);
        ReticleGap       = (float)cfg.GetValue("reticle", "gap",        ReticleGap);
        ReticleThick     = (float)cfg.GetValue("reticle", "thickness",  ReticleThick);
        ReticleCenterDot = (bool) cfg.GetValue("reticle", "center_dot", ReticleCenterDot);

        // Enum persists as int so a hand-edited settings.cfg stays readable and a
        // future reordering of the enum cannot silently remap a saved value.
        ReticleStyle        = (ReticleStyleMode)(int)cfg.GetValue("reticle", "style", (int)ReticleStyle);
        ReticleOutline      = (bool) cfg.GetValue("reticle", "outline",       ReticleOutline);
        ReticleOutlineThick = (float)cfg.GetValue("reticle", "outline_thick", ReticleOutlineThick);
        ReticleTStyle       = (bool) cfg.GetValue("reticle", "t_style",       ReticleTStyle);
        ReticleUseAlpha     = (bool) cfg.GetValue("reticle", "use_alpha",     ReticleUseAlpha);
        ReticleAlpha        = (float)cfg.GetValue("reticle", "alpha",         ReticleAlpha);

        MouseSensitivity  = (float)cfg.GetValue("controls", "sensitivity", MouseSensitivity);
        AdsSensMultiplier = (float)cfg.GetValue("controls", "ads_mult",    AdsSensMultiplier);
        InvertY           = (bool) cfg.GetValue("controls", "invert_y",    InvertY);

        _binds.Clear();
        if (cfg.HasSection("keybinds"))
            foreach (var key in cfg.GetSectionKeys("keybinds"))
                _binds[key] = (string)cfg.GetValue("keybinds", key, "");
    }

    void WriteTo(ConfigFile machine, ConfigFile account)
    {
        machine.SetValue("display",  "fullscreen", Fullscreen);
        machine.SetValue("display",  "vsync",      VSync);
        machine.SetValue("graphics", "psx_effect", PSXEffect);

        account.SetValue("graphics", "fov",        FOV);
        account.SetValue("reticle",  "color",      ReticleColor);
        account.SetValue("reticle",  "size",       ReticleSize);
        account.SetValue("reticle",  "gap",        ReticleGap);
        account.SetValue("reticle",  "thickness",  ReticleThick);
        account.SetValue("reticle",  "center_dot", ReticleCenterDot);
        account.SetValue("reticle",  "style",         (int)ReticleStyle);
        account.SetValue("reticle",  "outline",       ReticleOutline);
        account.SetValue("reticle",  "outline_thick", ReticleOutlineThick);
        account.SetValue("reticle",  "t_style",       ReticleTStyle);
        account.SetValue("reticle",  "use_alpha",     ReticleUseAlpha);
        account.SetValue("reticle",  "alpha",         ReticleAlpha);
        account.SetValue("controls", "sensitivity", MouseSensitivity);
        account.SetValue("controls", "ads_mult",    AdsSensMultiplier);
        account.SetValue("controls", "invert_y",    InvertY);
        foreach (var (action, enc) in _binds) account.SetValue("keybinds", action, enc);
    }
}
