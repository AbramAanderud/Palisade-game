using System.Collections.Generic;
using System.Linq;
using Godot;

/// res://scripts/PitBuilder.cs — Geometry for one 3x3 vertical shaft.
///
/// A Pit is stored as ONE MazePiece at the shaft's centre cell. It claims a 3x3
/// footprint across three floors (anchor floor, one up, one down), clipped to the
/// world's floor range: a pit placed at the top floor simply loses its upper level
/// and stays valid.
///
/// The ENTIRE 3x3 is open shaft. Any cell face on the shaft's perimeter, on any
/// occupied floor, with a piece pointing at it becomes a floating doorway — you
/// step through it into thin air. That is the intended feel.
///
/// The pit deals NO damage. It is a traversal piece: you drop, you land, you walk
/// out through a doorway at the bottom level. Do not add damage here.
///
/// ── MESH SPLITTING ──────────────────────────────────────────────────────────
/// A pit is 30m x 30m across and up to 54m tall — the worst case in the whole game
/// for the GL per-object light cap (see DungeonBuilder.cs:156-160: a large merged
/// mesh is only lit near its bounding-box centre, leaving corners dark).
/// RoomBuilder hit this exact bug already and was fixed to emit geometry per cell —
/// this class does the same: one StaticBody3D per (footprint cell, occupied floor),
/// named `Cell_{x}_{y}_{floor}` to match DungeonBuilder.BuildFloor's convention.
/// The shaft bottom splits across its 9 cells; each wall segment already belongs to
/// exactly one cell and floor; the vault cap splits across the top level's 9 cells.
///
/// This changes only how triangles are PACKAGED, never which triangles are generated
/// or where their vertices sit. In particular the vault's arch function is always
/// evaluated against the FULL 30 m shaft span (shaftX0..shaftX1), never a single
/// cell's own extent, so adjacent cells' slices meet at identical heights and the
/// cap reads as one continuous vault with no ridge at the cell seams.
public static class PitBuilder
{
    const float CS = DungeonBuilder.CellSize;
    const float FH = DungeonBuilder.FloorHeight;
    const float HW = DungeonBuilder.OpeningW * 0.5f;   // 3 m — half doorway width

    /// Doorway opening height, matching the room treatment so the two read as a set.
    const float DoorH = RoomBuilder.RoomDoorH;

    static readonly Dir[] Faces = { Dir.N, Dir.E, Dir.S, Dir.W };

    /// Floors this pit actually occupies, clipped to [floorMin, floorMax].
    /// Ascending order. Always contains at least the anchor floor.
    public static int[] OccupiedFloors(int anchorFloor, int floorMin, int floorMax)
        => PieceDB.FloorSpan(PieceType.Pit)
            .Select(d => anchorFloor + d)
            .Where(f => f >= floorMin && f <= floorMax)
            .OrderBy(f => f)
            .ToArray();

    /// True when this pit's clipped volume covers cell (x, y) on `floor`.
    public static bool Occupies(MazePiece pit, int x, int y, int floor,
                                int floorMin, int floorMax)
    {
        if (pit.Type != PieceType.Pit) return false;
        if (!OccupiedFloors(pit.Floor, floorMin, floorMax).Contains(floor)) return false;
        return PieceDB.Footprint(PieceType.Pit)
            .Any(o => pit.X + o.dx == x && pit.Y + o.dy == y);
    }

    /// Builds one pit into `owner`, one StaticBody3D per (footprint cell, occupied
    /// floor) — see the class doc comment for why per-cell packaging is required.
    public static void Build(DungeonBuilder owner, MazePiece pit,
                             Dictionary<(int, int, int), MazePiece> lookup,
                             int floorMin, int floorMax)
    {
        int[] floors = OccupiedFloors(pit.Floor, floorMin, floorMax);
        if (floors.Length == 0) return;

        int botFloor = floors[0];
        int topFloor = floors[^1];

        // Full 30 m footprint extents — used only as the ArchY domain so every
        // cell's vault slice agrees on height at shared edges (see class doc).
        float shaftX0 = (pit.X - 1) * CS, shaftX1 = (pit.X + 2) * CS;
        float yBot     = botFloor * FH;
        float yTopBase = topFloor * FH;

        var footprint = PieceDB.Footprint(PieceType.Pit);

        foreach (int f in floors)
        {
            float fy0 = f * FH, fy1 = fy0 + FH;

            foreach (var (dx, dy) in footprint)
            {
                int cx = pit.X + dx, cy = pit.Y + dy;
                float cx0 = cx * CS, cz0 = cy * CS;
                float cx1 = cx0 + CS, cz1 = cz0 + CS;

                var wallST  = DungeonBuilder.MakeST();
                var floorST = DungeonBuilder.MakeST();
                var ceilST  = DungeonBuilder.MakeST();
                // Corridor-facing side of the arched doorway heads — see
                // RoomBuilder.ArchedDoorHead for why this cannot share wallST.
                var sealST  = DungeonBuilder.MakeST();

                // Ceiling above a doorway on THIS floor. The shaft is open all the
                // way up, so only the top floor has a real cap to clip against;
                // every lower floor is bounded by nothing but the next floor level.
                System.Func<float, float, float> ceilAt = f == topFloor
                    ? (x, z) => ArchY(x, shaftX0, shaftX1, yTopBase)
                    : (x, z) => fy1;

                // ── Shaft bottom ─────────────────────────────────────────────
                // Solid landing at the lowest occupied floor, split into this
                // cell's own 10x10 tile. Free traversal: you land here unhurt
                // and walk out through a bottom-level doorway.
                if (f == botFloor)
                    DungeonBuilder.Quad(floorST, new(cx0, yBot, cz0), new(cx1, yBot, cz0),
                                                 new(cx1, yBot, cz1), new(cx0, yBot, cz1));

                // ── Shaft walls, one segment per perimeter face on this cell/floor ──
                // Interior faces of the 3x3 (dx/dy pointing at a neighboring
                // footprint cell) are skipped — that's the open shaft interior.
                foreach (var face in Faces)
                {
                    if (!IsPerimeterFace(dx, dy, face)) continue;
                    bool door = HasEntry(lookup, pit, cx, cy, f, face, floorMin, floorMax);
                    AddWallSegment(wallST, sealST, cx, cy, fy0, fy1, face, door, ceilAt);
                    // A small landing lip juts into the shaft at the base of every
                    // doorway, so you step onto a ledge instead of straight into the
                    // fall — and have somewhere to catch yourself on the way up. The
                    // bottom floor already has a full slab, so it needs no lip.
                    if (door && f != botFloor)
                        AddDoorwayLip(floorST, cx, cy, fy0, face);
                }

                // ── Vault cap ─────────────────────────────────────────────────
                // Only the top occupied floor's slice; same arch treatment as a
                // room so the two new piece types share one ceiling language.
                if (f == topFloor)
                    AddVaultSlice(ceilST, cx0, cz0, cx1, cz1, shaftX0, shaftX1, yTopBase);

                var body = new StaticBody3D { Name = $"Cell_{cx}_{cy}_{f}" };
                owner.AddChild(body);
                // The "Floor" PREFIX IS LOAD-BEARING: DungeonBuilder.AddMesh picks the
                // material with name.StartsWith("Floor") || name.StartsWith("Stair").
                // A name like "PitFloor_…" starts with "Pit" and would silently get
                // the WALL material. This exact bug already shipped once in
                // RoomBuilder — do not reintroduce it.
                owner.AddMesh(body, DungeonBuilder.Commit(floorST), $"FloorPit_{cx}_{cy}", default);
                owner.AddMesh(body, DungeonBuilder.Commit(wallST),  $"WallPit_{cx}_{cy}",  default);
                owner.AddMesh(body, DungeonBuilder.Commit(ceilST),  $"CeilPit_{cx}_{cy}",  default);
                owner.AddMesh(body, DungeonBuilder.Commit(sealST),  $"WallPitSeal_{cx}_{cy}", default);
            }
        }

        AddShaftLights(owner, pit, floors);
        AddTrampoline(owner, pit, botFloor);
    }

    // Depth a doorway landing lip juts into the shaft, in metres.
    const float LipDepth = 1.6f;

    /// A thin walkable ledge at the base of a doorway, protruding into the shaft so a
    /// player can stand at the threshold (and catch a doorway on the way up) rather
    /// than only ever falling through. Added to the cell's FloorPit mesh, so it gets
    /// the floor material and collision. Wound normal-up like the shaft floor slab.
    static void AddDoorwayLip(SurfaceTool st, int cx, int cy, float fy0, Dir face)
    {
        float x0 = cx * CS, z0 = cy * CS, x1 = x0 + CS, z1 = z0 + CS;
        float xc = x0 + CS * 0.5f, zc = z0 + CS * 0.5f;
        float y  = fy0 + 0.02f;   // hair above the floor plane to avoid z-fighting a slab below
        switch (face)
        {
            case Dir.N:
                DungeonBuilder.Quad(st, new(xc - HW, y, z0), new(xc + HW, y, z0),
                                        new(xc + HW, y, z0 + LipDepth), new(xc - HW, y, z0 + LipDepth));
                break;
            case Dir.S:
                DungeonBuilder.Quad(st, new(xc - HW, y, z1 - LipDepth), new(xc + HW, y, z1 - LipDepth),
                                        new(xc + HW, y, z1), new(xc - HW, y, z1));
                break;
            case Dir.W:
                DungeonBuilder.Quad(st, new(x0, y, zc - HW), new(x0 + LipDepth, y, zc - HW),
                                        new(x0 + LipDepth, y, zc + HW), new(x0, y, zc + HW));
                break;
            default: // Dir.E
                DungeonBuilder.Quad(st, new(x1 - LipDepth, y, zc - HW), new(x1, y, zc - HW),
                                        new(x1, y, zc + HW), new(x1 - LipDepth, y, zc + HW));
                break;
        }
    }

    /// A trampoline on the shaft's bottom-centre cell. Landing on it flings the player
    /// back up the shaft with a brief window of much stronger air control, turning the
    /// pit from a one-way drop into a movement loop: fall in, bounce out, steer to a
    /// doorway. See PitTrampolineNode for the launch behaviour.
    // Trampoline proportions, in metres above the shaft floor.
    const float TrampR   = 3.8f;    // frame radius (7.6 m across — fits the 10 m cell)
    const float TrampTop = 1.2f;    // mat/rim height, aligned with the launch trigger

    static void AddTrampoline(DungeonBuilder owner, MazePiece pit, int botFloor)
    {
        float cx = pit.X * CS + CS * 0.5f;
        float cz = pit.Y * CS + CS * 0.5f;
        float y  = botFloor * FH;
        float yr = y + TrampTop;   // rim / mat height in world space

        var frame = new Node3D { Name = $"PitTrampoline_{pit.X}_{pit.Y}" };
        owner.AddChild(frame);

        var steel = new StandardMaterial3D
        {
            AlbedoColor = new Color(0.15f, 0.16f, 0.20f), Metallic = 0.85f, Roughness = 0.32f,
        };
        var springMat = new StandardMaterial3D
        {
            AlbedoColor = new Color(0.58f, 0.60f, 0.66f), Metallic = 0.9f, Roughness = 0.22f,
        };
        // The mat itself is dark taut fabric with a faint green glow — reads as a special
        // "springy" surface and stays visible in the near-black shaft, without a torch.
        var matFabric = new StandardMaterial3D
        {
            AlbedoColor              = new Color(0.05f, 0.09f, 0.07f),
            EmissionEnabled          = true,
            Emission                 = new Color(0.07f, 0.45f, 0.27f),
            EmissionEnergyMultiplier = 0.55f,
            Metallic                 = 0.1f, Roughness = 0.7f,
        };

        // Padded steel rim (torus) around the outside.
        frame.AddChild(new MeshInstance3D
        {
            Name = "Rim",
            Mesh = new TorusMesh { InnerRadius = TrampR - 0.24f, OuterRadius = TrampR + 0.24f, Rings = 24, RingSegments = 12 },
            MaterialOverride = steel,
            Position = new Vector3(cx, yr, cz),
        });

        // Taut mat, a thin disc just inside the rim.
        frame.AddChild(new MeshInstance3D
        {
            Name = "Mat",
            Mesh = new CylinderMesh { TopRadius = TrampR - 0.40f, BottomRadius = TrampR - 0.40f, Height = 0.06f, RadialSegments = 28 },
            MaterialOverride = matFabric,
            Position = new Vector3(cx, yr - 0.02f, cz),
        });

        // Six legs splaying out from the rim down to the shaft floor.
        const int Legs = 6;
        for (int i = 0; i < Legs; i++)
        {
            float a = i * Mathf.Tau / Legs + 0.35f;
            var top  = new Vector3(cx + Mathf.Cos(a) * TrampR,          yr,        cz + Mathf.Sin(a) * TrampR);
            var foot = new Vector3(cx + Mathf.Cos(a) * (TrampR + 0.8f), y + 0.05f, cz + Mathf.Sin(a) * (TrampR + 0.8f));
            frame.AddChild(Strut(top, foot, 0.14f, steel, "Leg"));
        }

        // A ring of springs joining the mat edge to the frame — slightly raised at the
        // rim so they angle up-and-out like real trampoline springs.
        const int Springs = 26;
        for (int i = 0; i < Springs; i++)
        {
            float a = i * Mathf.Tau / Springs;
            var inner = new Vector3(cx + Mathf.Cos(a) * (TrampR - 0.42f), yr - 0.04f, cz + Mathf.Sin(a) * (TrampR - 0.42f));
            var outer = new Vector3(cx + Mathf.Cos(a) * (TrampR - 0.04f), yr + 0.06f, cz + Mathf.Sin(a) * (TrampR - 0.04f));
            frame.AddChild(Strut(inner, outer, 0.05f, springMat, "Spring"));
        }

        // Launch trigger — a slab of air just above the mat that catches a downward-
        // moving player mid-fall. Unchanged behaviour; only the visuals got richer.
        var node = new PitTrampolineNode { Name = $"Trampoline_{pit.X}_{pit.Y}" };
        node.AddChild(new CollisionShape3D { Shape = new BoxShape3D { Size = new Vector3(CS, 2.0f, CS) } });
        node.Position = new Vector3(cx, yr, cz);
        owner.AddChild(node);
    }

    /// A capsule-thin cylinder spanning two points, for trampoline legs and springs.
    /// CylinderMesh is Y-aligned, so rotate its up axis onto the (b - a) direction.
    static MeshInstance3D Strut(Vector3 a, Vector3 b, float radius, Material mat, string name)
    {
        Vector3 d = b - a;
        float len = d.Length();
        Vector3 dir = len > 1e-5f ? d / len : Vector3.Up;

        Basis basis;
        Vector3 axis = Vector3.Up.Cross(dir);
        if (axis.LengthSquared() < 1e-8f)
            basis = Vector3.Up.Dot(dir) < 0f ? new Basis(Vector3.Right, Mathf.Pi) : Basis.Identity;
        else
            basis = new Basis(axis.Normalized(), Mathf.Acos(Mathf.Clamp(Vector3.Up.Dot(dir), -1f, 1f)));

        return new MeshInstance3D
        {
            Name             = name,
            Mesh             = new CylinderMesh { TopRadius = radius, BottomRadius = radius, Height = len, RadialSegments = 8 },
            MaterialOverride = mat,
            Transform        = new Transform3D(basis, (a + b) * 0.5f),
        };
    }

    /// Lights the shaft.
    ///
    /// A pit is 30 m across and up to 54 m tall — far too big for the corridor torch
    /// (range 13) that AddTorches would otherwise drop at the anchor cell. One such
    /// light in the middle of a volume this size leaves the whole shaft unreadable,
    /// and the player still has to see the doorways to aim for one on the way down.
    ///
    /// So: one wide-range light per occupied floor, hung at that floor's doorway
    /// height rather than mid-volume, so each level's openings are the lit thing.
    /// Registering the anchor cell in TorchByCell also suppresses AddTorches' fallback
    /// torch for this piece (it skips any cell already present), which is what stops a
    /// second, far too dim light appearing in the same shaft.
    static void AddShaftLights(DungeonBuilder owner, MazePiece pit, int[] floors)
    {
        float cx = pit.X * CS + CS * 0.5f;
        float cz = pit.Y * CS + CS * 0.5f;

        for (int i = 0; i < floors.Length; i++)
        {
            var light = new OmniLight3D
            {
                Name            = $"PitLight_{pit.X}_{pit.Y}_{floors[i]}",
                Position        = new Vector3(cx, floors[i] * FH + DoorH * 0.75f, cz),
                LightColor      = new Color(1.0f, 0.66f, 0.24f),
                LightEnergy     = 3.2f,
                OmniRange       = 30f,   // must cross the 30 m shaft, not just one cell
                OmniAttenuation = 0.8f,
                ShadowEnabled   = false,
            };
            owner.AddChild(light);

            // Claim the anchor cell once so AddTorches' fallback skips this piece.
            if (i == 0)
                owner.TorchByCell[(pit.X, pit.Y, pit.Floor)] = light;
        }
    }

    /// True when the given face of footprint offset (dx, dy) is on the 3x3's outer edge.
    static bool IsPerimeterFace(int dx, int dy, Dir face) => face switch
    {
        Dir.N => dy == -1,
        Dir.S => dy ==  1,
        Dir.W => dx == -1,
        _     => dx ==  1,
    };

    /// True when a piece outside the pit points at this face on this floor.
    /// Any piece with a matching opening qualifies — the requirement is
    /// "any slot that could be connected is valid".
    static bool HasEntry(Dictionary<(int, int, int), MazePiece> lookup, MazePiece pit,
                         int cx, int cy, int floor, Dir face, int floorMin, int floorMax)
    {
        var (dx, dy) = PieceDB.Delta(face);
        int nx = cx + dx, ny = cy + dy;

        // Never open a doorway into our own volume.
        if (Occupies(pit, nx, ny, floor, floorMin, floorMax)) return false;

        if (!lookup.TryGetValue((nx, ny, floor), out var nb)) return false;
        return PieceDB.HasSameFloorOpening(nb.Type, nb.Rotation, PieceDB.Opposite(face));
    }

    /// One 10 m wall segment: solid, or split around a 6 m doorway.
    ///
    /// The head above a doorway is NOT a flat lintel — it follows the arched
    /// cross-section of the corridor on the other side (RoomBuilder.ArchedDoorHead),
    /// so the hallway's vault runs into the shaft opening instead of dying against a
    /// straight edge, and the strip above it is sealed from the corridor side too.
    static void AddWallSegment(SurfaceTool st, SurfaceTool sealST, int cx, int cy,
                               float fy0, float fy1, Dir face, bool doorway,
                               System.Func<float, float, float> ceilAt)
    {
        float x0 = cx * CS, z0 = cy * CS;
        float x1 = x0 + CS, z1 = z0 + CS;
        float xc = x0 + CS * 0.5f, zc = z0 + CS * 0.5f;

        // One band of wall on this face. normalSign points the face INTO the shaft.
        void Band(float a, float b, float yLo, float yHi)
        {
            if (yHi - yLo < 0.001f || b - a < 0.001f) return;
            switch (face)
            {
                case Dir.N: DungeonBuilder.EWWall(st, z0, a, b, yLo, yHi, +1); break;
                case Dir.S: DungeonBuilder.EWWall(st, z1, a, b, yLo, yHi, -1); break;
                case Dir.W: DungeonBuilder.NSWall(st, x0, a, b, yLo, yHi, +1); break;
                default:    DungeonBuilder.NSWall(st, x1, a, b, yLo, yHi, -1); break;
            }
        }

        bool  alongX = face == Dir.N || face == Dir.S;
        float fLo = alongX ? x0 : z0;
        float fHi = alongX ? x1 : z1;
        float oLo = (alongX ? xc : zc) - HW;
        float oHi = (alongX ? xc : zc) + HW;

        if (!doorway)
        {
            Band(fLo, fHi, fy0, fy1);
            return;
        }

        // Each flank is split at ITS jamb height so the arched head's end vertices
        // meet a matching vertex instead of a T-junction — see RoomBuilder.DoorJambY.
        var (jLo, jHi) = RoomBuilder.DoorJambY(face, cx, cy, fy0, fy1, ceilAt);
        Band(fLo, oLo, fy0, jLo);   Band(fLo, oLo, jLo, fy1);
        Band(oHi, fHi, fy0, jHi);   Band(oHi, fHi, jHi, fy1);

        RoomBuilder.ArchedDoorHead(st, sealST, face, cx, cy, fy0, fy1, ceilAt);
    }

    /// One cell's slice of the barrel vault capping the shaft. Arcs across X
    /// (evaluated against the FULL shaft span so slices agree at shared edges),
    /// runs flat along Z within this cell's own 10 m depth.
    static void AddVaultSlice(SurfaceTool st, float x0, float z0, float x1, float z1,
                              float shaftX0, float shaftX1, float yBase)
    {
        const int N = 8;   // 10 m cell / 8 slices == the same density as 24 slices over 30 m
        for (int i = 0; i < N; i++)
        {
            float xa = x0 + (x1 - x0) * i / N;
            float xb = x0 + (x1 - x0) * (i + 1) / N;
            float ya = ArchY(xa, shaftX0, shaftX1, yBase);
            float yb = ArchY(xb, shaftX0, shaftX1, yBase);
            DungeonBuilder.Quad(st, new(xa, ya, z1), new(xb, yb, z1),
                                    new(xb, yb, z0), new(xa, ya, z0));
        }
    }

    static float ArchY(float v, float v0, float v1, float yBase)
    {
        float half = (v1 - v0) * 0.5f;
        if (half <= 0.001f) return yBase + RoomBuilder.RoomPeakY;
        float t = Mathf.Clamp((v - (v0 + half)) / half, -1f, 1f);
        return yBase + RoomBuilder.RoomPeakY
             - (RoomBuilder.RoomPeakY - RoomBuilder.RoomSpringY) * t * t;
    }
}

/// Flings the player back up the shaft when they land on the pit trampoline, with a
/// short window of stronger air control so they can steer to a doorway on the way up.
/// No damage — the pit stays a traversal piece; the trampoline turns the drop into a
/// bounce rather than a dead end.
public sealed partial class PitTrampolineNode : Area3D
{
    // 44 m/s against the player's 22 gravity rises ~44 m — roughly two-and-a-half
    // floors — so a bounce from the bottom clears back up past the top doorways of a
    // full three-floor pit. BoostTime is how long the stronger air control lasts.
    const float LaunchSpeed = 44f;
    const float BoostTime   = 1.6f;

    float _cooldown = 0f;

    public override void _Ready()
    {
        Monitoring  = true;
        BodyEntered += OnEnter;
    }

    public override void _PhysicsProcess(double delta)
    {
        if (_cooldown > 0f) _cooldown -= (float)delta;
    }

    void OnEnter(Node3D body)
    {
        if (_cooldown > 0f) return;
        if (body is not PlayerController p) return;
        // Only fire while the player is NOT moving upward, so the launch doesn't
        // re-trigger as they rise back out through the trigger volume.
        if (p.Velocity.Y > 1.0f) return;
        _cooldown = 0.4f;
        p.LaunchUp(LaunchSpeed, BoostTime);
    }
}
