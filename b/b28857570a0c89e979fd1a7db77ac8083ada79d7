using System;
using System.Collections.Generic;
using System.Linq;
using Godot;

public enum Door { N = 0, E = 1, S = 2, W = 3 }

public sealed class SeatPlacement
{
    public Door    Door;
    public int     QuarterTurns;   // MazeRotation.Rotate(data, QuarterTurns) before building
    public Vector3 Offset;         // DungeonBuilder world offset of the ROTATED maze (arena-centred frame)
    public float   DoorAngle;      // ArenaBuilder convention: 0 = north, clockwise
    public Dir     ExitOpenDir;    // DungeonBuilder.Build exitOpenDir (the face toward the arena)
    public Vector3 HallStart;      // on the door axis at the arena wall (y = 0)
    public Vector3 HallEnd;        // on the door axis at the maze Exit face (y = 0)
    public MazeFootprint Rotated = null!;
}

public sealed class PlusLayoutResult
{
    public int             HallCells;
    public float           HallLength => HallCells * DungeonBuilder.CellSize;
    public SeatPlacement[] Seats = Array.Empty<SeatPlacement>();
    public float[]         DoorAngles => Seats.Select(s => s.DoorAngle).ToArray();
    public float            Apothem;   // set by Place; WithHall reads it back

    /// Which seat's maze or hallway contains p (arena-centred frame), or −1 for
    /// the arena / anywhere else. Exact per-column test, so irregular mazes whose
    /// bounding boxes overlap never get confused.
    public int SeatAt(Vector3 p)
    {
        for (int i = 0; i < Seats.Length; i++)
        {
            var s = Seats[i];
            if (HallCells > 0 && PlusLayout.HallBox(s, HallLength).HasPoint(p)) return i;
            int gx = Mathf.FloorToInt((p.X - s.Offset.X) / DungeonBuilder.CellSize);
            int gy = Mathf.FloorToInt((p.Z - s.Offset.Z) / DungeonBuilder.CellSize);
            if (s.Rotated.Columns.TryGetValue((gx, gy), out var span) &&
                MazeFootprint.ColumnBox(gx, gy, span.lo, span.hi).Grow(0.01f).HasPoint(
                    new Vector3(p.X - s.Offset.X, p.Y, p.Z - s.Offset.Z)))
                return i;
        }
        return -1;
    }
}

/// res://scripts/PlusLayout.cs — the FFA "plus sign": one maze per arena door.
///
/// Seat i gets door DoorsFor(n)[i]. Its maze data is turned by (int)Door
/// quarter turns (the Exit's arena side, Dir.S in the editor frame, rotates to
/// face the arena). The maze is placed so its Exit cell sits on the door axis
/// with its arena-side face at apothem + L.
///
/// L (the same for every hallway, so travel is fair) is the SHORTEST whole-cell
/// length at which no two mazes' occupied columns overlap in 3D, with each
/// maze's columns grown by `margin`. Mazes on non-overlapping floors can
/// therefore sit closer. L is forced to 0 for 2 seats (1v1 geometry is unchanged).
public static class PlusLayout
{
    public const int MaxHallCells = 10;   // worst case is 7; the hallway lookup stays inside a 10-cell strip

    public static Door[] DoorsFor(int seats) => seats switch
    {
        2 => new[] { Door.N, Door.S },
        3 => new[] { Door.N, Door.E, Door.W },
        4 => new[] { Door.N, Door.E, Door.S, Door.W },
        _ => throw new ArgumentOutOfRangeException(nameof(seats), "FFA supports 2–4 seats"),
    };

    public static Vector3 DoorDir(Door d) => d switch
    {
        Door.N => new Vector3(0f, 0f, -1f),
        Door.E => new Vector3(1f, 0f, 0f),
        Door.S => new Vector3(0f, 0f, 1f),
        _      => new Vector3(-1f, 0f, 0f),
    };

    public static float DoorAngle(Door d) => (int)d * Mathf.Pi * 0.5f;

    static Dir TowardArena(Door d) => d switch { Door.N => Dir.S, Door.E => Dir.W, Door.S => Dir.N, _ => Dir.E };

    public static PlusLayoutResult Compute(IReadOnlyList<MazeFootprint> seats, float apothem,
                                           float margin = MazeFootprint.Margin)
    {
        var doors = DoorsFor(seats.Count);
        var rotated = seats.Select((fp, i) => fp.Rotated((int)doors[i])).ToArray();
        var r = Place(rotated, doors, apothem, 0);
        if (seats.Count == 2) return r;
        for (int c = 0; c <= MaxHallCells; c++)
        {
            r = Place(rotated, doors, apothem, c);
            if (!Collides(r, margin)) return r;
        }
        throw new InvalidOperationException($"No hallway ≤ {MaxHallCells} cells separates these mazes");
    }

    public static PlusLayoutResult WithHall(PlusLayoutResult r, int cells) =>
        Place(r.Seats.Select(s => s.Rotated).ToArray(), r.Seats.Select(s => s.Door).ToArray(), r.Apothem, cells);

    static PlusLayoutResult Place(MazeFootprint[] rotated, Door[] doors, float apothem, int cells)
    {
        float cs = DungeonBuilder.CellSize, hall = cells * cs;
        var seats = new SeatPlacement[rotated.Length];
        for (int i = 0; i < rotated.Length; i++)
        {
            var fp = rotated[i]; var d = doors[i]; var u = DoorDir(d);
            var exitCentre = new Vector3((fp.ExitX + 0.5f) * cs, 0f, (fp.ExitY + 0.5f) * cs);
            var faceLocal  = exitCentre - u * (cs * 0.5f);   // face toward the arena (−u side)
            var off        = u * (apothem + hall) - faceLocal;
            off.Y = -fp.ExitFloor * DungeonBuilder.FloorHeight;
            seats[i] = new SeatPlacement
            {
                Door = d, QuarterTurns = (int)d, Offset = off, DoorAngle = DoorAngle(d),
                ExitOpenDir = TowardArena(d), Rotated = fp,
                HallStart = u * apothem, HallEnd = u * (apothem + hall),
            };
        }
        return new PlusLayoutResult { HallCells = cells, Seats = seats, Apothem = apothem };
    }

    internal static Aabb HallBox(SeatPlacement s, float hall)
    {
        float hw = DungeonBuilder.CellSize * 0.5f;
        var a = s.HallStart; var b = s.HallEnd;
        var min = new Vector3(Mathf.Min(a.X, b.X), 0f, Mathf.Min(a.Z, b.Z));
        var max = new Vector3(Mathf.Max(a.X, b.X), DungeonBuilder.FloorHeight, Mathf.Max(a.Z, b.Z));
        bool alongZ = s.Door == Door.N || s.Door == Door.S;
        if (alongZ) { min.X -= hw; max.X += hw; } else { min.Z -= hw; max.Z += hw; }
        return new Aabb(min, max - min);
    }

    // World (arena-centred) boxes of a seat's columns, grown by margin, plus its hallway.
    static List<Aabb> Boxes(SeatPlacement s, float hall, float margin)
    {
        var list = new List<Aabb>(s.Rotated.Columns.Count + 1);
        var flat = new Vector3(s.Offset.X, 0f, s.Offset.Z);   // column boxes are already relative to the arena floor
        foreach (var kv in s.Rotated.Columns)
        {
            var b = MazeFootprint.ColumnBox(kv.Key.x, kv.Key.y, kv.Value.lo, kv.Value.hi);
            list.Add(new Aabb(b.Position + flat, b.Size).Grow(margin));
        }
        if (hall > 0f) list.Add(HallBox(s, hall).Grow(margin));
        return list;
    }

    static bool Overlap(Aabb a, Aabb b) =>
        a.Position.X < b.End.X && b.Position.X < a.End.X &&
        a.Position.Y < b.End.Y && b.Position.Y < a.End.Y &&
        a.Position.Z < b.End.Z && b.Position.Z < a.End.Z;

    public static bool Collides(PlusLayoutResult r, float margin)
    {
        var boxes = r.Seats.Select(s => Boxes(s, r.HallLength, margin)).ToArray();
        for (int i = 0; i < boxes.Length; i++)
            for (int j = i + 1; j < boxes.Length; j++)
                foreach (var a in boxes[i])
                    foreach (var b in boxes[j])
                        if (Overlap(a, b)) return true;
        return false;
    }
}
