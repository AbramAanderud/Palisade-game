using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using System.Text.Json;
using Godot;

/// res://scenes/OnlineFfaArena.Combat.cs — the FFA match rules on top of the
/// arena core: loadout, the n−1 host-arbitrated pickups, directed hits with
/// victim validation, the shared damage table, deaths with killer credit,
/// leavers, the 480 s clock, the host-authoritative end result, spectating
/// after death, and the end screen with placements and fame.
///
/// All scoring goes through one FfaMatch fed the same events on every client.
/// The final ORDER is the host's: whoever is host when the end is detected
/// broadcasts {"t":"end","placements":[…],"clock":bool}; a non-host that sees
/// the end first waits up to EndWaitSeconds for it, then falls back to its own
/// Placements(). Mirrored 1v1 methods name their OnlineDungeonArena source.
public partial class OnlineFfaArena
{
    const double EndWaitSeconds   = 2.0;
    const double SpectateDelay    = 1.5;
    const int    LoadoutRollTries = 32;

    FfaMatch?  _match;
    bool       _localDead;
    int        _lastDamager = -1;
    ulong      _lastDamageMs;      // Time.GetTicksMsec() of the last accepted remote hit
    const ulong KillCreditWindowMs = 5000;

    // Loadout
    bool       _loadoutApplied;
    (int start, int[] arena)? _pendingLoadout;   // arrived before our world existed

    // Pickups: index → holder seat (−1 = still on the altar)
    int[]      _pickupHolder = Array.Empty<int>();
    readonly List<(int i, int seat)> _pendingAwards = new();

    // End
    bool       _endDetected;       // IsOver/clock seen locally (or end received)
    bool       _endClock;
    bool       _endCancelled;      // the end came before GO: no placement fame, no banking
    List<int>  _endSnapshot = new();
    bool       _endWaitStarted;
    List<int>  _finalPlacements = new();

    // Spectator
    bool        _spectating;
    int         _spectateSeat = -1;
    CanvasLayer? _spectateCanvas;
    Label?       _spectateLabel;

    // ── Test hooks (TEST-ONLY: read/driven by the FFA tests; not gameplay API) ──
    /// TEST-ONLY. The shared match rules (lazily created from the roster so
    /// leaves replayed at _Ready are recorded in relay order).
    public FfaMatch Match => _match ??= new FfaMatch(OnlineGameState.FfaRoster.Select(e => e.Seat));
    /// TEST-ONLY. True once the end screen is up (final result known).
    public bool Ended { get; private set; }
    /// TEST-ONLY. The placement list the end screen showed, best first (empty before the end).
    public IReadOnlyList<int> FinalPlacements => _finalPlacements;
    /// TEST-ONLY. Fame the end screen awarded (and banked) for the local player.
    public int LocalFameAwarded { get; private set; }
    /// TEST-ONLY. Seat whose "end" decided our result (our own seat if we were
    /// the host that finalised it; −1 = none / local fallback / connection lost).
    public int EndFromSeat { get; private set; } = -1;
    /// TEST-ONLY. Seat holding pickup i, or −1.
    public int PickupHolder(int i) => i >= 0 && i < _pickupHolder.Length ? _pickupHolder[i] : -1;
    /// TEST-ONLY. Damages `seat`'s puppet through its PlayerHealth, i.e. exactly
    /// the DamageDealt → directed "hit" path a real gun hit on that puppet takes.
    public void DebugDamageSeat(int seat, float dmg)
    {
        if (!_peers.TryGetValue(seat, out var peer) || !IsInstanceValid(peer.Puppet)) return;
        peer.Puppet.GetNodeOrNull<PlayerHealth>("PlayerHealth")?.TakeDamage(dmg, peer.Puppet.GlobalPosition);
    }
    /// TEST-ONLY. Fires the same handler as Pickups[i].ClaimAttempted.
    public void DebugClaimPickup(int i) => OnLocalClaim(i);
    /// TEST-ONLY. Heals the local player through PlayerHealth.Heal (the path
    /// lifesteal takes); peers see it via the `hp` field of our next "pos".
    public void DebugHealLocal(float amt) =>
        _localPlayer?.GetNodeOrNull<PlayerHealth>("PlayerHealth")?.Heal(amt);
    /// TEST-ONLY. HP of `seat`'s puppet on this client (−1 if there is none).
    public float PuppetHealth(int seat) =>
        _peers.TryGetValue(seat, out var p) && IsInstanceValid(p.Puppet) &&
        p.Puppet.GetNodeOrNull<PlayerHealth>("PlayerHealth") is { } h ? h.CurrentHealth : -1f;
    /// TEST-ONLY. The local player's HP (−1 before spawn).
    public float LocalHealth =>
        _localPlayer != null && IsInstanceValid(_localPlayer) &&
        _localPlayer.GetNodeOrNull<PlayerHealth>("PlayerHealth") is { } h ? h.CurrentHealth : -1f;

    bool EndingOrEnded => _endDetected || Ended;

    /// Every FFA message is formatted with the invariant culture, so a
    /// comma-decimal (or U+2212 minus) locale can't break the JSON.
    static string Inv(FormattableString s) => s.ToString(CultureInfo.InvariantCulture);
    static string InvJoin(IEnumerable<int> xs) =>
        string.Join(",", xs.Select(x => x.ToString(CultureInfo.InvariantCulture)));

    /// Core hook: once the end is detected, only a still-awaited "end" gets through.
    bool DropAfterEnd(string t) => EndingOrEnded && !(t == "end" && !Ended);

    // ── Seams ────────────────────────────────────────────────────────────────

    partial void OnArenaSpawned()
    {
        if (_world == null) return;
        _pickupHolder = Enumerable.Repeat(-1, _world.Pickups.Count).ToArray();
        for (int i = 0; i < _world.Pickups.Count; i++)
        {
            int idx = i;
            _world.Pickups[i].ClaimAttempted += () => OnLocalClaim(idx);
        }
        WireCombatRelay();

        if (_pendingLoadout is { } lo) { _pendingLoadout = null; ApplyLoadout(lo.start, lo.arena); }
        else if (IsHost) RollLoadout();
        foreach (var (i, seat) in _pendingAwards) ApplyPickupAward(i, seat);
        _pendingAwards.Clear();

        // Ended while still loading (connection lost / everyone left): the core
        // just grabbed the mouse and camera for the new body — undo that.
        if (EndingOrEnded) FreezeBodies();
        else CheckEnd();
    }

    partial void OnMatchGo()
    {
        // The countdown finished after the match was already decided.
        if (!EndingOrEnded) return;
        _matchClock?.Stop();
        SetCombatLocked(true);
        FreezeBodies();
    }

    partial void OnMatchClockExpired()
    {
        GD.Print("[FFA] Match clock expired.");
        DetectEnd(clockExpired: true);
    }

    partial void OnSeatLeft(int seat)
    {
        if (!EndingOrEnded)
        {
            Match.RecordLeave(seat);
            if (_spectating && _spectateSeat == seat) SpectateNext();
            // Handover: the old host never rolled (its loadout would have reached
            // us before its peer_left — the relay keeps per-sender order).
            if (IsHost && _arenaBuilt && !_loadoutApplied && _pendingLoadout == null) RollLoadout();
            CheckEnd();
        }
        else if (!Ended && IsHost)
        {
            // The host left while we waited for its "end": we're responsible now.
            DetectEnd(_endClock);
        }
        // After the end the view stays on the last spectated body; if that
        // body just left (puppet freed), fall back to our own camera.
        if (EndingOrEnded && seat == _spectateSeat && _localPlayer != null && IsInstanceValid(_localPlayer))
            _localPlayer.Camera.MakeCurrent();
    }

    partial void OnMatchData(string t, JsonElement root, int from)
    {
        // Host-authoritative verdicts, like go/world/drop: only the current host's count.
        if ((t is "loadout" or "pickup_awarded" or "end") && from != OnlineGameState.FfaHostSeat)
        {
            GD.PushWarning($"[FFA] Ignoring '{t}' from non-host seat {from}.");
            return;
        }
        switch (t)
        {
            case "loadout":        OnLoadoutMessage(root);       break;
            case "pickup_claim":   OnPickupClaim(root, from);    break;
            case "pickup_awarded":
                ApplyPickupAward(root.GetProperty("i").GetInt32(), root.GetProperty("seat").GetInt32());
                break;
            case "hit":            OnHitMessage(root, from);     break;
            case "dmg":
                Match.RecordDamage(root.GetProperty("by").GetInt32(), from, root.GetProperty("amt").GetSingle());
                // The victim's own HP is the display truth for its puppet.
                if (root.TryGetProperty("hp", out var hpProp) && hpProp.ValueKind == JsonValueKind.Number &&
                    _peers.TryGetValue(from, out var victim) && IsInstanceValid(victim.Puppet))
                    victim.Puppet.GetNodeOrNull<PlayerHealth>("PlayerHealth")?.SetHealth(hpProp.GetSingle());
                break;
            case "die":            OnDieMessage(root, from);     break;
            case "end":            OnEndMessage(root, from);     break;
        }
    }

    // ── Loadout ──────────────────────────────────────────────────────────────

    /// Mirrors the host roll in OnlineDungeonArena.BuildArena (L787–801): a
    /// starter that differs from last match's (32 tries), plus n−1 DISTINCT
    /// arena-pool indices, one per pickup. Broadcast, then applied locally.
    void RollLoadout()
    {
        if (_world == null || _loadoutApplied) return;
        int s, tries = 0;
        do s = (int)(GD.Randi() % (uint)GunCombat.StarterPool.Length);
        while (s == OnlineGameState.LastStarterRoll && ++tries < LoadoutRollTries);
        OnlineGameState.LastStarterRoll = s;

        var pool = Enumerable.Range(0, GunCombat.ArenaPool.Length).ToList();
        for (int k = pool.Count - 1; k > 0; k--)
        {
            int j = (int)(GD.Randi() % (uint)(k + 1));
            (pool[k], pool[j]) = (pool[j], pool[k]);
        }
        int[] arena = pool.Take(Math.Min(_world.Pickups.Count, pool.Count)).ToArray();

        _nm.SendGameData(Inv($"{{\"t\":\"loadout\",\"start\":{s},\"arena\":[{InvJoin(arena)}]}}"));
        ApplyLoadout(s, arena);
    }

    void OnLoadoutMessage(JsonElement root)
    {
        int s = root.GetProperty("start").GetInt32();
        int[] arena = root.GetProperty("arena").EnumerateArray().Select(e => e.GetInt32()).ToArray();
        if (_loadoutApplied) return;
        if (_world == null) { _pendingLoadout = (s, arena); return; }   // 1v1 buffer pattern
        ApplyLoadout(s, arena);
    }

    /// Mirrors OnlineDungeonArena.ApplyLoadout (L834–852): starter on the local
    /// player, the same starter on every puppet (plain EquipGun — stats belong
    /// to the owner's client), and each pickup's arena prize. First one wins.
    void ApplyLoadout(int starterIdx, int[] arenaIdx)
    {
        if (_loadoutApplied || _world == null) return;
        _loadoutApplied = true;
        string starter = GunCombat.RollStarter(starterIdx);
        _localPlayer?.EquipStarterGun(starter);
        foreach (var p in _peers.Values)
            if (IsInstanceValid(p.Puppet)) p.Puppet.EquipGun(starter);
        for (int i = 0; i < _world.Pickups.Count && i < arenaIdx.Length; i++)
            if (IsInstanceValid(_world.Pickups[i])) _world.Pickups[i].ArenaGunId = GunCombat.RollArena(arenaIdx[i]);
        GD.Print($"[FFA] Loadout — starter '{starter}', pickups " +
                 string.Join(", ", arenaIdx.Select(GunCombat.RollArena)));
    }

    // ── Pickups (host-arbitrated) ────────────────────────────────────────────

    /// Mirrors OnlineDungeonArena.OnLocalSwordClaimAttempted (L1237–1254): the
    /// host awards itself at once; anyone else asks the host, directed.
    void OnLocalClaim(int i)
    {
        if (!_matchLive || _localDead || EndingOrEnded) return;
        if (Match.HasPickup(_mySeat) || _pickupHolder.Contains(_mySeat)) return;
        if (IsHost) HostAward(i, _mySeat);
        else
        {
            _nm.SendGameData(Inv($"{{\"t\":\"pickup_claim\",\"to\":{OnlineGameState.FfaHostSeat},\"i\":{i}}}"));
            GD.Print($"[FFA] Sent pickup_claim {i} to host seat {OnlineGameState.FfaHostSeat}.");
        }
    }

    /// Mirrors OnlineDungeonArena `case "sword_claim"` (L1110–1124): host only.
    void OnPickupClaim(JsonElement root, int from)
    {
        if (!IsHost) return;
        HostAward(root.GetProperty("i").GetInt32(), from);
    }

    /// Host: award pickup i to `seat` if it is still up and the claimant holds
    /// none and is still in the match. The verdict goes to everyone.
    void HostAward(int i, int seat)
    {
        if (i < 0 || i >= _pickupHolder.Length || _pickupHolder[i] != -1) return;
        if (_pickupHolder.Contains(seat) || !Match.Alive.Contains(seat)) return;
        _nm.SendGameData(Inv($"{{\"t\":\"pickup_awarded\",\"i\":{i},\"seat\":{seat}}}"));
        GD.Print($"[FFA] Host: pickup {i} → seat {seat}.");
        ApplyPickupAward(i, seat);
    }

    /// Mirrors OnlineDungeonArena.AwardSwordToLocal / AwardSwordToOpponent
    /// (L1256–1283), per pickup. Idempotent.
    void ApplyPickupAward(int i, int seat)
    {
        if (_world == null) { _pendingAwards.Add((i, seat)); return; }
        if (i < 0 || i >= _pickupHolder.Length || _pickupHolder[i] != -1) return;
        _pickupHolder[i] = seat;
        Match.RecordPickup(seat);
        var pickup = _world.Pickups[i];
        if (!IsInstanceValid(pickup)) return;

        if (seat == _mySeat)
        {
            // ConfirmPickup needs us still inside the pickup radius; if we walked
            // off while the verdict was in flight, grant it directly instead.
            bool granted = false;
            void OnGranted() => granted = true;
            pickup.PickedUp += OnGranted;
            pickup.ConfirmPickup();
            pickup.PickedUp -= OnGranted;
            if (!granted)
            {
                _localPlayer?.EquipArenaGun(pickup.ArenaGunId);
                pickup.DespawnSilently();
            }
            ShowToast($"Weapon claimed  +{FfaMatch.FamePickup} fame", new Color(0.3f, 1f, 0.5f));
        }
        else
        {
            if (_peers.TryGetValue(seat, out var peer) && IsInstanceValid(peer.Puppet))
                peer.Puppet.EquipGun(pickup.ArenaGunId);
            pickup.DespawnSilently();
        }
    }

    // ── Hits / damage ────────────────────────────────────────────────────────

    /// Mirrors OnlineDungeonArena.WireHitRelay (damage/death half, L859–875 and
    /// L900–902): each puppet's DamageDealt → a "hit" directed at that seat,
    /// stamped with where we SAW them; local OnDied → OnLocalPlayerDied.
    void WireCombatRelay()
    {
        foreach (var peer in _peers.Values)
        {
            var puppet = peer.Puppet;
            int seat   = peer.Seat;
            var hp = puppet.GetNodeOrNull<PlayerHealth>("PlayerHealth");
            if (hp == null) continue;
            hp.DamageDealt += dmg =>
            {
                if (EndingOrEnded || !IsInstanceValid(puppet)) return;
                var seen = puppet.PuppetLastNetPos;
                _nm.SendGameData(Inv($"{{\"t\":\"hit\",\"to\":{seat},\"dmg\":{dmg:F1},\"px\":{seen.X:F2},\"py\":{seen.Y:F2},\"pz\":{seen.Z:F2}}}"));
            };
        }
        var localHealth = _localPlayer?.GetNodeOrNull<PlayerHealth>("PlayerHealth");
        if (localHealth != null) localHealth.OnDied += OnLocalPlayerDied;
    }

    /// Mirrors OnlineDungeonArena `case "hit"` (L1058–1090): victim-side
    /// WasRecentlyNear staleness check, TakeDamage, incoming damage label. FFA
    /// adds killer credit (_lastDamager) and the "dmg" broadcast for the shared
    /// damage table — sent BEFORE TakeDamage so peers see it ahead of any "die".
    void OnHitMessage(JsonElement root, int from)
    {
        if (_localPlayer == null || !_matchLive || _localDead) return;
        float incoming = root.GetProperty("dmg").GetSingle();
        if (root.TryGetProperty("px", out var cx) &&
            root.TryGetProperty("py", out var cy) &&
            root.TryGetProperty("pz", out var cz))
        {
            var claimed = new Vector3(cx.GetSingle(), cy.GetSingle(), cz.GetSingle());
            if (!_localPlayer.WasRecentlyNear(claimed))
            {
                GD.Print($"[FFA] Rejected stale hit claim from seat {from}: {incoming:F0} dmg " +
                         $"@ {claimed} vs us @ {_localPlayer.GlobalPosition}");
                return;
            }
        }
        var hp = _localPlayer.GetNodeOrNull<PlayerHealth>("PlayerHealth");
        if (hp == null || hp.Invulnerable || hp.CurrentHealth <= 0f) return;

        // Rounded to the F1 the "dmg" broadcast carries, so our own damage
        // table records exactly what every peer parses.
        float taken   = MathF.Round(Math.Min(incoming, hp.CurrentHealth), 1);
        float hpAfter = hp.CurrentHealth - taken;
        _lastDamager  = from;
        _lastDamageMs = Time.GetTicksMsec();
        Match.RecordDamage(from, _mySeat, taken);
        _nm.SendGameData(Inv($"{{\"t\":\"dmg\",\"by\":{from},\"amt\":{taken:F1},\"hp\":{hpAfter:F1}}}"));
        hp.TakeDamage(incoming, Vector3.Zero);
        SpawnIncomingDmgLabel(incoming, _localPlayer.GlobalPosition + Vector3.Up * 1.8f);
    }

    /// Mirrors OnlineDungeonArena.SpawnIncomingDmgLabel (L1674–1694).
    void SpawnIncomingDmgLabel(float dmg, Vector3 worldPos)
    {
        var label = new Label3D
        {
            Text        = ((int)dmg).ToString(),
            FontSize    = 72,
            Modulate    = new Color(1f, 0.85f, 0.1f, 1f),
            Billboard   = BaseMaterial3D.BillboardModeEnum.Enabled,
            NoDepthTest = true,
            Position    = worldPos + new Vector3(GD.Randf() * 0.4f - 0.2f, 0f, 0f),
        };
        AddChild(label);
        var tween = label.CreateTween();
        tween.TweenProperty(label, "position:y", label.Position.Y + 1.8f, 0.85f)
             .SetEase(Tween.EaseType.Out).SetTrans(Tween.TransitionType.Quad);
        tween.Parallel().TweenProperty(label, "modulate:a", 0f, 0.5f).SetDelay(0.35f);
        tween.TweenCallback(Callable.From(label.QueueFree));
    }

    // ── Deaths ───────────────────────────────────────────────────────────────

    /// Mirrors OnlineDungeonArena.OnLocalPlayerDied (L1356–1368): broadcast
    /// "die" (with the killer), play the death, and after 1.5 s spectate
    /// instead of resolving — the match goes on without us.
    void OnLocalPlayerDied()
    {
        if (EndingOrEnded || _localDead) return;
        _localDead = true;
        // Credit the last remote damager only if its hit landed recently;
        // otherwise (own splash, a fall long after the last hit) nobody.
        int killer = _lastDamager >= 0 && Time.GetTicksMsec() - _lastDamageMs <= KillCreditWindowMs
            ? _lastDamager : -1;
        _nm.SendGameData(Inv($"{{\"t\":\"die\",\"by\":{killer}}}"));
        GD.Print($"[FFA] Local player died (killer seat {killer}).");
        _localPlayer?.TriggerDeath();
        Match.RecordDeath(_mySeat, killer);
        GetTree().CreateTimer(SpectateDelay).Timeout += () =>
        {
            if (IsInstanceValid(this) && !EndingOrEnded) EnterSpectator();
        };
        CheckEnd();
    }

    /// Mirrors OnlineDungeonArena `case "die"` (L1180–1191): their body drops
    /// on our screen; FFA records the elimination and credits the killer.
    void OnDieMessage(JsonElement root, int from)
    {
        int by = root.TryGetProperty("by", out var b) && b.ValueKind == JsonValueKind.Number ? b.GetInt32() : -1;
        if (!Match.Alive.Contains(from)) return;
        Match.RecordDeath(from, by);
        GD.Print($"[FFA] Seat {from} died (killer seat {by}).");
        if (_peers.TryGetValue(from, out var peer) && IsInstanceValid(peer.Puppet))
        {
            peer.Remove(died: true);
            var hp = peer.Puppet.GetNodeOrNull<PlayerHealth>("PlayerHealth");
            if (hp != null)
            {
                hp.Invulnerable = true;   // no hits on a corpse
                hp.CannotDie    = false;  // lets HP read 0 (no events) so aim assist / homing skip it
                hp.SetHealth(0f);
            }
        }
        if (by == _mySeat)
        {
            ShowToast($"You eliminated {NameOf(from)}  +{FfaMatch.FameKill} fame", new Color(1f, 0.6f, 0.3f));
        }
        if (_spectating && _spectateSeat == from) SpectateNext();
        CheckEnd();
    }

    // ── End detection (host-authoritative) ───────────────────────────────────

    void CheckEnd()
    {
        if (!EndingOrEnded && Match.IsOver) DetectEnd(clockExpired: false);
    }

    /// The match is over as far as this client can tell. The host finalises
    /// and broadcasts "end"; anyone else freezes and waits for it.
    void DetectEnd(bool clockExpired)
    {
        if (Ended) return;
        if (!_endDetected)
        {
            _endDetected = true;
            _endClock    = clockExpired;
            _endCancelled = !_matchLive;
            _endSnapshot = Match.Placements(clockExpired).ToList();
            _matchClock?.Stop();
            _mazeRetryTimer?.Stop();   // a pre-world end: no maze give-up off the end screen
            SetCombatLocked(true);
            FreezeBodies();
            GD.Print($"[FFA] End detected (clock={clockExpired}); local placements " +
                     string.Join(",", _endSnapshot));
        }

        if (IsHost)
        {
            _nm.SendGameData($"{{\"t\":\"end\",\"placements\":[{InvJoin(_endSnapshot)}]," +
                             $"\"clock\":{(_endClock ? "true" : "false")}," +
                             $"\"cancelled\":{(_endCancelled ? "true" : "false")}}}");
            EndFromSeat = _mySeat;
            FinishMatch(_endSnapshot, _endClock, connectionLost: false);
        }
        else if (!_endWaitStarted)
        {
            _endWaitStarted = true;
            GetTree().CreateTimer(EndWaitSeconds).Timeout += () =>
            {
                if (!IsInstanceValid(this) || Ended) return;
                GD.Print("[FFA] No 'end' from the host — using local placements.");
                FinishMatch(_endSnapshot, _endClock, connectionLost: false);
            };
        }
    }

    void OnEndMessage(JsonElement root, int from)
    {
        if (Ended) return;
        EndFromSeat = from;
        var placements = root.GetProperty("placements").EnumerateArray().Select(e => e.GetInt32()).ToList();
        bool clock = root.TryGetProperty("clock", out var c) && c.ValueKind == JsonValueKind.True;
        if (!_endDetected)
        {
            _endDetected  = true;
            _endClock     = clock;
            _endCancelled = !_matchLive;
            _matchClock?.Stop();
            SetCombatLocked(true);
        }
        // The host's verdict on "ended before GO" wins over our own timing.
        if (root.TryGetProperty("cancelled", out var cc) &&
            (cc.ValueKind == JsonValueKind.True || cc.ValueKind == JsonValueKind.False))
            _endCancelled = cc.ValueKind == JsonValueKind.True;
        GD.Print($"[FFA] 'end' from host: {string.Join(",", placements)} (clock={clock})");
        FinishMatch(placements, clock, connectionLost: false);
    }

    void OnConnectionLost()
    {
        if (Ended || _leaving) return;
        GD.PushWarning("[FFA] Connection to the relay lost.");
        _mazeRetryTimer?.Stop();
        if (_endDetected) { FinishMatch(_endSnapshot, _endClock, connectionLost: false); return; }
        _endDetected  = true;
        _endCancelled = !_matchLive;
        _matchClock?.Stop();
        SetCombatLocked(true);
        FinishMatch(Match.Placements(false).ToList(), clockExpired: false, connectionLost: true);
    }

    void OnConnectionFailed(string reason) => OnConnectionLost();
    void OnRelayPeerDisconnected()         => OnConnectionLost();

    /// Core hook: (un)subscribe the own-connection-lost signals.
    void SubscribeConnectionLoss(bool on)
    {
        if (on)
        {
            _nm.ConnectionFailed += OnConnectionFailed;
            _nm.PeerDisconnected += OnRelayPeerDisconnected;
        }
        else
        {
            _nm.ConnectionFailed -= OnConnectionFailed;
            _nm.PeerDisconnected -= OnRelayPeerDisconnected;
        }
    }

    /// Mirrors OnlineDungeonArena.ResolveMatch (L1408–1459): the ONE way the
    /// match ends — stop the clock, freeze, tear down dialogs, bank fame and
    /// show the overlay. Fame comes from the placement list actually shown.
    void FinishMatch(IReadOnlyList<int> placements, bool clockExpired, bool connectionLost)
    {
        if (Ended) return;
        Ended            = true;
        _endDetected     = true;
        _finalPlacements = placements.ToList();
        _matchClock?.Stop();
        _mazeRetryTimer?.Stop();
        FreezeBodies();
        ExitSpectator(keepView: true);

        if (_leaveDialog != null) { _leaveDialog.QueueFree(); _leaveDialog = null; }
        GetViewport().PhysicsObjectPicking = false;
        Input.MouseMode = Input.MouseModeEnum.Visible;

        int place = _finalPlacements.IndexOf(_mySeat);
        if (_endCancelled)
        {
            // Ended before GO (everyone else left / pre-GO timeout): no fame
            // at all and nothing banked, so an empty lobby can't be farmed.
            LocalFameAwarded = 0;
        }
        else
        {
            LocalFameAwarded = Match.Fame(_mySeat, _finalPlacements, includePlacement: !connectionLost);
            OnlineGameState.Gold += LocalFameAwarded;
            PlayerProfile.Save();
        }
        GD.Print($"[FFA] Match over: placements {string.Join(",", _finalPlacements)} clock={clockExpired} " +
                 $"lost={connectionLost} cancelled={_endCancelled} — seat {_mySeat} place {place + 1}, " +
                 $"+{LocalFameAwarded} fame (total {OnlineGameState.Gold}).");

        string title = connectionLost ? "Connection lost"
                     : _endCancelled  ? "Match cancelled"
                     : place < 0      ? "Match over"
                     : place switch { 0 => "1st place!", 1 => "2nd place", 2 => "3rd place", _ => $"{place + 1}th place" };
        ShowEndOverlay(title, place, clockExpired, connectionLost);
    }

    /// Mirrors OnlineDungeonArena.FreezePlayers (L1461), over every body.
    void FreezeBodies()
    {
        if (_localPlayer != null && IsInstanceValid(_localPlayer))
        {
            _localPlayer.Frozen = true;
            _localPlayer.ReleaseMouse();
        }
        foreach (var p in _peers.Values)
            if (IsInstanceValid(p.Puppet)) p.Puppet.Frozen = true;
        if (_spectating) Input.MouseMode = Input.MouseModeEnum.Visible;
    }

    /// Mirrors OnlineDungeonArena.ShowEndOverlay (L1472–1596) layout: result
    /// title, then (FFA) the placement list, "+N fame", "Total fame", and Exit
    /// to Menu. No Rematch yet (Phase 6).
    void ShowEndOverlay(string title, int place, bool clockExpired, bool connectionLost)
    {
        var canvas = new CanvasLayer { Name = "EndOverlay", Layer = 100 };
        AddChild(canvas);

        var bg = new ColorRect { Color = new Color(0f, 0f, 0f, 0.82f), MouseFilter = Control.MouseFilterEnum.Stop };
        bg.SetAnchorsPreset(Control.LayoutPreset.FullRect);
        canvas.AddChild(bg);

        var vbox = new VBoxContainer();
        vbox.AnchorLeft     = 0.5f; vbox.AnchorRight  = 0.5f;
        vbox.AnchorTop      = 0.5f; vbox.AnchorBottom = 0.5f;
        vbox.GrowHorizontal = Control.GrowDirection.Both;
        vbox.GrowVertical   = Control.GrowDirection.Both;
        vbox.OffsetLeft     = -260f; vbox.OffsetRight  = 260f;
        vbox.OffsetTop      = -200f; vbox.OffsetBottom = 200f;
        vbox.AddThemeConstantOverride("separation", 14);
        canvas.AddChild(vbox);

        Color titleColor = connectionLost || _endCancelled ? new Color(0.85f, 0.85f, 0.85f)
                         : place == 0     ? new Color(0.3f, 1f, 0.5f)
                         : place == 1     ? new Color(1f, 0.9f, 0.3f)
                         :                  new Color(1f, 0.45f, 0.35f);
        vbox.AddChild(MakeLabel(title, title.Length > 14 ? 44 : 60, titleColor));
        if (_endCancelled)
            vbox.AddChild(MakeLabel("The match ended before it started — no fame awarded", 18, new Color(0.8f, 0.8f, 0.8f)));
        else if (clockExpired && !connectionLost)
            vbox.AddChild(MakeLabel("Time's up — ranked by damage dealt", 18, new Color(0.8f, 0.8f, 0.8f)));

        for (int i = 0; i < _finalPlacements.Count && !_endCancelled; i++)
        {
            int seat  = _finalPlacements[i];
            int kills = Match.KillsBy(seat);
            string who  = NameOf(seat) + (seat == _mySeat ? " (you)" : "") + (_leftSeats.Contains(seat) ? " — left" : "");
            string line = $"{i + 1}.  {who}   {kills} kill{(kills == 1 ? "" : "s")}";
            vbox.AddChild(MakeLabel(line, 22, seat == _mySeat ? new Color(1f, 0.95f, 0.6f) : new Color(0.85f, 0.85f, 0.85f)));
        }

        if (!_endCancelled)
            vbox.AddChild(MakeLabel($"+{LocalFameAwarded} fame", 30, new Color(1f, 0.85f, 0.3f)));
        vbox.AddChild(MakeLabel($"Total fame: {OnlineGameState.Gold}", 20, new Color(0.8f, 0.8f, 0.5f)));

        var exitBtn = MakeButton("Exit to Menu", new Color(1f, 0.95f, 0.85f));
        exitBtn.CustomMinimumSize   = new Vector2(240, 56);
        exitBtn.SizeFlagsHorizontal = Control.SizeFlags.ShrinkCenter;
        exitBtn.MouseFilter         = Control.MouseFilterEnum.Stop;
        exitBtn.AddThemeColorOverride("font_hover_color", new Color(1f, 0.9f, 0.5f));
        bool clicked = false;
        exitBtn.Pressed += () =>
        {
            if (clicked) return;
            clicked  = true;
            _leaving = true;
            _nm.PartyLeave();
            _nm.Disconnect();
            if (IsInstanceValid(this)) GetTree().ChangeSceneToFile("res://scenes/TitleScreen.tscn");
        };
        vbox.AddChild(exitBtn);
        exitBtn.GrabFocus();
    }

    // ── Spectator ────────────────────────────────────────────────────────────

    void EnterSpectator()
    {
        if (_spectating) return;
        _spectating = true;
        _spectateCanvas = new CanvasLayer { Name = "SpectateHud", Layer = 20 };
        AddChild(_spectateCanvas);
        _spectateLabel = MakeLabel("", 22, new Color(0.9f, 0.9f, 0.9f));
        _spectateLabel.AnchorLeft = 0f; _spectateLabel.AnchorRight = 1f;
        _spectateLabel.AnchorTop  = 1f; _spectateLabel.AnchorBottom = 1f;
        _spectateLabel.OffsetTop  = -70f; _spectateLabel.OffsetBottom = -30f;
        _spectateCanvas.AddChild(_spectateLabel);
        SpectateNext();
    }

    void ExitSpectator(bool keepView)
    {
        _spectating = false;
        _spectateCanvas?.QueueFree();
        _spectateCanvas = null;
        _spectateLabel  = null;
        if (!keepView) RestoreView();
    }

    /// Next living seat after the current one (seat order, wrapping), skipping
    /// the dead and the departed. Nobody left → keep the last view (or fall
    /// back to our own camera if that body is gone).
    void SpectateNext()
    {
        var alive = Match.Alive
            .Where(s => s != _mySeat && _peers.TryGetValue(s, out var p) && IsInstanceValid(p.Puppet))
            .OrderBy(s => s).ToList();
        if (alive.Count == 0)
        {
            bool viewGone = !_peers.TryGetValue(_spectateSeat, out var cur) || !IsInstanceValid(cur.Puppet);
            if (viewGone && _localPlayer != null && IsInstanceValid(_localPlayer)) _localPlayer.Camera.MakeCurrent();
            return;
        }
        int next = alive.FirstOrDefault(s => s > _spectateSeat, alive[0]);
        _spectateSeat = next;
        _peers[next].Puppet.Camera.MakeCurrent();
        if (_spectateLabel != null) _spectateLabel.Text = $"Spectating {NameOf(next)} — Tab to switch";
        GD.Print($"[FFA] Spectating seat {next}.");
    }

    /// Core hook (leave dialog dismissed): the core re-activates our own
    /// camera; while spectating, point it back at the spectated body.
    void RestoreView()
    {
        if (_spectating && _peers.TryGetValue(_spectateSeat, out var p) && IsInstanceValid(p.Puppet))
            p.Puppet.Camera.MakeCurrent();
    }

    public override void _UnhandledInput(InputEvent ev)
    {
        if (!_spectating || Ended || _leaveDialog != null) return;
        bool cycle = ev is InputEventKey { Pressed: true, Echo: false, Keycode: Key.Tab }
                  || ev is InputEventMouseButton { Pressed: true, ButtonIndex: MouseButton.Left };
        if (!cycle) return;
        SpectateNext();
        GetViewport().SetInputAsHandled();
    }

    // ── Toast ────────────────────────────────────────────────────────────────

    void ShowToast(string text, Color color)
    {
        var canvas = new CanvasLayer { Layer = 30 };
        AddChild(canvas);
        var lbl = MakeLabel(text, 24, color);
        lbl.AnchorLeft = 0f; lbl.AnchorRight = 1f;
        lbl.OffsetTop  = 90f;
        canvas.AddChild(lbl);
        var tw = lbl.CreateTween();
        tw.TweenInterval(2.5);
        tw.TweenProperty(lbl, "modulate:a", 0f, 0.6f);
        tw.TweenCallback(Callable.From(canvas.QueueFree));
    }
