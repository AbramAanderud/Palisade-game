using Godot;
using System;
using System.Collections.Generic;

/// Behavioural checks for the 2026-09-27 movement-feel pass, run against a real
/// PlayerController inside the real arena (curved shelf wall, open sky):
///   WALLRUN-*  a forced wall-run along the curved shelf ring holds for > 2.5 s,
///              including while strafing slightly away from the wall.
///   AIR-KEEP   16 m/s of carried (bhop-level) speed is neither trimmed nor
///              increased by air steering — only redirected.
///   AIR-TURN   air steering turns that velocity > 10 deg in 0.6 s (AirAccel 4 gave ~5).
///   BOUNCE     trampoline air control is still boosted 2.5 s into the arc
///              (well past the old 1.6 s window).
///   DIVE       looking straight down during the bounce lands sooner than
///              looking level.
public partial class TestMovementFeel : Node3D
{
    sealed class Case
    {
        public string Name = "";
        public Action<PlayerController> Setup = _ => { };
        public Func<PlayerController, float, bool> Step = (_, _) => false;   // return true = done
        public Func<string> Verdict = () => "";
        public Func<bool> Pass = () => true;
        public string[] Actions = Array.Empty<string>();
    }

    readonly List<Case> _cases = new();
    int _idx = -1;
    float _t;
    PlayerController? _p;
    int _fails;
    float _diveLevelT = -1f, _diveDownT = -1f;

    public override void _Ready()
    {
        AddChild(new WorldEnvironment { Environment = new Godot.Environment() });
        var arena = new ArenaBuilder { Name = "Arena" };
        AddChild(arena);
        arena.Build(Vector3.Zero, openNorth: true, openSouth: true);

        float rFront = ArenaBuilder.Apothem - 0.55f - 0.06f;
        // East side of the arena (angle +90 deg), well clear of both doorways.
        foreach (var (label, acts) in new[] {
            ("fwd",       new[] { "move_forward" }),
            ("fwd+away",  new[] { "move_forward", "move_left" }),   // facing -Z at +X side: left = -X = away
            ("no input",  Array.Empty<string>()) })
        {
            float ran = 0f;
            _cases.Add(new Case
            {
                Name = $"WALLRUN-{label}",
                Actions = acts,
                Setup = p =>
                {
                    p.GlobalPosition = new Vector3(rFront - 0.36f, 20f, 0f);   // high: sliding down to the floor would end it early
                    p.Velocity = new Vector3(0, 0, -12f);          // clockwise along the ring
                    p.DebugForceWallRun(Vector3.Left);             // shelf face normal points to centre
                },
                Step = (p, t) => { if (p.DebugIsWallRunning) ran = t; return t > 3f; },
                Verdict = () => $"held {ran:F2}s",
                Pass = () => ran > 2.5f,
            });
        }

        float keepMin = 99f, keepMax = 0f, turnDeg = 0f;
        _cases.Add(new Case
        {
            Name = "AIR-KEEP/TURN",
            Actions = new[] { "move_forward", "move_right" },
            Setup = p => { p.GlobalPosition = new Vector3(0, 40f, 0); p.Velocity = new Vector3(0, 0, -16f); },
            Step = (p, t) =>
            {
                var h = new Vector2(p.Velocity.X, p.Velocity.Z);
                keepMin = Mathf.Min(keepMin, h.Length()); keepMax = Mathf.Max(keepMax, h.Length());
                turnDeg = Mathf.RadToDeg(Mathf.Abs(h.AngleTo(new Vector2(0, -1))));
                return t > 0.6f;
            },
            Verdict = () => $"speed {keepMin:F2}..{keepMax:F2} (from 16), turned {turnDeg:F1} deg",
            Pass = () => keepMin > 15.9f && keepMax < 16.1f && turnDeg > 10f,
        });

        // Rounding a corner: input 90° off the carried velocity (what holding W
        // while looking round a corner produces) must swing it ~90° in 0.3 s
        // without bleeding bhop speed.
        float cornerMin = 99f, cornerDeg = 0f;
        _cases.Add(new Case
        {
            Name = "AIR-CORNER",
            Actions = new[] { "move_right" },
            Setup = p => { p.GlobalPosition = new Vector3(0, 40f, 0); p.Velocity = new Vector3(0, 0, -16f); },
            Step = (p, t) =>
            {
                var h = new Vector2(p.Velocity.X, p.Velocity.Z);
                cornerMin = Mathf.Min(cornerMin, h.Length());
                cornerDeg = Mathf.RadToDeg(Mathf.Abs(h.AngleTo(new Vector2(0, -1))));
                return t > 0.3f;
            },
            Verdict = () => $"turned {cornerDeg:F1} deg in 0.3 s, min speed {cornerMin:F2} (from 16)",
            Pass = () => cornerDeg > 85f && cornerMin > 15.9f,
        });

        float bounceSpd = 0f;
        _cases.Add(new Case
        {
            Name = "BOUNCE",
            Setup = p => { p.GlobalPosition = new Vector3(0, 2f, 0); p.Velocity = Vector3.Zero; p.LaunchUp(44f, 6f); },
            Step = (p, t) =>
            {
                if (t > 2.5f && t < 2.52f) Input.ActionPress("move_right");
                if (t >= 2.9f) { bounceSpd = new Vector2(p.Velocity.X, p.Velocity.Z).Length(); Input.ActionRelease("move_right"); return true; }
                return false;
            },
            Verdict = () => $"0.4s of strafe at t=2.5s -> {bounceSpd:F2} m/s (unboosted cap 5.5)",
            Pass = () => bounceSpd > 7f,
        });

        foreach (bool down in new[] { false, true })
        {
            _cases.Add(new Case
            {
                Name = down ? "DIVE-down" : "DIVE-level",
                Setup = p =>
                {
                    p.GlobalPosition = new Vector3(0, 2f, 0); p.Velocity = Vector3.Zero;
                    p.DebugSetPitch(down ? -1.45f : 0f);
                    p.LaunchUp(44f, 6f);
                },
                Step = (p, t) =>
                {
                    if (t > 0.2f && p.IsOnFloor())
                    {
                        if (down) _diveDownT = t; else _diveLevelT = t;
                        return true;
                    }
                    return t > 8f;
                },
                Verdict = () => down ? $"landed at {_diveDownT:F2}s (level {_diveLevelT:F2}s)" : $"landed at {_diveLevelT:F2}s",
                Pass = () => !down || (_diveDownT > 0f && _diveDownT < _diveLevelT - 0.5f),
            });
        }
        Next();
    }

    void Next()
    {
        if (_idx >= 0)
        {
            var c = _cases[_idx];
            foreach (var a in c.Actions) Input.ActionRelease(a);
            bool ok = c.Pass();
            if (!ok) _fails++;
            GD.Print($"[TestMovementFeel] {c.Name}: {c.Verdict()} {(ok ? "PASS" : "FAIL")}");
        }
        _p?.QueueFree();
        _p = null;
        _idx++;
        if (_idx >= _cases.Count)
        {
            GD.Print($"[TestMovementFeel] RESULT {(_fails == 0 ? "PASS" : "FAIL")} ({_fails}/{_cases.Count} failing)");
            GetTree().Quit(_fails == 0 ? 0 : 1);
            return;
        }
        var cur = _cases[_idx];
        _p = PlayerController.Spawn(this, new Vector3(0, 60f, 0), 0f);   // yaw 0 = facing -Z
        cur.Setup(_p);
        foreach (var a in cur.Actions) Input.ActionPress(a);
        _t = 0f;
    }

    public override void _PhysicsProcess(double delta)
    {
        if (_p == null) return;
        _t += (float)delta;
        if (_cases[_idx].Step(_p, _t)) Next();
    }
}
