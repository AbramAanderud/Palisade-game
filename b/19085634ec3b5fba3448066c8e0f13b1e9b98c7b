using Godot;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Reflection;
using System.Threading.Tasks;

/// test/FfaTestShots.cs
/// Shared by TestFfaMatchFlow and TestFfaRematchFlow (Phase 7 windowed pass):
///   - `--shot <dir>`: PNGs of the live online FFA match from a WINDOWED role
///     (no-op headless): countdown, just after GO, a puppet close-up, the
///     spectator view (if this role dies), the end screen.
///   - `[BW]` bandwidth over the live-match window from NetworkManager's
///     BytesSent / BytesReceived counters.
/// The watcher only reads state and swaps the current camera for one frame
/// burst (puppet close-up); it never moves a body, so the tests' hit
/// validation (nobody moves) is untouched.
public static class FfaTestShots
{
    public static string? ParseDir()
    {
        var args = OS.GetCmdlineArgs();
        for (int i = 0; i < args.Length - 1; i++) if (args[i] == "--shot") return args[i + 1];
        return null;
    }

    public static bool CanShoot(string? dir) => dir != null && DisplayServer.GetName() != "headless";

    public static async Task Frames(Node n, int count)
    {
        for (int i = 0; i < count; i++) await n.ToSignal(n.GetTree(), SceneTree.SignalName.ProcessFrame);
    }

    public static async Task Save(Node n, string dir, string name)
    {
        await Frames(n, 4);
        string abs = dir.StartsWith("res://") || dir.StartsWith("user://") ? ProjectSettings.GlobalizePath(dir) : dir;
        DirAccess.MakeDirRecursiveAbsolute(abs);
        string path = $"{abs}/{name}.png";
        var err = n.GetViewport().GetTexture().GetImage().SavePng(path);
        GD.Print($"[SHOT] {path} ({err})");
    }

    static T Field<T>(object o, string name) =>
        (T)(o.GetType().GetField(name, BindingFlags.NonPublic | BindingFlags.Instance)
            ?? throw new MissingFieldException(o.GetType().Name, name)).GetValue(o)!;

    static List<PlayerController> Puppets(OnlineFfaArena a) =>
        Field<Dictionary<int, RemotePeer>>(a, "_peers").Values
            .Where(p => GodotObject.IsInstanceValid(p.Puppet)).Select(p => p.Puppet).ToList();

    /// Test-only camera ~3 m in front of the first live puppet, looking at
    /// its chest; shoot, then hand the view back to whatever was current.
    public static async Task PuppetCloseup(Node n, OnlineFfaArena a, string dir, string name)
    {
        var pup = Puppets(a).FirstOrDefault();
        if (pup == null) { GD.Print("[SHOT] no puppet for a close-up"); return; }
        var prev = n.GetViewport().GetCamera3D();
        var cam = new Camera3D { Name = "TestShotCam", Fov = 70f };
        a.AddChild(cam);
        var body = pup.GetNodeOrNull<Node3D>("PlayerBody") ?? pup;
        var fwd = -body.GlobalBasis.Z; fwd.Y = 0f;
        if (fwd.LengthSquared() < 0.01f) fwd = Vector3.Forward;
        var target = pup.GlobalPosition + Vector3.Up * 1.2f;
        var want = target + fwd.Normalized() * 3.0f + Vector3.Up * 0.3f;
        var q = PhysicsRayQueryParameters3D.Create(target, want);
        q.Exclude = new Godot.Collections.Array<Rid> { pup.GetRid() };
        var hit = a.GetWorld3D().DirectSpaceState.IntersectRay(q);
        if (hit.Count > 0) want = target + ((Vector3)hit["position"] - target) * 0.85f;
        cam.GlobalPosition = want;
        cam.LookAt(target, Vector3.Up);
        cam.MakeCurrent();
        await Save(n, dir, name);
        if (prev != null && GodotObject.IsInstanceValid(prev)) prev.MakeCurrent();
        cam.QueueFree();
    }

    /// Fire-and-forget: shoots the phases of one arena as they happen.
    public static async Task Watch(Node n, OnlineFfaArena a, string dir, string prefix)
    {
        bool Valid() => GodotObject.IsInstanceValid(a) && a.IsInsideTree();
        while (Valid() && !Field<bool>(a, "_countdownStarted") && !a.MatchLive) await Frames(n, 1);
        if (!Valid()) return;
        if (!a.MatchLive)
        {
            await n.ToSignal(n.GetTree().CreateTimer(1.2), SceneTreeTimer.SignalName.Timeout);
            if (Valid() && !a.MatchLive) await Save(n, dir, $"{prefix}1_countdown");
        }
        while (Valid() && !a.MatchLive) await Frames(n, 1);
        if (!Valid()) return;
        await n.ToSignal(n.GetTree().CreateTimer(0.4), SceneTreeTimer.SignalName.Timeout);
        if (!Valid() || a.Ended) return;
        await Save(n, dir, $"{prefix}2_go");
        await PuppetCloseup(n, a, dir, $"{prefix}3_puppet");
        // Spectator (only if this role dies before the end).
        while (Valid() && !a.Ended && !Field<bool>(a, "_spectating")) await Frames(n, 1);
        if (Valid() && !a.Ended)
        {
            await n.ToSignal(n.GetTree().CreateTimer(1.0), SceneTreeTimer.SignalName.Timeout);
            if (Valid() && !a.Ended) await Save(n, dir, $"{prefix}4_spectator");
        }
        while (Valid() && !a.Ended) await Frames(n, 1);
        if (!Valid()) return;
        await n.ToSignal(n.GetTree().CreateTimer(1.0), SceneTreeTimer.SignalName.Timeout);
        if (Valid()) await Save(n, dir, $"{prefix}5_end");
    }

    // -- Bandwidth ---------------------------------------------------------------

    public sealed class Bw
    {
        readonly NetworkManager _nm;
        readonly long _s0, _r0;
        readonly ulong _t0;
        public Bw(NetworkManager nm) { _nm = nm; _s0 = nm.BytesSent; _r0 = nm.BytesReceived; _t0 = Time.GetTicksMsec(); }

        public void Report(string role)
        {
            double secs = Math.Max(0.001, (Time.GetTicksMsec() - _t0) / 1000.0);
            long s = _nm.BytesSent - _s0, r = _nm.BytesReceived - _r0;
            GD.Print(FormattableString.Invariant(
                $"[BW] [{role}] sent={s} recv={r} over {secs:F1}s -> up {s / 1024.0 / secs:F2} KB/s, down {r / 1024.0 / secs:F2} KB/s"));
        }
    }
}
