using Godot;
using System.Linq;

/// test/TestGunSlots.cs
/// Two rules that are easy to break silently and impossible to see in a diff:
///
///  1. StarterPool guns are SECONDARY, ArenaPool guns are PRIMARY. The slot a
///     gun lands in is decided by which Equip* method the arena calls, so a gun
///     added to the wrong pool would quietly occupy the wrong hand. GunDef.Slot
///     makes the rule data; this asserts the data and the pools agree.
///
///  2. The weapon input actions exist and are bound. They were hand-written
///     into project.godot (Godot's own serialisation format), so a typo would
///     not fail the build — the keys would just silently do nothing in game.
public partial class TestGunSlots : Node
{
    int _fail;
    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + label);
        if (!ok) _fail++;
    }

    public override void _Ready()
    {
        GD.Print("── gun slots ──");
        foreach (var id in GunCombat.StarterPool)
            Check(GunCombat.Defs[id].Slot == GunCombat.GunSlot.Secondary,
                  $"starter '{id}' is SECONDARY");
        foreach (var id in GunCombat.ArenaPool)
            Check(GunCombat.Defs[id].Slot == GunCombat.GunSlot.Primary,
                  $"arena '{id}' is PRIMARY");

        // No gun may sit in both pools — it would need both slots at once.
        Check(!GunCombat.StarterPool.Intersect(GunCombat.ArenaPool).Any(),
              "no gun appears in both pools");

        GD.Print("── projectile hit volume ──");
        foreach (var id in GunCombat.Defs.Keys)
        {
            var d = GunCombat.Defs[id];
            if (d.Mode != GunCombat.FireMode.Projectile) continue;
            // A projectile with no radius would fall back to a hairline sweep,
            // which is the bug this field exists to fix.
            Check(d.ProjRadius > 0.05f, $"'{id}' has a real hit radius ({d.ProjRadius:F2} m)");
            // Hit volume must stay well inside the splash it triggers, or the
            // rocket detonates before it can reach anyone.
            Check(d.ProjRadius < d.SplashRadius * 0.25f,
                  $"'{id}' radius {d.ProjRadius:F2} stays under a quarter of splash {d.SplashRadius:F1}");
        }

        GD.Print("── fire sounds ──");
        // A typo'd path does NOT fail the build — GD.Load returns null and the
        // gun simply fires silently, which is easy to miss in a noisy playtest.
        var paths = new System.Collections.Generic.List<string>();
        foreach (var id in GunCombat.Defs.Keys)
        {
            var def = GunCombat.Defs[id];
            Check(ResourceLoader.Exists(def.FireSfx), $"'{id}' fire sound exists ({def.FireSfx.GetFile()})");
            paths.Add(def.FireSfx);
        }
        // Previously SEVEN guns shared TWO samples — an AWP and a quad rocket
        // were the same noise. They now have real recordings, one per class.
        // quadrocket deliberately shares the rocket sample (there is no
        // separate quad recording), so the invariant is per-CLASS uniqueness,
        // not per-gun: everything except the two launchers must be distinct.
        var nonLauncher = GunCombat.Defs.Keys
            .Where(k => !k.Contains("rocket"))
            .Select(k => GunCombat.Defs[k].FireSfx).ToList();
        Check(nonLauncher.Distinct().Count() == nonLauncher.Count,
              $"each non-launcher gun has its own shot ({nonLauncher.Distinct().Count()}/{nonLauncher.Count})");
        Check(GunCombat.Defs["rocketlaucher"].FireSfx == GunCombat.Defs["quadrocket"].FireSfx,
              "both launchers share the one rocket recording (intended)");
        // The synthesised placeholders must be fully retired.
        Check(!paths.Any(x => x.Contains("GunShot_") || x.Contains("GunShotLight")
                                                     || x.Contains("GunShotHeavy")),
              "no gun still points at a placeholder sample");

        GD.Print("── weapon input actions ──");
        foreach (var act in new[] { "weapon_primary", "weapon_secondary",
                                    "weapon_next", "weapon_prev" })
        {
            bool has = InputMap.HasAction(act);
            Check(has, $"action '{act}' exists");
            if (has)
                Check(InputMap.ActionGetEvents(act).Count > 0,
                      $"action '{act}' has {InputMap.ActionGetEvents(act).Count} binding(s)");
        }

        // Wheel directions must be on SEPARATE actions and must not collide —
        // both on one action is what made scrolling non-directional, and both
        // pointing at the same physical notch would make one direction dead.
        MouseButton BtnOf(string act)
        {
            foreach (var e in InputMap.ActionGetEvents(act))
                if (e is InputEventMouseButton mb) return mb.ButtonIndex;
            return MouseButton.None;
        }
        var next = BtnOf("weapon_next");
        var prev = BtnOf("weapon_prev");
        Check(next == MouseButton.WheelDown, $"weapon_next is wheel DOWN (got {next})");
        Check(prev == MouseButton.WheelUp,   $"weapon_prev is wheel UP (got {prev})");
        Check(next != prev, "the two scroll directions are distinct notches");
        Check(!InputMap.HasAction("weapon_cycle"),
              "the old non-directional weapon_cycle action is gone");

        GD.Print(_fail == 0 ? "RESULT OK" : $"RESULT {_fail} FAILURE(S)");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
