using Godot;

/// scenes/DevGlyphC.cs — dev-tools view of the CORNERS "C" on black.
///
/// The same TitleWordmark the title screen builds, not a copy of it: same
/// corridor pieces, same stroke weight, same starry-night shader, same black
/// plate, same drag-to-orbit. It is the title's C exactly — only the framing
/// differs (one letter, centred, camera pulled in).
///
/// Reusing the real node is the point: a hand-copied glyph would drift from the
/// title the first time either is tweaked.
public partial class DevGlyphC : Node3D
{
    public override void _Ready()
    {
        AddChild(new TitleWordmark
        {
            Name            = "GlyphC",
            Word            = TitleWordmark.LetterC,
            ScreenLiftFrac  = 0f,   // centred: there is no menu column to clear

            // Sample the sky where the C actually sits in CORNERS. The nebula
            // is continuous across the word, so a lone C at the origin lands on
            // a dark patch and reads navy instead of the menu's vivid blue.
            SkyOffset       = TitleWordmark.SkyOffsetForLetter(0, 1),

            // The title's 340 frames 41 columns of letters; one 5-column glyph
            // at that distance is a speck. The C is 7 rows tall — the same
            // height as the word — so height is what the camera must fit here,
            // not width.
            DefDist         = 118f,
            MinDist         = 70f,
            MaxDist         = 340f,
            // No menu column to avoid, so let it turn properly.
            MaxYaw          = 0.60f,
        });
        GD.Print("[DevGlyphC] title C, unmodified — drag to orbit, wheel to zoom");
    }
}
