using System;
using System.Collections.Generic;
using Godot;

/// In-training weapon wheel: hold Tab (`gun_switch`) to open, scroll the mouse
/// wheel to move the highlight, release Tab to equip whatever is highlighted.
/// Only ever added when TrainingConfig.AllowGunSwitch is on — this is a testing
/// tool, not a real-match mechanic, so it stays out of the way otherwise.
public partial class GunSwitcher : CanvasLayer
{
    // Every real gun, skipping the setup screen's "Random" entry — mid-match there
    // is no meaningful "random" pick. Reuses TrainingSetupScreen's list/labels
    // rather than rebuilding the pool here.
    // The knife is appended last: it is always carried, so picking it just
    // swaps to slot 3 instead of rebuilding the loadout (see Close).
    internal static readonly string[] GunIds = BuildGunIds();

    static string[] BuildGunIds()
    {
        var ids = new List<string>();
        foreach (var id in TrainingSetupScreen.GunIds)
            if (id != TrainingConfig.RandomGun) ids.Add(id);
        ids.Add(GunCombat.KnifeId);
        return ids.ToArray();
    }

    static readonly Color NormalColor = new(0.60f, 0.60f, 0.60f, 0.9f);
    static readonly Color SelColor    = new(1.00f, 0.82f, 0.20f, 1.0f);

    PlayerController _player = null!;
    FontFile?         _font;

    PanelContainer? _panel;
    Label[]         _rows   = null!;
    bool            _open   = false;
    int             _selIdx = 0;

    public void Init(PlayerController player, FontFile? font)
    {
        _player = player;
        _font   = font;
        Layer   = 20;   // above the plain HUD hint, below the death overlay (100)

        _panel = new PanelContainer
        {
            Visible     = false,
            MouseFilter = Control.MouseFilterEnum.Ignore,
        };
        _panel.SetAnchorsPreset(Control.LayoutPreset.Center);
        var style = new StyleBoxFlat
        {
            BgColor                = new Color(0f, 0f, 0f, 0.75f),
            ContentMarginLeft      = 32, ContentMarginRight  = 32,
            ContentMarginTop       = 18, ContentMarginBottom = 18,
            CornerRadiusTopLeft    = 6,  CornerRadiusTopRight    = 6,
            CornerRadiusBottomLeft = 6,  CornerRadiusBottomRight = 6,
        };
        _panel.AddThemeStyleboxOverride("panel", style);
        AddChild(_panel);

        var vbox = new VBoxContainer();
        vbox.AddThemeConstantOverride("separation", 4);
        _panel.AddChild(vbox);

        var title = new Label { Text = "SWITCH WEAPON", HorizontalAlignment = HorizontalAlignment.Center };
        if (_font != null) title.AddThemeFontOverride("font", _font);
        title.AddThemeFontSizeOverride("font_size", 16);
        title.AddThemeColorOverride("font_color", new Color(0.55f, 0.55f, 0.55f));
        vbox.AddChild(title);
        vbox.AddChild(new Control { CustomMinimumSize = new Vector2(0, 6) });

        _rows = new Label[GunIds.Length];
        for (int i = 0; i < GunIds.Length; i++)
        {
            var lbl = new Label { HorizontalAlignment = HorizontalAlignment.Left };
            if (_font != null) lbl.AddThemeFontOverride("font", _font);
            vbox.AddChild(lbl);
            _rows[i] = lbl;
        }
        RefreshRows();
    }

    public override void _Process(double delta)
    {
        if (_panel == null || !TrainingConfig.AllowGunSwitch) return;

        bool held = Input.IsActionPressed("gun_switch");
        if (held && !_open) Open();
        else if (!held && _open) Close();
    }

    // Wheel only matters while the wheel is open — consumed here so it never
    // reaches gameplay (nothing currently binds it, but this keeps it that way).
    public override void _Input(InputEvent ev)
    {
        if (!_open) return;
        if (ev is not InputEventMouseButton mb || !mb.Pressed) return;

        if (mb.ButtonIndex == MouseButton.WheelUp)   { _selIdx = Wrap(_selIdx - 1); RefreshRows(); GetViewport().SetInputAsHandled(); }
        else if (mb.ButtonIndex == MouseButton.WheelDown) { _selIdx = Wrap(_selIdx + 1); RefreshRows(); GetViewport().SetInputAsHandled(); }
    }

    void Open()
    {
        _open = true;
        int cur = Array.IndexOf(GunIds, _player.Gun?.Def?.Id);
        _selIdx = cur >= 0 ? cur : 0;
        RefreshRows();
        _panel!.Visible = true;
    }

    void Close()
    {
        _open = false;
        _panel!.Visible = false;
        // The knife isn't a loadout gun — EquipStarterGun would park it in the
        // SECONDARY slot. Swap to it like key 3 does and keep the loadout.
        if (GunIds[_selIdx] == GunCombat.KnifeId) _player.SelectMelee();
        else                                      _player.EquipStarterGun(GunIds[_selIdx]);
    }

    void RefreshRows()
    {
        for (int i = 0; i < _rows.Length; i++)
        {
            bool sel = i == _selIdx;
            _rows[i].Text = (sel ? "> " : "   ") + TrainingSetupScreen.GunDisplay(GunIds[i]);
            _rows[i].AddThemeFontSizeOverride("font_size", sel ? 28 : 22);
            _rows[i].AddThemeColorOverride("font_color", sel ? SelColor : NormalColor);
        }
    }

    static int Wrap(int v)
    {
        int n = GunIds.Length;
        return ((v % n) + n) % n;
    }
}
