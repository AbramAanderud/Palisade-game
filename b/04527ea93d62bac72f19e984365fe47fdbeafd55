    /// Bounding box of a whole model hierarchy, measured in the ROOT's local
    /// space. Each mesh's AABB is transformed by its chain of parent transforms
    /// before merging — the guns are multi-part models (slide, magazine, trigger
    /// are separate nodes with their own offsets), so merging raw mesh-local
    /// boxes would badly mis-measure them and throw off both scaling and the
    /// barrel-axis check.
    public static Aabb MeasureAabb(Node root)
    {
        var  result = new Aabb();
        bool first  = true;

        void Walk(Node n, Transform3D xform)
        {
            // The root's own transform is excluded so the result stays local to it.
            var local = (n is Node3D n3 && n != root) ? xform * n3.Transform : xform;

            if (n is MeshInstance3D mi && mi.Mesh != null)
            {
                var a = local * mi.Mesh.GetAabb();
                if (first) { result = a; first = false; }
                else       { result = result.Merge(a); }
            }
            foreach (Node c in n.GetChildren()) Walk(c, local);
        }

        Walk(root, Transform3D.Identity);
        return result;
    }

