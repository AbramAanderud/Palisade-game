    /// arena prizes are PRIMARY — previously that rule was only implied by which
    /// of PlayerController.EquipStarterGun / EquipArenaGun happened to be
    /// called, so a gun added to the wrong pool would land in the wrong slot
    /// with nothing to catch it. TestGunSlots asserts pool and slot agree.
    public enum GunSlot { Primary, Secondary }
    public enum Phase    { Idle, Firing, Reloading, Empty }

