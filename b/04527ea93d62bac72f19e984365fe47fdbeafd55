    /// Aim input is ignored entirely on guns without a scope, so only the AWP
    /// ever enters ADS. Everything downstream (spread bonus, speed cap, viewmodel
    /// pull-in, third-person camera) keys off IsAiming, so this one gate covers
    /// all of them. Firing a scoped gun kicks the player out of the scope for
    /// the bolt cycle (_adsLockout, Rivals-style), and reloading unscopes too —
    /// the controller re-asserts held aim input every tick, so a held RMB
    /// re-scopes automatically the moment the gun is ready again.
    public void SetAiming(bool on) =>
        _aiming = on && _def.CanAds && _adsLockout <= 0f && _phase != Phase.Reloading;

    /// Whether the equipped gun can aim at all — the HUD hides the ADS hint and
    /// the controller skips the speed cap when this is false.
    public bool CanAds => _def.CanAds;

    // ── Read-only surface ─────────────────────────────────────────────────────
    public GunDef  Def           => _def;
    public Phase   CombatPhase   => _phase;
    public int     Ammo          => _ammo;
    public bool    IsAiming      => _aiming;
    public bool    IsReloading   => _phase == Phase.Reloading;
    public bool    IsEmpty       => _ammo <= 0;
    public float   SpreadDegrees => _spreadNow;
    public float   AmmoFraction  => MagSize > 0 ? _ammo / (float)MagSize : 0f;
    public bool    JustFired     => _flashLeft > 0f;

    /// 0 → just started, 1 → complete. Drives the HUD reload ring; 0 when idle.
    public float ReloadProgress =>
        _phase == Phase.Reloading && ReloadDur > 0.001f
            ? Mathf.Clamp(1f - (_reloadLeft / ReloadDur), 0f, 1f)
            : 0f;

    /// 0 → just fired, 1 → ready again. Drives the slide/pump cycle animation.
    public float FireCycle =>
        FireInterval > 0.001f ? Mathf.Clamp(1f - (_fireTimer / FireInterval), 0f, 1f) : 1f;

