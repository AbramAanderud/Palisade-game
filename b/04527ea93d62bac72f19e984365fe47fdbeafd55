    readonly Dictionary<string, int> _storedAmmo = new();

    /// Swap to another owned gun, preserving each gun's magazine. Equip() stays
    /// the fresh-loadout path (full mag); this is the mid-match slot swap.
    public void SwitchTo(string id)
    {
        if (id == _def.Id) return;
        _storedAmmo[_def.Id] = _ammo;
        Equip(id);
        if (_storedAmmo.TryGetValue(id, out int kept)) _ammo = kept;
        // Arriving on a dry mag starts the reload immediately — the swap itself
        // was the player's "do something" input, don't make them press R too.
        if (_ammo <= 0) StartReload();
    }

    /// Forget remembered magazines — call when handing out a fresh spawn loadout.
    public void ResetStoredAmmo() => _storedAmmo.Clear();

    /// Remembered mag for a holstered gun (HUD readout); full mag if never held.
    public int StoredAmmo(string id)
        => _storedAmmo.TryGetValue(id, out var a) ? a
         : Defs.TryGetValue(id, out var d) ? d.MagSize : 0;

    // ── Per-frame tick ────────────────────────────────────────────────────────
    /// aimOrigin/aimDir come from the FP camera; moveSpeed is horizontal m/s.
    public void Tick(float dt, Vector3 aimOrigin, Vector3 aimDir,
                     float moveSpeed, bool airborne)
    {
        if (_fireTimer > 0f) _fireTimer -= dt;
        if (_flashLeft > 0f) _flashLeft -= dt;
        if (_adsLockout > 0f) _adsLockout -= dt;

        _spreadNow = CurrentSpread(moveSpeed, airborne);

        if (_phase == Phase.Reloading)
        {
            _reloadLeft -= dt;
            if (_reloadLeft <= 0f)
            {
                _ammo  = MagSize;
                _phase = Phase.Idle;
                OnReloadEnd?.Invoke();
            }
            _attackRequested = false;
            _reloadRequested = false;
            return;
        }

        if (_reloadRequested)
        {
            _reloadRequested = false;
            if (_ammo < MagSize) StartReload();
        }

        if (_attackRequested)
        {
            _attackRequested = false;

            if (_ammo <= 0)
            {
                // Dry click, then auto-reload so nobody is stuck holding an empty
                // gun because they forgot to press R.
                if (_fireTimer <= 0f)
                {
                    _drySfx.Play();
                    OnDryFire?.Invoke();
                    _fireTimer = 0.25f;
                    StartReload();
                }
            }
            else if (_fireTimer <= 0f)
            {
                Fire(aimOrigin, aimDir);
            }
        }

        // Do NOT clobber a reload that just started this tick — StartReload sets
        // Phase.Reloading above, and overwriting it here would cancel every
        // reload on the same frame it began (IsReloading would never read true,
        // so the HUD ring would never appear and the magazine would never refill).
        if (_phase != Phase.Reloading)
            _phase = _flashLeft > 0f ? Phase.Firing
                   : _ammo <= 0      ? Phase.Empty
                   : Phase.Idle;
    }

    void StartReload()
    {
        if (_phase == Phase.Reloading) return;
        _phase      = Phase.Reloading;
        _reloadLeft = ReloadDur;
        _reloadSfx.Play();
        OnReloadStart?.Invoke();
    }

    /// Cone half-angle in degrees. Movement and airtime deliberately do NOT
    /// widen it — you are exactly as accurate mid-bhop as standing still, so
    /// repositioning and jumping are always free (hero-shooter model, see
    /// header). The params stay so call sites and the damage-profile harness
    /// keep compiling and can prove the flatness.
    public float CurrentSpread(float moveSpeed, bool airborne)
    {
        float s = _def.SpreadBase;
        if (_aiming) s *= _def.AdsSpreadMult;
        return s;
    }

    // ── Shooting ──────────────────────────────────────────────────────────────
    void Fire(Vector3 origin, Vector3 dir)
    {
        _ammo--;
        _fireTimer = FireInterval;
        _flashLeft = 0.06f;

        // Bolt-action feel (Rivals): a scoped gun kicks you out of the scope on
        // every shot, and the scope can't come back until the gun can fire again.
        // The unscope must land THIS frame — the controller already called
        // SetAiming for this tick, so clearing the timer alone would leave one
        // scoped frame.
        if (_def.CanAds)
        {
            _adsLockout = FireInterval;
            _aiming     = false;
        }

        // Vary pitch per shot. Without this every round is the SAME waveform:
        // at the MAC-10's 0.15 s interval that phase-locks into a flat buzz
        // rather than reading as distinct rounds. +/-4% is under the threshold
        // where a listener hears "detuned" but well over the one where repeats
        // stop sounding copy-pasted.
        _fireSfx.PitchScale = 1f + (GD.Randf() - 0.5f) * 2f * FirePitchJitter;
        _fireSfx.Play();
        OnFired?.Invoke(_def.Id);

        // Emptying the magazine reloads immediately — for the single-shot rocket
        // tube this IS the weapon's rhythm: fire, reload, fire. Ordered AFTER
        // OnFired so the reload ANIMATION is not stomped by the shoot one-shot
        // (the reload is 2.8 s of visible telegraph; the muzzle pose is 0.18 s).
        if (_ammo <= 0) StartReload();

        // Hits come from the CAMERA (crosshair-true); visuals come from the
        // MUZZLE. Falls back to a point in front of the eye if no model exists.
        var muzzle = GetMuzzleWorld?.Invoke() ?? origin + dir * 0.5f;

        GunFx.MuzzleFlash(this, muzzle, dir,
                          _def.Mode == FireMode.Projectile ? 1.6f
                        : _def.Mode == FireMode.Pellets    ? 1.3f : 1.0f);

        switch (_def.Mode)
        {
            case FireMode.Projectile:
                GunFx.Backblast(this, muzzle, dir);
                FireProjectile(muzzle, origin, dir);
                break;
            case FireMode.Pellets:
                GunFx.Casing(this, muzzle, dir);
                FireHitscan(origin, muzzle, dir, _def.Pellets);
                break;
            default:
                GunFx.Casing(this, muzzle, dir);
                FireHitscan(origin, muzzle, dir, 1);
                break;
        }
    }

    void FireHitscan(Vector3 origin, Vector3 muzzle, Vector3 dir, int pellets)
    {
        // Accumulate per-target so a shotgun blast produces ONE damage number
        // and one TakeDamage call rather than eight of each.
        var tally = new Dictionary<Node3D, (float dmg, Vector3 pos, bool head)>();

        for (int i = 0; i < pellets; i++)
        {
            var shotDir = ApplySpread(dir, _spreadNow);
            var to      = origin + shotDir * _def.Range;
            var hit     = Raycast(origin, to);

            Vector3 endPoint = to;
            if (hit.Count > 0)
            {
                endPoint = (Vector3)hit["position"];
                if (hit["collider"].As<GodotObject>() is Node3D body)
                {
                    // Shootable world objects (e.g. a gate's targets) react to the hit
                    // directly; they carry no PlayerHealth so TallyHit ignores them.
                    if (body is IShootable shootable) shootable.OnShot(endPoint);
                    TallyHit(tally, body, endPoint);
                }
            }

            // Tracer flies from the MUZZLE to wherever the camera ray landed —
            // the visual converges onto the true hit like every modern shooter.
            // A shotgun blast tracers every third pellet: enough to read the
            // cone without filling the screen with nine streaks.
            if (pellets == 1 || i % 3 == 0)
                GunFx.Tracer(this, muzzle, endPoint);

            // First ray's endpoint goes to the net layer so the opponent's
            // client can draw this exact shot from their side.
            if (i == 0) OnShotEndpoint?.Invoke(endPoint);
        }

        foreach (var (body, e) in tally)
        {
            var health = body.GetNodeOrNull<PlayerHealth>("PlayerHealth");
            if (health != null) DeliverDamage(body, health, e.dmg, e.pos, e.head);
        }
    }

    void TallyHit(Dictionary<Node3D, (float, Vector3, bool)> tally,
                  Node3D body, Vector3 hitPos)
    {
        var health = body.GetNodeOrNull<PlayerHealth>("PlayerHealth");
        if (health == null) return;   // world geometry — the tracer's arrival draws the impact

        // Never damage our own team.
        var theirs = FindGunCombat(body);
        if (theirs != null && theirs.CombatTeam == CombatTeam) return;

        // Hit-location zones are measured from the FEET. BOTH body types — players
        // AND dummies — centre their 1.6 m capsule on the origin, so feet sit at
        // origin − 0.8. The old code assumed feet-at-origin, which meant a head
        // could NEVER register (collider tops out at rel 0.8 vs a 1.5 threshold)
        // and centre-mass hits at rel ~0.2 scored as LEG shots. Every fight since
        // guns shipped has been fought on the wrong multipliers.
        float footY   = body.GlobalPosition.Y - 0.8f;
        float relY    = hitPos.Y - footY;
        bool  head    = relY > HeadMinY;
        float locMult = head ? HeadMult : relY < LegsMaxY ? LegsMult : 1.0f;

        // A sniper headshot is a rule, not an arithmetic accident: deal the full
        // health pool so it stays lethal no matter how Damage or MaxHealth are
        // later retuned. DamageMultiplier is divided out because DeliverDamage
        // multiplies it back in.
        float dmg = (head && _def.OneShotHeadshot)
            ? PlayerHealth.MaxHealth / Mathf.Max(DamageMultiplier, 0.001f)
            : Damage * locMult;

        if (tally.TryGetValue(body, out var cur))
            tally[body] = (cur.Item1 + dmg, cur.Item2, cur.Item3 || head);
        else
            tally[body] = (dmg, hitPos, head);
    }

    void FireProjectile(Vector3 muzzle, Vector3 origin, Vector3 dir)
    {
        var shotDir = ApplySpread(dir, _spreadNow);
        // The rocket leaves the TUBE, not the eye — its flight line starts at the
        // muzzle and converges onto the camera ray's direction, which is both how
        // it looks right and how launchers behave in every serious shooter.
        Rocket.Spawn(GetTree().Root, muzzle + shotDir * 0.3f, shotDir, _def, this);
        OnShotEndpoint?.Invoke(muzzle + shotDir * _def.Range);

        // Rocket jumping falls out for free: kick the shooter back along the shot.
        if (_def.SelfKnockback > 0f)
            ApplyImpulse?.Invoke(-shotDir * _def.SelfKnockback);
    }

    Godot.Collections.Dictionary Raycast(Vector3 from, Vector3 to)
    {
        var space = GetParent<Node3D>().GetWorld3D().DirectSpaceState;
        var query = PhysicsRayQueryParameters3D.Create(from, to);
        query.CollideWithBodies = true;
        query.CollideWithAreas  = false;
        if (GetParent() is CollisionObject3D self)
            query.Exclude = new Godot.Collections.Array<Rid> { self.GetRid() };
        return space.IntersectRay(query);
    }

    /// Rotate `dir` by a random offset inside a cone of `degrees` half-angle.
    Vector3 ApplySpread(Vector3 dir, float degrees)
    {
        if (degrees <= 0.001f) return dir.Normalized();

        dir = dir.Normalized();
        var up    = Mathf.Abs(dir.Dot(Vector3.Up)) > 0.99f ? Vector3.Right : Vector3.Up;
        var right = dir.Cross(up).Normalized();
        up        = right.Cross(dir).Normalized();

        // Uniform disc sample so the cone fills evenly rather than clustering.
        float ang = GD.Randf() * Mathf.Tau;
        float rad = Mathf.Sqrt(GD.Randf()) * Mathf.DegToRad(degrees);
        var offset = (right * Mathf.Cos(ang) + up * Mathf.Sin(ang)) * Mathf.Tan(rad);
        return (dir + offset).Normalized();
    }

    /// Public so Rocket can route its splash through the same damage path.
    public void DeliverDamage(Node3D target, PlayerHealth health,
                              float damage, Vector3 hitPos, bool headshot)
    {
        float finalDmg = damage * DamageMultiplier;
        GD.Print($"[Gun] HIT {target.Name} | {(headshot ? "HEAD" : "BODY")} | " +
                 $"{finalDmg:F0} dmg ({_def.Display}, spread {_spreadNow:F2}°)");

        health.TakeDamage(finalDmg, hitPos);
        SpawnDamageNumber(hitPos, finalDmg, headshot);
        // Audible hit-confirm at the wound — the flesh thock every shooter keys
        // on. Headshots ring sharper (pitched up) so the ear learns the
        // difference before the eye reads the gold number.
        GunFx.PlayOneShot3D(this, "res://assets/audio/sfx/combat/swordfleshimpact.wav",
                            hitPos, maxDist: 35f, pitch: headshot ? 1.35f : 1.0f);

        // Hit confirm in the shooter's own ears. A headshot stacks the ding ON
        // TOP of the marker instead of replacing it, so the confirmation always
        // arrives in the same place and the ding reads as the bonus on top —
        // swapping them would make a headshot feel like a different event than
        // a hit, rather than a better one.
        if (!OnRemotePuppet)
        {
            Ping(_hitMarkerSfx);
            if (headshot) Ping(_headshotSfx);
            OnHitConfirmed?.Invoke(headshot);
        }

        if (Lifesteal > 0f)
        {
            var selfHealth = GetParent<Node3D>()?.GetNodeOrNull<PlayerHealth>("PlayerHealth");
            selfHealth?.Heal(finalDmg * Lifesteal);
        }
    }

    static GunCombat? FindGunCombat(Node3D body)
    {
        foreach (Node child in body.GetChildren())
            if (child is GunCombat gc) return gc;
        return null;
    }

    // ── Visuals ───────────────────────────────────────────────────────────────
    public void SpawnDamageNumber(Vector3 worldPos, float damage, bool headshot)
    {
        var label = new Label3D
        {
            Text        = ((int)damage).ToString(),
            FontSize    = headshot ? 96 : 72,
            Modulate    = headshot ? new Color(1f, 0.85f, 0.15f, 1f)
                                   : new Color(1f, 0.12f, 0.08f, 1f),
            Billboard   = BaseMaterial3D.BillboardModeEnum.Enabled,
            NoDepthTest = true,
            Position    = worldPos + new Vector3(GD.Randf() * 0.5f - 0.25f, 0f,
                                                 GD.Randf() * 0.3f - 0.15f),
        };
        GetTree().Root.AddChild(label);

        var tween = label.CreateTween();
        tween.TweenProperty(label, "position:y", label.Position.Y + 1.8f, 0.85f)
             .SetEase(Tween.EaseType.Out).SetTrans(Tween.TransitionType.Quad);
        tween.Parallel()
             .TweenProperty(label, "modulate:a", 0f, 0.5f)
             .SetDelay(0.35f);
        tween.TweenCallback(Callable.From(label.QueueFree));
    }


    // ── Interrupts ────────────────────────────────────────────────────────────
    /// Taking a hit cancels a reload — getting shot mid-reload should hurt.
    // ── Puppet audio ──────────────────────────────────────────────────────────
    // The relay replays the opponent's shots/reloads on THIS client; these let
    // the puppet's own 3D emitters carry the sound, so distance attenuation and
    // stream-per-gun (EquipGun swaps _fireSfx) come for free.
    public void PlayFireSfx()   => _fireSfx?.Play();
    public void PlayReloadSfx() => _reloadSfx?.Play();
    public void PlayDrySfx()    => _drySfx?.Play();

    /// Test hooks. The confirm audio is null-guarded end to end, so a missing or
    /// unloadable file degrades to silence — which is exactly how the gun WAVs
    /// managed to be absent for everyone once already. These let the harness
    /// assert the streams genuinely loaded instead of trusting the guard.
    public bool HitMarkerLoaded  => _hitMarkerSfx?.Stream  != null;
    public bool HeadshotLoaded   => _headshotSfx?.Stream   != null;
    public bool HitMarkerPlaying => _hitMarkerSfx?.Playing ?? false;
    public bool HeadshotPlaying  => _headshotSfx?.Playing  ?? false;

    public void InterruptByHit()
    {
        if (_phase != Phase.Reloading) return;
        _phase      = Phase.Idle;
        _reloadLeft = 0f;
        OnReloadEnd?.Invoke();
    }
}
