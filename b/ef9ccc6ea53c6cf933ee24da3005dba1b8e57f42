using System.Collections.Generic;
using Godot;

/// test/TestFfaRematch.cs — pure rematch vote tally / decision / offset rule.
public partial class TestFfaRematch : Node
{
    int _fail;
    void Check(bool ok, string label) { GD.Print((ok ? "PASS  " : "FAIL  ") + label); if (!ok) _fail++; }

    static Dictionary<int, RematchMode> V(params (int seat, RematchMode m)[] v)
    {
        var d = new Dictionary<int, RematchMode>();
        foreach (var (s, m) in v) d[s] = m;
        return d;
    }

    public override void _Ready()
    {
        var all4 = new[] { 0, 1, 2, 3 };
        var S = RematchMode.Same; var R = RematchMode.Rotate;

        Check(FfaRematch.Decide(all4, V((0, S), (1, S), (2, S), (3, R)), 0) == S, "4-seat majority Same");
        Check(FfaRematch.Decide(all4, V((0, R), (1, R), (2, S), (3, R)), 0) == R, "4-seat majority Rotate");
        Check(FfaRematch.Decide(all4, V((0, S), (1, S), (2, R), (3, R)), 0) == S, "2-2 tie, host votes Same");
        Check(FfaRematch.Decide(all4, V((0, R), (1, S), (2, S), (3, R)), 0) == R, "2-2 tie, host votes Rotate");
        Check(FfaRematch.Decide(all4, V((0, S), (1, S), (2, R)), 0) == null, "one seat not voted -> null");
        Check(FfaRematch.Decide(new[] { 0, 1 }, V((0, S), (1, S)), 0) == null, "2 remaining -> null");
        Check(FfaRematch.Decide(new[] { 0, 1, 2 }, V((0, S), (1, R), (2, R), (3, S), (4, S)), 0) == R,
            "votes from non-remaining seats ignored");
        var t = FfaRematch.Tally(new[] { 0, 1, 2 }, V((0, S), (1, R), (2, R), (3, S)));
        Check(t.same == 1 && t.rotate == 2, "tally ignores non-remaining");

        Check(FfaRematch.NextOffset(1, 4, S) == 1 && FfaRematch.NextOffset(2, 4, S) == 2 && FfaRematch.NextOffset(3, 4, S) == 3,
            "n=4 same keeps 1/2/3");
        Check(FfaRematch.NextOffset(1, 4, R) == 2 && FfaRematch.NextOffset(2, 4, R) == 3 && FfaRematch.NextOffset(3, 4, R) == 1,
            "n=4 rotate 1->2->3->1");
        Check(FfaRematch.NextOffset(3, 3, S) == 1 && FfaRematch.NextOffset(1, 3, S) == 1 && FfaRematch.NextOffset(2, 3, S) == 2,
            "n=3 same: 3->1, keeps 1, 2");
        Check(FfaRematch.NextOffset(1, 3, R) == 2 && FfaRematch.NextOffset(2, 3, R) == 1, "n=3 rotate 1->2->1");

        bool ok = true;
        foreach (int n in new[] { 3, 4 })
            for (int o = 1; o < n + 2; o++)
                foreach (var m in new[] { S, R })
                {
                    int r = FfaRematch.NextOffset(o, n, m);
                    if (r == 0 || r >= n) ok = false;
                }
        Check(ok, "offset never 0 and never >= n");

        GD.Print(_fail == 0 ? "ALL PASS" : $"{_fail} FAILED");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
