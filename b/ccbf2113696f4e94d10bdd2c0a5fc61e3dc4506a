    AudioStreamPlayer3D _fireSfx   = null!;
    AudioStreamPlayer3D _reloadSfx = null!;
    AudioStreamPlayer3D _drySfx    = null!;

    // The gun WAVs may not exist yet. ResourceLoader.Exists is checked FIRST so a
    // missing file is a silent no-op instead of a wall of GD.Load error spam —
    // the guns stay fully playable, just silent, until the audio is dropped in.
    static AudioStreamPlayer3D MakeSfx3D(Node3D parent, string path, float maxDist)
    {
        var sfx = new AudioStreamPlayer3D { MaxDistance = maxDist };
        if (ResourceLoader.Exists(path))
        {
            var stream = GD.Load<AudioStream>(path);
            if (stream != null) sfx.Stream = stream;
        }
        parent.AddChild(sfx);
        return sfx;
    }

    public override void _Ready()
    {
        var parent = GetParent<Node3D>();
        _fireSfx   = MakeSfx3D(parent, _def.FireSfx, 110f);
        _reloadSfx = MakeSfx3D(parent, "res://assets/audio/sfx/combat/GunReload.wav", 25f);
        _drySfx    = MakeSfx3D(parent, "res://assets/audio/sfx/combat/GunDryFire.wav", 20f);
        Equip(_def.Id);
    }

    // ── Equip ─────────────────────────────────────────────────────────────────
    /// Swap the active weapon and refill it.
    public void Equip(string id)
    {
        if (!Defs.TryGetValue(id, out var def))
        {
            GD.PrintErr($"[Gun] Unknown gun id '{id}' — falling back to pew");
            def = Defs["pew"];
        }
        _def = def;

        Damage       = def.Damage;
        FireInterval = def.FireInterval;
        MagSize      = def.MagSize;
        ReloadDur    = def.ReloadDur;
        RecoilKick   = def.RecoilKick;

        _ammo       = MagSize;
        _phase      = Phase.Idle;
        _reloadLeft = 0f;
        _fireTimer  = 0f;

        // Swap the firing sound to match the new gun (silent if the WAV is absent).
        if (_fireSfx != null && ResourceLoader.Exists(def.FireSfx))
        {
            var stream = GD.Load<AudioStream>(def.FireSfx);
            if (stream != null) _fireSfx.Stream = stream;
        }

        GD.Print($"[Gun] Equipped {def.Display} ({def.Mode}, {def.Damage} dmg × {def.Pellets})");
        OnEquipped?.Invoke(def.Id);
    }

    // ── Per-frame tick ────────────────────────────────────────────────────────
    /// aimOrigin/aimDir come from the FP camera; moveSpeed is horizontal m/s.
    public void Tick(float dt, Vector3 aimOrigin, Vector3 aimDir,
                     float moveSpeed, bool airborne)
    {
        if (_fireTimer > 0f) _fireTimer -= dt;
        if (_flashLeft > 0f) _flashLeft -= dt;

        _spreadNow = CurrentSpread(moveSpeed, airborne);

        if (_phase == Phase.Reloading)
        {
            _reloadLeft -= dt;
            if (_reloadLeft <= 0f)
            {
                _ammo  = MagSize;
                _phase = Phase.Idle;
                OnReloadEnd?.Invoke();
            }
            _attackRequested = false;
            _reloadRequested = false;
            return;
        }

        if (_reloadRequested)
        {
            _reloadRequested = false;
            if (_ammo < MagSize) StartReload();
        }

        if (_attackRequested)
        {
            _attackRequested = false;

            if (_ammo <= 0)
            {
                // Dry click, then auto-reload so nobody is stuck holding an empty
                // gun because they forgot to press R.
                if (_fireTimer <= 0f)
                {
                    _drySfx.Play();
                    OnDryFire?.Invoke();
                    _fireTimer = 0.25f;
                    StartReload();
                }
            }
            else if (_fireTimer <= 0f)
            {
                Fire(aimOrigin, aimDir);
            }
        }

        // Do NOT clobber a reload that just started this tick — StartReload sets
        // Phase.Reloading above, and overwriting it here would cancel every
        // reload on the same frame it began (IsReloading would never read true,
        // so the HUD ring would never appear and the magazine would never refill).
        if (_phase != Phase.Reloading)
            _phase = _flashLeft > 0f ? Phase.Firing
                   : _ammo <= 0      ? Phase.Empty
                   : Phase.Idle;
    }

    void StartReload()
    {
        if (_phase == Phase.Reloading) return;
        _phase      = Phase.Reloading;
        _reloadLeft = ReloadDur;
        _reloadSfx.Play();
        OnReloadStart?.Invoke();
    }

    /// Cone half-angle in degrees for the current movement state.
    public float CurrentSpread(float moveSpeed, bool airborne)
    {
        float s = _def.SpreadBase + _def.SpreadPerSpeed * Mathf.Max(moveSpeed, 0f);
        if (airborne) s += _def.SpreadAir;
        s = Mathf.Min(s, _def.SpreadMax);
        if (_aiming) s *= _def.AdsSpreadMult;
        return s;
    }

    // ── Shooting ──────────────────────────────────────────────────────────────
    void Fire(Vector3 origin, Vector3 dir)
    {
        _ammo--;
        _fireTimer = FireInterval;
        _flashLeft = 0.06f;

        _fireSfx.Play();
        OnFired?.Invoke(_def.Id);

        switch (_def.Mode)
        {
            case FireMode.Projectile: FireProjectile(origin, dir); break;
            case FireMode.Pellets:    FireHitscan(origin, dir, _def.Pellets); break;
            default:                  FireHitscan(origin, dir, 1); break;
        }
    }

    void FireHitscan(Vector3 origin, Vector3 dir, int pellets)
    {
        // Accumulate per-target so a shotgun blast produces ONE damage number
        // and one TakeDamage call rather than eight of each.
        var tally = new Dictionary<Node3D, (float dmg, Vector3 pos, bool head)>();

        for (int i = 0; i < pellets; i++)
        {
            var shotDir = ApplySpread(dir, _spreadNow);
            var to      = origin + shotDir * _def.Range;
            var hit     = Raycast(origin, to);

            Vector3 endPoint = to;
            if (hit.Count > 0)
            {
                endPoint = (Vector3)hit["position"];
                if (hit["collider"].As<GodotObject>() is Node3D body)
                    TallyHit(tally, body, endPoint);
                else
                    SpawnImpactSpark(endPoint);
            }
            SpawnTracer(origin, endPoint);
        }

        foreach (var (body, e) in tally)
        {
            var health = body.GetNodeOrNull<PlayerHealth>("PlayerHealth");
            if (health != null) DeliverDamage(body, health, e.dmg, e.pos, e.head);
        }
    }

    void TallyHit(Dictionary<Node3D, (float, Vector3, bool)> tally,
                  Node3D body, Vector3 hitPos)
    {
        var health = body.GetNodeOrNull<PlayerHealth>("PlayerHealth");
        if (health == null) { SpawnImpactSpark(hitPos); return; }

        // Never damage our own team.
        var theirs = FindGunCombat(body);
        if (theirs != null && theirs.CombatTeam == CombatTeam) return;

        float relY    = hitPos.Y - body.GlobalPosition.Y;
        bool  head    = relY > HeadMinY;
        float locMult = head ? HeadMult : relY < LegsMaxY ? LegsMult : 1.0f;

        if (tally.TryGetValue(body, out var cur))
            tally[body] = (cur.Item1 + Damage * locMult, cur.Item2, cur.Item3 || head);
        else
            tally[body] = (Damage * locMult, hitPos, head);
    }

    void FireProjectile(Vector3 origin, Vector3 dir)
    {
        var shotDir = ApplySpread(dir, _spreadNow);
        Rocket.Spawn(GetTree().Root, origin + shotDir * 0.8f, shotDir, _def, this);

        // Rocket jumping falls out for free: kick the shooter back along the shot.
        if (_def.SelfKnockback > 0f)
            ApplyImpulse?.Invoke(-shotDir * _def.SelfKnockback);
    }

    Godot.Collections.Dictionary Raycast(Vector3 from, Vector3 to)
    {
        var space = GetParent<Node3D>().GetWorld3D().DirectSpaceState;
        var query = PhysicsRayQueryParameters3D.Create(from, to);
        query.CollideWithBodies = true;
        query.CollideWithAreas  = false;
        if (GetParent() is CollisionObject3D self)
            query.Exclude = new Godot.Collections.Array<Rid> { self.GetRid() };
        return space.IntersectRay(query);
    }

    /// Rotate `dir` by a random offset inside a cone of `degrees` half-angle.
    Vector3 ApplySpread(Vector3 dir, float degrees)
    {
        if (degrees <= 0.001f) return dir.Normalized();

        dir = dir.Normalized();
        var up    = Mathf.Abs(dir.Dot(Vector3.Up)) > 0.99f ? Vector3.Right : Vector3.Up;
        var right = dir.Cross(up).Normalized();
        up        = right.Cross(dir).Normalized();

        // Uniform disc sample so the cone fills evenly rather than clustering.
        float ang = GD.Randf() * Mathf.Tau;
        float rad = Mathf.Sqrt(GD.Randf()) * Mathf.DegToRad(degrees);
        var offset = (right * Mathf.Cos(ang) + up * Mathf.Sin(ang)) * Mathf.Tan(rad);
        return (dir + offset).Normalized();
    }

    /// Public so Rocket can route its splash through the same damage path.
    public void DeliverDamage(Node3D target, PlayerHealth health,
                              float damage, Vector3 hitPos, bool headshot)
    {
        float finalDmg = damage * DamageMultiplier;
        GD.Print($"[Gun] HIT {target.Name} | {(headshot ? "HEAD" : "BODY")} | " +
                 $"{finalDmg:F0} dmg ({_def.Display}, spread {_spreadNow:F2}°)");

        health.TakeDamage(finalDmg, hitPos);
        SpawnDamageNumber(hitPos, finalDmg, headshot);

        if (Lifesteal > 0f)
        {
            var selfHealth = GetParent<Node3D>()?.GetNodeOrNull<PlayerHealth>("PlayerHealth");
            selfHealth?.Heal(finalDmg * Lifesteal);
        }
    }

    static GunCombat? FindGunCombat(Node3D body)
    {
        foreach (Node child in body.GetChildren())
            if (child is GunCombat gc) return gc;
        return null;
    }

    // ── Visuals ───────────────────────────────────────────────────────────────
    public void SpawnDamageNumber(Vector3 worldPos, float damage, bool headshot)
    {
        var label = new Label3D
        {
            Text        = ((int)damage).ToString(),
            FontSize    = headshot ? 96 : 72,
            Modulate    = headshot ? new Color(1f, 0.85f, 0.15f, 1f)
                                   : new Color(1f, 0.12f, 0.08f, 1f),
            Billboard   = BaseMaterial3D.BillboardModeEnum.Enabled,
            NoDepthTest = true,
            Position    = worldPos + new Vector3(GD.Randf() * 0.5f - 0.25f, 0f,
                                                 GD.Randf() * 0.3f - 0.15f),
        };
        GetTree().Root.AddChild(label);

        var tween = label.CreateTween();
        tween.TweenProperty(label, "position:y", label.Position.Y + 1.8f, 0.85f)
             .SetEase(Tween.EaseType.Out).SetTrans(Tween.TransitionType.Quad);
        tween.Parallel()
             .TweenProperty(label, "modulate:a", 0f, 0.5f)
             .SetDelay(0.35f);
        tween.TweenCallback(Callable.From(label.QueueFree));
    }

    /// Thin glowing line from muzzle to impact, faded over ~80 ms. This is the
    /// main thing that makes a hitscan shot legible to the person being shot at.
    void SpawnTracer(Vector3 from, Vector3 to)
    {
        float len = from.DistanceTo(to);
        if (len < 0.1f) return;

        var mat = new StandardMaterial3D
        {
            AlbedoColor              = new Color(1f, 0.88f, 0.55f, 0.85f),
            EmissionEnabled          = true,
            Emission                 = new Color(1f, 0.80f, 0.40f),
            EmissionEnergyMultiplier = 4f,
            ShadingMode              = BaseMaterial3D.ShadingModeEnum.Unshaded,
            Transparency             = BaseMaterial3D.TransparencyEnum.Alpha,
            CullMode                 = BaseMaterial3D.CullModeEnum.Disabled,
        };

        var mesh = new MeshInstance3D
        {
            Mesh = new CylinderMesh
            {
                TopRadius = 0.012f, BottomRadius = 0.012f, Height = len,
                RadialSegments = 4, Rings = 1,
            },
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        };
        mesh.SetSurfaceOverrideMaterial(0, mat);

        GetTree().Root.AddChild(mesh);
        mesh.GlobalPosition = (from + to) * 0.5f;
        var dir = (to - from).Normalized();
        if (Mathf.Abs(dir.Dot(Vector3.Up)) < 0.999f)
            mesh.LookAtFromPosition(mesh.GlobalPosition, mesh.GlobalPosition + dir, Vector3.Up);
        mesh.RotateObjectLocal(Vector3.Right, Mathf.Pi / 2f);

        var tw = mesh.CreateTween();
        tw.TweenProperty(mat, "albedo_color:a", 0f, 0.08f);
        tw.TweenCallback(Callable.From(mesh.QueueFree));
    }

    void SpawnImpactSpark(Vector3 pos)
    {
        var mat = new StandardMaterial3D
        {
            AlbedoColor              = new Color(1f, 0.9f, 0.6f, 0.9f),
            EmissionEnabled          = true,
            Emission                 = new Color(1f, 0.75f, 0.35f),
            EmissionEnergyMultiplier = 6f,
            ShadingMode              = BaseMaterial3D.ShadingModeEnum.Unshaded,
            Transparency             = BaseMaterial3D.TransparencyEnum.Alpha,
        };
        var spark = new MeshInstance3D
        {
            Mesh = new SphereMesh { Radius = 0.05f, Height = 0.1f,
                                    RadialSegments = 6, Rings = 3 },
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        };
        spark.SetSurfaceOverrideMaterial(0, mat);
        GetTree().Root.AddChild(spark);
        spark.GlobalPosition = pos;

        var tw = spark.CreateTween();
        tw.TweenProperty(spark, "scale", Vector3.One * 0.1f, 0.12f);
        tw.Parallel().TweenProperty(mat, "albedo_color:a", 0f, 0.12f);
        tw.TweenCallback(Callable.From(spark.QueueFree));
    }

    // ── Interrupts ────────────────────────────────────────────────────────────
    /// Taking a hit cancels a reload — getting shot mid-reload should hurt.
    public void InterruptByHit()
    {
        if (_phase != Phase.Reloading) return;
        _phase      = Phase.Idle;
        _reloadLeft = 0f;
        OnReloadEnd?.Invoke();
    }
}
