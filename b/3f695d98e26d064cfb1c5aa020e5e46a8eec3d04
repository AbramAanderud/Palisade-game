@echo off
REM Launches the local relay + FOUR game windows (FfaA..FfaD) for testing
REM free-for-all (3-4 player) matches on one PC.
REM
REM Usage:
REM   test-ffa-local.bat        run the EDITOR binary against this folder (default)
REM   test-ffa-local.bat exe    run build\windows\Corners.exe instead
REM
REM WHY the default is the editor binary: the exported build\windows\Corners.exe
REM only contains FFA if it was re-exported from the feat/ffa-4p branch. An old
REM export silently has no "Host FFA" button. The editor binary with --path runs
REM the current source in this folder, so it always has FFA.
REM   - Editor mode needs the C# assembly built once first:
REM       dotnet build Palisade.csproj -v q
REM     (close the Godot editor first if the build hits a locked DLL).
REM   - Override the binary with:  set GODOT=C:\path\to\Godot_..._mono_win64.exe
REM
REM Prerequisites: Node.js ("node" works) and `cd server && npm install` run once.
REM
REM How to play: in each window open Online, join the lobby, then in FfaA use
REM "Host FFA (3-4)", invite FfaB..FfaD, and accept in those windows.
REM
REM Each window writes to its own account folder under user://accounts/ (FfaA..FfaD),
REM so mazes/gold never collide. Windows are 960x540 (--test-windowed) tiled 2x2.

setlocal

if "%GODOT%"=="" set GODOT=C:\Godot_v4.6.2-stable_mono_win64\Godot_v4.6.2-stable_mono_win64.exe

set MODE=editor
if /i "%~1"=="exe" set MODE=exe

if "%MODE%"=="exe" (
  set EXE=build\windows\Corners.exe
  set PATHARG=
  echo  [i] Using the exported build. It must have been exported from feat/ffa-4p to include FFA.
) else (
  set EXE=%GODOT%
  set PATHARG=--path "%CD%"
)

if not exist "%EXE%" (
  echo.
  echo  [!] %EXE% not found.
  if "%MODE%"=="exe" (
    echo      Open Godot and use Project ^> Export to build a Windows binary into build\windows\.
  ) else (
    echo      Set GODOT to your Godot 4.6 mono executable.
  )
  echo.
  pause
  exit /b 1
)

echo Starting relay server on ws://localhost:3000 ...
start "Corners Relay" cmd /k "cd server && node relay.js"

REM Give the relay a beat to bind the port before clients try to connect.
timeout /t 2 /nobreak >nul

echo Launching FfaA ...
start "Corners - FfaA" "%EXE%" %PATHARG% --account FfaA --local --test-windowed --position 0,30

timeout /t 1 /nobreak >nul

echo Launching FfaB ...
start "Corners - FfaB" "%EXE%" %PATHARG% --account FfaB --local --test-windowed --position 960,30

timeout /t 1 /nobreak >nul

echo Launching FfaC ...
start "Corners - FfaC" "%EXE%" %PATHARG% --account FfaC --local --test-windowed --position 0,570

timeout /t 1 /nobreak >nul

echo Launching FfaD ...
start "Corners - FfaD" "%EXE%" %PATHARG% --account FfaD --local --test-windowed --position 960,570

echo.
echo  Five windows opened: relay + FfaA..FfaD tiled 2x2 (%MODE% mode).
echo  Close them all when finished testing.
echo.
endlocal
