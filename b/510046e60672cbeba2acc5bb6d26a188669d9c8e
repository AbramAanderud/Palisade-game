using System.Collections.Generic;
using System.Linq;
using System.Text.Json;

public sealed class FfaRosterEntry { public int Seat; public string Id = ""; public string Name = ""; }

/// res://scripts/FfaParty.cs — client view of a relay FFA party (protocol: server/README.md).
/// Parses party_created / party_joined / party_update / ffa_start; all share one shape.
public sealed class FfaPartyInfo
{
    public const int MinPlayers = 3;

    public string Code = "";
    public int    HostSeat;
    public int    Cap = 4;
    public bool   Started;
    public int    Seat = -1;   // the receiver's own seat; only on created / joined / ffa_start
    public List<FfaRosterEntry> Roster = new();

    public static FfaPartyInfo Parse(string json)
    {
        using var doc = JsonDocument.Parse(json);
        var r = doc.RootElement;
        var p = new FfaPartyInfo
        {
            Code     = r.TryGetProperty("code", out var c) ? c.GetString() ?? "" : "",
            HostSeat = r.TryGetProperty("hostSeat", out var h) ? h.GetInt32() : 0,
            Cap      = r.TryGetProperty("cap", out var cap) ? cap.GetInt32() : 4,
            Started  = r.TryGetProperty("started", out var s) && s.GetBoolean(),
            Seat     = r.TryGetProperty("seat", out var seat) ? seat.GetInt32() : -1,
        };
        if (r.TryGetProperty("roster", out var ro))
            foreach (var e in ro.EnumerateArray())
                p.Roster.Add(new FfaRosterEntry
                {
                    Seat = e.GetProperty("seat").GetInt32(),
                    Id   = e.GetProperty("id").GetString() ?? "",
                    Name = e.GetProperty("name").GetString() ?? "",
                });
        p.Roster.Sort((a, b) => a.Seat.CompareTo(b.Seat));
        return p;
    }

    public string? NameAt(int seat) => Roster.Find(e => e.Seat == seat)?.Name;
    public bool Has(int seat) => Roster.Exists(e => e.Seat == seat);

    /// Host may start when at least MinPlayers are seated and every seated player is ready.
    /// (Readiness implies a valid maze: the READY button is gated on the maze picker.)
    public static bool CanStart(FfaPartyInfo p, ISet<int> readySeats) =>
        p.Roster.Count >= MinPlayers && p.Roster.All(e => readySeats.Contains(e.Seat));
}
