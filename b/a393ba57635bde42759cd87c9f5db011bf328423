using System.Collections.Generic;

/// test/FfaFixtures.cs — deterministic mazes for FFA layout tests and captures.
/// Slab: every cell of `slabFloor` is a Room tile, so the footprint is the full
/// 100×100 m square — the worst case for hallway sizing. Start sits at (4,0)
/// on floor 0 and Exit at (exitCol, 9) on exitFloor, as the editor enforces.
public static class FfaFixtures
{
    public static MazeData Slab(int exitCol, int exitFloor = 0, int slabFloor = 0)
    {
        var m = new MazeData { Name = $"Slab c{exitCol} f{slabFloor}", IsOnline = false };
        m.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 4, Y = 0, Floor = 0, Rotation = 0 });
        m.Pieces.Add(new MazePiece { Type = PieceType.Exit, X = exitCol, Y = 9, Floor = exitFloor, Rotation = 0 });
        for (int y = 0; y < 10; y++)
            for (int x = 0; x < 10; x++)
            {
                if (slabFloor == 0 && x == 4 && y == 0) continue;
                if (slabFloor == exitFloor && x == exitCol && y == 9) continue;
                m.Pieces.Add(new MazePiece { Type = PieceType.Room, X = x, Y = y, Floor = slabFloor, RoomGroup = 1 });
            }
        return m;
    }

    /// Seven stacked corridor floors (−3..3) — a light-heavy stress maze.
    /// Each floor is a full grid of Straight pieces (every wall face has sconces), and floors
    /// are joined by a StairsUp at (0, y) per floor. Walkability is not the point; it
    /// maximises the omni count for the perf capture.
    public static MazeData Tall(int exitCol)
    {
        var m = new MazeData { Name = $"Tall c{exitCol}", IsOnline = false };
        m.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 4, Y = 0, Floor = 0 });
        m.Pieces.Add(new MazePiece { Type = PieceType.Exit, X = exitCol, Y = 9, Floor = 0 });
        for (int f = -3; f <= 3; f++)
            for (int y = 0; y < 10; y++)
                for (int x = 0; x < 10; x++)
                {
                    if (f == 0 && ((x == 4 && y == 0) || (x == exitCol && y == 9))) continue;
                    var type = (x == 0 && y == f + 3 && f < 3) ? PieceType.StairsUp : PieceType.Straight;
                    m.Pieces.Add(new MazePiece { Type = type, X = x, Y = y, Floor = f, Rotation = (x + y) % 2 });
                }
        return m;
    }

    /// A small maze exercising every trap type once, plus a legacy Stairs piece, all
    /// on floor 0. Traps are N|S straight corridors at rotation 0 (TrapPush is
    /// rotation 1 = E|W, so the rotated case is covered too); each sits on its own
    /// cell with nothing adjacent, so this maze is "valid-ish" — every piece builds
    /// standalone geometry, not a certified-solvable path. The two TrapPortal pads
    /// share LinkId 1, pairing them. TrapDoor's landing cell — its own (x, y) one
    /// floor below (see PieceDB.FloorSpan) — is left unclaimed, since nothing else
    /// in this maze occupies floor −1. Start sits at (4, 0) and Exit at (8, 9), as
    /// the editor enforces.
    public static MazeData Traps()
    {
        var m = new MazeData { Name = "Traps", IsOnline = false };
        m.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 4, Y = 0, Floor = 0, Rotation = 0 });
        m.Pieces.Add(new MazePiece { Type = PieceType.Exit,  X = 8, Y = 9, Floor = 0, Rotation = 0 });

        m.Pieces.Add(new MazePiece { Type = PieceType.TrapIce,  X = 1, Y = 2, Floor = 0, Rotation = 0 });
        m.Pieces.Add(new MazePiece { Type = PieceType.TrapTar,  X = 2, Y = 2, Floor = 0, Rotation = 0 });
        m.Pieces.Add(new MazePiece { Type = PieceType.TrapDark, X = 3, Y = 2, Floor = 0, Rotation = 0 });
        m.Pieces.Add(new MazePiece { Type = PieceType.TrapDoor, X = 4, Y = 2, Floor = 0, Rotation = 0 });
        m.Pieces.Add(new MazePiece { Type = PieceType.TrapGate, X = 5, Y = 2, Floor = 0, Rotation = 0 });

        m.Pieces.Add(new MazePiece { Type = PieceType.TrapPush,   X = 1, Y = 5, Floor = 0, Rotation = 1 }); // E|W
        m.Pieces.Add(new MazePiece { Type = PieceType.TrapPortal, X = 2, Y = 5, Floor = 0, Rotation = 0, LinkId = 1 });
        m.Pieces.Add(new MazePiece { Type = PieceType.TrapPortal, X = 3, Y = 5, Floor = 0, Rotation = 0, LinkId = 1 });
        m.Pieces.Add(new MazePiece { Type = PieceType.TrapGrease, X = 4, Y = 5, Floor = 0, Rotation = 0 });
        m.Pieces.Add(new MazePiece { Type = PieceType.Stairs,     X = 5, Y = 5, Floor = 0, Rotation = 0 }); // legacy

        return m;
    }
}
