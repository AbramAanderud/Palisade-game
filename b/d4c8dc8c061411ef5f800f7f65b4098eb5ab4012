using Godot;

/// res://test/TestScope.cs
/// ─────────────────────────────────────────────────────────────────────────────
/// Films the AWP scope from the PLAYER'S OWN first-person camera, which is the
/// only view that can show whether the overlay actually renders. It deliberately
/// creates no camera of its own so the PlayerController's FP camera stays current.
///
/// The scene is a plain lit box with distance markers, so the FOV zoom is
/// obvious: at 25° the far wall should visibly jump closer.
/// ─────────────────────────────────────────────────────────────────────────────
public partial class TestScope : Node3D
{
    PlayerController? _player;
    float _t = 0f;
    float _lastShot = 0f;

    public override void _Ready()
    {
        var env = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0.35f, 0.45f, 0.60f),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(1f, 1f, 1f),
            AmbientLightEnergy = 0.9f,
        };
        AddChild(new WorldEnvironment { Environment = env });

        var sun = new DirectionalLight3D { LightEnergy = 2.0f };
        sun.RotationDegrees = new Vector3(-45f, 30f, 0f);
        AddChild(sun);

        AddBox(new Vector3(0f, -0.5f, -30f), new Vector3(40f, 1f, 80f),
               new Color(0.30f, 0.32f, 0.30f));

        // Pillars every 10 m down the range: with a 90° FOV they read as a
        // receding row, and at 25° the far ones fill the frame.
        for (int i = 1; i <= 6; i++)
        {
            float z = -i * 10f;
            var c = (i % 2 == 0) ? new Color(0.85f, 0.35f, 0.25f)
                                 : new Color(0.90f, 0.85f, 0.55f);
            AddBox(new Vector3(-3f, 1.5f, z), new Vector3(0.6f, 4f, 0.6f), c);
            AddBox(new Vector3( 3f, 1.5f, z), new Vector3(0.6f, 4f, 0.6f), c);
        }
        AddBox(new Vector3(0f, 3f, -70f), new Vector3(24f, 8f, 1f),
               new Color(0.55f, 0.60f, 0.70f));

        _player = PlayerController.Spawn(this, new Vector3(0f, 0.2f, 0f), 0f);
        _player.Frozen = true;                 // no input, no mouse capture
        _player.EquipStarterGun("awp");        // the one gun with a scope
    }

    void AddBox(Vector3 pos, Vector3 size, Color col)
    {
        var body = new StaticBody3D();
        body.AddChild(new CollisionShape3D { Shape = new BoxShape3D { Size = size } });
        var mi = new MeshInstance3D { Mesh = new BoxMesh { Size = size } };
        mi.SetSurfaceOverrideMaterial(0,
            new StandardMaterial3D { AlbedoColor = col, Roughness = 1f, Metallic = 0f });
        body.AddChild(mi);
        AddChild(body);
        body.GlobalPosition = pos;
    }

    public override void _PhysicsProcess(double delta)
    {
        if (_player == null) return;
        _t += (float)delta;
        // First second unscoped for a before/after comparison, then scope in and
        // hold — the transition itself is what "snappy" is judged on.
        // 0-1s hip, 1-2.6s FIRING (muzzle flash + tracer from the barrel),
        // 2.6-4s scoped, then sprinting.
        string beat = _t < 1.0f ? "IDLE" : _t < 2.6f ? "SHOOTING"
                    : _t < 4.0f ? "SCOPED" : "SPRINTING";
        _player.DebugDriveThirdPerson(beat, (float)delta);

        // Bolt-action check: from 4 s on, hold the aim button DOWN for good and
        // fire once a second. A correct Rivals-style AWP must kick out of the
        // scope on each shot even though aim is never released, then re-scope on
        // its own once the 1.2 s fire interval elapses.
        var gun = _player.Gun;
        if (_t > 4.0f && gun != null)
        {
            gun.SetAiming(true);                       // RMB held, never released
            // 1.4 s > the AWP's 1.2 s fire interval, so every pull really fires.
            if (_t - _lastShot > 1.4f) { _lastShot = _t; gun.RequestAttack(); }
        }

        if (Engine.GetPhysicsFrames() % 5 == 0)
        {
            var cam = _player.GetNodeOrNull<Camera3D>("CamMount/PlayerCam");
            GD.Print($"[Scope] t={_t:F2} beat={beat} " +
                     $"aim={(gun != null && gun.IsAiming)} " +
                     $"camFov={(cam != null ? cam.Fov : -1f):F1}");
        }
    }
}
