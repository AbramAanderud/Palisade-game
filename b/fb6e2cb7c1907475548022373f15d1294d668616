using System.Collections.Generic;

public enum RematchMode { Same, Rotate }

/// Pure rematch-vote helper for FFA: tally, decision (host breaks ties), rotation offset rule.
public static class FfaRematch
{
    public const int MinPlayers = 3;

    public static (int same, int rotate) Tally(IReadOnlyCollection<int> remaining, IReadOnlyDictionary<int, RematchMode> votes)
    {
        int same = 0, rotate = 0;
        foreach (int seat in remaining)
            if (votes.TryGetValue(seat, out var m)) { if (m == RematchMode.Same) same++; else rotate++; }
        return (same, rotate);
    }

    /// Majority of the remaining seats' votes; tie -> host's vote. Null if incomplete or too few players.
    public static RematchMode? Decide(IReadOnlyCollection<int> remaining, IReadOnlyDictionary<int, RematchMode> votes, int hostSeat)
    {
        if (remaining.Count < MinPlayers) return null;
        foreach (int seat in remaining) if (!votes.ContainsKey(seat)) return null;
        var (same, rotate) = Tally(remaining, votes);
        if (same > rotate) return RematchMode.Same;
        if (rotate > same) return RematchMode.Rotate;
        return votes.TryGetValue(hostSeat, out var h) ? h : null;
    }

    /// n = remaining seat count; result is always in 1..n-1.
    public static int NextOffset(int offset, int n, RematchMode mode)
    {
        int o;
        if (mode == RematchMode.Same) { o = offset % n; if (o == 0) o = 1; }
        else { o = offset % n + 1; if (o >= n) o = 1; }
        return o;
    }
}
