using Godot;

/// Reusable programmatic settings panel.
/// Add to any scene; call Show() / Hide() to control visibility.
/// Fires Closed when the user clicks Close.
public partial class SettingsPanel : Control
{
    [Signal] public delegate void ClosedEventHandler();

    FontFile?    _font;
    Label?       _accountNameLabel;
    CanvasLayer? _subDialog;          // overlay for Change Name / Switch User / Sign Out

    public override void _Ready()
    {
        _font = GD.Load<FontFile>("res://assets/fonts/Agmena Pro Book.ttf");

        SetAnchorsPreset(LayoutPreset.FullRect);
        Visible = false;

        // Dim backdrop
        var bg = new ColorRect { Color = new Color(0f, 0f, 0f, 0.75f) };
        bg.SetAnchorsPreset(LayoutPreset.FullRect);
        bg.MouseFilter = MouseFilterEnum.Stop; // block clicks behind panel
        AddChild(bg);

        // CenterContainer fills the whole panel and centers the card reliably
        // regardless of whether the parent is a Control or a CanvasLayer.
        var center = new CenterContainer();
        center.SetAnchorsPreset(LayoutPreset.FullRect);
        AddChild(center);

        var card = new PanelContainer();
        card.CustomMinimumSize = new Vector2(480, 0);
        center.AddChild(card);

        var vbox = new VBoxContainer();
        vbox.AddThemeConstantOverride("separation", 14);
        var margin = new MarginContainer();
        margin.AddThemeConstantOverride("margin_left",   28);
        margin.AddThemeConstantOverride("margin_right",  28);
        margin.AddThemeConstantOverride("margin_top",    24);
        margin.AddThemeConstantOverride("margin_bottom", 24);
        margin.AddChild(vbox);
        card.AddChild(margin);

        // Title
        var title = new Label { Text = "SETTINGS", HorizontalAlignment = HorizontalAlignment.Center };
        if (_font != null) title.AddThemeFontOverride("font", _font);
        title.AddThemeFontSizeOverride("font_size", 28);
        vbox.AddChild(title);

        vbox.AddChild(new HSeparator());

        // ── Account section ───────────────────────────────────────────────────
        var accountHeader = new Label { Text = "ACCOUNT" };
        if (_font != null) accountHeader.AddThemeFontOverride("font", _font);
        accountHeader.AddThemeFontSizeOverride("font_size", 14);
        accountHeader.AddThemeColorOverride("font_color", new Color(0.55f, 0.55f, 0.55f));
        vbox.AddChild(accountHeader);

        _accountNameLabel = new Label
        {
            Text                = $"Signed in as: {OnlineGameState.PlayerName}",
            HorizontalAlignment = HorizontalAlignment.Left,
        };
        if (_font != null) _accountNameLabel.AddThemeFontOverride("font", _font);
        _accountNameLabel.AddThemeFontSizeOverride("font_size", 18);
        _accountNameLabel.AddThemeColorOverride("font_color", Colors.White);
        vbox.AddChild(_accountNameLabel);

        var accountBtnRow = new HBoxContainer();
        accountBtnRow.AddThemeConstantOverride("separation", 8);
        accountBtnRow.SizeFlagsHorizontal = SizeFlags.ExpandFill;
        vbox.AddChild(accountBtnRow);

        accountBtnRow.AddChild(MakeFlatBtn("Change Name", _font, 14, ShowChangeNameDialog));
        accountBtnRow.AddChild(MakeFlatBtn("Switch User", _font, 14, ShowSwitchUserDialog));
        accountBtnRow.AddChild(MakeFlatBtn("Sign Out",    _font, 14, ShowSignOutConfirm));

        vbox.AddChild(new HSeparator());

        // ── Display ────────────────────────────────────────────────────────────
        var displayHeader = new Label { Text = "DISPLAY" };
        if (_font != null) displayHeader.AddThemeFontOverride("font", _font);
        displayHeader.AddThemeFontSizeOverride("font_size", 14);
        displayHeader.AddThemeColorOverride("font_color", new Color(0.55f, 0.55f, 0.55f));
        vbox.AddChild(displayHeader);

        // ── Fullscreen ────────────────────────────────────────────────────────
        vbox.AddChild(MakeToggleRow("Fullscreen",
            GameSettings.Instance?.Fullscreen ?? true,
            v => GameSettings.Instance?.SetFullscreen(v), _font));

        // ── PSX Retro Effect ──────────────────────────────────────────────────
        vbox.AddChild(MakeToggleRow("PSX Retro Effect",
            GameSettings.Instance?.PSXEffect ?? true,
            v => GameSettings.Instance?.SetPSXEffect(v), _font));

        // ── VSync ─────────────────────────────────────────────────────────────
        vbox.AddChild(MakeToggleRow("VSync",
            GameSettings.Instance?.VSync ?? true,
            v => GameSettings.Instance?.SetVSync(v), _font));

        // ── FOV ───────────────────────────────────────────────────────────────
        vbox.AddChild(MakeFovRow());

        vbox.AddChild(new HSeparator());

        // ── Reticle ───────────────────────────────────────────────────────────
        var reticleHeader = new Label { Text = "RETICLE" };
        if (_font != null) reticleHeader.AddThemeFontOverride("font", _font);
        reticleHeader.AddThemeFontSizeOverride("font_size", 14);
        reticleHeader.AddThemeColorOverride("font_color", new Color(0.55f, 0.55f, 0.55f));
        vbox.AddChild(reticleHeader);

        // Live preview sits directly under the header so every change is visible
        // without closing the panel.
        var preview = new ReticlePreview { CustomMinimumSize = new Vector2(0, 90) };
        vbox.AddChild(preview);

        vbox.AddChild(MakeSliderRow("Size", 2f, 24f, 1f,
            GameSettings.Instance?.ReticleSize ?? 9f,
            v => { GameSettings.Instance?.SetReticleSize(v); preview.QueueRedraw(); }));

        vbox.AddChild(MakeSliderRow("Gap", 0f, 30f, 1f,
            GameSettings.Instance?.ReticleGap ?? 5f,
            v => { GameSettings.Instance?.SetReticleGap(v); preview.QueueRedraw(); }));

        vbox.AddChild(MakeSliderRow("Thickness", 1f, 6f, 1f,
            GameSettings.Instance?.ReticleThick ?? 2f,
            v => { GameSettings.Instance?.SetReticleThick(v); preview.QueueRedraw(); }));

        vbox.AddChild(MakeToggleRow("Center Dot",
            GameSettings.Instance?.ReticleCenterDot ?? true,
            v => { GameSettings.Instance?.SetReticleCenterDot(v); preview.QueueRedraw(); }, _font));

        vbox.AddChild(MakeReticleColorRow(preview));

        vbox.AddChild(new HSeparator());

        // ── Close ─────────────────────────────────────────────────────────────
        var close = new Button
        {
            Text = "Close",
            CustomMinimumSize = new Vector2(0, 44),
        };
        if (_font != null) close.AddThemeFontOverride("font", _font);
        close.AddThemeFontSizeOverride("font_size", 18);
        close.Pressed += () => { Hide(); EmitSignal(SignalName.Closed); };
        vbox.AddChild(close);
    }

    // ── Account sub-dialogs ───────────────────────────────────────────────────

    void ShowChangeNameDialog()
    {
        OpenSubDialog(layer =>
        {
            var vbox = MakeDialogVBox(layer, width: 420, height: 240);

            var prompt = MakeDialogLabel("Change account name", 24);
            vbox.AddChild(prompt);

            var sub = MakeDialogLabel($"Renames \"{OnlineGameState.PlayerName}\" — your mazes and fame come with you.", 13);
            sub.AddThemeColorOverride("font_color", new Color(0.6f, 0.6f, 0.6f));
            vbox.AddChild(sub);

            var edit = new LineEdit
            {
                Text              = OnlineGameState.PlayerName,
                MaxLength         = 24,
                CustomMinimumSize = new Vector2(360, 44),
                SizeFlagsHorizontal = SizeFlags.ShrinkCenter,
            };
            if (_font != null) edit.AddThemeFontOverride("font", _font);
            edit.AddThemeFontSizeOverride("font_size", 18);
            vbox.AddChild(edit);

            var btnRow = MakeDialogBtnRow();
            vbox.AddChild(btnRow);

            var cancelBtn = MakeFlatBtn("Cancel", _font, 16, CloseSubDialog);
            btnRow.AddChild(cancelBtn);

            var okBtn = MakeFlatBtn("Save", _font, 16, () =>
            {
                string clean = SanitizeName(edit.Text);
                if (clean == OnlineGameState.PlayerName) { CloseSubDialog(); return; }
                bool ok = AccountManager.RenameActiveAccount(clean);
                if (!ok)
                {
                    sub.Text = "Name already in use. Pick another.";
                    sub.AddThemeColorOverride("font_color", new Color(1f, 0.5f, 0.5f));
                    return;
                }
                ReloadTitleScreen();
            });
            okBtn.AddThemeColorOverride("font_color", new Color(0.4f, 1f, 0.6f));
            btnRow.AddChild(okBtn);

            edit.GrabFocus();
            edit.TextSubmitted += _ => okBtn.EmitSignal(Button.SignalName.Pressed);
        });
    }

    void ShowSwitchUserDialog()
    {
        OpenSubDialog(layer =>
        {
            var vbox = MakeDialogVBox(layer, width: 460, height: 480);

            vbox.AddChild(MakeDialogLabel("Switch user", 24));
            var sub = MakeDialogLabel("Pick an existing account or create a new one.", 13);
            sub.AddThemeColorOverride("font_color", new Color(0.6f, 0.6f, 0.6f));
            vbox.AddChild(sub);

            var listVbox = new VBoxContainer();
            listVbox.AddThemeConstantOverride("separation", 6);
            listVbox.SizeFlagsHorizontal = SizeFlags.ExpandFill;
            listVbox.SizeFlagsVertical   = SizeFlags.ExpandFill;
            var scroll = new ScrollContainer { SizeFlagsVertical = SizeFlags.ExpandFill };
            scroll.AddChild(listVbox);
            vbox.AddChild(scroll);

            var accounts = AccountManager.ListAccounts();
            foreach (var name in accounts)
            {
                bool isActive = name == AccountManager.ActiveAccount;
                string label  = isActive ? $"● {name}  (current)" : $"○ {name}";
                var btn = MakeFlatBtn(label, _font, 16, () =>
                {
                    if (isActive) { CloseSubDialog(); return; }
                    AccountManager.SwitchOrCreate(name);
                    PlayerProfile.Load();
                    ReloadTitleScreen();
                });
                btn.AddThemeColorOverride("font_color",
                    isActive ? new Color(0.4f, 1f, 0.6f) : Colors.White);
                btn.SizeFlagsHorizontal = SizeFlags.ExpandFill;
                listVbox.AddChild(btn);
            }

            vbox.AddChild(new HSeparator());

            var newRow = new HBoxContainer();
            newRow.AddThemeConstantOverride("separation", 8);
            vbox.AddChild(newRow);

            var newEdit = new LineEdit
            {
                PlaceholderText     = "New account name",
                MaxLength           = 24,
                SizeFlagsHorizontal = SizeFlags.ExpandFill,
                CustomMinimumSize   = new Vector2(0, 42),
            };
            if (_font != null) newEdit.AddThemeFontOverride("font", _font);
            newEdit.AddThemeFontSizeOverride("font_size", 16);
            newRow.AddChild(newEdit);

            var createBtn = MakeFlatBtn("Create", _font, 14, () =>
            {
                string clean = SanitizeName(newEdit.Text);
                if (string.IsNullOrEmpty(clean)) return;
                AccountManager.SwitchOrCreate(clean);
                OnlineGameState.PlayerName = clean;
                OnlineGameState.Gold       = AccountManager.StarterRank;
                PlayerProfile.Save();
                ReloadTitleScreen();
            });
            createBtn.AddThemeColorOverride("font_color", new Color(0.4f, 1f, 0.6f));
            newRow.AddChild(createBtn);

            var btnRow = MakeDialogBtnRow();
            vbox.AddChild(btnRow);
            btnRow.AddChild(MakeFlatBtn("Cancel", _font, 16, CloseSubDialog));
        });
    }

    void ShowSignOutConfirm()
    {
        OpenSubDialog(layer =>
        {
            var vbox = MakeDialogVBox(layer, width: 400, height: 220);

            vbox.AddChild(MakeDialogLabel("Sign out?", 26));
            var sub = MakeDialogLabel("Your account stays saved — sign back in any time.", 14);
            sub.AddThemeColorOverride("font_color", new Color(0.65f, 0.65f, 0.65f));
            vbox.AddChild(sub);

            var btnRow = MakeDialogBtnRow();
            vbox.AddChild(btnRow);

            btnRow.AddChild(MakeFlatBtn("Cancel", _font, 16, CloseSubDialog));

            var confirmBtn = MakeFlatBtn("Sign Out", _font, 16, () =>
            {
                AccountManager.SignOut();
                ReloadTitleScreen();
            });
            confirmBtn.AddThemeColorOverride("font_color", new Color(1f, 0.5f, 0.5f));
            btnRow.AddChild(confirmBtn);
        });
    }

    // ── Sub-dialog plumbing ──────────────────────────────────────────────────

    void OpenSubDialog(System.Action<CanvasLayer> build)
    {
        CloseSubDialog();
        _subDialog = new CanvasLayer { Layer = 110 };
        AddChild(_subDialog);

        var bg = new ColorRect
        {
            Color       = new Color(0f, 0f, 0f, 0.78f),
            MouseFilter = MouseFilterEnum.Stop,
        };
        bg.SetAnchorsPreset(LayoutPreset.FullRect);
        _subDialog.AddChild(bg);

        build(_subDialog);
    }

    void CloseSubDialog()
    {
        if (_subDialog == null) return;
        _subDialog.QueueFree();
        _subDialog = null;
    }

    VBoxContainer MakeDialogVBox(CanvasLayer layer, float width, float height)
    {
        var panel = new PanelContainer();
        panel.AnchorLeft   = 0.5f; panel.AnchorRight  = 0.5f;
        panel.AnchorTop    = 0.5f; panel.AnchorBottom = 0.5f;
        panel.GrowHorizontal = GrowDirection.Both;
        panel.GrowVertical   = GrowDirection.Both;
        panel.OffsetLeft   = -width / 2;  panel.OffsetRight  = width / 2;
        panel.OffsetTop    = -height / 2; panel.OffsetBottom = height / 2;
        layer.AddChild(panel);

        var margin = new MarginContainer();
        margin.AddThemeConstantOverride("margin_left",   24);
        margin.AddThemeConstantOverride("margin_right",  24);
        margin.AddThemeConstantOverride("margin_top",    24);
        margin.AddThemeConstantOverride("margin_bottom", 24);
        panel.AddChild(margin);

        var vbox = new VBoxContainer();
        vbox.AddThemeConstantOverride("separation", 14);
        margin.AddChild(vbox);
        return vbox;
    }

    Label MakeDialogLabel(string text, int size)
    {
        var lbl = new Label
        {
            Text                = text,
            HorizontalAlignment = HorizontalAlignment.Center,
            AutowrapMode        = TextServer.AutowrapMode.Word,
        };
        if (_font != null) lbl.AddThemeFontOverride("font", _font);
        lbl.AddThemeFontSizeOverride("font_size", size);
        lbl.AddThemeColorOverride("font_color", Colors.White);
        return lbl;
    }

    HBoxContainer MakeDialogBtnRow()
    {
        var row = new HBoxContainer { Alignment = BoxContainer.AlignmentMode.Center };
        row.AddThemeConstantOverride("separation", 16);
        return row;
    }

    static string SanitizeName(string raw)
    {
        string s = (raw ?? "").Trim();
        var sb = new System.Text.StringBuilder();
        foreach (char c in s)
        {
            if (c < 32 || c == 127) continue;
            if (c == '/' || c == '\\' || c == ':' || c == '*' || c == '?' ||
                c == '"' || c == '<' || c == '>' || c == '|') continue;
            sb.Append(c);
            if (sb.Length >= 24) break;
        }
        return sb.ToString().Trim();
    }

    void ReloadTitleScreen()
    {
        CloseSubDialog();
        Hide();
        EmitSignal(SignalName.Closed);
        GetTree().ChangeSceneToFile("res://scenes/TitleScreen.tscn");
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    static HBoxContainer MakeToggleRow(string label, bool initial, System.Action<bool>? onChange, FontFile? font = null)
    {
        var row = new HBoxContainer();

        var lbl = new Label { Text = label, SizeFlagsHorizontal = SizeFlags.ExpandFill };
        if (font != null) lbl.AddThemeFontOverride("font", font);
        lbl.AddThemeFontSizeOverride("font_size", 18);
        row.AddChild(lbl);

        var btn = new CheckButton { ButtonPressed = initial };
        btn.Toggled += on => onChange?.Invoke(on);
        row.AddChild(btn);

        return row;
    }

    Control MakeFovRow()
    {
        var col = new VBoxContainer();
        col.AddThemeConstantOverride("separation", 4);

        float curFov = GameSettings.Instance?.FOV ?? 90f;

        var headerRow = new HBoxContainer();
        var lbl = new Label { Text = "Field of View", SizeFlagsHorizontal = SizeFlags.ExpandFill };
        if (_font != null) lbl.AddThemeFontOverride("font", _font);
        lbl.AddThemeFontSizeOverride("font_size", 18);
        headerRow.AddChild(lbl);

        var valLabel = new Label { Text = $"{(int)curFov}" };
        if (_font != null) valLabel.AddThemeFontOverride("font", _font);
        valLabel.AddThemeFontSizeOverride("font_size", 18);
        headerRow.AddChild(valLabel);

        col.AddChild(headerRow);

        var slider = new HSlider
        {
            MinValue = 60,
            MaxValue = 120,
            Step     = 1,
            Value    = curFov,
            SizeFlagsHorizontal = SizeFlags.ExpandFill,
        };
        slider.ValueChanged += v =>
        {
            valLabel.Text = $"{(int)v}";
            GameSettings.Instance?.SetFOV((float)v);
        };
        col.AddChild(slider);

        return col;
    }

    /// Generic labelled slider with a live numeric readout — used by all three
    /// reticle dimensions.
    Control MakeSliderRow(string label, float min, float max, float step,
                          float initial, System.Action<float> onChange)
    {
        var col = new VBoxContainer();
        col.AddThemeConstantOverride("separation", 4);

        var headerRow = new HBoxContainer();
        var lbl = new Label { Text = label, SizeFlagsHorizontal = SizeFlags.ExpandFill };
        if (_font != null) lbl.AddThemeFontOverride("font", _font);
        lbl.AddThemeFontSizeOverride("font_size", 18);
        headerRow.AddChild(lbl);

        var valLabel = new Label { Text = $"{initial:0.#}" };
        if (_font != null) valLabel.AddThemeFontOverride("font", _font);
        valLabel.AddThemeFontSizeOverride("font_size", 18);
        headerRow.AddChild(valLabel);
        col.AddChild(headerRow);

        var slider = new HSlider
        {
            MinValue = min, MaxValue = max, Step = step, Value = initial,
            SizeFlagsHorizontal = SizeFlags.ExpandFill,
        };
        slider.ValueChanged += v =>
        {
            valLabel.Text = $"{v:0.#}";
            onChange((float)v);
        };
        col.AddChild(slider);
        return col;
    }

    /// Colour swatches. A fixed palette rather than a full picker: these are the
    /// colours that actually stay readable against dark stone and torchlight.
    Control MakeReticleColorRow(ReticlePreview preview)
    {
        var col = new VBoxContainer();
        col.AddThemeConstantOverride("separation", 4);

        var lbl = new Label { Text = "Color" };
        if (_font != null) lbl.AddThemeFontOverride("font", _font);
        lbl.AddThemeFontSizeOverride("font_size", 18);
        col.AddChild(lbl);

        var row = new HBoxContainer();
        row.AddThemeConstantOverride("separation", 8);

        (string name, Color c)[] swatches =
        {
            ("White",  new Color(1f,    1f,    1f,    0.75f)),
            ("Green",  new Color(0.30f, 1f,    0.40f, 0.85f)),
            ("Cyan",   new Color(0.30f, 0.95f, 1f,    0.85f)),
            ("Yellow", new Color(1f,    0.90f, 0.25f, 0.85f)),
            ("Red",    new Color(1f,    0.30f, 0.25f, 0.85f)),
            ("Pink",   new Color(1f,    0.40f, 0.85f, 0.85f)),
        };

        foreach (var (name, c) in swatches)
        {
            var sw = new ColorRect
            {
                Color             = c,
                CustomMinimumSize = new Vector2(0, 34),
                SizeFlagsHorizontal = SizeFlags.ExpandFill,
                TooltipText       = name,
                MouseFilter       = MouseFilterEnum.Stop,
            };
            var captured = c;
            sw.GuiInput += ev =>
            {
                if (ev is InputEventMouseButton mb && mb.Pressed
                 && mb.ButtonIndex == MouseButton.Left)
                {
                    GameSettings.Instance?.SetReticleColor(captured);
                    preview.QueueRedraw();
                }
            };
            row.AddChild(sw);
        }

        col.AddChild(row);
        return col;
    }

    static Button MakeFlatBtn(string label, FontFile? font, int size, System.Action onClick)
    {
        var btn = new Button
        {
            Text              = label,
            CustomMinimumSize = new Vector2(0, 36),
            SizeFlagsHorizontal = SizeFlags.ExpandFill,
            FocusMode         = FocusModeEnum.All,
            MouseFilter       = MouseFilterEnum.Stop,
        };
        if (font != null) btn.AddThemeFontOverride("font", font);
        btn.AddThemeFontSizeOverride("font_size", size);
        btn.AddThemeColorOverride("font_color",       Colors.White);
        btn.AddThemeColorOverride("font_hover_color", new Color(0.6f, 0.85f, 1f));
        btn.Pressed += onClick;
        return btn;
    }
}

/// Live reticle preview for the settings panel. Draws the crosshair exactly as
/// SpreadCrosshair does, but at a fixed nominal spread so the shape being edited
/// is stable while the sliders move.
public partial class ReticlePreview : Control
{
    public override void _Draw()
    {
        // Dark backing so light reticles are visible against the panel.
        DrawRect(new Rect2(Vector2.Zero, Size), new Color(0.06f, 0.06f, 0.07f, 1f));

        var s = GameSettings.Instance;
        float len   = s?.ReticleSize  ?? 9f;
        float thick = s?.ReticleThick ?? 2f;
        var   col   = s?.ReticleColor ?? new Color(1f, 1f, 1f, 0.75f);
        bool  dot   = s?.ReticleCenterDot ?? true;

        // Base gap plus the spread a grounded, standing player actually has, so
        // the preview matches what you see in game while holding still.
        float gap = (s?.ReticleGap ?? 5f) + 0.6f * 14f;

        var c = Size / 2f;
        DrawLine(c + new Vector2(-gap - len, 0), c + new Vector2(-gap, 0), col, thick);
        DrawLine(c + new Vector2( gap,       0), c + new Vector2( gap + len, 0), col, thick);
        DrawLine(c + new Vector2(0, -gap - len), c + new Vector2(0, -gap), col, thick);
        DrawLine(c + new Vector2(0,  gap),       c + new Vector2(0,  gap + len), col, thick);
        if (dot) DrawCircle(c, Mathf.Max(thick * 0.75f, 1f), col);
    }
}
