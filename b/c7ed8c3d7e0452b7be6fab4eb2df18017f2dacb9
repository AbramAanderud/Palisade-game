public enum FireMode { Hitscan, Pellets, Projectile, Melee }
public enum GunSlot { Primary, Secondary, Melee }
public const string KnifeId = "knife";
public bool IsMelee => _def.Mode == FireMode.Melee;
public bool IsEmpty => !IsMelee && _ammo <= 0;
public float AmmoFraction => MagSize > 0 ? _ammo / (float)MagSize : 1f;
// Tick: reload only when !IsMelee; dry-fire branch only when !IsMelee; Empty phase only when !IsMelee
// SwitchTo: auto-reload on arrival only when !IsMelee
// Fire: _ammo-- only when !IsMelee; after OnFired: if (IsMelee) { Stab(origin, dir); return; }

static bool IsBehind(Node3D target, Vector3 from)
{
    var fwd = target is PlayerController pc ? pc.ForwardVector : -target.GlobalTransform.Basis.Z;
    var to  = from - target.GlobalPosition;
    fwd.Y = 0f; to.Y = 0f;
    if (fwd.LengthSquared() < 1e-6f || to.LengthSquared() < 1e-6f) return false;
    return fwd.Normalized().Dot(to.Normalized()) <= -0.5f;   // within ±60° of straight behind
}
```

