### Task 3: Air dash (PlayerController) + TestKnifeDash

**Files:** Modify `scripts/PlayerController.cs`; Create `test/TestKnifeDash.cs/.tscn`.

**Produces:** `PlayerController.DashReady`, `IsDashing`, `RequestDash()`.

```csharp
bool    _dashCharge = true, _dashRequested;
float   _dashLeft, _dashSpeed, _dashExitCap, _dashFovKick;
Vector3 _dashDir;
const float DashFovKick = 6f;
public bool DashReady => _dashCharge && KnifeOut;
public bool IsDashing => _dashLeft > 0f;
public void RequestDash() => _dashRequested = true;

// hook A (after _airBoostTimer bookkeeping): if (onFloor || _wallRunning) _dashCharge = true;
// hook B (right after WallRunTick/SlideTick/NormalTick dispatch): TickDash(ref vel, dt, onFloor);

void TickDash(ref Vector3 vel, float dt, bool onFloor)
{
    bool pressed = _dashRequested || (!IsRemotePuppet && Input.IsActionJustPressed("knife_dash"));
    _dashRequested = false;
    if (pressed && _dashLeft <= 0f && KnifeOut && _dashCharge
        && !onFloor && !_wallRunning && !_sliding)
    {
        _dashCharge  = false;
        _dashDir     = new Vector3(-Mathf.Sin(_yaw) * Mathf.Cos(_pitch), Mathf.Sin(_pitch),
                                   -Mathf.Cos(_yaw) * Mathf.Cos(_pitch)).Normalized();
        _dashLeft    = _combat.Def.DashDur;
        _dashSpeed   = _combat.Def.DashSpeed;
        _dashExitCap = _combat.Def.DashExitCap;
        _dashFovKick = 1f;
        GunFx.PlayOneShot3D(this, "res://assets/audio/sfx/combat/ThirdSwordSwing.wav",
                            GlobalPosition, maxDist: 30f, pitch: 1.35f);
    }
    if (_dashLeft <= 0f) return;
    if (onFloor || _wallRunning) { EndDash(ref vel); return; }
    vel = _dashDir * _dashSpeed;
    _dashLeft -= dt;
    if (_dashLeft <= 0f) EndDash(ref vel);
}

void EndDash(ref Vector3 vel)
{
    _dashLeft = 0f;
    var h = new Vector3(vel.X, 0f, vel.Z);
    if (h.Length() > _dashExitCap) { h = h.Normalized() * _dashExitCap; vel.X = h.X; vel.Z = h.Z; }
    vel.Y = Mathf.Min(vel.Y, JumpSpeed);
}
// FOV: after targetFov is computed: targetFov += DashFovKick * _dashFovKick;
//      _dashFovKick = Mathf.MoveToward(_dashFovKick, 0f, 4f * dt);
```

