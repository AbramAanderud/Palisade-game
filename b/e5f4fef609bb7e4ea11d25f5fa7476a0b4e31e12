using System;
using Godot;

/// res://scripts/PlayerHealth.cs
/// Tracks player HP and delivers TakeDamage / Die.
/// Stub: prints to console now; RPC-ready for multiplayer phase.
public partial class PlayerHealth : Node
{
    public const float MaxHealth = 100f;

    float _hp   = MaxHealth;
    bool  _dead = false;

    /// While true, TakeDamage is a no-op: the player can be shot at and takes
    /// nothing. OnlineDungeonArena raises this on BOTH players for the whole
    /// pre-claim phase, enforcing CLAUDE.md's pillar that combat unlocks with
    /// the centre weapon.
    ///
    /// Gating here rather than at the network send is deliberate — this is the
    /// single choke point every damage source already passes through (GunCombat
    /// locally, the "hit" relay remotely). The shooter's own copy of the puppet
    /// therefore refuses damage too, so no HP bar moves and no DamageDealt
    /// relay fires: the two clients cannot disagree about whether a shot landed.
    public bool Invulnerable = false;

    public float CurrentHealth => _hp;

    /// Additive, default off (1v1 unchanged). While true, TakeDamage floors HP
    /// at 1 and never dies: FFA puppets are display copies whose deaths come
    /// only from the victim's own "die" message. DamageDealt still fires (the
    /// hit relay depends on it).
    public bool CannotDie { get; set; }

    /// Sets HP directly, clamped to [1 if CannotDie else 0, MaxHealth], without
    /// firing any event. The FFA arena mirrors the victim's reported HP with it.
    public void SetHealth(float v) => _hp = Mathf.Clamp(v, CannotDie ? 1f : 0f, MaxHealth);

    /// Fired when damage is dealt — used by OnlineDungeonArena to relay damage to the peer.
    public event Action<float>? DamageDealt;

    /// Fired once when HP reaches zero.
    public event Action? OnDied;

    public void TakeDamage(float amount, Vector3 hitWorldPos)
    {
        if (_dead || Invulnerable) return;
        _hp = Mathf.Max(_hp - amount, CannotDie ? 1f : 0f);
        GD.Print($"[Health] {GetParent().Name}: {_hp:F0}/{MaxHealth} HP  (-{amount:F0})");
        DamageDealt?.Invoke(amount);
        if (_hp <= 0f && !CannotDie) Die();
    }

    public void Die()
    {
        if (_dead || Invulnerable || CannotDie) return;
        _dead = true;
        GD.Print($"[Health] {GetParent().Name} died!");
        OnDied?.Invoke();
    }

    public void Heal(float amount)
    {
        _hp = Mathf.Min(_hp + amount, MaxHealth);
    }
}
