using System.Collections.Generic;

/// res://scripts/MazeData.cs — Serializable maze data model.

public class MazePiece
{
    public PieceType Type     { get; set; }
    public int       X        { get; set; }
    public int       Y        { get; set; }
    public int       Floor    { get; set; }
    public int       Rotation { get; set; }  // 0-3 (clockwise quarter turns)

    /// Pairs two Teleport Pads. Both ends of a pair share the same non-zero id.
    /// 0 means unpaired — an unpaired pad is inert.
    /// Old saves deserialize this as 0, which is the correct default.
    public int LinkId { get; set; } = 0;

    /// Groups the Room tiles produced by ONE drag in the editor, so a
    /// corner-to-corner floor behaves as a single piece: deleting any tile
    /// deletes the whole slab, and picking one up picks up the whole slab.
    /// Every tile from a single PaintRoomRect call shares one non-zero id.
    ///
    /// 0 means ungrouped — a standalone tile that deletes on its own. Old saves
    /// deserialize as 0, so pre-existing rooms keep the old per-tile behaviour
    /// rather than silently becoming undeletable-in-part. Same
    /// backward-compatibility pattern as LinkId above.
    public int RoomGroup { get; set; } = 0;
}

public class MazeData
{
    public string          Name      { get; set; } = "Untitled";
    public int             GoldSpent { get; set; } = 0;
    public List<MazePiece> Pieces    { get; set; } = new();
    /// True when saved from MazeEditor3D (the canonical editor).
    /// Defaults to true so the maze appears in the Play Game lobby's dropdown.
    public bool            IsOnline    { get; set; } = true;

    /// True when MazeValidator.IsGameReady(this) succeeds at save time.
    /// Only game-ready mazes appear in the Play Game lobby's maze selector.
    public bool            IsGameReady { get; set; } = false;

    // ── Per-maze analytics, updated on every online match's sword pickup ─────
    /// Total matches this maze has been in.
    public int    MatchesPlayed   { get; set; } = 0;
    /// Matches where this maze trapped its opponent (they didn't escape in time).
    public int    TrapSuccesses   { get; set; } = 0;
    /// Matches where the opponent escaped this maze.
    public int    EscapeCount     { get; set; } = 0;
    /// Sum of escape times in seconds across all escapes (divide by EscapeCount for average).
    public double EscapeTimesSum  { get; set; } = 0.0;

    // ── Teleporter normalisation ──────────────────────────────────────────────
    /// Brings a loaded maze in line with the teleporter rules: at most
    /// MaxChannels pairs, exactly PadsPerPair pads per channel, channels
    /// numbered from 1.
    ///
    /// This exists because saved maps predate the rules. Two real maps were
    /// found carrying pads with LinkId 0 — legacy data from before channels
    /// existed. LinkId 0 means UNPAIRED, and an unpaired pad is inert, so those
    /// teleporters silently did nothing at runtime. The editor made it worse by
    /// rendering LinkId &lt;= 0 as channel 1, so it showed a working pair that the
    /// game did not agree existed.
    ///
    /// Deterministic: pads are ordered by (Floor, Y, X) and dealt into channel 1
    /// then channel 2, so the same input always produces the same output and
    /// host and client cannot disagree about a maze sent over the wire.
    ///
    /// Overflow pads (beyond MaxChannels * PadsPerPair) are set INERT rather
    /// than deleted — silently destroying a player's pieces is worse than
    /// leaving one visibly unlinked for them to move.
    ///
    /// Returns the number of pads whose LinkId changed, so callers can log a
    /// migration rather than performing one invisibly.
    public const int TeleportMaxChannels = 2;
    public const int TeleportPadsPerPair = 2;

    public int NormalizeTeleporters()
    {
        var pads = Pieces.FindAll(p => p.Type == PieceType.TrapPortal);
        if (pads.Count == 0) return 0;

        // Deterministic order everywhere below, so the same maze always yields
        // the same result — host and client must not disagree about a maze sent
        // over the wire.
        pads.Sort((a, b) =>
        {
            int c = a.Floor.CompareTo(b.Floor); if (c != 0) return c;
            c = a.Y.CompareTo(b.Y);             if (c != 0) return c;
            return a.X.CompareTo(b.X);
        });

        // PRESERVE what is already legal. An earlier draft of this dealt every
        // pad out by position, which quietly re-wired deliberate pairings — a
        // player who linked the pad at (1,1) to the one at (9,9) would find it
        // paired to its nearest neighbour instead. Existing valid channels are
        // claimed first; only the broken remainder is redistributed.
        var keep = new System.Collections.Generic.List<MazePiece>[TeleportMaxChannels + 1];
        var pool = new System.Collections.Generic.List<MazePiece>();
        for (int c = 1; c <= TeleportMaxChannels; c++)
            keep[c] = new System.Collections.Generic.List<MazePiece>();

        foreach (var pad in pads)
        {
            int c = pad.LinkId;
            if (c >= 1 && c <= TeleportMaxChannels && keep[c].Count < TeleportPadsPerPair)
                keep[c].Add(pad);      // already on a legal channel with room
            else
                pool.Add(pad);         // unpaired (0), out of range, or overflow
        }

        // Top each channel up from the pool, lowest channel first.
        int changed = 0, next = 0;
        for (int c = 1; c <= TeleportMaxChannels; c++)
            while (keep[c].Count < TeleportPadsPerPair && next < pool.Count)
            {
                var pad = pool[next++];
                if (pad.LinkId != c) { pad.LinkId = c; changed++; }
                keep[c].Add(pad);
            }

        // Anything still left over is INERT rather than deleted — silently
        // destroying a player's pieces is worse than leaving one visibly
        // unlinked for them to move.
        for (; next < pool.Count; next++)
            if (pool[next].LinkId != 0) { pool[next].LinkId = 0; changed++; }

        return changed;
    }
}
