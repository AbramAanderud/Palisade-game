```csharp
using System;
using System.Collections.Generic;
using System.Linq;
using Godot;

/// res://scripts/MazeFootprint.cs — which grid columns a maze occupies and the
/// vertical span of each, in floors RELATIVE TO THE EXIT FLOOR. The arena floor
/// is relative floor 0, because every maze is shifted so its Exit meets it.
///
/// Spans include PieceDB.FloorSpan (pit = 3 floors, trapdoor = self + below),
/// StairsDown's geometry one floor below its anchor (DungeonBuilder builds it from
/// yBase − FloorHeight), and Stairs/StairsUp rising into the floor above.
///
/// Margin: how far built geometry can stick out past a column's box (wall
/// thickness, props, collision slabs). MEASURED by test/TestMazeFootprint,
/// which fails if geometry ever overhangs further.
public sealed class MazeFootprint
{
    public const float Margin = 1.0f;   // set from TestMazeFootprint's printed worst case, rounded up to 0.5 m

    public readonly Dictionary<(int x, int y), (int lo, int hi)> Columns = new();
    public int ExitX { get; private set; } = 4;
    public int ExitY { get; private set; } = 9;
    public int ExitFloor { get; private set; }

    public static MazeFootprint From(MazeData m)
    {
        var fp = new MazeFootprint();
        var exit = m.Pieces.FirstOrDefault(p => p.Type == PieceType.Exit);
        if (exit != null) { fp.ExitX = exit.X; fp.ExitY = exit.Y; fp.ExitFloor = exit.Floor; }
        foreach (var p in m.Pieces)
        {
            int lo = p.Floor, hi = p.Floor;
            foreach (int f in PieceDB.FloorSpan(p.Type)) { lo = Math.Min(lo, p.Floor + f); hi = Math.Max(hi, p.Floor + f); }
            if (p.Type == PieceType.StairsDown) lo = Math.Min(lo, p.Floor - 1);
            if (p.Type == PieceType.Stairs || p.Type == PieceType.StairsUp) hi = Math.Max(hi, p.Floor + 1);
            foreach (var (dx, dy) in PieceDB.Footprint(p.Type))
                fp.Add(p.X + dx, p.Y + dy, lo - fp.ExitFloor, hi - fp.ExitFloor);
        }
        return fp;
    }

    void Add(int x, int y, int lo, int hi)
    {
        if (Columns.TryGetValue((x, y), out var s)) Columns[(x, y)] = (Math.Min(s.lo, lo), Math.Max(s.hi, hi));
        else Columns[(x, y)] = (lo, hi);
    }

    public MazeFootprint Rotated(int quarterTurns)
    {
        var r = new MazeFootprint { ExitFloor = ExitFloor };
