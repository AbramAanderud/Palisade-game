    // ── Door angles ──────────────────────────────────────────────────────────
    // Doorways are a list of angles (0 = north, clockwise, the same convention as
    // the polygon: (sin a, 0, −cos a)). 1v1 uses {0, π}; FFA adds π/2 and 3π/2,
    // which land exactly on faces 8 and 24. NearDoor is the ONE test every
    // doorway exception goes through.
    static bool NearDoor(float angle, float halfWidth, IReadOnlyList<float> doors)
    {
        foreach (float d in doors)
        {
            float diff = Mathf.Abs(Mathf.Wrap(angle - d + Mathf.Pi, 0f, Mathf.Tau) - Mathf.Pi);
            if (diff < halfWidth) return true;
        }
        return false;
    }

    static bool IsAngle(float a, float target) =>
        Mathf.Abs(Mathf.Wrap(a - target + Mathf.Pi, 0f, Mathf.Tau) - Mathf.Pi) < 1e-3f;

