using Godot;

/// res://test/TestHitMarker.cs
/// ─────────────────────────────────────────────────────────────────────────────
/// Proves the shooter both HEARS and SEES a landed hit.
///
/// The audio half exists because the null-guarded loader degrades a missing file
/// to silence, which is precisely how every gun in the game was mute for
/// everyone once already — the guard hid it. So the first assertion is simply
/// "did the streams load", which no amount of code reading can tell you.
///
/// The visual half puts a real SpreadCrosshair in a CanvasLayer under the
/// shooter, so HudLookup.FindGun resolves the same way it does in game and the
/// marker is drawn by the same code path the player sees.
///
/// DeliverDamage is the single funnel every hit takes — GunCombat's own hit
/// resolution and Rocket's splash both route through it — so exercising it is
/// exercising the live-game path.
///
/// Timeline (fixed-fps 10, so rendered frame N is at t = N/10):
///   t=0.10  body shot   → white marker, rendered frames 1-3
///   t=1.00  headshot    → gold  marker, rendered frames 10-12
/// ─────────────────────────────────────────────────────────────────────────────
public partial class TestHitMarker : Node3D
{
    StaticBody3D    _shooter  = null!;
    GunCombat       _gun      = null!;
    CharacterBody3D _target   = null!;
    PlayerHealth    _targetHp = null!;
    SpreadCrosshair _cross    = null!;

    int  _tick = 0;
    int  _events = 0;
    int  _headEvents = 0;

    public override void _Ready()
    {
        var floor = new StaticBody3D { Name = "Floor" };
        floor.AddChild(new CollisionShape3D
        {
            Shape = new BoxShape3D { Size = new Vector3(200f, 1f, 200f) },
        });
        floor.Position = new Vector3(0f, -2.5f, 0f);
        AddChild(floor);

        _shooter = new StaticBody3D { Name = "Shooter" };
        AddChild(_shooter);
        _shooter.GlobalPosition = Vector3.Zero;

        _gun = new GunCombat { CombatTeam = 0 };
        _shooter.AddChild(_gun);
        _gun.OnHitConfirmed += head => { _events++; if (head) _headEvents++; };

        // HUD hung off the SHOOTER so HudLookup.FindGun walks up and finds the
        // gun as a sibling, exactly as it resolves in the real player scene.
        var layer = new CanvasLayer { Name = "HUD" };
        _shooter.AddChild(layer);
        _cross = new SpreadCrosshair { Name = "Crosshair" };
        _cross.SetAnchorsPreset(Control.LayoutPreset.FullRect);
        _cross.MouseFilter = Control.MouseFilterEnum.Ignore;
        layer.AddChild(_cross);

        // Capsule CENTRED on the body origin, with the origin itself at feet +
        // 0.8. That is the convention GunCombat's zone math assumes
        // (footY = GlobalPosition.Y - 0.8). TestGunRange instead offsets the
        // shape +0.9 and puts the origin at the feet, which makes every
        // "centre mass" shot in that harness score as a HEADSHOT.
        _target = new CharacterBody3D { Name = "Target" };
        _target.AddChild(new CollisionShape3D
        {
            Shape    = new CapsuleShape3D { Radius = 0.4f, Height = 1.6f },
            Position = Vector3.Zero,
        });
        _targetHp = new PlayerHealth { Name = "PlayerHealth" };
        _target.AddChild(_targetHp);
        AddChild(_target);
        _target.GlobalPosition = new Vector3(0f, 0.8f, -10f);
    }

    public override void _PhysicsProcess(double delta)
    {
        _tick++;

        if (_tick == 2)
        {
            GD.Print($"[HM] streams loaded: hitmarker={_gun.HitMarkerLoaded} " +
                     $"headshotding={_gun.HeadshotLoaded}");
            GD.Print(_gun.HitMarkerLoaded && _gun.HeadshotLoaded
                ? "[HM] PASS load: both confirm sounds loaded off disk"
                : "[HM] FAIL load: a confirm sound did not load — hits would be silent");
        }
        else if (_tick == 6)
        {
            _gun.Equip("ak47");
            float hpBefore = _targetHp.CurrentHealth;
            _gun.RequestAttack();
            // Level with centre mass: relY lands at 0.8 — above LegsMaxY (0.5)
            // and below HeadMinY (1.35), so this is unambiguously a BODY hit.
            _gun.Tick(0.016f, new Vector3(0f, 0.8f, 0f), new Vector3(0f, 0f, -1f), 0f, false);

            GD.Print($"[HM] body shot: hp {hpBefore:F0} -> {_targetHp.CurrentHealth:F0}, " +
                     $"marker={_gun.HitMarkerPlaying} ding={_gun.HeadshotPlaying} " +
                     $"events={_events}");
            GD.Print(_targetHp.CurrentHealth < hpBefore && _gun.HitMarkerPlaying
                ? "[HM] PASS body: a landed shot plays the hitmarker"
                : "[HM] FAIL body: landed shot did not play the hitmarker");
            GD.Print(!_gun.HeadshotPlaying
                ? "[HM] PASS body: a body shot does NOT ring the headshot ding"
                : "[HM] FAIL body: a body shot rang the headshot ding");
            GD.Print(_events == 1 && _headEvents == 0
                ? "[HM] PASS event: body hit raised OnHitConfirmed(false)"
                : "[HM] FAIL event: body hit event wrong");
        }
        else if (_tick == 60)
        {
            _gun.DeliverDamage(_target, _targetHp, 20f,
                               _target.GlobalPosition + new Vector3(0f, 0.7f, 0f),
                               headshot: true);
            GD.Print($"[HM] headshot: marker={_gun.HitMarkerPlaying} " +
                     $"ding={_gun.HeadshotPlaying} events={_events} head={_headEvents}");
            GD.Print(_gun.HitMarkerPlaying && _gun.HeadshotPlaying
                ? "[HM] PASS head: a headshot plays BOTH the marker and the ding"
                : "[HM] FAIL head: a headshot did not stack both sounds");
            GD.Print(_headEvents == 1
                ? "[HM] PASS event: headshot raised OnHitConfirmed(true)"
                : "[HM] FAIL event: headshot event wrong");
        }
    }
}
