using Godot;
using System;
using System.Collections.Generic;
using System.Linq;

/// test/TestAltarWalk.cs
/// Gate for the arena altar: can the player actually walk up onto it, from any
/// direction, and does anything visual poke through the walk surface?
///
/// The altar's visible steps carry NO collision — an invisible cone does (the
/// project's settled stair pattern). That makes it easy to ship a version that
/// looks right and is unclimbable, or climbable with a hitch at one seam. So
/// this drives a player-shaped capsule at the altar from 12 approach angles and
/// asserts each one ends up standing on the platform.
///
/// Capsule and floor settings are copied from PlayerController (radius 0.35,
/// height 1.6, FloorMaxAngle 68 deg, FloorSnapLength 1.5) — a gate that used
/// different physics parameters than the real player would prove nothing.
public partial class TestAltarWalk : Node3D
{
    const int   Approaches = 12;
    const float WalkSpeed  = 6.0f;
    const int   StepsPerRun = 260;      // physics ticks per approach
    const float Dt         = 1f / 60f;

    public override void _Ready()
    {
        // Floor for the capsule to start on.
        var floor = new StaticBody3D { Name = "Floor" };
        floor.AddChild(new CollisionShape3D
        {
            Shape = new BoxShape3D { Size = new Vector3(60f, 1f, 60f) },
            Position = new Vector3(0f, -0.5f, 0f),
        });
        AddChild(floor);

        var altar = new AltarBuilder { Name = "Altar" };
        AddChild(altar);
        altar.Build(Vector3.Zero);

        // Diagnostics before the walk: if the ramp collider is missing or
        // degenerate the walk result is meaningless, so prove it exists first.
        var body0 = altar.GetNodeOrNull<StaticBody3D>("AltarBody");
        GD.Print($"[AltarWalk] AltarBody found={body0 != null} " +
                 $"shapes={body0?.GetChildren().OfType<CollisionShape3D>().Count() ?? -1} " +
                 $"layer={body0?.CollisionLayer}");
        foreach (var cs in body0?.GetChildren().OfType<CollisionShape3D>() ?? Enumerable.Empty<CollisionShape3D>())
            GD.Print($"[AltarWalk]   shape {cs.Name} type={cs.Shape?.GetType().Name} " +
                     $"faces={(cs.Shape as ConcavePolygonShape3D)?.GetFaces().Length / 3 ?? -1}");

        CallDeferred(nameof(Probe));
        CallDeferred(nameof(Run));
    }

    void Probe()
    {
        // Ray straight at the altar flank from outside, at knee height.
        var from = new Vector3(0f, 0.6f, -(AltarBuilder.BaseRadius + 2f));
        var to   = new Vector3(0f, 0.6f, 0f);
        var hit  = GetWorld3D().DirectSpaceState.IntersectRay(
            PhysicsRayQueryParameters3D.Create(from, to));
        GD.Print($"[AltarWalk] ray from r={AltarBuilder.BaseRadius + 2f} inward @y=0.6 -> " +
                 (hit.Count > 0 ? $"HIT {((Vector3)hit["position"])} on {hit["collider"]}" : "NO HIT"));
    }

    readonly List<(CharacterBody3D body, Vector3 inward, float ang)> _probes = new();
    int _tick;

    void Run()
    {
        for (int i = 0; i < Approaches; i++)
        {
            float ang = 2f * Mathf.Pi * i / Approaches;
            var inward = new Vector3(-Mathf.Sin(ang), 0f, Mathf.Cos(ang));
            var start  = new Vector3(Mathf.Sin(ang), 0f, -Mathf.Cos(ang))
                         * (AltarBuilder.BaseRadius + 2.5f) + new Vector3(0f, 1.0f, 0f);

            var body = new CharacterBody3D
            {
                Name            = $"Probe{i}",
                Position        = start,
                FloorMaxAngle   = 68f * Mathf.Pi / 180f,
                FloorSnapLength = 1.5f,
                // Probes live on layer 2 and mask only layer 1: they collide
                // with the altar and floor (layer 1) but not with each other, so
                // twelve converging capsules cannot pile up and hide a real dead
                // spot. NOT layer 0 — a body with no layer bits is skipped by the
                // broadphase for its own sweeps, so MoveAndSlide sails straight
                // through static geometry while raycasts still report hits.
                CollisionLayer  = 2,
                CollisionMask   = 1,
            };
            body.AddChild(new CollisionShape3D
            {
                Shape = new CapsuleShape3D { Radius = 0.35f, Height = 1.6f },
            });
            AddChild(body);
            _probes.Add((body, inward, ang));
        }
    }

    // Arrival tick per probe; -1 until it reaches the platform.
    readonly List<int> _arrived = new();

    public override void _PhysicsProcess(double delta)
    {
        if (_probes.Count == 0) return;
        while (_arrived.Count < _probes.Count) _arrived.Add(-1);

        for (int i = 0; i < _probes.Count; i++)
        {
            var (body, inward, _) = _probes[i];

            // Stop driving once a probe is standing on the platform. Without
            // this it keeps walking, crosses the 6m-wide top and falls off the
            // far side — which reads as "never climbed" in the final position
            // even though the climb succeeded. Measure arrival, not endpoint.
            if (_arrived[i] >= 0) { body.Velocity = Vector3.Zero; continue; }

            float r = new Vector2(body.Position.X, body.Position.Z).Length();
            if (body.Position.Y > AltarBuilder.Height + 0.6f && r < AltarBuilder.TopRadius)
            {
                _arrived[i] = _tick;
                body.Velocity = Vector3.Zero;
                continue;
            }

            var v = inward * WalkSpeed;
            v.Y = body.IsOnFloor() ? -1.0f : body.Velocity.Y - 22f * (float)delta;
            body.Velocity = v;
            body.MoveAndSlide();
        }

        _tick++;
        if (_arrived.Any(a => a < 0) && _tick < StepsPerRun) return;
        Report();
    }

    void Report()
    {
        var results = _probes
            .Select((p, i) => (ang: p.ang, y: p.body.Position.Y,
                          r: new Vector2(p.body.Position.X, p.body.Position.Z).Length(),
                          tick: _arrived[i], ok: _arrived[i] >= 0))
            .ToList();

        void P(string l) => GD.Print("[AltarWalk] " + l);
        P("──────────────────────────────────────────────");
        P($"altar  height={AltarBuilder.Height}m  top r={AltarBuilder.TopRadius}m  base r={AltarBuilder.BaseRadius}m");
        P($"ramp angle  {Mathf.RadToDeg(Mathf.Atan2(AltarBuilder.Height, AltarBuilder.Steps * AltarBuilder.StepRun)):F1} deg" +
          "   (PlayerController.FloorMaxAngle = 68 deg)");
        foreach (var r in results)
            P($"  approach {Mathf.RadToDeg(r.ang),6:F0} deg -> y={r.y,6:F2}  r={r.r,5:F2}  " +
              (r.ok ? $"UP in {r.tick} ticks" : "STUCK"));

        int up = results.Count(r => r.ok);
        var ticks = results.Where(r => r.ok).Select(r => r.tick).ToList();
        int spreadT = ticks.Count > 0 ? ticks.Max() - ticks.Min() : 0;
        P($"climbed {up}/{Approaches}   arrival-tick spread {spreadT}" +
          "   (a large spread means one direction is slower — a partial dead spot)");
        P(up == Approaches && spreadT <= 12
            ? "PASS — every approach reaches the platform at an even rate"
            : "FAIL — see STUCK rows / uneven arrival above");
        P("──────────────────────────────────────────────");
        GetTree().Quit();
    }
}
