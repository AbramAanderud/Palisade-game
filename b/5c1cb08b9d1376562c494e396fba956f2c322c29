using Godot;
using System.Collections.Generic;

/// Test: physics clutter props (Task 9). Drops 5 placeholder PhysicsProp
/// bodies onto a floor plane, lets them fall/settle, then fires
/// PhysicsProp.ApplySwingImpulse from a point toward them so a frame capture
/// shows visible scatter between early and late frames.
public partial class TestPhysicsProps : Node3D
{
    readonly List<PhysicsProp> _props = new();
    float _t;
    bool _swung;

    public override void _Ready()
    {
        var worldEnv = new WorldEnvironment();
        var env = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0, 0, 0),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(0.3f, 0.3f, 0.35f),
            AmbientLightEnergy = 1.0f,
        };
        worldEnv.Environment = env;
        AddChild(worldEnv);

        // floor plane
        var floorBody = new StaticBody3D { Name = "Floor" };
        var floorMesh = new MeshInstance3D
        {
            Mesh = new BoxMesh { Size = new Vector3(10f, 0.4f, 10f) },
            Position = new Vector3(0, -0.2f, 0),
        };
        floorBody.AddChild(floorMesh);
        floorBody.AddChild(new CollisionShape3D
        {
            Shape = new BoxShape3D { Size = new Vector3(10f, 0.4f, 10f) },
            Position = new Vector3(0, -0.2f, 0),
        });
        AddChild(floorBody);

        // 5 placeholder physics props dropped from ~0.5m, spread in an arc
        // in front of the swing origin (0,0,0) facing +Z.
        var colors = new[]
        {
            new Color(0.8f, 0.2f, 0.2f), new Color(0.2f, 0.8f, 0.2f),
            new Color(0.2f, 0.2f, 0.8f), new Color(0.8f, 0.8f, 0.2f),
            new Color(0.8f, 0.2f, 0.8f),
        };
        for (int i = 0; i < 5; i++)
        {
            float x = -1.0f + i * 0.5f;
            var prop = PhysicsProp.SpawnPrimitive(new Vector3(x, 0.5f, 1.5f), colors[i]);
            AddChild(prop);
            _props.Add(prop);
        }

        var cam = new Camera3D { Name = "Cam", Fov = 60f, Near = 0.05f, Far = 100f };
        cam.Position = new Vector3(0, 4.5f, 6f);
        cam.RotationDegrees = new Vector3(-45f, 0, 0);
        AddChild(cam);
        cam.MakeCurrent();

        var sun = new DirectionalLight3D { RotationDegrees = new Vector3(-55f, -30f, 0), LightEnergy = 1.2f };
        AddChild(sun);

        GD.Print("[TestPhysicsProps] Ready");
    }

    public override void _Process(double delta)
    {
        _t += (float)delta;
        // let props fall/settle for ~2s, then swing once from behind/below
        // toward +Z, matching where the props were spawned.
        if (!_swung && _t >= 2.0f)
        {
            _swung = true;
            GD.Print("[TestPhysicsProps] Applying swing impulse");
            PhysicsProp.ApplySwingImpulse(this, new Vector3(0, 0.5f, 0), new Vector3(0, 0, 1));
        }
    }
}
