using Godot;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Reflection;
using System.Text.Json;
using System.Threading.Tasks;

/// test/TestFfaLobbyFlow.cs
/// Four-client end-to-end check of the FFA party flow over a REAL relay:
/// party create/invite/join, seat + roster sync, maze-pick sync, ready/START
/// gating, ffa_start hand-off to OnlineFfaArena, the arena core (maze exchange,
/// world build, 3 puppets, host go → MatchLive, zone reports), and peer_left.
///
/// Run a relay, then four instances (throwaway accounts, writes maze slot 3):
///   PORT=3138 node server/relay.js & RELAY=$!
///   pids=(); for r in host c1 c2 c3; do
///     ..._console.exe --path . --headless res://test/TestFfaLobbyFlow.tscn --account __test_ffa_$r --relay ws://localhost:3138 --role $r > ffa-$r.log 2>&1 & pids+=($!)
///   done
///   wait "${pids[@]}"; kill $RELAY      # wait on the 4 Godot PIDs only, then stop the relay
/// Every log must end in ALL PASS.
///
/// The driver parks itself on the tree root so it survives every scene change.
public partial class TestFfaLobbyFlow : Node
{
    const int    TestSlot   = 3;
    const double TimeoutSec = 180;

    string _role = "";
    bool   _isHost => _role == "host";
    int    _fail;
    string _me = "";
    NetworkManager _nm = null!;

    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + $"[{_role}] " + label);
        if (!ok) _fail++;
    }

    public override void _Ready()
    {
        if (!AccountManager.ActiveAccount.StartsWith("__test_ffa"))
        {
            GD.PushError("Refusing to run: pass --account __test_ffa_<role>");
            GetTree().Quit(2);
            return;
        }
        var args = OS.GetCmdlineArgs();
        for (int i = 0; i < args.Length - 1; i++)
            if (args[i] == "--role") _role = args[i + 1];
        if (_role != "host" && _role != "c1" && _role != "c2" && _role != "c3")
        {
            GD.PushError("Refusing to run: --role must be host|c1|c2|c3");
            GetTree().Quit(2);
            return;
        }
        CallDeferred(nameof(Detach));
    }

    void Detach()
    {
        var root = GetTree().Root;
        GetParent().RemoveChild(this);
        root.AddChild(this);
        _ = Run();
    }

    async Task Run()
    {
        var watchdog = GetTree().CreateTimer(TimeoutSec);
        watchdog.Timeout += () => { GD.PrintErr("TIMEOUT"); GetTree().Quit(3); };

        PlayerProfile.Load();
        _me = OnlineGameState.PlayerName;
        var test = DefaultMaze.Build();
        test.Name = $"{_me} test maze";
        MazeSerializer.Save(TestSlot, test);
        OnlineGameState.SelectedMazeSlot = TestSlot;

        _nm = GetNode<NetworkManager>("/root/NetworkManager");

        // -- Matchmaking / party setup ------------------------------------
        var lobbyPlayers = new Dictionary<string, string>();   // id -> name, everyone but me
        bool created = false, joined = false;
        string createdJson = "", joinedJson = "";
        _nm.LobbyUpdated += json =>
        {
            using var doc = JsonDocument.Parse(json);
            lobbyPlayers.Clear();
            foreach (var p in doc.RootElement.GetProperty("players").EnumerateArray())
            {
                string id = p.GetProperty("id").GetString()!, name = p.GetProperty("name").GetString()!;
                if (name != _me) lobbyPlayers[id] = name;
            }
        };
        _nm.PartyCreated += j => { createdJson = j; created = true; };
        _nm.PartyJoined  += j => { joinedJson  = j; joined  = true; };
        _nm.PartyInvited += (code, _, _) => _nm.PartyRespond(code, true);

        if (!_isHost) await Wait(0.5);   // host is first in the lobby
        _nm.ConnectAndJoinLobby(_me);

        var expectedClients = new HashSet<string>();
        if (_isHost)
        {
            await Until(() => lobbyPlayers.Count >= 3, "3 clients in the lobby", limit: 40);
            foreach (var n in lobbyPlayers.Values) expectedClients.Add(n);
            await Wait(0.5);
            _nm.PartyCreate();
            await Until(() => created, "party_created");
            FfaPreGameLobby.PendingInfoJson = createdJson;
        }
        else
        {
            await Until(() => joined, "party_joined (after accepting the invite)", limit: 60);
            FfaPreGameLobby.PendingInfoJson = joinedJson;
        }

        GetTree().ChangeSceneToFile("res://scenes/FfaPreGameLobby.tscn");
        await Until(() => GetTree().CurrentScene is FfaPreGameLobby, "FfaPreGameLobby scene");
        var lobby = (FfaPreGameLobby)GetTree().CurrentScene;
        int mySeat = lobby.MySeat;

        // Host invites each client through the lobby's invite list. The Invite
        // buttons ARE reachable: the list is the private _inviteList VBox of
        // HBox rows (name Label + Button); we emit that button's Pressed, the
        // same handler a click runs (it calls _nm.PartyInvite(id)).
        if (_isHost)
        {
            var invited = new HashSet<string>();
            await Until(() =>
            {
                foreach (var name in expectedClients)
                    if (!invited.Contains(name) && PressInvite(lobby, name)) invited.Add(name);
                return invited.Count == expectedClients.Count;
            }, "Invite buttons for all 3 clients", limit: 20);
        }

        // -- Seats / roster -----------------------------------------------
        await Until(() => Enumerable.Range(0, 4).All(s => Occupied(lobby, s)), "4 occupied seats", limit: 60);
        var seatNames = Enumerable.Range(0, 4).Select(s => lobby.SeatNameText(s)).ToList();
        Check(seatNames.Distinct().Count() == 4, $"4 distinct seat names ({string.Join(", ", seatNames)})");
        Check(lobby.SeatNameText(mySeat) == _me, $"my seat {mySeat} shows my name '{_me}'");
        if (_isHost)
        {
            Check(mySeat == 0, "host is seat 0");
            var expectedAll = new HashSet<string>(expectedClients) { _me };
            Check(seatNames.ToHashSet().SetEquals(expectedAll), "seat names match the lobby roster");
            Check(lobby.SeatNameText(0) == _me &&
                  Enumerable.Range(1, 3).Select(s => lobby.SeatNameText(s)).ToHashSet().SetEquals(expectedClients),
                  "clients hold distinct seats 1-3");
        }
        else
        {
            Check(mySeat >= 1 && mySeat <= 3, $"client seat in 1-3 ({mySeat})");
        }

        lobby.SelectMazeForTest(TestSlot);
        await Wait(1.0);   // everyone's first pick / ready state crosses

        // -- Readying -----------------------------------------------------
        var others = Enumerable.Range(0, 4).Where(s => s != mySeat).ToList();
        if (!_isHost)
        {
            Check(!lobby.StartVisible, "client does not see START");
            await Wait(0.5 * mySeat);   // stagger a little
            lobby.PressReadyForTest();
        }
        else
        {
            await Until(() => others.All(s => lobby.SeatReady(s)), "all 3 clients ready", limit: 40);
            Check(lobby.StartVisible && !lobby.StartEnabled, "host START visible but disabled while host not ready");
            await Until(() => others.All(s => lobby.SeatMazeText(s).Contains($"(Slot {TestSlot})")),
                        "every client's pick shows the slot-3 maze", limit: 10);
            Check(others.All(s => lobby.SeatMazeText(s).Contains("test maze")),
                  "pick sync: " + string.Join(" | ", others.Select(s => lobby.SeatMazeText(s))));
            lobby.PressReadyForTest();
            await Until(() => lobby.StartEnabled, "START enabled after host ready", limit: 5);
            Check(true, "START enabled once host + clients are ready");
            lobby.PressStartForTest();
        }

        // -- Arena hand-off -----------------------------------------------
        await Until(() => GetTree().CurrentScene is OnlineFfaArena, "OnlineFfaArena scene", limit: 30);
        var arena = (OnlineFfaArena)GetTree().CurrentScene;
        Check(OnlineGameState.IsFfa, "IsFfa set");
        Check(OnlineGameState.FfaSeat == mySeat, $"FfaSeat {OnlineGameState.FfaSeat} == lobby seat {mySeat}");
        Check(OnlineGameState.FfaRoster.Count == 4, $"FfaRoster.Count == {OnlineGameState.FfaRoster.Count}");
        Check(OnlineGameState.FfaHostSeat == 0, $"FfaHostSeat == {OnlineGameState.FfaHostSeat}");
        Check(OnlineGameState.FfaRotationOffset == 1, $"FfaRotationOffset == {OnlineGameState.FfaRotationOffset}");

        // -- Arena core (Phase 5): maze exchange → world → puppets → go → GO --
        await Until(() => arena.MatchLive, "MatchLive (every maze in, host go, countdown done)", limit: 60);
        Check(arena.PuppetCount == 3, $"PuppetCount == {arena.PuppetCount} (3 remote puppets)");
        int expectMaze = (mySeat + 1) % 4;   // seats 0-3, offset 1: layout k runs k+1
        Check(arena.LocalMazeSeat == expectMaze, $"LocalMazeSeat {arena.LocalMazeSeat} == {expectMaze}");
        Check(arena.LocalPosition != Vector3.Zero, $"local player spawned at {arena.LocalPosition}");
        await Until(() => arena.ZoneBySeat.Count == 4, "zone reports from all 4 seats", limit: 10);
        Check(Enumerable.Range(0, 4).All(s => arena.ZoneBySeat.TryGetValue(s, out var z) && z == (s + 1) % 4),
              "every seat reports standing in the maze it runs: " +
              string.Join(" ", arena.ZoneBySeat.OrderBy(kv => kv.Key).Select(kv => $"{kv.Key}:{kv.Value}")));
        await Wait(1.0);   // let everyone reach GO before the drop

        // -- peer_left ----------------------------------------------------
        if (_role == "c3")
        {
            _nm.Disconnect();
            await Wait(0.5);
        }
        else
        {
            await Until(() => arena.PeerLeftCount == 1, "peer_left for c3", limit: 15);
            Check(arena.PeerLeftCount == 1, $"PeerLeftCount == {arena.PeerLeftCount}");
            Check(OnlineGameState.FfaHostSeat == 0, $"host seat still 0 after c3 left ({OnlineGameState.FfaHostSeat})");
            Check(arena.PuppetCount == 2, $"c3's puppet removed (PuppetCount == {arena.PuppetCount})");
            await Wait(1.5);   // don't quit before the others have checked
        }

        DirAccess.RemoveAbsolute(ProjectSettings.GlobalizePath(AccountManager.MazeSlotPath(TestSlot)));
        DirAccess.RemoveAbsolute(ProjectSettings.GlobalizePath(AccountManager.ProfilePath()));
        GD.Print(_fail == 0 ? "ALL PASS" : $"{_fail} FAILED");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }

    // -- Helpers ------------------------------------------------------------

    // Open seats render as "Open seat".
    static bool Occupied(FfaPreGameLobby l, int s)
    {
        string t = l.SeatNameText(s);
        return t != "" && t != "Open seat";
    }

    /// Emits Pressed on the enabled Invite button in the row labelled `name`.
    static bool PressInvite(FfaPreGameLobby lobby, string name)
    {
        var list = Field<VBoxContainer>(lobby, "_inviteList");
        foreach (var row in list.GetChildren().OfType<HBoxContainer>())
        {
            var lbl = row.GetChildren().OfType<Label>().FirstOrDefault();
            var btn = row.GetChildren().OfType<Button>().FirstOrDefault();
            if (lbl == null || btn == null || lbl.Text != name || btn.Disabled || row.IsQueuedForDeletion()) continue;
            btn.EmitSignal(BaseButton.SignalName.Pressed);
            return true;
        }
        return false;
    }

    static T Field<T>(object o, string name)
    {
        var f = o.GetType().GetField(name, BindingFlags.NonPublic | BindingFlags.Instance)
                ?? throw new MissingFieldException(o.GetType().Name, name);
        return (T)f.GetValue(o)!;
    }

    async Task Wait(double s) => await ToSignal(GetTree().CreateTimer(s), SceneTreeTimer.SignalName.Timeout);

    async Task Until(Func<bool> cond, string what, double limit = 30)
    {
        double t = 0;
        while (!cond())
        {
            await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame);
            t += GetProcessDeltaTime();
            if (t > limit) { Check(false, $"timed out waiting for {what}"); GD.Print($"{_fail} FAILED"); GetTree().Quit(1); await Wait(999); }
        }
    }
}
