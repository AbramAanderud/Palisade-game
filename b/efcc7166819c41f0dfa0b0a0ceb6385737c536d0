using Godot;
using System;
using System.Collections.Generic;

/// scenes/HallwayDemo.cs — dev-tools walkthrough of the six Blender hallway
/// modules (tools/hallway_gen.py → assets/glb/hallways/hall_*.glb).
///
/// Reachable from the title screen's "Dev: Scenes" picker. Free-fly camera:
/// WASD + mouse, Q/E down/up, Shift = fast, Esc releases the mouse.
///
/// Each style is 3 tiled 10m segments plus its own lighting rig — the GLBs are
/// static geometry only, and each reference photo's look is at least half
/// lighting, so colour/energy/spacing here is per style, not shared.
///
/// Axis note: the generator builds each segment along Blender +Y (0..10);
/// the glTF exporter's Y-up conversion lands that on Godot -Z, so a segment
/// spans z in [-10, 0] and tiling means stepping z by -10.
///
/// Headless capture (screenshots for review):
///   godot --path . res://scenes/HallwayDemo.tscn --write-movie shots/h.png \
///         --fixed-fps 1 --quit-after 7 -- shots
public partial class HallwayDemo : Node3D
{
    const float SegLen = 10f;
    const int   SegsPerStyle = 3;
    const float StyleGap = 6f;      // dark breather between styles

    // (glb style suffix, display name, light colour, energy, range, spacing, height)
    //
    // ── HARD LIGHT BUDGET: total omnis across ALL styles must stay ≤ 32 ──────
    // Measured on this project's gl_compatibility renderer: beyond ~32 total
    // OmniLight3D in frame, lights are SILENTLY DROPPED (max_renderable_lights
    // =512 in project.godot does not save you; the operative ceiling matches
    // max_lights_per_object=32). Symptom is bizarre: floors stay lit while
    // ceilings 2m from a light render ambient-black. Diagnosed by bisection:
    // solo style = lit, full six styles at 56 lights = black; halving the
    // census under 32 restored every ceiling. Current census: 3+7+5+5+5+5=30.
    static readonly (string id, string label, Color col, float energy, float range, float spacing, float h)[]
        Styles =
    {
        ("redlodge", "RED LODGE",    new Color(1.0f, 0.45f, 0.30f), 2.6f, 14f, 10.0f, 5.0f),
        ("office",   "MINT OFFICE",  new Color(0.93f, 1.0f, 0.93f), 2.8f, 18f, 4.4f, 12.8f),
        ("hotel",    "GRAND HOTEL",  new Color(1.0f, 0.80f, 0.52f), 2.0f, 12f, 6.6f, 3.0f),
        ("manor",    "DIM MANOR",    new Color(1.0f, 0.60f, 0.28f), 2.2f, 14f, 6.6f, 11.0f),
        ("ocean",    "OCEAN DOORS",  new Color(0.72f, 0.80f, 0.90f), 1.7f, 18f, 6.6f, 10.0f),
        ("garden",   "ROSE GALLERY", new Color(1.0f, 0.97f, 0.90f), 2.8f, 18f, 6.6f, 11.5f),
    };

    string? _solo;
    Camera3D _cam = null!;
    float _yaw, _pitch;
    bool _shots;
    int _frame;

    public override void _Ready()
    {
        _shots = System.Linq.Enumerable.Contains(OS.GetCmdlineUserArgs(), "shots");
        // Bisect tool: "solo:office" builds ONLY that style at z=0 — the probe
        // scene with office alone renders a LIT ceiling while the full demo
        // renders it black, so the fault is somewhere in scene composition.
        foreach (var a in OS.GetCmdlineUserArgs())
            if (a.StartsWith("solo:")) _solo = a.Substring(5);

        var env = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = Colors.Black,
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(0.5f, 0.5f, 0.5f),
            AmbientLightEnergy = 0.12f,
            TonemapMode        = Godot.Environment.ToneMapper.Filmic,
            TonemapExposure    = 1.1f,
        };
        AddChild(new WorldEnvironment { Environment = env });

        float z = 0f;
        foreach (var s in Styles)
        {
            if (_solo != null && s.id != _solo) continue;
            var scene = LoadGlb($"res://assets/glb/hallways/hall_{s.id}.glb");
            if (scene == null)
            {
                GD.Print($"[HallwayDemo] MISSING hall_{s.id}.glb — run tools/hallway_gen.py");
                continue;
            }
            for (int k = 0; k < SegsPerStyle; k++)
            {
                var inst = scene.Instantiate<Node3D>();
                inst.Name = $"{s.id}_{k}";
                inst.Position = new Vector3(0, 0, z - k * SegLen);
                AddChild(inst);
            }
            // lighting rig — the styles differ by light, not just geometry.
            // Ocean is special-cased: its ONLY light is the storm spill added
            // by BuildOceanExterior, per the no-interior-lighting brief.
            for (float d = s.spacing * 0.5f; s.id != "ocean" && d < SegLen * SegsPerStyle; d += s.spacing)
                AddChild(new OmniLight3D
                {
                    Position        = new Vector3(0, s.h, z - d),
                    LightColor      = s.col,
                    LightEnergy     = s.energy,
                    OmniRange       = s.range,
                    OmniAttenuation = 0.9f,
                    ShadowEnabled   = false,
                });
            AddChild(new Label3D
            {
                Text      = s.label,
                Position  = new Vector3(0, 3.2f, z + 1.2f),
                FontSize  = 96,
                PixelSize = 0.004f,
                Modulate  = new Color(1f, 0.95f, 0.8f),
                Billboard = BaseMaterial3D.BillboardModeEnum.Enabled,
            });
            if (s.id == "ocean") BuildOceanExterior(z);
            z -= SegLen * SegsPerStyle + StyleGap;
        }

        _cam = new Camera3D { Fov = 80f, Near = 0.05f, Far = 400f, Position = new Vector3(0, 1.6f, 3f) };
        AddChild(_cam);
        _cam.MakeCurrent();
        if (!_shots) Input.MouseMode = Input.MouseModeEnum.Captured;
        GD.Print("[HallwayDemo] ready — WASD+mouse, Q/E vertical, Shift fast, Esc frees mouse");
    }


    // ══════════════════════════════════════════════════════════════════════════
    //  OCEAN EXTERIOR — a real moving sea outside the ocean room's doorways.
    //  The hall_ocean GLB (v3) has genuine holes in its walls: big pink frames,
    //  no door slabs. Everything you see through them is built here:
    //    - animated wave plane (vertex-displaced, 3 interfering sine trains)
    //    - gradient sky box quads with a sun disc
    //    - invisible StaticBody3D blockers in each opening: look out, never
    //      walk out
    //  All ocean/sky materials are render_mode UNSHADED — they consume ZERO of
    //  the ≤32 omni budget this file documents above.
    // ══════════════════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════════════════
    //  INFINITE OCEAN PORTALS — the sea exists nowhere in physical space.
    //
    //  Each doorway holds one flat quad. Its fragment shader ray-casts from
    //  CAMERA_POSITION_WORLD through the fragment against an infinite sea
    //  plane (y = -0.6) and an infinite cloud plane (y = 60), and shades the
    //  hit analytically: sea by wave-normal field + directional sky
    //  reflection, sky by elevation gradient + projected storm deck. The
    //  horizon sits at mathematical infinity, parallax is exact as the viewer
    //  moves, and there is NO geometry outside the wall at all — the previous
    //  diorama boxes are gone entirely. cull_back means the quads are
    //  invisible from outside the room.
    //
    //  The room is lit ONLY by cool spill lights at the doorways (storm light
    //  from the ocean): the ocean style contributes no generic ceiling row —
    //  see the light-budget note; census is 3+7+5+5+0+5 generic + 6 spill = 31.
    // ══════════════════════════════════════════════════════════════════════════
    const string StormCommonSrc = @"
float hash21(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vn2(vec2 p){
    vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash21(i), hash21(i + vec2(1, 0)), f.x),
               mix(hash21(i + vec2(0, 1)), hash21(i + vec2(1, 1)), f.x), f.y);
}
float fbm(vec2 p){ return vn2(p) * 0.55 + vn2(p * 2.3 + 7.7) * 0.30 + vn2(p * 5.1 + 3.1) * 0.15; }
vec3 skyGrad(float t01){
    vec3 horz = vec3(0.52, 0.54, 0.56);
    vec3 mid  = vec3(0.36, 0.41, 0.48);
    vec3 zen  = vec3(0.15, 0.18, 0.23);
    float t = clamp(t01, 0.0, 1.0);
    vec3 c = mix(horz, mid, smoothstep(0.0, 0.20, t));
    return mix(c, zen, smoothstep(0.28, 1.0, t));
}
float lightning(float t){
    float f = sin(t * 1.7) * sin(t * 0.63 + 2.1) * sin(t * 2.9 + 0.7);
    return pow(max(f, 0.0), 36.0);
}
";

    const string PortalShaderSrc = @"
shader_type spatial;
render_mode unshaded, cull_back;
// The sea sits SEA_DROP below the room floor, so every portal is a sheer fall
// to the water — you look DOWN at the ocean, not out across it. The horizon
// still paints itself at eye height (it is at infinity; lowering the plane
// cannot move it), which is exactly how a clifftop view behaves.
const float SEA_DROP = 30.0;
// Which wall this portal lives in, so the surf band below can hug the
// structure: wall_x is the wall plane's world x, side_sign is +1 east / -1
// west (outward = side_sign * (x - wall_x) increasing).
uniform float wall_x = 3.07;
uniform float side_sign = 1.0;
__COMMON__
varying vec3 wpos;
void vertex() { wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }

vec3 stormSky(vec3 ro, vec3 rd) {
    float el = max(rd.y, 0.0);
    vec3 col = skyGrad(el * 1.6);
    // storm deck: project the ray onto an infinite cloud plane at y = 60 —
    // real parallax, infinite extent
    float tt = clamp(el * 2.0, 0.0, 1.0);
    vec2 cuv;
    if (rd.y > 0.02) cuv = (ro + rd * ((60.0 - ro.y) / rd.y)).xz * 0.004 + vec2(TIME * 0.012, 0.0);
    else             cuv = rd.xz * 9.0;
    float cl = fbm(cuv);
    float cov = smoothstep(0.30, 0.58, cl);
    vec3 cloudDark = mix(vec3(0.28, 0.30, 0.34), vec3(0.10, 0.11, 0.14), tt);
    col = mix(col, cloudDark, cov * 0.92);
    float edge = smoothstep(0.30, 0.40, cl) - smoothstep(0.44, 0.70, cl);
    col += vec3(0.30, 0.30, 0.33) * edge * (1.0 - tt) * 0.55;
    col += vec3(0.50, 0.54, 0.68) * lightning(TIME) * smoothstep(0.35, 0.0, el);
    return col;
}

void fragment() {
    vec3 ro = CAMERA_POSITION_WORLD;
    vec3 rd = normalize(wpos - ro);
    float t = TIME * 1.2;
    vec3 col;
    if (rd.y < -0.001) {
        // ── infinite sea plane, SEA_DROP below the floor ──────────────────────
        float dist = (ro.y + SEA_DROP) / (-rd.y);
        vec3 hit = ro + rd * dist;
        float dhx = cos(hit.x * 0.31 + t * 1.2) * 0.42 * 0.31
                  + cos((hit.x + hit.z) * 0.52 + t * 1.8) * 0.18 * 0.52;
        float dhz = cos(hit.z * 0.23 - t * 0.8) * 0.34 * 0.23
                  + cos((hit.x + hit.z) * 0.52 + t * 1.8) * 0.18 * 0.52;
        vec2 chop = vec2(vn2(hit.xz * 2.3 + vec2(t * 0.8, -t * 0.5)),
                         vn2(hit.xz * 2.1 - vec2(t * 0.6, t * 0.9))) - 0.5;
        // soften the normal field with distance (a poor man's mip) so the far
        // field shimmers instead of aliasing. 0.015 not 0.03: with the sea
        // 30m down, the NEAREST water is already ~30m away — the old constant
        // flattened the whole visible field.
        float att = 1.0 / (1.0 + dist * 0.015);
        vec3 N = normalize(vec3((-dhx + chop.x * 0.45) * att, 1.0,
                                (-dhz + chop.y * 0.45) * att));
        float hgt = sin(hit.x * 0.31 + t * 1.2) * 0.42 + sin(hit.z * 0.23 - t * 0.8) * 0.34;
        vec3 deep  = vec3(0.020, 0.045, 0.060);
        vec3 crest = vec3(0.075, 0.125, 0.135);
        col = mix(deep, crest, clamp((hgt + 0.76) / 1.52, 0.0, 1.0));
        // directional reflection of the SAME sky the portal paints above
        vec3 R = reflect(rd, N);
        vec3 refl = R.y > 0.0 ? skyGrad(R.y * 1.6) : vec3(0.10, 0.13, 0.15);
        refl *= 0.72 + 0.28 * vn2(hit.xz * 0.05 + R.xz * 6.0 + TIME * 0.02);
        float fres = pow(1.0 - clamp(dot(N, -rd), 0.0, 1.0), 3.0);
        col = mix(col, refl, clamp(0.18 + fres * 1.1, 0.0, 0.92));
        // wind-streaked whitecaps, calmer far away
        float capN = vn2(hit.xz * 1.1 + vec2(t * 0.5, t * 0.3))
                   + vn2(hit.xz * 3.4 - vec2(t * 0.3, t * 0.6)) * 0.35;
        float cap = smoothstep(0.55, 0.95, (hgt + 0.76) / 1.52) * smoothstep(0.75, 1.05, capN);
        col = mix(col, vec3(0.60, 0.63, 0.65), cap * 0.55 * att);
        // ── surf: waves breaking against the structure below ─────────────────
        // The band of churning white along the wall base is what makes the
        // drop read as a building rising out of the sea rather than a room
        // floating in air. dxw = horizontal distance outward from this wall.
        float dxw = side_sign * (hit.x - wall_x);
        float churn = vn2(hit.xz * 0.9 + vec2(0.0, t * 0.9)) * 0.6
                    + vn2(hit.xz * 2.6 - vec2(t * 0.7, 0.0)) * 0.4;
        float surge = 0.75 + 0.25 * sin(t * 0.9 + hit.z * 0.35);   // swell slamming in
        // Band width 14m, not 6: sightline geometry through a sill at floor
        // level means the nearest water a player can SEE (toes at the
        // threshold, eye 1.7m up) is ~9m out from the wall — a 6m band was
        // mathematically invisible from inside the room.
        float surf = smoothstep(14.0, 0.4, dxw) * (0.30 + 0.70 * churn) * surge;
        col = mix(col, vec3(0.64, 0.67, 0.69), clamp(surf, 0.0, 1.0) * 0.85);

        // aerial perspective: exponential haze to the horizon colour; as
        // rd.y -> 0 the distance -> infinity and sea meets sky seamlessly.
        // 0.0055 not 0.010: the nearest water is now 30m+ away and the old
        // constant washed out the very surf that sells the fall.
        col = mix(vec3(0.16, 0.19, 0.21), col, exp(-dist * 0.0055));
        col += vec3(0.40, 0.44, 0.55) * lightning(TIME) * fres * 0.5;
    } else {
        col = stormSky(ro, rd);
    }
    ALBEDO = col;
}";

    void BuildOceanExterior(float zStart)
    {
        // One material per SIDE (not one shared): the surf band needs to know
        // which wall plane it breaks against (wall_x / side_sign uniforms).
        var portalShader = new Shader { Code = PortalShaderSrc.Replace("__COMMON__", StormCommonSrc) };
        var portalMats = new Dictionary<int, ShaderMaterial>();
        foreach (int sd in new[] { -1, 1 })
        {
            var m = new ShaderMaterial { Shader = portalShader };
            m.SetShaderParameter("wall_x", sd * 3.07f);
            m.SetShaderParameter("side_sign", (float)sd);
            portalMats[sd] = m;
        }

        // openings: must mirror tools/hallway_gen.py ocean v4 (OW/OH/CENTRES)
        const float OW = 4.0f, OH = 9.2f;
        float[] centres = { 2.5f, 7.5f };

        var body = new StaticBody3D { Name = "OceanBlockers" };
        AddChild(body);

        for (int k = 0; k < SegsPerStyle; k++)
            foreach (float c in centres)
                foreach (int side in new[] { -1, 1 })
                {
                    float z = zStart - k * SegLen - c;
                    // portal quad in the opening plane, facing inward
                    AddChild(new MeshInstance3D
                    {
                        Name = $"Portal{(side > 0 ? "E" : "W")}{k}_{c}",
                        Mesh = new QuadMesh { Size = new Vector2(OW, OH) },
                        Position = new Vector3(side * 3.07f, OH / 2f, z),
                        RotationDegrees = new Vector3(0, side > 0 ? -90 : 90, 0),
                        MaterialOverride = portalMats[side],
                        CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
                    });
                    // collision: look out, never walk out
                    body.AddChild(new CollisionShape3D
                    {
                        Shape = new BoxShape3D { Size = new Vector3(0.3f, OH, OW) },
                        Position = new Vector3(side * 3.06f, OH / 2f, z),
                    });
                }

        // the ONLY light in this room: cool storm spill through the doorways
        // (one per side per segment, covering both portals — 6 total, keeping
        // the global census at 31 ≤ 32)
        for (int k = 0; k < SegsPerStyle; k++)
            foreach (int side in new[] { -1, 1 })
                AddChild(new OmniLight3D
                {
                    Name            = $"OceanSpill{k}{side}",
                    Position        = new Vector3(side * 2.2f, 4.5f, zStart - k * SegLen - 5f),
                    LightColor      = new Color(0.62f, 0.70f, 0.80f),
                    LightEnergy     = 1.5f,
                    OmniRange       = 10f,
                    OmniAttenuation = 0.8f,
                    ShadowEnabled   = false,
                });
    }

    // Runtime GLB load with the PropLibrary fallback: assets/ is gitignored, so
    // on a fresh checkout the .import sidecars may not exist yet.
    static PackedScene? LoadGlb(string resPath)
    {
        if (ResourceLoader.Exists(resPath))
        {
            var ps = GD.Load<PackedScene>(resPath);
            if (ps != null) return ps;
        }
        var abs = ProjectSettings.GlobalizePath(resPath);
        if (!System.IO.File.Exists(abs)) return null;
        var gltf = new GltfDocument();
        var state = new GltfState();
        if (gltf.AppendFromFile(abs, state) != Error.Ok) return null;
        var node = gltf.GenerateScene(state);
        var packed = new PackedScene();
        packed.Pack(node);
        return packed;
    }

    public override void _UnhandledInput(InputEvent ev)
    {
        if (ev is InputEventMouseMotion mm && Input.MouseMode == Input.MouseModeEnum.Captured)
        {
            _yaw   -= mm.Relative.X * 0.0025f;
            _pitch  = Mathf.Clamp(_pitch - mm.Relative.Y * 0.0025f, -1.5f, 1.5f);
            _cam.Rotation = new Vector3(_pitch, _yaw, 0);
        }
        if (ev is InputEventKey k && k.Pressed && k.Keycode == Key.Escape)
            Input.MouseMode = Input.MouseMode == Input.MouseModeEnum.Captured
                ? Input.MouseModeEnum.Visible : Input.MouseModeEnum.Captured;
    }

    public override void _Process(double delta)
    {
        if (_shots) { ShotFrame(); return; }

        float sp = Input.IsKeyPressed(Key.Shift) ? 12f : 4.5f;
        var dir = Vector3.Zero;
        if (Input.IsKeyPressed(Key.W)) dir -= _cam.Basis.Z;
        if (Input.IsKeyPressed(Key.S)) dir += _cam.Basis.Z;
        if (Input.IsKeyPressed(Key.A)) dir -= _cam.Basis.X;
        if (Input.IsKeyPressed(Key.D)) dir += _cam.Basis.X;
        if (Input.IsKeyPressed(Key.E)) dir += Vector3.Up;
        if (Input.IsKeyPressed(Key.Q)) dir -= Vector3.Up;
        if (dir.LengthSquared() > 0.01f)
            _cam.Position += dir.Normalized() * sp * (float)delta;
    }

    // One frame per style, camera at the style's mid-corridor eye line.
    void ShotFrame()
    {
        int i = Math.Min(_frame, Styles.Length - 1);
        float z0 = -i * (SegLen * SegsPerStyle + StyleGap);
        _cam.Position = new Vector3(0, 1.6f, z0 - 2f);
        _cam.Rotation = new Vector3(0.10f, 0, 0);   // slight up-tilt: show the 14m verticality
        if (i == 4)
        {
            // ocean: a step back from the portal, tilted down — the DOORFRAME
            // must stay in frame or the drop has nothing to be relative to.
            // yaw -90 faces +X (straight out the east portal).
            _cam.Position = new Vector3(0.9f, 1.7f, z0 - 2.5f);
            _cam.RotationDegrees = new Vector3(-20f, -90f, 0f);
        }
        _frame++;
    }
}
