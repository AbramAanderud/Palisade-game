using Godot;

/// res://test/TestRocketFlight.cs
/// ─────────────────────────────────────────────────────────────────────────────
/// Films a rocket in flight from a side-on camera to answer one question: is the
/// projectile actually visible in the air, or does it read as an instant hit?
///
/// A wall sits 40 m downrange so the rocket has a full travel arc to be seen
/// against, and the scene is dark so the rocket's own light shows the way a
/// dungeon corridor would.
/// ─────────────────────────────────────────────────────────────────────────────
public partial class TestRocketFlight : Node3D
{
    StaticBody3D _shooter = null!;
    GunCombat    _gun     = null!;
    float        _t       = 0f;
    int          _fired   = 0;

    public override void _Ready()
    {
        // Dark, like the dungeon — so the rocket's own OmniLight does the work.
        var env = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0.02f, 0.02f, 0.03f),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(0.25f, 0.25f, 0.30f),
            AmbientLightEnergy = 0.35f,
        };
        AddChild(new WorldEnvironment { Environment = env });

        // Floor + a far wall to detonate against.
        AddBox(new Vector3(0f, -0.5f, -20f), new Vector3(12f, 1f, 60f),
               new Color(0.18f, 0.17f, 0.16f));
        AddBox(new Vector3(0f, 3f, -40f), new Vector3(12f, 8f, 1f),
               new Color(0.26f, 0.24f, 0.22f));

        _shooter = new StaticBody3D { Name = "Shooter" };
        AddChild(_shooter);
        _shooter.GlobalPosition = Vector3.Zero;

        _gun = new GunCombat { CombatTeam = 0 };
        _shooter.AddChild(_gun);
        _gun.Equip("rocketlaucher");

        // Side-on camera: the whole 40 m flight path is in frame left-to-right,
        // which is the only way to judge whether the rocket is trackable in air.
        var cam = new Camera3D { Fov = 70f };
        AddChild(cam);
        cam.Position = new Vector3(26f, 6f, -20f);
        cam.LookAt(new Vector3(0f, 1.5f, -20f), Vector3.Up);
        cam.MakeCurrent();
    }

    void AddBox(Vector3 pos, Vector3 size, Color col)
    {
        var body = new StaticBody3D();
        body.AddChild(new CollisionShape3D { Shape = new BoxShape3D { Size = size } });
        var mi = new MeshInstance3D { Mesh = new BoxMesh { Size = size } };
        mi.SetSurfaceOverrideMaterial(0,
            new StandardMaterial3D { AlbedoColor = col, Roughness = 1f, Metallic = 0f });
        body.AddChild(mi);
        AddChild(body);
        body.GlobalPosition = pos;
    }

    public override void _PhysicsProcess(double delta)
    {
        float dt = (float)delta;
        _t += dt;

        // Fire once a second, straight down the range.
        var origin = new Vector3(0f, 1.6f, 0f);
        var dir    = new Vector3(0f, 0.06f, -1f).Normalized();

        if (_t > 0.35f + _fired * 1.0f && _fired < 4)
        {
            _gun.RequestAttack();
            _fired++;
        }
        _gun.Tick(dt, origin, dir, 0f, false);
    }
}
