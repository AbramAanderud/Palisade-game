# blend.ps1 — send a Python file to the running Blender MCP add-on bridge.
#
# The official Blender Lab "MCP" add-on exposes a raw socket on 127.0.0.1:9876
# speaking null-byte-delimited JSON: {"type":"execute","code":"...","strict_json":bool}\0
# The uvx companion server that normally wraps this is failing to start, and its
# tools only load at Claude Code session start anyway — so we talk to the bridge
# directly, which needs nothing but a TCP socket.
#
# Usage: powershell -File blend.ps1 <script.py>

param([Parameter(Mandatory=$true)][string]$ScriptPath)

if (-not (Test-Path $ScriptPath)) { Write-Error "No such file: $ScriptPath"; exit 1 }

$code = [System.IO.File]::ReadAllText($ScriptPath)
# Strip a UTF-8 BOM if the file has one — it survives into the JSON string and
# makes the first Python line a syntax error.
if ($code.Length -gt 0 -and $code[0] -eq [char]0xFEFF) { $code = $code.Substring(1) }
$payload = @{ type = "execute"; code = $code; strict_json = $false } | ConvertTo-Json -Compress -Depth 5

$client = New-Object System.Net.Sockets.TcpClient
try {
    $client.Connect("127.0.0.1", 9876)
    $stream = $client.GetStream()
    $stream.ReadTimeout = 600000

    # Send payload and its null delimiter as ONE write — splitting them across two
    # calls left the add-on waiting on an incomplete request until it timed out.
    $bytes = [System.Text.Encoding]::UTF8.GetBytes($payload + "`0")
    $stream.Write($bytes, 0, $bytes.Length)
    $stream.Flush()

    # Read until the null terminator that ends the response.
    $sb  = New-Object System.Text.StringBuilder
    $buf = New-Object byte[] 65536
    while ($true) {
        $n = $stream.Read($buf, 0, $buf.Length)
        if ($n -le 0) { break }
        $chunk = $buf[0..($n-1)]
        $nullAt = [Array]::IndexOf($chunk, [byte]0)
        if ($nullAt -ge 0) {
            if ($nullAt -gt 0) {
                [void]$sb.Append([System.Text.Encoding]::UTF8.GetString($chunk[0..($nullAt-1)]))
            }
            break
        }
        [void]$sb.Append([System.Text.Encoding]::UTF8.GetString($chunk))
    }
    $sb.ToString()
}
finally {
    $client.Close()
}
