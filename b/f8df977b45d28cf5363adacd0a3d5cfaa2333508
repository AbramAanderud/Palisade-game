using System.Collections.Generic;
using System.Linq;
using Godot;

/// test/TestGateSync.cs
///
/// Headless proof for the multiplayer gate-destruction desync fix.
///
/// Bug: ShootingGateNode.Open() only ever mutated the shooter's own scene —
/// there was no outbound message, so the opponent's client kept the gate
/// visible AND solid. The shooter could then fire through the now-open gap
/// while the victim still saw (and trusted) an intact wall.
///
/// Fix: ShootingGateNode.Destroyed fires (with its deterministic NetId) only
/// for a REAL local shot; OnlineDungeonArena.WireGateRelay forwards that as
/// {"t":"gate_down","id":...} down the same relay send path as "hit"/"shot"/
/// etc.; OnlineDungeonArena.ApplyRemoteGateDown (static, root-parameterized —
/// no live NetworkManager needed) replays it as gate.RemoteOpen(), which does
/// the identical visual+collision removal WITHOUT re-raising Destroyed (no
/// echo loop).
///
/// This test builds two independent gates through TrapBehaviours.Decorate —
/// the exact call the real dungeon uses — under builders named "MazeA" like
/// BuildArena does, standing in for "client A's own copy" and "client B's
/// mirrored copy" of the identical maze. It never touches NetworkManager or
/// the WebSocket relay; the seam under test is the plain (Node root, string id)
/// pair that crosses that boundary.
public partial class TestGateSync : Node
{
    int _fail;
    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + label);
        if (!ok) _fail++;
    }

    // Builds one gate, wired up exactly like AddGate does inside a real dungeon
    // build, parented under a builder named `side` ("MazeA" in both stand-ins —
    // the two clients build the identical maze into identically-named builders).
    static ShootingGateNode BuildGate(Node testRoot, string side, out DungeonBuilder builder)
    {
        builder = new DungeonBuilder { Name = side };
        testRoot.AddChild(builder);
        var body   = new StaticBody3D();
        testRoot.AddChild(body);
        var lookup = new Dictionary<(int, int, int), MazePiece>();

        var piece = new MazePiece { Type = PieceType.TrapGate, X = 3, Y = 5, Floor = 0, Rotation = 0 };
        TrapBehaviours.Decorate(builder, body, piece, 0f, lookup);

        ShootingGateNode? gate = null;
        foreach (var c in builder.GetChildren())
            if (c is ShootingGateNode g) { gate = g; break; }
        return gate!;
    }

    static bool WallSolid(ShootingGateNode gate) =>
        gate.Wall != null && gate.Wall.Visible &&
        gate.Wall.GetChildren().OfType<CollisionShape3D>().All(cs => !cs.Disabled);

    static bool WallGone(ShootingGateNode gate) =>
        gate.Wall != null && !gate.Wall.Visible &&
        gate.Wall.GetChildren().OfType<CollisionShape3D>().All(cs => cs.Disabled);

    static bool TargetsGone(ShootingGateNode gate) =>
        gate.GetChildren().OfType<ShootableTargetNode>()
            .All(t => t.GetChildren().OfType<CollisionShape3D>().All(cs => cs.Disabled) && !t.Visible);

    public override void _Ready()
    {
        GD.Print("── Gate NetId: deterministic and side-qualified ──");
        {
            // Two SEPARATE roots — standing in for two SEPARATE client processes,
            // each independently building its own "MazeA" from the identical
            // maze JSON (as OnlineDungeonArena.BuildArena does on each machine).
            // Godot auto-renames a second SIBLING with a duplicate requested
            // name (e.g. "MazeA2"), so this property only holds — and only
            // should hold — across independent trees, never within one.
            var clientA = new Node();
            var clientB = new Node();
            AddChild(clientA);
            AddChild(clientB);
            var gateA1 = BuildGate(clientA, "MazeA", out _);
            var gateA2 = BuildGate(clientB, "MazeA", out _);
            var gateB  = BuildGate(clientB, "MazeB", out _);

            Check(gateA1.NetId == "MazeA/ShootingGate_3_5_0", "NetId is \"{maze}/{gate name}\"");
            Check(gateA1.NetId == gateA2.NetId,
                  "identical piece coords on identically-named builders, built on two INDEPENDENT " +
                  "trees, produce the SAME id — this is what makes it valid across two real clients");
            Check(gateA2.NetId != gateB.NetId, "different maze side changes the id (A vs B do not collide)");

            RemoveChild(clientA); clientA.Free();
            RemoveChild(clientB); clientB.Free();
        }

        GD.Print("── Local destruction fires Destroyed exactly once, with the right id ──");
        {
            var root = new Node();
            AddChild(root);
            var gate = BuildGate(root, "MazeA", out _);

            var fired = new List<string>();
            gate.Destroyed += id => fired.Add(id);

            var targets = gate.GetChildren().OfType<ShootableTargetNode>().ToList();
            Check(targets.Count == 3, "gate mounts three targets");

            targets[0].OnShot(Vector3.Zero);
            targets[1].OnShot(Vector3.Zero);
            Check(fired.Count == 0, "Destroyed has not fired before the third target");

            targets[2].OnShot(Vector3.Zero);
            Check(fired.Count == 1, "Destroyed fires exactly once when the third target opens the gate");
            Check(fired.Count > 0 && fired[0] == gate.NetId, "Destroyed carries this gate's NetId");
            Check(WallGone(gate) && TargetsGone(gate), "local destruction removes visual AND collision");

            // Re-shooting an already-shot target (idempotent locally) must not
            // re-fire Destroyed — this would be a second outbound message for
            // a gate the opponent already knows is down.
            targets[0].OnShot(Vector3.Zero);
            Check(fired.Count == 1, "re-shooting a spent target does not re-fire Destroyed");

            RemoveChild(root); root.Free();
        }

        GD.Print("── Remote replay: outbound message applied on the \"other\" client ──");
        {
            // Two independent trees standing in for client A's own world and
            // client B's mirrored copy of the identical maze — exactly what
            // OnlineDungeonArena.BuildArena produces on each machine.
            var localRoot  = new Node { Name = "LocalArena" };
            var remoteRoot = new Node { Name = "RemoteArena" };
            AddChild(localRoot);
            AddChild(remoteRoot);

            var localGate  = BuildGate(localRoot,  "MazeA", out _);
            var remoteGate = BuildGate(remoteRoot, "MazeA", out _);

            string? sentId = null;
            localGate.Destroyed += id => sentId = id;

            // The remote replay must not re-broadcast (no echo loop back across
            // the relay towards the original shooter). Attached BEFORE the
            // replay so it would actually catch a wrongly-firing Destroyed.
            bool remoteEchoed = false;
            remoteGate.Destroyed += _ => remoteEchoed = true;

            // Simulate the LOCAL player's real shot destroying the gate on
            // their own client (the existing, already-working half of the fix).
            foreach (var t in localGate.GetChildren().OfType<ShootableTargetNode>())
                t.OnShot(Vector3.Zero);

            Check(sentId != null, "local destruction produced an outbound gate_down id");
            Check(WallGone(localGate), "local client: gate is down (visual + collision)");
            Check(WallSolid(remoteGate), "remote client BEFORE the message: gate is still up (the bug)");

            // Feed the exact string that crossed the relay into the remote
            // side's handler — the same seam OnlineDungeonArena.OnGameData's
            // "gate_down" case drives.
            bool applied = OnlineDungeonArena.ApplyRemoteGateDown(remoteRoot, sentId!);
            Check(applied, "ApplyRemoteGateDown reports success for a known id");
            Check(WallGone(remoteGate) && TargetsGone(remoteGate),
                  "remote client AFTER the message: gate is down (visual AND collision) — fixed");
            Check(!remoteEchoed, "RemoteOpen never raises Destroyed — no echo back across the relay");

            RemoveChild(localRoot);  localRoot.Free();
            RemoveChild(remoteRoot); remoteRoot.Free();
        }

        GD.Print("── Unknown id: dropped safely, never crashes ──");
        {
            var root = new Node();
            AddChild(root);
            BuildGate(root, "MazeA", out _);

            bool applied = OnlineDungeonArena.ApplyRemoteGateDown(root, "MazeA/ShootingGate_99_99_0");
            Check(!applied, "an id naming a gate that was never built reports failure, not a crash");

            bool appliedGarbage = OnlineDungeonArena.ApplyRemoteGateDown(root, "not/a/real/path/at/all");
            Check(!appliedGarbage, "a nonsense path also reports failure rather than throwing");

            // Arrival-race stand-in: a root with no maze built at all yet
            // (mirrors a "gate_down" arriving before TryBuildArenaAndSpawn ran).
            var emptyRoot = new Node();
            AddChild(emptyRoot);
            bool appliedEmpty = OnlineDungeonArena.ApplyRemoteGateDown(emptyRoot, "MazeA/ShootingGate_3_5_0");
            Check(!appliedEmpty, "a gate_down arriving before the maze exists is dropped, not a crash");

            RemoveChild(root);      root.Free();
            RemoveChild(emptyRoot); emptyRoot.Free();
        }

        GD.Print("── Duplicate delivery: idempotent ──");
        {
            var root = new Node();
            AddChild(root);
            var gate = BuildGate(root, "MazeA", out _);
            string id = gate.NetId!;

            bool first  = OnlineDungeonArena.ApplyRemoteGateDown(root, id);
            Check(first, "first gate_down for this id applies");
            Check(WallGone(gate), "gate is down after the first delivery");

            bool second = OnlineDungeonArena.ApplyRemoteGateDown(root, id);
            Check(second, "a duplicate gate_down for an already-open gate still resolves the node " +
                          "(found, just already open) rather than erroring");
            Check(WallGone(gate), "gate is still (only) down after the duplicate — no double-toggle, no crash");

            RemoveChild(root); root.Free();
        }

        GD.Print(_fail == 0 ? "RESULT OK" : $"RESULT {_fail} FAILURE(S)");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
