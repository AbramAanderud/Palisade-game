using Godot;

/// Minimal probe: white plate at y=13.9 (hallway-ceiling height), omni 2m
/// below it, camera looking straight up. If the plate renders bright, high
/// omnis are fine and the hallway ceilings are dark for another reason.
public partial class TestLightProbe : Node3D
{
    public override void _Ready()
    {
        AddChild(new WorldEnvironment { Environment = new Godot.Environment {
            BackgroundMode = Godot.Environment.BGMode.Color, BackgroundColor = Colors.Black,
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor = new Color(0.5f,0.5f,0.5f), AmbientLightEnergy = 0.12f,
            TonemapMode = Godot.Environment.ToneMapper.Filmic, TonemapExposure = 1.1f } });

        // the REAL hallway module, not a synthetic plate — camera will look at
        // ITS ceiling. Loaded exactly the way HallwayDemo loads it.
        var gltf = new GltfDocument(); var st = new GltfState();
        gltf.AppendFromFile(ProjectSettings.GlobalizePath("res://assets/glb/hallways/hall_office.glb"), st);
        var node = gltf.GenerateScene(st);
        // EXACTLY the demo's path: pack, then instantiate the PackedScene.
        var packed = new PackedScene(); packed.Pack(node);
        var inst = packed.Instantiate<Node3D>();
        inst.Position = new Vector3(0, 0, 5f);
        AddChild(inst);

        // hallway-like condition: a long row of overlapping-volume lights.
        // If the plates go dark as the count rises, the compat renderer is
        // dropping lights per object and the demo's overlapping ranges are the
        // real culprit behind the black ceilings.
        // full-demo light census: ~56 omnis in overlapping rows. The 12-light
        // probe stayed bright; if THIS goes dark, the compat renderer is
        // silently dropping per-object lights once too many volumes intersect.
        int made = 0;
        for (int row = 0; row < 6; row++)
            for (int i = 0; i < 9; i++)
            {
                AddChild(new OmniLight3D { Position = new Vector3(0, 11.9f, -row * 36f - i * 3.3f),
                    LightEnergy = 2.8f, OmniRange = 18f, OmniAttenuation = 0.9f, ShadowEnabled = false });
                made++;
            }
        GD.Print($"[probe] lights={made}");

        // control: identical plate at y=9.9, TOP face 2m BELOW the same light
        var plate2 = new MeshInstance3D { Mesh = new BoxMesh { Size = new Vector3(6f, 0.1f, 6f) },
            Position = new Vector3(0, 9.9f, 0),
            MaterialOverride = new StandardMaterial3D { AlbedoColor = new Color(0.88f,0.88f,0.86f) } };
        AddChild(plate2);

        // demo-identical viewpoint: eye level, slight up-tilt, ceiling seen
        // 10-30m away — vs the close-up that has been reading bright.
        _cam = new Camera3D { Position = new Vector3(0, 1.6f, 3.0f), Fov = 80f };
        AddChild(_cam); _cam.MakeCurrent();
    }

    Camera3D _cam = null!;
    int _f;
    public override void _Process(double delta)
    {
        _cam.RotationDegrees = new Vector3(_f < 2 ? 5.7f : 80f, 0, 0);  // demo tilt, then near-vertical
        _f++;
    }
}
