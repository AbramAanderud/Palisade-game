using Godot;

/// test/TestKnifeDash.cs
/// Drives a REAL PlayerController (in the tree, on a floor, real physics) to
/// prove the knife's right-click air dash follows its rules:
///
///   1. on the ground it does nothing (slide is the ground burst);
///   2. with a gun out it does nothing (knife only);
///   3. in the air with the knife it bursts ~6.6 m along the look direction;
///      from a standstill it exits at the 16 m/s bhop ceiling;
///   4. one charge — a second press straight after does nothing;
///   5. landing does NOT refill it; the charge returns on a ~2.5 s timer;
///   6. the first-person left arm collapses only while the knife is out;
///   7. the dash only ever ADDS speed: fast + straight exits faster, a
///      sideways dash redirects without bleeding speed, a flat dash keeps a
///      trampoline rise, and rocket-jump speed is never cut;
///   8. the lunge pose is up by the end of the burst and gone soon after.
///
/// RequestDash() is the same flag the right-click input sets, so this runs
/// headless without faking mouse events.
public partial class TestKnifeDash : Node3D
{
    PlayerController _p = null!;
    int     _f, _fail;
    int     _step = 0;
    Vector3 _start;
    int     _launchF, _floorF;

    OneHandArmPose? OneHand => _p.FindChild("OneHandArmPose", true, false) as OneHandArmPose;

    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + label);
        if (!ok) _fail++;
    }

    public override void _Ready()
    {
        var floor = new StaticBody3D { Name = "Floor" };
        floor.AddChild(new CollisionShape3D
        {
            Shape = new BoxShape3D { Size = new Vector3(400f, 1f, 400f) },
        });
        AddChild(floor);
        floor.GlobalPosition = new Vector3(0f, -0.5f, 0f);

        _p = new PlayerController { Name = "Player" };
        AddChild(_p);
        _p.GlobalPosition = new Vector3(0f, 1.0f, 0f);
    }

    static float Horiz(Vector3 v) => new Vector3(v.X, 0f, v.Z).Length();

    // Speed rules: exit = max(entry + 4, 16), bonus limited to 36, never cut.
    int _case;
    static readonly (string name, Vector3 entry, float minH, float minY)[] Cases =
    {
        ("fast + straight",   new Vector3(0f, 0f, -24f),  28f, -1000f),
        ("fast + sideways",   new Vector3(20f, 0f, 0f),   24f, -1000f),
        ("trampoline rise",   new Vector3(0f, 30f, -8f),  16f, 28f),
        ("rocket-jump speed", new Vector3(0f, 0f, -50f),  50f, -1000f),
    };

    void Finish()
    {
        GD.Print(_fail == 0 ? "RESULT OK" : $"RESULT {_fail} FAILURE(S)");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }

    public override void _PhysicsProcess(double delta)
    {
        _f++;
        if (_f > 2400) { Check(false, $"timed out at step {_step}"); Finish(); return; }

        switch (_step)
        {
            case 0:   // arm the player, knife out, let it settle on the floor
                if (_f == 5) { _p.EquipStarterGun("pew"); _p.SelectMelee(); }
                if (_f >= 40 && _p.IsOnFloor())
                {
                    Check(_p.KnifeOut, "knife is out after SelectMelee");
                    _p.RequestDash();
                    _step = 1;
                }
                break;

            case 1:
                Check(!_p.IsDashing, "grounded: no dash");
                // Teleport high, gun out.
                _p.GlobalPosition = new Vector3(0f, 60f, 0f);
                _p.Velocity       = Vector3.Zero;
                _p.SelectSecondary();
                _step = 2;
                break;

            case 2:
                _p.RequestDash();
                _step = 3;
                break;

            case 3:
                Check(!_p.IsDashing, "airborne with a gun out: no dash");
                _p.SelectMelee();
                _step = 4;
                break;

            case 4:
                Check(_p.DashReady, "airborne with the knife: charge is ready");
                Check(OneHand?.Active == true, "knife out: first-person left arm collapsed (one-handed)");
                _start   = _p.GlobalPosition;
                _launchF = _f;
                _p.RequestDash();
                _step = 5;
                break;

            case 5:
                Check(_p.IsDashing, "airborne with the knife: dash starts");
                _step = 6;
                break;

            case 6:   // wait for the burst to end
                if (_p.IsDashing) break;
                var d = _p.GlobalPosition - _start;
                Check(Horiz(d) >= 6.0f, $"burst covers >= 6.0 m (got {Horiz(d):F2})");
                Check(-d.Z > 0.95f * Horiz(d), $"burst goes along the look (-Z) (d={d})");
                Check(Mathf.Abs(Horiz(_p.Velocity) - 16f) < 0.3f,
                      $"from a standstill, exit speed is the 16 m/s ceiling (got {Horiz(_p.Velocity):F2})");
                Check(_p.DashLunge > 0.8f, $"lunge pose is up at the end of the burst ({_p.DashLunge:F2})");
                _p.RequestDash();
                _step = 7;
                break;

            case 7:
                Check(!_p.IsDashing && !_p.DashReady, "second air dash is refused (one charge)");
                // Put them on the floor: landing must NOT refill the charge.
                _p.GlobalPosition = new Vector3(0f, 1f, 0f);
                _p.Velocity       = Vector3.Zero;
                _floorF = _f;
                _step = 8;
                break;

            case 8:   // grounded for a moment — still recharging
                if (_f - _floorF < 15) break;
                if (_f - _floorF < 30) break;
                Check(_p.DashLunge < 0.05f, $"lunge pose eased out ({_p.DashLunge:F2})");
                Check(_p.IsOnFloor() && !_p.DashReady && _p.DashRecharging,
                      "landing does not refill the charge (still recharging)");
                _step = 9;
                break;

            case 9:   // wait for the timer
                if (!_p.DashReady) break;
                float secs = (_f - _launchF) / 60f;
                Check(Mathf.Abs(secs - GunCombat.Defs[GunCombat.KnifeId].DashRecharge) < 0.1f,
                      $"charge returns on the timer ({secs:F2} s)");
                _case = 0;
                _step = 20;
                break;

            // ── The dash only adds speed ────────────────────────────────────
            // Each case: airborne, a given entry velocity, look along -Z, dash,
            // then check the velocity it hands back. Waits out the recharge.
            case 20:
                if (!_p.DashReady) break;
                if (_case >= Cases.Length) { _p.SelectSecondary(); _step = 10; break; }
                _p.GlobalPosition = new Vector3(0f, 80f, 0f);
                _p.Velocity       = Cases[_case].entry;
                _step = 23;   // one physics frame so IsOnFloor() clears
                break;

            case 23:
                _p.Velocity = Cases[_case].entry;   // undo that frame's gravity/drag
                _p.RequestDash();
                _step = 21;
                break;

            case 21:
                Check(_p.IsDashing && _p.Velocity.Length() >= Cases[_case].entry.Length() - 0.01f,
                      $"{Cases[_case].name}: burst is never slower than entry ({_p.Velocity.Length():F1} m/s)");
                _step = 22;
                break;

            case 22:
                if (_p.IsDashing) break;
                var v = _p.Velocity;
                var (name, entry, minH, minY) = Cases[_case];
                Check(Horiz(v) >= minH - 0.05f, $"{name}: exit {Horiz(v):F2} m/s >= {minH:F2}");
                Check(-v.Z >= 0.95f * Horiz(v), $"{name}: exit heads along the look (-Z) (v={v})");
                if (minY > -999f)
                    Check(v.Y >= minY, $"{name}: keeps the rise (vy {v.Y:F1} >= {minY:F1})");
                _case++;
                _step = 20;
                break;

            case 10:
                Check(OneHand?.Active == false, "gun out: both arms back");
                Finish();
                break;
        }
    }
}
