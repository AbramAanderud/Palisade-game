using Godot;
using System.Collections.Generic;
using System.Text.Json;

/// res://scenes/FfaPreGameLobby.cs — 3–4 player FFA pre-game screen.
/// One card per party seat: name, HOST/YOU tags, maze pick, ready state. Every
/// member broadcasts its own pick + ready flag as party game data (the relay
/// stamps `from` = sender seat); the host invites lobby players and presses
/// START once FfaPartyInfo.CanStart holds. The relay's ffa_start moves everyone
/// to OnlineFfaArena. The 1v1 flow (PreGameLobby) is untouched.
public partial class FfaPreGameLobby : Control
{
    /// Raw party_created / party_joined JSON, set by whoever changes to this scene.
    public static string PendingInfoJson = "";

    static readonly Color LocalAccent = new(0.45f, 0.85f, 1.0f);
    static readonly Color ReadyGreen  = new(0.3f, 1f, 0.5f);
    static readonly Color Grey        = new(0.55f, 0.55f, 0.55f);
    static readonly Color DimGrey     = new(0.5f, 0.5f, 0.5f);
    static readonly Color HostGold    = new(1.0f, 0.8f, 0.35f);
    const double InviteTimeoutSeconds = 30.0;

    NetworkManager     _nm = null!;
    FontFile?          _font;
    AudioStreamPlayer? _clickSfx;

    FfaPartyInfo _party = new();
    readonly Dictionary<int, string> _pickText = new();
    readonly HashSet<int> _ready = new();
    bool _localReady, _changingScene;
    readonly Dictionary<string, SceneTreeTimer> _invitePending = new();

    sealed class SeatCard
    {
        public Label Name = null!, Tags = null!;
        public Label Maze = null!, Status = null!;   // other seats only; the local card has the picker + READY
    }
    readonly List<SeatCard> _cards = new();

    OptionButton  _mazeDropdown = null!;
    Button        _readyBtn     = null!;
    Button        _startBtn     = null!;
    Label         _statusLabel  = null!;
    VBoxContainer _inviteBox    = null!;
    VBoxContainer _inviteList   = null!;

    // ── Test accessors ────────────────────────────────────────────────────────
    public int MySeat { get; private set; } = -1;
    public string SeatNameText(int seat) =>
        seat >= 0 && seat < _cards.Count ? _cards[seat].Name.Text : "";
    public string SeatMazeText(int seat) =>
        !_party.Has(seat) ? "" : _pickText.TryGetValue(seat, out var t) ? t : "Selecting…";
    public bool SeatReady(int seat) => _ready.Contains(seat);
    public bool StartVisible => _startBtn.Visible;
    public bool StartEnabled => _startBtn.Visible && !_startBtn.Disabled;

    // ── Test hooks (same handlers the buttons use) ────────────────────────────
    public void SelectMazeForTest(int slot)
    {
        for (int i = 0; i < _mazeDropdown.ItemCount; i++)
            if (_mazeDropdown.GetItemId(i) == slot) { _mazeDropdown.Select(i); OnMazeSelected(i); return; }
        GD.PushWarning($"[FFA LOBBY] SelectMazeForTest: slot {slot} not in picker");
    }
    public void PressReadyForTest() => OnReadyPressed();
    public void PressStartForTest() => OnStartPressed();

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    public override void _Ready()
    {
        Input.MouseMode = Input.MouseModeEnum.Visible;
        _font = GD.Load<FontFile>("res://assets/fonts/Agmena Pro Book.ttf");
        _clickSfx = new AudioStreamPlayer();
        var clickSnd = GD.Load<AudioStream>("res://assets/audio/ui/MenuButtonClick.wav");
        if (clickSnd != null) _clickSfx.Stream = clickSnd;
        AddChild(_clickSfx);

        try { _party = FfaPartyInfo.Parse(PendingInfoJson); }
        catch (System.Exception e) when (e is JsonException || e is System.InvalidOperationException || e is System.ArgumentException)
        {
            _party = new FfaPartyInfo();
        }
        MySeat = _party.Seat;
        if (MySeat < 0)
        {
            GD.PushError("[FFA LOBBY] PendingInfoJson missing/invalid (no seat); returning to PlayGameScreen");
            Callable.From(() => GetTree().ChangeSceneToFile("res://scenes/PlayGameScreen.tscn")).CallDeferred();
            return;
        }

        _nm = GetNode<NetworkManager>("/root/NetworkManager");
        _nm.PartyUpdated      += OnPartyUpdated;
        _nm.FfaStarted        += OnFfaStarted;
        _nm.GameDataReceived  += OnGameData;
        _nm.LobbyUpdated      += OnLobbyUpdated;
        _nm.PartyDeclined     += OnPartyDeclined;
        _nm.PartyInviteFailed += OnPartyInviteFailed;
        _nm.PartyError        += OnPartyError;
        _nm.ConnectionFailed  += OnConnectionFailed;

        SetAnchorsPreset(LayoutPreset.FullRect);
        BuildUI();
        PopulateMazeDropdown();
        BroadcastMine();
        RenderInviteList(_nm.LastLobbyJson);
        Refresh();

        // A party_update may have arrived between party_joined and this scene loading.
        string last = _nm.LastPartyJson;
        if (last != "" && last != PendingInfoJson)
        {
            try
            {
                using var doc = JsonDocument.Parse(last);
                var r = doc.RootElement;
                if (r.TryGetProperty("type", out var tp) && tp.ValueKind == JsonValueKind.String && tp.GetString() == "party_update"
                    && r.TryGetProperty("code", out var cp) && cp.ValueKind == JsonValueKind.String && cp.GetString() == _party.Code)
                    OnPartyUpdated(last);
            }
            catch (System.Exception e) when (e is JsonException || e is System.InvalidOperationException) { }
        }
    }

    public override void _ExitTree()
    {
        if (_nm == null) return;
        _nm.PartyUpdated      -= OnPartyUpdated;
        _nm.FfaStarted        -= OnFfaStarted;
        _nm.GameDataReceived  -= OnGameData;
        _nm.LobbyUpdated      -= OnLobbyUpdated;
        _nm.PartyDeclined     -= OnPartyDeclined;
        _nm.PartyInviteFailed -= OnPartyInviteFailed;
        _nm.PartyError        -= OnPartyError;
        _nm.ConnectionFailed  -= OnConnectionFailed;
    }

    // ── UI ────────────────────────────────────────────────────────────────────

    void BuildUI()
    {
        var bg = new ColorRect { Color = Colors.Black };
        bg.SetAnchorsPreset(LayoutPreset.FullRect);
        AddChild(bg);

        var outer = new VBoxContainer();
        outer.SetAnchorsPreset(LayoutPreset.FullRect);
        outer.AddThemeConstantOverride("separation", 0);
        AddChild(outer);

        outer.AddChild(Spacer(48));
        outer.AddChild(MakeLabel("FREE FOR ALL", 64, Colors.White));
        outer.AddChild(Spacer(28));

        // ── Seat cards ───────────────────────────────────────────────────────
        var cardMargin = new MarginContainer { SizeFlagsVertical = SizeFlags.ExpandFill };
        foreach (var side in new[] { "margin_left", "margin_right" })
            cardMargin.AddThemeConstantOverride(side, 32);
        outer.AddChild(cardMargin);
        var row = new HBoxContainer { SizeFlagsHorizontal = SizeFlags.ExpandFill };
        row.AddThemeConstantOverride("separation", 16);
        cardMargin.AddChild(row);
        for (int s = 0; s < _party.Cap; s++)
            row.AddChild(BuildSeatCard(s));

        outer.AddChild(Spacer(16));

        // ── Host-only invite list ────────────────────────────────────────────
        _inviteBox = new VBoxContainer { SizeFlagsHorizontal = SizeFlags.ShrinkCenter };
        _inviteBox.AddThemeConstantOverride("separation", 8);
        _inviteBox.AddChild(MakeLabel("INVITE PLAYERS", 16, LocalAccent));
        var scroll = new ScrollContainer
        {
            CustomMinimumSize    = new Vector2(460, 140),
            HorizontalScrollMode = ScrollContainer.ScrollMode.Disabled,
        };
        _inviteList = new VBoxContainer { SizeFlagsHorizontal = SizeFlags.ExpandFill };
        _inviteList.AddThemeConstantOverride("separation", 6);
        scroll.AddChild(_inviteList);
        _inviteBox.AddChild(scroll);
        outer.AddChild(_inviteBox);

        // ── Status + START ───────────────────────────────────────────────────
        _statusLabel = MakeLabel("", 16, new Color(0.75f, 0.75f, 0.5f));
        _statusLabel.CustomMinimumSize = new Vector2(0, 28);
        outer.AddChild(_statusLabel);

        _startBtn = MakeButton("START", 26, new Vector2(260, 52));
        _startBtn.SizeFlagsHorizontal = SizeFlags.ShrinkCenter;
        _startBtn.AddThemeColorOverride("font_color", ReadyGreen);
        _startBtn.Pressed += OnStartPressed;
        outer.AddChild(_startBtn);
        outer.AddChild(Spacer(28));

        MenuUI.AddBackButton(this, _font, OnLeave);
    }

    Control BuildSeatCard(int seat)
    {
        var panel = new PanelContainer
        {
            SizeFlagsHorizontal = SizeFlags.ExpandFill,
            SizeFlagsVertical   = SizeFlags.ExpandFill,
        };
        bool mine = seat == MySeat;
        var box = new StyleBoxFlat
        {
            BgColor = new Color(0.06f, 0.06f, 0.06f),
            BorderColor = mine ? LocalAccent : new Color(0.25f, 0.25f, 0.25f),
        };
        box.SetBorderWidthAll(mine ? 2 : 1);
        box.SetContentMarginAll(14);
        panel.AddThemeStyleboxOverride("panel", box);

        var stack = new VBoxContainer { Alignment = BoxContainer.AlignmentMode.Center };
        stack.AddThemeConstantOverride("separation", 12);
        panel.AddChild(stack);

        var card = new SeatCard();
        card.Tags = MakeLabel("", 14, HostGold);
        card.Name = MakeLabel("Open seat", 28, Grey);
        card.Name.AutowrapMode = TextServer.AutowrapMode.WordSmart;
        stack.AddChild(card.Tags);
        stack.AddChild(card.Name);
        stack.AddChild(MakeLabel("MAZE", 13, DimGrey));

        if (mine)
        {
            _mazeDropdown = new OptionButton
            {
                CustomMinimumSize   = new Vector2(220, 40),
                SizeFlagsHorizontal = SizeFlags.ShrinkCenter,
                ClipText            = true,
            };
            if (_font != null) _mazeDropdown.AddThemeFontOverride("font", _font);
            _mazeDropdown.AddThemeFontSizeOverride("font_size", 15);
            _mazeDropdown.ItemSelected += idx => OnMazeSelected((int)idx);
            stack.AddChild(_mazeDropdown);

            _readyBtn = MakeButton("READY", 22, new Vector2(180, 46));
            _readyBtn.SizeFlagsHorizontal = SizeFlags.ShrinkCenter;
            _readyBtn.Pressed += OnReadyPressed;
            stack.AddChild(Spacer(4));
            stack.AddChild(_readyBtn);
        }
        else
        {
            card.Maze = MakeLabel("Selecting…", 18, Colors.White);
            card.Maze.AutowrapMode = TextServer.AutowrapMode.WordSmart;
            card.Status = MakeLabel("Not ready", 22, Grey);
            stack.AddChild(card.Maze);
            stack.AddChild(Spacer(4));
            stack.AddChild(card.Status);
        }
        _cards.Add(card);
        return panel;
    }

    void PopulateMazeDropdown()
    {
        _mazeDropdown.Clear();
        _mazeDropdown.AddItem(DefaultMaze.DisplayName, DefaultMaze.SentinelSlot);
        for (int i = 0; i < MazeSerializer.SlotCount; i++)
        {
            if (!MazeSerializer.Exists(i)) continue;
            var data = MazeSerializer.Load(i);
            if (data == null || !data.IsOnline || !data.IsGameReady) continue;
            _mazeDropdown.AddItem($"Slot {i}: {data.Name ?? "Untitled"}", i);
        }
        for (int i = 0; i < _mazeDropdown.ItemCount; i++)
            if (_mazeDropdown.GetItemId(i) == OnlineGameState.SelectedMazeSlot) { _mazeDropdown.Select(i); return; }
        _mazeDropdown.Select(0);
        OnlineGameState.SelectedMazeSlot = _mazeDropdown.GetItemId(0);
    }

    /// Re-applies model state (_party, _pickText, _ready, _localReady) to every widget.
    void Refresh()
    {
        bool isHost = MySeat == _party.HostSeat;
        for (int s = 0; s < _cards.Count; s++)
        {
            var c = _cards[s];
            bool taken = _party.Has(s);
            c.Name.Text = taken ? _party.NameAt(s) ?? "" : "Open seat";
            c.Name.AddThemeColorOverride("font_color", !taken ? Grey : s == MySeat ? LocalAccent : Colors.White);
            var tags = new List<string>();
            if (taken && s == _party.HostSeat) tags.Add("HOST");
            if (s == MySeat) tags.Add("YOU");
            c.Tags.Text = string.Join("  ·  ", tags);
            if (s == MySeat) continue;
            c.Maze.Visible = c.Status.Visible = taken;
            c.Maze.Text = SeatMazeText(s);
            bool r = _ready.Contains(s);
            c.Status.Text = r ? "READY" : "Not ready";
            c.Status.AddThemeColorOverride("font_color", r ? ReadyGreen : Grey);
        }

        int slot = OnlineGameState.SelectedMazeSlot;
        _mazeDropdown.Disabled = _localReady || _changingScene;
        _readyBtn.Text = _localReady ? "UNREADY" : "READY";
        _readyBtn.AddThemeColorOverride("font_color", _localReady ? Grey : ReadyGreen);
        _readyBtn.Disabled = _changingScene || IsInvalidSlot(slot);

        _startBtn.Visible  = isHost;
        _startBtn.Disabled = _changingScene || !FfaPartyInfo.CanStart(_party, _ready);
    }

    static bool IsInvalidSlot(int slot) => slot < 0 && slot != DefaultMaze.SentinelSlot;

    // ── Interactions ──────────────────────────────────────────────────────────

    void OnMazeSelected(int idx)
    {
        if (_localReady || _changingScene) return;
        _clickSfx?.Play();
        OnlineGameState.SelectedMazeSlot = _mazeDropdown.GetItemId(idx);
        BroadcastMine();
        Refresh();
    }

    void OnReadyPressed()
    {
        if (_changingScene || (!_localReady && IsInvalidSlot(OnlineGameState.SelectedMazeSlot))) return;
        _clickSfx?.Play();
        _localReady = !_localReady;
        BroadcastMine();
        Refresh();
    }

    void OnStartPressed()
    {
        if (_changingScene || MySeat != _party.HostSeat || !FfaPartyInfo.CanStart(_party, _ready)) return;
        _clickSfx?.Play();
        _nm.PartyStart();
        _startBtn.Disabled = true;
        _statusLabel.Text = "Starting…";
    }

    void OnLeave()
    {
        if (_changingScene) return;
        _changingScene = true;
        _clickSfx?.Play();
        _nm.PartyLeave();
        GetTree().ChangeSceneToFile("res://scenes/PlayGameScreen.tscn");
    }

    // ── Messages ──────────────────────────────────────────────────────────────

    void BroadcastMine()
    {
        int slot = OnlineGameState.SelectedMazeSlot;
        string name = slot == DefaultMaze.SentinelSlot ? DefaultMaze.DisplayName : (MazeSerializer.Load(slot)?.Name ?? "Untitled");
        _nm.SendGameData($"{{\"t\":\"pick\",\"slot\":{slot},\"name\":{JsonSerializer.Serialize(name)}}}");
        _nm.SendGameData($"{{\"t\":\"ready\",\"on\":{(_localReady ? "true" : "false")}}}");
        // mirror into local state so our own card uses the same code path
        _pickText[MySeat] = PickLabel(slot, name);
        if (_localReady) _ready.Add(MySeat); else _ready.Remove(MySeat);
    }

    static string PickLabel(int slot, string name) => slot == DefaultMaze.SentinelSlot ? name : $"{name} (Slot {slot})";

    void OnGameData(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            var r = doc.RootElement;
            if (r.ValueKind != JsonValueKind.Object) return;
            if (!r.TryGetProperty("from", out var fp) || fp.ValueKind != JsonValueKind.Number || !fp.TryGetInt32(out int from)) return;
            if (!r.TryGetProperty("t", out var tp) || tp.ValueKind != JsonValueKind.String) return;
            switch (tp.GetString())
            {
                case "pick":
                    if (!r.TryGetProperty("slot", out var sp) || !sp.TryGetInt32(out int slot)) return;
                    string name = r.TryGetProperty("name", out var np) && np.ValueKind == JsonValueKind.String
                        ? np.GetString() ?? "Untitled" : "Untitled";
                    _pickText[from] = PickLabel(slot, name);
                    break;
                case "ready":
                    bool on = r.TryGetProperty("on", out var op) && op.ValueKind == JsonValueKind.True;
                    if (on) _ready.Add(from); else _ready.Remove(from);
                    break;
                default: return;
            }
        }
        catch (System.Exception e) when (e is JsonException || e is System.InvalidOperationException) { return; }
        Refresh();
    }

    void OnPartyUpdated(string json)
    {
        _party = FfaPartyInfo.Parse(json);   // party_update carries no seat; MySeat is kept
        foreach (var s in new List<int>(_pickText.Keys)) if (!_party.Has(s)) _pickText.Remove(s);
        _ready.RemoveWhere(s => !_party.Has(s));
        foreach (var e in _party.Roster) _invitePending.Remove(e.Id);   // invite answered by joining
        BroadcastMine();
        RenderInviteList(_nm.LastLobbyJson);
        Refresh();
    }

    void OnFfaStarted(string json)
    {
        if (_changingScene) return;
        var info = FfaPartyInfo.Parse(json);
        OnlineGameState.IsFfa             = true;
        OnlineGameState.FfaSeat           = info.Seat;
        OnlineGameState.FfaHostSeat       = info.HostSeat;
        OnlineGameState.FfaRoster         = info.Roster;
        OnlineGameState.RoomCode          = info.Code;
        OnlineGameState.FfaRotationOffset = 1;
        _changingScene = true;
        GetTree().ChangeSceneToFile("res://scenes/OnlineFfaArena.tscn");
    }

    void OnPartyError(string reason)
    {
        if (reason == "started") return;   // already starting; leave status and START alone
        _statusLabel.Text = reason == "too_few" ? "Need at least 3 players" : reason;
        _startBtn.Disabled = _changingScene || !FfaPartyInfo.CanStart(_party, _ready);
    }

    void OnConnectionFailed(string reason)
    {
        if (_changingScene) return;
        _changingScene = true;
        _statusLabel.Text = "Connection lost";
        Refresh();   // _changingScene disables picker / READY / START
        RenderInviteList(_nm.LastLobbyJson);   // rows render disabled while _changingScene
        GetTree().CreateTimer(2.0).Timeout += () =>
        {
            if (IsInstanceValid(this)) GetTree().ChangeSceneToFile("res://scenes/PlayGameScreen.tscn");
        };
    }

    // ── Invites (host only) ───────────────────────────────────────────────────

    void OnLobbyUpdated(string json) => RenderInviteList(json);

    void RenderInviteList(string lobbyJson)
    {
        bool isHost = MySeat == _party.HostSeat;
        _inviteBox.Visible = isHost;
        foreach (var child in _inviteList.GetChildren()) { _inviteList.RemoveChild(child); child.QueueFree(); }
        if (!isHost) return;

        int rows = 0;
        if (!string.IsNullOrEmpty(lobbyJson))
        {
            try
            {
                using var doc = JsonDocument.Parse(lobbyJson);
                if (doc.RootElement.TryGetProperty("players", out var arr) && arr.ValueKind == JsonValueKind.Array)
                    foreach (var p in arr.EnumerateArray())
                    {
                        string id   = p.TryGetProperty("id", out var ip) ? ip.GetString() ?? "" : "";
                        string name = p.TryGetProperty("name", out var np) ? np.GetString() ?? "Unknown" : "Unknown";
                        bool busy   = p.TryGetProperty("busy", out var bp) && bp.ValueKind == JsonValueKind.True;
                        if (id == "" || busy || _party.Roster.Exists(e => e.Id == id)) continue;
                        AddInviteRow(id, name);
                        rows++;
                    }
            }
            catch (System.Exception e) when (e is JsonException || e is System.InvalidOperationException) { }
        }
        if (rows == 0)
            _inviteList.AddChild(MakeLabel("No free players online right now.", 15, DimGrey));
    }

    void AddInviteRow(string id, string name)
    {
        var row = new HBoxContainer();
        row.AddThemeConstantOverride("separation", 16);
        var lbl = MakeLabel(name, 18, Colors.White);
        lbl.HorizontalAlignment = HorizontalAlignment.Left;
        lbl.SizeFlagsHorizontal = SizeFlags.ExpandFill;
        row.AddChild(lbl);

        bool pending = _invitePending.ContainsKey(id);
        var btn = MakeButton(pending ? "Invited…" : "Invite", 16, new Vector2(120, 36));
        btn.Disabled = pending || _changingScene;
        btn.Pressed += () => OnInvitePressed(id, name, btn);
        row.AddChild(btn);
        _inviteList.AddChild(row);
    }

    void OnInvitePressed(string id, string name, Button btn)
    {
        if (_changingScene || _invitePending.ContainsKey(id)) return;
        _clickSfx?.Play();
        _nm.PartyInvite(id);
        btn.Text = "Invited…";
        btn.Disabled = true;
        var timer = GetTree().CreateTimer(InviteTimeoutSeconds);
        _invitePending[id] = timer;
        timer.Timeout += () =>
        {
            if (!IsInstanceValid(this)) return;
            // Only if this exact invite is still outstanding (not answered / re-sent).
            if (!_invitePending.TryGetValue(id, out var t) || t != timer) return;
            ClearInvite(id, $"{name} didn't respond");
        };
    }

    void OnPartyDeclined(string targetId, string name) => ClearInvite(targetId, $"{name} declined");

    void OnPartyInviteFailed(string targetId, string reason)
    {
        if (string.IsNullOrEmpty(targetId)) return;   // invitee-side failure; not ours
        ClearInvite(targetId, $"Couldn't invite: {reason}");
    }

    void ClearInvite(string id, string status)
    {
        _invitePending.Remove(id);
        _statusLabel.Text = status;
        RenderInviteList(_nm.LastLobbyJson);
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    static Control Spacer(float h) => new() { CustomMinimumSize = new Vector2(0, h) };

    Label MakeLabel(string text, int size, Color color)
    {
        var lbl = new Label { Text = text, HorizontalAlignment = HorizontalAlignment.Center };
        if (_font != null) lbl.AddThemeFontOverride("font", _font);
        lbl.AddThemeFontSizeOverride("font_size", size);
        lbl.AddThemeColorOverride("font_color", color);
        return lbl;
    }

    Button MakeButton(string text, int size, Vector2 minSize)
    {
        var btn = new Button { Text = text, CustomMinimumSize = minSize };
        if (_font != null) btn.AddThemeFontOverride("font", _font);
        btn.AddThemeFontSizeOverride("font_size", size);
        return btn;
    }
}
