using Godot;

/// test/TestKnifeCapture.cs
/// Windowed visual check for the knife: saves four screenshots to
/// screenshots/knife/ — knife ready (pip lit), mid-stab, mid-dash (pip spent,
/// FOV kick), and third person (hand model). Not an assertion test; run it
/// windowed (on the monitor NOT running League) and look at the PNGs.
public partial class TestKnifeCapture : Node3D
{
    PlayerController _p = null!;
    int _f;
    const string Out = "res://screenshots/knife/";

    public override void _Ready()
    {
        DirAccess.MakeDirRecursiveAbsolute(ProjectSettings.GlobalizePath(Out));

        AddChild(new WorldEnvironment
        {
            Environment = new Godot.Environment
            {
                BackgroundMode     = Godot.Environment.BGMode.Color,
                BackgroundColor    = new Color(0.05f, 0.05f, 0.07f),
                AmbientLightSource = Godot.Environment.AmbientSource.Color,
                AmbientLightColor  = new Color(0.55f, 0.52f, 0.48f),
                AmbientLightEnergy = 0.6f,
            },
        });
        var sun = new DirectionalLight3D { LightEnergy = 1.4f };
        AddChild(sun);
        sun.RotationDegrees = new Vector3(-50f, 30f, 0f);

        Box(new Vector3(0f, -0.5f, 0f), new Vector3(60f, 1f, 60f), new Color(0.25f, 0.23f, 0.21f));
        Box(new Vector3(0f, 2f, -8f),   new Vector3(12f, 5f, 1f),  new Color(0.35f, 0.32f, 0.29f));

        _p = new PlayerController { Name = "Player" };
        AddChild(_p);
        _p.GlobalPosition = new Vector3(0f, 1f, 0f);
    }

    void Box(Vector3 pos, Vector3 size, Color col)
    {
        var b = new StaticBody3D();
        b.AddChild(new CollisionShape3D { Shape = new BoxShape3D { Size = size } });
        var mi = new MeshInstance3D { Mesh = new BoxMesh { Size = size } };
        mi.SetSurfaceOverrideMaterial(0, new StandardMaterial3D { AlbedoColor = col, Roughness = 1f });
        b.AddChild(mi);
        AddChild(b);
        b.GlobalPosition = pos;
    }

    void Debug()
    {
        var held = _p.FindChild("HeldWeapon", true, false) as Node3D;
        var cam  = GetViewport().GetCamera3D();
        GD.Print($"[KnifeDbg] held={held != null} vis={held?.IsVisibleInTree()} pos={held?.GlobalPosition} cam={cam?.GlobalPosition}");
        if (held == null) return;
        void Walk(Node n)
        {
            if (n is MeshInstance3D mi)
                GD.Print($"[KnifeDbg]   mesh {mi.Name} vis={mi.IsVisibleInTree()} layers={mi.Layers} aabb={mi.GlobalTransform * mi.GetAabb()} scale={mi.GlobalTransform.Basis.Scale}");
            else if (n is Node3D n3)
                GD.Print($"[KnifeDbg]   node {n3.Name} scale={n3.Scale} rot={n3.RotationDegrees}");
            foreach (Node c in n.GetChildren()) Walk(c);
        }
        Walk(held);
    }

    void Shot(string name)
    {
        var img = GetViewport().GetTexture().GetImage();
        img.SavePng(ProjectSettings.GlobalizePath(Out + name));
        GD.Print($"[KnifeCapture] saved {name}");
    }

    // Counted in RENDERED frames: during load catch-up several physics steps run
    // per draw, so physics-frame timing can grab the same image twice.
    public override void _Process(double delta)
    {
        _f++;
        switch (_f)
        {
            case 5:   _p.EquipStarterGun("pew"); break;
            case 60:  Shot("0_fp_pew_compare.png"); _p.SelectMelee(); break;
            case 89:  Debug(); break;
            case 90:  Shot("1_fp_ready.png"); break;
            case 91:  _p.Gun?.RequestAttack(); break;
            case 92:  Shot("2a_fp_stab_early.png"); break;
            case 93:  GD.Print($"[KnifeCapture] after stab: FireCycle={_p.Gun?.FireCycle:F2} melee={_p.Gun?.IsMelee}"); break;
            case 95:  Shot("2_fp_stab.png"); break;
            case 120: _p.GlobalPosition = new Vector3(0f, 5f, 4f); _p.Velocity = Vector3.Zero; break;
            case 123: _p.RequestDash(); break;
            case 127: Shot("3_fp_dash.png"); break;
            case 170: Shot("3b_fp_recharging_ring.png"); break;
            case 200:
                Input.ParseInputEvent(new InputEventAction { Action = "toggle_camera", Pressed = true });
                break;
            case 202:
                Input.ParseInputEvent(new InputEventAction { Action = "toggle_camera", Pressed = false });
                break;
            case 260: Shot("4_tp_knife.png"); break;
            case 265: GetTree().Quit(); break;
        }
    }
}
