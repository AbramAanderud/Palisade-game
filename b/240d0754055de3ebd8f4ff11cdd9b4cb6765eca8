using System.Collections.Generic;
using Godot;

/// test/TestRoomStairLandingCapture.cs
/// Before/after screenshots for TestRoomStairLanding's StairsUp case: a room on
/// F1 at the top end of a StairsUp from F0. Frame 0: from inside the room
/// looking at the landing. Frames 1+: from the stair's foot looking up (the
/// room wall faces inward, so from here it was invisible but still solid).
///   ..._console.exe --path . --write-movie out/f.png --fixed-fps 1 --resolution 1280x720 --quit-after 4 res://test/TestRoomStairLandingCapture.tscn
public partial class TestRoomStairLandingCapture : Node3D
{
    const float CS = DungeonBuilder.CellSize;
    const float FH = DungeonBuilder.FloorHeight;
    Camera3D _cam = null!;
    int _frame;

    public override void _Ready()
    {
        AddChild(new WorldEnvironment
        {
            Environment = new Godot.Environment
            {
                BackgroundMode     = Godot.Environment.BGMode.Color,
                BackgroundColor    = new Color(0.02f, 0.02f, 0.03f),
                AmbientLightSource = Godot.Environment.AmbientSource.Color,
                AmbientLightColor  = new Color(0.6f, 0.55f, 0.5f),
                AmbientLightEnergy = 0.6f,
            },
        });

        var pieces = new List<MazePiece>
        {
            new() { Type = PieceType.Straight, X = 4, Y = 6, Floor = 0 },
            new() { Type = PieceType.StairsUp, X = 4, Y = 5, Floor = 0, Rotation = 0 },
            new() { Type = PieceType.Room,     X = 4, Y = 4, Floor = 1 },
        };
        var dungeon = new DungeonBuilder();
        AddChild(dungeon);
        dungeon.Build(new MazeData { Name = "RoomStairLanding", Pieces = pieces });

        // Lights in the room and on the stair so both sides of the boundary read.
        AddChild(new OmniLight3D { Position = new(4.5f * CS, FH + 8f, 4.5f * CS), OmniRange = 30f, LightEnergy = 3f });
        AddChild(new OmniLight3D { Position = new(4.5f * CS, 12f, 5.5f * CS), OmniRange = 30f, LightEnergy = 3f });

        _cam = new Camera3D { Fov = 75f, Current = true, Far = 500f };
        AddChild(_cam);
        Place(0);
    }

    void Place(int shot)
    {
        if (shot == 0)   // in the room (F1), back to its N wall, facing the landing (S)
        {
            _cam.Position = new(4.5f * CS, FH + 3f, 4f * CS + 1.5f);
            _cam.LookAt(new(4.5f * CS, FH + 2f, 6f * CS));
        }
        else             // at the stair's foot (F0), looking up toward the room
        {
            _cam.Position = new(4.5f * CS, 3f, 6.5f * CS);
            _cam.LookAt(new(4.5f * CS, FH + 3f, 4.5f * CS));
        }
    }

    public override void _Process(double delta)
    {
        _frame++;
        if (_frame == 2) Place(1);
    }
}
