/// Shared configuration for the training game mode.
public static class TrainingConfig
{
    /// Bot difficulty tiers.
    ///   Passive — just walk toward the player; never attack, block, or evade.
    ///   Easy    — approach and swing, but no blocking, dodging, or leaping.
    ///   Normal  — full combat kit at standard speed.
    ///   Hard    — full kit, moves faster and presses harder.
    public enum Difficulty { Passive, Easy, Normal, Hard }

    public static int        DummyCount = 1;
    public static Difficulty Level      = Difficulty.Normal;

    /// Gun to spawn with in training. `RandomGun` means roll from the starter
    /// pool the way a real match does; any other value is a GunCombat.Defs id,
    /// so training can be used to practise ANY gun including the arena ones.
    public const  string RandomGun = "__random__";
    public static string Gun       = RandomGun;

    /// When true, holding the `gun_switch` action (Tab) in the training arena opens
    /// an in-game weapon wheel — a fast-iteration tool for testing every gun without
    /// leaving the match. Off by default so normal training matches the real game.
    public static bool AllowGunSwitch = false;
}
