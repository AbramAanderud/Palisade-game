// ── FFA parties ─────────────────────────────────────────────────────────────

async function makeParty(hostName, memberNames) {
  const host = await Client.open(hostName);
  const members = [];
  for (const n of memberNames) members.push(await Client.open(n));
  host.send({ type: 'party_create' });
  const created = await host.next(m => m.type === 'party_created');
  for (const m of members) {
    host.send({ type: 'party_invite', targetId: m.id });
    const inv = await m.next(x => x.type === 'party_invited');
    m.send({ type: 'party_response', code: inv.code, accepted: true });
    await m.next(x => x.type === 'party_joined');
  }
  return { host, members, code: created.code };
}

