using Godot;
using System.Collections.Generic;
using System.Linq;

/// Visual-flair preview harness. Builds a single connected corridor with a
/// junction + exit, mirrors the live game's environment, and flies an
/// eye-level camera through it for stills.
///
/// Pass user arg `flairoff` (… -- flairoff) to disable VisualFlair for a
/// fair before/after capture from one build.
public partial class TestVisualFlair : Node3D
{
    int _frame = 0;
    const float Cell = DungeonBuilder.CellSize; // 10
    const float CX   = 55f;                      // column 5 centre

    // (ax,ay,az, tx,ty,tz)
    static readonly (float ax,float ay,float az,float tx,float ty,float tz)[] Cams =
    {
        (CX, 1.7f,  6f,  CX, 1.6f, 30f),   // start corridor, looking down the hall
        (CX, 1.7f, 24f,  CX, 1.6f, 48f),   // approaching the junction
        (CX, 2.5f, 15f,  50f, 9f,  15f),   // side wall of a straight — verify hanging banner
        (CX, 1.7f, 52f,  CX, 1.6f, 74f),   // past junction
        (CX, 1.7f, 72f,  CX, 2.2f, 95f),   // approaching the exit god-ray
        (CX, 1.8f, 88f,  CX, 2.6f, 99f),   // exit god-ray, close
        (52f, 2.0f, 64f, CX, 1.6f, 28f),   // looking back up the hall (torches recede into fog)
        (CX, 7.0f, 46f,  CX, 0f,   72f),   // high-angle overview
    };

    bool _big;

    public override void _Ready()
    {
        var userArgs = OS.GetCmdlineUserArgs();
        if (userArgs.Contains("flairoff"))
        {
            VisualFlair.Enabled = false;
            GD.Print("[TestVisualFlair] VisualFlair DISABLED (before)");
        }
        else
        {
            GD.Print("[TestVisualFlair] VisualFlair ENABLED (after)");
        }
        if (userArgs.Contains("shadowsoff"))
        {
            VisualFlair.TorchShadows = false;
            GD.Print("[TestVisualFlair] TorchShadows DISABLED");
        }
        _big = userArgs.Contains("big");

        // ── Environment — identical to OnlineDungeonArena.BuildEnvironment ─────
        var worldEnv = new WorldEnvironment();
        var env = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0f, 0f, 0f),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(0.10f, 0.07f, 0.04f),
            AmbientLightEnergy = 0.25f,
            TonemapMode        = Godot.Environment.ToneMapper.Filmic,
            TonemapExposure    = 1.3f,
        };
        VisualFlair.ApplyEnvironment(env);
        worldEnv.Environment = env;
        AddChild(worldEnv);

        // ── Perf stress maze: dense 7×7 Cross grid (~51 torches) ──────────────
        if (_big)
        {
            var grid = new MazeData { Name = "FlairPerf" };
            grid.Pieces = new List<MazePiece>();
            for (int gx = 1; gx <= 7; gx++)
                for (int gy = 1; gy <= 7; gy++)
                    grid.Pieces.Add(new MazePiece { Type = PieceType.Cross, X = gx, Y = gy, Floor = 0, Rotation = 0 });
            grid.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 4, Y = 0, Floor = 0, Rotation = 0 });
            grid.Pieces.Add(new MazePiece { Type = PieceType.Exit,  X = 4, Y = 8, Floor = 0, Rotation = 0 });
            var gb = new DungeonBuilder { Name = "Maze" };
            AddChild(gb);
            gb.Build(grid);
            SetupCamera(0);
            return;
        }

        // ── Maze: Start → straights → Cross junction → straights → Exit ───────
        var data = new MazeData { Name = "FlairPreview" };
        data.Pieces = new List<MazePiece>
        {
            new() { Type = PieceType.Start,    X=5, Y=0, Floor=0, Rotation=0 },
            new() { Type = PieceType.Straight, X=5, Y=1, Floor=0, Rotation=0 },
            new() { Type = PieceType.Straight, X=5, Y=2, Floor=0, Rotation=0 },
            new() { Type = PieceType.Straight, X=5, Y=3, Floor=0, Rotation=0 },
            new() { Type = PieceType.Cross,    X=5, Y=4, Floor=0, Rotation=0 },
            new() { Type = PieceType.Straight, X=5, Y=5, Floor=0, Rotation=0 },
            new() { Type = PieceType.Straight, X=5, Y=6, Floor=0, Rotation=0 },
            new() { Type = PieceType.Straight, X=5, Y=7, Floor=0, Rotation=0 },
            new() { Type = PieceType.Straight, X=5, Y=8, Floor=0, Rotation=0 },
            new() { Type = PieceType.Exit,     X=5, Y=9, Floor=0, Rotation=0 },
        };

        var builder = new DungeonBuilder { Name = "Maze" };
        AddChild(builder);
        builder.Build(data);

        SetupCamera(0);
    }

    void SetupCamera(int idx)
    {
        GetNodeOrNull<Camera3D>("Cam")?.QueueFree();
        // Stress maze: sweep an eye-level camera through the middle of the hall
        // so many shadow-casting torches stay in frustum.
        var (ax, ay, az, tx, ty, tz) = _big
            ? (45f, 2.0f, 14f + idx * 9f, 75f, 2.0f, 50f)
            : Cams[idx];
        var cam = new Camera3D { Name = "Cam", Current = true, Fov = 80f };
        cam.Position = new Vector3(ax, ay, az);
        AddChild(cam);
        cam.LookAt(new Vector3(tx, ty, tz));
        cam.Current = true;
    }

    public override void _Process(double delta)
    {
        _frame++;
        if (_frame < 2) return;
        int camIdx = (_frame - 2) / 2;
        if (camIdx < Cams.Length) SetupCamera(camIdx);
        else GetTree().Quit();
    }
}
