using Godot;
using System.Collections.Generic;

/// res://scripts/PieceVariants.cs
/// Deterministic per-piece visual variants. Applied AFTER DungeonBuilder
/// builds each cell: swaps mesh materials and adds decorative child nodes.
/// NEVER touches piece geometry or collision (fragile — see CLAUDE.md).
/// Determinism: both multiplayer clients hold identical MazeData, so a pure
/// hash of piece fields yields identical variants with no shared seed.
public partial class PieceVariants : Node
{
    public const int VariantCount = 4;

    // FNV-1a — stable across runs and machines (never use GetHashCode here).
    public static int Fnv(params int[] values)
    {
        unchecked
        {
            uint h = 2166136261;
            foreach (int v in values) { h ^= (uint)v; h *= 16777619; }
            return (int)(h & 0x7FFFFFFF);
        }
    }

    public static int VariantIndex(MazePiece p, int count, int salt = 0)
        => Fnv(p.X, p.Y, p.Floor, (int)p.Type, p.Rotation, salt) % count;

    /// Entry point — called once from DungeonBuilder.Build.
    public static void Apply(Node3D builder, IEnumerable<MazePiece> pieces)
    {
        foreach (var p in pieces)
        {
            var body = builder.GetNodeOrNull<StaticBody3D>($"Cell_{p.X}_{p.Y}_{p.Floor}");
            if (body == null) continue;
            int v = VariantIndex(p, VariantCount);
            ApplyVariant(builder, body, p, v);
        }
    }

    /// Task 3 adds rug-runner decor; Task 4/6 extend this with further material
    /// sets and props keyed off `variant`.
    static void ApplyVariant(Node3D builder, StaticBody3D body, MazePiece p, int variant)
    {
        AddRugSlab(body, p, variant);
        AddWallTrim(body, p, variant);
        AddCofferBeams(body, p, variant);
        AddSconces(body, p, variant);
        AddCornerProps(body, p, variant);
        AddMidCorridorProp(body, p, variant);
        AddDrapePanel(body, p, variant);
        AddClutterProps(body, p, variant);
    }

    // ── Knockable clutter: books/goblets/pots, physics-driven (Task 9) ──────
    // GLB-gated like the other PropLibrary.Instance callers — PhysicsProp.Spawn
    // returns null when assets/glb/props is empty, so this silently adds
    // nothing until Task 5's asset pipeline unblocks it.
    static void AddClutterProps(StaticBody3D body, MazePiece p, int variant)
    {
        if (PieceDB.IsStair(p.Type)) return;
        string[] clutter = { "clutter_bookstack", "clutter_goblet", "clutter_pot" };
        int count = Fnv(p.X, p.Y, p.Floor, 21) % 3;    // 0..2 items
        float cs2 = DungeonBuilder.CellSize;
        for (int i = 0; i < count; i++)
        {
            string prop = clutter[Fnv(p.X, p.Y, i, 22) % clutter.Length];
            float ox = (Fnv(p.X, p.Y, i, 23) % 100) / 100f * 3f - 1.5f;
            float oz = (Fnv(p.X, p.Y, i, 24) % 100) / 100f * 3f - 1.5f;
            var prop3d = PhysicsProp.Spawn(prop,
                new Vector3(p.X * cs2 + cs2 * 0.5f + ox,
                            p.Floor * DungeonBuilder.FloorHeight + 0.4f,
                            p.Y * cs2 + cs2 * 0.5f + oz));
            if (prop3d != null) body.AddChild(prop3d);
        }
    }

    // ── Trim geometry: shared beveled-box mesh + wood shader ────────────────
    static ArrayMesh? _trimMesh;
    static ArrayMesh TrimMesh()
    {
        if (_trimMesh != null) return _trimMesh;
        var st = new SurfaceTool();
        st.Begin(Mesh.PrimitiveType.Triangles);
        // simple box (visual trim only; bevel via normal softness not needed at this size)
        Vector3[] c = {
            new(-0.5f,-0.5f,-0.5f), new(0.5f,-0.5f,-0.5f), new(0.5f,0.5f,-0.5f), new(-0.5f,0.5f,-0.5f),
            new(-0.5f,-0.5f, 0.5f), new(0.5f,-0.5f, 0.5f), new(0.5f,0.5f, 0.5f), new(-0.5f,0.5f, 0.5f) };
        int[][] faces = { new[]{0,1,2,3}, new[]{5,4,7,6}, new[]{4,0,3,7}, new[]{1,5,6,2}, new[]{3,2,6,7}, new[]{4,5,1,0} };
        foreach (var f in faces)
        {
            st.AddVertex(c[f[0]]); st.AddVertex(c[f[1]]); st.AddVertex(c[f[2]]);
            st.AddVertex(c[f[0]]); st.AddVertex(c[f[2]]); st.AddVertex(c[f[3]]);
        }
        st.GenerateNormals();      // fine here: trim boxes don't need welding
        _trimMesh = st.Commit();
        return _trimMesh;
    }

    const string TrimShaderSrc = @"
shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;
varying vec3 wpos;
void vertex(){ wpos=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz; }
float hash13(vec3 p){ p=fract(p*0.1031); p+=dot(p,p.zyx+31.32); return fract((p.x+p.y)*p.z); }
float vnoise(vec3 p){
    vec3 i=floor(p), f=fract(p); f=f*f*(3.0-2.0*f);
    float a=hash13(i),b=hash13(i+vec3(1,0,0)),c=hash13(i+vec3(0,1,0)),d=hash13(i+vec3(1,1,0));
    float e=hash13(i+vec3(0,0,1)),g=hash13(i+vec3(1,0,1)),h=hash13(i+vec3(0,1,1)),k=hash13(i+vec3(1,1,1));
    return mix(mix(mix(a,b,f.x),mix(c,d,f.x),f.y),mix(mix(e,g,f.x),mix(h,k,f.x),f.y),f.z);
}
void fragment(){
    float grain = vnoise(vec3(wpos.x*5.0, wpos.y*0.8, wpos.z*5.0));
    ALBEDO = mix(vec3(0.12,0.07,0.045), vec3(0.26,0.16,0.09), grain);
    ROUGHNESS = 0.8;
}";
    static ShaderMaterial? _trimMat;
    static ShaderMaterial TrimMat() =>
        _trimMat != null && GodotObject.IsInstanceValid(_trimMat)
            ? _trimMat
            : _trimMat = new ShaderMaterial { Shader = new Shader { Code = TrimShaderSrc } };

    static MeshInstance3D Trim(Vector3 center, Vector3 size)
        => new()
        {
            Mesh = TrimMesh(),
            MaterialOverride = TrimMat(),
            Position = center,
            Scale = size,
            Name = "Trim",
        };

    static Vector3 Abs(Vector3 v) => new(Mathf.Abs(v.X), Mathf.Abs(v.Y), Mathf.Abs(v.Z));

    // Wainscot frame (baseboard + chair-rail cap + stiles) along closed corridor
    // walls. Wall positions verified against DungeonBuilder.AddPiece's
    // CapWallNS/CapWallEW calls: closed-side cap walls sit at cx±hw / cz±hw,
    // i.e. exactly ±OpeningW/2 from the cell centerline — matches this brief's
    // assumption, so wallOff below needs no adjustment.
    static void AddWallTrim(StaticBody3D body, MazePiece p, int variant)
    {
        if (PieceDB.IsStair(p.Type)) return;
        var op = PieceDB.GetOpenings(p.Type, p.Rotation);
        float cs = DungeonBuilder.CellSize, half = DungeonBuilder.OpeningW * 0.5f;
        float cx = p.X * cs + cs * 0.5f, cz = p.Y * cs + cs * 0.5f;
        float y0 = p.Floor * DungeonBuilder.FloorHeight;
        // trim heights: baseboard 0..0.25, chair rail cap at 2.4 (matches wainscot_h)
        foreach (var (dir, open) in new[] {
            (Dir.N, (op & Dir.N) != 0), (Dir.S, (op & Dir.S) != 0),
            (Dir.E, (op & Dir.E) != 0), (Dir.W, (op & Dir.W) != 0) })
        {
            if (open) continue;   // no wall on open sides
            bool alongX = dir is Dir.N or Dir.S;
            float wallOff = half - 0.06f;   // proud of the wall by 6cm
            Vector3 n = dir switch {
                Dir.N => new Vector3(0, 0, -1), Dir.S => new Vector3(0, 0, 1),
                Dir.E => new Vector3(1, 0, 0),  _     => new Vector3(-1, 0, 0) };
            Vector3 wallC = new Vector3(cx, 0, cz) + n * wallOff;
            float len = DungeonBuilder.OpeningW * 0.98f;
            Vector3 alongV = alongX ? new Vector3(1, 0, 0) : new Vector3(0, 0, 1);
            // baseboard
            body.AddChild(Trim(wallC + new Vector3(0, y0 + 0.125f, 0),
                Abs(alongV * len + n * 0.10f + Vector3.Up * 0.25f)));
            // chair-rail cap
            body.AddChild(Trim(wallC + new Vector3(0, y0 + 2.4f, 0),
                Abs(alongV * len + n * 0.12f + Vector3.Up * 0.10f)));
            // vertical stiles every len/4 ≈ 1.47m (variant 3 = plain, skips stiles)
            if (variant != 3)
            {
                int stiles = 4;
                for (int i = 0; i <= stiles; i++)
                {
                    float t = -len / 2 + len * i / stiles;
                    body.AddChild(Trim(wallC + alongV * t + new Vector3(0, y0 + 1.3f, 0),
                        Abs(alongV * 0.09f + n * 0.07f + Vector3.Up * 2.1f)));
                }
            }
        }
    }

    // Coffer beam grid on flat ceiling strips flanking corridor barrel vaults.
    // Corridors only (an open N/S or E/W pair) — rooms/junctions skip beams.
    static void AddCofferBeams(StaticBody3D body, MazePiece p, int variant)
    {
        if (PieceDB.IsStair(p.Type) || variant == 2) return;   // variant 2 = plain ceiling
        var op = PieceDB.GetOpenings(p.Type, p.Rotation);
        bool ns = (op & Dir.N) != 0 && (op & Dir.S) != 0;
        bool ew = (op & Dir.E) != 0 && (op & Dir.W) != 0;
        // Straight corridors ONLY: a THall/Cross also has a perpendicular opening,
        // and a beam spanning the corridor width would cut through that doorway.
        bool nsOnly = ns && (op & Dir.E) == 0 && (op & Dir.W) == 0;
        bool ewOnly = ew && (op & Dir.N) == 0 && (op & Dir.S) == 0;
        if (!nsOnly && !ewOnly) return;
        float cs = DungeonBuilder.CellSize;
        float cx = p.X * cs + cs * 0.5f, cz = p.Y * cs + cs * 0.5f;
        float yCeil = p.Floor * DungeonBuilder.FloorHeight + DungeonBuilder.CellHeight - 0.15f;
        Vector3 along = nsOnly ? new Vector3(0, 0, 1) : new Vector3(1, 0, 0);
        Vector3 across = nsOnly ? new Vector3(1, 0, 0) : new Vector3(0, 0, 1);
        // cross beams every 2.5m spanning the corridor width
        for (int i = -1; i <= 1; i++)
            body.AddChild(Trim(new Vector3(cx, yCeil, cz) + along * (i * 2.5f),
                Abs(across * DungeonBuilder.OpeningW + along * 0.22f + Vector3.Up * 0.30f)));
    }

    // ── Sconces: one torch prop per closed wall, warm light on ~1-in-3 ──────
    // GLBs are asset-pipeline output (Task 5) and may not exist yet;
    // PropLibrary.Instance returns null in that case and we bail out of the
    // whole loop on the first miss — no partial/inconsistent prop sets.
    static void AddSconces(StaticBody3D body, MazePiece p, int variant)
    {
        if (PieceDB.IsStair(p.Type)) return;
        var op = PieceDB.GetOpenings(p.Type, p.Rotation);
        float cs = DungeonBuilder.CellSize, half = DungeonBuilder.OpeningW * 0.5f;
        float cx = p.X * cs + cs * 0.5f, cz = p.Y * cs + cs * 0.5f;
        float y0 = p.Floor * DungeonBuilder.FloorHeight;
        string prop = (variant % 2 == 0) ? "torch_a" : "torch_b";
        // one sconce per closed wall; REAL light only when Fnv says so (1 in 3)
        foreach (var (dir, open) in new[] {
            (Dir.N, (op & Dir.N) != 0), (Dir.S, (op & Dir.S) != 0),
            (Dir.E, (op & Dir.E) != 0), (Dir.W, (op & Dir.W) != 0) })
        {
            if (open) continue;
            bool lit = Fnv(p.X, p.Y, p.Floor, (int)dir, 7) % 3 == 0;
            var node = PropLibrary.Instance(prop, withLight: lit);
            if (node == null) return;                    // GLBs absent → skip all
            Vector3 n = dir switch {
                Dir.N => new Vector3(0, 0, -1), Dir.S => new Vector3(0, 0, 1),
                Dir.E => new Vector3(1, 0, 0),  _     => new Vector3(-1, 0, 0) };
            node.Position = new Vector3(cx, y0 + 2.9f, cz) + n * (half - 0.15f);
            body.AddChild(node);   // AddChild before LookAt: LookAt on a not-yet-in-tree
                                    // node can misbehave (see CLAUDE.md task note)
            node.LookAt(node.Position - n, Vector3.Up);   // face into the corridor
        }
    }

    // Variant 0 extra: a potted plant tucked into each real wall corner (both
    // adjacent sides closed). Straight corridors have no such corner, so this
    // only fires on turns / dead-ends / rooms — reads as "junction corners".
    static void AddCornerProps(StaticBody3D body, MazePiece p, int variant)
    {
        if (PieceDB.IsStair(p.Type) || variant != 0) return;
        var op = PieceDB.GetOpenings(p.Type, p.Rotation);
        float cs = DungeonBuilder.CellSize, half = DungeonBuilder.OpeningW * 0.5f;
        float cx = p.X * cs + cs * 0.5f, cz = p.Y * cs + cs * 0.5f;
        float y0 = p.Floor * DungeonBuilder.FloorHeight;
        var corners = new[] {
            (Dir.N, Dir.W, new Vector3(-1, 0, -1)),
            (Dir.N, Dir.E, new Vector3( 1, 0, -1)),
            (Dir.S, Dir.W, new Vector3(-1, 0,  1)),
            (Dir.S, Dir.E, new Vector3( 1, 0,  1)),
        };
        foreach (var (d1, d2, offset) in corners)
        {
            if ((op & d1) != 0 || (op & d2) != 0) continue;   // needs both walls closed
            var node = PropLibrary.Instance("plant_a");
            if (node == null) return;                          // GLBs absent → skip all
            node.Position = new Vector3(cx, y0, cz) + offset * (half - 0.4f);
            body.AddChild(node);
        }
    }

    // Variant 1 extra: a candelabra at the midpoint of straight corridors,
    // set against whichever side wall Fnv picks so runs don't all line up.
    static void AddMidCorridorProp(StaticBody3D body, MazePiece p, int variant)
    {
        if (PieceDB.IsStair(p.Type) || variant != 1) return;
        var op = PieceDB.GetOpenings(p.Type, p.Rotation);
        bool ns = (op & Dir.N) != 0 && (op & Dir.S) != 0;
        bool ew = (op & Dir.E) != 0 && (op & Dir.W) != 0;
        bool nsOnly = ns && (op & Dir.E) == 0 && (op & Dir.W) == 0;
        bool ewOnly = ew && (op & Dir.N) == 0 && (op & Dir.S) == 0;
        if (!nsOnly && !ewOnly) return;
        float cs = DungeonBuilder.CellSize, half = DungeonBuilder.OpeningW * 0.5f;
        float cx = p.X * cs + cs * 0.5f, cz = p.Y * cs + cs * 0.5f;
        float y0 = p.Floor * DungeonBuilder.FloorHeight;
        bool sideA = Fnv(p.X, p.Y, p.Floor, 11) % 2 == 0;
        Vector3 n = nsOnly ? new Vector3(sideA ? 1 : -1, 0, 0)
                            : new Vector3(0, 0, sideA ? 1 : -1);
        var node = PropLibrary.Instance("candelabra_a", withLight: true);
        if (node == null) return;                              // GLBs absent → skip
        node.Position = new Vector3(cx, y0, cz) + n * (half - 0.2f);
        body.AddChild(node);   // AddChild before LookAt (see AddSconces note)
        node.LookAt(node.Position - n, Vector3.Up);
    }

    // ── Velvet drape panel (variant 3 only) ──────────────────────────────────
    // Procedural cloth reusing ArenaBuilder's velvet shader source (codebase
    // duplicates shader sources deliberately rather than sharing a public
    // const — see CLAUDE.md). Unlike sconces/plants/candelabras this doesn't
    // load a GLB, so it's explicitly gated on PropLibrary.PropsAvailable to
    // keep fallback captures free of new geometry too.
    const string VelvetShaderSrc = @"
shader_type spatial;
render_mode cull_disabled, diffuse_burley, specular_schlick_ggx;
uniform vec3 velvet_color : source_color = vec3(0.39, 0.043, 0.043);
varying vec2 vuv;
float hash21(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453); }
float vn2(vec2 p){
    vec2 i=floor(p), f=fract(p); f=f*f*(3.0-2.0*f);
    return mix(mix(hash21(i),hash21(i+vec2(1,0)),f.x),mix(hash21(i+vec2(0,1)),hash21(i+vec2(1,1)),f.x),f.y);
}
void vertex(){
    vuv = UV;
    float free = UV.y;
    VERTEX.z += sin(UV.x * 18.85) * 0.16 * free;
}
void fragment(){
    float folds = vn2(vuv * vec2(16.0, 2.0));
    float grain = vn2(vuv * 90.0);
    vec3 col = velvet_color * (0.65 + 0.45 * folds) * (0.92 + 0.16 * grain);
    float fres = pow(1.0 - clamp(dot(normalize(NORMAL), normalize(VIEW)), 0.0, 1.0), 2.4);
    col = mix(col, velvet_color * 2.4 + vec3(0.10, 0.04, 0.04), fres * 0.75);
    ALBEDO = col; ROUGHNESS = 0.78; METALLIC = 0.0;
}";

    static ArrayMesh? _drapeMesh;
    static ArrayMesh DrapeMesh()
    {
        if (_drapeMesh != null) return _drapeMesh;
        const int segsX = 8, segsY = 10;
        var st = new SurfaceTool();
        st.Begin(Mesh.PrimitiveType.Triangles);
        for (int row = 0; row <= segsY; row++)
        {
            float t = (float)row / segsY;
            for (int col = 0; col <= segsX; col++)
            {
                float s = (float)col / segsX;
                st.SetUV(new Vector2(s, t));
                st.SetNormal(new Vector3(0, 0, 1));
                st.AddVertex(new Vector3(s - 0.5f, -t, 0));   // unit panel, rod at y=0
            }
        }
        for (int row = 0; row < segsY; row++)
        for (int col = 0; col < segsX; col++)
        {
            int i0 = row * (segsX + 1) + col;
            int i1 = i0 + 1;
            int i2 = i0 + (segsX + 1);
            int i3 = i2 + 1;
            st.AddIndex(i0); st.AddIndex(i2); st.AddIndex(i1);
            st.AddIndex(i1); st.AddIndex(i2); st.AddIndex(i3);
        }
        _drapeMesh = st.Commit();
        return _drapeMesh;
    }

    static ShaderMaterial? _drapeMat;
    static ShaderMaterial DrapeMat() =>
        _drapeMat != null && GodotObject.IsInstanceValid(_drapeMat)
            ? _drapeMat
            : _drapeMat = new ShaderMaterial { Shader = new Shader { Code = VelvetShaderSrc } };

    // One drape per piece, hung across the first open doorway found (N/E/S/W
    // scan order). Matches AddCurtain's valance style: rod near the vault
    // spring, hem overhanging the opening; the doorway itself stays passable.
    static void AddDrapePanel(StaticBody3D body, MazePiece p, int variant)
    {
        if (PieceDB.IsStair(p.Type) || variant != 3) return;
        if (!PropLibrary.PropsAvailable) return;   // gated like GLB props (see const comment above)
        var op = PieceDB.GetOpenings(p.Type, p.Rotation);
        float cs = DungeonBuilder.CellSize, half = DungeonBuilder.OpeningW * 0.5f;
        float cx = p.X * cs + cs * 0.5f, cz = p.Y * cs + cs * 0.5f;
        float y0 = p.Floor * DungeonBuilder.FloorHeight;
        float top = y0 + DungeonBuilder.CellHeight + 1.0f;   // near the vault spring
        float bottom = y0 + 6.5f;                            // overhangs the opening, stays passable
        foreach (var (dir, open) in new[] {
            (Dir.N, (op & Dir.N) != 0), (Dir.E, (op & Dir.E) != 0),
            (Dir.S, (op & Dir.S) != 0), (Dir.W, (op & Dir.W) != 0) })
        {
            if (!open) continue;
            Vector3 n = dir switch {
                Dir.N => new Vector3(0, 0, -1), Dir.S => new Vector3(0, 0, 1),
                Dir.E => new Vector3(1, 0, 0),  _     => new Vector3(-1, 0, 0) };
            var mi = new MeshInstance3D
            {
                Name = "DrapePanel",
                Mesh = DrapeMesh(),
                MaterialOverride = DrapeMat(),
                Position = new Vector3(cx, top, cz) + n * (half - 0.05f),
                Scale = new Vector3(DungeonBuilder.OpeningW * 0.9f, top - bottom, 1f),
                CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
            };
            body.AddChild(mi);   // AddChild before LookAt (see AddSconces note)
            mi.LookAt(mi.Position + n, Vector3.Up);
            return;   // one drape panel per piece
        }
    }

    const string RugShaderSrc = @"
shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;
uniform sampler2D rug_tex : filter_linear_mipmap, repeat_enable;
uniform vec3 border_col : source_color = vec3(0.10, 0.04, 0.03);
uniform vec3 tint : source_color = vec3(1.0, 1.0, 1.0);
void fragment() {
    // UV laid out 0..1 across the slab; border band 8% in from each edge
    vec2 e = min(UV, 1.0 - UV);
    float border = 1.0 - smoothstep(0.06, 0.085, min(e.x, e.y));
    vec3 rug = texture(rug_tex, UV * vec2(2.0, 6.0)).rgb * tint;
    ALBEDO = mix(rug, border_col, border * 0.85);
    ROUGHNESS = 0.97;
}";

    // Per-variant material cache: building a rug material loads a JPG from disk and
    // compiles a shader, so do it once per variant instead of once per corridor cell.
    // IsInstanceValid guard matches the codebase's other material caches — Godot frees
    // resources on scene unload while the C# handle stays non-null (see DungeonBuilder).
    static readonly ShaderMaterial?[] _rugMats = new ShaderMaterial?[VariantCount];

    static ShaderMaterial? RugMat(int variant)
    {
        int slot = variant % _rugMats.Length;
        var cached = _rugMats[slot];
        if (cached != null && GodotObject.IsInstanceValid(cached)) return cached;

        // Per-variant tint over the same carpet texture
        var tints = new[] { new Color(1,1,1), new Color(0.7f,0.85f,1.1f),
                            new Color(1.1f,0.9f,0.7f), new Color(0.85f,1.0f,0.85f) };
        var abs = ProjectSettings.GlobalizePath("res://assets/img/mats/carpet/Carpet3_BaseColor.jpg.jpg");
        var img = new Image();
        if (img.Load(abs) != Error.Ok) return null;
        img.SrgbToLinear(); img.GenerateMipmaps();
        var m = new ShaderMaterial { Shader = new Shader { Code = RugShaderSrc } };
        m.SetShaderParameter("rug_tex", ImageTexture.CreateFromImage(img));
        m.SetShaderParameter("tint", tints[slot % tints.Length]);
        _rugMats[slot] = m;
        return m;
    }

    static void AddRugSlab(StaticBody3D body, MazePiece p, int variant)
    {
        if (PieceDB.IsStair(p.Type)) return;
        var mat = RugMat(variant);
        if (mat == null) return;                       // texture missing → skip
        var op = PieceDB.GetOpenings(p.Type, p.Rotation);
        // Corridor axis: N/S pair or E/W pair. Rooms/junctions get a centered square rug.
        bool ns = (op & Dir.N) != 0 && (op & Dir.S) != 0;
        bool ew = (op & Dir.E) != 0 && (op & Dir.W) != 0;
        float cs = DungeonBuilder.CellSize;
        float len = cs * 0.96f, wid = DungeonBuilder.OpeningW * 0.55f;
        if (ns == ew)   // junction (neither axis) or 4-way crossing (both): square rug
        {
            len = wid = DungeonBuilder.OpeningW * 0.8f;
            ns = false;  // square — orientation irrelevant, use the len-along-X layout
        }

        var mesh = new BoxMesh { Size = new Vector3(ns ? wid : len, 0.05f, ns ? len : wid) };
        mesh.Material = mat;
        // Cell bodies sit at the builder origin with geometry in world-relative
        // coords, so a child's local position == piece coordinates.
        var mi = new MeshInstance3D
        {
            Name = "RugSlab",
            Mesh = mesh,
            Position = new Vector3(p.X * cs + cs * 0.5f,
                                   p.Floor * DungeonBuilder.FloorHeight + 0.03f,
                                   p.Y * cs + cs * 0.5f),
        };
        body.AddChild(mi);
    }
}
