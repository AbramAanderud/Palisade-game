using Godot;
using System.Linq;

/// test/TestPickupPrompt.cs
/// Visual check for the radial pickup prompt. Spawns three pickups at different
/// ring fills so one capture shows empty / mid / nearly-complete, and forces the
/// prompt visible (normally it only shows when a player enters the Area3D).
public partial class TestPickupPrompt : Node3D
{
    public override void _Ready()
    {
        var env = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0.05f, 0.05f, 0.07f),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(0.5f, 0.5f, 0.55f),
            AmbientLightEnergy = 1.0f,
        };
        AddChild(new WorldEnvironment { Environment = env });
        AddChild(new DirectionalLight3D { Rotation = new(-0.7f, 0.6f, 0f), LightEnergy = 1.4f });

        float[] fills = { 0.0f, 0.45f, 0.85f };
        for (int i = 0; i < fills.Length; i++)
        {
            var wp = WeaponPickup.Spawn(this, new Vector3((i - 1) * 3.2f, 0f, 0f));
            int idx = i;
            // Defer: the prompt is created in WeaponPickup._Ready, which has not
            // run yet at this point in our own _Ready.
            CallDeferred(nameof(Force), wp, fills[idx]);
        }

        var cam = new Camera3D { Position = new Vector3(0f, 0.2f, 6.0f), Fov = 55f };
        AddChild(cam);
        cam.MakeCurrent();
    }

    void Force(Node wpNode, float fill)
    {
        var prompt = wpNode.GetChildren().OfType<ProximityPrompt>().FirstOrDefault();
        if (prompt == null) { GD.Print("[Prompt] FAIL — no ProximityPrompt child"); return; }
        prompt.Visible  = true;
        prompt.Progress = fill;
        GD.Print($"[Prompt] shown fill={fill:F2}");
    }
}
