# tools/gunsfx_gen.py
# Synthesises one distinct gunshot per weapon into assets/audio/sfx/combat/.
# Run:  py tools/gunsfx_gen.py          (stdlib only — no numpy, no scipy)
#
# WHY THIS EXISTS
# Seven guns shared two samples (GunShotLight for mac10/pew, GunShotHeavy for
# the other five), so an AWP and a quad rocket were literally the same noise.
# A gunshot is also not one sound — it is three stacked events, and a sample
# that lacks any of them reads as "cheap":
#
#   crack  1-8 ms   the supersonic snap. Carries the weapon's PERCEIVED power;
#                   bright, near-instant decay.
#   body   20-90 ms the chamber/bore thump. Carries CALIBRE — a shotgun is
#                   mostly body, a pistol has almost none.
#   tail   0.1-0.6s the room answering back. Carries SPACE. Without it a shot
#                   sounds like it happened in a padded box, which is the single
#                   biggest giveaway of a bad game gunshot.
#
# Tails here include discrete early reflections (slap-back off stone at a few
# fixed delays) because the game is set in a dungeon of hard corridors — a
# smooth exponential tail alone sounds outdoors.
#
# Output matches the existing assets exactly: 44.1 kHz, mono, 16-bit PCM.

import array, math, os, random, struct, wave

SR  = 44100
OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                   "..", "assets", "audio", "sfx", "combat")


# ── tiny DSP kit ─────────────────────────────────────────────────────────────

def silence(dur):
    return [0.0] * int(SR * dur)

def noise(buf, start, dur, amp, tau):
    """White noise with an exponential decay, summed into buf."""
    n0 = int(SR * start)
    for i in range(int(SR * dur)):
        if n0 + i >= len(buf): break
        buf[n0 + i] += random.uniform(-1.0, 1.0) * amp * math.exp(-i / (SR * tau))

def tone(buf, start, dur, freq, amp, tau, sweep=0.0):
    """Decaying sine; `sweep` bends the pitch down over the note (a thump)."""
    n0 = int(SR * start)
    ph = 0.0
    for i in range(int(SR * dur)):
        if n0 + i >= len(buf): break
        f = freq * (1.0 - sweep * (i / (SR * dur)))
        ph += 2.0 * math.pi * f / SR
        buf[n0 + i] += math.sin(ph) * amp * math.exp(-i / (SR * tau))

def lowpass(buf, fc):
    rc, dt = 1.0 / (2 * math.pi * fc), 1.0 / SR
    a = dt / (rc + dt)
    y = 0.0
    for i, x in enumerate(buf):
        y += a * (x - y)
        buf[i] = y

def highpass(buf, fc):
    rc, dt = 1.0 / (2 * math.pi * fc), 1.0 / SR
    a = rc / (rc + dt)
    y, xp = 0.0, 0.0
    for i, x in enumerate(buf):
        y = a * (y + x - xp)
        xp = x
        buf[i] = y

def reflections(buf, taps, damp_fc):
    """Discrete slap-back off hard surfaces — what makes it read as stone."""
    src = list(buf)
    lowpass(src, damp_fc)                     # walls eat the highs
    for delay_ms, gain in taps:
        d = int(SR * delay_ms / 1000.0)
        for i in range(len(buf) - d):
            buf[i + d] += src[i] * gain

def normalize(buf, peak=0.89):
    m = max(abs(v) for v in buf) or 1.0
    k = peak / m
    for i in range(len(buf)):
        v = buf[i] * k
        # soft clip: keeps transients loud without the crunch of hard clipping
        buf[i] = math.tanh(v * 1.25) / math.tanh(1.25)

def write_wav(name, buf):
    os.makedirs(OUT, exist_ok=True)
    path = os.path.abspath(os.path.join(OUT, name))
    pcm = array.array("h", (int(max(-1.0, min(1.0, v)) * 32767) for v in buf))
    with wave.open(path, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(SR)
        w.writeframes(pcm.tobytes())
    peak = max(abs(v) for v in buf)
    rms  = math.sqrt(sum(v * v for v in buf) / len(buf))
    print(f"[gunsfx] {name:24s} {len(buf)/SR*1000:5.0f} ms  peak {peak:.2f}  rms {rms:.3f}")


# ── the guns ─────────────────────────────────────────────────────────────────
# Each is crack + body + tail in different proportions. The proportions ARE the
# weapon's identity: sniper is nearly all crack, shotgun nearly all body.

def build(dur, crack_amp, crack_tau, body_f, body_amp, body_tau, body_sweep,
          tail_amp, tail_tau, tail_fc, taps, bright_fc, seed):
    random.seed(seed)                          # reproducible builds
    buf = silence(dur)

    crack = silence(dur)
    noise(crack, 0.000, min(0.06, dur), crack_amp, crack_tau)
    highpass(crack, bright_fc)                 # brightness = perceived power

    body = silence(dur)
    noise(body, 0.001, min(0.18, dur), body_amp * 0.8, body_tau)
    lowpass(body, body_f * 3.0)
    tone(body, 0.001, min(0.22, dur), body_f, body_amp, body_tau, body_sweep)

    tail = silence(dur)
    noise(tail, 0.004, dur - 0.005, tail_amp, tail_tau)
    lowpass(tail, tail_fc)

    for i in range(len(buf)):
        buf[i] = crack[i] + body[i] + tail[i]

    reflections(buf, taps, damp_fc=2600)
    normalize(buf)
    return buf


STONE = [(11, 0.22), (23, 0.15), (37, 0.10), (59, 0.06)]   # dungeon slap-back

GUNS = {
    # id                          dur  crackA crackT  bodyF bodyA bodyT  swp  tailA tailT tailFc  taps   brightFc seed
    "GunShot_Pistol.wav":  dict(dur=0.26, crack_amp=0.85, crack_tau=0.0035, body_f=150, body_amp=0.45,
                                body_tau=0.022, body_sweep=0.35, tail_amp=0.16, tail_tau=0.055,
                                tail_fc=2200, taps=STONE, bright_fc=1500, seed=11),
    "GunShot_Smg.wav":     dict(dur=0.20, crack_amp=0.92, crack_tau=0.0022, body_f=185, body_amp=0.34,
                                body_tau=0.014, body_sweep=0.40, tail_amp=0.13, tail_tau=0.040,
                                tail_fc=2600, taps=STONE, bright_fc=1900, seed=22),
    "GunShot_Shotgun.wav": dict(dur=0.52, crack_amp=0.70, crack_tau=0.0060, body_f=78,  body_amp=1.00,
                                body_tau=0.070, body_sweep=0.55, tail_amp=0.34, tail_tau=0.150,
                                tail_fc=1100, taps=STONE, bright_fc=700,  seed=33),
    "GunShot_Rifle.wav":   dict(dur=0.36, crack_amp=1.00, crack_tau=0.0030, body_f=120, body_amp=0.60,
                                body_tau=0.032, body_sweep=0.45, tail_amp=0.22, tail_tau=0.085,
                                tail_fc=1800, taps=STONE, bright_fc=1600, seed=44),
    "GunShot_Sniper.wav":  dict(dur=0.70, crack_amp=1.00, crack_tau=0.0018, body_f=95,  body_amp=0.72,
                                body_tau=0.045, body_sweep=0.50, tail_amp=0.30, tail_tau=0.230,
                                tail_fc=1500, taps=STONE, bright_fc=2400, seed=55),
    # Launchers: almost no crack — a rocket leaving a tube is a WHOOSH and a
    # low thump, not a supersonic snap. Getting this wrong is why launchers
    # so often sound like rifles.
    "GunShot_Rocket.wav":  dict(dur=0.60, crack_amp=0.30, crack_tau=0.0120, body_f=62,  body_amp=0.95,
                                body_tau=0.090, body_sweep=0.30, tail_amp=0.45, tail_tau=0.200,
                                tail_fc=900,  taps=STONE, bright_fc=450,  seed=66),
    "GunShot_Quad.wav":    dict(dur=0.40, crack_amp=0.42, crack_tau=0.0075, body_f=88,  body_amp=0.80,
                                body_tau=0.050, body_sweep=0.35, tail_amp=0.32, tail_tau=0.120,
                                tail_fc=1200, taps=STONE, bright_fc=650,  seed=77),
}

if __name__ == "__main__":
    for name, kw in GUNS.items():
        write_wav(name, build(**kw))
    print(f"[gunsfx] {len(GUNS)} shots written to {os.path.abspath(OUT)}")
