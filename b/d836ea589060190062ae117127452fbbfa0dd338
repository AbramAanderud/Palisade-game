using Godot;
using System;

/// res://scripts/GrassField.cs
/// Interactive stylized grass, Godot-native (inspired by Unity's "A+ Grass"):
///   - MultiMesh crossed-quad blades (single draw call, no collision)
///   - Wind: two scrolling noise layers with a blend uniform
///   - Colour: base->tip gradient, per-blade jitter, broad patch noise, base AO
///   - Interaction: nodes in the GrassInteractor group bend grass; a CPU
///     bend-map texture keeps a TRAIL that recovers over time
///   - Distance fade (alpha scissor)
/// Acts as its own manager: wind + recovery globals are exports here.
public partial class GrassField : Node3D
{
    [Export] public float Radius       = 27f;
    [Export] public int   BladeCount   = 60000;
    [Export] public float BladeHeight  = 0.42f;  // avg blade height (m)
    [Export] public Color BaseColor    = new(0.045f, 0.10f, 0.035f);
    [Export] public Color TipColor     = new(0.22f, 0.38f, 0.12f);

    // ── wind globals ──────────────────────────────────────────────────────────
    [Export] public float WindStrength   = 0.22f;
    [Export] public float WindSpeed      = 1.1f;
    [Export] public Vector2 WindDir      = new(1f, 0.35f);
    [Export(PropertyHint.Range, "0,1")] public float WindNoiseBlend = 0.45f;

    // ── interaction globals ───────────────────────────────────────────────────
    [Export] public float RecoverySpeed  = 0.55f;  // trail fade-out per second (lingers ~3s)
    [Export] public float DistFadeStart  = 34f;
    [Export] public float DistFadeEnd    = 50f;

    const int MapRes = 128;                 // bend-map resolution
    float _mapWorld;                        // world size the map covers
    byte[] _bendData = null!;
    Image _bendImg = null!;
    ImageTexture _bendTex = null!;
    ShaderMaterial _mat = null!;

    const string GrassShaderSrc = @"
shader_type spatial;
render_mode cull_disabled, diffuse_burley, specular_schlick_ggx, world_vertex_coords;
uniform vec3 base_color : source_color = vec3(0.045, 0.10, 0.035);
uniform vec3 tip_color  : source_color = vec3(0.30, 0.48, 0.14);
uniform float wind_strength = 0.22;
uniform float wind_speed    = 1.1;
uniform vec2  wind_dir      = vec2(1.0, 0.35);
uniform float wind_blend    = 0.45;   // 0 = broad gusts, 1 = fine ripple
uniform float fade_start    = 34.0;
uniform float fade_end      = 50.0;
uniform sampler2D bend_map : filter_linear, repeat_disable;
uniform vec2  map_origin;             // world xz of bend map min corner
uniform float map_size = 1.0;         // world extent covered by bend map
varying float v_h;                    // 0 root .. 1 tip
varying float v_jit;                  // per-blade colour jitter
varying vec2  v_wxz;
varying float v_dist;
float hash21(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vn2(vec2 p){
    vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash21(i), hash21(i + vec2(1, 0)), f.x),
               mix(hash21(i + vec2(0, 1)), hash21(i + vec2(1, 1)), f.x), f.y);
}
void vertex() {
    float h = UV.y;
    v_h = h;
    v_jit = INSTANCE_CUSTOM.x;
    float hmul = INSTANCE_CUSTOM.y;
    v_wxz = VERTEX.xz;

    // wind: two noise layers scrolling at different scales/speeds
    vec2 wd = normalize(wind_dir);
    float t = TIME * wind_speed;
    float n1 = vn2(VERTEX.xz * 0.10 + wd * t * 0.35);
    float n2 = vn2(VERTEX.xz * 0.55 - wd * t * 0.90 + 7.31);
    float gust = mix(n1, n2, wind_blend) - 0.35;
    vec2 sway = wd * gust * wind_strength * h * h * (0.6 + 0.8 * hmul)
              + vec2(0.0, 1.0) * sin(t * 1.7 + INSTANCE_CUSTOM.z * 6.28) * 0.02 * h;

    // interaction: sample bend trail map (RG = dir, B = strength)
    vec2 muv = (VERTEX.xz - map_origin) / map_size;
    vec4 bm = texture(bend_map, muv);
    vec2 bdir = bm.rg * 2.0 - 1.0;
    float bstr = bm.b;
    sway += bdir * bstr * 0.85 * h;
    VERTEX.xz += sway;
    VERTEX.y -= bstr * 0.30 * h;          // squash bent grass down a bit

    v_dist = length(VERTEX - CAMERA_POSITION_WORLD);
}
void fragment() {
    // blade silhouette: near-constant width, tapering to a point in the top half
    float w = 0.20 * (1.0 - smoothstep(0.35, 0.97, v_h)) + 0.015;
    float a = 1.0 - smoothstep(w - 0.03, w, abs(UV.x - 0.5));
    a *= 1.0 - smoothstep(fade_start, fade_end, v_dist);   // distance fade
    ALPHA = a;
    ALPHA_SCISSOR_THRESHOLD = 0.45;

    vec3 col = mix(base_color, tip_color, pow(v_h, 1.3));
    col *= 0.80 + 0.40 * v_jit;                            // per-blade jitter
    col *= 0.75 + 0.50 * vn2(v_wxz * 0.22);                // broad patches
    col *= 0.50 + 0.50 * v_h;                              // root AO
    ALBEDO = col;
    ROUGHNESS = 0.9;
    NORMAL = normalize(vec3(0.0, 1.0, 0.0) * mat3(VIEW_MATRIX)); // light like ground
}";

    public override void _Ready()
    {
        _mapWorld = Radius * 2f + 6f;

        // ── bend map (trail state) ────────────────────────────────────────────
        _bendData = new byte[MapRes * MapRes * 4];
        for (int i = 0; i < _bendData.Length; i += 4) { _bendData[i] = 127; _bendData[i + 1] = 127; }
        _bendImg = Image.CreateFromData(MapRes, MapRes, false, Image.Format.Rgba8, _bendData);
        _bendTex = ImageTexture.CreateFromImage(_bendImg);

        // ── blade mesh: two crossed quads, origin at root, 1m tall ───────────
        var st = new SurfaceTool();
        st.Begin(Mesh.PrimitiveType.Triangles);
        void BladeQuad(Vector3 right)
        {
            Vector3 r = right * 0.07f;
            Vector3 up = Vector3.Up;
            // two triangles, UV.x across width, UV.y up the blade
            st.SetUV(new(0, 0)); st.AddVertex(-r);
            st.SetUV(new(1, 0)); st.AddVertex(r);
            st.SetUV(new(1, 1)); st.AddVertex(r + up);
            st.SetUV(new(0, 0)); st.AddVertex(-r);
            st.SetUV(new(1, 1)); st.AddVertex(r + up);
            st.SetUV(new(0, 1)); st.AddVertex(-r + up);
        }
        BladeQuad(Vector3.Right);
        BladeQuad(new Vector3(0.5f, 0, 0.866f));
        st.GenerateNormals();
        var bladeMesh = st.Commit();

        _mat = new ShaderMaterial { Shader = new Shader { Code = GrassShaderSrc } };
        _mat.SetShaderParameter("base_color", BaseColor);
        _mat.SetShaderParameter("tip_color", TipColor);
        _mat.SetShaderParameter("wind_strength", WindStrength);
        _mat.SetShaderParameter("wind_speed", WindSpeed);
        _mat.SetShaderParameter("wind_dir", WindDir);
        _mat.SetShaderParameter("wind_blend", WindNoiseBlend);
        _mat.SetShaderParameter("fade_start", DistFadeStart);
        _mat.SetShaderParameter("fade_end", DistFadeEnd);
        _mat.SetShaderParameter("bend_map", _bendTex);
        _mat.SetShaderParameter("map_size", _mapWorld);
        bladeMesh.SurfaceSetMaterial(0, _mat);

        // ── scatter instances ────────────────────────────────────────────────
        var mm = new MultiMesh
        {
            TransformFormat = MultiMesh.TransformFormatEnum.Transform3D,
            UseCustomData   = true,
            Mesh            = bladeMesh,
            InstanceCount   = BladeCount,
        };
        var rng = new Random(4242);
        for (int i = 0; i < BladeCount; i++)
        {
            // uniform disc distribution
            float ang = (float)(rng.NextDouble() * Math.PI * 2);
            float rad = Radius * MathF.Sqrt((float)rng.NextDouble());
            var pos = new Vector3(MathF.Cos(ang) * rad, 0, MathF.Sin(ang) * rad);
            float yaw = (float)(rng.NextDouble() * Math.PI * 2);
            float sx  = 0.8f + (float)rng.NextDouble() * 0.5f;
            float sy  = BladeHeight * (0.65f + (float)rng.NextDouble() * 0.8f);
            var basis = Basis.FromEuler(new Vector3(0, yaw, 0)).Scaled(new Vector3(sx, sy, sx));
            mm.SetInstanceTransform(i, new Transform3D(basis, pos));
            mm.SetInstanceCustomData(i, new Color(
                (float)rng.NextDouble(),          // colour jitter
                (float)rng.NextDouble(),          // wind height multiplier
                (float)rng.NextDouble(), 0));     // sway phase
        }
        AddChild(new MultiMeshInstance3D
        {
            Name = "GrassBlades",
            Multimesh = mm,
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        });
    }

    public override void _Process(double delta)
    {
        // world origin of the map follows this node
        Vector2 origin = new(GlobalPosition.X - _mapWorld * 0.5f, GlobalPosition.Z - _mapWorld * 0.5f);
        _mat.SetShaderParameter("map_origin", origin);

        // ── recovery: strength decays toward zero ────────────────────────────
        float decay = MathF.Exp(-RecoverySpeed * (float)delta);
        bool dirty = false;
        for (int i = 0; i < _bendData.Length; i += 4)
        {
            byte b = _bendData[i + 2];
            if (b == 0) continue;
            _bendData[i + 2] = (byte)(b * decay);
            dirty = true;
        }

        // ── stamp interactors ────────────────────────────────────────────────
        float pxPerM = MapRes / _mapWorld;
        foreach (var node in GetTree().GetNodesInGroup(GrassInteractor.Group))
        {
            if (node is not GrassInteractor gi || !gi.IsInsideTree()) continue;
            Vector3 gp = gi.GlobalPosition;
            float cx = (gp.X - origin.X) * pxPerM;
            float cz = (gp.Z - origin.Y) * pxPerM;
            float rPx = gi.Radius * pxPerM;
            int x0 = Math.Max(0, (int)(cx - rPx)), x1 = Math.Min(MapRes - 1, (int)(cx + rPx));
            int z0 = Math.Max(0, (int)(cz - rPx)), z1 = Math.Min(MapRes - 1, (int)(cz + rPx));
            if (x1 < 0 || z1 < 0 || x0 >= MapRes || z0 >= MapRes) continue;
            for (int z = z0; z <= z1; z++)
            for (int x = x0; x <= x1; x++)
            {
                float dx = x - cx, dz = z - cz;
                float d = MathF.Sqrt(dx * dx + dz * dz);
                if (d > rPx) continue;
                float s = (1f - d / rPx) * gi.Strength;
                int idx = (z * MapRes + x) * 4;
                byte sb = (byte)(Math.Clamp(s, 0f, 1f) * 255f);
                if (sb <= _bendData[idx + 2]) continue;      // keep strongest
                float inv = d > 0.001f ? 1f / d : 0f;        // push radially outward
                _bendData[idx]     = (byte)((dx * inv * 0.5f + 0.5f) * 255f);
                _bendData[idx + 1] = (byte)((dz * inv * 0.5f + 0.5f) * 255f);
                _bendData[idx + 2] = sb;
                dirty = true;
            }
        }

        if (dirty)
        {
            _bendImg.SetData(MapRes, MapRes, false, Image.Format.Rgba8, _bendData);
            _bendTex.Update(_bendImg);
        }
    }
}
