using Godot;
using System.Reflection;
using System.Collections.Generic;

/// test/TestStairOverlap.cs
/// Owner report: "I can put stairs ontop of pieces and its letting me... you
/// can put stairs above and over pieces where even if the stairs landing and
/// opening is valid they are gonna collide with other pieces."
///
/// GROUND TRUTH (verified against AddStairGeometry, not guessed):
/// DungeonBuilder.AddStairGeometry builds a stair's outer envelope from
/// yLo=geomBase up to springHi+ArchRise = geomBase + FloorHeight + CellHeight
/// + ArchRise = geomBase + 2*FloorHeight (CellHeight+ArchRise==FloorHeight) —
/// a full TWO floors of vertical structure in the stair's own (x,y) column.
/// geomBase == yBase (== Floor*FloorHeight) for StairsUp/Stairs, and
/// yBase-FloorHeight for StairsDown. In both cases this means the stair also
/// occupies the SAME (x,y) column on `destFloor = Floor + StairFloorDelta`:
/// StairsUp/Stairs (delta +1) claims the floor ABOVE; StairsDown (delta -1)
/// claims the floor BELOW. Nothing enforced this before — this suite pins the
/// fix in both directions.
///
/// Uses the same not-in-the-tree MazeEditor3D pattern as TestTeleportPairs.cs
/// (IsValidPlacement is internal and doesn't touch _world). `_floor` is
/// private, so tests that need floor != 0 set it via reflection.
public partial class TestStairOverlap : Node
{
    int _fail;
    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + label);
        if (!ok) _fail++;
    }

    static void SetFloor(MazeEditor3D ed, int floor)
    {
        var fi = typeof(MazeEditor3D).GetField("_floor", BindingFlags.NonPublic | BindingFlags.Instance);
        fi!.SetValue(ed, floor);
    }

    static MazePiece P(PieceType t, int x, int y, int floor, int rot = 0) =>
        new MazePiece { Type = t, X = x, Y = y, Floor = floor, Rotation = rot };

    public override void _Ready()
    {
        GD.Print("── stair vertical-overlap placement rules ──");

        // ── A) stair-onto-occupied-airspace rejected ────────────────────────
        {
            var ed = new MazeEditor3D();
            ed._maze.Pieces.Add(P(PieceType.Straight, 5, 5, 1));   // occupies (5,5,F1)
            // StairsUp at (5,5,F0) -> destFloor = 1 -> claims (5,5,F1), occupied.
            Check(!ed.IsValidPlacement(5, 5, PieceType.StairsUp, 0, silent: true),
                  "StairsUp rot0 onto (5,5,F0) rejected: airspace (5,5,F1) already occupied");
            Check(!ed.IsValidPlacement(5, 5, PieceType.StairsUp, 2, silent: true),
                  "StairsUp rot2 onto (5,5,F0) rejected too (rotation doesn't change the claimed floor)");
        }
        {
            var ed = new MazeEditor3D();
            ed._maze.Pieces.Add(P(PieceType.Straight, 5, 5, -1));  // occupies (5,5,F-1)
            // StairsDown at (5,5,F0) -> destFloor = -1 -> claims (5,5,F-1), occupied.
            Check(!ed.IsValidPlacement(5, 5, PieceType.StairsDown, 0, silent: true),
                  "StairsDown rot0 onto (5,5,F0) rejected: airspace (5,5,F-1) already occupied");
            Check(!ed.IsValidPlacement(5, 5, PieceType.StairsDown, 1, silent: true),
                  "StairsDown rot1 onto (5,5,F0) rejected too (rotation doesn't change the claimed floor)");
        }

        // ── B) piece-into-stair-airspace rejected (the reciprocal direction) ─
        {
            var ed = new MazeEditor3D();
            // StairsUp at (5,5,F-1) -> destFloor = 0 -> claims (5,5,F0).
            ed._maze.Pieces.Add(P(PieceType.StairsUp, 5, 5, -1));
            Check(!ed.IsValidPlacement(5, 5, PieceType.Straight, 0, silent: true),
                  "Straight into (5,5,F0) rejected: claimed by StairsUp's airspace from F-1");
            Check(!ed.IsValidPlacement(5, 5, PieceType.Room, 0, silent: true),
                  "Room into (5,5,F0) rejected too — the rule is type-agnostic, not stair-only");
        }
        {
            var ed = new MazeEditor3D();
            // StairsDown at (5,5,F1) -> destFloor = 0 -> claims (5,5,F0).
            ed._maze.Pieces.Add(P(PieceType.StairsDown, 5, 5, 1));
            Check(!ed.IsValidPlacement(5, 5, PieceType.Straight, 0, silent: true),
                  "Straight into (5,5,F0) rejected: claimed by StairsDown's airspace from F1");
        }

        // ── C) legitimate placements still accepted ──────────────────────────
        {
            // Empty maze: a stair with a fully free column must still be valid
            // (floorCount == 0 also exempts it from the "must connect" rule).
            var ed = new MazeEditor3D();
            Check(ed.IsValidPlacement(5, 5, PieceType.StairsUp, 0, silent: true),
                  "StairsUp onto an empty maze/free column is still accepted");
        }
        {
            // A piece at the stair's actual CROSS-direction landing cell (a
            // DIFFERENT (x,y) on destFloor, not the same column) must remain
            // valid — this is the normal, intended way to connect to a stair.
            var ed = new MazeEditor3D();
            // StairsUp rot0 -> CrossDir = N -> landing cell is one step N of (5,5)
            // on destFloor(=1): (5,4,F1). Straight opens N|S by default, so its S
            // face already matches back toward the stair.
            ed._maze.Pieces.Add(P(PieceType.StairsUp, 5, 5, 0, rot: 0));
            SetFloor(ed, 1);
            Check(ed.IsValidPlacement(5, 4, PieceType.Straight, 0, silent: true),
                  "Straight at the stair's actual landing cell (5,4,F1) — a different column — is still accepted");
        }
        {
            // Sanity: the SAME (x,y) one floor further out (F2, beyond destFloor)
            // is unrelated to the claim and must be unaffected.
            var ed = new MazeEditor3D();
            ed._maze.Pieces.Add(P(PieceType.StairsUp, 5, 5, 0));   // claims (5,5,F1) only
            SetFloor(ed, 2);
            Check(ed.IsValidPlacement(5, 5, PieceType.Straight, 0, silent: true),
                  "Straight at (5,5,F2) is unaffected — only F1 (destFloor) is claimed, not F2");
        }

        GD.Print(_fail == 0 ? "RESULT OK" : $"RESULT {_fail} FAILURE(S)");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
