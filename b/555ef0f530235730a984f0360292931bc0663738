using Godot;
using System.Collections.Generic;
using System.Reflection;

/// test/TestSlotScroll.cs — the maze editor's 30-slot scrolling list.
/// Checks: the list keeps the old 5-button footprint, opening on a deep slot
/// lands with that slot in view, the wheel moves exactly one slot per notch and
/// clamps at both ends, and slots outside the window fade to nothing.
/// Throwaway account only (it writes maze slots):
///   ..._console.exe --path . --headless res://test/TestSlotScroll.tscn --account __test_slotscroll
/// Windowed (no --headless) it also saves slots_open.png / slots_mid.png /
/// slots_end.png to --shot <dir>.
public partial class TestSlotScroll : Node
{
    const string TestAccount = "__test_slotscroll";
    static readonly int[] Filled = { 0, 1, 2, 7, 12, 29 };

    MazeEditor3D _ed = null!;
    int _frame, _fails;
    string? _shotDir;

    public override void _Ready()
    {
        var args = OS.GetCmdlineUserArgs().Length > 0 ? OS.GetCmdlineUserArgs() : OS.GetCmdlineArgs();
        for (int i = 0; i < args.Length - 1; i++)
            if (args[i] == "--shot") _shotDir = args[i + 1];

        if (AccountManager.ActiveAccount != TestAccount)
        {
            GD.PushError($"Refusing to run: pass --account {TestAccount}");
            GetTree().Quit(2);
            return;
        }
        ClearSlots();
        foreach (int s in Filled)
            MazeSerializer.Save(s, new MazeData { Name = $"Test Maze {s + 1}", Pieces = new List<MazePiece>() });

        GameState.ActiveSlot = 12;   // open deep in the list
        _ed = GD.Load<PackedScene>("res://scenes/MazeEditor3D.tscn").Instantiate<MazeEditor3D>();
        AddChild(_ed);
    }

    T F<T>(string name) =>
        (T)typeof(MazeEditor3D).GetField(name, BindingFlags.NonPublic | BindingFlags.Instance)!.GetValue(_ed)!;

    void Wheel(bool up)
    {
        var mi = typeof(MazeEditor3D).GetMethod("OnSlotScrollInput", BindingFlags.NonPublic | BindingFlags.Instance)!;
        mi.Invoke(_ed, new object[] { new InputEventMouseButton
            { ButtonIndex = up ? MouseButton.WheelUp : MouseButton.WheelDown, Pressed = true } });
    }

    void Check(bool ok, string what)
    {
        GD.Print(ok ? "PASS  " : "FAIL  ", what);
        if (!ok) _fails++;
    }

    float ScrollNow => (float)F<ScrollContainer>("_slotScroll").GetVScrollBar().Value;
    float Target => F<float>("_slotScrollTarget");
    float Alpha(int i) => F<Button[]>("_slotBtns")[i].Modulate.A;

    void Shot(string name)
    {
        if (_shotDir == null || DisplayServer.GetName() == "headless") return;
        DirAccess.MakeDirRecursiveAbsolute(_shotDir);
        GetViewport().GetTexture().GetImage().SavePng($"{_shotDir}/{name}.png");
    }

    public override void _Process(double delta)
    {
        _frame++;
        const int Pitch = 54, ListH = 5 * 54 - 10, Max = 30 * 54 - 10 - ListH;

        if (_frame == 30)
        {
            var scroll = F<ScrollContainer>("_slotScroll");
            Check(Mathf.IsEqualApprox(scroll.Size.Y, ListH), $"list height {scroll.Size.Y} == old 5-button footprint {ListH}");
            Check(F<Button[]>("_slotBtns").Length == 30, "30 slot buttons");
            float top = 12 * Pitch;
            Check(Mathf.IsEqualApprox(ScrollNow, top - 2 * Pitch), $"opened with slot 13 centred (scroll {ScrollNow})");
            Check(Mathf.IsEqualApprox(ScrollNow, Target), "opening jumped straight there (no glide)");
            Check(Mathf.IsEqualApprox(ScrollNow % Pitch, 0f), "rests on a whole slot");
            Check(Alpha(12) > 0.99f, "current slot fully visible");
            Check(Alpha(0) < 0.01f, "slot 1 (far above) faded out");
            Check(F<Button[]>("_slotBtns")[3].GetThemeColor("font_color") != Colors.White, "empty slot is dimmed");
            Shot("slots_open");

            float before = Target;
            Wheel(up: true);
            Check(Mathf.IsEqualApprox(Target, before - Pitch), "one wheel notch = one slot");
        }
        if (_frame == 31)
            Check(ScrollNow > Target && ScrollNow < Target + Pitch, $"eases rather than jumps (mid-glide {ScrollNow})");
        if (_frame == 60)
        {
            Check(Mathf.IsEqualApprox(ScrollNow, Target), $"settled on target ({ScrollNow} vs {Target}, step {F<ScrollContainer>("_slotScroll").GetVScrollBar().Step})");
            // Park half a slot past a boundary to exercise the fade mid-way.
            F<ScrollContainer>("_slotScroll").GetVScrollBar().Value = Target + Pitch * 0.5f;
        }
        if (_frame == 61)
        {
            int partial = (int)(Target / Pitch);   // the slot sliding off the top
            float a = Alpha(partial);
            Check(a > 0.05f && a < 0.95f, $"a slot half out of the window is partly faded (a={a:0.00})");
            Shot("slots_mid");
            for (int i = 0; i < 40; i++) Wheel(up: true);
            Check(Target == 0f, "clamps at the top");
        }
        if (_frame == 90)
        {
            for (int i = 0; i < 40; i++) Wheel(up: false);
            Check(Mathf.IsEqualApprox(Target, Max), $"clamps at the bottom ({Target} == {Max})");
        }
        if (_frame == 130)
        {
            Check(Alpha(29) > 0.99f && Alpha(25) > 0.99f && Alpha(24) < 0.01f, "bottom window shows slots 26–30");
            Shot("slots_end");
            ClearSlots();
            GD.Print(_fails == 0 ? "ALL PASS" : $"{_fails} FAILED");
            GetTree().Quit(_fails == 0 ? 0 : 1);
        }
    }

    static void ClearSlots()
    {
        for (int i = 0; i < MazeSerializer.SlotCount; i++)
            DirAccess.RemoveAbsolute(ProjectSettings.GlobalizePath(AccountManager.MazeSlotPath(i)));
    }
}
