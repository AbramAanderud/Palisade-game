    Vector3 _puppetTargetPos   = Vector3.Zero;
    Vector3 _puppetTargetVel   = Vector3.Zero;
    float   _puppetTargetYaw   = 0f;
    float   _puppetTargetPitch = 0f;
    ulong   _puppetReceiveMs   = 0;   // local Time.GetTicksMsec at receive
    bool    _puppetHasTarget   = false;

    const float PuppetExtrapolateCapSec = 0.2f;   // cap forward prediction at 200 ms
    const float PuppetSnapDistance      = 2.0f;   // snap if extrapolated target drifts > 2 m

    /// Set puppet target with velocity for extrapolation. Velocity is in world units/sec.
    public void SetPuppetTarget(Vector3 pos, Vector3 velocity, float yaw, float pitch)
    {
        _puppetTargetPos   = pos;
        _puppetTargetVel   = velocity;
        _puppetTargetYaw   = yaw;
        _puppetTargetPitch = pitch;
        _puppetReceiveMs   = Time.GetTicksMsec();
        _puppetHasTarget   = true;
    }

    /// The opponent's last self-reported position (puppets only). Hit claims are
    /// stamped with THIS, not the puppet's rendered position — the render is an
    /// extrapolated guess, but this is a spot the victim's client actually
    /// broadcast, so their validation can hold a tight tolerance.
    public Vector3 PuppetLastNetPos => _puppetTargetPos;

    // ── Position history (victim-side hit validation) ─────────────────────────
    // The local body's recent positions, sampled every physics tick. When a hit
    // claim arrives over the relay it names where the shooter saw us; if we were
    // never near that spot inside the window, the claim is too stale to honour.
    // 750 ms: must cover one-way relay latency — the claim names a position the
    // victim broadcast ~latency ago. At 300 ms every moving-target hit through
    // a slow Render relay was rejected, which playtested as "guns do no damage".
    const float HitClaimWindowMs  = 750f;
    const float HitClaimTolerance = 1.5f;   // metres, centre-to-centre
    readonly (ulong ms, Vector3 pos)[] _posHistory = new (ulong, Vector3)[48];
    int _posHistoryIdx = 0;

    void RecordPosHistory()
    {
        _posHistory[_posHistoryIdx] = (Time.GetTicksMsec(), GlobalPosition);
        _posHistoryIdx = (_posHistoryIdx + 1) % _posHistory.Length;
    }

    /// Was this body within HitClaimTolerance of `claimed` at any point in the
    /// last HitClaimWindowMs? Entries with ms == 0 are unfilled slots.
    public bool WasRecentlyNear(Vector3 claimed)
    {
        ulong now = Time.GetTicksMsec();
        foreach (var (ms, pos) in _posHistory)
        {
            if (ms == 0 || now - ms > (ulong)HitClaimWindowMs) continue;
            if (pos.DistanceTo(claimed) <= HitClaimTolerance) return true;
        }
        return false;
    }

