    /// Show this puppet firing — the opponent shot on their machine, so play the
    /// shoot pose and a muzzle flash on our screen. Damage arrives separately via
    /// the existing {"t":"hit"} relay, so this is purely cosmetic.
    // ── Puppet movement audio ─────────────────────────────────────────────────
    // The local player's step/jump/land sounds are NON-positional (they're your
    // own body) and fire from code paths a puppet never runs. The opponent's
    // version is derived here from the relayed velocity stream and played
    // through positional emitters on the puppet, so you can HEAR where they are
    // and what their feet are doing — the classic info channel of every shooter.
    AudioStreamPlayer3D? _puppetStepSfx, _puppetJumpSfx, _puppetLandSfx;
    AudioStream? _puppetWalkStream, _puppetRunStream;
    float _puppetStepDist, _puppetPrevVy;

    void TickPuppetAudio(float dt)
    {
        if (_puppetStepSfx == null)
        {
            AudioStreamPlayer3D Mk(float maxDist)
            {
                var p = new AudioStreamPlayer3D { MaxDistance = maxDist };
                AddChild(p);
                return p;
            }
            _puppetStepSfx    = Mk(22f);
            _puppetJumpSfx    = Mk(26f);
            _puppetLandSfx    = Mk(30f);
            _puppetWalkStream = GD.Load<AudioStream>("res://assets/audio/sfx/movement/Walk.wav");
            _puppetRunStream  = GD.Load<AudioStream>("res://assets/audio/sfx/movement/Run.wav");
            if (ResourceLoader.Exists("res://assets/audio/sfx/movement/Jump.wav"))
                _puppetJumpSfx.Stream = GD.Load<AudioStream>("res://assets/audio/sfx/movement/Jump.wav");
            if (ResourceLoader.Exists("res://assets/audio/sfx/movement/Land.wav"))
                _puppetLandSfx.Stream = GD.Load<AudioStream>("res://assets/audio/sfx/movement/Land.wav");
        }

        float vy   = _puppetTargetVel.Y;
        float hSpd = new Vector2(_puppetTargetVel.X, _puppetTargetVel.Z).Length();
        bool  grounded = Mathf.Abs(vy) < 1.5f;   // no real floor query on a mirror

        // Footsteps by distance travelled, like a real cadence — not a timer, so
        // a slow walk ticks slowly and a sprint drums.
        if (grounded && hSpd > 0.8f)
        {
            _puppetStepDist += hSpd * dt;
            if (_puppetStepDist >= 2.6f)
            {
                _puppetStepDist = 0f;
                var stream = hSpd > 7f ? _puppetRunStream : _puppetWalkStream;
                if (stream != null && _puppetStepSfx != null)
                {
                    _puppetStepSfx.Stream = stream;
                    _puppetStepSfx.Play();
                }
            }
        }
        else if (!grounded) _puppetStepDist = 0f;

        // Jump on the rising edge, land on the fall arrest.
        if (vy > 4.5f && _puppetPrevVy <= 4.5f) _puppetJumpSfx?.Play();
        if (_puppetPrevVy < -4f && vy > -0.5f)  _puppetLandSfx?.Play();
        _puppetPrevVy = vy;
    }

    public void TriggerPuppetShot() => TriggerPuppetShot(null);

    /// Replay the opponent's shot on THIS client with the same visual language
    /// they saw: pose, flash, tracer/casing for hitscan, backblast + a cosmetic
    /// projectile for rockets. `endPoint` is the relayed ray end; without it
    /// (older peer, dropped field) we still show pose + flash.
    public void TriggerPuppetShot(Vector3? endPoint)
    {
        _animator.PlayShoot();
        SpawnPuppetMuzzleFlash();
        PulseTpShot();
        // Their gunshot, from their position, through their gun's own 3D emitter
        // — distance attenuation and the per-gun report come free.
        _combat?.PlayFireSfx();

        if (endPoint == null || _combat == null) return;

        var muzzle = GetMuzzleWorldPoint();
        var dir    = (endPoint.Value - muzzle).Normalized();
        if (dir.LengthSquared() < 0.5f) return;

        var def = _combat.Def;
        if (def.Mode == GunCombat.FireMode.Projectile)
        {
            GunFx.Backblast(this, muzzle, dir);
            var r = Rocket.Spawn(GetTree().Root, muzzle + dir * 0.3f, dir, def, _combat);
            r.CosmeticOnly = true;   // damage already travels on the hit relay
        }
        else
        {
            GunFx.Tracer(this, muzzle, endPoint.Value);
            GunFx.Casing(this, muzzle, dir);
        }
    }

