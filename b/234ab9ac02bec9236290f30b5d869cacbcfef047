        var root = new Node3D { Name = "FpArms", Visible = false };

        // Right forearm — grips the sword
        var rFore = new MeshInstance3D
        {
            Mesh             = new CapsuleMesh { Radius = 0.042f, Height = 0.36f },
            Position         = new(0.30f, -0.52f, -0.32f),
