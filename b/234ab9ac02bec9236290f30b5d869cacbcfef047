        lHand.SetSurfaceOverrideMaterial(0, gauntletMat);
        root.AddChild(lHand);

        return root;
    }

    public void TriggerDeath()
    {
        if (_isDead) return;
        _isDead = true;
        _animator.PlayDeath();
    }

    public void ReleaseMouse() => Input.MouseMode = Input.MouseModeEnum.Visible;
    public Camera3D Camera    => _cam;

    /// True while the third-person camera is the active one.
    public bool     TpMode       => _tpMode;
    /// The camera actually rendering, which is what the HUD must project through.
    public Camera3D ActiveCamera => _tpMode ? _tpCam : _cam;
    /// World point the current shot would land on. Only updated in third person
    /// (see UpdateAimPoint) - in first person the aim ray IS the view ray, so a
    /// screen-centred reticle is already exactly right and this is not needed.
    public Vector3  AimPoint     { get; private set; }

    /// Traces the aim ray so the third-person reticle can sit on the point the
    /// shot will actually hit. The aim ray still comes from the FP camera at the
    /// player's head - that is what GunCombat fires along - while the visible
    /// camera sits behind and above, so screen centre and the real impact point
    /// are different places on screen.
    void UpdateAimPoint()
    {
        var origin = _cam.GlobalPosition;
        var dir    = -_cam.GlobalTransform.Basis.Z;
        var query  = PhysicsRayQueryParameters3D.Create(origin, origin + dir * AimTraceLen);
        query.Exclude = new Godot.Collections.Array<Rid> { GetRid() };
        var hit = GetWorld3D().DirectSpaceState.IntersectRay(query);
        AimPoint = hit.Count > 0 ? (Vector3)hit["position"] : origin + dir * AimTraceLen;
    }
