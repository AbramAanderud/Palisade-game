        root.AddChild(rHand);

        // Left forearm — supporting hand lower and further away
        var lFore = new MeshInstance3D
        {
            Mesh            = new CapsuleMesh { Radius = 0.040f, Height = 0.33f },
            Position        = new(-0.18f, -0.60f, -0.38f),
