using System;
using Godot;

/// Training mode setup screen: pick dummy count (1-10) and bot difficulty, then start.
public partial class TrainingSetupScreen : Control
{
    const float BtnH      = 52f;
    const float CornerPad = 36f;
    const float StartBtnW = 220f;

    // Start Training is the screen's affirmative action, so it gets an accent
    // colour instead of MakeBtn's default white. Mirrors MenuUI's Back trio
    // (base / brighter on hover / darker on press) so the two corner buttons
    // read as a matched pair: red to leave, green to go.
    static readonly Color StartColor        = new(0.20f, 0.80f, 0.30f);
    static readonly Color StartHoverColor   = new(0.42f, 1.00f, 0.50f);
    static readonly Color StartPressedColor = new(0.12f, 0.50f, 0.18f);

    static readonly string[] DiffNames = { "Passive", "Easy", "Normal", "Hard" };

    int                _dummyCount  = 1;
    Label              _countLabel  = null!;
    int                _difficulty  = (int)TrainingConfig.Difficulty.Normal;
    Label              _diffLabel   = null!;

    // Weapon picker. Index 0 is "Random" (roll the starter pool like a real
    // match); the rest are every gun in GunCombat.Defs, so training doubles as a
    // range for the arena guns you would otherwise have to win a race to hold.
    // internal (not private) so GunSwitcher.cs can reuse the same id list / display
    // names for the in-game weapon wheel instead of rebuilding them.
    internal static readonly string[] GunIds = BuildGunIds();
    int                _gunIdx      = 0;
    Label              _gunLabel    = null!;

    static string[] BuildGunIds()
    {
        var ids = new System.Collections.Generic.List<string> { TrainingConfig.RandomGun };
        ids.AddRange(GunCombat.StarterPool);
        ids.AddRange(GunCombat.ArenaPool);
        return ids.ToArray();
    }

    internal static string GunDisplay(string id) =>
        id == TrainingConfig.RandomGun ? "Random"
        : GunCombat.Defs.TryGetValue(id, out var d) ? d.Display
        : id;

    // Switch Guns toggle. Off by default, like every other row — this screen never
    // remembers the previous visit's choices.
    bool               _allowGunSwitch = false;
    Label              _switchLabel    = null!;
    FontFile?          _font;
    AudioStreamPlayer? _clickSfx;
    bool _changingScene = false;
    AudioStreamPlayer? _playGameSfx;

    public override void _Ready()
    {
        Input.MouseMode = Input.MouseModeEnum.Visible;
        SetAnchorsPreset(LayoutPreset.FullRect);
        GrowHorizontal = GrowDirection.Both;
        GrowVertical   = GrowDirection.Both;

        _font = GD.Load<FontFile>("res://assets/fonts/Agmena Pro Book.ttf");

        _clickSfx = new AudioStreamPlayer();
        var clickStream = GD.Load<AudioStream>("res://assets/audio/ui/MenuButtonClick.wav");
        if (clickStream != null) _clickSfx.Stream = clickStream;
        AddChild(_clickSfx);

        _playGameSfx = new AudioStreamPlayer();
        var playStream = GD.Load<AudioStream>("res://assets/audio/ui/PlayGameButtonNoise.wav");
        if (playStream != null) _playGameSfx.Stream = playStream;
        AddChild(_playGameSfx);

        var bg = new ColorRect { Color = Colors.Black };
        bg.SetAnchorsPreset(LayoutPreset.FullRect);
        AddChild(bg);

        // Centre column
        var outer = new VBoxContainer();
        outer.SetAnchorsPreset(LayoutPreset.FullRect);
        outer.AddThemeConstantOverride("separation", 0);
        AddChild(outer);

        outer.AddChild(VSpacer());

        var hrow = new HBoxContainer();
        hrow.AddThemeConstantOverride("separation", 0);
        outer.AddChild(hrow);
        hrow.AddChild(HSpacer());

        var vbox = new VBoxContainer();
        vbox.CustomMinimumSize = new Vector2(480, 0);
        vbox.AddThemeConstantOverride("separation", 0);
        hrow.AddChild(vbox);
        hrow.AddChild(HSpacer());

        for (int i = 0; i < 3; i++) outer.AddChild(VSpacer());

        // Title
        var title = new Label { Text = "TRAINING", HorizontalAlignment = HorizontalAlignment.Center };
        if (_font != null) title.AddThemeFontOverride("font", _font);
        title.AddThemeFontSizeOverride("font_size", 96);
        title.AddThemeColorOverride("font_color", Colors.White);
        vbox.AddChild(title);

        vbox.AddChild(new Control { CustomMinimumSize = new Vector2(0, 40) });

        // ── Dummy count row ───────────────────────────────────────────────────
        var countRow = new HBoxContainer();
        countRow.AddThemeConstantOverride("separation", 0);
        countRow.CustomMinimumSize = new Vector2(0, BtnH);
        vbox.AddChild(countRow);

        var countLabelLeft = new Label
        {
            Text                = "Dummies",
            HorizontalAlignment = HorizontalAlignment.Right,
            VerticalAlignment   = VerticalAlignment.Center,
            SizeFlagsHorizontal = SizeFlags.ExpandFill,
        };
        if (_font != null) countLabelLeft.AddThemeFontOverride("font", _font);
        countLabelLeft.AddThemeFontSizeOverride("font_size", 26);
        countLabelLeft.AddThemeColorOverride("font_color", Colors.White);
        countRow.AddChild(countLabelLeft);

        countRow.AddChild(new Control { CustomMinimumSize = new Vector2(20, 0) });

        var minusBtn = MakeBtn("−", _font, 30, () => SetCount(_dummyCount - 1));
        minusBtn.CustomMinimumSize = new Vector2(BtnH, BtnH);
        minusBtn.Pressed += () => _clickSfx?.Play();
        countRow.AddChild(minusBtn);

        _countLabel = new Label
        {
            Text                = $"{_dummyCount}",
            HorizontalAlignment = HorizontalAlignment.Center,
            VerticalAlignment   = VerticalAlignment.Center,
            CustomMinimumSize   = new Vector2(64, BtnH),
        };
        if (_font != null) _countLabel.AddThemeFontOverride("font", _font);
        _countLabel.AddThemeFontSizeOverride("font_size", 30);
        _countLabel.AddThemeColorOverride("font_color", Colors.White);
        countRow.AddChild(_countLabel);

        var plusBtn = MakeBtn("+", _font, 30, () => SetCount(_dummyCount + 1));
        plusBtn.CustomMinimumSize = new Vector2(BtnH, BtnH);
        plusBtn.Pressed += () => _clickSfx?.Play();
        countRow.AddChild(plusBtn);

        vbox.AddChild(new Control { CustomMinimumSize = new Vector2(0, 16) });

        // ── Difficulty row ────────────────────────────────────────────────────
        var diffRow = new HBoxContainer();
        diffRow.AddThemeConstantOverride("separation", 0);
        diffRow.CustomMinimumSize = new Vector2(0, BtnH);
        vbox.AddChild(diffRow);

        var diffLabelLeft = new Label
        {
            Text                = "Difficulty",
            HorizontalAlignment = HorizontalAlignment.Right,
            VerticalAlignment   = VerticalAlignment.Center,
            SizeFlagsHorizontal = SizeFlags.ExpandFill,
        };
        if (_font != null) diffLabelLeft.AddThemeFontOverride("font", _font);
        diffLabelLeft.AddThemeFontSizeOverride("font_size", 26);
        diffLabelLeft.AddThemeColorOverride("font_color", Colors.White);
        diffRow.AddChild(diffLabelLeft);

        diffRow.AddChild(new Control { CustomMinimumSize = new Vector2(20, 0) });

        var diffMinus = MakeBtn("−", _font, 30, () => SetDifficulty(_difficulty - 1));
        diffMinus.CustomMinimumSize = new Vector2(BtnH, BtnH);
        diffMinus.Pressed += () => _clickSfx?.Play();
        diffRow.AddChild(diffMinus);

        _diffLabel = new Label
        {
            Text                = DiffNames[_difficulty],
            HorizontalAlignment = HorizontalAlignment.Center,
            VerticalAlignment   = VerticalAlignment.Center,
            CustomMinimumSize   = new Vector2(150, BtnH),
        };
        if (_font != null) _diffLabel.AddThemeFontOverride("font", _font);
        _diffLabel.AddThemeFontSizeOverride("font_size", 30);
        _diffLabel.AddThemeColorOverride("font_color", Colors.White);
        diffRow.AddChild(_diffLabel);

        var diffPlus = MakeBtn("+", _font, 30, () => SetDifficulty(_difficulty + 1));
        diffPlus.CustomMinimumSize = new Vector2(BtnH, BtnH);
        diffPlus.Pressed += () => _clickSfx?.Play();
        diffRow.AddChild(diffPlus);

        // ── Weapon row ────────────────────────────────────────────────────────
        var gunRow = new HBoxContainer();
        gunRow.AddThemeConstantOverride("separation", 0);
        gunRow.CustomMinimumSize = new Vector2(0, BtnH);
        vbox.AddChild(gunRow);

        var gunLabelLeft = new Label
        {
            Text                = "Weapon",
            HorizontalAlignment = HorizontalAlignment.Right,
            VerticalAlignment   = VerticalAlignment.Center,
            SizeFlagsHorizontal = SizeFlags.ExpandFill,
        };
        if (_font != null) gunLabelLeft.AddThemeFontOverride("font", _font);
        gunLabelLeft.AddThemeFontSizeOverride("font_size", 26);
        gunLabelLeft.AddThemeColorOverride("font_color", Colors.White);
        gunRow.AddChild(gunLabelLeft);

        gunRow.AddChild(new Control { CustomMinimumSize = new Vector2(20, 0) });

        var gunMinus = MakeBtn("−", _font, 30, () => SetGun(_gunIdx - 1));
        gunMinus.CustomMinimumSize = new Vector2(BtnH, BtnH);
        gunMinus.Pressed += () => _clickSfx?.Play();
        gunRow.AddChild(gunMinus);

        _gunLabel = new Label
        {
            Text                = GunDisplay(GunIds[_gunIdx]),
            HorizontalAlignment = HorizontalAlignment.Center,
            VerticalAlignment   = VerticalAlignment.Center,
            CustomMinimumSize   = new Vector2(220, BtnH),
        };
        if (_font != null) _gunLabel.AddThemeFontOverride("font", _font);
        _gunLabel.AddThemeFontSizeOverride("font_size", 30);
        _gunLabel.AddThemeColorOverride("font_color", Colors.White);
        gunRow.AddChild(_gunLabel);

        var gunPlus = MakeBtn("+", _font, 30, () => SetGun(_gunIdx + 1));
        gunPlus.CustomMinimumSize = new Vector2(BtnH, BtnH);
        gunPlus.Pressed += () => _clickSfx?.Play();
        gunRow.AddChild(gunPlus);

        vbox.AddChild(new Control { CustomMinimumSize = new Vector2(0, 16) });

        // ── Switch Guns row ──────────────────────────────────────────────────
        var switchRow = new HBoxContainer();
        switchRow.AddThemeConstantOverride("separation", 0);
        switchRow.CustomMinimumSize = new Vector2(0, BtnH);
        vbox.AddChild(switchRow);

        var switchLabelLeft = new Label
        {
            Text                = "Switch Guns",
            HorizontalAlignment = HorizontalAlignment.Right,
            VerticalAlignment   = VerticalAlignment.Center,
            SizeFlagsHorizontal = SizeFlags.ExpandFill,
        };
        if (_font != null) switchLabelLeft.AddThemeFontOverride("font", _font);
        switchLabelLeft.AddThemeFontSizeOverride("font_size", 26);
        switchLabelLeft.AddThemeColorOverride("font_color", Colors.White);
        switchRow.AddChild(switchLabelLeft);

        switchRow.AddChild(new Control { CustomMinimumSize = new Vector2(20, 0) });

        // Two states only, so both − and + just flip it — keeps the row's look
        // consistent with Dummies/Difficulty/Weapon instead of a one-off CheckButton.
        var switchMinus = MakeBtn("−", _font, 30, () => SetSwitchGuns(!_allowGunSwitch));
        switchMinus.CustomMinimumSize = new Vector2(BtnH, BtnH);
        switchMinus.Pressed += () => _clickSfx?.Play();
        switchRow.AddChild(switchMinus);

        _switchLabel = new Label
        {
            Text                = _allowGunSwitch ? "ON" : "OFF",
            HorizontalAlignment = HorizontalAlignment.Center,
            VerticalAlignment   = VerticalAlignment.Center,
            CustomMinimumSize   = new Vector2(150, BtnH),
        };
        if (_font != null) _switchLabel.AddThemeFontOverride("font", _font);
        _switchLabel.AddThemeFontSizeOverride("font_size", 30);
        _switchLabel.AddThemeColorOverride("font_color", Colors.White);
        switchRow.AddChild(_switchLabel);

        var switchPlus = MakeBtn("+", _font, 30, () => SetSwitchGuns(!_allowGunSwitch));
        switchPlus.CustomMinimumSize = new Vector2(BtnH, BtnH);
        switchPlus.Pressed += () => _clickSfx?.Play();
        switchRow.AddChild(switchPlus);

        vbox.AddChild(new Control { CustomMinimumSize = new Vector2(0, 32) });

        // ── Bottom-right: Start Training ──────────────────────────────────────
        var startBtn = MakeBtn("Start Training", _font, 26, OnStart);
        startBtn.CustomMinimumSize = new Vector2(StartBtnW, BtnH);
        // Anchored to the RIGHT edge and grown inward, so the button stays pinned
        // to the corner at any window size rather than drifting with the layout.
        startBtn.AnchorLeft     = 1f;  startBtn.AnchorRight  = 1f;
        startBtn.AnchorTop      = 1f;  startBtn.AnchorBottom = 1f;
        startBtn.GrowHorizontal = GrowDirection.Begin;
        startBtn.GrowVertical   = GrowDirection.Begin;
        startBtn.OffsetLeft     = -(CornerPad + StartBtnW);
        startBtn.OffsetRight    = -CornerPad;
        startBtn.OffsetTop      = -(CornerPad + BtnH);
        startBtn.OffsetBottom   = -CornerPad;
        // Applied after MakeBtn, which sets the default white/grey trio.
        startBtn.AddThemeColorOverride("font_color",         StartColor);
        startBtn.AddThemeColorOverride("font_hover_color",   StartHoverColor);
        startBtn.AddThemeColorOverride("font_pressed_color", StartPressedColor);
        startBtn.AddThemeColorOverride("font_focus_color",   StartColor);
        AddChild(startBtn);

        // ── Top-left: Back ────────────────────────────────────────────────────
        // Placement and colour live in MenuUI so every menu tab shares them.
        // Click SFX is played inside OnBack — keeping it as a separate handler
        // races with the scene change and logs "node not inside scene tree".
        MenuUI.AddBackButton(this, _font, OnBack);
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    void SetCount(int v)
    {
        _dummyCount      = Mathf.Clamp(v, 1, 10);
        _countLabel.Text = $"{_dummyCount}";
    }

    void SetDifficulty(int v)
    {
        int n           = DiffNames.Length;
        _difficulty     = ((v % n) + n) % n;   // wrap around (Hard → Passive and back)
        _diffLabel.Text = DiffNames[_difficulty];
    }

    void SetGun(int v)
    {
        int n          = GunIds.Length;
        _gunIdx        = ((v % n) + n) % n;   // wrap both directions
        _gunLabel.Text = GunDisplay(GunIds[_gunIdx]);
    }

    void SetSwitchGuns(bool v)
    {
        _allowGunSwitch   = v;
        _switchLabel.Text = _allowGunSwitch ? "ON" : "OFF";
    }

    void OnStart()
    {
        if (_changingScene) return;
        _changingScene = true;
        TrainingConfig.DummyCount      = _dummyCount;
        TrainingConfig.Level           = (TrainingConfig.Difficulty)_difficulty;
        TrainingConfig.Gun             = GunIds[_gunIdx];
        TrainingConfig.AllowGunSwitch  = _allowGunSwitch;
        _playGameSfx?.Play();
        GetTree().CreateTimer(0.5).Timeout += () =>
            GetTree().ChangeSceneToFile("res://scenes/TrainingArena.tscn");
    }

    void OnBack()
    {
        if (_changingScene) return;
        _changingScene = true;
        _clickSfx?.Play();
        GetTree().ChangeSceneToFile("res://scenes/TitleScreen.tscn");
    }

    static Control VSpacer() =>
        new Control { SizeFlagsVertical = SizeFlags.ExpandFill };

    static Control HSpacer() =>
        new Control { SizeFlagsHorizontal = SizeFlags.ExpandFill };

    static Button MakeBtn(string label, FontFile? font, int fontSize, Action pressed)
    {
        var btn = new Button
        {
            Text              = label,
            Flat              = true,
            Alignment         = HorizontalAlignment.Center,
            CustomMinimumSize = new Vector2(0, 52f),
        };
        if (font != null) btn.AddThemeFontOverride("font", font);
        btn.AddThemeFontSizeOverride("font_size", fontSize);
        btn.AddThemeColorOverride("font_color",         Colors.White);
        btn.AddThemeColorOverride("font_hover_color",   new Color(0.6f, 0.6f, 0.6f));
        btn.AddThemeColorOverride("font_pressed_color", new Color(0.4f, 0.4f, 0.4f));
        btn.AddThemeColorOverride("font_focus_color",   Colors.White);

        var empty = new StyleBoxEmpty();
        btn.AddThemeStyleboxOverride("normal",   empty);
        btn.AddThemeStyleboxOverride("hover",    empty);
        btn.AddThemeStyleboxOverride("pressed",  empty);
        btn.AddThemeStyleboxOverride("focus",    empty);
        btn.AddThemeStyleboxOverride("disabled", empty);

        btn.Pressed += pressed;
        return btn;
    }
}
