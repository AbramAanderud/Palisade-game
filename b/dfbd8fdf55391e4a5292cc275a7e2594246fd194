```csharp
    // ── Room painting ─────────────────────────────────────────────────────────
    // Click one cell, then a second: every cell in the rectangle between them
    // becomes an independent Room tile. Painting over an existing piece replaces
    // it. Cells that already hold a Room are left alone, so overlapping drags
    // extend a room instead of churning it.
    void PaintRoomRect(int ax, int ay, int bx, int by)
    {
        int x0 = Mathf.Min(ax, bx), x1 = Mathf.Max(ax, bx);
        int y0 = Mathf.Min(ay, by), y1 = Mathf.Max(ay, by);

        int painted = 0;
        for (int x = x0; x <= x1; x++)
        {
            for (int y = y0; y <= y1; y++)
            {
                if (x < 0 || x >= GW || y < 0 || y >= GH) continue;

                // Already a Room here on this floor — nothing to do.
                if (TryGetPlacedPieceOnFloor(x, y, _floor, out var existing) &&
                    existing.Type == PieceType.Room)
                    continue;

                // Never paint over Start or Exit; they are unique and row-locked.
                if (existing != null &&
                    (existing.Type == PieceType.Start || existing.Type == PieceType.Exit))
                    continue;

                RemovePiece(x, y);

                _maze.Pieces.Add(new MazePiece
                {
                    X = x, Y = y, Floor = _floor, Type = PieceType.Room, Rotation = 0,
                });
                painted++;
            }
        }

        RebuildGeometry();
        RebuildBorderHints();
        _clickSfx?.Play();
        SetStatus(painted > 0
            ? $"Painted {painted} room tile(s)  —  {(x1 - x0 + 1)}x{(y1 - y0 + 1)}"
            : "No new room tiles — that area is already open.");
    }

    /// Cancels a half-finished room drag.
    void CancelRoomPaint()
    {
        if (_roomAnchor == null) return;
        _roomAnchor = null;
        UpdateHoverHighlight();
        SetStatus("Room corner cleared.");
    }
