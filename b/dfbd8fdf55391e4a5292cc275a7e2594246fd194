```csharp
using System.Collections.Generic;
using System.Linq;
using Godot;

/// res://scripts/PitBuilder.cs — Geometry for one 3x3 vertical shaft.
///
/// A Pit is stored as ONE MazePiece at the shaft's centre cell. It claims a 3x3
/// footprint across three floors (anchor floor, one up, one down), clipped to the
/// world's floor range: a pit placed at the top floor simply loses its upper level
/// and stays valid.
///
/// The ENTIRE 3x3 is open shaft. Any cell face on the shaft's perimeter, on any
/// occupied floor, with a piece pointing at it becomes a floating doorway — you
/// step through it into thin air. That is the intended feel.
///
/// The pit deals NO damage. It is a traversal piece: you drop, you land, you walk
/// out through a doorway at the bottom level. Do not add damage here.
///
/// ⚠️ MESH SPLITTING — READ BEFORE IMPLEMENTING.
/// The single-SurfaceTool-per-shaft structure sketched below is WRONG and must not be
/// implemented as written. DungeonBuilder.cs:156-160 documents why:
///
///   "GL selects the closest max_lights_per_object lights relative to each mesh
///    object's bounding-box center. A 100m x 100m merged floor mesh has only its
///    CENTER lit; corner cells go dark."
///
/// A pit is 30m x 30m across and up to 54m tall — the worst case in the whole game for
/// this. One merged mesh would light only the shaft's centre and leave every corner
/// black. RoomBuilder already hit this exact bug and was fixed to emit geometry PER CELL.
///
/// Do the same here: emit one StaticBody3D per (footprint cell, occupied floor), named
/// `Cell_{x}_{y}_{floor}` to match DungeonBuilder.BuildFloor's convention, each carrying
/// its own floor/wall/ceiling meshes. The shaft bottom splits across its 9 cells; each
/// wall segment already belongs to exactly one cell and floor; the vault cap splits
/// across the top level's 9 cells.
///
/// This changes only how triangles are PACKAGED, never which triangles are generated or
/// where their vertices sit. In particular ArchY must still receive the full 30m shaft
/// span (x0..x1), never a single cell's extent, or the vault cap develops a ridge at
/// every cell seam.
public static class PitBuilder
{
    const float CS = DungeonBuilder.CellSize;
    const float FH = DungeonBuilder.FloorHeight;
    const float HW = DungeonBuilder.OpeningW * 0.5f;   // 3 m — half doorway width

    /// Doorway opening height, matching the room treatment so the two read as a set.
    const float DoorH = RoomBuilder.RoomDoorH;

    static readonly Dir[] Faces = { Dir.N, Dir.E, Dir.S, Dir.W };

    /// Floors this pit actually occupies, clipped to [floorMin, floorMax].
    /// Ascending order. Always contains at least the anchor floor.
    public static int[] OccupiedFloors(int anchorFloor, int floorMin, int floorMax)
        => PieceDB.FloorSpan(PieceType.Pit)
            .Select(d => anchorFloor + d)
            .Where(f => f >= floorMin && f <= floorMax)
            .OrderBy(f => f)
            .ToArray();

    /// True when this pit's clipped volume covers cell (x, y) on `floor`.
    public static bool Occupies(MazePiece pit, int x, int y, int floor,
                                int floorMin, int floorMax)
    {
        if (pit.Type != PieceType.Pit) return false;
        if (!OccupiedFloors(pit.Floor, floorMin, floorMax).Contains(floor)) return false;
        return PieceDB.Footprint(PieceType.Pit)
            .Any(o => pit.X + o.dx == x && pit.Y + o.dy == y);
    }

    /// Builds one pit into `owner` as a single StaticBody3D.
    public static void Build(DungeonBuilder owner, MazePiece pit,
                             Dictionary<(int, int, int), MazePiece> lookup,
                             int floorMin, int floorMax)
    {
        int[] floors = OccupiedFloors(pit.Floor, floorMin, floorMax);
        if (floors.Length == 0) return;

        int botFloor = floors[0];
        int topFloor = floors[^1];

        // World-space extents of the 3x3 footprint.
        float x0 = (pit.X - 1) * CS, x1 = (pit.X + 2) * CS;
        float z0 = (pit.Y - 1) * CS, z1 = (pit.Y + 2) * CS;
        float yBot = botFloor * FH;

        var wallST  = DungeonBuilder.MakeST();
        var floorST = DungeonBuilder.MakeST();
        var ceilST  = DungeonBuilder.MakeST();

        // ── Shaft bottom ──────────────────────────────────────────────────────
        // Solid landing at the lowest occupied floor. Free traversal: you land here
        // unhurt and walk out through a bottom-level doorway.
        DungeonBuilder.Quad(floorST, new(x0, yBot, z0), new(x1, yBot, z0),
                                     new(x1, yBot, z1), new(x0, yBot, z1));

        // ── Shaft walls, one segment per perimeter cell face per floor ────────
        // Segmenting per cell (rather than one 30 m plane per side) is what makes
        // punching doorways cheap: a segment is either solid or a doorway.
        foreach (int f in floors)
        {
            float fy0 = f * FH;
            float fy1 = fy0 + FH;

            foreach (var (dx, dy) in PieceDB.Footprint(PieceType.Pit))
            {
                int cx = pit.X + dx, cy = pit.Y + dy;

                foreach (var face in Faces)
                {
                    if (!IsPerimeterFace(dx, dy, face)) continue;   // interior of the 3x3
                    bool door = HasEntry(lookup, pit, cx, cy, f, face, floorMin, floorMax);
                    AddWallSegment(wallST, cx, cy, fy0, fy1, face, door);
                }
            }
        }

        // ── Vault cap ─────────────────────────────────────────────────────────
        // Same arch treatment as a room, spanning the full 30 m of the shaft, so the
        // two new piece types share one ceiling language.
        AddVaultCap(ceilST, x0, z0, x1, z1, topFloor * FH);

        var body = new StaticBody3D { Name = $"Pit_{pit.X}_{pit.Y}_{pit.Floor}" };
        owner.AddChild(body);
        // The "Floor" PREFIX IS LOAD-BEARING: DungeonBuilder.AddMesh picks the material
        // with name.StartsWith("Floor") || name.StartsWith("Stair"). A name like
        // "PitFloor_…" starts with "Pit" and would silently get the WALL material.
        // This exact bug already shipped once in RoomBuilder — do not reintroduce it.
        owner.AddMesh(body, DungeonBuilder.Commit(floorST), $"FloorPit_{pit.X}_{pit.Y}", default);
        owner.AddMesh(body, DungeonBuilder.Commit(wallST),  $"WallPit_{pit.X}_{pit.Y}",  default);
        owner.AddMesh(body, DungeonBuilder.Commit(ceilST),  $"CeilPit_{pit.X}_{pit.Y}",  default);
    }

    /// True when the given face of footprint offset (dx, dy) is on the 3x3's outer edge.
    static bool IsPerimeterFace(int dx, int dy, Dir face) => face switch
    {
        Dir.N => dy == -1,
        Dir.S => dy ==  1,
        Dir.W => dx == -1,
        _     => dx ==  1,
    };

    /// True when a piece outside the pit points at this face on this floor.
    /// Any piece with a matching opening qualifies — the requirement is
    /// "any slot that could be connected is valid".
    static bool HasEntry(Dictionary<(int, int, int), MazePiece> lookup, MazePiece pit,
                         int cx, int cy, int floor, Dir face, int floorMin, int floorMax)
    {
        var (dx, dy) = face switch
        {
            Dir.N => (0, -1),
            Dir.S => (0,  1),
            Dir.E => (1,  0),
            _     => (-1, 0),
        };
        int nx = cx + dx, ny = cy + dy;

        // Never open a doorway into our own volume.
        if (Occupies(pit, nx, ny, floor, floorMin, floorMax)) return false;

        if (!lookup.TryGetValue((nx, ny, floor), out var nb)) return false;
        return PieceDB.HasSameFloorOpening(nb.Type, nb.Rotation, PieceDB.Opposite(face));
    }

    /// One 10 m wall segment: solid, or split around a 6 m doorway with a lintel above.
    static void AddWallSegment(SurfaceTool st, int cx, int cy,
                               float fy0, float fy1, Dir face, bool doorway)
    {
        float x0 = cx * CS, z0 = cy * CS;
        float x1 = x0 + CS, z1 = z0 + CS;
        float xc = x0 + CS * 0.5f, zc = z0 + CS * 0.5f;
        float yDoor = fy0 + DoorH;

        // normalSign points the wall's face INTO the shaft.
        switch (face)
        {
            case Dir.N:
                if (doorway)
                {
                    DungeonBuilder.EWWall(st, z0, x0, xc - HW, fy0, fy1, +1);
                    DungeonBuilder.EWWall(st, z0, xc + HW, x1, fy0, fy1, +1);
                    DungeonBuilder.EWWall(st, z0, xc - HW, xc + HW, yDoor, fy1, +1);
                }
                else DungeonBuilder.EWWall(st, z0, x0, x1, fy0, fy1, +1);
                break;

            case Dir.S:
                if (doorway)
                {
                    DungeonBuilder.EWWall(st, z1, x0, xc - HW, fy0, fy1, -1);
                    DungeonBuilder.EWWall(st, z1, xc + HW, x1, fy0, fy1, -1);
                    DungeonBuilder.EWWall(st, z1, xc - HW, xc + HW, yDoor, fy1, -1);
                }
                else DungeonBuilder.EWWall(st, z1, x0, x1, fy0, fy1, -1);
                break;

            case Dir.W:
                if (doorway)
                {
                    DungeonBuilder.NSWall(st, x0, z0, zc - HW, fy0, fy1, +1);
                    DungeonBuilder.NSWall(st, x0, zc + HW, z1, fy0, fy1, +1);
                    DungeonBuilder.NSWall(st, x0, zc - HW, zc + HW, yDoor, fy1, +1);
                }
                else DungeonBuilder.NSWall(st, x0, z0, z1, fy0, fy1, +1);
                break;

            default:   // Dir.E
                if (doorway)
                {
                    DungeonBuilder.NSWall(st, x1, z0, zc - HW, fy0, fy1, -1);
                    DungeonBuilder.NSWall(st, x1, zc + HW, z1, fy0, fy1, -1);
                    DungeonBuilder.NSWall(st, x1, zc - HW, zc + HW, yDoor, fy1, -1);
                }
                else DungeonBuilder.NSWall(st, x1, z0, z1, fy0, fy1, -1);
                break;
        }
    }

    /// Barrel vault capping the shaft, arcing across X and running along Z.
    static void AddVaultCap(SurfaceTool st, float x0, float z0, float x1, float z1,
                            float yBase)
    {
        const int N = 24;   // 30 m span — more slices than a 10 m cell needs
        for (int i = 0; i < N; i++)
        {
            float xa = x0 + (x1 - x0) * i / N;
            float xb = x0 + (x1 - x0) * (i + 1) / N;
            float ya = ArchY(xa, x0, x1, yBase);
            float yb = ArchY(xb, x0, x1, yBase);
            DungeonBuilder.Quad(st, new(xa, ya, z1), new(xb, yb, z1),
                                    new(xb, yb, z0), new(xa, ya, z0));
        }
    }

    static float ArchY(float v, float v0, float v1, float yBase)
    {
        float half = (v1 - v0) * 0.5f;
        if (half <= 0.001f) return yBase + RoomBuilder.RoomPeakY;
        float t = Mathf.Clamp((v - (v0 + half)) / half, -1f, 1f);
        return yBase + RoomBuilder.RoomPeakY
             - (RoomBuilder.RoomPeakY - RoomBuilder.RoomSpringY) * t * t;
    }
}
