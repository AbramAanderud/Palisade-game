using Godot;

/// res://scripts/SwingArc.cs
/// ─────────────────────────────────────────────────────────────────────────────
/// Cosmetic joust VFX. Two effects:
///
///   Spawn(idx)        — the glide-strike crescent. One huge right-to-left cleave
///                       matching SwordCombat's hitbox sweep; idx 1 (aerial) is
///                       drawn wider and brighter than idx 0 (ground lunge).
///   SpawnParryFlash() — a bright expanding ring at chest height when a parry
///                       connects, so both players instantly read the turn.
///
/// Purely visual and purely LOCAL — no network messages. Strikes/parries are
/// already relayed as events, so calling these from the puppet triggers makes
/// the effects appear on the opponent's screen too.
///
/// World-space: verts are built in global coordinates and the MeshInstance is
/// TopLevel, so the slash hangs in the air where it was struck rather than
/// following the attacker.
/// ─────────────────────────────────────────────────────────────────────────────
public static class SwingArc
{
    const int   Segments  = 16;
    const float Lifetime  = 0.32f;    // seconds to fade out
    const float BaseAlpha = 0.9f;

    // Cool steel-white tint — reads over dark stone without clashing with the
    // red enemies or orange torchlight.
    static readonly Color Tint      = new(0.60f, 0.80f, 1.0f);
    static readonly Color ParryTint = new(1.0f, 0.92f, 0.55f);   // gold — success!

    // Blade-sweep arcs in (right, up, forward) offsets from the attacker origin.
    // These mirror SwordCombat's hitbox arc so the trail matches where you hit.
    // idx 0 = grounded lunge, idx 1 = aerial glide (wider, taller, more reach).
    static readonly Vector3[] ArcStart = {
        new( 0.85f, 0.75f, 0.55f),
        new( 1.05f, 0.95f, 0.45f),
    };
    static readonly Vector3[] ArcEnd = {
        new(-0.85f, 0.35f, 0.90f),
        new(-1.05f, 0.25f, 1.10f),
    };

    // Inner pivot (the hand) the crescent fans out from.
    static readonly Vector3 Hand = new(0.10f, 0.55f, 0.25f);

    /// Spawn the glide-strike crescent (idx 0 = ground, 1 = aerial).
    public static void Spawn(Node3D world, Vector3 origin, float yaw, int idx)
    {
        if (world == null) return;
        int i = Mathf.Clamp(idx, 0, 1);
        float alpha = i == 1 ? BaseAlpha : BaseAlpha * 0.8f;

        var fwd   = new Vector3(-Mathf.Sin(yaw), 0f, -Mathf.Cos(yaw));
        var right = new Vector3( Mathf.Cos(yaw), 0f, -Mathf.Sin(yaw));
        Vector3 Local(Vector3 v) => origin + right * v.X + Vector3.Up * v.Y + fwd * v.Z;

        var st = new SurfaceTool();
        st.Begin(Mesh.PrimitiveType.Triangles);

        Vector3 hand = Local(Hand);
        for (int s = 0; s < Segments; s++)
        {
            float t0 = (float)s       / Segments;
            float t1 = (float)(s + 1) / Segments;
            Vector3 a0 = Local(ArcStart[i].Lerp(ArcEnd[i], t0));
            Vector3 a1 = Local(ArcStart[i].Lerp(ArcEnd[i], t1));

            // Trail fades from faint (start of swing) to bright (leading edge).
            Color cOuter0 = WithAlpha(Tint, alpha * t0);
            Color cOuter1 = WithAlpha(Tint, alpha * t1);
            Color cInner  = WithAlpha(Tint, alpha * t1 * 0.25f);

            AddVert(st, cInner,  hand);
            AddVert(st, cOuter0, a0);
            AddVert(st, cOuter1, a1);
        }

        BuildAndFade(world, st.Commit(), Lifetime);
    }

    /// Spawn the gold parry-success ring at the defender's chest.
    public static void SpawnParryFlash(Node3D world, Vector3 origin, float yaw)
    {
        if (world == null) return;
        var fwd = new Vector3(-Mathf.Sin(yaw), 0f, -Mathf.Cos(yaw));
        Vector3 centre = origin + Vector3.Up * 0.6f + fwd * 0.5f;

        // Ring: two concentric circles of verts, bright inner edge fading outward.
        const int   RingSegs = 20;
        const float R0 = 0.25f, R1 = 0.75f;
        var st = new SurfaceTool();
        st.Begin(Mesh.PrimitiveType.Triangles);

        // Build the ring facing the attacker (plane perpendicular to fwd).
        var upAxis    = Vector3.Up;
        var rightAxis = fwd.Cross(upAxis).Normalized();
        Color cIn  = WithAlpha(ParryTint, 0.95f);
        Color cOut = WithAlpha(ParryTint, 0.0f);

        for (int s = 0; s < RingSegs; s++)
        {
            float a0 = Mathf.Tau * s       / RingSegs;
            float a1 = Mathf.Tau * (s + 1) / RingSegs;
            Vector3 d0 = rightAxis * Mathf.Cos(a0) + upAxis * Mathf.Sin(a0);
            Vector3 d1 = rightAxis * Mathf.Cos(a1) + upAxis * Mathf.Sin(a1);

            Vector3 i0 = centre + d0 * R0, i1 = centre + d1 * R0;
            Vector3 o0 = centre + d0 * R1, o1 = centre + d1 * R1;

            AddVert(st, cIn, i0); AddVert(st, cOut, o0); AddVert(st, cOut, o1);
            AddVert(st, cIn, i0); AddVert(st, cOut, o1); AddVert(st, cIn, i1);
        }

        BuildAndFade(world, st.Commit(), 0.40f);
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    static Color WithAlpha(Color c, float a) => new(c.R, c.G, c.B, Mathf.Clamp(a, 0f, 1f));

    static void AddVert(SurfaceTool st, Color c, Vector3 v)
    {
        st.SetColor(c);
        st.AddVertex(v);
    }

    static StandardMaterial3D? _mat;
    static StandardMaterial3D Mat() => _mat ??= new StandardMaterial3D
    {
        ShadingMode            = BaseMaterial3D.ShadingModeEnum.Unshaded,
        VertexColorUseAsAlbedo = true,
        Transparency           = BaseMaterial3D.TransparencyEnum.Alpha,
        BlendMode              = BaseMaterial3D.BlendModeEnum.Add,
        CullMode               = BaseMaterial3D.CullModeEnum.Disabled,
        DisableReceiveShadows  = true,
    };

    static void BuildAndFade(Node3D world, ArrayMesh mesh, float lifetime)
    {
        var mi = new MeshInstance3D
        {
            Name       = "SwingArc",
            Mesh       = mesh,
            TopLevel   = true,                 // verts are already world-space
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        };
        mi.MaterialOverride = Mat();
        world.AddChild(mi);

        var tween = mi.CreateTween();
        tween.TweenProperty(mi, "transparency", 1.0f, lifetime)
             .SetEase(Tween.EaseType.Out).SetTrans(Tween.TransitionType.Quad);
        tween.TweenCallback(Callable.From(mi.QueueFree));
    }
}
