using Godot;
using System.Collections.Generic;
using System.Text;

/// res://test/TestDamageProfile.cs
/// ─────────────────────────────────────────────────────────────────────────────
/// Measures what every gun ACTUALLY delivers at range, rather than what its
/// GunDef says on paper. For each gun × distance it fires a fixed number of shots
/// at a body-height target and records:
///
///   hit rate   — fraction of shots (or pellets) that connect at all
///   avg damage — mean damage per trigger pull, INCLUDING complete misses
///
/// There is no damage-falloff curve anywhere in GunCombat: damage is
/// distance-independent and `Range` is only a hard cutoff. So any decline these
/// numbers show is caused purely by SPREAD — the cone widening until pellets or
/// bullets miss the silhouette. That distinction matters, and measuring is the
/// only way to state it honestly.
///
/// Also asserts two rules: the AWP one-shot headshot, and that scoping restores
/// accuracy while airborne.
///
/// Run: --headless --fixed-fps 600 --quit-after 60000
/// ─────────────────────────────────────────────────────────────────────────────
public partial class TestDamageProfile : Node3D
{
    static readonly string[] Guns =
    { "mac10", "pew", "shotgun", "awp", "ak47" };   // hitscan/pellet only

    static readonly float[] Distances = { 3f, 6f, 10f, 15f, 20f, 25f, 30f, 40f };

    const int ShotsPerCase = 12;

    StaticBody3D   _shooter = null!;
    GunCombat      _gun     = null!;
    CharacterBody3D? _target;
    PlayerHealth   _hp      = null!;

    int   _g = 0, _d = 0, _shots = 0;
    float _damageAccum = 0f;
    int   _hits = 0;
    bool  _done = false;
    readonly List<string> _rows = new();

    public override void _Ready()
    {
        var floor = new StaticBody3D();
        floor.AddChild(new CollisionShape3D
        { Shape = new BoxShape3D { Size = new Vector3(200f, 1f, 200f) } });
        AddChild(floor);
        floor.Position = new Vector3(0f, -3f, 0f);

        _shooter = new StaticBody3D { Name = "Shooter" };
        AddChild(_shooter);
        _gun = new GunCombat { CombatTeam = 0 };
        _shooter.AddChild(_gun);

        // Rule checks run from _PhysicsProcess, not here: a body added this frame
        // is not in the physics space yet, so a raycast at it silently misses.
        _gun.Equip("awp");
        NewTarget(10f);
    }

    int _ruleFrame = 0;

    /// The two behavioural rules, checked directly rather than inferred from the
    /// damage table.
    void AssertRules()
    {
        GD.Print("═══ RULES ═══");

        // 1. AWP headshot is lethal outright.
        var origin = new Vector3(0f, 1.6f, 0f);
        var headAt = _target!.GlobalPosition + Vector3.Up * 0.65f;   // rel-foot 1.45, inside the head band AND the collider
        _gun.RequestAttack();
        _gun.Tick(0.016f, origin, (headAt - origin).Normalized(), 0f, false);
        GD.Print($"  AWP headshot: target HP {_hp.CurrentHealth:F0}/100  " +
                 $"{(_hp.CurrentHealth <= 0f ? "LETHAL OK" : "*** NOT LETHAL ***")}");

        // 2. Spread across the movement range. A ~2.3° cone is the angular
        //    half-width of a torso at 10 m, so anything under that is a reliable
        //    hit at duelling range — the bar for "moving and shooting works".
        GD.Print("  spread° by speed        still   walk5.5  sprint8   bhop16   air-ADS");
        foreach (var id in Guns)
        {
            _gun.Equip(id);
            float still  = _gun.CurrentSpread(0f, false);
            float walk   = _gun.CurrentSpread(5.5f, false);
            float sprint = _gun.CurrentSpread(8f, false);
            float bhop   = _gun.CurrentSpread(16f, false);
            _gun.SetAiming(true);
            float airAds = _gun.CurrentSpread(0f, true);
            bool  scoped = _gun.Def.CanAds;
            _gun.SetAiming(false);
            GD.Print($"  {GunCombat.Defs[id].Display,-16}{still,8:F2}{walk,9:F2}" +
                     $"{sprint,9:F2}{bhop,9:F2}   {(scoped ? airAds.ToString("F2") : "—")}");
        }
        GD.Print("═════════════");
    }

    void NewTarget(float dist)
    {
        if (_target != null && IsInstanceValid(_target))
        {
            RemoveChild(_target);
            _target.QueueFree();
        }
        // Match the REAL body convention: a 1.6 m capsule CENTRED on the origin
        // (both PlayerController and EnemyController do this). The old harness
        // target put its origin at the feet, so it validated hit zones against a
        // convention the actual game never used.
        _target = new CharacterBody3D { Name = "Target" };
        _target.AddChild(new CollisionShape3D
        {
            Shape = new CapsuleShape3D { Radius = 0.35f, Height = 1.6f },
        });
        _hp = new PlayerHealth { Name = "PlayerHealth" };
        _hp.DamageDealt += d => { _damageAccum += d; _hits++; };
        _target.AddChild(_hp);
        AddChild(_target);
        _target.GlobalPosition = new Vector3(0f, 0.8f, -dist);   // feet at y=0
    }

    void StartCase()
    {
        _gun.Equip(Guns[_g]);
        NewTarget(Distances[_d]);
        _shots = 0; _damageAccum = 0f; _hits = 0;
    }

    public override void _PhysicsProcess(double delta)
    {
        if (_done || _target == null) return;
        float dt = (float)delta;

        // Give the freshly-added target one physics step to enter the space.
        if (_ruleFrame < 3)
        {
            _ruleFrame++;
            if (_ruleFrame == 3) { AssertRules(); StartCase(); }
            return;
        }

        var origin = new Vector3(0f, 1.6f, 0f);
        var aimAt  = _target.GlobalPosition + Vector3.Up * 0.2f;   // centre mass (rel-foot 1.0)
        int before = _gun.Ammo;

        _gun.RequestAttack();
        _gun.Tick(dt, origin, (aimAt - origin).Normalized(), 0f, false);

        if (_gun.Ammo < before)
        {
            _shots++;
            // A dead target stops registering damage, so replace it between shots.
            if (_hp.CurrentHealth <= 0f) NewTarget(Distances[_d]);
            else _hp.Heal(9999f);
        }

        if (_shots >= ShotsPerCase)
        {
            var def = GunCombat.Defs[Guns[_g]];
            float avg = _damageAccum / _shots;
            _rows.Add($"{def.Display}\t{Distances[_d]:F0}\t{avg:F1}\t{_hits}\t{_shots}");
            GD.Print($"  {def.Display,-10} @{Distances[_d],4:F0} m  " +
                     $"avg dmg/shot {avg,6:F1}   hit events {_hits,3}/{_shots}");

            _d++;
            if (_d >= Distances.Length) { _d = 0; _g++; }
            if (_g >= Guns.Length) { Finish(); return; }
            StartCase();
        }
    }

    void Finish()
    {
        _done = true;
        var sb = new StringBuilder();
        sb.AppendLine("gun\tdistance_m\tavg_damage_per_shot\thit_events\tshots");
        foreach (var r in _rows) sb.AppendLine(r);
        // Written to disk so the numbers can be charted without re-running.
        using var f = FileAccess.Open("res://screenshots/damage_profile.tsv",
                                      FileAccess.ModeFlags.Write);
        if (f != null) f.StoreString(sb.ToString());
        GD.Print("═══ WROTE screenshots/damage_profile.tsv ═══");
        GetTree().Quit();
    }
}
