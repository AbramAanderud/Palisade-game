using System.Collections.Generic;
using System.Linq;

/// res://scripts/RoomGroups.cs — Flood-fills adjacent Room tiles into room groups.
///
/// Rooms are stored as one independent MazePiece per cell (see PieceDB.IsMultiCell
/// for why), but they must RENDER as a single space: one merged floor, no interior
/// walls, one continuous vault. This class is the seam between those two views.
/// It is deliberately free of Godot node types so it can be exercised headlessly.
public sealed class RoomGroup
{
    public int Floor;
    public HashSet<(int x, int y)> Cells = new();

    /// Inclusive cell-space bounds of the group.
    public int MinX, MinY, MaxX, MaxY;

    /// Orientation of the group's barrel vault.
    /// The barrel RUNS along the group's longer axis and ARCS across the shorter one —
    /// the same way a cathedral nave is vaulted. VaultAlongZ == true means the barrel
    /// runs along Z and the arch profile is a function of X.
    public bool VaultAlongZ;

    public bool Contains(int x, int y) => Cells.Contains((x, y));

    /// True when the given face of the given cell is on the group's outer boundary —
    /// i.e. the neighbouring cell across that face is not part of this group. Those
    /// are the faces that get a wall; interior faces are left open so the room reads
    /// as one space.
    public bool IsPerimeterFace(int x, int y, Dir face)
    {
        var (dx, dy) = face switch
        {
            Dir.N => (0, -1),
            Dir.S => (0,  1),
            Dir.E => (1,  0),
            _     => (-1, 0),
        };
        return !Cells.Contains((x + dx, y + dy));
    }
}

public static class RoomGroups
{
    static readonly (int dx, int dy)[] Neighbours = { (0, -1), (0, 1), (1, 0), (-1, 0) };

    /// Groups every Room tile in `pieces` into connected components.
    /// Connectivity is 4-way (shared faces only) and never crosses floors.
    public static List<RoomGroup> Build(IEnumerable<MazePiece> pieces)
    {
        // Bucket Room cells by floor — groups never span floors.
        var byFloor = new Dictionary<int, HashSet<(int x, int y)>>();
        foreach (var p in pieces)
        {
            if (p.Type != PieceType.Room) continue;
            if (!byFloor.TryGetValue(p.Floor, out var set))
                byFloor[p.Floor] = set = new HashSet<(int, int)>();
            set.Add((p.X, p.Y));
        }

        var groups = new List<RoomGroup>();

        foreach (var (floor, cells) in byFloor)
        {
            var unvisited = new HashSet<(int x, int y)>(cells);

            while (unvisited.Count > 0)
            {
                var seed  = unvisited.First();
                var group = new RoomGroup { Floor = floor };
                var queue = new Queue<(int x, int y)>();

                queue.Enqueue(seed);
                unvisited.Remove(seed);

                while (queue.Count > 0)
                {
                    var cell = queue.Dequeue();
                    group.Cells.Add(cell);

                    foreach (var (dx, dy) in Neighbours)
                    {
                        var next = (cell.x + dx, cell.y + dy);
                        if (!unvisited.Remove(next)) continue;
                        queue.Enqueue(next);
                    }
                }

                group.MinX = group.Cells.Min(c => c.x);
                group.MaxX = group.Cells.Max(c => c.x);
                group.MinY = group.Cells.Min(c => c.y);
                group.MaxY = group.Cells.Max(c => c.y);

                int width = group.MaxX - group.MinX + 1;   // extent along X
                int depth = group.MaxY - group.MinY + 1;   // extent along Z

                // Barrel runs along the longer axis. On a square room (width == depth)
                // default to running along Z so the arch faces a player entering from
                // the north or south — the common case, since Start is on the north row.
                group.VaultAlongZ = depth >= width;

                groups.Add(group);
            }
        }

        return groups;
    }
}
