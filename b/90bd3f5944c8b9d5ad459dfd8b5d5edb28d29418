# tools/hallway_gen.py
# Generates the six reference-styled hallway modules as GLBs.
# Run headless:  blender -b -P tools/hallway_gen.py
#
# DUNGEON SCALE (v2): each module now matches the maze corridor contract from
# DungeonBuilder — 10m cell length, 6m interior opening, 14m wall height
# (CellSize / OpeningW / CellHeight). A 14m wall at reference proportions is
# mostly blank, so every style distributes detail in three bands:
#   functional band 0-3m   (doors, sconces, wainscot — human-height stuff)
#   rhythm band    3-11m   (pilasters, panel grids, curtains, planting)
#   cornice/ceiling 11-14m (beams, coves, vault, fixtures)
#
# Blender axes: corridor along +Y (0..LEN), width X (±W/2), height +Z. The
# glTF exporter's Y-up conversion lands that on Godot -Z; segments tile at
# z steps of -10. HallwayDemo.cs relies on this.
#
# Materials are flat Principled colours + emission only — no textures. All
# detail is geometry; that keeps GLBs small and the retro look consistent.

import bpy, math, random, os

OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "assets", "glb", "hallways")
LEN = 10.0     # cell length  (DungeonBuilder.CellSize)
W   = 6.0      # interior width (DungeonBuilder.OpeningW)
H   = 14.0     # wall height  (DungeonBuilder.CellHeight)


# ── helpers ──────────────────────────────────────────────────────────────────

def reset():
    bpy.ops.wm.read_factory_settings(use_empty=True)

def mat(name, color, rough=0.85, metal=0.0, emit=None, estr=0.0):
    m = bpy.data.materials.get(name)
    if m: return m
    m = bpy.data.materials.new(name)
    m.use_nodes = True
    bsdf = m.node_tree.nodes["Principled BSDF"]
    bsdf.inputs["Base Color"].default_value = (*color, 1.0)
    bsdf.inputs["Roughness"].default_value = rough
    bsdf.inputs["Metallic"].default_value = metal
    if emit:
        bsdf.inputs["Emission Color"].default_value = (*emit, 1.0)
        bsdf.inputs["Emission Strength"].default_value = estr
    return m

def box(name, sx, sy, sz, x, y, z, m, rz=0.0, ry=0.0):
    bpy.ops.mesh.primitive_cube_add(size=1, location=(x, y, z), rotation=(0, ry, rz))
    o = bpy.context.active_object
    o.name = name
    o.scale = (sx, sy, sz)
    o.data.materials.append(m)
    return o

def sphere(name, r, x, y, z, m, subdiv=1):
    bpy.ops.mesh.primitive_ico_sphere_add(subdivisions=subdiv, radius=r, location=(x, y, z))
    o = bpy.context.active_object
    o.name = name
    o.data.materials.append(m)
    return o

def cylinder(name, r, depth, x, y, z, m, rx=0.0, verts=10):
    bpy.ops.mesh.primitive_cylinder_add(vertices=verts, radius=r, depth=depth,
                                        location=(x, y, z), rotation=(rx, 0, 0))
    o = bpy.context.active_object
    o.name = name
    o.data.materials.append(m)
    return o

def frame(name, w, h, th, depth, x, y, z, m):
    """Rectangular molding frame on a wall at x, facing inward (w across, h tall)."""
    box(f"{name}_t", depth, w, th, x, y, z + h/2 - th/2, m)
    box(f"{name}_b", depth, w, th, x, y, z - h/2 + th/2, m)
    box(f"{name}_l", depth, th, h, x, y - w/2 + th/2, z, m)
    box(f"{name}_r", depth, th, h, x, y + w/2 - th/2, z, m)

def shell(m_wall, m_ceil, ceil_z=H):
    """Standard corridor shell: two side walls + ceiling. Floors are per-style."""
    for side in (-1, 1):
        box(f"wall{side}", 0.12, LEN, ceil_z, side * (W/2 + 0.06), LEN/2, ceil_z/2, m_wall)
    box("ceilshell", W + 0.3, LEN, 0.08, 0, LEN/2, ceil_z, m_ceil)

def export(style):
    os.makedirs(OUT, exist_ok=True)
    path = os.path.abspath(os.path.join(OUT, f"hall_{style}.glb"))
    bpy.ops.object.select_all(action="SELECT")
    bpy.ops.export_scene.gltf(filepath=path, export_format="GLB")
    polys = sum(len(o.data.polygons) for o in bpy.data.objects if o.type == "MESH")
    print(f"[hallgen] exported {path}  polys={polys}")


# ── 1. RED LODGE — towering curtains, checkerboard, beamed dark ceiling ──────

def red_lodge():
    reset()
    m_blk  = mat("rl_black", (0.04, 0.04, 0.045), 0.35)
    m_wht  = mat("rl_white", (0.85, 0.82, 0.75), 0.35)
    m_cur  = mat("rl_curtain", (0.45, 0.04, 0.05), 0.65)
    m_cur2 = mat("rl_curtain2", (0.30, 0.02, 0.03), 0.7)
    m_ceil = mat("rl_ceil", (0.10, 0.02, 0.02), 0.9)
    m_beam = mat("rl_beam", (0.02, 0.015, 0.015), 0.8)
    m_plth = mat("rl_plinth", (0.06, 0.05, 0.05), 0.6)

    t = 0.5
    for ix in range(int(W / t)):
        for iy in range(int(LEN / t)):
            m = m_blk if (ix + iy) % 2 == 0 else m_wht
            box(f"tile_{ix}_{iy}", t - 0.015, t - 0.015, 0.05,
                -W/2 + t/2 + ix*t, t/2 + iy*t, 0.025, m)   # grout gaps between tiles

    box("ceil", W + 0.3, LEN, 0.08, 0, LEN/2, H, m_ceil)
    for j in range(5):                                      # dark crossbeams
        box(f"beam{j}", W + 0.3, 0.35, 0.5, 0, 1.0 + j * 2.0, H - 0.25, m_beam)

    random.seed(7)
    for side in (-1, 1):
        box(f"plinth{side}", 0.5, LEN, 0.22, side * (W/2 - 0.2), LEN/2, 0.11, m_plth)
        # two curtain layers: dark recessed layer + brighter front layer with
        # three fold frequencies and a slow drift up the 14m drop
        for layer, (mm, inset, amp) in enumerate([(m_cur2, 0.10, 0.30), (m_cur, 0.32, 0.22)]):
            bpy.ops.mesh.primitive_grid_add(x_subdivisions=110, y_subdivisions=6, size=1)
            o = bpy.context.active_object
            o.name = f"curtain{side}_{layer}"
            o.scale = (LEN / 2, H / 2, 1)
            o.rotation_euler = (math.pi / 2, 0, math.pi / 2)
            o.location = (side * (W/2 - inset), LEN/2, H/2)
            bpy.ops.object.transform_apply(scale=True, rotation=True, location=True)
            ph = random.random() * 6.28
            for v in o.data.vertices:
                fold = (math.sin(v.co.y * 4.2 + ph) * amp
                        + math.sin(v.co.y * 11.3 + ph * 2) * amp * 0.35
                        + math.sin(v.co.y * 27.0 + ph * 5) * amp * 0.12)
                sway = math.sin(v.co.z * 0.5 + v.co.y * 0.8 + ph) * 0.10
                v.co.x += -side * (fold + sway + 0.10 * (1 - (v.co.z / H)))
            o.data.materials.append(mm)
    export("redlodge")


# ── 2. MINT OFFICE — panel grid walls, T-bar ceiling, staggered carpet ───────

def mint_office():
    reset()
    m_wall = mat("of_wall", (0.63, 0.72, 0.62), 0.9)
    m_carp = mat("of_carpet", (0.62, 0.58, 0.50), 0.98)
    m_rect = mat("of_rect", (0.28, 0.20, 0.16), 0.98)
    m_ceil = mat("of_ceil", (0.80, 0.80, 0.78), 0.9)
    m_lite = mat("of_light", (0.9, 0.9, 0.88), 0.4, emit=(1.0, 1.0, 0.95), estr=2.2)
    m_trim = mat("of_trim", (0.84, 0.86, 0.82), 0.8)
    m_seam = mat("of_seam", (0.52, 0.60, 0.52), 0.9)
    m_door = mat("of_door", (0.70, 0.72, 0.66), 0.7)

    shell(m_wall, m_ceil)
    box("floor", W, LEN, 0.05, 0, LEN/2, -0.025, m_carp)
    r = 0
    for row in range(8):                                    # staggered carpet rects
        y = 0.8 + row * 1.2
        for cx in ((-1.3, 1.3) if row % 2 == 0 else (0.0,)):
            box(f"crect{r}", 0.8, 0.95, 0.014, cx, y, 0.007, m_rect); r += 1
    box("cborderL", 0.10, LEN, 0.012, -2.35, LEN/2, 0.006, m_rect)
    box("cborderR", 0.10, LEN, 0.012,  2.35, LEN/2, 0.006, m_rect)

    for side in (-1, 1):
        x = side * (W/2 - 0.02)
        box(f"skirt{side}", 0.16, LEN, 0.25, x, LEN/2, 0.125, m_trim)
        box(f"rail{side}",  0.14, LEN, 0.10, x, LEN/2, 1.25, m_trim)
        box(f"crown{side}", 0.20, LEN, 0.18, x, LEN/2, H - 0.35, m_trim)
        for b in range(3):                                  # horizontal reveal bands
            box(f"band{side}{b}", 0.13, LEN, 0.07, x, LEN/2, 4.5 + b * 3.0, m_seam)
        for j in range(5):                                  # vertical panel seams
            y = j * 2.5
            box(f"seam{side}{j}", 0.13, 0.06, H - 2.0, x, y, 1.3 + (H - 2.0)/2, m_seam)
        for j in range(2):                                  # office doors + frames
            y = 2.8 + j * 5.0
            box(f"door{side}{j}", 0.10, 1.1, 2.3, x, y, 1.15, m_door)
            frame(f"dfr{side}{j}", 1.3, 2.5, 0.09, 0.12, x, y, 1.25, m_trim)

    for gy in range(9):                                     # T-bar ceiling grid
        box(f"tbarY{gy}", W, 0.06, 0.06, 0, 0.6 + gy * 1.1, H - 0.05, m_seam)
    for gx in range(4):
        box(f"tbarX{gx}", 0.06, LEN, 0.06, -2.2 + gx * 1.47, LEN/2, H - 0.05, m_seam)
    for i in range(4):                                      # light panel run
        box(f"panel{i}", 2.0, 1.0, 0.05, 0, 1.15 + i * 2.2, H - 0.06, m_lite)
    export("office")


# ── 3. GRAND HOTEL — wainscot, panelled doors, sconces, ornate runner ────────

def grand_hotel():
    reset()
    m_wall = mat("ht_wall", (0.70, 0.60, 0.46), 0.85)
    m_wain = mat("ht_wainscot", (0.30, 0.19, 0.11), 0.7)
    m_carp = mat("ht_carpet", (0.38, 0.09, 0.09), 0.98)
    m_cred = mat("ht_carpet2", (0.55, 0.16, 0.12), 0.98)
    m_gold = mat("ht_gold", (0.75, 0.58, 0.22), 0.5, metal=0.6)
    m_door = mat("ht_door", (0.26, 0.16, 0.09), 0.7)
    m_dpan = mat("ht_doorpanel", (0.33, 0.21, 0.12), 0.7)
    m_ceil = mat("ht_ceil", (0.76, 0.70, 0.60), 0.9)
    m_dome = mat("ht_dome", (0.95, 0.88, 0.70), 0.4, emit=(1.0, 0.85, 0.55), estr=5.0)

    shell(m_wall, m_ceil)
    box("floor", W, LEN, 0.05, 0, LEN/2, -0.025, m_carp)
    box("runnerbedL", 0.5, LEN, 0.010, -1.55, LEN/2, 0.005, m_cred)
    box("runnerbedR", 0.5, LEN, 0.010,  1.55, LEN/2, 0.005, m_cred)
    box("runnerL", 0.14, LEN, 0.014, -1.2, LEN/2, 0.007, m_gold)
    box("runnerR", 0.14, LEN, 0.014,  1.2, LEN/2, 0.007, m_gold)
    for i in range(5):                                      # diamonds + inner accents
        y = 1.0 + i * 2.0
        box(f"dia{i}", 0.6, 0.6, 0.014, 0, y, 0.007, m_gold, rz=math.pi/4)
        box(f"diaIn{i}", 0.3, 0.3, 0.018, 0, y, 0.009, m_cred, rz=math.pi/4)
        for sx in (-0.85, 0.85):
            box(f"sq{i}{sx}", 0.22, 0.22, 0.014, sx, y + 1.0, 0.007, m_gold, rz=math.pi/4)

    for side in (-1, 1):
        x = side * (W/2 - 0.02)
        box(f"wain{side}", 0.14, LEN, 1.3, x, LEN/2, 0.65, m_wain)
        box(f"waincap{side}", 0.18, LEN, 0.07, x, LEN/2, 1.33, m_gold)
        box(f"cornice{side}", 0.26, LEN, 0.30, x, LEN/2, H - 0.9, m_wain)
        box(f"cornice2{side}", 0.20, LEN, 0.10, x, LEN/2, H - 1.15, m_gold)
        for j in range(3):                                  # panelled doors + hardware
            y = 1.7 + j * 3.3
            box(f"door{side}{j}", 0.10, 1.15, 2.5, x, y, 1.25, m_door)
            box(f"dpanT{side}{j}", 0.12, 0.75, 0.9, x, y, 1.85, m_dpan)
            box(f"dpanB{side}{j}", 0.12, 0.75, 0.9, x, y, 0.75, m_dpan)
            sphere(f"knob{side}{j}", 0.06, side * (W/2 - 0.16), y + 0.42, 1.15, m_gold)
            box(f"lintel{side}{j}", 0.14, 1.45, 0.14, x, y, 2.6, m_gold)
            sy = y + 1.65
            if sy < LEN:                                    # twin-candle sconces
                box(f"scback{side}{j}", 0.06, 0.20, 0.45, x, sy, 2.3, m_gold)
                box(f"scarm{side}{j}", 0.22, 0.05, 0.05, side * (W/2 - 0.13), sy, 2.25, m_gold)
                for dy in (-0.10, 0.10):
                    cylinder(f"cnd{side}{j}{dy}", 0.025, 0.18, side * (W/2 - 0.24), sy + dy, 2.36, m_gold)
                    sphere(f"scl{side}{j}{dy}", 0.07, side * (W/2 - 0.24), sy + dy, 2.52, m_dome)
        for j in range(4):                                  # gold picture frames up high
            y = 1.3 + j * 2.5
            frame(f"pic{side}{j}", 1.4, 2.2, 0.08, 0.10, x, y, 5.2, m_gold)
            frame(f"pic2{side}{j}", 1.0, 1.6, 0.06, 0.10, x, y, 9.0, m_gold)

    for i in range(3):                                      # ceiling domes + gold rings
        y = 1.7 + i * 3.3
        bpy.ops.mesh.primitive_uv_sphere_add(segments=14, ring_count=7, radius=0.45,
                                             location=(0, y, H))
        o = bpy.context.active_object
        o.name = f"dome{i}"
        o.scale = (1, 1, 0.5)
        o.data.materials.append(m_dome)
        cylinder(f"domering{i}", 0.55, 0.08, 0, y, H - 0.03, m_gold, verts=14)
    export("hotel")


# ── 4. DIM MANOR — staggered planks, paintings, beams, globe pendants ────────

def dim_manor():
    reset()
    woods = [mat(f"mn_wood{i}", c, 0.85) for i, c in enumerate(
        [(0.32, 0.20, 0.10), (0.27, 0.16, 0.08), (0.38, 0.25, 0.13), (0.22, 0.13, 0.07)])]
    m_wall = mat("mn_wall", (0.52, 0.31, 0.11), 0.9)
    m_batt = mat("mn_batten", (0.24, 0.14, 0.07), 0.8)
    m_ceil = mat("mn_ceil", (0.26, 0.17, 0.09), 0.9)
    m_glow = mat("mn_glow", (1.0, 0.75, 0.4), 0.4, emit=(1.0, 0.72, 0.35), estr=7.0)
    m_dark = mat("mn_dark", (0.05, 0.04, 0.03), 0.9)
    m_pict = mat("mn_pict", (0.10, 0.07, 0.05), 0.8)

    random.seed(23)
    x = -W/2
    i = 0
    while x < W/2:                                          # planks w/ staggered joints
        pw = 0.17
        y0 = -random.uniform(0, 1.2)
        while y0 < LEN:
            pl = random.uniform(1.4, 2.6)
            yA, yB = max(y0, 0.0), min(y0 + pl, LEN)
            if yB > yA:
                box(f"plank{i}", pw - 0.008, (yB - yA) - 0.02, 0.04,
                    x + pw/2, (yA + yB) / 2, -0.02, random.choice(woods))
            y0 += pl; i += 1
        x += pw

    shell(m_wall, m_ceil)
    for j in range(5):                                      # dark ceiling beams
        box(f"beam{j}", W + 0.3, 0.30, 0.45, 0, 1.0 + j * 2.0, H - 0.22, m_batt)

    for side in (-1, 1):
        x = side * (W/2 - 0.02)
        box(f"base{side}", 0.14, LEN, 0.28, x, LEN/2, 0.14, m_batt)
        box(f"platerail{side}", 0.14, LEN, 0.08, x, LEN/2, 2.6, m_batt)
        for j in range(8):                                  # wainscot battens
            box(f"batt{side}{j}", 0.12, 0.09, 2.3, x, 0.6 + j * 1.25, 1.3, m_batt)
        for j in range(2):                                  # doorways, one glowing
            y = 2.6 + j * 5.0
            glow = (side == 1 and j == 1)
            box(f"dw{side}{j}", 0.11, 1.05, 2.3, x, y, 1.15, m_glow if glow else m_dark)
            frame(f"dwf{side}{j}", 1.3, 2.6, 0.10, 0.14, x, y, 1.3, m_batt)
        for j in range(3):                                  # dark framed paintings
            y = 1.6 + j * 3.3
            frame(f"pf{side}{j}", 1.1, 1.5, 0.09, 0.10, x, y, 4.6, m_batt)
            box(f"pc{side}{j}", 0.07, 0.92, 1.32, x, y, 4.6, m_pict)
    for i in range(3):                                      # globe pendants on long rods
        y = 1.8 + i * 3.3
        cylinder(f"cord{i}", 0.02, 2.6, 0, y, H - 1.3, m_dark)
        cylinder(f"ring{i}", 0.30, 0.04, 0, y, H - 2.55, m_batt, verts=12)
        sphere(f"globe{i}", 0.30, 0, y, H - 2.75, m_glow, subdiv=2)
    export("manor")


# ── 5. OCEAN DOORS — panelled pink doors onto layered sea + sky ──────────────

def ocean_doors():
    reset()
    # ── STORM ROOM (v4) ───────────────────────────────────────────────────────
    # Dark interior lit only by the storm outside (the demo adds cool spill
    # lights at the doorways and NOTHING else). Doorways doubled: two grand
    # 4.0 x 9.2m portals per side per cell. The ocean itself is not built
    # anywhere — HallwayDemo fills each opening with an infinite-ocean portal
    # shader. Detail: wet-look glossy floor tiles, stepped double surrounds,
    # pilasters on the piers, cornice, plinth.
    m_wall  = mat("oc_wall", (0.14, 0.16, 0.17), 0.85)
    m_dark  = mat("oc_dark", (0.075, 0.085, 0.095), 0.8)
    m_ceil  = mat("oc_ceil", (0.10, 0.11, 0.12), 0.9)
    m_tile  = mat("oc_tile", (0.085, 0.095, 0.105), 0.12)   # wet stone, glossy
    m_grout = mat("oc_grout", (0.035, 0.040, 0.045), 0.6)
    m_rose  = mat("oc_rose", (0.42, 0.20, 0.26), 0.55)      # deep weathered rose
    m_roseL = mat("oc_roseL", (0.55, 0.30, 0.36), 0.55)

    OW, OH = 4.0, 9.2
    CENTRES = (2.5, 7.5)

    # wet tiled floor: 1m grid over a grout bed
    box("groutbed", W, LEN, 0.04, 0, LEN/2, -0.02, m_grout)
    for ix in range(6):
        for iy in range(10):
            box(f"tile{ix}_{iy}", 0.96, 0.96, 0.05,
                -W/2 + 0.5 + ix, 0.5 + iy, 0.005, m_tile)
    box("ceil", W + 0.3, LEN, 0.08, 0, LEN/2, H, m_ceil)

    for side in (-1, 1):
        xw = side * (W/2 + 0.06)          # wall plane
        xf = side * (W/2 - 0.02)          # inner face for trim
        # piers between/around the two big openings, 0..OH
        gaps = [(0.0, CENTRES[0] - OW/2),
                (CENTRES[0] + OW/2, CENTRES[1] - OW/2),
                (CENTRES[1] + OW/2, LEN)]
        for gi, (y0, y1) in enumerate(gaps):
            if y1 - y0 < 0.05: continue
            box(f"pier{side}{gi}", 0.12, y1 - y0, OH, xw, (y0 + y1)/2, OH/2, m_wall)
            # proud pilaster strip on each pier
            box(f"pil{side}{gi}", 0.20, min(y1 - y0, 0.45), OH,
                xf, (y0 + y1)/2, OH/2, m_dark)
        # band above the openings + cornice + plinth
        box(f"band{side}", 0.12, LEN, H - OH, xw, LEN/2, OH + (H - OH)/2, m_wall)
        box(f"cornice{side}", 0.24, LEN, 0.30, xf, LEN/2, H - 0.55, m_dark)
        box(f"cornice2{side}", 0.18, LEN, 0.10, xf, LEN/2, H - 0.78, m_rose)
        box(f"plinth{side}", 0.16, LEN, 0.30, xf, LEN/2, 0.15, m_dark)
        for b in range(2):                # dark string courses up the band
            box(f"string{side}{b}", 0.10, LEN, 0.14, xf, LEN/2, OH + 1.4 + b * 1.6, m_dark)
        for j, c in enumerate(CENTRES):   # stepped double surround per portal
            box(f"jL1{side}{j}", 0.70, 0.30, OH + 0.7, xw, c - OW/2 - 0.15, (OH + 0.7)/2, m_rose)
            box(f"jR1{side}{j}", 0.70, 0.30, OH + 0.7, xw, c + OW/2 + 0.15, (OH + 0.7)/2, m_rose)
            box(f"jL2{side}{j}", 0.45, 0.18, OH + 0.3, xw, c - OW/2 - 0.34, (OH + 0.3)/2, m_roseL)
            box(f"jR2{side}{j}", 0.45, 0.18, OH + 0.3, xw, c + OW/2 + 0.34, (OH + 0.3)/2, m_roseL)
            box(f"head1{side}{j}", 0.70, OW + 0.9, 0.40, xw, c, OH + 0.55, m_rose)
            box(f"head2{side}{j}", 0.45, OW + 1.3, 0.22, xw, c, OH + 0.85, m_roseL)
            box(f"key{side}{j}",  0.80, 0.5, 0.65, xw, c, OH + 0.55, m_roseL)   # keystone
            box(f"sill{side}{j}", 0.80, OW + 0.3, 0.10, xw, c, 0.05, m_dark)
    export("ocean")


# ── 6. ROSE GALLERY — arched colonnade, planters, garlands, chandeliers ──────

def rose_gallery():
    reset()
    m_white = mat("rg_white", (0.88, 0.88, 0.86), 0.7)
    m_leafA = mat("rg_leafA", (0.30, 0.52, 0.22), 0.9)
    m_leafB = mat("rg_leafB", (0.42, 0.62, 0.28), 0.9)
    m_leafC = mat("rg_leafC", (0.22, 0.40, 0.18), 0.9)
    m_rose  = mat("rg_rose", (0.95, 0.78, 0.82), 0.8)
    m_wht_f = mat("rg_flower", (0.95, 0.93, 0.90), 0.8)
    m_win   = mat("rg_window", (0.95, 0.97, 1.0), 0.3, emit=(1.0, 1.0, 0.98), estr=3.5)
    m_marb  = mat("rg_marble", (0.90, 0.90, 0.88), 0.25)
    m_inlay = mat("rg_inlay", (0.25, 0.45, 0.32), 0.4)
    m_pot   = mat("rg_pot", (0.85, 0.83, 0.78), 0.7)

    shell(m_white, m_white)
    box("floor", W, LEN, 0.05, 0, LEN/2, -0.025, m_marb)
    box("inlayL", 0.12, LEN, 0.012, -1.8, LEN/2, 0.006, m_inlay)
    box("inlayR", 0.12, LEN, 0.012,  1.8, LEN/2, 0.006, m_inlay)
    for i in range(3):                                      # centre inlay diamonds
        box(f"cd{i}", 0.7, 0.7, 0.012, 0, 1.7 + i * 3.3, 0.006, m_inlay, rz=math.pi/4)

    random.seed(41)
    for side in (-1, 1):
        x = side * (W/2 - 0.02)
        for j in range(5):                                  # pilasters, planters, ivy
            y = j * 2.5
            box(f"pil{side}{j}", 0.30, 0.42, 10.0, side * (W/2 - 0.15), y, 5.0, m_white)
            box(f"pilcap{side}{j}", 0.40, 0.55, 0.25, side * (W/2 - 0.15), y, 10.1, m_white)
            if 0 < y < LEN:
                cylinder(f"pot{side}{j}", 0.35, 0.55, side * (W/2 - 0.55), y, 0.28, m_pot, verts=10)
                for k in range(5):                          # bush in the pot
                    sphere(f"bush{side}{j}{k}", random.uniform(0.16, 0.30),
                           side * (W/2 - 0.55) + random.uniform(-0.15, 0.15),
                           y + random.uniform(-0.15, 0.15),
                           0.75 + random.uniform(0, 0.35),
                           random.choice([m_leafA, m_leafB, m_leafC]))
            for k in range(7):                              # ivy trailing down pilasters
                sphere(f"ivy{side}{j}{k}", random.uniform(0.10, 0.18),
                       side * (W/2 - 0.30), y + random.uniform(-0.25, 0.25),
                       9.6 - k * 1.15 + random.uniform(-0.2, 0.2),
                       random.choice([m_leafA, m_leafC]))
        for j in range(2):                                  # arched windows w/ mullions
            y = 2.5 + j * 5.0
            box(f"win{side}{j}", 0.07, 1.6, 4.5, x, y, 4.2, m_win)
            arc = cylinder(f"winarc{side}{j}", 0.8, 0.07, x, y, 6.45, m_win, verts=14)
            arc.rotation_euler = (0, math.pi/2, 0)
            box(f"mulV{side}{j}", 0.09, 0.07, 4.5, x, y, 4.2, m_white)
            box(f"mulH{side}{j}", 0.09, 1.6, 0.07, x, y, 4.2, m_white)
            frame(f"winf{side}{j}", 1.8, 4.7, 0.10, 0.12, x, y, 4.2, m_white)

    # arch ribs: at 14m walls a full elliptical ring is safely overhead
    # (bottom ~8.2m), unlike the human-scale version where it crossed eye level
    for j in range(5):
        y = j * 2.5
        bpy.ops.mesh.primitive_torus_add(major_radius=3.0, minor_radius=0.14,
                                         major_segments=28, minor_segments=6,
                                         location=(0, y, 10.4), rotation=(math.pi/2, 0, 0))
        rib = bpy.context.active_object
        rib.name = f"rib{j}"
        rib.scale = (1, 1, 0.85)
        rib.data.materials.append(m_white)
        for k in range(20):                                 # garland on each rib
            a = random.uniform(0.15, math.pi - 0.15)
            sphere(f"leaf{j}_{k}", random.uniform(0.12, 0.26),
                   math.cos(a) * 2.95, y + random.uniform(-0.25, 0.25),
                   10.4 + math.sin(a) * 2.55,
                   random.choice([m_leafA, m_leafB, m_leafC, m_rose]))
    for i in range(2):                                      # flower chandeliers
        y = 2.8 + i * 4.6
        cylinder(f"chain{i}", 0.015, 3.2, 0, y, H - 1.6, m_white)
        for k in range(14):
            sphere(f"bloom{i}_{k}", random.uniform(0.10, 0.20),
                   random.uniform(-0.4, 0.4), y + random.uniform(-0.4, 0.4),
                   H - 3.3 + random.uniform(-0.35, 0.35),
                   random.choice([m_wht_f, m_wht_f, m_rose]))
    export("garden")


for build in (red_lodge, mint_office, grand_hotel, dim_manor, ocean_doors, rose_gallery):
    build()
print("[hallgen] all six exported")
