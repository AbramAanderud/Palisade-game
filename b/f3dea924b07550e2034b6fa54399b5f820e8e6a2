using Godot;

/// res://test/TestTask.cs — per-task harness (overwritten each task).
/// ─────────────────────────────────────────────────────────────────────────────
/// State-matrix capture for the "always facing reticle" / "sprint face-carry"
/// fix. Films the FP viewmodel through the PLAYER'S OWN first-person camera
/// (no camera of our own — same pattern as TestScope.cs) while cycling three
/// guns (mac10, ak47, awp) through a fixed timeline of named beats driven via
/// PlayerController.DebugDriveThirdPerson, exactly like TestScope/TestThirdPerson
/// already do for visual QA.
///
/// A burned-in label (gun | beat | t=) plus a centre-screen crosshair
/// (ReticleRenderer, the same draw code the real HUD uses) make every frame
/// self-documenting: the crosshair position is the ground truth for "is the
/// gun on target", and the label makes it trivial to pick the right frame back
/// out of the --write-movie PNG sequence afterward.
///
/// Two modes, selected by the CAPTURE_MODE env var:
///   full (default)  — per gun: 9s idle (drift check), +45 pitch, -45 pitch,
///                      sprint, airborne (falling), firing. 16s/gun, 48s total.
///   sprint_only      — per gun: 2s idle, 2s sprint. 4s/gun, 12s total. Used to
///                      grab the sprint before/after comparison against a
///                      temporarily-reverted build.
/// ─────────────────────────────────────────────────────────────────────────────
public partial class TestTask : Node3D
{
    static readonly string[] Guns = { "mac10", "ak47", "awp" };

    const float FullGunDuration   = 16f;
    const float SprintGunDuration = 4f;

    PlayerController? _player;
    Label?    _label;
    float     _t = 0f;
    int       _curGunIdx = -1;
    string    _mode = "full";
    float     _shotClock = 0f;

    public override void _Ready()
    {
        _mode = System.Environment.GetEnvironmentVariable("CAPTURE_MODE");
        if (string.IsNullOrEmpty(_mode)) _mode = "full";
        GD.Print($"[Capture] mode={_mode}");

        BuildRoom();

        var cl = new CanvasLayer();
        AddChild(cl);
        cl.AddChild(new ReticleOverlay());

        _label = new Label
        {
            Position = new Vector2(24, 24),
            Text = "",
        };
        _label.AddThemeFontSizeOverride("font_size", 28);
        _label.AddThemeColorOverride("font_color", Colors.Yellow);
        _label.AddThemeColorOverride("font_outline_color", Colors.Black);
        _label.AddThemeConstantOverride("outline_size", 6);
        cl.AddChild(_label);

        _player = PlayerController.Spawn(this, new Vector3(0f, 0.2f, 0f), 0f);
        _player.Frozen = true;   // no real input — DebugDriveThirdPerson drives every tick
        _player.EquipStarterGun(Guns[0]);
        _curGunIdx = 0;
    }

    void BuildRoom()
    {
        var env = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0.35f, 0.45f, 0.60f),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(1f, 1f, 1f),
            AmbientLightEnergy = 0.9f,
        };
        AddChild(new WorldEnvironment { Environment = env });

        var sun = new DirectionalLight3D { LightEnergy = 2.0f };
        sun.RotationDegrees = new Vector3(-45f, 30f, 0f);
        AddChild(sun);

        AddBox(new Vector3(0f, -0.5f, -30f), new Vector3(40f, 1f, 80f),
               new Color(0.30f, 0.32f, 0.30f));

        // Pillars every 10 m, and one overhead beam + one low ledge so +/-45 deg
        // pitch has something obvious to land on in frame.
        for (int i = 1; i <= 6; i++)
        {
            float z = -i * 10f;
            var c = (i % 2 == 0) ? new Color(0.85f, 0.35f, 0.25f)
                                 : new Color(0.90f, 0.85f, 0.55f);
            AddBox(new Vector3(-3f, 1.5f, z), new Vector3(0.6f, 4f, 0.6f), c);
            AddBox(new Vector3( 3f, 1.5f, z), new Vector3(0.6f, 4f, 0.6f), c);
        }
        AddBox(new Vector3(0f, 8f, -20f), new Vector3(6f, 0.6f, 0.6f), new Color(0.6f, 0.8f, 0.9f));
        AddBox(new Vector3(0f, 0.1f, -5f), new Vector3(6f, 0.4f, 0.6f), new Color(0.4f, 0.9f, 0.5f));
        AddBox(new Vector3(0f, 3f, -70f), new Vector3(24f, 8f, 1f),
               new Color(0.55f, 0.60f, 0.70f));
    }

    void AddBox(Vector3 pos, Vector3 size, Color col)
    {
        var body = new StaticBody3D();
        body.AddChild(new CollisionShape3D { Shape = new BoxShape3D { Size = size } });
        var mi = new MeshInstance3D { Mesh = new BoxMesh { Size = size } };
        mi.SetSurfaceOverrideMaterial(0,
            new StandardMaterial3D { AlbedoColor = col, Roughness = 1f, Metallic = 0f });
        body.AddChild(mi);
        AddChild(body);
        body.GlobalPosition = pos;
    }

    static string BeatForFull(float localT)
    {
        if (localT < 9.0f)  return "IDLE";
        if (localT < 10.0f) return "PITCH UP45";
        if (localT < 11.0f) return "PITCH DOWN45";
        if (localT < 12.5f) return "SPRINTING";
        // "airborne" — JUMPING, not FALLING: both drove IsOnFloor=false identically
        // for this test, but this capture also caught a real, separate bug fixed
        // alongside this task (PlayerAnimator.UpdateFpArmsLocoClip's Jump/Fall
        // exclusion) — the borrowed NinjaJump_Start/Idle clips swing the FP
        // viewmodel's hand out of frame entirely. See JOURNAL.md.
        if (localT < 13.5f) return "JUMPING";
        return "SHOOTING";                                // firing (RequestAttack held)
    }

    static string BeatForSprintOnly(float localT)
        => localT < 2.0f ? "IDLE" : "SPRINTING";

    public override void _PhysicsProcess(double delta)
    {
        if (_player == null) return;
        float dt = (float)delta;
        _t += dt;

        bool  sprintOnly = _mode == "sprint_only";
        float gunDur     = sprintOnly ? SprintGunDuration : FullGunDuration;
        int   gunIdx     = Mathf.Min((int)(_t / gunDur), Guns.Length - 1);
        float localT     = _t - gunIdx * gunDur;

        if (gunIdx != _curGunIdx)
        {
            _curGunIdx = gunIdx;
            _player.EquipStarterGun(Guns[gunIdx]);
            GD.Print($"[Capture] === equip {Guns[gunIdx]} ===");
        }

        string beat = sprintOnly ? BeatForSprintOnly(localT) : BeatForFull(localT);

        // Hold the trigger continuously through the firing beat, same as a
        // player holding LMB — mirrors the real _PhysicsProcess's
        // Input.IsActionPressed("attack") polling (see PlayerController.cs).
        _player.DebugDriveThirdPerson(beat, dt);

        if (_label != null)
            _label.Text = $"{Guns[gunIdx]}  |  {beat}  |  t={_t:F1}s";

        if (Engine.GetPhysicsFrames() % 2 == 0)
            GD.Print($"[Capture] frame={Engine.GetPhysicsFrames()} t={_t:F2} " +
                     $"gun={Guns[gunIdx]} beat={beat}");
    }
}

/// Screen-space crosshair using the SAME draw code the real HUD uses
/// (ReticleRenderer) — the ground truth for "is the gun on target" in every
/// capture frame.
public partial class ReticleOverlay : Control
{
    public override void _Ready()
    {
        SetAnchorsPreset(LayoutPreset.FullRect);
        MouseFilter = MouseFilterEnum.Ignore;
    }

    public override void _Process(double delta) => QueueRedraw();

    public override void _Draw()
    {
        var center = GetViewportRect().Size / 2f;
        ReticleRenderer.Draw(this, center, 0f, false);
    }
}
