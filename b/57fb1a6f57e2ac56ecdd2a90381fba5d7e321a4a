using Godot;

/// test/TestKnifeModes.cs
/// The knife must be equipable in every mode a player can reach, not just an
/// online match. Loads the REAL maze-playtest scene (DungeonArena — what the
/// editor's play button opens) and then the REAL TrainingArena, and in each
/// presses the actual `weapon_melee` input (key 3) rather than calling
/// SelectMelee — so a freeze, an unarmed spawn or any other input gate on the
/// way would fail here. Also checks the training weapon wheel lists the knife.
public partial class TestKnifeModes : Node
{
    public override void _Ready()
    {
        GetTree().Root.CallDeferred(Node.MethodName.AddChild, new KnifeModesWatcher());
        GetTree().CallDeferred(SceneTree.MethodName.ChangeSceneToFile,
                               "res://scenes/DungeonArena.tscn");
    }
}

public partial class KnifeModesWatcher : Node
{
    static readonly string[] Scenes =
    {
        "res://scenes/DungeonArena.tscn",
        "res://scenes/TrainingArena.tscn",
    };

    int _scene, _frame, _fail;

    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + label);
        if (!ok) _fail++;
    }

    static void Key3(bool pressed) =>
        Input.ParseInputEvent(new InputEventAction { Action = "weapon_melee", Pressed = pressed });

    public override void _Process(double delta)
    {
        _frame++;
        string name = Scenes[_scene].GetFile().GetBaseName();

        if (_frame == 180) Key3(true);        // scene build takes a while
        if (_frame == 183) Key3(false);
        if (_frame != 190) return;

        var p = Find(GetTree().CurrentScene);
        Check(p != null, $"{name}: a local player exists");
        if (p != null)
        {
            Check(p.HasWeapon, $"{name}: player spawns armed");
            Check(p.KnifeOut,  $"{name}: key 3 equips the knife (held={p.Gun?.Def.Id ?? "-"})");
            Check(p.SecondaryGunId != null && p.SecondaryGunId != GunCombat.KnifeId,
                  $"{name}: loadout intact (secondary={p.SecondaryGunId ?? "-"})");
        }

        if (++_scene < Scenes.Length)
        {
            _frame = 0;
            GetTree().ChangeSceneToFile(Scenes[_scene]);
            return;
        }

        Check(System.Array.IndexOf(GunSwitcher.GunIds, GunCombat.KnifeId) >= 0,
              "training weapon wheel lists the knife");

        // Camera toggle is V and ONLY V; 3 belongs to the knife.
        static Key Phys(InputEvent e) => e is InputEventKey k
            ? (k.PhysicalKeycode != 0 ? k.PhysicalKeycode : k.Keycode) : Key.None;
        var cam = InputMap.ActionGetEvents("toggle_camera");
        Check(cam.Count == 1 && Phys(cam[0]) == Key.V,
              $"camera toggle is bound to V only ({cam.Count} event(s))");
        bool threeOnCam = false;
        foreach (var e in cam) threeOnCam |= Phys(e) == Key.Key3;
        Check(!threeOnCam, "3 does not toggle the camera");
        var melee = InputMap.ActionGetEvents("weapon_melee");
        Check(melee.Count == 1 && Phys(melee[0]) == Key.Key3, "3 equips the knife");

        GD.Print(_fail == 0 ? "RESULT OK" : $"RESULT {_fail} FAILURE(S)");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }

    static PlayerController? Find(Node? root)
    {
        if (root == null) return null;
        if (root is PlayerController { IsRemotePuppet: false } pc) return pc;
        foreach (var c in root.GetChildren())
        {
            var hit = Find(c);
            if (hit != null) return hit;
        }
        return null;
    }
}
