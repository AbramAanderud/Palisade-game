using Godot;

/// res://test/TestWeaponPoses.cs
/// ─────────────────────────────────────────────────────────────────────────────
/// The weapon-pose check-sheet: every gun in the game held by its own character,
/// filmed from an opponent's vantage — first at combat idle, then sprinting.
/// One capture answers "is each weapon pointed and carried realistically" for
/// all seven guns and both states at once.
/// ─────────────────────────────────────────────────────────────────────────────
public partial class TestWeaponPoses : Node3D
{
    static readonly string[] Guns =
    { "pew", "mac10", "ak47", "shotgun", "awp", "rocketlaucher", "quadrocket" };

    readonly PlayerController[] _players = new PlayerController[Guns.Length];
    Label3D? _banner;
    float _t = 0f;

    public override void _Ready()
    {
        var env = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0.08f, 0.08f, 0.10f),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(1f, 0.97f, 0.92f),
            AmbientLightEnergy = 0.85f,
        };
        AddChild(new WorldEnvironment { Environment = env });
        var key = new DirectionalLight3D { LightEnergy = 1.5f };
        key.RotationDegrees = new Vector3(-38f, 32f, 0f);
        AddChild(key);

        var floor = new StaticBody3D();
        floor.AddChild(new CollisionShape3D
        { Shape = new BoxShape3D { Size = new Vector3(80f, 1f, 80f) } });
        var fm = new MeshInstance3D { Mesh = new BoxMesh { Size = new Vector3(80f, 1f, 80f) } };
        fm.SetSurfaceOverrideMaterial(0, new StandardMaterial3D
        { AlbedoColor = new Color(0.18f, 0.18f, 0.20f), Roughness = 1f, Metallic = 0f });
        floor.AddChild(fm);
        AddChild(floor);
        floor.GlobalPosition = new Vector3(0f, -0.5f, 0f);

        float x = -(Guns.Length - 1) * 1.9f / 2f;
        for (int i = 0; i < Guns.Length; i++)
        {
            var p = PlayerController.Spawn(this, new Vector3(x, 0.2f, 0f), 0f);
            p.Frozen = true;
            p.EquipStarterGun(Guns[i]);
            _players[i] = p;

            AddChild(new Label3D
            {
                Text      = GunCombat.Defs[Guns[i]].Display,
                FontSize  = 56,
                Position  = new Vector3(x, 2.25f, 0f),
                Billboard = BaseMaterial3D.BillboardModeEnum.Enabled,
                Modulate  = new Color(1f, 0.88f, 0.5f),
                PixelSize = 0.003f,
            });
            x += 1.9f;
        }

        _banner = new Label3D
        {
            Text      = "IDLE",
            FontSize  = 96,
            Position  = new Vector3(0f, 3.2f, 0f),
            Billboard = BaseMaterial3D.BillboardModeEnum.Enabled,
            Modulate  = new Color(0.6f, 0.9f, 1f),
            PixelSize = 0.004f,
        };
        AddChild(_banner);

        // Opponent's-eye wide shot: front three-quarter, whole row in frame.
        var cam = new Camera3D { Fov = 62f, CullMask = ~4u };
        AddChild(cam);
        cam.Position = new Vector3(2.5f, 2.2f, 8.5f);
        cam.LookAt(new Vector3(0f, 1.0f, 0f), Vector3.Up);
        cam.MakeCurrent();
    }

    public override void _PhysicsProcess(double delta)
    {
        _t += (float)delta;
        string beat = _t < 2.0f ? "IDLE" : "SPRINTING";
        if (_banner != null) _banner.Text = beat;
        foreach (var p in _players)
            p?.DebugDriveThirdPerson(beat, (float)delta);
    }
}
