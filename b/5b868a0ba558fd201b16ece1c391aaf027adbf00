using System.Collections.Generic;
using System.Linq;
using Godot;

/// test/TestMazeFootprint.cs
/// 1. Column spans: FloorSpan (pits, trapdoors) and stair overhang are included,
///    relative to the Exit floor.
/// 2. Margin guard: builds real DungeonBuilder geometry for several fixtures and
///    asserts every mesh vertex / collision point lies within MazeFootprint.Margin
///    of some predicted column box. Prints the worst offender so the constant is
///    MEASURED, not guessed. If geometry is ever added that overhangs further,
///    this test fails and the FFA hallway sizing must be revisited.
public partial class TestMazeFootprint : Node
{
    int _fail;
    void Check(bool ok, string label) { GD.Print((ok ? "PASS  " : "FAIL  ") + label); if (!ok) _fail++; }

    public override void _Ready()
    {
        // ── 1. Column logic ──────────────────────────────────────────────────
        var m = FfaFixtures.Slab(exitCol: 2, exitFloor: 1, slabFloor: 1);
        // Clear the slab where the extra pieces go — MazeLookup rejects two pieces on one cell.
        m.Pieces.RemoveAll(p => p.Type == PieceType.Room &&
            ((System.Math.Abs(p.X - 5) <= 1 && System.Math.Abs(p.Y - 5) <= 1) || (p.X == 8 && p.Y == 2) || (p.X == 1 && p.Y == 1)));
        m.Pieces.Add(new MazePiece { Type = PieceType.Pit,        X = 5, Y = 5, Floor = 1 });
        m.Pieces.Add(new MazePiece { Type = PieceType.StairsDown, X = 8, Y = 2, Floor = 1 });
        m.Pieces.Add(new MazePiece { Type = PieceType.StairsUp,   X = 1, Y = 1, Floor = 1 });
        var fp = MazeFootprint.From(m);
        Check(fp.ExitX == 2 && fp.ExitY == 9 && fp.ExitFloor == 1, "exit located");
        Check(fp.Columns[(4, 0)] == (-1, 0), "Start on floor 0 is relative floor −1 (exit floor 1); slab adds 0");
        Check(fp.Columns[(5, 5)].lo == -1 && fp.Columns[(5, 5)].hi == 1, "pit spans 3 floors");
        Check(fp.Columns[(4, 4)].lo == -1 && fp.Columns[(6, 6)].hi == 1, "pit 3x3 footprint included");
        Check(fp.Columns[(8, 2)].lo == -1, "StairsDown reaches one floor below");
        Check(fp.Columns[(8, 2)].hi == 0, "StairsDown column doesn't also reach above its own floor");
        Check(fp.Columns[(1, 1)].hi == 1, "StairsUp reaches one floor above");
        Check(fp.Columns[(1, 1)].lo == 0, "StairsUp column doesn't also reach below its own floor");
        var r1 = fp.Rotated(1);
        Check(r1.ExitX == 0 && r1.ExitY == 2 && r1.Columns[(9, 4)] == fp.Columns[(4, 0)],
              "Rotated(1) moves exit and columns with MazeRotation.RotateCell");

        // FfaFixtures.Traps: every trap type once, plus a legacy Stairs. Exit sits
        // on floor 0, so relative floors equal absolute floors here.
        var tp  = FfaFixtures.Traps();
        var fpt = MazeFootprint.From(tp);
        Check(fpt.Columns[(4, 2)] == (-1, 0), "TrapDoor column spans floor−1..floor relative to the exit floor");
        Check(fpt.Columns[(5, 5)].hi == 1, "legacy Stairs column reaches one floor above");

        // ── 2. Margin guard on real geometry ────────────────────────────────
        var fixtures = new List<MazeData> { DefaultMaze.Build(), FfaFixtures.Slab(0), FfaFixtures.Tall(9), m, tp };
        float worst = 0f; string worstWhere = "";
        foreach (var maze in fixtures)
        {
            var f = MazeFootprint.From(maze);
            var b = new DungeonBuilder { Name = "Probe" };
            AddChild(b);
            b.Build(maze, new Vector3(0f, -f.ExitFloor * DungeonBuilder.FloorHeight, 0f), Dir.S);
            foreach (var (p, where) in GeometryPoints(b))
            {
                float e = Excess(f, p);
                if (e > worst) { worst = e; worstWhere = $"{maze.Name}: {where} at {p}"; }
            }
            b.Free();
        }
        GD.Print($"[Footprint] worst protrusion past column boxes = {worst:F2} m ({worstWhere})");
        Check(worst <= MazeFootprint.Margin, $"all geometry within Margin={MazeFootprint.Margin} m");

        GD.Print(_fail == 0 ? "ALL PASS" : $"{_fail} FAILED");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }

    // Distance outside the nearest column box (0 when inside one), checking the
    // point's own column and its 8 neighbours — boxes are 10 m, margins are small.
    static float Excess(MazeFootprint f, Vector3 p)
    {
        int cx = Mathf.FloorToInt(p.X / DungeonBuilder.CellSize);
        int cy = Mathf.FloorToInt(p.Z / DungeonBuilder.CellSize);
        float best = float.MaxValue;
        for (int dx = -1; dx <= 1; dx++)
            for (int dy = -1; dy <= 1; dy++)
            {
                if (!f.Columns.TryGetValue((cx + dx, cy + dy), out var span)) continue;
                var box = MazeFootprint.ColumnBox(cx + dx, cy + dy, span.lo, span.hi);
                var q = p.Clamp(box.Position, box.End);
                float d = Mathf.Max(Mathf.Abs(p.X - q.X), Mathf.Max(Mathf.Abs(p.Y - q.Y), Mathf.Abs(p.Z - q.Z)));
                best = Mathf.Min(best, d);
            }
        return best;
    }

    static IEnumerable<(Vector3, string)> GeometryPoints(Node root)
    {
        foreach (var n in root.FindChildren("*", "", true, false))
        {
            if (n is MeshInstance3D mi && mi.Mesh != null)
            {
                var xf = mi.GlobalTransform;
                for (int s = 0; s < mi.Mesh.GetSurfaceCount(); s++)
                {
                    var arr = mi.Mesh.SurfaceGetArrays(s);
                    foreach (var v in arr[(int)Mesh.ArrayType.Vertex].AsVector3Array())
                        yield return (xf * v, mi.GetPath());
                }
            }
            else if (n is MultiMeshInstance3D mmi && mmi.Multimesh?.Mesh != null)
            {
                var aabb = mmi.Multimesh.Mesh.GetAabb();
                for (int i = 0; i < mmi.Multimesh.InstanceCount; i++)
                {
                    var xf = mmi.GlobalTransform * mmi.Multimesh.GetInstanceTransform(i);
                    for (int c = 0; c < 8; c++) yield return (xf * aabb.GetEndpoint(c), mmi.GetPath());
                }
            }
            else if (n is CollisionShape3D cs && cs.Shape != null)
            {
                var xf = cs.GlobalTransform;
                if (cs.Shape is ConcavePolygonShape3D cc)
                    foreach (var v in cc.GetFaces()) yield return (xf * v, cs.GetPath());
                else
                {
                    var aabb = cs.Shape.GetDebugMesh().GetAabb();
                    for (int c = 0; c < 8; c++) yield return (xf * aabb.GetEndpoint(c), cs.GetPath());
                }
            }
        }
    }
}
