using Godot;

/// Visual-only capture harness for Task 6 (editor trap glyphs). This is NOT part of
/// the headless assertion suite — it exists purely so a human (or an agent with the
/// Read tool) can look at what BuildTrapGlyph actually draws.
///
/// It renders each of the 8 traps through MazeEditor3D.BuildPieceInto directly — the
/// exact same method the palette thumbnails and grid tiles call — using the same
/// orthographic top-down camera setup as MazeEditor3D.SetupThumbs (Size = CS*1.35,
/// looking straight down, same background/ambient/sun) so what gets captured here is
/// representative of the real thumbnail, not a lookalike.
///
/// NOTE: as of this task, MazeEditor3D's palette array (`Palette`, top of the file)
/// only lists the 6 Structure/Traversal pieces — Room, Pit and all 8 traps are never
/// added to a palette cell, so the live TRAPS tab currently renders empty. That gap
/// is pre-existing and out of this task's scope (Task 6 only touches BuildPieceInto),
/// but it does mean BuildPieceInto/BuildTrapGlyph can't be reached by clicking through
/// the actual running editor today — hence calling them directly here.
///
/// Frames (one per captured PNG, ~1s apart at --fixed-fps 1):
///   0 Ice   1 Tar   2 Dark   3 Door   4 Gate@rot0   5 Gate@rot1
///   6 Push@rot0   7 Push@rot1   8 Portal   9 Grease
/// Frames 4/5 and 6/7 are the rotation check: same piece, rot 0 vs rot 1, to see
/// by eye whether the Gate/Push arrow visibly moves.
public partial class TestTrapGlyphs : Node3D
{
    Camera3D _cam = null!;
    // Starts at -1, not 0: --write-movie's first CAPTURED frame reflects state after
    // one _Process tick has already run (confirmed empirically — a Place(0) called
    // synchronously in _Ready was never captured; frame 0 showed Tiles[1] instead).
    // Starting one below and incrementing on the first tick lines capture index up
    // with Tiles index exactly.
    int _frame = -1;

    const float CS = DungeonBuilder.CellSize;

    static readonly (PieceType type, int rot, string note)[] Tiles =
    {
        (PieceType.TrapIce,    0, "Ice — Chevrons"),
        (PieceType.TrapTar,    0, "Tar — Drag"),
        (PieceType.TrapDark,   0, "Dark — Snuffed"),
        (PieceType.TrapDoor,   0, "Door — DownArrow"),
        (PieceType.TrapGate,   0, "Gate — BigArrow @rot0"),
        (PieceType.TrapGate,   1, "Gate — BigArrow @rot1"),
        (PieceType.TrapPush,   0, "Push — PushArrows @rot0"),
        (PieceType.TrapPush,   1, "Push — PushArrows @rot1"),
        (PieceType.TrapPortal, 0, "Portal — Portal ring"),
        (PieceType.TrapGrease, 0, "Grease — WallHatch"),
    };

    public override void _Ready()
    {
        // Mirrors MazeEditor3D.SetupThumbs' per-thumbnail WorldEnvironment exactly,
        // so glyph contrast/brightness here matches the real palette thumbnail.
        var worldEnv = new WorldEnvironment();
        worldEnv.Environment = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0.07f, 0.07f, 0.09f),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(0.45f, 0.45f, 0.45f),
            AmbientLightEnergy = 0.75f,
        };
        AddChild(worldEnv);

        AddChild(new DirectionalLight3D
        {
            Rotation    = new Vector3(-0.85f, 0.65f, 0f),
            LightEnergy = 1.1f,
        });

        var editor = new MazeEditor3D();   // never added to the tree — only used to call BuildPieceInto
        var root   = new Node3D();
        AddChild(root);

        // Spaced 3 cells apart (not 1): the real palette thumbnail isolates each
        // piece in its own SubViewport/OwnWorld3D so there is never a neighbor to
        // bleed in. This harness shares one 3D world across all 10 tiles instead
        // (simpler than 10 SubViewports), so tiles need enough gap that the capture's
        // wide 16:9 aspect (~2.4x the real square 96×96 thumbnail's horizontal reach
        // at the same orthographic Size) doesn't pull the next tile into frame.
        const float Gap = CS * 3f;
        for (int i = 0; i < Tiles.Length; i++)
        {
            var (type, rot, _) = Tiles[i];
            editor.BuildPieceInto(root, type, rot, i * Gap, 0f, 0f, isActive: true);
        }

        // Orthographic top-down, same Size as the real thumbnail camera (CS*1.35 —
        // fits one cell with a small margin).
        _cam = new Camera3D
        {
            Projection = Camera3D.ProjectionType.Orthogonal,
            Size       = CS * 1.35f,
            Current    = true,
        };
        AddChild(_cam);
        // Deliberately NOT calling Place(0) here — see the _frame comment above.
        // The first _Process tick does that instead.
    }

    void Place(int i)
    {
        float cx = i * (CS * 3f) + CS * 0.5f;
        _cam.Position = new Vector3(cx, 60f, CS * 0.5f);
        _cam.LookAt(new Vector3(cx, 0f, CS * 0.5f), new Vector3(0, 0, -1));
        GD.Print($"[frame {i}] {Tiles[i].note}");
    }

    public override void _Process(double delta)
    {
        _frame++;
        if (_frame >= Tiles.Length) { GetTree().Quit(); return; }
        Place(_frame);
    }
}
