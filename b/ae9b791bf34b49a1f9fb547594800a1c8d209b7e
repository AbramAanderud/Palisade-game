using Godot;

/// res://scripts/Rocket.cs
/// ─────────────────────────────────────────────────────────────────────────────
/// Projectile for the rocket launcher / quad rocket (GunCombat.FireMode.Projectile).
///
/// Deliberately NOT a RigidBody3D: it moves a fixed distance per frame and
/// raycasts across that step, so it can never tunnel through a wall at speed and
/// never inherits physics jitter. Detonates on the first thing it touches, then
/// applies falloff splash to every character in radius.
///
/// Damage routes back through the owning GunCombat.DeliverDamage so the existing
/// client-authoritative net relay ({"t":"hit"}) carries splash damage with no
/// protocol change.
/// ─────────────────────────────────────────────────────────────────────────────
public partial class Rocket : Node3D
{
    const float LifeSeconds = 6f;
    const float Gravity     = 3.5f;   // slight droop so long shots need leading

    GunCombat.GunDef _def   = null!;
    GunCombat?       _owner;
    Vector3          _vel;
    Rid              _shooterRid;
    float            _age = 0f;
    bool             _spent = false;

    public static Rocket Spawn(Node parent, Vector3 pos, Vector3 dir,
                               GunCombat.GunDef def, GunCombat owner)
    {
        var r = new Rocket
        {
            Name   = "Rocket",
            _def   = def,
            _owner = owner,
            _vel   = dir.Normalized() * def.ProjSpeed,
        };
        if (owner.GetParent() is CollisionObject3D shooter)
            r._shooterRid = shooter.GetRid();

        parent.AddChild(r);
        r.GlobalPosition = pos;
        r.BuildVisual();
        return r;
    }

    void BuildVisual()
    {
        var mat = new StandardMaterial3D
        {
            AlbedoColor              = new Color(1f, 0.62f, 0.20f),
            EmissionEnabled          = true,
            Emission                 = new Color(1f, 0.50f, 0.12f),
            EmissionEnergyMultiplier = 7f,
            ShadingMode              = BaseMaterial3D.ShadingModeEnum.Unshaded,
        };
        // Deliberately larger than scale realism would suggest. At 34-42 m/s a
        // physically-sized rocket is a handful of pixels and reads as an instant
        // hit; the projectile has to be trackable in the air for splash and
        // rocket-jumping to be learnable.
        //
        // Sized FROM _def.ProjRadius — the same number _PhysicsProcess sweeps —
        // so the thing you see is exactly the thing that collides. Hard-coding
        // these independently is what let the mesh and the hit test drift apart.
        float r = _def.ProjRadius;
        var body = new MeshInstance3D
        {
            Mesh = new CapsuleMesh { Radius = r, Height = r * 5f,
                                     RadialSegments = 10, Rings = 3 },
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        };
        body.SetSurfaceOverrideMaterial(0, mat);
        AddChild(body);

        // A wider, dimmer glow shell around the core so the rocket has a visible
        // silhouette even against a bright wall, not just against darkness.
        var glowMat = new StandardMaterial3D
        {
            AlbedoColor              = new Color(1f, 0.45f, 0.10f, 0.30f),
            EmissionEnabled          = true,
            Emission                 = new Color(1f, 0.40f, 0.08f),
            EmissionEnergyMultiplier = 3f,
            ShadingMode              = BaseMaterial3D.ShadingModeEnum.Unshaded,
            Transparency             = BaseMaterial3D.TransparencyEnum.Alpha,
            CullMode                 = BaseMaterial3D.CullModeEnum.Disabled,
        };
        var glow = new MeshInstance3D
        {
            Mesh = new SphereMesh { Radius = r * 2.3f, Height = r * 4.6f,
                                    RadialSegments = 10, Rings = 6 },
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        };
        glow.SetSurfaceOverrideMaterial(0, glowMat);
        AddChild(glow);

        // The rocket lights the corridor it flies down — the main reason a rocket
        // in a dark dungeon reads well.
        AddChild(new OmniLight3D
        {
            LightColor  = new Color(1f, 0.58f, 0.22f),
            LightEnergy = 6f,
            OmniRange   = 14f,
        });
    }

    // ── Exhaust trail ─────────────────────────────────────────────────────────
    // Puffs dropped along the flight path and faded out. This is what actually
    // makes the rocket's direction and speed readable — a lone moving dot does
    // not communicate travel, a receding line of embers does.
    const float TrailInterval = 0.022f;
    float _trailTimer = 0f;

    void DropTrailPuff()
    {
        var mat = new StandardMaterial3D
        {
            AlbedoColor              = new Color(1f, 0.55f, 0.20f, 0.75f),
            EmissionEnabled          = true,
            Emission                 = new Color(1f, 0.42f, 0.10f),
            EmissionEnergyMultiplier = 4f,
            ShadingMode              = BaseMaterial3D.ShadingModeEnum.Unshaded,
            Transparency             = BaseMaterial3D.TransparencyEnum.Alpha,
        };
        var puff = new MeshInstance3D
        {
            Mesh = new SphereMesh { Radius = 0.16f, Height = 0.32f,
                                    RadialSegments = 6, Rings = 4 },
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        };
        puff.SetSurfaceOverrideMaterial(0, mat);
        GetTree().Root.AddChild(puff);
        puff.GlobalPosition = GlobalPosition;

        var tw = puff.CreateTween();
        tw.TweenProperty(puff, "scale", Vector3.One * 1.9f, 0.45f);
        tw.Parallel().TweenProperty(mat, "albedo_color:a", 0f, 0.45f);
        tw.TweenCallback(Callable.From(puff.QueueFree));
    }

    public override void _PhysicsProcess(double delta)
    {
        if (_spent) return;

        float dt = (float)delta;
        _age += dt;
        if (_age > LifeSeconds) { QueueFree(); return; }

        _trailTimer -= dt;
        if (_trailTimer <= 0f)
        {
            _trailTimer = TrailInterval;
            DropTrailPuff();
        }

        _vel.Y -= Gravity * dt;
        if (_def.HomingTurnDeg > 0f && _age >= _def.HomingDelay)
            SteerTowardTarget(dt);

        var from = GlobalPosition;
        var to   = from + _vel * dt;

        // ── Sphere-sweep the step, not a hairline ray ─────────────────────────
        // This used to be IntersectRay: a zero-thickness line, while the rocket
        // DREW as a 0.17 m capsule. A rocket could visually clip a player and
        // sail straight past, which reads as the game ignoring an obvious hit.
        // Sweeping a sphere of _def.ProjRadius gives the projectile the volume
        // it already appeared to have (BuildVisual sizes the mesh from the same
        // number), and still cannot tunnel — CastMotion sweeps the whole step.
        var space  = GetWorld3D().DirectSpaceState;
        var motion = to - from;
        var query  = new PhysicsShapeQueryParameters3D
        {
            Shape             = new SphereShape3D { Radius = _def.ProjRadius },
            Transform         = new Transform3D(Basis.Identity, from),
            Motion            = motion,
            CollideWithBodies = true,
            CollideWithAreas  = false,
        };
        // Don't detonate inside the barrel of the person who fired it. At 34 m/s
        // the rocket is ~4 m clear well before this lapses, so a fat sphere
        // cannot clip its owner on the way out.
        if (_shooterRid.IsValid && _age < 0.12f)
            query.Exclude = new Godot.Collections.Array<Rid> { _shooterRid };

        // CastMotion returns [safe, unsafe] fractions of the motion; unsafe < 1
        // means something blocks the step.
        var frac = space.CastMotion(query);
        if (frac.Length == 2 && frac[1] < 1f)
        {
            var contact = from + motion * frac[1];

            // Re-place the shape at the contact point to learn WHAT was struck.
            query.Transform = new Transform3D(Basis.Identity, contact);
            query.Motion    = Vector3.Zero;
            var rest = space.GetRestInfo(query);

            Node3D? struck = null;
            Vector3 point  = contact;
            if (rest.Count > 0)
            {
                if (rest.ContainsKey("point"))
                    point = (Vector3)rest["point"];
                if (rest.ContainsKey("collider_id"))
                    struck = InstanceFromId((ulong)rest["collider_id"]) as Node3D;
            }
            Detonate(point, struck);
            return;
        }

        GlobalPosition = to;
        if (_vel.LengthSquared() > 0.01f)
            LookAt(GlobalPosition + _vel.Normalized(), Vector3.Up);
    }

    // ── Soft homing ───────────────────────────────────────────────────────────
    // No lock-on: every step, bend the heading toward the NEAREST opponent in a
    // cone ahead of the rocket, capped at HomingTurnDeg per second. Speed never
    // changes. The replicated (CosmeticOnly) rocket runs the same steering on
    // the opponent's client, so its path matches closely — not bit-for-bit, but
    // damage is the shooter's call anyway.
    void SteerTowardTarget(float dt)
    {
        if (_owner == null || !IsInstanceValid(_owner)) return;
        float speed = _vel.Length();
        if (speed < 0.01f) return;
        var heading = _vel / speed;

        float   coneCos = Mathf.Cos(Mathf.DegToRad(_def.HomingConeDeg));
        float   bestD   = _def.HomingRange;
        Vector3 aim     = Vector3.Zero;
        foreach (var body in GunCombat.OpponentBodies(GetTree(), _owner.GetParent(),
                                                      _owner.CombatTeam))
        {
            var   to = body.GlobalPosition - GlobalPosition;
            float d  = to.Length();
            if (d > bestD || d < 0.01f) continue;
            if (heading.Dot(to / d) < coneCos) continue;
            if (!CanSee(body)) continue;   // never curls toward someone behind a wall
            aim   = to / d;
            bestD = d;
        }
        if (aim == Vector3.Zero) return;

        float angle = heading.AngleTo(aim);
        var   axis  = heading.Cross(aim);
        if (angle < 1e-4f || axis.LengthSquared() < 1e-8f) return;
        float turn = Mathf.Min(angle, Mathf.DegToRad(_def.HomingTurnDeg) * dt);
        _vel = heading.Rotated(axis.Normalized(), turn) * speed;
    }

    bool CanSee(Node3D body)
    {
        var query = PhysicsRayQueryParameters3D.Create(GlobalPosition, body.GlobalPosition);
        query.CollideWithAreas = false;
        if (_shooterRid.IsValid)
            query.Exclude = new Godot.Collections.Array<Rid> { _shooterRid };
        var hit = GetWorld3D().DirectSpaceState.IntersectRay(query);
        return hit.Count == 0 || hit["collider"].As<GodotObject>() == body;
    }

    /// True for the REPLICATED rocket drawn on the opponent's client: full
    /// flight, light, and explosion, but zero damage — the shooter's client
    /// already resolved the hit and relayed it over {"t":"hit"}. Without this a
    /// replicated rocket would double-damage its victim.
    public bool CosmeticOnly = false;

    void Detonate(Vector3 at, Node3D? direct)
    {
        _spent = true;
        GlobalPosition = at;

        if (!CosmeticOnly)
        {
            // Direct hit takes full damage; everyone in radius takes falloff splash.
            if (direct != null)
            {
                var h = direct.GetNodeOrNull<PlayerHealth>("PlayerHealth");
                if (h != null && _owner != null && IsInstanceValid(_owner))
                    _owner.DeliverDamage(direct, h, _def.Damage, at, false);
            }
            ApplySplash(at, direct);
        }

        SpawnExplosion(at);

        // Let the light and mesh linger a frame so the flash is seen, then go.
        var tw = CreateTween();
        tw.TweenInterval(0.06);
        tw.TweenCallback(Callable.From(QueueFree));
    }

    void ApplySplash(Vector3 at, Node3D? skip)
    {
        if (_def.SplashRadius <= 0f || _owner == null || !IsInstanceValid(_owner)) return;

        // The shooter never eats their own splash: rocket jumping is movement
        // tech, not a health tax (the jump impulse is applied at fire time via
        // SelfKnockback, so skipping damage here costs the jump nothing).
        var ownerBody = _owner.GetParent<Node3D>();

        var shape = new SphereShape3D { Radius = _def.SplashRadius };
        var query = new PhysicsShapeQueryParameters3D
        {
            Shape             = shape,
            Transform         = new Transform3D(Basis.Identity, at),
            CollideWithBodies = true,
            CollideWithAreas  = false,
        };

        foreach (var res in GetWorld3D().DirectSpaceState.IntersectShape(query, 32))
        {
            if (res["collider"].As<GodotObject>() is not Node3D body) continue;
            if (body == skip) continue;        // already took the direct hit
            if (body == ownerBody) continue;   // no self-splash damage

            var health = body.GetNodeOrNull<PlayerHealth>("PlayerHealth");
            if (health == null) continue;

            // Linear falloff from full splash at the centre to zero at the edge.
            float d    = body.GlobalPosition.DistanceTo(at);
            float frac = Mathf.Clamp(1f - (d / _def.SplashRadius), 0f, 1f);
            float dmg  = _def.SplashDamage * frac;
            if (dmg < 1f) continue;

            _owner.DeliverDamage(body, health, dmg, body.GlobalPosition, false);
        }
    }

    void SpawnExplosion(Vector3 at)
    {
        // Boom: the heavy shot sample pitched down reads as an explosion until a
        // real one is sourced. Lives here, not in Detonate's damage path, so the
        // opponent's CosmeticOnly rocket booms identically.
        GunFx.PlayOneShot3D(this, "res://assets/audio/sfx/combat/GunShotHeavy.wav",
                            at, maxDist: 120f, pitch: 0.55f, volumeDb: 4f);

        var light = new OmniLight3D
        {
            LightColor  = new Color(1f, 0.6f, 0.25f),
            LightEnergy = 14f,
            OmniRange   = _def.SplashRadius * 3.5f,
        };
        GetTree().Root.AddChild(light);
        light.GlobalPosition = at;

        var mat = new StandardMaterial3D
        {
            AlbedoColor              = new Color(1f, 0.7f, 0.3f, 0.8f),
            EmissionEnabled          = true,
            Emission                 = new Color(1f, 0.5f, 0.15f),
            EmissionEnergyMultiplier = 8f,
            ShadingMode              = BaseMaterial3D.ShadingModeEnum.Unshaded,
            Transparency             = BaseMaterial3D.TransparencyEnum.Alpha,
        };
        var ball = new MeshInstance3D
        {
            Mesh = new SphereMesh { Radius = 0.5f, Height = 1f },
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        };
        ball.SetSurfaceOverrideMaterial(0, mat);
        GetTree().Root.AddChild(ball);
        ball.GlobalPosition = at;
        ball.Scale = Vector3.One * 0.3f;

        var tw = ball.CreateTween();
        tw.TweenProperty(ball, "scale", Vector3.One * _def.SplashRadius, 0.18f)
          .SetEase(Tween.EaseType.Out);
        tw.Parallel().TweenProperty(mat, "albedo_color:a", 0f, 0.22f);
        tw.Parallel().TweenProperty(light, "light_energy", 0f, 0.20f);
        tw.TweenCallback(Callable.From(() => { ball.QueueFree(); light.QueueFree(); }));
    }
}
