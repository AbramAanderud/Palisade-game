using Godot;
using System.Linq;

/// test/TestTeleportPairs.cs
/// Two teleporters per maze, two pads each, placed as pairs.
///
/// Every rule here fails SILENTLY if it regresses — you would only find out by
/// counting pads in the editor, or worse, by a third pad on one channel making
/// the runtime's LinkId pairing ambiguous mid-match (which two of the three
/// link?). So they are pinned:
///
///   - a fifth pad is refused
///   - pads fill teleporter 1 before starting teleporter 2, so they pair up in
///     placement order
///   - no channel ever holds three pads
///   - replacing an existing pad is not a new one (the cap must not lock you
///     out of moving a pad you already own)
///
/// Uses the same not-in-the-tree MazeEditor3D pattern as TestRoomPitLogic: the
/// placement rules touch only _maze.Pieces and PieceDB statics.
///
/// Pads are laid in a VERTICAL column on purpose. TrapPortal opens N|S only
/// (PieceDB), and the editor refuses any piece that cannot connect to an
/// existing one — a row of pads side by side is rejected by that rule, not by
/// the cap, which would make every assertion here pass for the wrong reason.
public partial class TestTeleportPairs : Node
{
    int _fail;
    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + label);
        if (!ok) _fail++;
    }

    static MazePiece Pad(int x, int y, int link) => new MazePiece
    {
        Type = PieceType.TrapPortal, X = x, Y = y, Floor = 0, LinkId = link,
    };

    public override void _Ready()
    {
        GD.Print("── teleporter pairing ──");
        var ed = new MazeEditor3D();

        int Placed(int x, int y)
        {
            // Mirrors PlacePiece: validate, then take the pairing channel.
            if (!ed.IsValidPlacement(x, y, PieceType.TrapPortal, 0, silent: true)) return -1;
            int ch = ed.NextFreeWarpChannel();
            ed._maze.Pieces.Add(Pad(x, y, ch));
            return ch;
        }

        ed._maze.Pieces.Clear();
        Check(Placed(1, 1) == 1, "pad 1 opens teleporter 1");
        Check(Placed(1, 2) == 1, "pad 2 completes teleporter 1 (pairs in order)");
        Check(Placed(1, 3) == 2, "pad 3 starts teleporter 2, not a third pad on 1");
        Check(Placed(1, 4) == 2, "pad 4 completes teleporter 2");
        // (1,5) connects N-S to the pad at (1,4), so ONLY the cap can refuse it.
        Check(Placed(1, 5) == -1, "pad 5 is REFUSED — two teleporters is the cap");

        // The decisive property: exactly two pads per channel, never three.
        foreach (var g in ed._maze.Pieces.Where(p => p.Type == PieceType.TrapPortal)
                                         .GroupBy(p => p.LinkId))
            Check(g.Count() == 2, $"teleporter {g.Key} holds exactly 2 pads (has {g.Count()})");
        Check(ed._maze.Pieces.Count(p => p.Type == PieceType.TrapPortal) == 4,
              "four pads total");

        // At the cap you must still be able to REPLACE a pad in place —
        // otherwise a full board becomes uneditable.
        Check(ed.IsValidPlacement(1, 1, PieceType.TrapPortal, 0, silent: true),
              "replacing an EXISTING pad is still allowed at the cap");
        Check(!ed.IsValidPlacement(1, 5, PieceType.TrapPortal, 0, silent: true),
              "an otherwise-connectable empty cell is refused at the cap");

        // Removing a pad frees exactly one slot, on that pad's own teleporter.
        ed._maze.Pieces.RemoveAll(p => p.Type == PieceType.TrapPortal && p.Y == 3);
        Check(ed.NextFreeWarpChannel() == 2, "removing a pad frees its own teleporter");
        Check(Placed(1, 5) == 2, "the freed slot is refilled on teleporter 2");

        // Channel cycling wraps across the two teleporters only — never to 3.
        GD.Print("── channel cycling ──");
        Check(MazeEditor3D.NextWarpChannel(1) == 2, "1 cycles to 2");
        Check(MazeEditor3D.NextWarpChannel(2) == 1, "2 wraps back to 1, never 3");
        Check(MazeEditor3D.NextWarpChannel(0) == 1, "a legacy LinkId 0 lands on 1");

        GD.Print(_fail == 0 ? "RESULT OK" : $"RESULT {_fail} FAILURE(S)");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
