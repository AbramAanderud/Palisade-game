            svp.AddChild(light);

            var root = new Node3D();
            svp.AddChild(root);
            BuildPieceInto(root, pt, 0, 0f, 0f, 0f, isActive: true);

            WireThumbTexture(pt);
        }
    }

    void WireThumbTexture(PieceType pt)
    {
        if (!_palPan.TryGetValue(pt, out var panel)) return;
        var tr = panel.GetNodeOrNull<TextureRect>("VBoxContainer/Thumb");
        if (tr == null)
        {
            // BuildPaletteCell adds a VBoxContainer as first child
            foreach (var child in panel.GetChildren())
            {
                if (child is VBoxContainer vb)
                {
                    tr = vb.GetNodeOrNull<TextureRect>("Thumb");
                    break;
                }
            }
        }
        if (tr != null && _thumbVp.TryGetValue(pt, out var svp))
            tr.Texture = svp.GetTexture();
    }

    // ── Active-floor reference plane ───────────────────────────────────────────
    // A faint blue slab + corner label sit at the active floor's Y so the eye has a
    // clear horizontal anchor that says "you are here." Built once at startup;
    // RefreshActiveFloorAnchor moves them whenever _floor changes.
    void BuildActiveFloorAnchor()
    {
        var plane = new PlaneMesh { Size = new Vector2(GW * CS, GH * CS) };
        var mat = new StandardMaterial3D
        {
            AlbedoColor  = new Color(0.25f, 0.55f, 1.0f, 0.10f),
            Transparency = BaseMaterial3D.TransparencyEnum.Alpha,
            ShadingMode  = BaseMaterial3D.ShadingModeEnum.Unshaded,
            CullMode     = BaseMaterial3D.CullModeEnum.Disabled,
            // Keep the plane from z-fighting with piece arm-floors that sit at the same Y.
            // RenderPriority -1 plus the small Y offset in RefreshActiveFloorAnchor pushes
            // it below the arm geometry in the draw order.
            RenderPriority = -1,
        };
        _activeFloorPlane = new MeshInstance3D { Mesh = plane, MaterialOverride = mat };
        _world.AddChild(_activeFloorPlane);

        _activeFloorLabel = new Label3D
        {
            Text             = $"FLOOR {_floor}",
            FontSize         = 96,
            PixelSize        = 0.03f,
            Modulate         = new Color(0.55f, 0.80f, 1.0f, 0.95f),
            OutlineSize      = 12,
            OutlineModulate  = new Color(0f, 0f, 0f, 0.85f),
            Billboard        = BaseMaterial3D.BillboardModeEnum.Enabled,
            NoDepthTest      = true,
            HorizontalAlignment = HorizontalAlignment.Center,
        };
        _world.AddChild(_activeFloorLabel);

        RefreshActiveFloorAnchor();
    }

    void RefreshActiveFloorAnchor()
    {
        if (_activeFloorPlane == null || _activeFloorLabel == null) return;

        float planeY = _floor * EdFH + 0.02f;             // just above the piece base
        float labelY = _floor * EdFH + 2.5f;              // hover well above the plane

        _activeFloorPlane.Position = new Vector3(GW * CS * 0.5f, planeY, GH * CS * 0.5f);

        // Label sits just past the NE corner so it stays clear of the playable cells.
        _activeFloorLabel.Position = new Vector3(GW * CS + 3f, labelY, -3f);
        _activeFloorLabel.Text     = $"FLOOR {_floor}";
    }

    // ── Floor grids ────────────────────────────────────────────────────────────
    void BuildFloorGrids()
    {
        for (int f = FlMin; f <= FlMax; f++)
        {
            var mi = BuildGridMesh(f, GridAlpha(f));
            _world.AddChild(mi);
            _gridMi[f] = mi;
        }
        RefreshGridOpacity();   // apply the blue active-floor tint at startup
    }

    MeshInstance3D BuildGridMesh(int floor, float alpha)
    {
        float y    = floor * EdFH + FlrT + 0.05f;
        float barW = 0.40f;   // visible at 145 m camera distance
        float barH = 0.12f;

        var mat = new StandardMaterial3D
        {
            AlbedoColor  = new Color(0.55f, 0.55f, 0.55f, alpha),
            Transparency = alpha < 0.999f
                ? BaseMaterial3D.TransparencyEnum.Alpha
                : BaseMaterial3D.TransparencyEnum.Disabled,
            ShadingMode  = BaseMaterial3D.ShadingModeEnum.Unshaded,
        };

        var st = new SurfaceTool();
        st.Begin(Mesh.PrimitiveType.Triangles);

        void AddBar(Vector3 centre, Vector3 size)
        {
            float hx = size.X * 0.5f, hy = size.Y * 0.5f, hz = size.Z * 0.5f;
            Vector3[] c =
            {
                centre + new Vector3(-hx, -hy, -hz), centre + new Vector3( hx, -hy, -hz),
                centre + new Vector3( hx,  hy, -hz), centre + new Vector3(-hx,  hy, -hz),
                centre + new Vector3(-hx, -hy,  hz), centre + new Vector3( hx, -hy,  hz),
                centre + new Vector3( hx,  hy,  hz), centre + new Vector3(-hx,  hy,  hz),
            };
            void Tri(int a, int b, int d) { st.AddVertex(c[a]); st.AddVertex(c[b]); st.AddVertex(c[d]); }
            Tri(0,2,1); Tri(0,3,2);  // -Z
            Tri(4,5,6); Tri(4,6,7);  // +Z
            Tri(0,4,7); Tri(0,7,3);  // -X
            Tri(1,2,6); Tri(1,6,5);  // +X
            Tri(3,7,6); Tri(3,6,2);  // +Y
            Tri(0,1,5); Tri(0,5,4);  // -Y
        }

        for (int i = 0; i <= GW; i++)
        {
            float x = i * CS, lenZ = GH * CS;
            AddBar(new Vector3(x, y, lenZ * 0.5f), new Vector3(barW, barH, lenZ));
        }
        for (int j = 0; j <= GH; j++)
        {
            float z = j * CS, lenX = GW * CS;
            AddBar(new Vector3(lenX * 0.5f, y, z), new Vector3(lenX, barH, barW));
        }

        st.GenerateNormals();
        return new MeshInstance3D { Mesh = st.Commit(), MaterialOverride = mat };
    }

    // Visibility falls off with distance from the current floor.
    // Floors below fade gently; floors above fade aggressively so the maze you're
    // editing always reads clearly without the ceiling grid drowning it out.
    float GridAlpha(int f)
    {
        int dist = _floor - f;          // positive = below, negative = above
        if (dist == 0) return 0.80f;
        if (dist  > 0) return Mathf.Max(0.45f * Mathf.Pow(0.65f,  dist - 1), 0.05f);
        return                Mathf.Max(0.18f * Mathf.Pow(0.45f, -dist - 1), 0.02f);
    }

    // Active floor gets a saturated blue tint so the workspace plane is unmistakable.
    // Other floors keep the neutral grey so they don't compete for attention.
    static readonly Color GridColorActive   = new(0.25f, 0.55f, 1.0f);
    static readonly Color GridColorInactive = new(0.55f, 0.55f, 0.55f);

    void RefreshGridOpacity()
    {
        foreach (var (f, mi) in _gridMi)
        {
            if (mi.MaterialOverride is not StandardMaterial3D m) continue;
            Color c = (f == _floor) ? GridColorActive : GridColorInactive;
            m.AlbedoColor = new Color(c.R, c.G, c.B, GridAlpha(f));
        }
        RefreshActiveFloorAnchor();
    }

    // ── Piece geometry ─────────────────────────────────────────────────────────
    void RebuildGeometry()
    {
        foreach (var n in _cellGeo.Values) n.QueueFree();
        _cellGeo.Clear();

        // Render every placed piece on its own floor. Stairs no longer auto-spawn an
        // inverse "landing" piece on the destination floor — the user is required to
        // place an actual piece at the landing cell. The stair's step geometry still
        // physically spans both floors, so the destination-floor view shows the stair
        // structure translucent through the floor without a separate landing visual.
        foreach (var p in _maze.Pieces)
        {
            var  key = new CK(p.X, p.Y, p.Floor);
            bool act = p.Floor == _floor;
            var  geo = new Node3D();
            _world.AddChild(geo);
            BuildPieceInto(geo, p.Type, p.Rotation,
                           p.X * CS, p.Floor * EdFH, p.Y * CS, act);
            _cellGeo[key] = geo;
        }

        // Edge walls (the translucent grey panels between cells) were removed —
        // the pieces themselves now indicate the floor plan via their active blue tint,
        // and the cleaner look matches a top-down floor plan instead of a wireframe.
        ClearEdgeWalls();
    }

    void ClearEdgeWalls()
    {
        foreach (var mi in _edgeWalls) { if (IsInstanceValid(mi)) mi.QueueFree(); }
        _edgeWalls.Clear();
    }

    // Stair color rule (two-mode):
    //
    //   • LONE stair (not part of a multi-piece chain): PERSPECTIVE-based.
    //       cyan  = this stair goes UP off the active floor
    //       purple = this stair goes DOWN off the active floor
    //     So a StairsUp@floor 0 viewed from floor 1 reads as PURPLE — from the user's
    //     POV on floor 1, the stair descends to floor 0. The piece's native type is
    //     ignored; what matters is "is the player going up or down via this piece."
    //
    //   • CHAINED stair (≥2 same-type stairs linked end-to-end): TYPE-based.
    //       StairsUp chain  → cyan   on every piece in the chain
    //       StairsDown chain → purple on every piece in the chain
    //     A chain is a deliberate unidirectional run — the user built it as a
    //     staircase, so it should read as one consistent color across all its pieces,
    //     even when you view it from the landing-floor side of one of the links.
    //
    //   • Stair that doesn't touch the active floor at either endpoint → dim gray.
    Color StairColorForView(PieceType type, int rot, float wx, float wy, float wz)
    {
        int pieceFloor = Mathf.RoundToInt(wy / EdFH);
        int delta      = PieceDB.StairFloorDelta(type);
        int otherFloor = pieceFloor + delta;

        // Off-floor pieces stay gray regardless of chain status.
        if (_floor != pieceFloor && _floor != otherFloor) return CStair;

        // ── Chain detection ──────────────────────────────────────────────────────
        // We're in a chain if either (a) my cross-floor landing holds a same-type
        // stair (downstream link), or (b) some other same-type stair's cross-floor
        // landing lands on MY cell (upstream link). The upstream check scans because
        // the upstream piece's rotation could differ — a fixed-offset lookup would
        // miss it.
        int pieceX = Mathf.RoundToInt(wx / CS);
        int pieceY = Mathf.RoundToInt(wz / CS);
        bool inChain = false;

        Dir myCross = PieceDB.GetStairCrossDir(type, rot);
        var (mdx, mdy) = DirToOffset(myCross);
        if (TryGetPlacedPieceOnFloor(pieceX + mdx, pieceY + mdy, pieceFloor + delta, out var downstream) &&
            downstream.Type == type)
            inChain = true;

        if (!inChain)
        {
            foreach (var s in _maze.Pieces)
            {
                if (s.Type != type) continue;
                if (s.X == pieceX && s.Y == pieceY && s.Floor == pieceFloor) continue;
                if (s.Floor + delta != pieceFloor) continue;
                Dir sCross = PieceDB.GetStairCrossDir(s.Type, s.Rotation);
                var (sdx, sdy) = DirToOffset(sCross);
                if (s.X + sdx == pieceX && s.Y + sdy == pieceY) { inChain = true; break; }
            }
        }

        if (inChain)
            return delta > 0 ? CStairActiveUp : CStairActiveDown;

        // ── Lone stair: perspective-based ────────────────────────────────────────
        // From the active floor, does the stair go up or down?
        //   if home is the active floor and delta > 0: goes UP → cyan.
        //   if home is the active floor and delta < 0: goes DOWN → purple.
        //   if landing is the active floor: invert (we're looking at the OTHER end).
        if (_floor == pieceFloor) return delta > 0 ? CStairActiveUp : CStairActiveDown;
        return delta > 0 ? CStairActiveDown : CStairActiveUp;
    }

    /// True iff the stair piece at (wy) has at least one endpoint on the active floor —
    /// either its home cell or its cross-floor landing. Used so the brightness matches
    /// the highlight color: a stair that's cyan/purple because its landing is on _floor
    /// renders at the SAME opacity as a stair whose home is _floor. Without this they'd
    /// share the color but the cross-floor one would be a faded ghost.
    bool StairTouchesActiveFloor(PieceType type, float wy)
    {
        int pieceFloor = Mathf.RoundToInt(wy / EdFH);
        int delta      = PieceDB.StairFloorDelta(type);
        return _floor == pieceFloor || _floor == pieceFloor + delta;
    }

    // internal (not private): the visual-capture harness (TestTrapGlyphs.cs) calls
    // this directly so a rendered frame goes through the exact same path the
    // palette thumbnails and grid tiles use — no separate rendering code to drift
    // out of sync with what a maze author actually sees.
    internal void BuildPieceInto(Node3D parent, PieceType type, int rot,
                        float wx, float wy, float wz, bool isActive)
    {
        // Inactive floors keep their natural color (green Start, red Exit, orange Stair, white Floor)
        // but render at lower alpha — easier to identify pieces on adjacent floors at a glance.
        // Stairs flip to bright blue when they live on the floor the player is currently
        // editing, so a busy column of orange stairs across many floors clearly highlights
        // which one you're actively on.
        // Start/Exit always render in their dedicated colors regardless of floor
        // (the user explicitly wants those two to stay green/red and not turn blue).
        // Every other piece type tints blue when it's on the floor you're editing.
        // Stairs are colored by whether they touch the active floor — see StairColorForView
        // for the full rule. Non-stair pieces still use the simple isActive split.
        // Room, Pit, and every trap get their own dedicated PieceDB.Colors entry
        // instead of falling through to the generic active-blue/inactive-white
        // split — that fallback made all ten of them indistinguishable from each
        // other and from a plain corridor. The dedicated color always applies
        // (not just when isActive); ghosting on non-active floors is handled
        // purely by the flrA alpha computed below, matching how Start/Exit keep
        // their own hue and only fade via alpha/lerp rather than swapping color.
        Color floorCol = type switch
        {
            PieceType.Start  => CStart,
            PieceType.Exit   => CExit,
            _ when PieceDB.IsStair(type) => StairColorForView(type, rot, wx, wy, wz),
            PieceType.Room   => PieceDB.Colors[PieceType.Room],
            PieceType.Pit    => PieceDB.Colors[PieceType.Pit],
            _ when TrapDB.IsTrap(type) => PieceDB.Colors[type],
            _ => isActive ? CActive : CFloor,
        };

        // Desaturate Start/Exit toward gray on non-active floors so their bright
        // accents stop competing with the layer you're editing. Stairs are exempt
        // because StairColorForView already returns gray for stairs that don't
        // touch the active floor (the cyan/purple cases stay vivid on purpose).
        if (!isActive && !PieceDB.IsStair(type) &&
            (type == PieceType.Start || type == PieceType.Exit))
            floorCol = floorCol.Lerp(CFloor, 0.5f);

        float cx   = wx + CS * 0.5f;
        float cy   = wy + FlrT * 0.5f;
        float cz   = wz + CS * 0.5f;

        // Inactive floors ghost down to ~0.25–0.30 alpha — strong enough to retain
        // depth context, faint enough that the active floor is the unambiguous focal
        // layer. Floors above the current one fade slightly less since the camera
        // sees them through translucent geometry stacks.
        //
        // EXCEPT for stair pieces whose landing touches the active floor: they're
        // highlighted cyan/purple by StairColorForView, and we want their brightness
        // to match the same-floor case so the chain reads as one continuous run.
        //
        // Computed here (ahead of the Room/Pit early-outs below) because both of
        // those custom-rendered types need it too.
        float flrA;
        if (isActive || (PieceDB.IsStair(type) && StairTouchesActiveFloor(type, wy)))
            flrA = 1f;
        else
        {
            int pieceFloor = Mathf.RoundToInt(wy / EdFH);
            flrA = pieceFloor > _floor ? 0.30f : 0.22f;
        }

        // Open Room — one flat full-cell slab. Adjacent room tiles abut exactly, so a
        // painted room reads as a single continuous floor in the editor too.
        if (type == PieceType.Room)
        {
            parent.AddChild(MakeMeshBox(
                new Vector3(cx, cy, cz),
                new Vector3(CS - 0.06f, FlrT, CS - 0.06f),
                floorCol, flrA));
            return;
        }

        // Pit — a 3x3 open frame with a hollow centre, drawn at the anchor. The frame
        // shows the footprint it claims; the vertical bars show the shaft's span.
        if (type == PieceType.Pit)
        {
            float ringY = cy;
            // Four edge bars outlining the 3x3 footprint.
            void Edge(Vector3 pos, Vector3 sz)
                => parent.AddChild(MakeMeshBox(pos, sz, floorCol, flrA));

            Edge(new Vector3(cx, ringY, cz - CS), new Vector3(CS * 3f, FlrT, CS));
            Edge(new Vector3(cx, ringY, cz + CS), new Vector3(CS * 3f, FlrT, CS));
            Edge(new Vector3(cx - CS, ringY, cz), new Vector3(CS, FlrT, CS));
            Edge(new Vector3(cx + CS, ringY, cz), new Vector3(CS, FlrT, CS));

            // Shaft bars at the four corners, spanning one floor up and one down.
            float span = EdFH * 2f;
            foreach (var (sx, sz2) in new[] { (-1f, -1f), (1f, -1f), (-1f, 1f), (1f, 1f) })
                parent.AddChild(MakeMeshBox(
                    new Vector3(cx + sx * CS * 1.5f, ringY, cz + sz2 * CS * 1.5f),
                    new Vector3(0.7f, span, 0.7f),
                    floorCol, flrA * 0.4f));
            return;
        }

        // Stair pieces don't get a central floor square — the step geometry below already
        // fills that space, so the orange flat slab was redundant.
        if (type != PieceType.StairsUp && type != PieceType.StairsDown)
        {
            parent.AddChild(MakeMeshBox(
                new Vector3(cx, cy, cz),
                new Vector3(CentW - 0.1f, FlrT, CentW - 0.1f),
                floorCol, flrA));
        }

        Dir open = PieceDB.GetOpenings(type, rot);
        // For stair pieces, suppress the arm floor on the CROSS side. The cross side is
        // where the steps reach a different floor's Y, so a floor patch at the home Y
        // sits OVER the descending/ascending steps and visually breaks the chain — most
        // noticeable on StairsDown chains where it appears as a lip at home-floor level
        // blocking the view of the next stair below.
        Dir crossDir = PieceDB.IsStair(type) ? PieceDB.GetStairCrossDir(type, rot) : Dir.None;

        void ArmFloor(float ax, float az, float aw, float ad)
            => parent.AddChild(MakeMeshBox(
                   new Vector3(ax, cy, az),
                   new Vector3(aw - 0.1f, FlrT, ad - 0.1f),
                   floorCol, flrA));

        if ((open & Dir.N) != 0 && crossDir != Dir.N) ArmFloor(cx,              wz + ArmLen * 0.5f,      ArmW, ArmLen);
        if ((open & Dir.S) != 0 && crossDir != Dir.S) ArmFloor(cx,              wz + CS - ArmLen * 0.5f, ArmW, ArmLen);
        if ((open & Dir.E) != 0 && crossDir != Dir.E) ArmFloor(wx + CS - ArmLen * 0.5f, cz,              ArmLen, ArmW);
        if ((open & Dir.W) != 0 && crossDir != Dir.W) ArmFloor(wx + ArmLen * 0.5f,      cz,              ArmLen, ArmW);

        if (TrapDB.IsTrap(type))
            BuildTrapGlyph(parent, type, rot, cx, cy + FlrT, cz, floorCol, flrA);

        if (type == PieceType.StairsUp || type == PieceType.StairsDown)
            BuildStairGeo(parent, type, rot, wx, wy, wz, isActive);
    }

    // ── Trap glyphs ───────────────────────────────────────────────────────────
    // A trap tile has to say what it DOES at a glance, from an isometric camera,
    // at thumbnail size. Each glyph is a handful of small boxes: chevrons for the
    // slide direction, a big arrow for the traps whose rotation matters, a ring for
    // a teleport pad, hatching for greased walls.
    // internal (not private): TestTraps.cs calls this directly to assert that the
    // glyph geometry for directional traps (Gate/Push) actually moves under
    // rotation, and that non-directional traps' glyphs don't — without needing
    // eyes on a rendered frame.
    internal void BuildTrapGlyph(Node3D parent, PieceType type, int rot,
                        float cx, float cy, float cz, Color col, float alpha)
    {
        // Bright, near-opaque marks — the glyph must beat the tile tint underneath it.
        // Now that traps render in their own PieceDB.Colors hue (was: a shared
        // active-blue/inactive-white tile), a couple of the trap colors are
        // already light — TrapIce's pale cyan (luminance ~0.83) most of all,
        // TrapDoor's amber (~0.68) to a lesser degree. Lerping those toward
        // white the same way the old dark/mid-tone tiles were lerped produces a
        // near-white-on-near-white glyph that washes out. Instead, pick the
        // contrast direction from the tile's own luminance: darken the mark on
        // a light tile, lighten it on a dark one. This leaves the other six
        // traps (all below the threshold) rendering identically to before.
        float lum = 0.299f * col.R + 0.587f * col.G + 0.114f * col.B;
        Color contrastTarget = lum > 0.6f ? new Color(0.05f, 0.05f, 0.05f) : new Color(1f, 1f, 1f);
        Color mark = col.Lerp(contrastTarget, 0.55f);
        float a    = Mathf.Min(1f, alpha + 0.25f);
        float gy   = cy + 0.06f;

        void Mk(float ox, float oz, float w, float d)
            => parent.AddChild(MakeMeshBox(
                   new Vector3(cx + ox, gy, cz + oz),
                   new Vector3(w, 0.10f, d), mark, a));

        // Unit vector for the piece's facing, matching TrapBuilder.FacingVector.
        int r = ((rot % 4) + 4) % 4;
        float fx = r == 1 ? 1f : r == 3 ? -1f : 0f;
        float fz = r == 2 ? 1f : r == 0 ? -1f : 0f;

        switch (TrapDB.Glyph(type))
        {
            case TrapGlyph.Chevrons:      // ice — three chevrons pointing along the corridor
                for (int i = -1; i <= 1; i++)
                {
                    Mk(-1.1f, i * 2.4f, 2.2f, 0.5f);
                    Mk( 1.1f, i * 2.4f + 0.9f, 2.2f, 0.5f);
                }
                break;

            case TrapGlyph.Drag:          // tar — a dense field of short drag marks
                for (int i = -1; i <= 1; i++)
                    for (int j = -1; j <= 1; j++)
                        Mk(i * 2.0f, j * 2.0f, 0.5f, 1.6f);
                break;

            case TrapGlyph.Snuffed:       // dark — a hollow ring around a dead centre
                Mk(0f, -2.2f, 4.4f, 0.5f);
                Mk(0f,  2.2f, 4.4f, 0.5f);
                Mk(-2.2f, 0f, 0.5f, 4.4f);
                Mk( 2.2f, 0f, 0.5f, 4.4f);
                break;

            case TrapGlyph.DownArrow:     // trapdoor — arrow head pointing down-screen
                Mk(0f, -1.4f, 0.7f, 3.2f);
                Mk(-1.0f, 1.0f, 2.6f, 0.6f);
                Mk( 1.0f, 1.0f, 2.6f, 0.6f);
                Mk(0f, 2.0f, 1.4f, 0.6f);
                break;

            case TrapGlyph.BigArrow:      // one-way gate — one large arrow along the facing
                Mk(fx * -1.0f, fz * -1.0f,
                   Mathf.Abs(fz) > 0.5f ? 0.9f : 5.0f,
                   Mathf.Abs(fz) > 0.5f ? 5.0f : 0.9f);
                Mk(fx * 2.2f - fz * 1.3f, fz * 2.2f + fx * 1.3f, 2.0f, 2.0f);
                Mk(fx * 2.2f + fz * 1.3f, fz * 2.2f - fx * 1.3f, 2.0f, 2.0f);
                break;

            case TrapGlyph.PushArrows:    // push tile — three stacked arrows along the facing
                for (int i = -1; i <= 1; i++)
                {
                    float px = fz * i * 2.2f, pz = fx * i * 2.2f;
                    Mk(px + fx * -0.8f, pz + fz * -0.8f,
                       Mathf.Abs(fz) > 0.5f ? 0.5f : 3.4f,
                       Mathf.Abs(fz) > 0.5f ? 3.4f : 0.5f);
                    Mk(px + fx * 1.8f, pz + fz * 1.8f, 1.2f, 1.2f);
                }
                break;

            case TrapGlyph.Portal:        // teleport — concentric ring
                Mk(0f, -1.8f, 3.6f, 0.5f);
                Mk(0f,  1.8f, 3.6f, 0.5f);
                Mk(-1.8f, 0f, 0.5f, 3.6f);
                Mk( 1.8f, 0f, 0.5f, 3.6f);
                Mk(0f, 0f, 1.0f, 1.0f);
                break;

            case TrapGlyph.WallHatch:     // greased walls — hatching along both side walls
                for (int i = -2; i <= 2; i++)
                {
                    Mk(-3.4f, i * 1.7f, 1.4f, 0.4f);
                    Mk( 3.4f, i * 1.7f, 1.4f, 0.4f);
                }
                break;
        }
    }

    void BuildStairGeo(Node3D parent, PieceType type, int rot,
                       float wx, float wy, float wz, bool isActive)
    {
        int  delta      = PieceDB.StairFloorDelta(type);
        Dir  highEndDir = delta > 0
            ? PieceDB.GetStairCrossDir(type, rot)
            : PieceDB.GetStairFlatDir(type, rot);

        // Unit vector pointing from the low end of the stair toward the high end
        float fwdX = highEndDir == Dir.E ? 1f : highEndDir == Dir.W ? -1f : 0f;
        float fwdZ = highEndDir == Dir.S ? 1f : highEndDir == Dir.N ? -1f : 0f;

        // lowY = floor the stairs sit on; highY = connected floor above/below
        float lowY  = delta > 0 ? wy          : wy + delta * EdFH;
        float highY = delta > 0 ? wy + EdFH   : wy;

        // 9 step positions span the full EdFH with 1 m of rise between each step.
        // Step 0 sits at the lower-floor surface and step NS-1 sits at the upper-floor
        // surface. That's the seam-fixer: chained StairsDown's bottom step (lowY) now
        // meets the next StairsDown's top step (highY = lowY of the upper one) at the
        // cell boundary with zero vertical gap. The old 8-step version put step 0 at
        // lowY+1m, leaving a visible 1 m drop between adjacent stairs going down.
        // StairsUp didn't show it because that chain meets at top-step ↔ flat-arm, both
        // at home-floor Y; StairsDown chains meet at bottom-step ↔ flat-arm and exposed
        // the gap.
        const int NS = 9;
        float stepH = CS / NS;
        float stepV = EdFH / (NS - 1);

        float lx = wx + CS * 0.5f - fwdX * CS * 0.5f;
        float lz = wz + CS * 0.5f - fwdZ * CS * 0.5f;

        // Stair color: lone stairs use perspective-based, chained stairs use native
        // type-based — see StairColorForView for the full rule.
        Color col = StairColorForView(type, rot, wx, wy, wz);
        // A stair whose landing reaches the active floor is highlighted cyan/purple
        // (via StairColorForView) — match its brightness to the same-floor case so
        // both ends of a chain pop at the same intensity. Stairs that don't touch
        // _floor stay ghosted at the inactive alpha.
        float alpha;
        if (isActive || StairTouchesActiveFloor(type, wy))
            alpha = 0.95f;
        else
        {
            int pieceFloor = Mathf.RoundToInt(wy / EdFH);
            alpha = pieceFloor > _floor ? 0.30f : 0.22f;
        }

        for (int i = 0; i < NS; i++)
        {
            float scx = lx + fwdX * (i + 0.5f) * stepH;
            float scy = lowY + i * stepV + FlrT * 0.5f;          // i=0 → lowY, i=NS-1 → highY
            float scz = lz + fwdZ * (i + 0.5f) * stepH;

            float tw = fwdZ != 0 ? CentW - 0.1f : stepH * 0.88f;
            float td = fwdX != 0 ? CentW - 0.1f : stepH * 0.88f;

            parent.AddChild(MakeMeshBox(new Vector3(scx, scy, scz),
                                        new Vector3(tw, FlrT, td), col, alpha));
        }

        // Shaft connecting the two floor levels — shows the vertical link clearly
        float sx = wx + CS * 0.5f + fwdX * CS * 0.38f;
        float sz = wz + CS * 0.5f + fwdZ * CS * 0.38f;
        parent.AddChild(MakeMeshBox(
            new Vector3(sx, (lowY + highY) * 0.5f, sz),
            new Vector3(0.9f, highY - lowY, 0.9f),
            col, isActive ? 0.22f : 0.07f));
    }

    // ── Camera update ──────────────────────────────────────────────────────────
    void UpdateCamera()
    {
        float cp = Mathf.Cos(_camPitch), sp = Mathf.Sin(_camPitch);
        float cy = Mathf.Cos(_camYaw),   sy = Mathf.Sin(_camYaw);

        float targetFloorY = _floor * EdFH;
        var   target  = new Vector3(GridCentre.X + _camPan.X, targetFloorY + WallH * 0.35f, GridCentre.Z + _camPan.Z);
        var   offset  = new Vector3(sy * cp, sp, cy * cp) * _camDist;

        _cam.Position = target + offset;
        // Near-vertical pitch: use -Z as up so North stays at screen-top
        var up = _camPitch > 1.50f ? new Vector3(0, 0, -1) : Vector3.Up;
        _cam.LookAt(target, up);
    }

    // ── Viewport input handling ────────────────────────────────────────────────
    void HandleVpInput(InputEvent ev)
    {
        if (ev is InputEventMouseButton mb)
        {
            if (mb.ButtonIndex == MouseButton.Right)
            {
                if (mb.Pressed)
                {
                    _rmb      = true;
                    _rmbDrag  = false;
                    _rmbStart = mb.Position;
                }
                else
                {
                    bool wasDrag = _rmbDrag;
                    _rmb = _rmbDrag = false;
                    if (!wasDrag)
                    {
                        // Right-click is the unified cancel/delete gesture (Escape and D
                        // were removed). Priority is:
                        //   1. If a piece is being held (picked up off the grid) → discard it
                        //   2. If a palette piece is selected (preview ghost showing) → clear the selection
                        //   3. Otherwise, if the cursor is over a placed piece, delete that piece
                        //      (Start/Exit are still permanent and refuse deletion).
                        if (_holding)
                        {
                            AbandonHolding();
                        }
                        else if (_roomAnchor != null)
                        {
                            // Right-click is this editor's unified cancel gesture (see the
                            // comment above); a half-finished room drag cancels first so a
                            // second right-click is still available to clear the Room
                            // selection itself.
                            CancelRoomPaint();
                        }
                        else if (_selType.HasValue)
                        {
                            _selType = null;
                            RefreshPalette();
                            RebuildBorderHints();
                            RebuildPreviewGeo();
                            SetStatus();
                        }
                        else if (TryGetCell(mb.Position, out int cx, out int cy))
                        {
                            // Cross-floor-aware: this also resolves stairs whose home
                            // floor is _floor±1 but whose landing visually sits at the
                            // active floor's cell.
                            if (TryGetActiveFloorPiece(cx, cy, out var rp) &&
                                (rp.Type == PieceType.Start || rp.Type == PieceType.Exit))
                            {
                                SetStatus($"{PieceDB.Labels[rp.Type]} cannot be removed — move it instead.");
                            }
                            else
                            {
                                RemovePiece(cx, cy);
                                RebuildGeometry();
                            }
                        }
                    }
                }
                GetViewport().SetInputAsHandled();
            }
            else if (mb.ButtonIndex == MouseButton.Left && mb.Pressed)
            {
                if (TryGetCell(mb.Position, out int cx, out int cy))
                {
                    if (_holding)
                        DropPiece(cx, cy);
                    // Room painting takes two clicks: first sets a corner, second fills
                    // the rectangle. Checked before the pick-up path so clicking an
                    // existing Room tile extends the drag instead of picking it up.
                    else if (_selType == PieceType.Room)
                    {
                        if (_roomAnchor == null)
                        {
                            _roomAnchor = (cx, cy);
                            _clickSfx?.Play();
                            SetStatus("Room corner set — click the opposite corner  |  right-click to cancel");
                        }
                        else
                        {
                            var (ax, ay) = _roomAnchor.Value;
                            _roomAnchor = null;
                            PaintRoomRect(ax, ay, cx, cy);
                        }
                    }
                    // Cross-floor-aware: pickup applies to stairs whose landing visually
                    // sits on the active floor too, not just pieces with home == _floor.
                    else if (TryGetActiveFloorPiece(cx, cy, out _))
                        PickUpPiece(cx, cy);   // existing piece always takes priority
                    else if (_selType.HasValue)
                        PlacePiece(cx, cy);
                }
                else if (_holding)
                {
                    // Clicked outside the grid while holding a piece → discard it
                    // (Start/Exit can't be deleted, so they return to their origin instead)
                    AbandonHolding();
                }
                GetViewport().SetInputAsHandled();
            }
            else if (mb.ButtonIndex == MouseButton.WheelUp)
            {
                _camDist = Mathf.Max(_camDist - 10f, 30f);
                GetViewport().SetInputAsHandled();
            }
            else if (mb.ButtonIndex == MouseButton.WheelDown)
            {
                _camDist = Mathf.Min(_camDist + 10f, 400f);
                GetViewport().SetInputAsHandled();
            }
            else if (mb.ButtonIndex == MouseButton.Middle)
            {
                _mmb = mb.Pressed;
                GetViewport().SetInputAsHandled();
            }
        }
        else if (ev is InputEventMouseMotion mm)
        {
            if (_rmb)
            {
                // 10-pixel threshold (was 4) — small mouse jitter no longer eats the click,
                // so a quick right-click reliably triggers delete / abandon-hold instead of
                // being misread as a tiny orbit drag.
                if ((mm.Position - _rmbStart).Length() > 10f) _rmbDrag = true;
                if (_rmbDrag)
                {
                    _camYaw   -= mm.Relative.X * 0.005f;
                    _camPitch += mm.Relative.Y * 0.005f;
                    _camPitch  = Mathf.Clamp(_camPitch, 0.05f, 1.55f);
                }
                GetViewport().SetInputAsHandled();
            }
            else if (_mmb)
            {
                // Middle-mouse drag pans the camera target along the screen's right/up
                // axes (in world space). Speed scales with distance so the same screen-
                // pixel delta moves the same on-screen amount whether zoomed in or out.
                float cp = Mathf.Cos(_camPitch), sp = Mathf.Sin(_camPitch);
                float cy = Mathf.Cos(_camYaw),   sy = Mathf.Sin(_camYaw);
                Vector3 fwd = new Vector3(-sy * cp, -sp, -cy * cp).Normalized();
                Vector3 worldUp = _camPitch > 1.50f ? new Vector3(0, 0, -1) : Vector3.Up;
                Vector3 right   = fwd.Cross(worldUp).Normalized();
                Vector3 upPlane = right.Cross(fwd).Normalized();

                // Pixels-to-world factor at the target distance: 2*tan(FOV/2)/viewportHeight.
                float vpH   = Mathf.Max(GetViewport().GetVisibleRect().Size.Y, 1f);
                float scale = 2f * Mathf.Tan(_cam.Fov * Mathf.Pi / 360f) * _camDist / vpH;
                Vector3 delta = (-mm.Relative.X * right + mm.Relative.Y * upPlane) * scale;

                _camPan += new Vector3(delta.X, 0f, delta.Z);   // keep Y locked to the floor

                // Clamp pan so the user can't lose the maze in the void.
                float maxX = GW * CS * 1.5f, maxZ = GH * CS * 1.5f;
                _camPan = new Vector3(
                    Mathf.Clamp(_camPan.X, -maxX, maxX),
                    0f,
                    Mathf.Clamp(_camPan.Z, -maxZ, maxZ));

                GetViewport().SetInputAsHandled();
            }
            else
            {
                if (TryGetCell(mm.Position, out int hcx, out int hcy))
                    SetHover(hcx, hcy);
                else
                    SetHover(-1, -1);
            }
        }
    }

    bool TryGetCell(Vector2 evPos, out int cx, out int cy)
    {
        cx = cy = -1;
        var vpSize = new Vector2(_mainVp.Size.X, _mainVp.Size.Y);
        var contSz = _vpCont.Size;
        if (contSz.X <= 0 || contSz.Y <= 0) return false;

        var vpPos = evPos / contSz * vpSize;
        var origin = _cam.ProjectRayOrigin(vpPos);
        var dir    = _cam.ProjectRayNormal(vpPos);

        float planeY = _floor * EdFH;
        if (Mathf.Abs(dir.Y) < 0.001f) return false;
        float t = (planeY - origin.Y) / dir.Y;
        if (t < 0f) return false;

        var hit = origin + dir * t;
        cx = (int)Mathf.Floor(hit.X / CS);
        cy = (int)Mathf.Floor(hit.Z / CS);
        return cx >= 0 && cx < GW && cy >= 0 && cy < GH;
    }

    // ── Hover highlight ────────────────────────────────────────────────────────
    void SetHover(int cx, int cy)
    {
        // Start/Exit are locked to their row regardless of where the cursor is, so the user
        // can never move them off-row even visually.
        if (cx >= 0 && _holding)
        {
            if (_heldType == PieceType.Start) cy = StartRow;
            else if (_heldType == PieceType.Exit) cy = ExitRow;
        }

        if (cx == _hoverCx && cy == _hoverCy) return;
        _hoverCx = cx;
        _hoverCy = cy;
        UpdateHoverHighlight();

        // Re-snap the held ghost's rotation to the new cell's neighbors so the user
        // sees the orientation they'll actually get on click.
        if (_holding && _heldGeo != null)
        {
            if (cx >= 0)
            {
                int snapped = PieceDB.IsStair(_heldType)
                    ? InferStairRotation(_heldType, cx, cy, _floor, fallback: _heldRot)
                    : InferRotation(_heldType,      cx, cy, _floor, fallback: _heldRot);
                if (snapped != _heldRot)
                {
                    _heldRot = snapped;
                    RebuildHeldGeo();
                }
                _heldGeo.Visible  = true;
                _heldGeo.Position = new Vector3(cx * CS, _floor * EdFH, cy * CS);
            }
            else
            {
                _heldGeo.Visible = false;
            }
        }

        // Same idea for the palette preview ghost.
        if (_previewGeo != null && _selType.HasValue)
        {
            if (cx >= 0)
            {
                int snapped = PieceDB.IsStair(_selType.Value)
                    ? InferStairRotation(_selType.Value, cx, cy, _floor, fallback: _rotation)
                    : InferRotation(_selType.Value,      cx, cy, _floor, fallback: _rotation);
                if (snapped != _rotation)
                {
                    _rotation = snapped;
                    RebuildPreviewGeo();
                }
                _previewGeo.Visible  = true;
                _previewGeo.Position = new Vector3(cx * CS, _floor * EdFH, cy * CS);
            }
            else
            {
                _previewGeo.Visible = false;
            }
        }
    }

    // Rebuilds the held-piece ghost in place at the current hover position.
    void RebuildHeldGeo()
    {
        if (!_holding) return;
        _heldGeo?.QueueFree();
        _heldGeo = new Node3D();
        _world.AddChild(_heldGeo);
        BuildPieceInto(_heldGeo, _heldType, _heldRot, 0f, 0f, 0f, isActive: true);
        YellowTint(_heldGeo);
        if (_hoverCx >= 0)
            _heldGeo.Position = new Vector3(_hoverCx * CS, _floor * EdFH, _hoverCy * CS);
    }

    void UpdateHoverHighlight()
    {
        foreach (var mi in _hoverBorder) { if (IsInstanceValid(mi)) mi.QueueFree(); }
        _hoverBorder.Clear();

        if (_hoverCx < 0 || _hoverCy < 0) return;
        if (!_holding && !_selType.HasValue) return;

        // Determine if this hover cell is a valid target. Start/Exit are already clamped
        // to their row by SetHover, so the off-row case never appears here — what's left is
        // "no rotation of this piece would be a legal placement at the hovered cell."
        PieceType? activeType = _holding ? _heldType : _selType;
        bool invalid = false;
        if (activeType.HasValue)
        {
            bool anyValid = false;
            for (int r = 0; r < 4; r++)
            {
                if (IsValidPlacement(_hoverCx, _hoverCy, activeType.Value, r, silent: true))
                {
                    anyValid = true;
                    break;
                }
            }
            invalid = !anyValid;
        }

        float y  = _floor * EdFH + FlrT + 0.1f;
        float x0 = _hoverCx * CS;
        float z0 = _hoverCy * CS;
        const float bW = 0.28f, bH = 0.1f;

        // Strong, glowing cyan-blue when valid — stands out against the softer blue
        // grid lines so the hovered cell pops. Red for invalid placement.
        var hoverColor = invalid
            ? new Color(0.95f, 0.18f, 0.18f, 0.98f)
            : new Color(0.55f, 0.85f, 1.0f,  1.0f);

        var mat = new StandardMaterial3D
        {
            AlbedoColor                = hoverColor,
            ShadingMode                = BaseMaterial3D.ShadingModeEnum.Unshaded,
            EmissionEnabled            = !invalid,
            Emission                   = new Color(0.30f, 0.65f, 1.0f),
            EmissionEnergyMultiplier   = 1.8f,
        };
        void Bar(Vector3 pos, Vector3 sz)
        {
            var mi = new MeshInstance3D { Mesh = new BoxMesh { Size = sz }, MaterialOverride = mat, Position = pos };
            _world.AddChild(mi);
            _hoverBorder.Add(mi);
        }
        // 4 bars forming a cell border (corners overlap intentionally)
        Bar(new Vector3(x0 + CS * 0.5f, y, z0      ), new Vector3(CS, bH, bW));
        Bar(new Vector3(x0 + CS * 0.5f, y, z0 + CS ), new Vector3(CS, bH, bW));
        Bar(new Vector3(x0,             y, z0 + CS * 0.5f), new Vector3(bW, bH, CS));
        Bar(new Vector3(x0 + CS,        y, z0 + CS * 0.5f), new Vector3(bW, bH, CS));

        // Pending room rectangle — outlines every cell between the anchor and the cursor.
        if (_selType == PieceType.Room && _roomAnchor != null)
        {
            var (ax, ay) = _roomAnchor.Value;
            int rx0 = Mathf.Min(ax, _hoverCx), rx1 = Mathf.Max(ax, _hoverCx);
            int ry0 = Mathf.Min(ay, _hoverCy), ry1 = Mathf.Max(ay, _hoverCy);

            var rectMat = new StandardMaterial3D
            {
                AlbedoColor              = new Color(0.45f, 0.95f, 0.65f, 0.95f),
                ShadingMode              = BaseMaterial3D.ShadingModeEnum.Unshaded,
                EmissionEnabled          = true,
                Emission                 = new Color(0.30f, 0.85f, 0.50f),
                EmissionEnergyMultiplier = 1.5f,
            };

            for (int rx = rx0; rx <= rx1; rx++)
            {
                for (int ry = ry0; ry <= ry1; ry++)
                {
                    float rxw = rx * CS, rzw = ry * CS;
                    void RBar(Vector3 pos, Vector3 sz)
                    {
                        var mi = new MeshInstance3D
                        {
                            Mesh = new BoxMesh { Size = sz },
                            MaterialOverride = rectMat,
                            Position = pos,
                        };
                        _world.AddChild(mi);
                        _hoverBorder.Add(mi);
                    }
                    RBar(new Vector3(rxw + CS * 0.5f, y, rzw),           new Vector3(CS, bH, bW));
                    RBar(new Vector3(rxw + CS * 0.5f, y, rzw + CS),      new Vector3(CS, bH, bW));
                    RBar(new Vector3(rxw,             y, rzw + CS*0.5f), new Vector3(bW, bH, CS));
                    RBar(new Vector3(rxw + CS,        y, rzw + CS*0.5f), new Vector3(bW, bH, CS));
                }
            }
        }
    }

    // ── Pick-up / move ─────────────────────────────────────────────────────────
    void PickUpPiece(int cx, int cy)
    {
        // Cross-floor-aware lookup — picking up a stair whose landing sits on the active
        // floor uses the stair's ACTUAL home floor as the origin (preserved in
        // _heldOFloor so a CancelHolding restores it correctly), and RemovePiece below
        // deletes the right (X, Y, F) record. If the user then drops on the active
        // floor, the new piece's home becomes _floor — effectively re-anchoring the
        // stair to the floor they're editing from.
        if (!TryGetActiveFloorPiece(cx, cy, out var p)) return;

        _heldType   = p.Type;
        _heldRot    = p.Rotation;
        _heldOX     = p.X;
        _heldOY     = p.Y;
        _heldOFloor = p.Floor;
        _heldLinkId = p.LinkId;

        RemovePiece(cx, cy);

        // Yellow ghost at the same cell; parent node moves with mouse
        _heldGeo = new Node3D();
        _world.AddChild(_heldGeo);
        BuildPieceInto(_heldGeo, _heldType, _heldRot, 0f, 0f, 0f, isActive: true);
        YellowTint(_heldGeo);
        _heldGeo.Position = new Vector3(cx * CS, _floor * EdFH, cy * CS);

        _holding = true;
        _selType = null;
        RefreshPalette();
        RebuildPreviewGeo();   // clears palette preview while holding
        RebuildGeometry();     // also refreshes stair shadows after removal
        RebuildBorderHints();
        _clickSfx?.Play();
        SetStatus($"Moving {PieceDB.Labels[_heldType]}  —  R to rotate  |  click to place  |  Esc to cancel");
    }

    void DropPiece(int cx, int cy)
    {
        if (!_holding) return;

        // Clamp Start/Exit to their valid row — clicking anywhere on the grid drops them
        // somewhere on their dedicated row (matching what the user sees via the held ghost).
        if (_heldType == PieceType.Start) cy = StartRow;
        else if (_heldType == PieceType.Exit) cy = ExitRow;

        // Auto-orient on drop, same as palette placement
        int useRot = PieceDB.IsStair(_heldType)
            ? InferStairRotation(_heldType, cx, cy, _floor, fallback: _heldRot)
            : InferRotation(_heldType,      cx, cy, _floor, fallback: _heldRot);

        if (!IsValidPlacement(cx, cy, _heldType, useRot)) return;

        _heldGeo?.QueueFree();
        _heldGeo = null;

        RemovePiece(cx, cy);   // clear any existing piece at destination

        var piece = new MazePiece { X = cx, Y = cy, Floor = _floor,
                                    Type = _heldType, Rotation = useRot, LinkId = _heldLinkId };
        _maze.Pieces.Add(piece);
        _heldRot = useRot;   // remember the snapped rotation in case user picks it up again

        var key = new CK(cx, cy, _floor);
        var geo = new Node3D();
        _world.AddChild(geo);
        BuildPieceInto(geo, _heldType, useRot, cx * CS, _floor * EdFH, cy * CS, isActive: true);
        _cellGeo[key] = geo;

        _holding = false;
        RebuildGeometry();   // also refreshes stair shadows
        RebuildBorderHints();
        UpdateHoverHighlight();
        _clickSfx?.Play();
        SetStatus($"Placed {PieceDB.Labels[_heldType]}");
    }

    void CancelHolding()
    {
        if (!_holding) return;

        _heldGeo?.QueueFree();
        _heldGeo = null;

        // Restore to original position
        var piece = new MazePiece { X = _heldOX, Y = _heldOY, Floor = _heldOFloor,
                                    Type = _heldType, Rotation = _heldRot, LinkId = _heldLinkId };
        _maze.Pieces.Add(piece);

        var key = new CK(_heldOX, _heldOY, _heldOFloor);
        var geo = new Node3D();
        _world.AddChild(geo);
        BuildPieceInto(geo, _heldType, _heldRot,
                       _heldOX * CS, _heldOFloor * EdFH, _heldOY * CS,
                       isActive: _heldOFloor == _floor);
        _cellGeo[key] = geo;

        _holding = false;
        RebuildGeometry();   // also refreshes stair shadows
        RebuildBorderHints();
        UpdateHoverHighlight();
        SetStatus();
    }

    static void YellowTint(Node3D node)
    {
        foreach (var child in node.GetChildren())
        {
            if (child is MeshInstance3D mi && mi.MaterialOverride is StandardMaterial3D mat)
                mat.AlbedoColor = new Color(CSel.R, CSel.G, CSel.B, mat.AlbedoColor.A * 0.75f);
            if (child is Node3D n) YellowTint(n);
        }
    }

    // ── Place / remove ─────────────────────────────────────────────────────────
    void PlacePiece(int cx, int cy)
    {
        if (!_selType.HasValue) return;
        var pt = _selType.Value;

        if (pt == PieceType.StairsUp   && _floor >= FlMax) { SetStatus("Can't place: top floor.");    return; }
        if (pt == PieceType.StairsDown && _floor <= FlMin) { SetStatus("Can't place: bottom floor."); return; }
        // A trapdoor drops the player exactly one floor down (TrapBehaviours.
        // AddTrapdoor just hides/disables this cell's floor; gravity does the
        // rest) — at the bottom floor there is nothing below to land on.
        if (pt == PieceType.TrapDoor   && _floor <= FlMin) { SetStatus("Can't place: bottom floor."); return; }

        // Auto-rotate: snap rotation to connect with neighbors / stair landings
        int useRot = PieceDB.IsStair(pt)
            ? InferStairRotation(pt, cx, cy, _floor, fallback: _rotation)
            : InferRotation(pt, cx, cy, _floor, fallback: _rotation);

        if (!IsValidPlacement(cx, cy, pt, useRot)) return;

        RemovePiece(cx, cy);   // clear existing

        var piece = new MazePiece { X = cx, Y = cy, Floor = _floor, Type = pt, Rotation = useRot };
        _maze.Pieces.Add(piece);

        if (pt == PieceType.TrapPortal)
        {
            if (_pendingLinkId == 0)
            {
                // Open a new pair — this pad is inert until its partner is placed.
                piece.LinkId   = _nextLinkId;
                _pendingLinkId = _nextLinkId;
                _nextLinkId++;
                SetStatus($"Teleport pad A placed (pair {piece.LinkId}) — place its partner.");
            }
            else
            {
                piece.LinkId   = _pendingLinkId;
                SetStatus($"Teleport pair {piece.LinkId} linked.");
                _pendingLinkId = 0;
            }
        }

        var key = new CK(cx, cy, _floor);
        var geo = new Node3D();
        _world.AddChild(geo);
        BuildPieceInto(geo, pt, useRot, cx * CS, _floor * EdFH, cy * CS, isActive: true);
        _cellGeo[key] = geo;

        RebuildGeometry();   // refresh stair-shadow rendering
        _clickSfx?.Play();
        // Teleport pads already set their own pairing-specific status above
        // ("pad A placed (pair N)" / "pair N linked") — don't clobber it with
        // the generic message.
        if (pt != PieceType.TrapPortal)
            SetStatus($"Placed {PieceDB.Labels[pt]}");
    }

    void RemovePiece(int cx, int cy)
    {
        // Use the cross-floor-aware lookup so right-click also reaches stair pieces
        // whose home floor is _floor±1 but whose landing sits on the active floor.
        // (Stair geometry visually occupies the active floor's cell, so the user
        // expects "right-click that thing → it's gone.")
        if (!TryGetActiveFloorPiece(cx, cy, out var target)) return;
        var key = new CK(target.X, target.Y, target.Floor);
        _maze.Pieces.RemoveAll(p => p.X == target.X && p.Y == target.Y && p.Floor == target.Floor);
        if (_cellGeo.TryGetValue(key, out var geo))
        {
            geo.QueueFree();
            _cellGeo.Remove(key);
        }
    }

    // ── Room painting ─────────────────────────────────────────────────────────
    // Click one cell, then a second: every cell in the rectangle between them
    // becomes an independent Room tile. Painting over an existing piece replaces
    // it. Cells that already hold a Room are left alone, so overlapping drags
    // extend a room instead of churning it.
    void PaintRoomRect(int ax, int ay, int bx, int by)
    {
        int painted = 0;
        int blockedByPit = 0;
        int blockedByStair = 0;
        foreach (var (x, y) in RoomRectCells(ax, ay, bx, by))
        {
            if (RoomPaintSkipsCell(x, y, out bool blockedByMultiCell, out bool blockedStair))
            {
                if (blockedByMultiCell) blockedByPit++;
                if (blockedStair) blockedByStair++;
                continue;
            }

            RemovePiece(x, y);

            _maze.Pieces.Add(new MazePiece
            {
                X = x, Y = y, Floor = _floor, Type = PieceType.Room, Rotation = 0,
            });
            painted++;
        }

        int x0 = Mathf.Min(ax, bx), x1 = Mathf.Max(ax, bx);
        int y0 = Mathf.Min(ay, by), y1 = Mathf.Max(ay, by);
        RebuildGeometry();
        RebuildBorderHints();
        _clickSfx?.Play();

        string sizeLabel = $"{(x1 - x0 + 1)}x{(y1 - y0 + 1)}";

        // Same style/shape as the original Pit-only message, extended to report
        // both reasons a cell might have been skipped (see I2).
        var reasons = new List<string>();
        if (blockedByPit > 0)
            reasons.Add($"{blockedByPit} cell(s) occupied by a Pit; right-click it to remove first");
        if (blockedByStair > 0)
            reasons.Add($"{blockedByStair} cell(s) occupied by a Stair; right-click it to remove first");
        string reasonText = reasons.Count > 0 ? $"  ({string.Join("; ", reasons)})" : "";

        if (painted > 0 && reasons.Count > 0)
            SetStatus($"Painted {painted} room tile(s)  —  {sizeLabel}{reasonText}");
        else if (painted > 0)
            SetStatus($"Painted {painted} room tile(s)  —  {sizeLabel}");
        else if (reasons.Count > 0)
            SetStatus($"No room tiles painted —{reasonText}");
        else
            SetStatus("No new room tiles — that area is already open.");
    }

    /// Per-cell decision backing PaintRoomRect: whether to leave this cell alone
    /// rather than paint a Room tile over it, and — via `blockedByMultiCell` /
    /// `blockedByStair` — whether that's specifically because doing so would
    /// require silently destroying an existing multi-cell piece (currently just
    /// Pit) or a stair (RemovePiece deletes such a piece's ENTIRE record —
    /// every cell and floor it spans for a Pit, or the whole stair piece for a
    /// stair — not just the one cell clicked). Start/Exit are refused for the
    /// same "don't silently destroy" reason but were already refused before this
    /// method existed, so they are not flagged via either out-param — only the
    /// Pit and Stair cases are surfaced in PaintRoomRect's status message.
    ///
    /// Resolution is cross-floor-aware (TryGetActiveFloorPiece), matching
    /// RemovePiece exactly — this method exists specifically to warn about
    /// what RemovePiece is about to do, so it has to see what RemovePiece sees.
    /// Using the same-floor-only TryGetPlacedPieceOnFloor here was I2: a room
    /// rectangle painted over a stair's landing cell (a StairsUp at _floor-1 or
    /// a StairsDown at _floor+1) silently deleted the stair with no warning and
    /// no undo, because this method never even looked at _floor±1.
    ///
    /// Extracted as its own `internal` method — rather than inlined in
    /// PaintRoomRect — so test/TestRoomPitLogic.cs can exercise this decision
    /// headlessly. PaintRoomRect itself cannot be called from the test harness:
    /// it calls RebuildGeometry(), which touches _world (the SubViewport's World
    /// node), and _world is only initialized by SetupMainVp() during a running
    /// _Ready() — null on an instance built directly by a headless test.
    internal bool RoomPaintSkipsCell(int x, int y, out bool blockedByMultiCell, out bool blockedByStair)
    {
        blockedByMultiCell = false;
        blockedByStair = false;

        if (!TryGetActiveFloorPiece(x, y, out var existing))
            return false;

        // Already a Room here on this floor — nothing to do.
        if (existing.Type == PieceType.Room)
            return true;

        // Never paint over Start or Exit; they are unique and row-locked.
        if (existing.Type == PieceType.Start || existing.Type == PieceType.Exit)
            return true;

        // Never silently destroy a multi-cell piece (currently just Pit) by
        // clipping even one corner of its footprint with a room rectangle —
        // RemovePiece deletes that piece's WHOLE record (every cell, every
        // floor it spans), not just this one cell. Same "refuse, don't
        // destroy" precedent as Start/Exit above. Deleting a pit on purpose is
        // still possible the normal way: right-click any of its cells.
        if (PieceDB.IsMultiCell(existing.Type))
        {
            blockedByMultiCell = true;
            return true;
        }

        // Never silently delete a stair either. A stair only shows up here via
        // the cross-floor-aware TryGetActiveFloorPiece resolution above (its
        // home cell may be on _floor±1) — exactly why the old same-floor-only
        // lookup missed this case; see I2 above.
        if (PieceDB.IsStair(existing.Type))
        {
            blockedByStair = true;
            return true;
        }

        return false;
    }

    /// Pure rectangle-fill math backing PaintRoomRect: every in-grid cell between
    /// two opposite corners, order-independent (either corner may be clicked first).
    /// Kept separate from the paint side effects (RemovePiece/RebuildGeometry/status)
    /// so it's testable without spinning up the editor's Node tree — see
    /// test/TestRoomPitLogic.cs. `internal` (not `public`) since the only outside
    /// caller is that same-assembly headless test harness.
    internal static IEnumerable<(int x, int y)> RoomRectCells(int ax, int ay, int bx, int by)
    {
        int x0 = Mathf.Min(ax, bx), x1 = Mathf.Max(ax, bx);
        int y0 = Mathf.Min(ay, by), y1 = Mathf.Max(ay, by);
        for (int x = x0; x <= x1; x++)
            for (int y = y0; y <= y1; y++)
                if (x >= 0 && x < GW && y >= 0 && y < GH)
                    yield return (x, y);
    }

    /// Cancels a half-finished room drag.
    void CancelRoomPaint()
    {
        if (_roomAnchor == null) return;
        _roomAnchor = null;
        UpdateHoverHighlight();
        SetStatus("Room corner cleared.");
    }

    // Generic "you let go of the piece" — Start/Exit can't be deleted, so they snap back
    // to their original cell; every other type is discarded.
    // Right-click / void-click / D while holding always discards the held piece, including
    // Start and Exit. If a critical piece gets discarded, EnsureStartExit() re-spawns it at
    // the default cell on the next Save/Load/Clear, so the maze auto-recovers.
    // Escape still calls CancelHolding() directly for the "I changed my mind" gesture.
    void AbandonHolding()
    {
        if (!_holding) return;
        DiscardHolding();
    }

    void DiscardHolding()
    {
        if (!_holding) return;
        _heldGeo?.QueueFree();
        _heldGeo = null;
        _holding = false;
        RebuildGeometry();   // also refreshes stair shadows
        RebuildBorderHints();
        UpdateHoverHighlight();
        SetStatus($"Discarded {PieceDB.Labels[_heldType]}");
    }

    // ── Floor navigation ───────────────────────────────────────────────────────
    void FloorUp()
    {
        if (_floor >= FlMax) return;
        _floor++;
        OnFloorChanged();
    }

    void FloorDown()
    {
        if (_floor <= FlMin) return;
        _floor--;
        OnFloorChanged();
    }

    void OnFloorChanged()
    {
        // A pending room-corner click doesn't survive a floor change — otherwise
        // the next click completes PaintRoomRect on the NEW _floor using the OLD
        // click's coordinates, painting a rectangle the user never saw previewed
        // here. CancelRoomPaint() is a no-op when no anchor is pending, and also
        // refreshes the on-screen rectangle preview so a cancelled drag stops
        // drawing immediately instead of lingering until the next mouse move.
        CancelRoomPaint();

        _floorLbl.Text = $"Floor {_floor}";
        RefreshGridOpacity();
        RebuildGeometry();
        // Border hints are floor-aware (Exit can land on any floor — see RebuildBorderHints)
        // so they must be redrawn whenever the visible floor set changes.
        RebuildBorderHints();
        // Held ghost follows the floor change — same cell, new Y level
        if (_holding && _heldGeo != null && _hoverCx >= 0)
            _heldGeo.Position = new Vector3(_hoverCx * CS, _floor * EdFH, _hoverCy * CS);
    }

    // ── Piece type selection ───────────────────────────────────────────────────
    void SelectType(PieceType pt)
    {
        // Picking from the palette while holding a piece discards it (Start/Exit return to origin)
        if (_holding) AbandonHolding();
        // Switching tools mid-drag would otherwise leave a stale anchor that silently
        // completes a paint against a rectangle the user never saw previewed.
        _roomAnchor = null;

        _selType = pt;
        _selCat  = PieceDB.CategoryOf(pt);   // follow the piece to its tab
        RefreshPalette();
        RebuildBorderHints();
        RebuildPreviewGeo();
        SetStatus($"{PieceDB.Labels[pt]}  [{PieceDB.GoldCosts[pt]}g]");
        // Camera stays where it is — user can right-click orbit freely.
    }

    void RotateOnce()
    {
        if (_holding)
        {
            _heldRot = (_heldRot + 1) % 4;
            _heldGeo?.QueueFree();
            _heldGeo = new Node3D();
            _world.AddChild(_heldGeo);
            BuildPieceInto(_heldGeo, _heldType, _heldRot, 0f, 0f, 0f, isActive: true);
            YellowTint(_heldGeo);
            if (_hoverCx >= 0)
                _heldGeo.Position = new Vector3(_hoverCx * CS, _floor * EdFH, _hoverCy * CS);
            SetStatus($"Moving {PieceDB.Labels[_heldType]}  rot {_heldRot * 90}°  —  click to place  |  Esc to cancel");
        }
        else
        {
            _rotation = (_rotation + 1) % 4;
            RebuildPreviewGeo();
            SetStatus(_selType.HasValue
                ? $"{PieceDB.Labels[_selType.Value]}  rot {_rotation * 90}°"
                : $"Rotation: {_rotation * 90}°");
        }
    }

    void SelectCategory(PieceCategory cat)
    {
        _selCat = cat;
        RefreshPalette();
        _clickSfx?.Play();
    }

    void RefreshPalette()
    {
        foreach (var (pt, panel) in _palPan)
        {
            // Cells outside the active tab are hidden, not destroyed — their
            // thumbnail SubViewports stay alive and keep rendering.
            panel.Visible = PieceDB.CategoryOf(pt) == _selCat;

            bool sel = _selType == pt;
            // Selected: subtle warm tint; unselected: fully transparent (floating look)
            panel.AddThemeStyleboxOverride("panel",
                Flat(sel ? new Color(0.20f, 0.17f, 0.03f, 0.75f) : new Color(0, 0, 0, 0)));
        }

        foreach (var (cat, btn) in _catBtn)
        {
            bool active = cat == _selCat;
            btn.AddThemeColorOverride("font_color",
                active ? new Color(1f, 0.86f, 0.35f) : new Color(0.55f, 0.55f, 0.55f));
            btn.AddThemeStyleboxOverride("normal",
                Flat(active ? new Color(0.16f, 0.13f, 0.03f, 0.9f) : new Color(0, 0, 0, 0),
                     active ? new Color(0.85f, 0.70f, 0.25f, 0.8f) : new Color(0.35f, 0.35f, 0.35f, 0.5f)));
            btn.AddThemeStyleboxOverride("hover",
                Flat(new Color(0.22f, 0.19f, 0.06f, 0.9f), new Color(0.85f, 0.70f, 0.25f, 0.8f)));
            btn.AddThemeStyleboxOverride("pressed",
                Flat(new Color(0.26f, 0.22f, 0.07f, 0.95f), new Color(1f, 0.86f, 0.35f, 0.9f)));
        }
    }

    // ── Clear ──────────────────────────────────────────────────────────────────
    // Shows a Yes/No confirmation dialog before wiping the current slot —
    // clearing is destructive (loses every piece on every floor) so a single
    // misclick shouldn't trash the user's maze.
    void ConfirmClearMap()
    {
        var dialog = new ConfirmationDialog
        {
            Title         = "Clear Map",
            DialogText    = "Clear every piece in this maze?\nThis cannot be undone.",
            OkButtonText  = "Yes",
            CancelButtonText = "No",
        };
        if (_font != null)
        {
            dialog.AddThemeFontOverride("font", _font);
            dialog.AddThemeFontSizeOverride("font_size", 16);
        }
        AddChild(dialog);
        dialog.Confirmed   += () => { ClearCurrentMap(); dialog.QueueFree(); };
        dialog.Canceled    += () => dialog.QueueFree();
        dialog.CloseRequested += () => dialog.QueueFree();
        dialog.PopupCentered(new Vector2I(360, 160));
    }

    void ClearCurrentMap()
    {
        // A pending room-corner click must not survive a Clear Map — otherwise
        // the very next click completes PaintRoomRect from a pre-clear anchor,
        // laying room tiles immediately after the user asked to clear everything.
        CancelRoomPaint();

        _maze.Pieces.Clear();
        EnsureStartExit();
        RebuildGeometry();
        SetStatus("Map cleared.");
    }

    // ── Save / load ────────────────────────────────────────────────────────────
    public void SaveCurrentSlot()
    {
        if (_nameEdit != null && _nameEdit.Text.Length > 0)
            _maze.Name = _nameEdit.Text;
        _maze.IsOnline    = true;
        _maze.IsGameReady = MazeValidator.IsGameReady(_maze, out string readyErr);
        MazeSerializer.Save(_slot, _maze);
        RefreshSlotButtons();
        SetStatus(_maze.IsGameReady
            ? "Saved — maze is game-ready."
            : $"Saved — not game-ready: {readyErr}");

        // Red pulse only fires now on save-failures (not during normal placement).
        // It points at the first piece that's unreachable from Start so the user
        // can see exactly where the path breaks.
        if (!_maze.IsGameReady)
        {
            var broken = FindUnreachableProblemPiece();
            if (broken != null) FlagErrorCell(broken.X, broken.Y, broken.Floor);
        }
    }

    // Returns the first piece that BFS from Start cannot reach. Prefers the Exit when
    // it's unreachable (most obvious "missing path"), then picks any other orphan piece.
    // Returns null if everything is fine.
    MazePiece? FindUnreachableProblemPiece()
    {
        var start = _maze.Pieces.FirstOrDefault(p => p.Type == PieceType.Start);
        if (start == null) return _maze.Pieces.FirstOrDefault(p => p.Type == PieceType.Exit)
                                ?? _maze.Pieces.FirstOrDefault();

        var visited = new System.Collections.Generic.HashSet<(int, int, int)>
            { (start.X, start.Y, start.Floor) };
        var queue   = new System.Collections.Generic.Queue<MazePiece>();
        queue.Enqueue(start);

        var lookup = _maze.Pieces.ToDictionary(p => (p.X, p.Y, p.Floor));
        Dir[]       all  = { Dir.N, Dir.E, Dir.S, Dir.W };
        (int,int)[] dlt  = { (0,-1), (1,0), (0,1), (-1,0) };
        Dir[]       opp  = { Dir.S, Dir.W, Dir.N, Dir.E };

        while (queue.Count > 0)
        {
            var p   = queue.Dequeue();
            Dir op  = PieceDB.GetOpenings(p.Type, p.Rotation);
            for (int i = 0; i < 4; i++)
            {
                if ((op & all[i]) == 0) continue;
                int nFloor = p.Floor;
                if (PieceDB.IsStair(p.Type) &&
                    all[i] == PieceDB.GetStairCrossDir(p.Type, p.Rotation))
                    nFloor = p.Floor + PieceDB.StairFloorDelta(p.Type);
                var key = (p.X + dlt[i].Item1, p.Y + dlt[i].Item2, nFloor);
                if (visited.Contains(key)) continue;
                if (!lookup.TryGetValue(key, out var nb)) continue;
                if (PieceDB.IsStair(nb.Type) &&
                    opp[i] == PieceDB.GetStairCrossDir(nb.Type, nb.Rotation)) continue;
                if ((PieceDB.GetOpenings(nb.Type, nb.Rotation) & opp[i]) == 0) continue;
                visited.Add(key);
                queue.Enqueue(nb);
            }
        }

        // Exit first — that's almost always the user-visible problem when a save fails.
        var exit = _maze.Pieces.FirstOrDefault(p => p.Type == PieceType.Exit);
        if (exit != null && !visited.Contains((exit.X, exit.Y, exit.Floor))) return exit;
        return _maze.Pieces.FirstOrDefault(p => !visited.Contains((p.X, p.Y, p.Floor)));
    }

    void LoadSlot(int s)
    {
        // Loading replaces _maze wholesale with a different maze's data — a
        // pending room-corner click from the maze being left behind is stale by
        // definition (its coordinates mean nothing on the newly-loaded layout)
        // and must not survive to complete a paint against it on the next click.
        CancelRoomPaint();

        _slot = s;
        var data = MazeSerializer.Load(s);
        _maze = data ?? new MazeData { Name = $"Maze {s + 1}", Pieces = new() };

        // Continue numbering above whatever the loaded maze already uses.
        _nextLinkId    = 1;
        _pendingLinkId = 0;
        foreach (var lp in _maze.Pieces)
            if (lp.LinkId >= _nextLinkId) _nextLinkId = lp.LinkId + 1;

        if (_nameEdit != null) _nameEdit.Text = _maze.Name;
        EnsureStartExit();
        RebuildGeometry();
        RefreshSlotButtons();
        SetStatus("Slot loaded.");
    }

    void RefreshSlotButtons()
    {
        for (int i = 0; i < MaxSlots; i++)
        {
            var  data    = MazeSerializer.Load(i);
            string name  = data?.Name ?? "(empty)";
            int pieces   = data?.Pieces?.Count ?? 0;
            // A saved-but-broken maze (has pieces yet isn't game-ready) gets a red [!] prefix
            // and red text. The slot can still be clicked to load and fix, but it's flagged
            // as unusable until the path between Start and Exit is restored — PlayGameScreen
            // already filters out non-ready slots from the matchmaking dropdown.
            bool notReady = data != null && pieces > 0 && !data.IsGameReady;
            string prefix = notReady ? "[!] " : "  ";
            _slotBtns[i].Text = $"{prefix}{i + 1}.  {name}  [{pieces}p]";

            bool isCur = i == _slot;
            _slotBtns[i].AddThemeStyleboxOverride("normal",
                Flat(isCur ? new Color(0.20f, 0.16f, 0.04f, 0.80f)
                           : new Color(0.04f, 0.04f, 0.04f, 0.55f)));
            _slotBtns[i].AddThemeColorOverride("font_color",
                notReady ? new Color(1f, 0.30f, 0.30f)
                : isCur  ? new Color(1f, 0.92f, 0.55f)
                         : Colors.White);
        }
    }

    // ── Enter dungeon ──────────────────────────────────────────────────────────
    void OnEnterDungeon()
    {
        // Must be a full game-ready maze (Start, Exit, and a valid path between them) before
        // we let the user test it. Same gate as Save/PlayGameScreen filtering.
        if (!MazeValidator.IsGameReady(_maze, out string err))
        {
            SetStatus($"Can't enter — {err}");
            return;
        }
        SaveCurrentSlot();
        // Play-test always goes through the dual-maze arena scene so the exit dumps the
        // player into the central arena (matching the online match layout). Both maze
        // slots are set to the maze being edited — the second copy is a mirror on the
        // far side of the arena, which the player can ignore or wander into.
        GameState.ActiveSlot        = _slot;
        GameState.IsArenaMode       = true;
        GameState.ArenaSlotA        = _slot;
        GameState.ArenaSlotB        = _slot;
        GameState.EditorReturnScene = "res://scenes/MazeEditor3D.tscn";
        DungeonArena.ChosenSpawn    = DungeonArena.SpawnPoint.MazeA;
        GetTree().ChangeSceneToFile("res://scenes/DungeonArena.tscn");
    }

    void SetStatus(string msg = "")
    {
        if (_statusLbl == null) return;
        _statusLbl.Text = msg.Length > 0 ? msg
            : _selType.HasValue ? $"{PieceDB.Labels[_selType.Value]}  {_rotation * 90}°"
            : "Select a piece →";
    }

