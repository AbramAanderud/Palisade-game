using Godot;
using System.Collections.Generic;

/// res://scripts/ManorFurniture.cs
/// Task 7 (Polish): procedural builders for manor-style corridor decor —
/// a collidable bookshelf bay (no GLB asset for this one; built entirely
/// from primitives, mirroring ArenaBuilder.AddBookshelfRing's look at a
/// single-bay scale) and a wall-hung painting frame (beveled frame +
/// textured canvas quad, visual only).
///
/// Both builders return a Node3D authored in a shared LOCAL convention so
/// PieceVariants can place either one with the same math:
///   - local X: width, centred on 0
///   - local Y: BuildBookshelf is floor-anchored (0 = floor, +up);BuildPaintingFrame
///     is centre-anchored (0 = painting's vertical centre)
///   - local Z: 0 = back face (flush against the wall), negative = toward
///     the room (front). WallBasis(outward) below orients this correctly
///     regardless of which of the 4 cardinal directions the wall faces.
public static class ManorFurniture
{
    // ══════════════════════════════════════════════════════════════════════
    //  Shared orientation helper
    // ══════════════════════════════════════════════════════════════════════

    /// Right-handed, Y-up basis for wall-mounted decor authored with local Z
    /// in [-depth, 0] (0 = back/wall, negative = front/room) and local X =
    /// width (left/right-symmetric, so X's exact sign doesn't matter). Fixes
    /// local +Z to `outward` (the direction from corridor centre TO the
    /// wall) — get this backwards and content built at Z<0 lands INSIDE the
    /// solid dungeon wall instead of protruding into the room.
    public static Basis WallBasis(Vector3 outward) => new(Vector3.Up.Cross(outward), Vector3.Up, outward);

    // ══════════════════════════════════════════════════════════════════════
    //  Box mesh helpers (axis-aligned; content is always authored in a
    //  world-aligned local frame here, so no per-face orientation math is
    //  needed — unlike ArenaBuilder's curved-ring OrientedBox).
    // ══════════════════════════════════════════════════════════════════════
    static void EmitBox(SurfaceTool st, Vector3 c, Vector3 h)
    {
        Vector3[] v = {
            c+new Vector3(-h.X,-h.Y,-h.Z), c+new Vector3(h.X,-h.Y,-h.Z), c+new Vector3(h.X,h.Y,-h.Z), c+new Vector3(-h.X,h.Y,-h.Z),
            c+new Vector3(-h.X,-h.Y, h.Z), c+new Vector3(h.X,-h.Y, h.Z), c+new Vector3(h.X,h.Y, h.Z), c+new Vector3(-h.X,h.Y, h.Z) };
        int[][] faces = { new[]{0,1,2,3}, new[]{5,4,7,6}, new[]{4,0,3,7}, new[]{1,5,6,2}, new[]{3,2,6,7}, new[]{4,5,1,0} };
        foreach (var f in faces)
        {
            st.AddVertex(v[f[0]]); st.AddVertex(v[f[1]]); st.AddVertex(v[f[2]]);
            st.AddVertex(v[f[0]]); st.AddVertex(v[f[2]]); st.AddVertex(v[f[3]]);
        }
    }

    static void EmitBoxColored(SurfaceTool st, Vector3 c, Vector3 h, Color col)
    {
        st.SetColor(col);   // persists for all AddVertex calls until next SetColor
        EmitBox(st, c, h);
    }

    // ══════════════════════════════════════════════════════════════════════
    //  BOOKSHELF — single collidable bay, ~2.4m wide x 3.0m tall x 0.45m deep.
    //  No GLB asset exists for this (per Task 7 brief: build procedurally).
    //  Posts + shelf boards are one merged wood mesh; books are the bookrow_*
    //  GLBs from ArenaBuilder's ring (rescaled to fit, same measure-then-
    //  rescale idiom) when available, else a deterministic (no RNG) box-book
    //  fallback so the shelf never renders bare.
    // ══════════════════════════════════════════════════════════════════════
    public const float ShelfWidth  = 2.4f;
    public const float ShelfHeight = 3.0f;
    public const float ShelfDepth  = 0.45f;
    const float PostW   = 0.14f;
    const float BoardTh = 0.06f;
    // Board Y-positions; the top one intentionally stays bare (matches
    // ArenaBuilder.AddBookshelfRing's "no books on the top board" rule).
    static readonly float[] ShelfLevels = { 0.05f, 0.85f, 1.65f, 2.45f };

    static ArrayMesh? _shelfWoodMesh;
    static ArrayMesh? _shelfBookMesh;
    static ShaderMaterial? _woodMat;
    static ShaderMaterial? _bookMat;

    public static Node3D BuildBookshelf()
    {
        var root = new Node3D { Name = "CorridorBookshelf" };

        var woodMesh = ShelfWoodMesh();
        if (woodMesh != null)
            root.AddChild(new MeshInstance3D { Name = "ShelfWood", Mesh = woodMesh, MaterialOverride = WoodMat() });

        // Book rows: real GLB per level (3 variants) when the asset pipeline
        // has produced them, else a procedural fallback. PropsAvailable is a
        // single global flag (PropLibrary checks assets/glb/props once) so
        // this is effectively all-or-nothing per run, not per level — the
        // per-call null check just matches the defensive style used
        // elsewhere in PieceVariants/ArenaBuilder.
        string[] rows = { "bookrow_a", "bookrow_b", "bookrow_c" };
        float boardLen = ShelfWidth - PostW * 2f;
        bool anyGlbRow = false;
        for (int i = 0; i < 3; i++)
        {
            var row = PropLibrary.Instance(rows[i % rows.Length]);
            if (row == null) continue;
            anyGlbRow = true;
            var aabb = PropLibrary.GetLocalAabb(row);
            float rowLen = Mathf.Max(aabb.Size.X, aabb.Size.Z);
            if (rowLen > 0.001f) row.Scale *= boardLen / rowLen;
            row.Position = new Vector3(0, ShelfLevels[i] + BoardTh * 0.5f, -ShelfDepth * 0.7f);
            root.AddChild(row);
        }
        if (!anyGlbRow)
        {
            var bookMesh = ShelfBookMeshFallback();
            if (bookMesh != null)
                root.AddChild(new MeshInstance3D { Name = "ShelfBooksFallback", Mesh = bookMesh, MaterialOverride = BookMat() });
        }

        // Collision: single box at the post/board front plane (the bay's
        // true outermost surface — books sit recessed inside it, same
        // reasoning as ArenaBuilder.AddShelfCollision's doc comment).
        var col = new StaticBody3D { Name = "BookshelfCollision" };
        col.AddToGroup("ManorFurnitureCollider");
        col.AddChild(new CollisionShape3D
        {
            Name  = "Box",
            Shape = new BoxShape3D { Size = new Vector3(ShelfWidth, ShelfHeight, ShelfDepth) },
            Position = new Vector3(0, ShelfHeight * 0.5f, -ShelfDepth * 0.5f),
        });
        root.AddChild(col);

        return root;
    }

    static ArrayMesh? ShelfWoodMesh()
    {
        if (_shelfWoodMesh != null && GodotObject.IsInstanceValid(_shelfWoodMesh)) return _shelfWoodMesh;
        var st = new SurfaceTool();
        st.Begin(Mesh.PrimitiveType.Triangles);

        float halfW = ShelfWidth * 0.5f;
        foreach (float sx in new[] { -1f, 1f })
        {
            float px = sx * (halfW - PostW * 0.5f);
            EmitBox(st, new Vector3(px, ShelfHeight * 0.5f, -ShelfDepth * 0.5f),
                    new Vector3(PostW * 0.5f, ShelfHeight * 0.5f, ShelfDepth * 0.5f));
        }
        float boardLen = ShelfWidth - PostW * 2f;
        foreach (float y in ShelfLevels)
            EmitBox(st, new Vector3(0, y, -ShelfDepth * 0.5f),
                    new Vector3(boardLen * 0.5f, BoardTh * 0.5f, ShelfDepth * 0.5f));

        st.GenerateNormals();
        var mesh = st.Commit();
        if (mesh.GetSurfaceCount() == 0) return null;
        _shelfWoodMesh = mesh;
        return mesh;
    }

    static ArrayMesh? ShelfBookMeshFallback()
    {
        if (_shelfBookMesh != null && GodotObject.IsInstanceValid(_shelfBookMesh)) return _shelfBookMesh;
        var st = new SurfaceTool();
        st.Begin(Mesh.PrimitiveType.Triangles);
        var palette = new[] {
            new Color(0.45f,0.08f,0.50f), new Color(0.10f,0.30f,0.55f), new Color(0.50f,0.12f,0.15f),
            new Color(0.08f,0.40f,0.30f), new Color(0.55f,0.30f,0.08f), new Color(0.25f,0.10f,0.45f),
        };
        float boardLen = ShelfWidth - PostW * 2f;
        for (int level = 0; level < 3; level++)
        {
            float y = ShelfLevels[level] + BoardTh * 0.5f;
            float t = -boardLen * 0.5f + 0.10f;
            int idx = 0;
            while (t < boardLen * 0.5f - 0.10f)
            {
                float w = 0.09f + (idx % 3) * 0.02f;
                float h = 0.45f + (idx % 4) * 0.05f;   // stays well under shelf spacing (~0.8m)
                var col = palette[(level * 3 + idx) % palette.Length];
                EmitBoxColored(st, new Vector3(t + w * 0.5f, y + h * 0.5f, -ShelfDepth * 0.7f),
                    new Vector3(w * 0.5f, h * 0.5f, 0.06f), col);
                t += w + 0.015f;
                idx++;
            }
        }
        st.GenerateNormals();
        var mesh = st.Commit();
        if (mesh.GetSurfaceCount() == 0) return null;
        _shelfBookMesh = mesh;
        return mesh;
    }

    const string WoodShaderSrc = @"
shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;
varying vec3 wpos;
void vertex(){ wpos=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz; }
float hash13(vec3 p){ p=fract(p*0.1031); p+=dot(p,p.zyx+31.32); return fract((p.x+p.y)*p.z); }
float vnoise(vec3 p){
    vec3 i=floor(p), f=fract(p); f=f*f*(3.0-2.0*f);
    float a=hash13(i),b=hash13(i+vec3(1,0,0)),c=hash13(i+vec3(0,1,0)),d=hash13(i+vec3(1,1,0));
    float e=hash13(i+vec3(0,0,1)),g=hash13(i+vec3(1,0,1)),h=hash13(i+vec3(0,1,1)),k=hash13(i+vec3(1,1,1));
    return mix(mix(mix(a,b,f.x),mix(c,d,f.x),f.y),mix(mix(e,g,f.x),mix(h,k,f.x),f.y),f.z);
}
void fragment(){
    float grain = vnoise(vec3(wpos.x*6.0, wpos.y*0.9, wpos.z*6.0));
    vec3 dark = vec3(0.13,0.08,0.05), light = vec3(0.30,0.19,0.11);
    ALBEDO = mix(dark, light, grain);
    ROUGHNESS = 0.85;
}";
    const string BookShaderSrc = @"
shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;
void fragment(){ ALBEDO = COLOR.rgb; ROUGHNESS = 0.6; }";

    static ShaderMaterial WoodMat() =>
        _woodMat != null && GodotObject.IsInstanceValid(_woodMat) ? _woodMat
        : _woodMat = new ShaderMaterial { Shader = new Shader { Code = WoodShaderSrc } };
    static ShaderMaterial BookMat() =>
        _bookMat != null && GodotObject.IsInstanceValid(_bookMat) ? _bookMat
        : _bookMat = new ShaderMaterial { Shader = new Shader { Code = BookShaderSrc } };

    // ══════════════════════════════════════════════════════════════════════
    //  PAINTING FRAME — beveled dark-wood/gilt frame (thin boxes) + a quad
    //  showing the supplied texture as a lit albedo. Visual only, no
    //  collision (paintings are wall-flush and out of the player's path).
    //  Origin: CENTRE of the painting (X and Y both centred on 0) so callers
    //  can place it directly at the desired mount height.
    // ══════════════════════════════════════════════════════════════════════
    const float FrameBarW    = 0.06f;
    const float FrameDepth   = 0.05f;
    const float CanvasInset  = 0.015f;

    const string CanvasShaderSrc = @"
shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx, cull_disabled;
uniform sampler2D art_tex : filter_linear_mipmap;
void fragment(){
    ALBEDO = texture(art_tex, UV).rgb;
    ROUGHNESS = 0.9;
}";

    public static Node3D BuildPaintingFrame(Texture2D art, float w, float h)
    {
        var root = new Node3D { Name = "Painting" };
        float hw = w * 0.5f, hh = h * 0.5f;

        var st = new SurfaceTool();
        st.Begin(Mesh.PrimitiveType.Triangles);
        // top / bottom bars (full width) + left / right bars (fill remaining height)
        EmitBox(st, new Vector3(0, hh - FrameBarW * 0.5f, -FrameDepth * 0.5f), new Vector3(hw, FrameBarW * 0.5f, FrameDepth * 0.5f));
        EmitBox(st, new Vector3(0, -hh + FrameBarW * 0.5f, -FrameDepth * 0.5f), new Vector3(hw, FrameBarW * 0.5f, FrameDepth * 0.5f));
        EmitBox(st, new Vector3(-hw + FrameBarW * 0.5f, 0, -FrameDepth * 0.5f), new Vector3(FrameBarW * 0.5f, hh - FrameBarW, FrameDepth * 0.5f));
        EmitBox(st, new Vector3(hw - FrameBarW * 0.5f, 0, -FrameDepth * 0.5f), new Vector3(FrameBarW * 0.5f, hh - FrameBarW, FrameDepth * 0.5f));
        st.GenerateNormals();
        var frameMesh = st.Commit();
        if (frameMesh.GetSurfaceCount() > 0)
            root.AddChild(new MeshInstance3D { Name = "Frame", Mesh = frameMesh, MaterialOverride = FrameMat() });

        // Canvas quad. PlaneMesh defaults to lying flat (normal +Y, Size.x
        // along local X, Size.y along local Z); rotating -90 deg around X
        // swings that normal to -Z (our "front, into the room" convention)
        // while Size.x/Size.y land correctly on the final X/Y (width/height).
        //
        // Uses a ShaderMaterial with the texture as a sampler2D uniform
        // rather than StandardMaterial3D.AlbedoTexture — the latter crashed
        // headless --write-movie captures ("ERROR: Parameter "t" is null."
        // -> segfault) when fed a texture built at runtime via Image.Load +
        // ImageTexture.CreateFromImage. PieceVariants.RugMat already uses
        // this exact ShaderMaterial+sampler2D pattern successfully for the
        // same kind of runtime-loaded JPG texture, so mirroring it here.
        var canvasMesh = new PlaneMesh { Size = new Vector2(w - FrameBarW * 2f - CanvasInset, h - FrameBarW * 2f - CanvasInset) };
        var canvasMat = new ShaderMaterial { Shader = new Shader { Code = CanvasShaderSrc } };
        canvasMat.SetShaderParameter("art_tex", art);
        root.AddChild(new MeshInstance3D
        {
            Name = "Canvas",
            Mesh = canvasMesh,
            MaterialOverride = canvasMat,
            Position = new Vector3(0, 0, -FrameDepth * 0.55f),
            RotationDegrees = new Vector3(-90, 0, 0),
        });

        return root;
    }

    const string FrameShaderSrc = @"
shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;
varying vec3 wpos;
void vertex(){ wpos=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz; }
float hash13(vec3 p){ p=fract(p*0.1031); p+=dot(p,p.zyx+31.32); return fract((p.x+p.y)*p.z); }
float vnoise(vec3 p){
    vec3 i=floor(p), f=fract(p); f=f*f*(3.0-2.0*f);
    float a=hash13(i),b=hash13(i+vec3(1,0,0)),c=hash13(i+vec3(0,1,0)),d=hash13(i+vec3(1,1,0));
    float e=hash13(i+vec3(0,0,1)),g=hash13(i+vec3(1,0,1)),h=hash13(i+vec3(0,1,1)),k=hash13(i+vec3(1,1,1));
    return mix(mix(mix(a,b,f.x),mix(c,d,f.x),f.y),mix(mix(e,g,f.x),mix(h,k,f.x),f.y),f.z);
}
void fragment(){
    // warmer/lighter than the bookshelf wood grain — reads as gilt trim
    float grain = vnoise(vec3(wpos.x*10.0, wpos.y*1.2, wpos.z*10.0));
    vec3 dark = vec3(0.10,0.07,0.03), light = vec3(0.55,0.42,0.18);
    ALBEDO = mix(dark, light, grain);
    ROUGHNESS = 0.45;
    METALLIC = 0.2;
}";
    static ShaderMaterial? _frameMat;
    static ShaderMaterial FrameMat() =>
        _frameMat != null && GodotObject.IsInstanceValid(_frameMat) ? _frameMat
        : _frameMat = new ShaderMaterial { Shader = new Shader { Code = FrameShaderSrc } };

    // ══════════════════════════════════════════════════════════════════════
    //  Painting texture loader — assets/img/paintings/{name}.png, gitignored
    //  like every other asset directory. Returns null (caller skips) when
    //  missing, matching PropLibrary.Instance's contract.
    // ══════════════════════════════════════════════════════════════════════
    static readonly Dictionary<string, Texture2D?> _paintingCache = new();

    public static Texture2D? LoadPaintingTexture(string fileNameNoExt)
    {
        if (_paintingCache.TryGetValue(fileNameNoExt, out var cached) && cached != null && GodotObject.IsInstanceValid(cached))
            return cached;

        var resPath = $"res://assets/img/paintings/{fileNameNoExt}.png";
        var abs = ProjectSettings.GlobalizePath(resPath);
        var img = new Image();
        if (!System.IO.File.Exists(abs) || img.Load(abs) != Error.Ok)
        {
            // export builds ship only the imported .ctex + .remap, not this
            // source PNG — retry through the resource loader before giving up.
            if (!ResourceLoader.Exists(resPath)) { _paintingCache[fileNameNoExt] = null; return null; }
            img = GD.Load<Texture2D>(resPath)?.GetImage();
            if (img == null) { _paintingCache[fileNameNoExt] = null; return null; }
            img.Decompress();   // GetImage() may be compressed
        }
        img.SrgbToLinear();
        img.GenerateMipmaps();
        var tex = ImageTexture.CreateFromImage(img);
        _paintingCache[fileNameNoExt] = tex;
        return tex;
    }
}
