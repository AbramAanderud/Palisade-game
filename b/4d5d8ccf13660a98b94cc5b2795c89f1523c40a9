using System.Collections.Generic;
using Godot;

/// Visual verification for Room and Pit geometry.
/// Builds a small maze: a corridor entering a 3x2 open room, plus a Pit two cells east.
/// Steps a camera through waypoints, one per captured frame.
public partial class TestRoomPitGeo : Node3D
{
    Camera3D _cam = null!;
    int      _frame = 0;

    const float CS = DungeonBuilder.CellSize;

    static readonly (Vector3 pos, float yaw, float pitch, string note)[] Waypoints =
    {
        // In the corridor at (3,0), looking south into the room doorway.
        (new(3.5f * CS, 2f, 0.5f * CS), 180f,   0f, "corridor -> room doorway"),
        // Standing inside the room, looking up at the vault.
        // NOTE: pitch is +55 here, not -55 as in the original brief snippet — in this
        // project's Camera3D.Rotation convention (matches PlayerController._pitch:
        // mouse-down subtracts from pitch to look down), positive pitch looks UP.
        // -55 was verified by capture to point the camera at the floor instead.
        (new(3.5f * CS, 2f, 2.5f * CS), 180f,  55f, "room vault from inside"),
        // Room corner, looking across the whole space (plinth + merged floor).
        (new(2.2f * CS, 3f, 1.2f * CS), 200f, -10f, "room floor, plinth, no interior walls"),
        // Beside the pit on floor 0, looking into the shaft doorway.
        (new(7.5f * CS, 2f, 1.5f * CS), 270f,   0f, "pit doorway from floor 0"),
        // Above the pit centre looking straight down the shaft.
        (new(6.5f * CS, DungeonBuilder.FloorHeight + 8f, 2.5f * CS), 0f, -89f, "pit shaft looking down"),
        // Bottom of the shaft looking up.
        (new(6.5f * CS, -DungeonBuilder.FloorHeight + 2f, 2.5f * CS), 0f, 80f, "pit shaft looking up"),
        // Task 4: standing in the room cell (3,3) on floor 0, looking south and down
        // through the missing floor slab at (3,4) — the stair's landing cell — to see
        // down into the open shaft below. This is the shot that proves IsStairLandingCell's
        // fix: no slab caps this cell, so there's a real opening in the room floor.
        (new(3.5f * CS, 3f, 3.3f * CS), 180f, -40f, "stair landing hole in room floor"),
        // Partway up the new stairwell (floor -1), looking up the flight toward the
        // landing hole. Framed above the tread line (not below it — a camera below the
        // treads sees only their single-sided undersides and renders solid black, which
        // is a viewing-angle artifact, not a geometry defect). This is the clearest shot:
        // individual treads are visible rising to a lit opening with nothing capping it.
        (new(3.5f * CS, -9f, 3.3f * CS), 180f, 20f, "mid-stair view looking up at treads and hole"),
    };

    public override void _Ready()
    {
        var worldEnv = new WorldEnvironment();
        worldEnv.Environment = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0f, 0f, 0f),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(0.30f, 0.26f, 0.22f),
            AmbientLightEnergy = 0.9f,
            TonemapMode        = Godot.Environment.ToneMapper.Filmic,
            TonemapExposure    = 1.3f,
        };
        AddChild(worldEnv);

        AddChild(new DirectionalLight3D
        {
            Name        = "TestSun",
            LightColor  = new Color(1f, 0.95f, 0.85f),
            LightEnergy = 1.4f,
            Rotation    = new Vector3(-0.7f, 0.5f, 0f),
        });

        var maze = new MazeData { Name = "RoomPitGeo", Pieces = BuildPieces() };

        var dungeon = new DungeonBuilder();
        AddChild(dungeon);
        dungeon.Build(maze);

        _cam = new Camera3D { Fov = 75f, Current = true, Far = 500f };
        AddChild(_cam);
        Place(0);
    }

    static List<MazePiece> BuildPieces()
    {
        var list = new List<MazePiece>();

        void P(PieceType t, int x, int y, int rot = 0, int floor = 0)
            => list.Add(new MazePiece { Type = t, X = x, Y = y, Floor = floor, Rotation = rot });

        // Corridor running south from the top edge into the room.
        P(PieceType.Start,    3, 0);
        // 3x2 open room at x 2..4, y 1..2.
        for (int x = 2; x <= 4; x++)
            for (int y = 1; y <= 2; y++)
                P(PieceType.Room, x, y);

        // Pit anchored at (6,1): claims x 5..7, y 0..2 on floors -1, 0, +1.
        // No connector corridor is needed: the room's east edge is x=4, the pit's
        // west edge is x=5 — they're already adjacent cells. The corridor that used
        // to sit at (5,1) is now INSIDE the pit's footprint, so it's removed rather
        // than relocated: (4,1) is already a Room tile, and Room is open on all four
        // faces (PieceDB), so its east face automatically doorways into the pit's
        // west perimeter cell (5,1) with no filler piece required.
        P(PieceType.Pit,      6, 1);

        P(PieceType.Exit,     3, 9);

        // StairsUp on floor -1 at (3,3) rot 2 crosses S -> lands at (3,4) on floor 0.
        // Move the room to cover (3,4) by adding a room tile there.
        P(PieceType.StairsUp, 3, 3, rot: 2, floor: -1);
        P(PieceType.Room,     3, 3);
        P(PieceType.Room,     3, 4);
        return list;
    }

    void Place(int i)
    {
        var (pos, yaw, pitch, note) = Waypoints[i];
        _cam.Position = pos;
        _cam.Rotation = new Vector3(Mathf.DegToRad(pitch), Mathf.DegToRad(yaw), 0f);
        GD.Print($"[frame {i}] {note}  pos={pos}");
    }

    public override void _Process(double delta)
    {
        _frame++;
        int idx = Mathf.Min(_frame / 2, Waypoints.Length - 1);
        Place(idx);
        if (_frame / 2 >= Waypoints.Length) GetTree().Quit();
    }
}
