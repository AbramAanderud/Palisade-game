using System.Collections.Generic;

/// res://scripts/MazeData.cs — Serializable maze data model.

public class MazePiece
{
    public PieceType Type     { get; set; }
    public int       X        { get; set; }
    public int       Y        { get; set; }
    public int       Floor    { get; set; }
    public int       Rotation { get; set; }  // 0-3 (clockwise quarter turns)

    /// Pairs two Teleport Pads. Both ends of a pair share the same non-zero id.
    /// 0 means unpaired — an unpaired pad is inert.
    /// Old saves deserialize this as 0, which is the correct default.
    public int LinkId { get; set; } = 0;
}

public class MazeData
{
    public string          Name      { get; set; } = "Untitled";
    public int             GoldSpent { get; set; } = 0;
    public List<MazePiece> Pieces    { get; set; } = new();
    /// True when saved from MazeEditor3D (the canonical editor).
    /// Defaults to true so the maze appears in the Play Game lobby's dropdown.
    public bool            IsOnline    { get; set; } = true;

    /// True when MazeValidator.IsGameReady(this) succeeds at save time.
    /// Only game-ready mazes appear in the Play Game lobby's maze selector.
    public bool            IsGameReady { get; set; } = false;

    // ── Per-maze analytics, updated on every online match's sword pickup ─────
    /// Total matches this maze has been in.
    public int    MatchesPlayed   { get; set; } = 0;
    /// Matches where this maze trapped its opponent (they didn't escape in time).
    public int    TrapSuccesses   { get; set; } = 0;
    /// Matches where the opponent escaped this maze.
    public int    EscapeCount     { get; set; } = 0;
    /// Sum of escape times in seconds across all escapes (divide by EscapeCount for average).
    public double EscapeTimesSum  { get; set; } = 0.0;
}
