using Godot;
using System.Collections.Generic;

/// res://scripts/VisualFlair.cs
/// ─────────────────────────────────────────────────────────────────────────────
/// EXPERIMENTAL atmospheric + prop layer for the dungeon.
///
/// Everything in this file is ADDITIVE and gated behind `VisualFlair.Enabled`.
/// To fully revert the new look:
///   • set `VisualFlair.Enabled = false`  (kills every effect at runtime), OR
///   • delete this file + the two guarded call sites:
///       - DungeonBuilder.Build()                → VisualFlair.Decorate(...)
///       - OnlineDungeonArena.BuildEnvironment()  → VisualFlair.ApplyEnvironment(...)
///
/// Renderer note: the project runs GL Compatibility. Volumetric fog, SSAO and
/// SDFGI are NOT available there — depth fog, glow and omni shadows ARE. The
/// "god-ray" beams are faked with additive cone geometry + a spotlight rather
/// than true volumetrics.
/// ─────────────────────────────────────────────────────────────────────────────
public static class VisualFlair
{
    // ══════════════════════════════════════════════════════════════════════════
    //  CONTROL PANEL — tweak these freely. Set Enabled=false to fully revert.
    //  Every field below is read at dungeon-build time, so changing a value and
    //  rebuilding is all it takes — no other code needs touching.
    // ══════════════════════════════════════════════════════════════════════════
    public static bool Enabled = true;            // master switch (false = original look)

    // ── Environment ────────────────────────────────────────────────────────────
    public static bool  Fog           = true;
    public static float FogDensity    = 0.020f;   // higher = thicker haze / shorter sightlines
    public static Color FogColor      = new(0.045f, 0.035f, 0.030f);
    public static bool  Glow          = true;
    public static float GlowIntensity = 0.55f;
    public static float GlowBloom     = 0.12f;
    public static float GlowThreshold = 1.0f;     // only pixels brighter than this bloom (1.0 = flames only)
    public static float Exposure      = 1.12f;

    // ── Torches ────────────────────────────────────────────────────────────────
    // Polish Pass Task 2: the procedural wall-mounted torch bracket + emissive
    // flame cone (formerly `AddTorchBracket`, relocated the corridor omni onto
    // a wall) is REMOVED — GLB sconces (PieceVariants.AddSconces) are now the
    // visible torch prop and primary light source. This layer only flickers
    // whatever light TorchByCell holds for a cell (a lit sconce, or the
    // DungeonBuilder fallback ambient for cells with no lit sconce).
    public static bool  Flicker       = true;
    public static float FlickerAmount = 0.14f;

    // ── Landmarks (Start / Exit) ────────────────────────────────────────────────
    // Tamed from the raw 3.5-energy neon glows so they no longer flood whole runs.
    public static float StartEnergy   = 2.0f;
    public static float StartRange    = 12f;
    public static Color StartColor    = new(0.35f, 0.85f, 0.45f);  // green identity, less neon
    public static float ExitEnergy    = 1.6f;
    public static float ExitRange     = 12f;
    public static Color ExitColor     = new(0.95f, 0.32f, 0.20f);  // ember-red, not pure red
    public static bool  GodRays       = true;
    public static Color ExitBeam      = new(1.0f, 0.80f, 0.42f);   // warm GOLD shaft (reads over red omni)
    public static Color StartBeam     = new(0.55f, 1.0f, 0.65f);
    public static float BeamSpotEnergy = 2.4f;

    // ── Props ──────────────────────────────────────────────────────────────────
    public static bool Banners = false;   // wall banners removed per request — flip true to restore
    public static bool Rubble  = true;

    // ══════════════════════════════════════════════════════════════════════════
    //  ENVIRONMENT — depth fog + glow + grade
    // ══════════════════════════════════════════════════════════════════════════
    public static void ApplyEnvironment(Godot.Environment env)
    {
        if (!Enabled) return;

        // Warm, dark exponential fog → atmospheric falloff, hides repetition,
        // and lets torch light read as pools rather than flat fill.
        if (Fog)
        {
            env.FogEnabled     = true;
            env.FogLightColor  = FogColor;
            env.FogLightEnergy = 1.0f;
            env.FogSunScatter  = 0.0f;
            env.FogDensity     = FogDensity;
        }

        // Glow / bloom so torch cores and emissive flames bleed light.
        if (Glow)
        {
            env.GlowEnabled      = true;
            env.GlowIntensity    = GlowIntensity;
            env.GlowStrength     = 1.0f;
            env.GlowBloom        = GlowBloom;
            env.GlowHdrThreshold = GlowThreshold;
            env.SetGlowLevel(1, 1.0f);
            env.SetGlowLevel(2, 1.0f);
            env.SetGlowLevel(3, 0.7f);
            env.SetGlowLevel(4, 0.4f);
        }

        // Keep the existing Filmic tonemap; pull exposure a touch for contrast.
        env.TonemapExposure = Exposure;
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  PROPS + LIGHT POLISH — one entry point, called after AddTorches()
    // ══════════════════════════════════════════════════════════════════════════
    public static void Decorate(Node3D root, List<MazePiece> pieces,
        Dictionary<(int X, int Y, int Floor), OmniLight3D> torchByCell)
    {
        if (!Enabled) return;

        const float Cell = DungeonBuilder.CellSize;     // 10
        const float FloorH = DungeonBuilder.FloorHeight; // 18
        const float WallH = DungeonBuilder.CellHeight;   // 14
        const float Hw    = DungeonBuilder.OpeningW * 0.5f; // 3

        TorchFlicker? flicker = null;
        if (Flicker)
        {
            flicker = new TorchFlicker { Name = "TorchFlicker" };
            root.AddChild(flicker);
        }

        int idx = 0;
        foreach (var p in pieces)
        {
            float cx    = p.X * Cell + Cell * 0.5f;
            float cz    = p.Y * Cell + Cell * 0.5f;
            float yBase = p.Floor * FloorH;
            float ty    = yBase + WallH * 0.50f;

            bool isStair = PieceDB.IsStair(p.Type);
            torchByCell.TryGetValue((p.X, p.Y, p.Floor), out var light);

            // ── Start / Exit landmarks: tame the glow, add a god-ray shaft ────
            if (p.Type == PieceType.Exit || p.Type == PieceType.Start)
            {
                bool exit = p.Type == PieceType.Exit;
                if (light != null)
                {
                    // Pull the raw neon landmark glows down so they read as a
                    // local accent instead of flooding the whole corridor.
                    light.LightColor = exit ? ExitColor   : StartColor;
                    light.LightEnergy = exit ? ExitEnergy : StartEnergy;
                    light.OmniRange   = exit ? ExitRange  : StartRange;
                }
                if (GodRays)
                    AddGodRay(root, cx, yBase, cz, FloorH, exit ? ExitBeam : StartBeam);
                flicker?.Register(light, 0.05f); // gentle landmark pulse
                idx++;
                continue;
            }

            if (isStair)
            {
                flicker?.Register(light, 0.18f);
                idx++;
                continue;
            }

            // ── Regular corridor: light is a lit GLB sconce (PieceVariants.
            // AddSconces) or DungeonBuilder's dim fallback — either way it's
            // already correctly positioned/mounted by its owner, so this layer
            // only adds flicker. No repositioning, no procedural bracket/flame
            // mesh (that visual is gone — see the Torches control-panel note).
            Dir open = PieceDB.GetOpenings(p.Type, p.Rotation);
            flicker?.Register(light, FlickerAmount);

            // ── Occasional hanging banner on a closed wall of a straight run ──
            if (Banners && p.Type == PieceType.Straight && idx % 3 == 1)
            {
                Dir banDir = FirstClosed(open, idx + 2);
                if (banDir != Dir.None)
                    AddBanner(root, banDir, cx, cz, yBase, WallH, Hw, idx);
            }

            // ── A little scattered rubble for floor detail ────────────────────
            if (Rubble && idx % 2 == 0)
                AddRubble(root, cx, cz, yBase, idx);

            idx++;
        }
    }

    // ── Direction helpers ─────────────────────────────────────────────────────
    static readonly Dir[] Cards = { Dir.N, Dir.E, Dir.S, Dir.W };

    static Dir FirstClosed(Dir open, int seed)
    {
        // Rotate the start point by seed so torches don't all stick to one wall.
        for (int i = 0; i < 4; i++)
        {
            Dir d = Cards[(seed + i) % 4];
            if ((open & d) == 0) return d;
        }
        return Dir.None;
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  PROP BUILDERS (procedural primitives — no asset files)
    // ══════════════════════════════════════════════════════════════════════════
    // NOTE: the old `AddTorchBracket`/`WallMount` (iron bracket + emissive
    // flame cone mounted on the wall) is REMOVED as of Polish Pass Task 2 —
    // GLB sconces (PieceVariants.AddSconces) are the visible torch prop now.
    // `IronMat`/`FlameMat` below are gone too, since they existed only to
    // shade that removed geometry.

    // Faked god-ray: large additive cone widening toward the floor + a soft spot.
    static void AddGodRay(Node3D root, float cx, float yBase, float cz,
        float floorH, Color tint)
    {
        var beam = new MeshInstance3D
        {
            Name = "GodRay",
            Mesh = new CylinderMesh
            {
                TopRadius = 0.6f, BottomRadius = 3.0f,
                Height = floorH * 0.92f, RadialSegments = 16,
            },
            Position = new Vector3(cx, yBase + floorH * 0.46f, cz),
        };
        beam.SetSurfaceOverrideMaterial(0, BeamMat(tint));
        beam.CastShadow = GeometryInstance3D.ShadowCastingSetting.Off;
        root.AddChild(beam);

        var spot = new SpotLight3D
        {
            Name = "GodRaySpot",
            Position = new Vector3(cx, yBase + floorH - 0.5f, cz),
            RotationDegrees = new Vector3(-90f, 0f, 0f),
            LightColor = tint,
            LightEnergy = BeamSpotEnergy,
            SpotRange = floorH,
            SpotAngle = 30f,
            SpotAngleAttenuation = 1.2f,
            ShadowEnabled = false,
        };
        root.AddChild(spot);
    }

    // Hanging cloth banner against a closed wall.
    static void AddBanner(Node3D root, Dir wallDir, float cx, float cz,
        float yBase, float wallH, float hw, int seed)
    {
        const float inset = 0.12f;
        float top = yBase + wallH - 0.4f;
        float h = 6.5f;
        var pos = wallDir switch
        {
            Dir.N => new Vector3(cx, top - h * 0.5f, cz - hw + inset),
            Dir.S => new Vector3(cx, top - h * 0.5f, cz + hw - inset),
            Dir.E => new Vector3(cx + hw - inset, top - h * 0.5f, cz),
            _     => new Vector3(cx - hw + inset, top - h * 0.5f, cz),
        };
        // Face the banner into the corridor (QuadMesh front = +Z by default).
        float yaw = wallDir switch
        {
            Dir.N => 0f,     // wall at -Z, room toward +Z
            Dir.S => 180f,   // wall at +Z, room toward -Z
            Dir.E => -90f,   // wall at +X, room toward -X
            _     => 90f,    // wall at -X, room toward +X
        };

        var banner = new MeshInstance3D
        {
            Name = "Banner",
            Mesh = new QuadMesh { Size = new Vector2(1.8f, h) },
            Position = pos,
            RotationDegrees = new Vector3(0f, yaw, 0f),
        };
        // Alternate two house colours so runs aren't monotone. Brighter than a
        // true cloth albedo so they still read in the dim torchlight.
        var col = (seed % 2 == 0)
            ? new Color(0.70f, 0.10f, 0.12f)   // crimson
            : new Color(0.16f, 0.26f, 0.62f);  // indigo
        banner.SetSurfaceOverrideMaterial(0, ClothMat(col));
        banner.CastShadow = GeometryInstance3D.ShadowCastingSetting.Off;
        root.AddChild(banner);
    }

    // A couple of small stone chunks on the floor.
    static void AddRubble(Node3D root, float cx, float cz, float yBase, int seed)
    {
        int n = 2 + (seed % 2);
        for (int i = 0; i < n; i++)
        {
            float ang = (seed * 1.3f + i * 2.1f);
            float r   = 1.4f + (i * 0.7f);
            float s   = 0.25f + ((seed + i) % 3) * 0.12f;
            var rock = new MeshInstance3D
            {
                Name = $"Rubble{i}",
                Mesh = new BoxMesh { Size = new Vector3(s, s * 0.7f, s * 1.1f) },
                Position = new Vector3(
                    cx + Mathf.Cos(ang) * r,
                    yBase + s * 0.35f,
                    cz + Mathf.Sin(ang) * r),
                RotationDegrees = new Vector3(0f, ang * 30f, 0f),
            };
            rock.SetSurfaceOverrideMaterial(0, RubbleMat());
            root.AddChild(rock);
        }
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  SHARED MATERIALS (cached)
    // ══════════════════════════════════════════════════════════════════════════
    static StandardMaterial3D? _rubble;

    static StandardMaterial3D RubbleMat() => _rubble ??= new StandardMaterial3D
    {
        AlbedoColor = new Color(0.20f, 0.18f, 0.15f),
        Roughness = 0.95f, Metallic = 0.0f,
    };

    // Per-colour materials (not cached — few instances). A faint emissive lift
    // keeps the banner legible where torchlight doesn't reach the upper wall.
    static StandardMaterial3D ClothMat(Color c) => new StandardMaterial3D
    {
        AlbedoColor = c, Roughness = 0.9f, Metallic = 0.0f,
        CullMode = BaseMaterial3D.CullModeEnum.Disabled,
        EmissionEnabled = true,
        Emission = c,
        EmissionEnergyMultiplier = 0.35f,
    };

    static StandardMaterial3D BeamMat(Color tint) => new StandardMaterial3D
    {
        AlbedoColor = new Color(tint.R, tint.G, tint.B, 0.10f),
        ShadingMode = BaseMaterial3D.ShadingModeEnum.Unshaded,
        Transparency = BaseMaterial3D.TransparencyEnum.Alpha,
        BlendMode = BaseMaterial3D.BlendModeEnum.Add,
        CullMode = BaseMaterial3D.CullModeEnum.Disabled,
        DisableReceiveShadows = true,
    };
}

/// Runtime flicker driver — animates the energy of registered torch lights with
/// a layered-sine "fire" wobble. Self-contained: lives only while the dungeon
/// node tree exists, and is never created when VisualFlair.Enabled is false.
public partial class TorchFlicker : Node
{
    struct Entry { public OmniLight3D Light; public float Base; public float Amt; public float Phase; }
    readonly List<Entry> _lights = new();
    float _t;

    public void Register(OmniLight3D? light, float amount)
    {
        if (light == null) return;
        // Spread phases so torches don't pulse in unison.
        float phase = _lights.Count * 0.7f;
        _lights.Add(new Entry { Light = light, Base = light.LightEnergy, Amt = amount, Phase = phase });
    }

    public override void _Process(double delta)
    {
        _t += (float)delta;
        foreach (var e in _lights)
        {
            float w = Mathf.Sin(_t * 11f + e.Phase) * 0.6f
                    + Mathf.Sin(_t * 23f + e.Phase * 1.7f) * 0.3f
                    + Mathf.Sin(_t * 4.3f + e.Phase * 0.5f) * 0.1f;
            e.Light.LightEnergy = e.Base * (1f + e.Amt * w);
        }
    }
}
