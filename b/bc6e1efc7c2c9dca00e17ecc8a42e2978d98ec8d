using System.Collections.Generic;
using System.Linq;
using Godot;

/// test/TestLightGate.cs — FfaLightGate: a maze's OmniLight3Ds are visible only
/// while the viewer is inside that maze; a hallway's are visible from the arena
/// or from its own maze/hallway; the arena's own lights are never touched; and
/// no camera at all leaves everything on. Instances the "worst" FFA scene
/// offline (WithPlayer=false, so nothing drives the active camera), then swaps
/// its own gate — which reads the (nonexistent) active camera — for a second
/// gate wired to a controllable local Vector3? so each zone can be probed on
/// demand via Evaluate(), exactly as a caller would.
public partial class TestLightGate : Node
{
    int _fail;
    void Check(bool ok, string label) { GD.Print((ok ? "PASS  " : "FAIL  ") + label); if (!ok) _fail++; }

    static bool AllOn(List<OmniLight3D> ls) => ls.All(l => l.Visible);
    static bool AllOff(List<OmniLight3D> ls) => ls.All(l => !l.Visible);

    public override async void _Ready()
    {
        FfaLocalArena.Fixture = "worst";
        FfaLocalArena.WithPlayer = false;
        FfaLocalArena.LightGate = true;
        var arena = GD.Load<PackedScene>("res://test/FfaLocalArena.tscn").Instantiate<FfaLocalArena>();
        AddChild(arena);
        await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame);
        await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame);

        // The scene's own gate drives off GetViewport().GetCamera3D(), and there
        // is no camera here — swap it for one wired to a controllable viewer.
        var sceneGate = arena.GetChildren().OfType<FfaLightGate>().Single();
        sceneGate.Free();

        Vector3? viewer = null;
        var gate = FfaLightGate.Attach(arena, arena.Layout, arena.Origin, arena.Mazes, arena.Halls, () => viewer);

        var arenaLights = arena.GetNode("Arena").FindChildren("*", "OmniLight3D", true, false)
                                .Cast<OmniLight3D>().ToList();
        var mazeLights = arena.Mazes.Select(m => m.FindChildren("*", "OmniLight3D", true, false)
                                                   .Cast<OmniLight3D>().ToList()).ToArray();
        var hallLights = arena.Halls.Select(h => h?.FindChildren("*", "OmniLight3D", true, false)
                                                   .Cast<OmniLight3D>().ToList() ?? new List<OmniLight3D>()).ToArray();
        Check(arenaLights.Count > 0, $"sanity: arena has lights ({arenaLights.Count})");
        Check(mazeLights.All(ls => ls.Count > 0), "sanity: every maze has lights");
        Check(hallLights.All(ls => ls.Count > 0), "sanity: every hallway has lights ('worst' forces a hallway)");

        int nIdx = System.Array.FindIndex(arena.Layout.Seats, s => s.Door == Door.N);
        int eIdx = System.Array.FindIndex(arena.Layout.Seats, s => s.Door == Door.E);
        var uN = PlusLayout.DoorDir(arena.Layout.Seats[nIdx].Door);
        var uE = PlusLayout.DoorDir(arena.Layout.Seats[eIdx].Door);
        float apothem = arena.Layout.Apothem, hallLen = arena.Layout.HallLength;

        // 1. Arena centre: every maze hidden, every hallway visible, arena untouched.
        viewer = new Vector3(0f, 1f, 0f);
        gate.Evaluate();
        Check(mazeLights.All(AllOff), "arena centre: every maze light hidden");
        Check(hallLights.All(AllOn), "arena centre: every hallway light visible");
        Check(AllOn(arenaLights), "arena centre: arena lights untouched/visible");
        Check(gate.CurrentSeat == -1, "arena centre: CurrentSeat == -1");

        // 5. Visible omnis at the arena centre <= arena omnis + hallway omnis.
        int visibleAtCentre = arenaLights.Count(l => l.Visible)
                             + hallLights.Sum(ls => ls.Count(l => l.Visible))
                             + mazeLights.Sum(ls => ls.Count(l => l.Visible));
        int arenaPlusHall = arenaLights.Count + hallLights.Sum(ls => ls.Count);
        GD.Print($"[LIGHTGATE] visible at arena centre = {visibleAtCentre}, arena omnis = {arenaLights.Count}, " +
                 $"hallway omnis = {hallLights.Sum(ls => ls.Count)}");
        Check(visibleAtCentre <= arenaPlusHall, "arena centre: visible omnis <= arena + hallway omnis");

        // 2. N hallway midpoint: only the N maze + N hall are visible.
        viewer = uN * (apothem + hallLen * 0.5f) + Vector3.Up;
        gate.Evaluate();
        for (int i = 0; i < arena.Mazes.Length; i++)
        {
            bool isN = i == nIdx;
            var door = arena.Layout.Seats[i].Door;
            Check(isN ? AllOn(mazeLights[i]) : AllOff(mazeLights[i]),
                  $"N hallway midpoint: maze {door} lights {(isN ? "visible" : "hidden")}");
            Check(isN ? AllOn(hallLights[i]) : AllOff(hallLights[i]),
                  $"N hallway midpoint: hall {door} lights {(isN ? "visible" : "hidden")}");
        }
        Check(AllOn(arenaLights), "N hallway midpoint: arena lights untouched/visible");
        Check(gate.CurrentSeat == nIdx, "N hallway midpoint: CurrentSeat == N seat");

        // 3. Deep in the E maze: only the E maze + E hall are visible.
        viewer = uE * (apothem + hallLen + 50f) + Vector3.Up;
        gate.Evaluate();
        for (int i = 0; i < arena.Mazes.Length; i++)
        {
            bool isE = i == eIdx;
            var door = arena.Layout.Seats[i].Door;
            Check(isE ? AllOn(mazeLights[i]) : AllOff(mazeLights[i]),
                  $"deep E maze: maze {door} lights {(isE ? "visible" : "hidden")}");
            Check(isE ? AllOn(hallLights[i]) : AllOff(hallLights[i]),
                  $"deep E maze: hall {door} lights {(isE ? "visible" : "hidden")}");
        }
        Check(AllOn(arenaLights), "deep E maze: arena lights untouched/visible");
        Check(gate.CurrentSeat == eIdx, "deep E maze: CurrentSeat == E seat");

        // 4. No camera at all -> leave everything on.
        viewer = null;
        gate.Evaluate();
        Check(mazeLights.All(AllOn), "no viewer: every maze light visible");
        Check(hallLights.All(AllOn), "no viewer: every hallway light visible");
        Check(AllOn(arenaLights), "no viewer: arena lights still visible");

        GD.Print(_fail == 0 ? "ALL PASS" : $"{_fail} FAILED");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
