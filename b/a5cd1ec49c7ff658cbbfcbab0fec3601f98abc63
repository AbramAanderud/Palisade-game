using Godot;

/// test/TestStartExitProtect.cs
/// Start and Exit can never be deleted from the maze editor. Right-click and
/// room paint already refuse them; this pins the placement path: placing or
/// dropping another piece onto them must be refused, because PlacePiece /
/// DropPiece call RemovePiece on the target cell right after IsValidPlacement
/// passes. Headless-safe: IsValidPlacement(silent) only reads _maze.Pieces.
public partial class TestStartExitProtect : Node
{
    int _fail;
    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + label);
        if (!ok) _fail++;
    }

    public override void _Ready()
    {
        var ed = new MazeEditor3D();
        try
        {
            var start = new MazePiece { Type = PieceType.Start, X = 4, Y = 0, Floor = 0 };
            var exit  = new MazePiece { Type = PieceType.Exit,  X = 4, Y = 9, Floor = 0 };
            ed._maze.Pieces.Add(start);
            ed._maze.Pieces.Add(exit);
            // Real mazes have a hall off Start/Exit — without one, the "must
            // connect" rule refuses everything and hides the bug.
            ed._maze.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 4, Y = 1, Floor = 0 });
            ed._maze.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 4, Y = 8, Floor = 0 });

            // Every rotation — one whose openings don't face off the grid edge
            // must still be refused because Start/Exit is under it.
            foreach (var t in new[] { PieceType.Straight, PieceType.LHall, PieceType.THall,
                                      PieceType.Cross, PieceType.Room })
                for (int rot = 0; rot < 4; rot++)
                {
                    Check(!ed.IsValidPlacement(4, 0, t, rot, silent: true), $"{t} r{rot} cannot be placed onto Start");
                    Check(!ed.IsValidPlacement(4, 9, t, rot, silent: true), $"{t} r{rot} cannot be placed onto Exit");
                }
            Check(ed.IsValidPlacement(4, 2, PieceType.Straight, 0, silent: true),
                  "control: Straight extending the hall is still allowed");
        }
        finally { ed.Free(); }

        GD.Print(_fail == 0 ? "ALL PASS" : $"{_fail} FAILED");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
