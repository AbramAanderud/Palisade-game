using Godot;
using System;

/// res://scripts/MenuUI.cs
/// Shared chrome for the full-screen menu tabs (Play Game, Pre-Game Lobby,
/// Training Setup).
///
/// This exists because the "leave this screen" button had drifted to a
/// different corner on every tab — top-left in PlayGameScreen, bottom-right in
/// TrainingSetupScreen, bottom-centre in PreGameLobby. Routing all of them
/// through AddBackButton means a tab cannot pick its own placement or colour:
/// change it here and every tab moves together.
public static class MenuUI
{
    /// Inset from the screen corner. Matches the CornerPad already used by
    /// TitleScreen and TrainingSetupScreen for their anchored corner buttons.
    public const float CornerPad = 36f;
    public const float BackW     = 140f;
    public const float BackH     = 46f;

    // Red reads as "leave" against the white primary actions, and stays legible
    // on the black menu background.
    public static readonly Color BackColor        = new(0.85f, 0.16f, 0.16f);
    public static readonly Color BackHoverColor   = new(1.00f, 0.38f, 0.34f);
    public static readonly Color BackPressedColor = new(0.55f, 0.10f, 0.10f);

    /// Builds the standard red Back button and anchors it to the screen's
    /// top-left corner.
    ///
    /// Pass the SCREEN ROOT as `screen`, never a flow container — anchoring to
    /// the root is what pins the button to the same pixel on every tab no
    /// matter how that tab lays out its own content. Call it last so the button
    /// draws above the tab's background.
    public static Button AddBackButton(Control screen, FontFile? font, Action pressed)
    {
        var btn = new Button
        {
            Text              = "Back",
            Flat              = true,
            // Left-aligned so the text starts exactly at CornerPad; centring it
            // inside the 140px hit box would indent it by ~45px and the corner
            // inset would stop matching the other anchored buttons.
            Alignment         = HorizontalAlignment.Left,
            CustomMinimumSize = new Vector2(BackW, BackH),
        };
        if (font != null) btn.AddThemeFontOverride("font", font);
        btn.AddThemeFontSizeOverride("font_size", 24);
        btn.AddThemeColorOverride("font_color",         BackColor);
        btn.AddThemeColorOverride("font_hover_color",   BackHoverColor);
        btn.AddThemeColorOverride("font_pressed_color", BackPressedColor);
        btn.AddThemeColorOverride("font_focus_color",   BackColor);

        // Flat + empty styleboxes: same treatment as the TitleScreen /
        // TrainingSetupScreen menu buttons, so Back reads as menu text rather
        // than a default-themed chrome button.
        var empty = new StyleBoxEmpty();
        btn.AddThemeStyleboxOverride("normal",   empty);
        btn.AddThemeStyleboxOverride("hover",    empty);
        btn.AddThemeStyleboxOverride("pressed",  empty);
        btn.AddThemeStyleboxOverride("focus",    empty);
        btn.AddThemeStyleboxOverride("disabled", empty);

        btn.AnchorLeft     = 0f; btn.AnchorRight  = 0f;
        btn.AnchorTop      = 0f; btn.AnchorBottom = 0f;
        btn.GrowHorizontal = Control.GrowDirection.End;
        btn.GrowVertical   = Control.GrowDirection.End;
        btn.OffsetLeft     = CornerPad;
        btn.OffsetRight    = CornerPad + BackW;
        btn.OffsetTop      = CornerPad;
        btn.OffsetBottom   = CornerPad + BackH;

        btn.Pressed += pressed;
        screen.AddChild(btn);
        return btn;
    }
}
