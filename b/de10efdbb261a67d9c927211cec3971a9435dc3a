using System.Collections.Generic;
using System.Linq;
using System.Text.Json;
using Godot;

/// res://scenes/OnlineFfaArena.Rematch.cs — the FFA end-screen rematch vote.
///
/// Every remaining seat votes "same mazes" or "rotate" ({"t":"rematch_vote",
/// "mode":…}, changeable). Every client keeps the full vote map; the HOST, after
/// each vote or leave, runs FfaRematch.Decide over the remaining seats (live
/// roster seats, minus leavers and dropped seats). Once it decides, it
/// broadcasts {"t":"rematch_go","mode":…,"offset":…,"seats":[…]} and everyone
/// (itself included) prunes the roster to `seats`, takes the new rotation
/// offset and reloads this scene, which re-runs the first-match path (maze
/// exchange, host loadout roll that avoids the last starter, 3-2-1).
///
/// No relay change: the relay never re-seats a started party, so seat numbers
/// are never reused and a pending peer_left for a seat outside the new roster
/// is safe to discard. Anyone who doesn't want to play presses Exit (PartyLeave)
/// and drops out of the remaining set via peer_left. If the host leaves during
/// the vote, the new host re-evaluates with the votes it already holds.
public partial class OnlineFfaArena
{
    const double RematchReloadDelay = 0.4;

    readonly Dictionary<int, RematchMode> _rematchVotes = new();
    bool           _rematchOffered;    // the end screen shows the rematch section
    bool           _rematchStarting;   // rematch_go applied; the reload is pending
    HBoxContainer? _rematchRow;
    Button?        _rematchSameBtn;
    Button?        _rematchRotateBtn;
    Label?         _rematchStatus;

    // ── Test hooks (TEST-ONLY: read/driven by the FFA tests; not gameplay API) ──
    /// TEST-ONLY. The rematch buttons are shown and a vote can still change the outcome.
    public bool RematchAvailable =>
        _rematchOffered && !_rematchStarting && RematchRemaining.Count >= FfaRematch.MinPlayers;
    /// TEST-ONLY. Live tally over the remaining seats.
    public (int same, int rotate) RematchTally => FfaRematch.Tally(RematchRemaining, _rematchVotes);
    /// TEST-ONLY. rematch_go applied; the scene reload is pending.
    public bool RematchStarting => _rematchStarting;
    /// TEST-ONLY. The same handler as the two end-screen buttons.
    public void DebugVoteRematch(bool rotate) => OnLocalRematchVote(rotate ? RematchMode.Rotate : RematchMode.Same);

    /// Seats that can take part in a rematch: live roster seats not dropped, sorted.
    List<int> RematchRemaining => ActiveSeats.OrderBy(s => s).ToList();

    static string ModeName(RematchMode m) => m == RematchMode.Same ? "same" : "rotate";

    static RematchMode? ParseMode(JsonElement root) =>
        root.TryGetProperty("mode", out var mp) && mp.ValueKind == JsonValueKind.String
            ? mp.GetString() switch { "same" => RematchMode.Same, "rotate" => RematchMode.Rotate, _ => null }
            : null;

    // ── End-screen section ───────────────────────────────────────────────────

    /// Called by ShowEndOverlay (not for a cancelled match or a lost connection).
    void AddRematchSection(VBoxContainer vbox)
    {
        _rematchOffered = true;
        _rematchRow = new HBoxContainer { Alignment = BoxContainer.AlignmentMode.Center };
        _rematchRow.AddThemeConstantOverride("separation", 16);
        vbox.AddChild(_rematchRow);

        _rematchSameBtn = MakeButton("Rematch: same mazes", new Color(0.6f, 0.95f, 0.6f));
        _rematchSameBtn.CustomMinimumSize = new Vector2(230, 52);
        _rematchSameBtn.Pressed += () => OnLocalRematchVote(RematchMode.Same);
        _rematchRow.AddChild(_rematchSameBtn);

        _rematchRotateBtn = MakeButton("Rematch: rotate", new Color(0.6f, 0.85f, 1f));
        _rematchRotateBtn.CustomMinimumSize = new Vector2(230, 52);
        _rematchRotateBtn.Pressed += () => OnLocalRematchVote(RematchMode.Rotate);
        _rematchRow.AddChild(_rematchRotateBtn);

        _rematchStatus = MakeLabel("", 18, new Color(0.85f, 0.85f, 0.85f));
        _rematchStatus.AutowrapMode = TextServer.AutowrapMode.WordSmart;
        vbox.AddChild(_rematchStatus);

        RefreshRematchUi();
        HostTryDecideRematch();   // votes may have reached us before our end screen
    }

    void RefreshRematchUi()
    {
        if (!_rematchOffered || _rematchStarting || _rematchStatus == null) return;
        var remaining = RematchRemaining;
        if (remaining.Count < FfaRematch.MinPlayers)
        {
            if (_rematchRow != null) _rematchRow.Visible = false;
            _rematchStatus.Text = "Not enough players for a rematch";
            return;
        }
        var (same, rotate) = FfaRematch.Tally(remaining, _rematchVotes);
        var waiting = remaining.Where(s => !_rematchVotes.ContainsKey(s))
                               .Select(s => s == _mySeat ? "you" : NameOf(s)).ToList();
        _rematchStatus.Text = $"Same {same} · Rotate {rotate}" +
                              (waiting.Count > 0 ? $" · waiting for {string.Join(", ", waiting)}" : "");

        bool has = _rematchVotes.TryGetValue(_mySeat, out var mine);
        if (_rematchSameBtn != null)
            _rematchSameBtn.Modulate = !has || mine == RematchMode.Same ? Colors.White : new Color(1f, 1f, 1f, 0.5f);
        if (_rematchRotateBtn != null)
            _rematchRotateBtn.Modulate = !has || mine == RematchMode.Rotate ? Colors.White : new Color(1f, 1f, 1f, 0.5f);
    }

    // ── Votes ────────────────────────────────────────────────────────────────

    void OnLocalRematchVote(RematchMode mode)
    {
        if (!RematchAvailable || _leaving || !_nm.IsOpen) return;
        _rematchVotes[_mySeat] = mode;
        _nm.SendGameData($"{{\"t\":\"rematch_vote\",\"mode\":\"{ModeName(mode)}\"}}");
        GD.Print($"[FFA] Rematch vote: {ModeName(mode)}.");
        RefreshRematchUi();
        HostTryDecideRematch();
    }

    /// Kept from the end onward (while we still await the host's "end" too:
    /// a vote can beat our end screen); counted only while the sender is in
    /// the remaining set. Before the end it is a stale vote from the previous
    /// match reaching the reloaded scene, and is ignored.
    void OnRematchVoteMessage(JsonElement root, int from)
    {
        if (!EndingOrEnded || _rematchStarting || ParseMode(root) is not { } mode) return;
        if (!OnlineGameState.FfaRoster.Any(e => e.Seat == from)) return;
        _rematchVotes[from] = mode;
        GD.Print($"[FFA] Seat {from} voted rematch {ModeName(mode)}.");
        RefreshRematchUi();
        HostTryDecideRematch();
    }

    /// Core hook (OnSeatLeft, after the end): a leaver shrinks the remaining
    /// set; a new host re-evaluates with the votes it already holds.
    void OnRematchSeatLeft()
    {
        RefreshRematchUi();
        HostTryDecideRematch();
    }

    /// Host: decide once every remaining seat has voted; broadcast and apply.
    void HostTryDecideRematch()
    {
        if (!IsHost || !Ended || !_rematchOffered || _rematchStarting || _leaving) return;
        var remaining = RematchRemaining;
        if (FfaRematch.Decide(remaining, _rematchVotes, _mySeat) is not { } mode) return;
        int offset = FfaRematch.NextOffset(OnlineGameState.FfaRotationOffset, remaining.Count, mode);
        _nm.SendGameData(Inv($"{{\"t\":\"rematch_go\",\"mode\":\"{ModeName(mode)}\",\"offset\":{offset},\"seats\":[{InvJoin(remaining)}]}}"));
        GD.Print($"[FFA] Host: rematch {ModeName(mode)} — offset {offset}, seats [{string.Join(",", remaining)}].");
        ApplyRematchGo(mode, offset, remaining);
    }

    /// Non-host: the host's decision (OnMatchData already checked the sender is the host).
    void OnRematchGoMessage(JsonElement root, int from)
    {
        if (_rematchStarting || _leaving || !EndingOrEnded || ParseMode(root) is not { } mode) return;
        var seats = root.GetProperty("seats").EnumerateArray().Select(e => e.GetInt32())
                        .Where(s => OnlineGameState.FfaRoster.Any(r => r.Seat == s))
                        .Distinct().OrderBy(s => s).ToList();
        int offset = root.GetProperty("offset").GetInt32();
        if (seats.Count < FfaRematch.MinPlayers || !seats.Contains(_mySeat) || offset < 1 || offset >= seats.Count)
        {
            GD.PushWarning($"[FFA] Ignoring rematch_go from seat {from}: seats [{string.Join(",", seats)}], offset {offset}.");
            return;
        }
        GD.Print($"[FFA] rematch_go from host {from}: {ModeName(mode)}, offset {offset}, seats [{string.Join(",", seats)}].");
        ApplyRematchGo(mode, offset, seats);
    }

    /// Prune the roster, take the new offset, flag the rematch and reload this
    /// scene after 0.4 s. FfaSeat and FfaHostSeat are kept.
    void ApplyRematchGo(RematchMode mode, int offset, List<int> seats)
    {
        _rematchStarting = true;
        var bySeat = OnlineGameState.FfaRoster.ToDictionary(e => e.Seat);
        OnlineGameState.FfaRoster         = seats.Where(bySeat.ContainsKey).Select(s => bySeat[s]).ToList();
        OnlineGameState.FfaRotationOffset = offset;
        OnlineGameState.RematchPending    = true;

        if (_rematchSameBtn != null)   _rematchSameBtn.Disabled   = true;
        if (_rematchRotateBtn != null) _rematchRotateBtn.Disabled = true;
        if (_rematchStatus != null)
            _rematchStatus.Text = mode == RematchMode.Same ? "Rematch — same mazes!" : "Rematch — rotating mazes!";

        GetTree().CreateTimer(RematchReloadDelay).Timeout += () =>
        {
            if (!IsInstanceValid(this) || _leaving) return;
            // Every peer_left of this match is still queued (only _Ready drains
            // the list). Drop the ones for seats outside the new roster (seats
            // are never reused); keep any for a seat inside it — it left after
            // the host built `seats` (or during this delay), and the new scene
            // must replay that leave.
            var keep = new HashSet<int>(seats);
            _nm.PendingPeerLefts.RemoveAll(p => !keep.Contains(p.seat));
            GetTree().ChangeSceneToFile("res://scenes/OnlineFfaArena.tscn");
        };
    }
}
