using Godot;
using System.Linq;
using System.Collections.Generic;

/// test/TestOffendingCells.cs
/// MazeValidator.FindOffendingCells is the additive structured result behind
/// the editor's "glow red" highlight (owner: "when a piece has an issue can
/// you make it glow red... so its easier to see"). Pins that it reports the
/// SAME problems IsGameReady already reports (never invented, never silent)
/// for each category, and stays empty for a clean maze.
///
/// Teleport-orphan and stair-overlap pieces are still reported as themselves
/// (cases B/C). Unreachable pieces are NOT (owner follow-up: "dont highlight
/// all the unreachable pieces highlight the cell that could fix the
/// problem") — cases D/F/G cover the gap-cell / nearest-gap / mismatch-
/// boundary-fallback rules instead.
public partial class TestOffendingCells : Node
{
    int _fail;
    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + label);
        if (!ok) _fail++;
    }

    static MazeData BaseMaze()
    {
        var m = new MazeData { Name = "OffendingCellsTest", Pieces = new List<MazePiece>() };
        for (int y = 0; y <= 9; y++)
        {
            PieceType t = y == 0 ? PieceType.Start : y == 9 ? PieceType.Exit : PieceType.Straight;
            m.Pieces.Add(new MazePiece { Type = t, X = 4, Y = y, Floor = 0 });
        }
        return m;
    }

    public override void _Ready()
    {
        GD.Print("── MazeValidator.FindOffendingCells ──");

        // A) clean maze -> empty set, and IsGameReady agrees it's ready.
        {
            var maze = BaseMaze();
            var cells = MazeValidator.FindOffendingCells(maze);
            Check(cells.Count == 0, $"clean maze: no offending cells (has {cells.Count})");
            Check(MazeValidator.IsGameReady(maze, out _), "clean maze: IsGameReady agrees (true)");
        }

        // B) unpaired teleport pad -> that pad's cell is flagged, IsGameReady disagrees too.
        {
            var maze = BaseMaze();
            maze.Pieces.Add(new MazePiece { Type = PieceType.TrapPortal, X = 1, Y = 1, Floor = 0, LinkId = 1 });
            var cells = MazeValidator.FindOffendingCells(maze);
            Check(cells.Contains((1, 1, 0)), "orphan teleport pad (1,1,F0) is flagged");
            Check(!MazeValidator.IsGameReady(maze, out string err1), $"IsGameReady agrees it's not ready ({err1})");
        }

        // C) stair-vertical-overlap -> BOTH the stair and the piece it overlaps are flagged.
        {
            var maze = BaseMaze();
            maze.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 6, Y = 6, Floor = 1 });
            maze.Pieces.Add(new MazePiece { Type = PieceType.StairsUp, X = 6, Y = 6, Floor = 0, Rotation = 0 });
            var cells = MazeValidator.FindOffendingCells(maze);
            Check(cells.Contains((6, 6, 0)), "the StairsUp itself (6,6,F0) is flagged");
            Check(cells.Contains((6, 6, 1)), "the piece it overlaps (6,6,F1) is flagged too — highlight the PAIR");
            Check(!MazeValidator.IsGameReady(maze, out string err2), $"IsGameReady agrees it's not ready ({err2})");
        }

        // D) unreachable piece -> the GAP cells off its open faces are flagged,
        // NOT the piece itself (owner: "dont highlight all the unreachable
        // pieces highlight the cell that could fix the problem... highlight
        // the gap coming off of the unreachable part"). Both neighbours of
        // this isolated Straight are empty and tie on distance to the
        // reachable column (4 cells either way), so both gaps qualify.
        {
            var maze = BaseMaze();
            maze.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 8, Y = 8, Floor = 0 }); // orphan island
            var cells = MazeValidator.FindOffendingCells(maze);
            Check(!cells.Contains((8, 8, 0)), "the unreachable piece itself (8,8,F0) is NOT flagged");
            Check(cells.Contains((8, 7, 0)), "its N gap (8,7,F0) IS flagged — a piece placed there would connect it");
            Check(cells.Contains((8, 9, 0)), "its S gap (8,9,F0) IS flagged too — tied distance to the reachable column");
            Check(!cells.Contains((4, 0, 0)), "Start itself (reachable) is NOT flagged");
        }

        // F) walled-off component — every open face already has SOME piece
        // behind it, just one whose own opening doesn't point back (an
        // openings-mismatch boundary, not a real gap). Owner: "if EVERY open
        // face... points at an occupied cell... fall back to highlighting the
        // two boundary pieces whose faces don't line up." Blockers rotated to
        // open E|W so neither's opening faces back at (8,8,F0).
        {
            var maze = BaseMaze();
            maze.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 8, Y = 8, Floor = 0, Rotation = 0 });
            maze.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 8, Y = 7, Floor = 0, Rotation = 1 });
            maze.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 8, Y = 9, Floor = 0, Rotation = 1 });
            var cells = MazeValidator.FindOffendingCells(maze);
            Check(cells.Contains((8, 8, 0)), "no gap exists -> falls back to the boundary piece itself (8,8,F0)");
            Check(cells.Contains((8, 7, 0)), "...and its mismatched N neighbour (8,7,F0)");
            Check(cells.Contains((8, 9, 0)), "...and its mismatched S neighbour (8,9,F0)");
        }

        // G) when a component has gaps at DIFFERENT distances from the
        // reachable region, only the nearest is kept — "prefer gap cells
        // that... are nearest by grid distance to the reachable region: the
        // point is build here and it connects". (4,13,F0) is 4 cells from the
        // reachable column's end (4,9,F0); (4,15,F0) is 6 — the far one must
        // NOT be flagged.
        {
            var maze = BaseMaze();
            maze.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 4, Y = 14, Floor = 0 });
            var cells = MazeValidator.FindOffendingCells(maze);
            Check(!cells.Contains((4, 14, 0)), "the unreachable piece itself is NOT flagged");
            Check(cells.Contains((4, 13, 0)), "the NEARER gap (4,13,F0), 4 cells from the reachable column, IS flagged");
            Check(!cells.Contains((4, 15, 0)), "the FARTHER gap (4,15,F0), 6 cells away, is NOT flagged");
        }

        // E) missing Start entirely -> no piece-level cells to flag (maze-wide problem).
        {
            var maze = new MazeData { Name = "NoStart", Pieces = new List<MazePiece>
                { new MazePiece { Type = PieceType.Exit, X = 4, Y = 9, Floor = 0 } } };
            var cells = MazeValidator.FindOffendingCells(maze);
            Check(cells.Count == 0, "no Start piece: FindOffendingCells returns empty (nothing piece-level to point at)");
        }

        // H) Exit rotated to face backwards (rot 2 → its only opening points S, at the
        // arena wall / off the bottom row). The Exit ITSELF is the fix — flag it, and
        // do NOT flag the off-board "gap" beyond it (nothing can be built there).
        {
            var maze = BaseMaze();
            maze.Pieces.First(p => p.Type == PieceType.Exit).Rotation = 2;
            var cells = MazeValidator.FindOffendingCells(maze);
            Check(cells.Contains((4, 9, 0)), "backwards Exit (4,9,F0) is flagged itself");
            Check(!cells.Contains((4, 10, 0)), "the off-board cell behind it (4,10,F0) is NOT flagged");
            Check(!MazeValidator.IsGameReady(maze, out string errH) && errH.Contains("faces"),
                  $"IsGameReady rejects it with an Exit-specific reason ({errH})");
        }

        // I) Exit rotated sideways (rot 1, opens E) is still an ordinary unreachable
        // case — the buildable gap beside it is the fix, not the Exit.
        {
            var maze = BaseMaze();
            maze.Pieces.First(p => p.Type == PieceType.Exit).Rotation = 1;
            var cells = MazeValidator.FindOffendingCells(maze);
            Check(cells.Contains((5, 9, 0)) && !cells.Contains((4, 9, 0)),
                  "sideways Exit: its E gap (5,9,F0) is flagged, the Exit is not");
        }

        GD.Print(_fail == 0 ? "RESULT OK" : $"RESULT {_fail} FAILURE(S)");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
