using Godot;

/// res://scripts/TrapBehaviours.cs — Traps that need more than a bag of multipliers.
///
/// Darkness, Trapdoor, One-Way Gate and Teleport each carry a small behaviour node.
/// None of them deals damage: a trapdoor drops you a floor unhurt, a gate re-routes
/// you, a teleport sends you backwards. The cost is always the clock.
public static class TrapBehaviours
{
    const float CS = DungeonBuilder.CellSize;
    const float HW = DungeonBuilder.OpeningW * 0.5f;
    const float CH = DungeonBuilder.CellHeight;

    public static void Decorate(DungeonBuilder owner, StaticBody3D body,
                                MazePiece p, float yBase)
    {
        switch (p.Type)
        {
            case PieceType.TrapDark: AddDarkness(owner, p, yBase);         break;
            case PieceType.TrapDoor: AddTrapdoor(owner, body, p, yBase);   break;
            case PieceType.TrapGate: AddGate(owner, p, yBase);             break;
            case PieceType.TrapPortal: AddTeleport(owner, p, yBase);       break;
        }
    }

    // ── Darkness Zone ─────────────────────────────────────────────────────────
    // Torches are already suppressed for this cell at build time (DungeonBuilder.
    // AddTorches and PieceVariants.ApplyVariant both skip TrapDark cells — see
    // their guards). That alone is not the "dense fog" the design calls for: this
    // project renders with the GL Compatibility method (project.godot's
    // renderer/rendering_method="gl_compatibility"), and Godot's real volumetric
    // fog (FogVolume / Environment.volumetric_fog_enabled) is Forward+ only —
    // "Volumetric fog is only supported in the Forward+ rendering method, not
    // Mobile or Compatibility" (Environment.xml). A FogVolume node here would
    // compile and run but render nothing, so the cell would just read as
    // "unlit" rather than "actively hard to see" — and light can still spill in
    // from a neighbouring lit cell through the open N/S connections, since
    // there's no fog to scatter/obscure it.
    //
    // Substitute that actually works under Compatibility: several unshaded,
    // alpha-blended "curtain" quads spanning the corridor cross-section, spaced
    // through the cell's depth. A first attempt used one hollow box shell —
    // wrong, because a shell only tints a view that CROSSES one of its faces.
    // A camera standing INSIDE a hollow box (which is exactly where the player
    // is once they walk into this cell) sees its own immediate surroundings
    // completely unobscured, since there's nothing between it and nearby
    // geometry within the shell — confirmed by capture, where the far end of
    // the corridor stayed fully visible from inside the cell. Stacking several
    // curtains guarantees any forward- or backward-looking ray, from anywhere
    // in the cell, crosses multiple of them before it can reach a neighbouring
    // lit cell, building up occlusion with distance the way real fog does
    // (alpha compounds: three crossed layers near ~0.8 alpha already blocks
    // over 99% of what's behind them). No collision: this must never change
    // how the cell walks, only how it looks — same rule TrapBuilder's
    // AddFloorOverlay/AddWallSheen follow for the other trap types.
    const int DarkCurtains = 6;

    static void AddDarkness(DungeonBuilder owner, MazePiece p, float yBase)
    {
        float x0 = p.X * CS, z0 = p.Y * CS;
        float cx = x0 + CS * 0.5f;
        float y0 = yBase + 0.1f, y1 = yBase + CH * 0.92f;

        var st = DungeonBuilder.MakeST();
        for (int i = 0; i < DarkCurtains; i++)
        {
            // Offset by half a step so no curtain sits flush on the cell's own
            // N/S boundary (that would read as a hard wall right at the
            // threshold instead of a gradient you walk into).
            float z = z0 + CS * (i + 0.5f) / DarkCurtains;
            DungeonBuilder.Quad(st,
                new(cx - HW, y0, z), new(cx + HW, y0, z),
                new(cx + HW, y1, z), new(cx - HW, y1, z));
        }
        var mesh = DungeonBuilder.Commit(st);
        if (mesh == null) return;

        owner.AddChild(new MeshInstance3D
        {
            Name = $"TrapDarkFog_{p.X}_{p.Y}_{p.Floor}",
            Mesh = mesh,
            MaterialOverride = new StandardMaterial3D
            {
                AlbedoColor  = new Color(0.02f, 0.01f, 0.04f, 0.78f),
                Transparency = BaseMaterial3D.TransparencyEnum.Alpha,
                ShadingMode  = BaseMaterial3D.ShadingModeEnum.Unshaded,
                CullMode     = BaseMaterial3D.CullModeEnum.Disabled,
            },
        });
    }

    // ── Trapdoor ──────────────────────────────────────────────────────────────
    static void AddTrapdoor(DungeonBuilder owner, StaticBody3D body,
                            MazePiece p, float yBase)
    {
        // A trapdoor drops the player exactly one floor down — TrapdoorNode
        // only hides/disables THIS cell's own floor and lets gravity do the
        // rest, it never checks that a floor exists to land on. At the
        // world's bottom floor (DungeonBuilder.FloorMin) there is no floor
        // below: the player would fall into open space with nothing to catch
        // them (PlayerController has no automatic out-of-world recovery —
        // only a manual "hold R to return to maze start"). MazeEditor3D.
        // PlacePiece now refuses to place a NEW TrapDoor at the bottom floor
        // for the same reason (matching its existing StairsDown-at-bottom
        // guard) — this is the runtime backstop for a maze that was authored
        // or saved before that rule existed: leave the floor solid instead of
        // building a hole to nowhere.
        if (p.Floor <= DungeonBuilder.FloorMin) return;

        // The hatch is its own StaticBody so its collision can be switched off
        // independently of the corridor around it.
        float cx = p.X * CS + CS * 0.5f;
        float cz = p.Y * CS + CS * 0.5f;

        // Footprint must match the ACTUAL floor mesh this replaces, not just the
        // cell's center square. A trap piece (N|S openings only) has its floor
        // built by DungeonBuilder.AddPiece as one merged mesh: the HWxHW center
        // square PLUS the N and S arm strips — together a straight HW*2 (wide) x
        // CS (deep) slab spanning the cell's FULL depth, not just its middle
        // third. A HW*2 x HW*2 hatch hides that whole mesh (it's all one
        // MeshInstance3D, hidden as a unit) but only covers its center square,
        // leaving two ~2 m strips fore and aft with no floor at all — confirmed
        // by capture as a black void band ahead of/behind the hatch. Sizing on
        // CS instead of HW*2 for the Z extent makes the hatch exactly what the
        // comment below claims it is: a full replacement, not a patch.
        var hatch = new StaticBody3D
        {
            Name     = $"TrapdoorHatch_{p.X}_{p.Y}_{p.Floor}",
            Position = new Vector3(cx, yBase + 0.06f, cz),
        };
        hatch.AddChild(new CollisionShape3D
        {
            Shape = new BoxShape3D { Size = new Vector3(HW * 2f, 0.12f, CS) },
        });
        hatch.AddChild(new MeshInstance3D
        {
            Mesh = new BoxMesh { Size = new Vector3(HW * 2f, 0.12f, CS) },
            MaterialOverride = new StandardMaterial3D
            {
                // Matches the surrounding stone in game — the trap only reads in the
                // editor. Being invisible in play is the whole point of a trapdoor.
                AlbedoColor = new Color(0.42f, 0.40f, 0.37f),
                Roughness   = 0.9f,
            },
        });
        owner.AddChild(hatch);

        // The hatch REPLACES this cell's corridor floor entirely — both its collision
        // AND its mesh. Disabling only the collision would leave a visible floor the
        // player falls straight through, which reads as a rendering bug rather than a
        // trap. DungeonBuilder.AddMesh names the mesh "Floor_X_Y" and its shape
        // "Floor_X_YCol", so a "Floor" prefix match catches both.
        foreach (var child in body.GetChildren())
        {
            string n = child.Name.ToString();
            if (!n.StartsWith("Floor")) continue;
            if (child is CollisionShape3D cs) cs.Disabled = true;
            if (child is MeshInstance3D mi)   mi.Visible  = false;
        }

        // Trigger spans the same full footprint so stepping anywhere on the hatch
        // — not just its center third — starts the drop.
        var trigger = new TrapdoorNode
        {
            Name     = $"TrapdoorTrigger_{p.X}_{p.Y}_{p.Floor}",
            Hatch    = hatch,
            Position = new Vector3(cx, yBase + 1.0f, cz),
        };
        trigger.AddChild(new CollisionShape3D
        {
            Shape = new BoxShape3D { Size = new Vector3(HW * 2f, 2.0f, CS) },
        });
        owner.AddChild(trigger);
    }

    // ── One-Way Gate ──────────────────────────────────────────────────────────
    // A portcullis that is open until you pass through it in the legal direction,
    // then drops and stays down. A wrong turn past a gate costs a full loop back
    // around the maze — which is the entire point.
    static void AddGate(DungeonBuilder owner, MazePiece p, float yBase)
    {
        float cx = p.X * CS + CS * 0.5f;
        float cz = p.Y * CS + CS * 0.5f;
        Vector3 facing = TrapBuilder.FacingVector(p);

        // The bars sit across the corridor, perpendicular to the facing direction.
        bool acrossX = Mathf.Abs(facing.Z) > 0.5f;
        var barSize = acrossX
            ? new Vector3(HW * 2f, CH * 0.92f, 0.35f)
            : new Vector3(0.35f, CH * 0.92f, HW * 2f);

        var bars = new StaticBody3D
        {
            Name     = $"GateBars_{p.X}_{p.Y}_{p.Floor}",
            Position = new Vector3(cx, yBase + CH * 0.46f, cz),
        };
        bars.AddChild(new CollisionShape3D { Shape = new BoxShape3D { Size = barSize } });
        bars.AddChild(new MeshInstance3D
        {
            Mesh = new BoxMesh { Size = barSize },
            MaterialOverride = new StandardMaterial3D
            {
                AlbedoColor = PieceDB.Colors[PieceType.TrapGate],
                Metallic    = 0.8f,
                Roughness   = 0.35f,
            },
        });
        bars.Visible = false;
        foreach (var child in bars.GetChildren())
            if (child is CollisionShape3D cs) cs.Disabled = true;
        owner.AddChild(bars);

        var trigger = new OneWayGateNode
        {
            Name     = $"GateTrigger_{p.X}_{p.Y}_{p.Floor}",
            Bars     = bars,
            Facing   = facing,
            Position = new Vector3(cx, yBase + CH * 0.45f, cz),
        };
        trigger.AddChild(new CollisionShape3D
        {
            Shape = new BoxShape3D { Size = new Vector3(CS, CH * 0.9f, CS) },
        });
        owner.AddChild(trigger);
    }

    // ── Teleport Pad ──────────────────────────────────────────────────────────
    // Steps you back to the pad's partner. The single biggest time-waster available,
    // which is why it is also the most expensive piece in the trap set.
    static void AddTeleport(DungeonBuilder owner, MazePiece p, float yBase)
    {
        float cx = p.X * CS + CS * 0.5f;
        float cz = p.Y * CS + CS * 0.5f;

        var pad = new TeleportPadNode
        {
            Name     = $"TeleportPad_{p.X}_{p.Y}_{p.Floor}",
            LinkId   = p.LinkId,
            Position = new Vector3(cx, yBase + 0.9f, cz),
        };
        pad.AddChild(new CollisionShape3D
        {
            Shape = new BoxShape3D { Size = new Vector3(HW * 1.6f, 1.8f, HW * 1.6f) },
        });
        pad.AddChild(new MeshInstance3D
        {
            Position = new Vector3(0f, -0.85f, 0f),
            Mesh     = new CylinderMesh
            {
                TopRadius = HW * 0.8f, BottomRadius = HW * 0.8f, Height = 0.1f,
            },
            MaterialOverride = new StandardMaterial3D
            {
                AlbedoColor              = PieceDB.Colors[PieceType.TrapPortal],
                EmissionEnabled          = true,
                Emission                 = PieceDB.Colors[PieceType.TrapPortal],
                EmissionEnergyMultiplier = 1.6f,
            },
        });
        owner.AddChild(pad);
    }
}

/// Opens a trapdoor hatch a beat after the player steps on it, then re-arms.
/// The delay is what sells the "it looked solid" moment; without it the floor
/// vanishes before the player has committed and they just stop at the edge.
public sealed partial class TrapdoorNode : Area3D
{
    public StaticBody3D? Hatch;

    bool  _triggered = false;
    float _timer     = 0f;

    // Test-only observation hooks (see test/TestTrapdoor.cs, which drives
    // _PhysicsProcess with synthetic deltas). Internal rather than public:
    // nothing outside this assembly needs to read a trapdoor's timing state.
    internal bool  DebugTriggered => _triggered;
    internal float DebugTimer     => _timer;

    public override void _Ready()
    {
        Monitoring  = true;
        BodyEntered += OnBodyEntered;
    }

    // Internal (not private) so the headless test can call this directly with a
    // synthetic body, exercising the exact same gate the real Area3D signal
    // uses, without needing a live physics frame or a fully-initialized player.
    internal void OnBodyEntered(Node3D body)
    {
        if (_triggered || body is not PlayerController) return;
        _triggered = true;
        _timer     = 0f;
    }

    public override void _PhysicsProcess(double delta)
    {
        if (!_triggered || Hatch == null || !IsInstanceValid(Hatch)) return;

        _timer += (float)delta;

        if (_timer >= TrapDB.TrapdoorDelay && Hatch.Visible)
        {
            // Drop the floor out. Hidden AND collision-disabled so nothing catches
            // the player on the way down.
            Hatch.Visible = false;
            foreach (var child in Hatch.GetChildren())
                if (child is CollisionShape3D cs) cs.Disabled = true;
        }

        if (_timer >= TrapDB.TrapdoorRearm)
        {
            Hatch.Visible = true;
            foreach (var child in Hatch.GetChildren())
                if (child is CollisionShape3D cs) cs.Disabled = false;
            _triggered = false;
            _timer     = 0f;
        }
    }
}

/// Drops a portcullis once the player has passed through in the legal direction.
public sealed partial class OneWayGateNode : Area3D
{
    public StaticBody3D? Bars;
    /// World-space unit vector of the direction the player is allowed to travel.
    public Vector3 Facing = Vector3.Forward;

    bool _armed = false;
    bool _shut  = false;

    // Test-only observation hooks (see test/TestTraps.cs, which drives OnEnter/
    // OnExit directly with a synthetic PlayerController and synthetic velocity).
    // Internal rather than public: nothing outside this assembly needs to read a
    // gate's arm/shut state.
    internal bool DebugArmed => _armed;
    internal bool DebugShut  => _shut;

    public override void _Ready()
    {
        Monitoring  = true;
        BodyEntered += OnEnter;
        BodyExited  += OnExit;
    }

    // Internal (not private) so the headless test can call these directly with a
    // synthetic body, exercising the exact same logic the real Area3D signals
    // use, without needing a live physics frame or a fully-initialized player.
    internal void OnEnter(Node3D body)
    {
        if (_shut || body is not PlayerController p) return;
        // Only arm when the player is actually travelling the legal way. Entering
        // against the facing leaves the gate open so they can back out freely.
        var vel = new Vector3(p.Velocity.X, 0f, p.Velocity.Z);
        if (vel.LengthSquared() > 0.01f && vel.Normalized().Dot(Facing) > 0.35f)
            _armed = true;
    }

    internal void OnExit(Node3D body)
    {
        if (_shut || !_armed || Bars == null || !IsInstanceValid(Bars)) return;
        if (body is not PlayerController) return;

        // They committed and left through the far side — shut it behind them.
        _shut = true;
        Bars.Visible = true;
        foreach (var child in Bars.GetChildren())
            if (child is CollisionShape3D cs) cs.Disabled = false;
    }
}

/// Sends the player to this pad's partner. Both ends share a non-zero LinkId.
public sealed partial class TeleportPadNode : Area3D
{
    public int LinkId;

    // Every live pad, so a pad can find its partner by LinkId without a
    // per-piece wiring pass at build time. A pad removes itself in _ExitTree —
    // see that override for why that matters when a dungeon gets rebuilt.
    static readonly System.Collections.Generic.List<TeleportPadNode> All = new();

    float _cooldown = 0f;

    // Test-only observation hook (see test/TestTraps.cs).
    internal float DebugCooldown => _cooldown;

    public override void _Ready()
    {
        Monitoring  = true;
        BodyEntered += OnEnter;
        All.Add(this);
    }

    // MazeEditor3D/DungeonBuilder rebuild geometry by freeing the old cell
    // nodes and building new ones (e.g. RebuildGeometry, or loading a
    // different slot/floor). All is a STATIC list — it outlives any one
    // dungeon build — so if a freed pad never removed itself, a later pad
    // sharing its LinkId (a rebuilt maze reusing the same numbering, or two
    // mazes loaded across a scene change) could resolve its "partner" to a
    // node whose scene resources are already gone. Removing self here on
    // every exit — whether from Free(), QueueFree(), or a normal tree
    // removal — keeps All limited to pads that are actually live.
    public override void _ExitTree() => All.Remove(this);

    public override void _PhysicsProcess(double delta)
    {
        if (_cooldown > 0f) _cooldown -= (float)delta;
    }

    // Internal (not private) so the headless test can drive pairing and
    // cooldown directly with synthetic pads and a synthetic player, without a
    // running physics frame or a live Area3D signal.
    internal void OnEnter(Node3D body)
    {
        if (LinkId == 0 || _cooldown > 0f) return;
        if (body is not PlayerController player) return;

        TeleportPadNode? partner = null;
        foreach (var pad in All)
            if (pad != this && pad.LinkId == LinkId) { partner = pad; break; }
        if (partner == null) return;

        // Cool BOTH ends down, or the arrival pad fires immediately and ping-pongs
        // the player between the two.
        _cooldown         = TrapDB.TeleportCooldown;
        partner._cooldown = TrapDB.TeleportCooldown;

        player.GlobalPosition = partner.GlobalPosition;
        // Kill horizontal momentum so the player does not arrive sprinting into a wall.
        player.Velocity = new Vector3(0f, player.Velocity.Y, 0f);
    }
}
