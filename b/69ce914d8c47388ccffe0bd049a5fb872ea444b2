using Godot;
using System.Collections.Generic;

/// Repro for "clipped into the bookshelves by wall-running into their side from
/// a doorway". Builds the real ArenaBuilder arena plus two stand-in corridor
/// walls at x = +-OpeningW/2 outside the north doorway (the maze corridor that
/// feeds it in-game), then for several scenarios spawns a REAL PlayerController
/// airborne in the corridor, forces a wall-run along the corridor's east wall
/// heading into the arena, holds move input, and tracks whether the capsule
/// centre ever ends up BEHIND the tier-0 shelf collision face — i.e. in the
/// radial band between the shelf front (rFront) and the arena wall, outside the
/// open doorway bay. That band is solid bookshelf visually; being in it is the bug.
///
/// PASS = no scenario ever puts the capsule centre inside that band.
public partial class TestShelfWallRun : Node3D
{
    const float RunSeconds = 1.5f;
    static readonly float RFront = ArenaBuilder.Apothem - 0.55f - 0.06f;   // mirrors AddShelfCollision
    static readonly float DoorHalfAngle = Mathf.Pi / 32f;                  // bay 0 spans +-FaceHalf

    record Scenario(string Name, float X, float Y, float Speed, string[] Actions, float YawOffsetDeg) { public float SlotZ { get; init; } }

    readonly List<Scenario> _scenarios = new();

    int   _idx = -1;
    float _t;
    PlayerController? _player;
    float _worst;          // deepest radial intrusion behind the shelf face (m)
    bool  _everRan;
    int   _fails;
    readonly List<string> _pressed = new();

    public override void _Ready()
    {
        AddChild(new WorldEnvironment { Environment = new Godot.Environment() });
        var arena = new ArenaBuilder { Name = "Arena" };
        AddChild(arena);
        arena.Build(Vector3.Zero, openNorth: true, openSouth: true);

        // Stand-in corridor: solid 0.5m walls whose inner faces sit at x=+-3.
        float hw = DungeonBuilder.OpeningW * 0.5f;
        var corr = new StaticBody3D { Name = "Corridor" };
        foreach (float sx in new[] { -1f, 1f })
            corr.AddChild(new CollisionShape3D
            {
                Shape = new BoxShape3D { Size = new Vector3(0.5f, 20f, 20f) },
                Position = new Vector3(sx * (hw + 0.25f), 10f, -ArenaBuilder.Apothem - 10f),
            });
        AddChild(corr);

        foreach (float x in new[] { 2.64f, 2.60f, 2.50f })
        foreach (float y in new[] { 2.9f, 4.0f })
        {
            _scenarios.Add(new($"x={x} y={y} fwd",            x, y, 15f, new[] { "move_forward" }, 0f));
            _scenarios.Add(new($"x={x} y={y} fwd+into",       x, y, 15f, new[] { "move_forward", "move_left" }, 0f));
            _scenarios.Add(new($"x={x} y={y} fwd look20 in",  x, y, 15f, new[] { "move_forward" }, 20f));
            _scenarios.Add(new($"x={x} y={y} fwd+into look45",x, y, 15f, new[] { "move_forward", "move_left" }, 45f));
            _scenarios.Add(new($"x={x} y={y} fast25 +into",   x, y, 25f, new[] { "move_forward", "move_left" }, 10f));
        }
        // Direct slot probe: from inside the open doorway bay, fly sideways (+X)
        // straight at the shelf ring's uncapped end, at several radii behind the
        // shelf front. No forced wall-run — TryStartWallRun may still kick in.
        foreach (float zc in new[] { -29.35f, -29.5f, -29.65f })
        foreach (float y in new[] { 2.9f, 4.0f })
        foreach (float spd in new[] { 10f, 25f })
            _scenarios.Add(new($"SLOT z={zc} y={y} v={spd}", 1.2f, y, spd, new[] { "move_left" }, 0f) { SlotZ = zc });
        NextScenario();
    }

    void NextScenario()
    {
        ReleaseAll();
        if (_idx >= 0)
        {
            bool pass = _worst <= 0.02f;
            if (!pass) _fails++;
            GD.Print($"[TestShelfWallRun] {_scenarios[_idx].Name}: intrusion={_worst:F3} wallRan={_everRan} end={_player?.GlobalPosition} {(pass ? "PASS" : "FAIL")}");
        }
        _player?.QueueFree();
        _player = null;
        _idx++;
        if (_idx >= _scenarios.Count)
        {
            GD.Print($"[TestShelfWallRun] RESULT {(_fails == 0 ? "PASS" : "FAIL")} ({_fails}/{_scenarios.Count} failing)");
            GetTree().Quit(_fails == 0 ? 0 : 1);
            return;
        }
        var s = _scenarios[_idx];
        // Facing +Z (into the arena from the north corridor): forward = (-sin, 0, -cos) → yaw = pi.
        // Positive offset turns toward the east (+X) wall. At yaw=pi, right = -X, so
        // "move_left" is the strafe INTO the east wall.
        float yaw = Mathf.Pi + Mathf.DegToRad(s.YawOffsetDeg);
        if (s.SlotZ != 0f)
        {
            _player = PlayerController.Spawn(this, new Vector3(s.X, s.Y, s.SlotZ), Mathf.RadToDeg(yaw));
            _player.Velocity = new Vector3(s.Speed, 0, 0);
        }
        else
        {
            _player = PlayerController.Spawn(this, new Vector3(s.X, s.Y, -ArenaBuilder.Apothem - 3f), Mathf.RadToDeg(yaw));
            _player.Velocity = new Vector3(0, 0, s.Speed);
            _player.DebugForceWallRun(Vector3.Left);   // east corridor wall faces -X
        }
        foreach (var a in s.Actions) { Input.ActionPress(a); _pressed.Add(a); }
        _t = 0; _worst = 0; _everRan = false;
    }

    void ReleaseAll() { foreach (var a in _pressed) Input.ActionRelease(a); _pressed.Clear(); }

    public override void _PhysicsProcess(double delta)
    {
        if (_player == null) return;
        _t += (float)delta;
        if (_player.DebugIsWallRunning) _everRan = true;

        var p = _player.GlobalPosition;
        float r = new Vector2(p.X, p.Z).Length();
        float ang = Mathf.Atan2(p.X, -p.Z);   // 0 = north doorway centre
        bool pastDoorBay = Mathf.Abs(ang) > DoorHalfAngle;
        bool inShelfHeight = p.Y - 0.8f < ArenaBuilder.ShelfBandH;
        if (pastDoorBay && inShelfHeight && r > RFront && r < ArenaBuilder.Radius)
        {
            float intr = r - RFront;
            if (intr > _worst)
            {
                if (_worst <= 0.02f && intr > 0.02f)
                    GD.Print($"[TestShelfWallRun]   t={_t:F3} pos={p} r={r:F3} ang={ang:F3} vel={_player.Velocity} wallRun={_player.DebugIsWallRunning}");
                _worst = intr;
            }
        }
        if (_t >= RunSeconds) NextScenario();
    }
}
