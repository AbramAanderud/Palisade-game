using Godot;

/// test/TestMazePick.cs
/// Online maze picker: the built-in default maze must always be its own
/// selectable entry, and the chosen maze must persist per account across
/// sessions (falling back to the default when that maze is gone).
///
/// RUN ONLY WITH A THROWAWAY ACCOUNT — it writes and deletes maze slots:
///   ..._console.exe --path . --headless res://test/TestMazePick.tscn --account __test_mazepick
///
/// Populate() mirrors PlayGameScreen.PopulateMazeDropdown (the picker lives in
/// a scene that needs a live NetworkManager, so it can't be instantiated here).
public partial class TestMazePick : Node
{
    const string TestAccount = "__test_mazepick";
    int _fail;

    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + label);
        if (!ok) _fail++;
    }

    public override void _Ready()
    {
        if (AccountManager.ActiveAccount != TestAccount)
        {
            GD.PushError($"Refusing to run: pass --account {TestAccount}");
            GetTree().Quit(2);
            return;
        }
        ClearAccount();

        GD.Print("── Godot OptionButton id semantics ──");
        var probe = new OptionButton();
        AddChild(probe);
        probe.AddItem("a", DefaultMaze.SentinelSlot);
        probe.AddItem("b", 0);
        Check(probe.GetItemId(0) == DefaultMaze.SentinelSlot,
              $"default entry keeps its sentinel id (got {probe.GetItemId(0)})");
        Check(probe.GetItemId(0) != probe.GetItemId(1), "default entry id never collides with slot 0");
        probe.QueueFree();

        GD.Print("── Fresh profile ──");
        NewSession();
        Check(OnlineGameState.SelectedMazeSlot == DefaultMaze.SentinelSlot, "fresh profile selects the default");
        var dd = Populate();
        Check(dd.GetSelectedId() == DefaultMaze.SentinelSlot, "picker shows the default selected");
        Check(dd.ItemCount == 1, "only the default is listed");
        dd.QueueFree();

        GD.Print("── Old-format profile + one custom map ──");
        WriteRaw(AccountManager.ProfilePath(), "{\"name\":\"OldTimer\",\"gold\":1234}");
        SaveMaze(0, "Mine");
        NewSession();
        Check(OnlineGameState.PlayerName == "OldTimer" && OnlineGameState.Gold == 1234,
              "old profile.json still loads name + gold");
        dd = Populate();
        Check(dd.ItemCount == 2, $"default + 1 custom listed (got {dd.ItemCount})");
        Check(dd.GetSelectedId() == DefaultMaze.SentinelSlot, "no saved pick → default selected, not slot 0");
        Check(dd.GetItemText(dd.Selected) == DefaultMaze.DisplayName, "selected label is the default");
        dd.QueueFree();

        GD.Print("── Several maps, pick persists across sessions ──");
        SaveMaze(2, "Two");
        SaveMaze(3, "Three");
        NewSession();
        dd = Populate();
        Check(dd.ItemCount == 4, $"default + 3 custom listed (got {dd.ItemCount})");
        OnlineGameState.SelectedMazeSlot = 2;         // player picks "Two" …
        PlayerProfile.Save();                         // … screen exit / match end saves
        NewSession();
        Check(OnlineGameState.SelectedMazeSlot == 2, $"slot 2 restored (got {OnlineGameState.SelectedMazeSlot})");
        dd.QueueFree();
        dd = Populate();
        Check(dd.GetSelectedId() == 2, "picker reselects slot 2");
        dd.QueueFree();

        OnlineGameState.SelectedMazeSlot = DefaultMaze.SentinelSlot;   // back to default
        PlayerProfile.Save();
        NewSession();
        Check(OnlineGameState.SelectedMazeSlot == DefaultMaze.SentinelSlot, "choosing default also persists");

        GD.Print("── Last-used map deleted ──");
        OnlineGameState.SelectedMazeSlot = 3;
        PlayerProfile.Save();
        DirAccess.RemoveAbsolute(ProjectSettings.GlobalizePath(AccountManager.MazeSlotPath(3)));
        NewSession();
        dd = Populate();
        Check(dd.GetSelectedId() == DefaultMaze.SentinelSlot, "deleted last-used → default selected");
        Check(OnlineGameState.SelectedMazeSlot == DefaultMaze.SentinelSlot, "state falls back to default too");
        dd.QueueFree();

        ClearAccount();
        GD.Print(_fail == 0 ? "ALL PASS" : $"{_fail} FAILED");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }

    /// Title → Play: Reset(), then PlayGameScreen._Ready's PlayerProfile.Load().
    static void NewSession()
    {
        OnlineGameState.Reset();
        PlayerProfile.Load();
    }

    OptionButton Populate()
    {
        var dd = new OptionButton();
        AddChild(dd);
        dd.AddItem(DefaultMaze.DisplayName, DefaultMaze.SentinelSlot);
        for (int i = 0; i < MazeSerializer.SlotCount; i++)
        {
            if (!MazeSerializer.Exists(i)) continue;
            var data = MazeSerializer.Load(i);
            if (data == null || !data.IsOnline) continue;
            if (!data.IsGameReady) continue;
            dd.AddItem($"Slot {i}: {data.Name ?? "Untitled"}", i);
        }
        for (int i = 0; i < dd.ItemCount; i++)
        {
            if (dd.GetItemId(i) == OnlineGameState.SelectedMazeSlot)
            {
                dd.Select(i);
                return dd;
            }
        }
        dd.Select(0);
        OnlineGameState.SelectedMazeSlot = dd.GetItemId(0);
        return dd;
    }

    static void SaveMaze(int slot, string name)
    {
        var m = DefaultMaze.Build();
        m.Name = name;
        MazeSerializer.Save(slot, m);
    }

    static void WriteRaw(string path, string text)
    {
        using var f = FileAccess.Open(path, FileAccess.ModeFlags.Write);
        f?.StoreString(text);
    }

    static void ClearAccount()
    {
        for (int i = 0; i < MazeSerializer.SlotCount; i++)
            DirAccess.RemoveAbsolute(ProjectSettings.GlobalizePath(AccountManager.MazeSlotPath(i)));
        DirAccess.RemoveAbsolute(ProjectSettings.GlobalizePath(AccountManager.ProfilePath()));
    }
}
