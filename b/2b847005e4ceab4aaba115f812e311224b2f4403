using Godot;

/// res://test/TestTask.cs — per-task harness (overwritten each task).
/// ─────────────────────────────────────────────────────────────────────────────
/// Reproduces (and verifies the fix for) the "phantom jog after a wall jump"
/// bug: FP arms getting stuck on whatever clip was playing (WallRun's own
/// "sprint" pump) when the player launches off a wall into Jump/Fall.
///
/// Unlike the reticle-facing task's harness, this one needs REAL state
/// transitions (wall-run -> wall-jump -> airborne -> fire -> land), so the
/// player is spawned UNFROZEN and driven by its own real _PhysicsProcess.
/// `PlayerController.DebugForceWallRun` seeds a real wall-run deterministically
/// (skipping the organic "run fast enough into a wall while airborne" trigger
/// timing) and a single simulated "jump" keypress performs a REAL wall-jump —
/// same code path as live play, just deterministically timed. Films through the
/// player's own FP camera (creates no camera of its own), same as TestScope.cs.
/// ─────────────────────────────────────────────────────────────────────────────
public partial class TestTask : Node3D
{
    PlayerController? _player;
    Label? _label;
    float _t = 0f;
    string _phase = "";
    bool _everAirborne = false;
    bool _everLandedAfterAirborne = false;

    public override void _Ready()
    {
        BuildRoom();

        var cl = new CanvasLayer();
        AddChild(cl);
        cl.AddChild(new ReticleOverlay());
        _label = new Label { Position = new Vector2(24, 24) };
        _label.AddThemeFontSizeOverride("font_size", 24);
        _label.AddThemeColorOverride("font_color", Colors.Yellow);
        _label.AddThemeColorOverride("font_outline_color", Colors.Black);
        _label.AddThemeConstantOverride("outline_size", 6);
        cl.AddChild(_label);

        // Wall's near face sits at X=3 (box centered at X=4, half-thickness 1),
        // running the length of the flight path along Z. Player starts hugging
        // it (0.05 m clearance — well inside HasWallContact's 0.5 m probe),
        // already airborne (Y=5, floor top at Y=0) so BeginWallRun's caller
        // contract is met without needing an organic run-up.
        _player = PlayerController.Spawn(this, new Vector3(2.6f, 5f, 14f), 0f);
        _player.EquipStarterGun("mac10");
        // Parallel to the wall (no X component) so WallRunTick's own along-wall
        // projection doesn't zero it out on the first tick.
        _player.Velocity = new Vector3(0f, 0f, -10f);
        _player.DebugForceWallRun(new Vector3(-1f, 0f, 0f));   // normal points into the room
    }

    void BuildRoom()
    {
        var env = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0.35f, 0.45f, 0.60f),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(1f, 1f, 1f),
            AmbientLightEnergy = 0.9f,
        };
        AddChild(new WorldEnvironment { Environment = env });
        var sun = new DirectionalLight3D { LightEnergy = 2.0f };
        sun.RotationDegrees = new Vector3(-45f, 30f, 0f);
        AddChild(sun);

        AddBox(new Vector3(0f, -0.5f, -20f), new Vector3(60f, 1f, 160f),
               new Color(0.30f, 0.32f, 0.30f));                                  // floor
        AddBox(new Vector3(4f, 6f, 0f), new Vector3(2f, 14f, 80f),
               new Color(0.55f, 0.45f, 0.35f));                                  // the wall
        // Distant markers down the flight path so travel/pitch reads on camera.
        for (int i = 1; i <= 5; i++)
        {
            float z = 14f - i * 10f;
            AddBox(new Vector3(-4f, 1.5f, z), new Vector3(0.6f, 4f, 0.6f),
                   (i % 2 == 0) ? new Color(0.85f, 0.35f, 0.25f) : new Color(0.90f, 0.85f, 0.55f));
        }
    }

    void AddBox(Vector3 pos, Vector3 size, Color col)
    {
        var body = new StaticBody3D();
        body.AddChild(new CollisionShape3D { Shape = new BoxShape3D { Size = size } });
        var mi = new MeshInstance3D { Mesh = new BoxMesh { Size = size } };
        mi.SetSurfaceOverrideMaterial(0,
            new StandardMaterial3D { AlbedoColor = col, Roughness = 1f, Metallic = 0f });
        body.AddChild(mi);
        AddChild(body);
        body.GlobalPosition = pos;
    }

    public override void _PhysicsProcess(double delta)
    {
        if (_player == null) return;
        float dt = (float)delta;
        _t += dt;

        // ── Scripted input timeline ─────────────────────────────────────────
        // t=1.0s: single-tick "jump" press -> real wall-jump (WallRunTick's own
        // Input.IsActionJustPressed("jump") branch — same code as live play).
        if (_t >= 1.00f && _t < 1.00f + dt)
            Input.ActionPress("jump");
        else
            Input.ActionRelease("jump");

        // Fire a burst while still airborne and falling (~0.5s after the jump,
        // ~0.5s+ before landing at this launch height) — verifies (c): shoot
        // interrupts the hold pose, and once it ends the arms return to the
        // hold pose instead of resuming any stuck locomotion clip.
        bool firing = _t >= 1.55f && _t < 1.85f;
        if (firing) Input.ActionPress("attack"); else Input.ActionRelease("attack");

        // After landing, hold forward for a beat — (a) "run on ground" regression
        // check: confirms ordinary grounded locomotion still looks like it did
        // before this fix (aim_mid, gun on reticle — FP arms have no separate
        // discrete run-cycle clip to begin with, only Idle/Walk/Run all sharing
        // aim_mid, so this is a pure no-regression check).
        bool runningOnGround = _t >= 2.50f && _t < 3.50f;
        if (runningOnGround) Input.ActionPress("move_forward"); else Input.ActionRelease("move_forward");

        bool onFloor  = _player.IsOnFloor();
        bool wallRun  = _player.DebugIsWallRunning;
        if (!onFloor && !wallRun) _everAirborne = true;
        if (onFloor && _everAirborne) _everLandedAfterAirborne = true;

        _phase = wallRun ? "WALL RUNNING"
               : !onFloor ? (firing ? "AIRBORNE + FIRING" : "AIRBORNE")
               : runningOnGround ? "GROUND RUN (post-land)"
               : _everAirborne ? "LANDED" : "GROUND (pre wall-run)";

        if (_label != null)
            _label.Text = $"t={_t:F2}s  {_phase}\nonFloor={onFloor}  wallRun={wallRun}";

        if (Engine.GetPhysicsFrames() % 6 == 0)
            GD.Print($"[Capture] t={_t:F2} phase={_phase} onFloor={onFloor} " +
                     $"wallRun={wallRun} vel={_player.Velocity}");
    }
}

/// Screen-space crosshair using the SAME draw code the real HUD uses
/// (ReticleRenderer).
public partial class ReticleOverlay : Control
{
    public override void _Ready()
    {
        SetAnchorsPreset(LayoutPreset.FullRect);
        MouseFilter = MouseFilterEnum.Ignore;
    }

    public override void _Process(double delta) => QueueRedraw();

    public override void _Draw()
    {
        var center = GetViewportRect().Size / 2f;
        ReticleRenderer.Draw(this, center, 0f, false);
    }
}
