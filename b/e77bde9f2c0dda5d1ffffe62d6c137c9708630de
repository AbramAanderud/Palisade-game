using Godot;
using System.Collections.Generic;

/// test/TestTeleportOrphan.cs
/// Data-level backstop for the editor's teleport pair-lock (I3, MazeEditor3D):
/// MazeValidator.IsGameReady must refuse ANY maze containing a Teleport Pad
/// whose LinkId group isn't exactly size 2 — a legacy/hand-edited save can
/// still reach this shape even though the editor's pair-lock now prevents it
/// from ever being SAVED that way going forward.
///
/// Builds minimal Start/Exit/corridor layouts directly (no scene tree needed —
/// MazeValidator is a pure static class), varying only the teleport pads.
public partial class TestTeleportOrphan : Node
{
    int _fail;
    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + label);
        if (!ok) _fail++;
    }

    // A trivial straight corridor from Start to Exit, plus whatever pads the
    // caller adds — reachability of the corridor itself is never the point of
    // these cases, only the pad-pairing rule.
    static MazeData BaseMaze()
    {
        var m = new MazeData { Name = "OrphanTest", Pieces = new List<MazePiece>() };
        for (int y = 0; y <= 9; y++)
        {
            PieceType t = y == 0 ? PieceType.Start : y == 9 ? PieceType.Exit : PieceType.Straight;
            m.Pieces.Add(new MazePiece { Type = t, X = 4, Y = y, Floor = 0, Rotation = 0 });
        }
        return m;
    }

    // Swaps the corridor cell at (4, y) for a TrapPortal pad on `link`. TrapPortal
    // opens N|S at rotation 0, same as Straight, so the corridor chain stays
    // intact with the pad standing in for one of its own cells — i.e. reachable
    // from Start the ordinary way, not via the teleport edge.
    static void InlinePad(MazeData m, int y, int link)
    {
        m.Pieces.RemoveAll(p => p.X == 4 && p.Y == y);
        m.Pieces.Add(new MazePiece { Type = PieceType.TrapPortal, X = 4, Y = y, Floor = 0, LinkId = link });
    }

    static MazePiece Pad(int x, int y, int link) =>
        new MazePiece { Type = PieceType.TrapPortal, X = x, Y = y, Floor = 0, LinkId = link };

    public override void _Ready()
    {
        GD.Print("── teleport orphan backstop (MazeValidator) ──");

        // Paired-valid: one pad sits IN the corridor (reached normally); its
        // partner is off on its own — reached purely via the teleport edge
        // (MazeValidator connects linked pads regardless of physical distance),
        // which is exactly what proves the PAIRING check, not placement, is
        // what's being exercised here.
        var paired = BaseMaze();
        InlinePad(paired, 3, 1);
        paired.Pieces.Add(Pad(1, 1, 1));
        Check(MazeValidator.IsGameReady(paired, out string err1), $"a complete pair is game-ready ({err1})");

        // Orphan-invalid: one pad, no partner (LinkId 1, alone). The pairing
        // check runs before BFS, so this is refused regardless of reachability.
        var orphan = BaseMaze();
        orphan.Pieces.Add(Pad(1, 1, 1));
        bool orphanOk = MazeValidator.IsGameReady(orphan, out string err2);
        Check(!orphanOk, "a lone pad is NOT game-ready");
        Check(err2.Contains("no partner"), $"orphan error message names the cause ({err2})");

        // Legacy LinkId 0 (unpaired/inert) — same rejection, even with two of
        // them, since LinkId 0 means "not linked to each other".
        var legacy = BaseMaze();
        legacy.Pieces.Add(Pad(1, 1, 0));
        legacy.Pieces.Add(Pad(1, 2, 0));
        Check(!MazeValidator.IsGameReady(legacy, out string err3),
              $"two LinkId-0 pads are still NOT paired to each other ({err3})");

        // Ambiguous triple on one channel.
        var triple = BaseMaze();
        triple.Pieces.Add(Pad(1, 1, 1));
        triple.Pieces.Add(Pad(1, 2, 1));
        triple.Pieces.Add(Pad(2, 1, 1));
        Check(!MazeValidator.IsGameReady(triple, out string err4),
              $"three pads on one channel is NOT game-ready ({err4})");

        // Two-pairs-valid: one pad from EACH pair sits in the corridor so both
        // channels are independently reachable; both partners are off on their own.
        var twoPairs = BaseMaze();
        InlinePad(twoPairs, 3, 1);
        InlinePad(twoPairs, 6, 2);
        twoPairs.Pieces.Add(Pad(1, 1, 1));
        twoPairs.Pieces.Add(Pad(1, 2, 2));
        Check(MazeValidator.IsGameReady(twoPairs, out string err5), $"two complete pairs are game-ready ({err5})");

        // One complete pair (1, in the corridor + its off-path partner) plus one
        // orphan on a second channel — the orphan alone must fail the whole maze.
        var mixedOrphan = BaseMaze();
        InlinePad(mixedOrphan, 3, 1);
        mixedOrphan.Pieces.Add(Pad(1, 1, 1));
        mixedOrphan.Pieces.Add(Pad(2, 1, 2));
        Check(!MazeValidator.IsGameReady(mixedOrphan, out string err6),
              $"a complete pair plus one orphan on another channel is NOT game-ready ({err6})");

        GD.Print(_fail == 0 ? "RESULT OK" : $"RESULT {_fail} FAILURE(S)");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
