using Godot;

/// res://scripts/GunFx.cs
/// ─────────────────────────────────────────────────────────────────────────────
/// All the visual language of a gunshot, in one place.
///
/// The design rule everything here follows: HITS come from the camera (the
/// crosshair never lies — that is what good gunplay means), but every VISUAL
/// comes from the MUZZLE. The old effects all spawned at the eye, which meant
/// you could not see your own tracers (collinear with the view), the flash
/// floated at head height, and rockets materialised out of your face.
///
/// Effects are deliberately cheap: unshaded emissive primitives driven by
/// tweens — no particle systems to configure, nothing persistent, everything
/// frees itself.
/// ─────────────────────────────────────────────────────────────────────────────
public static class GunFx
{
    // ── Tracer ────────────────────────────────────────────────────────────────
    /// A SHORT bright streak that TRAVELS from the muzzle to the impact point.
    /// An instant full-length line reads as a laser; a moving streak reads as a
    /// bullet. Damage is already applied when this spawns — only the visual
    /// travels, which is exactly how the big shooters fake it.
    public const float TracerSpeed = 320f;   // m/s, visual only

    public static void Tracer(Node ctx, Vector3 from, Vector3 to)
    {
        float dist = from.DistanceTo(to);
        if (dist < 3f) { Impact(ctx, to, (to - from).Normalized()); return; }

        var t = new TracerStreak { From = from, To = to };
        ctx.GetTree().Root.AddChild(t);
        t.GlobalPosition = from;
    }

    // ── Muzzle flash: small hot core + light + a wisp of smoke ────────────────
    public static void MuzzleFlash(Node ctx, Vector3 muzzle, Vector3 dir, float scale = 1f)
    {
        var root = ctx.GetTree().Root;

        // Hot core: a small emissive billboard quad, gone in ~50 ms. Kept SMALL —
        // the flash is a punctuation mark, not the sentence.
        var mat = new StandardMaterial3D
        {
            AlbedoColor              = new Color(1f, 0.85f, 0.45f, 0.95f),
            EmissionEnabled          = true,
            Emission                 = new Color(1f, 0.72f, 0.28f),
            EmissionEnergyMultiplier = 9f,
            ShadingMode              = BaseMaterial3D.ShadingModeEnum.Unshaded,
            Transparency             = BaseMaterial3D.TransparencyEnum.Alpha,
            BillboardMode            = BaseMaterial3D.BillboardModeEnum.Enabled,
        };
        var quad = new MeshInstance3D
        {
            Mesh       = new QuadMesh { Size = Vector2.One * 0.22f * scale },
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        };
        quad.SetSurfaceOverrideMaterial(0, mat);
        root.AddChild(quad);
        quad.GlobalPosition = muzzle + dir * 0.05f;
        quad.RotateObjectLocal(Vector3.Forward, GD.Randf() * Mathf.Tau);

        var light = new OmniLight3D
        {
            LightColor  = new Color(1f, 0.80f, 0.42f),
            LightEnergy = 3.2f * scale,
            OmniRange   = 5.5f * scale,
        };
        root.AddChild(light);
        light.GlobalPosition = muzzle;

        var tw = quad.CreateTween();
        tw.TweenProperty(quad, "scale", Vector3.One * 1.6f, 0.05f);
        tw.Parallel().TweenProperty(mat, "albedo_color:a", 0f, 0.05f);
        tw.Parallel().TweenProperty(light, "light_energy", 0f, 0.06f);
        tw.TweenCallback(Callable.From(() => { quad.QueueFree(); light.QueueFree(); }));

        SmokePuff(ctx, muzzle + dir * 0.08f, dir * 0.4f + Vector3.Up * 0.35f,
                  0.05f * scale, 0.14f * scale, 0.45f);
    }

    /// Rocket tubes vent a cloud BACKWARD on launch — the signature of a
    /// recoilless weapon, and the thing that makes a tube read as a tube.
    public static void Backblast(Node ctx, Vector3 muzzle, Vector3 dir)
    {
        for (int i = 0; i < 3; i++)
        {
            var offset = -dir * (0.5f + 0.35f * i)
                       + new Vector3(GD.Randf() - 0.5f, GD.Randf() - 0.5f,
                                     GD.Randf() - 0.5f) * 0.18f;
            SmokePuff(ctx, muzzle + offset, -dir * 1.6f, 0.10f, 0.42f, 0.55f);
        }
    }

    // ── Impact: spark + dust ──────────────────────────────────────────────────
    public static void Impact(Node ctx, Vector3 pos, Vector3 dir)
    {
        var root = ctx.GetTree().Root;
        var mat = new StandardMaterial3D
        {
            AlbedoColor              = new Color(1f, 0.9f, 0.6f, 0.9f),
            EmissionEnabled          = true,
            Emission                 = new Color(1f, 0.75f, 0.35f),
            EmissionEnergyMultiplier = 6f,
            ShadingMode              = BaseMaterial3D.ShadingModeEnum.Unshaded,
            Transparency             = BaseMaterial3D.TransparencyEnum.Alpha,
        };
        var spark = new MeshInstance3D
        {
            Mesh = new SphereMesh { Radius = 0.045f, Height = 0.09f,
                                    RadialSegments = 6, Rings = 3 },
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        };
        spark.SetSurfaceOverrideMaterial(0, mat);
        root.AddChild(spark);
        spark.GlobalPosition = pos;
        var tw = spark.CreateTween();
        tw.TweenProperty(spark, "scale", Vector3.One * 0.15f, 0.10f);
        tw.Parallel().TweenProperty(mat, "albedo_color:a", 0f, 0.10f);
        tw.TweenCallback(Callable.From(spark.QueueFree));

        // Dust kicked back along the surface normal-ish (approximated as -dir).
        SmokePuff(ctx, pos - dir * 0.05f, -dir * 0.5f + Vector3.Up * 0.2f,
                  0.07f, 0.24f, 0.35f);
    }

    // ── Shell casing: a tumbling brass fleck out the right of the action ─────
    public static void Casing(Node ctx, Vector3 muzzle, Vector3 dir)
    {
        var root  = ctx.GetTree().Root;
        var right = dir.Cross(Vector3.Up).Normalized();
        var mat = new StandardMaterial3D
        {
            AlbedoColor = new Color(0.82f, 0.65f, 0.25f),
            Metallic    = 0.7f, Roughness = 0.35f,
        };
        var shell = new MeshInstance3D
        {
            Mesh = new BoxMesh { Size = new Vector3(0.015f, 0.015f, 0.045f) },
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        };
        shell.SetSurfaceOverrideMaterial(0, mat);
        root.AddChild(shell);
        // Eject from the action, not the muzzle tip.
        shell.GlobalPosition = muzzle - dir * 0.35f + right * 0.06f;

        var apex = shell.GlobalPosition + right * 0.22f + Vector3.Up * 0.18f
                 + new Vector3(GD.Randf() - 0.5f, 0f, GD.Randf() - 0.5f) * 0.10f;
        var floor = new Vector3(apex.X, shell.GlobalPosition.Y - 1.2f, apex.Z);

        var tw = shell.CreateTween();
        tw.TweenProperty(shell, "global_position", apex, 0.16f)
          .SetEase(Tween.EaseType.Out);
        tw.TweenProperty(shell, "global_position", floor, 0.38f)
          .SetEase(Tween.EaseType.In);
        // Tumble the whole flight.
        var spin = shell.CreateTween();
        spin.TweenProperty(shell, "rotation",
            new Vector3(GD.Randf() * 9f, GD.Randf() * 9f, GD.Randf() * 9f), 0.54f);
        tw.TweenInterval(0.25f);
        tw.TweenCallback(Callable.From(shell.QueueFree));
    }

    // ── One-shot positional audio ─────────────────────────────────────────────
    /// Fire-and-forget 3D sound at a world position: transient player, frees
    /// itself when done. For sounds tied to an EVENT AT A PLACE (impacts,
    /// explosions) rather than to a node that persists (a gun's own fire sfx
    /// belongs on the gun, where EquipGun can retarget its stream).
    public static void PlayOneShot3D(Node ctx, string path, Vector3 pos,
                                     float maxDist = 40f, float pitch = 1f,
                                     float volumeDb = 0f)
    {
        if (!ResourceLoader.Exists(path)) return;   // silent no-op, same rule as MakeSfx3D
        var stream = GD.Load<AudioStream>(path);
        if (stream == null) return;

        var p = new AudioStreamPlayer3D
        {
            Stream      = stream,
            MaxDistance = maxDist,
            PitchScale  = pitch,
            VolumeDb    = volumeDb,
        };
        ctx.GetTree().Root.AddChild(p);
        p.GlobalPosition = pos;
        p.Finished += p.QueueFree;
        p.Play();
    }

    // ── Shared smoke ──────────────────────────────────────────────────────────
    static void SmokePuff(Node ctx, Vector3 pos, Vector3 drift,
                          float startR, float endR, float life)
    {
        var mat = new StandardMaterial3D
        {
            AlbedoColor  = new Color(0.62f, 0.60f, 0.57f, 0.34f),
            ShadingMode  = BaseMaterial3D.ShadingModeEnum.Unshaded,
            Transparency = BaseMaterial3D.TransparencyEnum.Alpha,
        };
        var puff = new MeshInstance3D
        {
            Mesh = new SphereMesh { Radius = startR, Height = startR * 2f,
                                    RadialSegments = 8, Rings = 4 },
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        };
        puff.SetSurfaceOverrideMaterial(0, mat);
        ctx.GetTree().Root.AddChild(puff);
        puff.GlobalPosition = pos;

        var tw = puff.CreateTween();
        tw.TweenProperty(puff, "scale", Vector3.One * (endR / startR), life);
        tw.Parallel().TweenProperty(puff, "global_position", pos + drift * life, life);
        tw.Parallel().TweenProperty(mat, "albedo_color:a", 0f, life);
        tw.TweenCallback(Callable.From(puff.QueueFree));
    }
}

/// The moving part of a tracer: a short emissive core with a soft glow shell,
/// flown from muzzle to impact at GunFx.TracerSpeed. Spawns the impact visual
/// when it ARRIVES, so distant hits flash a beat after the trigger — the same
/// slight travel beat every modern shooter fakes.
public partial class TracerStreak : Node3D
{
    public Vector3 From, To;

    const float CoreLen = 1.1f;

    float _dist, _travelled;
    Vector3 _dir;

    public override void _Ready()
    {
        _dir  = (To - From).Normalized();
        _dist = From.DistanceTo(To);

        var coreMat = new StandardMaterial3D
        {
            AlbedoColor              = new Color(1f, 0.93f, 0.72f, 0.95f),
            EmissionEnabled          = true,
            Emission                 = new Color(1f, 0.85f, 0.5f),
            EmissionEnergyMultiplier = 7f,
            ShadingMode              = BaseMaterial3D.ShadingModeEnum.Unshaded,
            Transparency             = BaseMaterial3D.TransparencyEnum.Alpha,
        };
        var core = new MeshInstance3D
        {
            Mesh = new CylinderMesh { TopRadius = 0.014f, BottomRadius = 0.02f,
                                      Height = CoreLen, RadialSegments = 5, Rings = 1 },
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        };
        core.SetSurfaceOverrideMaterial(0, coreMat);
        core.RotationDegrees = new Vector3(90f, 0f, 0f);   // cylinder +Y → local -Z
        AddChild(core);

        var glowMat = new StandardMaterial3D
        {
            AlbedoColor              = new Color(1f, 0.75f, 0.35f, 0.25f),
            EmissionEnabled          = true,
            Emission                 = new Color(1f, 0.65f, 0.25f),
            EmissionEnergyMultiplier = 3f,
            ShadingMode              = BaseMaterial3D.ShadingModeEnum.Unshaded,
            Transparency             = BaseMaterial3D.TransparencyEnum.Alpha,
            CullMode                 = BaseMaterial3D.CullModeEnum.Disabled,
        };
        var glow = new MeshInstance3D
        {
            Mesh = new CylinderMesh { TopRadius = 0.05f, BottomRadius = 0.06f,
                                      Height = CoreLen * 0.9f, RadialSegments = 6, Rings = 1 },
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        };
        glow.SetSurfaceOverrideMaterial(0, glowMat);
        glow.RotationDegrees = new Vector3(90f, 0f, 0f);
        AddChild(glow);

        if (Mathf.Abs(_dir.Dot(Vector3.Up)) < 0.999f)
            LookAt(GlobalPosition + _dir, Vector3.Up);
    }

    public override void _Process(double delta)
    {
        _travelled += GunFx.TracerSpeed * (float)delta;
        if (_travelled >= _dist)
        {
            GunFx.Impact(this, To, _dir);
            QueueFree();
            return;
        }
        GlobalPosition = From + _dir * _travelled;
    }
}
