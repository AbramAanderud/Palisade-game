using Godot;
using System;
using System.Collections.Generic;
using System.Linq;

/// test/TestArenaProtrusion.cs
/// Finds every place in the arena where VISUAL geometry sticks further into the
/// room than the nearest COLLISION surface — i.e. every place the player can
/// walk/wall-run into something they can see.
///
/// Playtest report: "the bookshelves are still collidable, you go into them."
/// Rather than guessing which piece is at fault, this measures all of them:
///
///   For each (angle sector, height band):
///     collisionR = ray cast outward from the arena axis, distance to first hit
///     visualR    = smallest radius of any visual vertex in that cell
///   If visualR < collisionR, visual geometry is INSIDE the collision surface —
///   the player reaches it and passes through. That difference is the bug, and
///   its worst value is the number the collision radius has to respect.
///
/// Walks MeshInstance3D and MultiMeshInstance3D (columns/balustrades/bookrows
/// are MultiMesh-batched, so ignoring those would miss the most proud pieces).
public partial class TestArenaProtrusion : Node3D
{
    const int   Sectors   = 64;
    const float BandH     = 1.0f;
    const float RayLen    = 60f;
    const float Epsilon   = 0.02f;   // ignore sub-2cm differences (z-fighting scale)

    // Geometry that is SUPPOSED to be inside the collision surface, so reporting
    // it is noise rather than signal:
    //   Grass*  — covers the whole floor disc and is walked through by design
    //   Curtain — shader cloth over the doorways, parts around the player
    //   column_a — a known, deliberately-unfixed offender; its capitals are
    //              standable platforms sized off its width, so it is tracked in
    //              ArenaBuilder's clearance-contract comment rather than here.
    //              Remove from this list when that decision is revisited.
    static readonly string[] Ignore = { "Grass", "Curtain", "column_a" };
    static bool Ignored(string n) => Ignore.Any(k => n.Contains(k));

    // Sectors overlapping either doorway bay (north at angle 0, south at pi),
    // widened by one sector each side to cover the arch shoulders.
    static bool DoorwaySector(int s)
    {
        float a = 2f * Mathf.Pi * (s + 0.5f) / Sectors;
        float halfBay = Mathf.Pi / 32f + 2f * Mathf.Pi / Sectors;
        return Mathf.Abs(Mathf.Wrap(a, -Mathf.Pi, Mathf.Pi)) < halfBay ||
               Mathf.Abs(Mathf.Wrap(a - Mathf.Pi, -Mathf.Pi, Mathf.Pi)) < halfBay;
    }

    public override void _Ready()
    {
        var arena = new ArenaBuilder { Name = "Arena" };
        AddChild(arena);
        arena.Build(Vector3.Zero, openNorth: true, openSouth: true);
        CallDeferred(nameof(Run));
    }

    void Run()
    {
        int bands = (int)(ArenaBuilder.ArenaWallH / BandH) + 1;
        var visualR = new float[Sectors, bands];
        for (int s = 0; s < Sectors; s++)
            for (int b = 0; b < bands; b++) visualR[s, b] = float.MaxValue;

        // ── gather visual geometry ────────────────────────────────────────────
        var names = new Dictionary<(int, int), string>();
        int meshCount = 0;
        void Visit(Node n, Transform3D xf)
        {
            if (n is Node3D n3) xf *= n3.Transform;

            if (n is MultiMeshInstance3D mmi && mmi.Multimesh?.Mesh != null && !Ignored(mmi.Name))
            {
                meshCount++;
                var verts = MeshVerts(mmi.Multimesh.Mesh);
                for (int i = 0; i < mmi.Multimesh.InstanceCount; i++)
                {
                    var ixf = xf * mmi.Multimesh.GetInstanceTransform(i);
                    foreach (var v in verts) Record(ixf * v, mmi.Name, visualR, names);
                }
            }
            else if (n is MeshInstance3D mi && mi.Mesh != null && !Ignored(mi.Name))
            {
                meshCount++;
                foreach (var v in MeshVerts(mi.Mesh)) Record(xf * v, mi.Name, visualR, names);
            }

            foreach (Node c in n.GetChildren()) Visit(c, xf);
        }
        Visit(GetNode("Arena"), Transform3D.Identity);

        // ── probe collision ───────────────────────────────────────────────────
        var space = GetWorld3D().DirectSpaceState;
        var report  = new List<(float depth, int s, int b, float vr, float cr, string who)>();
        var doorway = new List<(float depth, int s, int b, float vr, float cr, string who)>();

        for (int b = 0; b < bands; b++)
        {
            float y = (b + 0.5f) * BandH;
            for (int s = 0; s < Sectors; s++)
            {
                float a = 2f * Mathf.Pi * (s + 0.5f) / Sectors;
                var dir = new Vector3(Mathf.Sin(a), 0f, -Mathf.Cos(a));
                var q = PhysicsRayQueryParameters3D.Create(
                    new Vector3(0, y, 0), new Vector3(0, y, 0) + dir * RayLen);
                var hit = space.IntersectRay(q);
                float cr = hit.Count > 0
                    ? new Vector2(((Vector3)hit["position"]).X, ((Vector3)hit["position"]).Z).Length()
                    : float.MaxValue;

                float vr = visualR[s, b];
                if (vr == float.MaxValue || cr == float.MaxValue) continue;
                if (vr < cr - Epsilon)
                {
                    var row = (cr - vr, s, b, vr, cr, names.GetValueOrDefault((s, b), "?"));
                    // The collision ring is deliberately OPEN at the two doorway
                    // bays so the player can walk out through the arch. Decor that
                    // spans those bays (the tier ledge is one continuous torus,
                    // and the arch soffit) is therefore "unbacked" by design, not
                    // by mistake. Reported, but not counted as failure — the gate
                    // is about the surface the player runs along.
                    if (DoorwaySector(s)) doorway.Add(row); else report.Add(row);
                }
            }
        }

        void P(string l) => GD.Print("[Protrude] " + l);
        P("──────────────────────────────────────────────");
        P($"visual nodes walked   {meshCount}");
        P($"cells checked         {Sectors * bands}");
        P($"cells with protrusion {report.Count}   (+{doorway.Count} in open doorway bays, by design)");
        if (report.Count == 0) { P("PASS — no visual geometry inside the collision surface"); }
        else
        {
            // Worst offenders first — the top of this list is what to fix.
            foreach (var r in report.OrderByDescending(x => x.depth).Take(200))
                P($"  y={(r.b + 0.5f) * BandH,6:F1}  visual={r.vr:F3}  collide={r.cr:F3}  " +
                  $"PROTRUDES {r.depth * 1000f,6:F0} mm   {r.who}");

            var byNode = report.GroupBy(x => x.who)
                               .Select(g => (who: g.Key, worst: g.Max(x => x.depth), n: g.Count()))
                               .OrderByDescending(x => x.worst);
            P("  ── worst protrusion per node ──");
            foreach (var g in byNode) P($"    {g.worst * 1000f,6:F0} mm  x{g.n,4}  {g.who}");
            P($"FAIL — deepest protrusion {report.Max(x => x.depth) * 1000f:F0} mm");
        }
        P("──────────────────────────────────────────────");
        GetTree().Quit();
    }

    void Record(Vector3 p, string who, float[,] visualR, Dictionary<(int, int), string> names)
    {
        float r = new Vector2(p.X, p.Z).Length();
        if (r < 1f) return;                                   // ignore anything near the axis
        int b = (int)(p.Y / BandH);
        if (b < 0 || b >= visualR.GetLength(1)) return;
        float a = Mathf.Atan2(p.X, -p.Z);
        if (a < 0) a += 2f * Mathf.Pi;
        int s = Mathf.Clamp((int)(a / (2f * Mathf.Pi) * Sectors), 0, Sectors - 1);
        if (r < visualR[s, b]) { visualR[s, b] = r; names[(s, b)] = who; }
    }

    static readonly Dictionary<Mesh, Vector3[]> _cache = new();
    static Vector3[] MeshVerts(Mesh m)
    {
        if (_cache.TryGetValue(m, out var hit)) return hit;
        var all = new List<Vector3>();
        for (int s = 0; s < m.GetSurfaceCount(); s++)
        {
            var arr = m.SurfaceGetArrays(s);
            if (arr.Count > (int)Mesh.ArrayType.Vertex &&
                arr[(int)Mesh.ArrayType.Vertex].VariantType == Variant.Type.PackedVector3Array)
                all.AddRange((Vector3[])arr[(int)Mesh.ArrayType.Vertex]);
        }
        return _cache[m] = all.ToArray();
    }
}
