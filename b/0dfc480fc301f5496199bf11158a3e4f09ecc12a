using Godot;
using System.Linq;

/// test/TestTeleportMigration.cs
/// The guarantee that existing maps are not broken by the teleporter rules.
///
/// Two halves, and the second is the one that actually guarantees anything:
///
///  1. SYNTHETIC — every broken shape a save could hold (legacy LinkId 0, a
///     channel above the cap, three pads on one channel, a lone half-pair, more
///     pads than the cap allows) is fed through NormalizeTeleporters and the
///     invariants are asserted on the output.
///
///  2. REAL FILES — every maze_*.json actually on this machine is loaded and
///     checked. Synthetic cases only prove the code handles what I imagined;
///     scanning the real saves proves it handles what exists. This is what
///     turned up the two maps carrying LinkId 0, whose teleporters were inert
///     at runtime while the editor drew them as a working pair.
///
/// Also pins that normalisation PRESERVES deliberate pairings. An early draft
/// dealt every pad out by position, which silently re-wired a player's links.
public partial class TestTeleportMigration : Node
{
    int _fail;
    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + label);
        if (!ok) _fail++;
    }

    static MazePiece Pad(int x, int y, int link, int floor = 0) => new MazePiece
    {
        Type = PieceType.TrapPortal, X = x, Y = y, Floor = floor, LinkId = link,
    };

    /// The invariants, checked the same way for synthetic and real data.
    (bool ok, string why) Valid(MazeData m)
    {
        var pads = m.Pieces.Where(p => p.Type == PieceType.TrapPortal).ToList();
        foreach (var g in pads.GroupBy(p => p.LinkId))
        {
            if (g.Key == 0) continue;                       // inert overflow is legal
            if (g.Key < 0 || g.Key > MazeData.TeleportMaxChannels)
                return (false, $"channel {g.Key} out of range");
            if (g.Count() > MazeData.TeleportPadsPerPair)
                return (false, $"channel {g.Key} has {g.Count()} pads");
        }
        return (true, "");
    }

    public override void _Ready()
    {
        GD.Print("── synthetic legacy shapes ──");

        // Legacy: both pads on LinkId 0. This is the real-world case — inert at
        // runtime, drawn as channel 1 by the editor.
        var m = new MazeData();
        m.Pieces.Add(Pad(1, 1, 0)); m.Pieces.Add(Pad(1, 5, 0));
        Check(m.NormalizeTeleporters() == 2, "legacy 0/0 pair: both pads re-paired");
        Check(m.Pieces.All(p => p.LinkId == 1), "…onto teleporter 1, so it actually works");

        // A channel above the new cap.
        m = new MazeData();
        m.Pieces.Add(Pad(1, 1, 4)); m.Pieces.Add(Pad(1, 5, 4));
        m.NormalizeTeleporters();
        Check(Valid(m).ok && m.Pieces.All(p => p.LinkId == 1),
              "channel 4 pair moves down to teleporter 1");

        // Three pads on one channel — ambiguous pairing at runtime.
        m = new MazeData();
        for (int i = 0; i < 3; i++) m.Pieces.Add(Pad(1, i, 1));
        m.NormalizeTeleporters();
        Check(Valid(m).ok, "three-on-one-channel is resolved");
        Check(m.Pieces.Count(p => p.LinkId == 1) == 2, "…two stay on teleporter 1");
        Check(m.Pieces.Count(p => p.LinkId == 2) == 1, "…the third starts teleporter 2");

        // Over the cap: extras go INERT, never deleted.
        m = new MazeData();
        for (int i = 0; i < 7; i++) m.Pieces.Add(Pad(1, i, 0));
        m.NormalizeTeleporters();
        Check(m.Pieces.Count == 7, "over-cap map keeps ALL its pads (none deleted)");
        Check(Valid(m).ok, "over-cap map is valid after migration");
        Check(m.Pieces.Count(p => p.LinkId == 0) == 3, "the 3 extras are inert, not mispaired");

        // Preservation: a deliberate far-apart pairing must survive.
        m = new MazeData();
        m.Pieces.Add(Pad(1, 1, 1));   // linked to the far pad, not its neighbour
        m.Pieces.Add(Pad(2, 2, 2));
        m.Pieces.Add(Pad(3, 3, 2));
        m.Pieces.Add(Pad(9, 9, 1));
        Check(m.NormalizeTeleporters() == 0, "an already-legal layout is left completely alone");
        Check(m.Pieces.First(p => p.X == 1).LinkId == 1
           && m.Pieces.First(p => p.X == 9).LinkId == 1,
              "…the far-apart pair stays paired (not re-wired to neighbours)");

        // Idempotent: running it twice must change nothing the second time.
        m = new MazeData();
        for (int i = 0; i < 5; i++) m.Pieces.Add(Pad(1, i, 0));
        m.NormalizeTeleporters();
        Check(m.NormalizeTeleporters() == 0, "migration is idempotent");

        // ── real saves on this machine ───────────────────────────────────────
        GD.Print("── real save files ──");
        int scanned = 0, repaired = 0, stillBad = 0;
        foreach (var acct in new[] { "" }.Concat(ListDirs("user://accounts")))
        {
            string dir = acct == "" ? "user://" : $"user://accounts/{acct}";
            foreach (var f in ListFiles(dir).Where(f => f.StartsWith("maze_") && f.EndsWith(".json")))
            {
                using var fh = FileAccess.Open($"{dir}/{f}", FileAccess.ModeFlags.Read);
                if (fh == null) continue;
                MazeData? data;
                try { data = System.Text.Json.JsonSerializer.Deserialize<MazeData>(fh.GetAsText()); }
                catch { continue; }
                if (data == null) continue;

                scanned++;
                int fixedPads = data.NormalizeTeleporters();
                if (fixedPads > 0) repaired++;
                var (ok, why) = Valid(data);
                if (!ok) { stillBad++; GD.Print($"      {dir}/{f}: {why}"); }
            }
        }
        GD.Print($"      scanned {scanned} save file(s); {repaired} needed repair");
        Check(scanned > 0, "found real save files to scan (a zero scan proves nothing)");
        Check(stillBad == 0, "EVERY real save is valid after migration");

        GD.Print(_fail == 0 ? "RESULT OK" : $"RESULT {_fail} FAILURE(S)");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }

    static string[] ListDirs(string path)
        => DirAccess.DirExistsAbsolute(path) ? DirAccess.GetDirectoriesAt(path) : new string[0];
    static string[] ListFiles(string path)
        => DirAccess.DirExistsAbsolute(path) ? DirAccess.GetFilesAt(path) : new string[0];
}
