using Godot;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Reflection;
using System.Text.Json;
using System.Threading.Tasks;

/// test/TestFfaRematchFlow.cs
/// Four-client end-to-end check of the FFA end-screen rematch vote over a REAL
/// relay (Phase 6). The party forms and starts exactly as in TestFfaMatchFlow;
/// once MatchLive, the host kills c1, c2 and c3 (DebugDamageSeat 3x40 each).
/// The killed clients stay connected, and all four reach the end screen on the
/// host's "end". Then, per scenario:
///
///   --scenario A (drop to 3, rotate majority): c3 presses Exit. host, c1 and
///     c2 wait for RematchAvailable with 3 remaining seats, then vote host
///     Rotate, c1 Rotate, c2 Same. All three reload into a new OnlineFfaArena
///     with FfaRoster.Count 3, FfaRotationOffset 2 (1 -> rotate, n=3),
///     MatchLive with 2 puppets, and LocalMazeSeat following the runner rule.
///   --scenario B (tie -> host): all four stay; votes host Same, c1 Same,
///     c2 Rotate, then (after every client saw RematchTally (2,1)) c3 Rotate.
///     2-2 goes to the host's Same: everyone reloads with offset 1, 4 roster
///     seats, MatchLive with 3 puppets.
///   --scenario C (host leaves mid-vote): c1 Rotate, c2 Rotate, c3 Same
///     (everyone sees RematchTally (1,2)), then the host presses Exit without
///     voting. On c1, c2 and c3 the lowest remaining seat becomes host, the
///     remaining set is 3 seats that have all voted, and the new host decides
///     Rotate (2-1) and sends rematch_go: everyone reloads with roster 3,
///     offset 2, MatchLive with 2 puppets.
/// Votes go through DebugVoteRematch (the buttons' handler); Exit is the end
/// screen's real "Exit to Menu" button (its Pressed signal is emitted).
/// Clients sync phases with a test-only {"t":"test_rm"} message.
///
///   PORT=3301 node server/relay.js & RELAY=$!
///   P=""; for r in host c1 c2 c3; do
///     ..._console.exe --path . --headless res://test/TestFfaRematchFlow.tscn --account __test_ffa_r_$r --relay ws://localhost:3301 --role $r --scenario A > ffarA-$r.log 2>&1 & P="$P $!"
///   done
///   for p in $P; do wait $p; done; kill $RELAY
/// (B and C: another port each, --scenario B / C.) Every log must end in ALL PASS.
public partial class TestFfaRematchFlow : Node
{
    const int    TestSlot   = 3;
    const double TimeoutSec = 300;

    string _role = "";
    string _scenario = "";
    bool   _isHost => _role == "host";
    int    _fail;
    string _me = "";
    NetworkManager _nm = null!;
    string? _shotDir = FfaTestShots.ParseDir();   // --shot <dir>: windowed PNGs (FfaTestShots)
    FfaTestShots.Bw? _bw;

    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + $"[{_role}] " + label);
        if (!ok) _fail++;
    }

    public override void _Ready()
    {
        if (!AccountManager.ActiveAccount.StartsWith("__test_ffa"))
        {
            GD.PushError("Refusing to run: pass --account __test_ffa_<role>");
            GetTree().Quit(2);
            return;
        }
        var args = OS.GetCmdlineArgs();
        for (int i = 0; i < args.Length - 1; i++)
        {
            if (args[i] == "--role")     _role     = args[i + 1];
            if (args[i] == "--scenario") _scenario = args[i + 1];
        }
        if (_role != "host" && _role != "c1" && _role != "c2" && _role != "c3")
        {
            GD.PushError("Refusing to run: --role must be host|c1|c2|c3");
            GetTree().Quit(2);
            return;
        }
        if (_scenario != "A" && _scenario != "B" && _scenario != "C")
        {
            GD.PushError("Refusing to run: --scenario must be A, B or C");
            GetTree().Quit(2);
            return;
        }
        CallDeferred(nameof(Detach));
    }

    void Detach()
    {
        var root = GetTree().Root;
        GetParent().RemoveChild(this);
        root.AddChild(this);
        _ = Run();
    }

    async Task Run()
    {
        var watchdog = GetTree().CreateTimer(TimeoutSec);
        watchdog.Timeout += () => { GD.PrintErr("TIMEOUT"); GetTree().Quit(3); };

        PlayerProfile.Load();
        _me = OnlineGameState.PlayerName;
        var test = DefaultMaze.Build();
        test.Name = $"{_me} test maze";
        MazeSerializer.Save(TestSlot, test);
        OnlineGameState.SelectedMazeSlot = TestSlot;

        _nm = GetNode<NetworkManager>("/root/NetworkManager");
        _nm.GameDataReceived += OnTestData;   // before any arena traffic

        // -- Matchmaking / party setup ------------------------------------
        var lobbyPlayers = new Dictionary<string, string>();   // id -> name, everyone but me
        bool created = false, joined = false;
        string createdJson = "", joinedJson = "";
        _nm.LobbyUpdated += json =>
        {
            using var doc = JsonDocument.Parse(json);
            lobbyPlayers.Clear();
            foreach (var p in doc.RootElement.GetProperty("players").EnumerateArray())
            {
                string id = p.GetProperty("id").GetString()!, name = p.GetProperty("name").GetString()!;
                if (name != _me) lobbyPlayers[id] = name;
            }
        };
        _nm.PartyCreated += j => { createdJson = j; created = true; };
        _nm.PartyJoined  += j => { joinedJson  = j; joined  = true; };
        _nm.PartyInvited += (code, _, _) => _nm.PartyRespond(code, true);

        if (!_isHost) await Wait(0.5);   // host is first in the lobby
        _nm.ConnectAndJoinLobby(_me);

        var expectedClients = new HashSet<string>();
        if (_isHost)
        {
            await Until(() => lobbyPlayers.Count >= 3, "3 clients in the lobby", limit: 40);
            foreach (var n in lobbyPlayers.Values) expectedClients.Add(n);
            await Wait(0.5);
            _nm.PartyCreate();
            await Until(() => created, "party_created");
            FfaPreGameLobby.PendingInfoJson = createdJson;
        }
        else
        {
            await Until(() => joined, "party_joined (after accepting the invite)", limit: 60);
            FfaPreGameLobby.PendingInfoJson = joinedJson;
        }

        GetTree().ChangeSceneToFile("res://scenes/FfaPreGameLobby.tscn");
        await Until(() => GetTree().CurrentScene is FfaPreGameLobby, "FfaPreGameLobby scene");
        var lobby = (FfaPreGameLobby)GetTree().CurrentScene;
        int mySeat = lobby.MySeat;

        // Host invites each client through the lobby's invite list. The Invite
        // buttons ARE reachable: the list is the private _inviteList VBox of
        // HBox rows (name Label + Button); we emit that button's Pressed, the
        // same handler a click runs (it calls _nm.PartyInvite(id)).
        if (_isHost)
        {
            var invited = new HashSet<string>();
            await Until(() =>
            {
                foreach (var name in expectedClients)
                    if (!invited.Contains(name) && PressInvite(lobby, name)) invited.Add(name);
                return invited.Count == expectedClients.Count;
            }, "Invite buttons for all 3 clients", limit: 20);
        }

        // -- Seats / roster -----------------------------------------------
        await Until(() => Enumerable.Range(0, 4).All(s => Occupied(lobby, s)), "4 occupied seats", limit: 60);
        var seatNames = Enumerable.Range(0, 4).Select(s => lobby.SeatNameText(s)).ToList();
        Check(seatNames.Distinct().Count() == 4, $"4 distinct seat names ({string.Join(", ", seatNames)})");
        Check(lobby.SeatNameText(mySeat) == _me, $"my seat {mySeat} shows my name '{_me}'");
        if (_isHost)
        {
            Check(mySeat == 0, "host is seat 0");
            var expectedAll = new HashSet<string>(expectedClients) { _me };
            Check(seatNames.ToHashSet().SetEquals(expectedAll), "seat names match the lobby roster");
            Check(lobby.SeatNameText(0) == _me &&
                  Enumerable.Range(1, 3).Select(s => lobby.SeatNameText(s)).ToHashSet().SetEquals(expectedClients),
                  "clients hold distinct seats 1-3");
        }
        else
        {
            Check(mySeat >= 1 && mySeat <= 3, $"client seat in 1-3 ({mySeat})");
        }

        lobby.SelectMazeForTest(TestSlot);
        await Wait(1.0);   // everyone's first pick / ready state crosses

        // -- Readying -----------------------------------------------------
        var others = Enumerable.Range(0, 4).Where(s => s != mySeat).ToList();
        if (!_isHost)
        {
            Check(!lobby.StartVisible, "client does not see START");
            await Wait(0.5 * mySeat);   // stagger a little
            lobby.PressReadyForTest();
        }
        else
        {
            await Until(() => others.All(s => lobby.SeatReady(s)), "all 3 clients ready", limit: 40);
            Check(lobby.StartVisible && !lobby.StartEnabled, "host START visible but disabled while host not ready");
            await Until(() => others.All(s => lobby.SeatMazeText(s).Contains($"(Slot {TestSlot})")),
                        "every client's pick shows the slot-3 maze", limit: 10);
            Check(others.All(s => lobby.SeatMazeText(s).Contains("test maze")),
                  "pick sync: " + string.Join(" | ", others.Select(s => lobby.SeatMazeText(s))));
            lobby.PressReadyForTest();
            await Until(() => lobby.StartEnabled, "START enabled after host ready", limit: 5);
            Check(true, "START enabled once host + clients are ready");
            lobby.PressStartForTest();
        }

        // -- Arena: a whole match ------------------------------------------
        await Until(() => GetTree().CurrentScene is OnlineFfaArena, "OnlineFfaArena scene", limit: 30);
        var arena = (OnlineFfaArena)GetTree().CurrentScene;
        if (FfaTestShots.CanShoot(_shotDir)) _ = FfaTestShots.Watch(this, arena, _shotDir!, $"rm{_scenario}_{_role}_");

        // 1. Live, puppets, runner rule
        await Until(() => arena.MatchLive, "MatchLive", limit: 60);
        _bw = new FfaTestShots.Bw(_nm);
        Check(arena.PuppetCount == 3, $"PuppetCount == {arena.PuppetCount}");
        var seats = OnlineGameState.FfaRoster.Select(e => e.Seat).OrderBy(s => s).ToList();
        int nSeats = seats.Count, k = seats.IndexOf(mySeat);
        int expectMaze = seats[(k + OnlineGameState.FfaRotationOffset) % nSeats];
        Check(arena.LocalMazeSeat == expectMaze,
              $"runner rule: layout {k} runs layout ({k}+{OnlineGameState.FfaRotationOffset})%{nSeats} = maze {expectMaze} " +
              $"(LocalMazeSeat {arena.LocalMazeSeat})");
        Check(arena.WorldSeats.SequenceEqual(seats), $"world [{S(arena.WorldSeats)}] == roster [{S(seats)}]");

        others = seats.Where(s => s != mySeat).ToList();
        await Gather("role", _role, others);
        var seatOf = new Dictionary<string, int> { [_role] = mySeat };
        foreach (var (s, r) in _msgs["role"]) seatOf[r] = s;
        Check(seatOf.Count == 4 && seatOf.Values.Distinct().Count() == 4, "4 roles -> 4 seats: " +
              string.Join(" ", seatOf.OrderBy(kv => kv.Value).Select(kv => $"{kv.Key}={kv.Value}")));
        int H = seatOf["host"], C1 = seatOf["c1"], C2 = seatOf["c2"], C3 = seatOf["c3"];
        Check(H == 0 && H == OnlineGameState.FfaHostSeat, $"host is seat 0 and FfaHostSeat ({OnlineGameState.FfaHostSeat})");

        Check(OnlineGameState.FfaRotationOffset == 1, $"first match offset {OnlineGameState.FfaRotationOffset} == 1");

        // -- The host kills c1, c2, c3 -> everyone on the end screen --------
        await Gather("pre_kill", "", others);
        if (_isHost)
            foreach (int victim in new[] { C1, C2, C3 })
            {
                await Kill(arena, victim);
                bool dead = await WaitFor(() => arena.Match.EliminationOrder.Contains(victim), 10);
                Check(dead, $"seat {victim} eliminated");
            }
        bool ended = await WaitFor(() => arena.Ended, 30);
        _bw?.Report(_role);
        string want = $"{H},{C3},{C2},{C1}";
        Check(ended && S(arena.FinalPlacements) == want,
              $"Ended with FinalPlacements [{S(arena.FinalPlacements)}] == [host,c3,c2,c1] = [{want}]");
        await Until(() => arena.RematchAvailable, "RematchAvailable on the end screen", limit: 10);
        Check(Remaining(arena).Count == 4, $"4 remaining seats [{S(Remaining(arena))}]");
        await Gather("ended", "", others);

        switch (_scenario)
        {
            case "A": await ScenarioA(arena, mySeat, H, C1, C2, C3); break;
            case "B": await ScenarioB(arena, mySeat, H, C1, C2, C3); break;
            case "C": await ScenarioC(arena, mySeat, H, C1, C2, C3); break;
        }
    }

    // -- Scenarios ------------------------------------------------------------

    /// A: c3 exits; host Rotate, c1 Rotate, c2 Same -> rotate over 3 seats (offset 2).
    async Task ScenarioA(OnlineFfaArena arena, int mySeat, int H, int C1, int C2, int C3)
    {
        if (_role == "c3") { await PressExit(arena); return; }

        var three = new List<int> { H, C1, C2 }.OrderBy(s => s).ToList();
        await Until(() => arena.RematchAvailable && Remaining(arena).SequenceEqual(three),
                    $"RematchAvailable with 3 remaining seats [{S(three)}]", limit: 15);
        Check(true, $"c3 left: remaining [{S(Remaining(arena))}], RematchAvailable");
        var peers = three.Where(s => s != mySeat).ToList();
        await Gather("a_left", "", peers);

        // Sequential votes (each voter waits for the previous vote to arrive).
        if (_role == "host") arena.DebugVoteRematch(rotate: true);
        if (_role == "c1")
        {
            await Until(() => arena.RematchTally == (0, 1), "host's Rotate vote", limit: 10);
            arena.DebugVoteRematch(rotate: true);
        }
        if (_role == "c2")
        {
            await Until(() => arena.RematchTally == (0, 2), "host's and c1's Rotate votes", limit: 10);
            arena.DebugVoteRematch(rotate: false);
        }
        if (FfaTestShots.CanShoot(_shotDir)) await FfaTestShots.Save(this, _shotDir!, $"rm{_scenario}_{_role}_6_vote_row");
        await AssertRematch(arena, mySeat, peers, rosterCount: 3, offset: 2, puppets: 2);
    }

    /// B: all four stay; Same, Same, Rotate, (tally 2-1 everywhere), Rotate -> 2-2 tie -> host's Same (offset 1).
    async Task ScenarioB(OnlineFfaArena arena, int mySeat, int H, int C1, int C2, int C3)
    {
        var peers = new[] { H, C1, C2, C3 }.Where(s => s != mySeat).ToList();
        if (_role == "host") arena.DebugVoteRematch(rotate: false);
        if (_role == "c1")
        {
            await Until(() => arena.RematchTally == (1, 0), "host's Same vote", limit: 10);
            arena.DebugVoteRematch(rotate: false);
        }
        if (_role == "c2")
        {
            await Until(() => arena.RematchTally == (2, 0), "host's and c1's Same votes", limit: 10);
            arena.DebugVoteRematch(rotate: true);
        }
        bool saw = await WaitFor(() => arena.RematchTally == (2, 1), 10);
        Check(saw && arena.RematchTally == (2, 1) && arena.RematchAvailable && !arena.RematchStarting,
              $"after 3 votes RematchTally {arena.RematchTally} == (2, 1), no decision yet");
        await Gather("b_tally", arena.RematchTally.ToString(), peers);
        foreach (var (s, v) in _msgs["b_tally"]) Check(v == "(2, 1)", $"seat {s} saw tally {v}");
        if (_role == "c3") arena.DebugVoteRematch(rotate: true);
        await AssertRematch(arena, mySeat, peers, rosterCount: 4, offset: 1, puppets: 3);
    }

    /// C: c1 Rotate, c2 Rotate, c3 Same; the host exits without voting. The new
    /// host (lowest remaining seat) decides Rotate 2-1 over 3 seats (offset 2).
    async Task ScenarioC(OnlineFfaArena arena, int mySeat, int H, int C1, int C2, int C3)
    {
        var all = new[] { H, C1, C2, C3 }.Where(s => s != mySeat).ToList();
        if (_role == "c1") arena.DebugVoteRematch(rotate: true);
        if (_role == "c2")
        {
            await Until(() => arena.RematchTally == (0, 1), "c1's Rotate vote", limit: 10);
            arena.DebugVoteRematch(rotate: true);
        }
        if (_role == "c3")
        {
            await Until(() => arena.RematchTally == (0, 2), "c1's and c2's Rotate votes", limit: 10);
            arena.DebugVoteRematch(rotate: false);
        }
        bool saw = await WaitFor(() => arena.RematchTally == (1, 2), 10);
        Check(saw && !arena.RematchStarting, $"after 3 votes RematchTally {arena.RematchTally} == (1, 2), host not voted");
        await Gather("c_tally", "", all);

        if (_isHost) { await PressExit(arena); return; }

        var three   = new List<int> { C1, C2, C3 }.OrderBy(s => s).ToList();
        int newHost = three[0];
        var peers   = three.Where(s => s != mySeat).ToList();
        // Snapshot the old scene in the 0.4 s window between rematch_go and the reload.
        bool starting = await WaitFor(() => IsInstanceValid(arena) && arena.RematchStarting, 15);
        Check(starting, "rematch started after the host left");
        if (starting)
        {
            Check(OnlineGameState.FfaHostSeat == newHost,
                  $"FfaHostSeat {OnlineGameState.FfaHostSeat} == lowest remaining seat {newHost}");
            var rem = Remaining(arena);
            Check(rem.SequenceEqual(three), $"remaining [{S(rem)}] == [{S(three)}]");
            var (same, rotate) = arena.RematchTally;
            Check((same, rotate) == (1, 2), $"all 3 remaining voted: tally ({same}, {rotate}) == (1, 2)");
            Check(OnlineGameState.FfaRoster.Count == 3 && OnlineGameState.FfaRotationOffset == 2,
                  $"new host's rematch_go applied: roster {OnlineGameState.FfaRoster.Count}, offset {OnlineGameState.FfaRotationOffset}");
        }
        await AssertRematch(arena, mySeat, peers, rosterCount: 3, offset: 2, puppets: 2);
    }

    /// Wait for the reloaded arena and check roster / offset / live / puppets /
    /// runner rule; compare with `peers`, then hold ~4.5 s so a slower peer
    /// doesn't see our quit as a leave before its own checks.
    async Task AssertRematch(OnlineFfaArena oldArena, int mySeat, List<int> peers, int rosterCount, int offset, int puppets)
    {
        await Until(() => GetTree().CurrentScene is OnlineFfaArena a && a != oldArena, "reloaded OnlineFfaArena", limit: 20);
        var arena = (OnlineFfaArena)GetTree().CurrentScene;
        if (FfaTestShots.CanShoot(_shotDir)) _ = FfaTestShots.Watch(this, arena, _shotDir!, $"rm{_scenario}_{_role}_rematch_");
        await Until(() => arena.MatchLive, "rematch MatchLive", limit: 60);
        var seats = OnlineGameState.FfaRoster.Select(e => e.Seat).OrderBy(s => s).ToList();
        Check(seats.Count == rosterCount, $"FfaRoster.Count {seats.Count} == {rosterCount} [{S(seats)}]");
        Check(OnlineGameState.FfaRotationOffset == offset, $"FfaRotationOffset {OnlineGameState.FfaRotationOffset} == {offset}");
        Check(arena.PuppetCount == puppets, $"PuppetCount {arena.PuppetCount} == {puppets}");
        Check(!arena.Ended && arena.Match.EliminationOrder.Count == 0, "fresh match: not ended, nobody eliminated");
        int k = seats.IndexOf(mySeat);
        int expectMaze = k < 0 ? -2 : seats[(k + OnlineGameState.FfaRotationOffset) % seats.Count];
        Check(arena.LocalMazeSeat == expectMaze,
              $"runner rule: layout {k} runs layout ({k}+{OnlineGameState.FfaRotationOffset})%{seats.Count} = maze {expectMaze} " +
              $"(LocalMazeSeat {arena.LocalMazeSeat})");
        Check(arena.WorldSeats.SequenceEqual(seats), $"world [{S(arena.WorldSeats)}] == roster [{S(seats)}]");
        string sum = $"{S(seats)}|{OnlineGameState.FfaRotationOffset}|{S(arena.WorldSeats)}";
        await Gather("rematch_live", sum, peers, limit: 30);
        foreach (var (s, v) in _msgs["rematch_live"]) Check(v == sum, $"seat {s} agrees roster|offset|world = {v} (mine {sum})");
        for (int i = 0; i < 6; i++) { Say("rematch_live", sum); await Wait(0.75); }
        Finish();
    }

    /// Emits Pressed on the end screen's real "Exit to Menu" button.
    async Task PressExit(OnlineFfaArena arena)
    {
        var btn = arena.FindChildren("*", "Button", true, false).OfType<Button>()
                       .FirstOrDefault(b => b.Text == "Exit to Menu");
        Check(btn != null, "end screen has an Exit to Menu button");
        btn?.EmitSignal(BaseButton.SignalName.Pressed);
        await Wait(1.0);
        Finish();
    }

    /// The arena's private remaining set (live roster seats minus dropped), sorted.
    static List<int> Remaining(OnlineFfaArena arena)
    {
        var p = typeof(OnlineFfaArena).GetProperty("RematchRemaining", BindingFlags.NonPublic | BindingFlags.Instance)
                ?? throw new MissingMemberException(nameof(OnlineFfaArena), "RematchRemaining");
        return (List<int>)p.GetValue(arena)!;
    }

    // -- Test messaging -------------------------------------------------------

    readonly Dictionary<string, Dictionary<int, string>> _msgs = new();

    void OnTestData(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            var r = doc.RootElement;
            if (!r.TryGetProperty("t", out var t) || t.GetString() != "test_rm") return;
            string key = r.GetProperty("k").GetString()!;
            if (!_msgs.TryGetValue(key, out var byFrom)) _msgs[key] = byFrom = new();
            byFrom[r.GetProperty("from").GetInt32()] = r.GetProperty("v").GetString()!;
        }
        catch { }
    }

    void Say(string key, string v = "") =>
        _nm.SendGameData($"{{\"t\":\"test_rm\",\"k\":{JsonSerializer.Serialize(key)},\"v\":{JsonSerializer.Serialize(v)}}}");

    bool Heard(string key, int from) => _msgs.TryGetValue(key, out var m) && m.ContainsKey(from);

    /// Phase barrier + value exchange: repeat our value for `key` every second
    /// until every seat in `from` has sent theirs.
    async Task Gather(string key, string v, IEnumerable<int> from, double limit = 20)
    {
        var need = from.ToList();
        double since = 99;
        await Until(() =>
        {
            since += GetProcessDeltaTime();
            if (since > 1.0) { since = 0; Say(key, v); }
            return need.All(s => Heard(key, s));
        }, $"'{key}' from seats [{S(need)}]", limit);
    }

    /// Host: 3 x 40 on `seat`'s puppet, 0.3 s apart (the real hit path).
    async Task Kill(OnlineFfaArena arena, int seat)
    {
        for (int i = 0; i < 3; i++)
        {
            arena.DebugDamageSeat(seat, 40f);
            await Wait(0.3);
        }
    }

    static bool Near(float a, float b) => Math.Abs(a - b) <= 1f;
    static string S(IEnumerable<int> e) => string.Join(",", e);

    /// Non-fatal timed wait: true if `cond` held within `limit` seconds.
    async Task<bool> WaitFor(Func<bool> cond, double limit)
    {
        double t = 0;
        while (!cond())
        {
            await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame);
            t += GetProcessDeltaTime();
            if (t > limit) return false;
        }
        return true;
    }

    void Finish()
    {
        DirAccess.RemoveAbsolute(ProjectSettings.GlobalizePath(AccountManager.MazeSlotPath(TestSlot)));
        DirAccess.RemoveAbsolute(ProjectSettings.GlobalizePath(AccountManager.ProfilePath()));
        GD.Print(_fail == 0 ? "ALL PASS" : $"{_fail} FAILED");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }

    // -- Helpers ------------------------------------------------------------

    // Open seats render as "Open seat".
    static bool Occupied(FfaPreGameLobby l, int s)
    {
        string t = l.SeatNameText(s);
        return t != "" && t != "Open seat";
    }

    /// Emits Pressed on the enabled Invite button in the row labelled `name`.
    static bool PressInvite(FfaPreGameLobby lobby, string name)
    {
        var list = Field<VBoxContainer>(lobby, "_inviteList");
        foreach (var row in list.GetChildren().OfType<HBoxContainer>())
        {
            var lbl = row.GetChildren().OfType<Label>().FirstOrDefault();
            var btn = row.GetChildren().OfType<Button>().FirstOrDefault();
            if (lbl == null || btn == null || lbl.Text != name || btn.Disabled || row.IsQueuedForDeletion()) continue;
            btn.EmitSignal(BaseButton.SignalName.Pressed);
            return true;
        }
        return false;
    }

    static T Field<T>(object o, string name)
    {
        var f = o.GetType().GetField(name, BindingFlags.NonPublic | BindingFlags.Instance)
                ?? throw new MissingFieldException(o.GetType().Name, name);
        return (T)f.GetValue(o)!;
    }

    async Task Wait(double s) => await ToSignal(GetTree().CreateTimer(s), SceneTreeTimer.SignalName.Timeout);

    async Task Until(Func<bool> cond, string what, double limit = 30)
    {
        double t = 0;
        while (!cond())
        {
            await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame);
            t += GetProcessDeltaTime();
            if (t > limit) { Check(false, $"timed out waiting for {what}"); GD.Print($"{_fail} FAILED"); GetTree().Quit(1); await Wait(999); }
        }
    }
}
