- [ ] **Step 3: Implement SelectCategory and fold tab styling into RefreshPalette**

In `scripts/MazeEditor3D.cs`, replace `RefreshPalette()` (lines 1746-1755) with:

```csharp
    void SelectCategory(PieceCategory cat)
    {
        _selCat = cat;
        RefreshPalette();
        _clickSfx?.Play();
    }

    void RefreshPalette()
    {
        foreach (var (pt, panel) in _palPan)
        {
            // Cells outside the active tab are hidden, not destroyed — their
            // thumbnail SubViewports stay alive and keep rendering.
            panel.Visible = PieceDB.CategoryOf(pt) == _selCat;

            bool sel = _selType == pt;
            // Selected: subtle warm tint; unselected: fully transparent (floating look)
            panel.AddThemeStyleboxOverride("panel",
                Flat(sel ? new Color(0.20f, 0.17f, 0.03f, 0.75f) : new Color(0, 0, 0, 0)));
        }

        foreach (var (cat, btn) in _catBtn)
        {
            bool active = cat == _selCat;
            btn.AddThemeColorOverride("font_color",
                active ? new Color(1f, 0.86f, 0.35f) : new Color(0.55f, 0.55f, 0.55f));
            btn.AddThemeStyleboxOverride("normal",
                Flat(active ? new Color(0.16f, 0.13f, 0.03f, 0.9f) : new Color(0, 0, 0, 0),
                     active ? new Color(0.85f, 0.70f, 0.25f, 0.8f) : new Color(0.35f, 0.35f, 0.35f, 0.5f)));
            btn.AddThemeStyleboxOverride("hover",
                Flat(new Color(0.22f, 0.19f, 0.06f, 0.9f), new Color(0.85f, 0.70f, 0.25f, 0.8f)));
            btn.AddThemeStyleboxOverride("pressed",
                Flat(new Color(0.26f, 0.22f, 0.07f, 0.95f), new Color(1f, 0.86f, 0.35f, 0.9f)));
        }
    }
```

