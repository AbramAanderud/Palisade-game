using Godot;
using System;

/// res://scripts/AltarBuilder.cs
/// The weapon altar at the arena centre: a stepped stone plinth the player walks
/// up onto, with the arena weapon hovering above its platform.
///
/// Deliberately NOT part of ArenaBuilder. All three arenas (DungeonArena,
/// OnlineDungeonArena, TrainingArena) call ArenaBuilder.Build, but training has
/// no weapon to claim — so the altar is spawned by the scenes that want it
/// rather than baked into the shared arena. ArenaBuilder is also already ~1250
/// lines carrying walls/dome/shelves/tiers/curtains; this has one job.
///
/// ── PHYSICS: visual steps carry no collision; an invisible cone does ─────────
/// This mirrors the project's settled stair architecture (see CLAUDE.md
/// "Stair Physics: Visual Steps + Invisible Ramp"). Per-tread collision makes
/// the capsule step off tread edges and go briefly airborne; once airborne,
/// horizontal momentum arcs the player instead of snapping them to the next
/// step, which feels like flying. A single smooth cone eliminates that.
///
/// Cone angle here is atan(Height / StepRun*Steps) = atan(2.5 / 3.5) ≈ 35.6°,
/// comfortably under PlayerController.FloorMaxAngle (68°). If Height or the
/// step run changes, re-check that margin.
public partial class AltarBuilder : Node3D
{
    // ── dimensions ────────────────────────────────────────────────────────────
    // Sized to read as a monument without swallowing the fight: 13m across
    // against the arena's 60m span (~21%).
    public const float TopRadius = 3.0f;    // platform you stand on
    public const int   Steps     = 10;
    public const float StepRise  = 0.25f;
    public const float StepRun   = 0.35f;
    public const float Height    = Steps * StepRise;                 // 2.5 m
    public const float BaseRadius = TopRadius + Steps * StepRun;     // 6.5 m
    const int   Sides = 16;                                          // 16-gon rings

    /// Where the weapon should hover, relative to the altar's centre. Scenes use
    /// this to place the pickup instead of hardcoding a height, so the two can
    /// never drift apart.
    public static Vector3 WeaponAnchor => new(0f, Height + 1.9f, 0f);

    // Coarser, larger-block stone than the arena walls so the altar reads as a
    // separate monument rather than more of the same masonry.
    const string AltarStoneSrc = @"
shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx, cull_disabled;
uniform vec3 base_color  : source_color = vec3(0.38, 0.35, 0.31);
uniform vec3 mortar_color: source_color = vec3(0.17, 0.16, 0.15);
uniform float block_scale = 0.16;
varying vec3 wpos; varying vec3 wnorm;
void vertex(){
    wpos  = (MODEL_MATRIX * vec4(VERTEX,1.0)).xyz;
    wnorm = normalize((MODEL_MATRIX * vec4(NORMAL,0.0)).xyz);
}
float hash21(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453); }
float vn2(vec2 p){
    vec2 i=floor(p), f=fract(p); f=f*f*(3.0-2.0*f);
    return mix(mix(hash21(i),hash21(i+vec2(1,0)),f.x),
               mix(hash21(i+vec2(0,1)),hash21(i+vec2(1,1)),f.x), f.y);
}
void fragment(){
    // triplanar-ish block grid: horizontal faces tile in XZ, vertical in XY/ZY
    vec3 n = abs(wnorm);
    vec2 uv;
    if (n.y > n.x && n.y > n.z) uv = wpos.xz * block_scale;
    else if (n.x > n.z)         uv = wpos.zy * block_scale;
    else                        uv = wpos.xy * block_scale;
    vec2 cell = floor(vec2(uv.x + mod(floor(uv.y), 2.0) * 0.5, uv.y));
    vec2 f    = fract(vec2(uv.x + mod(floor(uv.y), 2.0) * 0.5, uv.y));
    float m   = step(0.06, f.x) * step(f.x, 0.94) * step(0.06, f.y) * step(f.y, 0.94);
    float h   = (hash21(cell) - 0.5) * 0.20;
    vec3 blk  = clamp(base_color + vec3(h, h * 0.9, h * 0.75), vec3(0.0), vec3(1.0));
    // grime settling into the lower steps
    blk *= 0.72 + 0.28 * vn2(wpos.xz * 0.7);
    ALBEDO = mix(mortar_color, blk, m);
    ROUGHNESS = 0.94; METALLIC = 0.0;
}";

    /// Builds the altar at `centre` (world space, y = arena floor level).
    public void Build(Vector3 centre)
    {
        Position = centre;

        var body = new StaticBody3D { Name = "AltarBody" };
        AddChild(body);

        // ── visual steps (no collision — see class doc) ───────────────────────
        var st = MakeST();
        for (int i = 0; i < Steps; i++)
        {
            float rOut = BaseRadius - i * StepRun;
            float rIn  = BaseRadius - (i + 1) * StepRun;
            float yBot = i * StepRise;
            float yTop = (i + 1) * StepRise;

            for (int s = 0; s < Sides; s++)
            {
                // riser: vertical band at rOut
                Quad(st, Ring(s, rOut, yBot), Ring(s + 1, rOut, yBot),
                         Ring(s + 1, rOut, yTop), Ring(s, rOut, yTop));
                // tread: horizontal annulus at yTop, rOut -> rIn
                Quad(st, Ring(s, rOut, yTop), Ring(s + 1, rOut, yTop),
                         Ring(s + 1, rIn, yTop), Ring(s, rIn, yTop));
            }
        }

        // ── top platform cap ──────────────────────────────────────────────────
        for (int s = 0; s < Sides; s++)
            Tri(st, new Vector3(0f, Height, 0f), Ring(s, TopRadius, Height),
                    Ring(s + 1, TopRadius, Height));

        var mesh = Commit(st);
        if (mesh != null)
            AddChild(new MeshInstance3D
            {
                Name = "AltarSteps",
                Mesh = mesh,
                MaterialOverride = new ShaderMaterial { Shader = new Shader { Code = AltarStoneSrc } },
            });

        AddRampCollision(body);
        AddBraziers();
    }

    // ── invisible walk surface ────────────────────────────────────────────────
    // A smooth cone over the step visuals plus a flat cap over the platform.
    // The cone surface sits ON the step nosings, so the player walks along the
    // tops of the steps and never drops into a tread corner.
    void AddRampCollision(StaticBody3D body)
    {
        var st = MakeST();
        for (int s = 0; s < Sides; s++)
        {
            // cone flank: base rim -> platform rim
            Quad(st, Ring(s, BaseRadius, 0f),  Ring(s + 1, BaseRadius, 0f),
                     Ring(s + 1, TopRadius, Height), Ring(s, TopRadius, Height));
            // platform cap
            Tri(st, new Vector3(0f, Height, 0f), Ring(s, TopRadius, Height),
                    Ring(s + 1, TopRadius, Height));
        }
        var mesh = Commit(st);
        if (mesh == null) return;

        var shape = mesh.CreateTrimeshShape();
        shape.BackfaceCollision = true;
        body.AddChild(new CollisionShape3D { Name = "AltarRamp", Shape = shape });
    }

    // ── braziers at the platform rim ──────────────────────────────────────────
    // Four only. gl_compatibility does per-object forward lighting capped by
    // max_lights_per_object (32 in project.godot), so lights here compete with
    // the arena's own torch rings — this is a deliberately small budget.
    void AddBraziers()
    {
        for (int i = 0; i < 4; i++)
        {
            float a = Mathf.Pi * 0.25f + i * Mathf.Pi * 0.5f;
            var p = new Vector3(Mathf.Cos(a) * (TopRadius - 0.55f), Height,
                                Mathf.Sin(a) * (TopRadius - 0.55f));

            var bowl = new MeshInstance3D
            {
                Name = $"Brazier{i}",
                Mesh = new CylinderMesh { TopRadius = 0.34f, BottomRadius = 0.20f, Height = 0.55f, RadialSegments = 10 },
                Position = p + new Vector3(0f, 0.28f, 0f),
                MaterialOverride = new StandardMaterial3D
                {
                    AlbedoColor = new Color(0.14f, 0.12f, 0.10f), Roughness = 0.85f,
                },
            };
            AddChild(bowl);

            AddChild(new OmniLight3D
            {
                Name            = $"BrazierLight{i}",
                Position        = p + new Vector3(0f, 0.75f, 0f),
                LightColor      = new Color(1.0f, 0.60f, 0.22f),
                LightEnergy     = 2.6f,
                OmniRange       = 13f,
                OmniAttenuation = 0.7f,
                ShadowEnabled   = false,
            });
        }
    }

    // ── helpers ───────────────────────────────────────────────────────────────
    static Vector3 Ring(int seg, float r, float y)
    {
        float a = 2f * Mathf.Pi * (seg % Sides) / Sides;
        return new Vector3(Mathf.Sin(a) * r, y, -Mathf.Cos(a) * r);
    }

    static SurfaceTool MakeST()
    { var st = new SurfaceTool(); st.Begin(Mesh.PrimitiveType.Triangles); return st; }

    static ArrayMesh? Commit(SurfaceTool st)
    { st.GenerateNormals(); var m = st.Commit(); return m.GetSurfaceCount() > 0 ? m : null; }

    // Emits a,c,b — i.e. REVERSED from the argument order.
    //
    // Ring() walks counter-clockwise viewed from above, so the natural reading
    // order (a,b,c) yields faces whose normals point DOWN and INWARD. Flipping
    // here rather than at each call site keeps every face consistent and makes
    // GenerateNormals produce outward/upward normals, which is what the shader's
    // lighting expects.
    //
    // This is a LIGHTING fix, not a physics one. A/B tested: TestAltarWalk
    // passes 12/12 with either winding, because AddRampCollision sets
    // BackfaceCollision = true, which makes the trimesh solid from both sides
    // for character physics as well as rays. Do not cite winding as the reason
    // a capsule can or cannot climb this.
    static void Tri(SurfaceTool st, Vector3 a, Vector3 b, Vector3 c)
    { st.AddVertex(a); st.AddVertex(c); st.AddVertex(b); }

    static void Quad(SurfaceTool st, Vector3 a, Vector3 b, Vector3 c, Vector3 d)
    { Tri(st, a, b, c); Tri(st, a, c, d); }
}
