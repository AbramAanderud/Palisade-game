using Godot;
using System.Collections.Generic;
using System.Linq;

/// test/TestPickupReach.cs
/// Proves the arena weapon is actually claimable everywhere it should be, and
/// not claimable where it shouldn't.
///
/// The altar raised the weapon to AltarBuilder.WeaponAnchor (4.4m). The pickup
/// Area3D radius was left at its pre-altar 2.5m, which silently stopped
/// reaching the outer ring of the platform — the weapon looked fine and simply
/// would not respond near the edge. Geometry reasoning is what let that slip,
/// so this asserts against the real Area3D instead.
///
/// Probe bodies are player-sized capsules on layer 1 (PlayerController sets no
/// CollisionLayer, so it uses the CharacterBody3D default of 1, which is what
/// the pickup Area3D masks).
public partial class TestPickupReach : Node3D
{
    readonly List<(string label, Vector3 pos, bool shouldReach)> _cases = new();
    Area3D _area = null!;
    int _frames;

    public override void _Ready()
    {
        var altar = new AltarBuilder { Name = "Altar" };
        AddChild(altar);
        altar.Build(Vector3.Zero);

        var wp = WeaponPickup.Spawn(this, AltarBuilder.WeaponAnchor);

        float top = AltarBuilder.Height;          // platform surface, 2.5
        float er  = AltarBuilder.TopRadius;       // platform edge radius, 3.0
        // Capsule centre sits 0.8 above the surface the feet are on.
        _cases.Add(("platform centre",      new Vector3(0f,        top + 0.8f, 0f),        true));
        _cases.Add(("platform edge +X",     new Vector3(er - 0.4f, top + 0.8f, 0f),        true));
        _cases.Add(("platform edge -Z",     new Vector3(0f,        top + 0.8f, -(er-0.4f)),true));
        _cases.Add(("platform edge diag",   new Vector3(2.0f,      top + 0.8f, 2.0f),      true));
        // Must still require the climb.
        _cases.Add(("arena floor at base",  new Vector3(AltarBuilder.BaseRadius + 0.5f, 0.8f, 0f), false));
        _cases.Add(("halfway up the steps", new Vector3(4.75f,     1.25f + 0.8f, 0f),      false));

        foreach (var (label, pos, _) in _cases)
        {
            var b = new CharacterBody3D { Name = label.Replace(' ', '_'), Position = pos, CollisionLayer = 1, CollisionMask = 0 };
            b.AddChild(new CollisionShape3D { Shape = new CapsuleShape3D { Radius = 0.35f, Height = 1.6f } });
            AddChild(b);
        }

        _area = wp.GetNode<Area3D>("PickupArea");
    }

    public override void _PhysicsProcess(double delta)
    {
        // Area overlap needs a couple of physics ticks to register.
        if (++_frames < 6) return;

        var overlapping = _area.GetOverlappingBodies().Select(b => b.Name.ToString()).ToHashSet();
        int fail = 0;
        void P(string l) => GD.Print("[Reach] " + l);

        P("──────────────────────────────────────────────");
        P($"weapon anchor y={AltarBuilder.WeaponAnchor.Y:F2}m   pickup radius={WeaponPickup.PickupRadius:F2}m");
        foreach (var (label, pos, should) in _cases)
        {
            bool got = overlapping.Contains(label.Replace(' ', '_'));
            bool ok  = got == should;
            if (!ok) fail++;
            P($"  {label,-22} reach={got,-5} expected={should,-5} {(ok ? "ok" : "MISMATCH")}");
        }
        P(fail == 0
            ? "PASS — claimable across the whole platform, not from the floor or steps"
            : $"FAIL — {fail} case(s) wrong");
        P("──────────────────────────────────────────────");
        GetTree().Quit(fail == 0 ? 0 : 1);
    }
}
