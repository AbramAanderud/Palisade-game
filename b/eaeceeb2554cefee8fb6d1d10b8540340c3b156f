using Godot;

/// Regression harness for settings persistence.
///
/// Covers the three things that actually break silently:
///   1. the machine/account SPLIT — display settings must not leak into the
///      account file, and reticle/keybinds must not leak into the machine file
///   2. survival across sign-out/in — switching away and back must restore the
///      account's own reticle and bindings, not the other account's
///   3. Discard — must put values AND key bindings back, not just the flag
///
/// Uses throwaway account names and restores whatever account was active, so
/// running it does not disturb a real profile.
public partial class TestSettingsPersistence : Node
{
    const string AccA = "__test_persist_a";
    const string AccB = "__test_persist_b";

    public override void _Ready()
    {
        var gs = GameSettings.Instance;
        if (gs == null) { GD.Print("[TestSettingsPersistence] PASS=False (no autoload)"); GetTree().Quit(); return; }

        string originalAccount = AccountManager.ActiveAccount;
        bool pass = true;

        // ── Account A: pick a distinctive config and save it ──────────────────
        AccountManager.SwitchOrCreate(AccA);
        gs.ReloadForAccount();

        gs.SetReticleColor(new Color(0f, 1f, 1f, 1f));      // cyan
        gs.SetReticleSize(17f);
        gs.SetMouseSensitivity(4.25f);
        gs.SetBinding("jump", new InputEventKey { PhysicalKeycode = Key.G });
        gs.SetFullscreen(false);                             // machine-scoped

        pass &= Check("dirty after edits", gs.Dirty);
        gs.SaveChanges();
        pass &= Check("clean after save", !gs.Dirty);

        // ── The split: each store holds only what belongs to it ───────────────
        var acct = new ConfigFile();
        var acctErr = acct.Load($"user://accounts/{AccA}/settings.cfg");
        pass &= Check("account file written", acctErr == Error.Ok);
        pass &= Check("account holds reticle",  acct.HasSection("reticle"));
        pass &= Check("account holds keybinds", acct.HasSection("keybinds"));
        pass &= Check("account has NO display", !acct.HasSection("display"));

        var mach = new ConfigFile();
        var machErr = mach.Load("user://settings.cfg");
        pass &= Check("machine file written",   machErr == Error.Ok);
        pass &= Check("machine holds display",  mach.HasSection("display"));
        pass &= Check("machine has NO reticle", !mach.HasSection("reticle"));
        pass &= Check("machine has NO keybinds", !mach.HasSection("keybinds"));

        // ── Account B: a fresh account must NOT inherit A's preferences ───────
        AccountManager.SwitchOrCreate(AccB);
        gs.ReloadForAccount();
        GD.Print($"[TestSettingsPersistence] B sens={gs.MouseSensitivity} size={gs.ReticleSize} jump={Bind("jump")}");
        pass &= Check("B did not inherit A's sensitivity", Mathf.Abs(gs.MouseSensitivity - 4.25f) > 0.01f);
        pass &= Check("B did not inherit A's binding",     Bind("jump") != "G");

        // ── Back to A: everything comes back ──────────────────────────────────
        AccountManager.SwitchOrCreate(AccA);
        gs.ReloadForAccount();
        GD.Print($"[TestSettingsPersistence] A sens={gs.MouseSensitivity} size={gs.ReticleSize} jump={Bind("jump")}");
        pass &= Check("A sensitivity restored", Mathf.Abs(gs.MouseSensitivity - 4.25f) < 0.01f);
        pass &= Check("A reticle size restored", Mathf.Abs(gs.ReticleSize - 17f) < 0.01f);
        pass &= Check("A binding restored",      Bind("jump") == "G");

        // ── Discard: values and InputMap both revert ──────────────────────────
        gs.SetMouseSensitivity(9f);
        gs.SetBinding("jump", new InputEventKey { PhysicalKeycode = Key.H });
        pass &= Check("binding applied live before discard", Bind("jump") == "H");
        gs.DiscardChanges();
        GD.Print($"[TestSettingsPersistence] after discard sens={gs.MouseSensitivity} jump={Bind("jump")}");
        pass &= Check("discard restored sensitivity", Mathf.Abs(gs.MouseSensitivity - 4.25f) < 0.01f);
        pass &= Check("discard restored binding",     Bind("jump") == "G");
        pass &= Check("clean after discard",          !gs.Dirty);

        // ── Cleanup ───────────────────────────────────────────────────────────
        // Switch away BEFORE deleting -- DeleteAccount will not remove the account
        // that is currently active, which otherwise leaves a stray test profile
        // sitting in the user's account list.
        if (!string.IsNullOrEmpty(originalAccount))
        {
            AccountManager.SwitchOrCreate(originalAccount);
            gs.ReloadForAccount();
        }
        AccountManager.DeleteAccount(AccA);
        AccountManager.DeleteAccount(AccB);

        GD.Print($"[TestSettingsPersistence] PASS={pass}");
        GetTree().Quit();
    }

    static bool Check(string what, bool ok)
    {
        GD.Print($"[TestSettingsPersistence]   {(ok ? "ok  " : "FAIL")} {what}");
        return ok;
    }

    static string Bind(string action)
    {
        if (!InputMap.HasAction(action)) return "-";
        foreach (var ev in InputMap.ActionGetEvents(action))
            if (ev is InputEventKey or InputEventMouseButton)
                return ev.AsText().Replace(" (Physical)", "").Replace(" - Physical", "").Trim();
        return "-";
    }
}
