using System.Collections.Generic;
using Godot;

/// Lays all eight traps out in one corridor and steps a camera down it.
/// Prints the piece at each waypoint so captured frames can be matched to traps.
public partial class TestTrapsGeo : Node3D
{
    Camera3D _cam = null!;
    int      _frame = 0;

    const float CS = DungeonBuilder.CellSize;

    static readonly PieceType[] Row =
    {
        PieceType.TrapIce, PieceType.TrapTar, PieceType.TrapDark, PieceType.TrapDoor,
        PieceType.TrapGate, PieceType.TrapPush, PieceType.TrapPortal, PieceType.TrapGrease,
    };

    public override void _Ready()
    {
        var worldEnv = new WorldEnvironment();
        worldEnv.Environment = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0f, 0f, 0f),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(0.30f, 0.26f, 0.22f),
            AmbientLightEnergy = 0.9f,
            TonemapMode        = Godot.Environment.ToneMapper.Filmic,
            TonemapExposure    = 1.3f,
        };
        AddChild(worldEnv);

        AddChild(new DirectionalLight3D
        {
            Name        = "TestSun",
            LightColor  = new Color(1f, 0.95f, 0.85f),
            LightEnergy = 1.4f,
            Rotation    = new Vector3(-0.7f, 0.5f, 0f),
        });

        var pieces = new List<MazePiece>
        {
            new() { Type = PieceType.Start, X = 4, Y = 0, Floor = 0, Rotation = 0 },
        };
        for (int i = 0; i < Row.Length; i++)
            pieces.Add(new MazePiece { Type = Row[i], X = 4, Y = i + 1, Floor = 0, Rotation = 0 });
        pieces.Add(new MazePiece { Type = PieceType.Exit, X = 4, Y = 9, Floor = 0, Rotation = 0 });

        var dungeon = new DungeonBuilder();
        AddChild(dungeon);
        dungeon.Build(new MazeData { Name = "TrapsGeo", Pieces = pieces });

        _cam = new Camera3D { Fov = 75f, Current = true, Far = 500f };
        AddChild(_cam);
        Place(0);
    }

    void Place(int i)
    {
        int y = Mathf.Clamp(i, 0, Row.Length - 1);
        _cam.Position = new Vector3(4.5f * CS, 3.5f, (y + 0.5f) * CS);
        _cam.Rotation = new Vector3(Mathf.DegToRad(-18f), Mathf.DegToRad(180f), 0f);
        GD.Print($"[frame {i}] looking at {Row[y]}");
    }

    public override void _Process(double delta)
    {
        _frame++;
        int idx = _frame / 2;
        if (idx >= Row.Length) { GetTree().Quit(); return; }
        Place(idx);
    }
}
