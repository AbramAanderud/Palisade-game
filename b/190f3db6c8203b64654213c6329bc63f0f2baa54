using Godot;
using System.Collections.Generic;
using System.Linq;

/// Task 7 (Polish): collision + clearance verification for manor furniture
/// (tables, corridor bookshelves) added by PieceVariants.AddManorFurniture.
///
/// Builds a single long Straight corridor (20 cells) so the ~40% Fnv-gated
/// placement rate produces several tables/bookshelves deterministically (same
/// outcome every run — no seeding needed).
///
/// Checks:
///   1. DISCOVERY — logs every "ManorFurnitureCollider" group member found
///      (table + bookshelf StaticBody3D boxes) with world position/size.
///   2. DRIVE (no penetration) — mirrors TestShelfCollision.cs: drives a
///      capsule (matches PlayerController's collision capsule) straight into
///      the first discovered collider at slide speed; final resting distance
///      must not overshoot the collider's near face by more than a small
///      sweep epsilon.
///   3. CLEARANCE SWEEP — for every corridor cell, raycasts east and west
///      from the centreline at a height (0.3m) that intersects BOTH table
///      (~0.75m tall) and bookshelf (3m tall) collision boxes; the sum of the
///      two hit distances is the clear corridor width at that cross-section.
///      Must stay >= 3.4m everywhere (OpeningW=6m, protrusion cap 1.3m rule),
///      and must never be blocked in a doorway-adjacent cell (none should be
///      — furniture placement already excludes those).
public partial class TestFurnitureCollision : Node3D
{
    const float CapsuleRadius = 0.35f;
    const float CapsuleHeight = 1.6f;
    const float DriveSpeed    = 32.0f;
    const float TestDurationSec = 6.0f;
    const int   SettleFrames    = 10;

    const float CellSize = DungeonBuilder.CellSize;
    const float OpeningW = DungeonBuilder.OpeningW;
    const int   CellX    = 5;
    const int   RunLen   = 20;   // Straight cells Y=1..RunLen

    float _cx;
    CharacterBody3D _capsule = null!;
    float _driveSign;
    float _maxAllowedU;
    float _maxU;
    int   _settleLeft = SettleFrames;
    float _t;
    bool  _finished;
    bool  _hasDriveTarget;

    public override void _Ready()
    {
        var env = new WorldEnvironment
        {
            Environment = new Godot.Environment
            {
                AmbientLightSource = Godot.Environment.AmbientSource.Color,
                AmbientLightColor  = new Color(0.4f, 0.4f, 0.4f),
                AmbientLightEnergy = 1.0f,
            }
        };
        AddChild(env);

        var data = new MazeData { Name = "FurnitureTest" };
        data.Pieces = new List<MazePiece> { new() { Type = PieceType.Start, X = CellX, Y = 0, Floor = 0, Rotation = 0 } };
        for (int y = 1; y <= RunLen; y++)
            data.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = CellX, Y = y, Floor = 0, Rotation = 0 });
        data.Pieces.Add(new MazePiece { Type = PieceType.Exit, X = CellX, Y = RunLen + 1, Floor = 0, Rotation = 0 });

        var builder = new DungeonBuilder { Name = "Maze" };
        AddChild(builder);
        builder.Build(data);

        _cx = CellX * CellSize + CellSize * 0.5f;

        Discover(builder);
        ClearanceSweep();
        SetupDrive();
    }

    void Discover(Node root)
    {
        var found = GetTree().GetNodesInGroup("ManorFurnitureCollider");
        GD.Print($"[TestFurnitureCollision][DISCOVER] {found.Count} manor-furniture colliders found in a {RunLen}-cell run");
        foreach (var n in found)
        {
            if (n is not StaticBody3D sb) continue;
            var cs = sb.GetNodeOrNull<CollisionShape3D>("Box");
            if (cs == null || cs.Shape is not BoxShape3D box) continue;
            var pos = cs.GlobalPosition;
            GD.Print($"[TestFurnitureCollision][DISCOVER] {sb.Name} pos=({pos.X:F2},{pos.Y:F2},{pos.Z:F2}) size=({box.Size.X:F2},{box.Size.Y:F2},{box.Size.Z:F2})");
        }
    }

    // Samples CONTINUOUSLY along the whole corridor's Z span (0.25m step),
    // not just once per piece centre — furniture is offset along Z (the
    // tangent axis for these E/W-closed pieces) by up to +-2m from the
    // piece centre, so a per-centre-only sample would silently miss every
    // single placement and always read a false "6.000m clear".
    void ClearanceSweep()
    {
        var space = GetWorld3D().DirectSpaceState;
        float minClear = float.MaxValue;
        float minAtZ = -1;
        int violations = 0;
        float zStart = 1 * CellSize;                 // first Straight piece's north edge
        float zEnd   = RunLen * CellSize + CellSize;  // last Straight piece's south edge
        const float DriveY = 0.3f;                    // intersects both table (~0.75m) and bookshelf (3m) boxes
        for (float z = zStart; z <= zEnd; z += 0.25f)
        {
            var from = new Vector3(_cx, DriveY, z);
            var qE = PhysicsRayQueryParameters3D.Create(from, from + new Vector3(10f, 0, 0));
            var qW = PhysicsRayQueryParameters3D.Create(from, from - new Vector3(10f, 0, 0));
            var hitE = space.IntersectRay(qE);
            var hitW = space.IntersectRay(qW);

            float distE = hitE.Count > 0 ? ((Vector3)hitE["position"] - from).Length() : -1f;
            float distW = hitW.Count > 0 ? ((Vector3)hitW["position"] - from).Length() : -1f;
            if (distE < 0f || distW < 0f)
            {
                GD.Print($"[TestFurnitureCollision][CLEARANCE] z={z:F2} NO HIT one side (distE={distE:F2} distW={distW:F2}) — gap in wall geometry?");
                violations++;
                continue;
            }
            float clear = distE + distW;
            if (clear < minClear) { minClear = clear; minAtZ = z; }
            if (clear < 3.4f)
            {
                GD.Print($"[TestFurnitureCollision][CLEARANCE] z={z:F2} clear={clear:F3} < 3.4 REQUIRED — VIOLATION (distE={distE:F2} distW={distW:F2})");
                violations++;
            }
        }
        GD.Print($"[TestFurnitureCollision][CLEARANCE] minClear={minClear:F3} at z={minAtZ:F2} (sampled every 0.25m across z=[{zStart:F0},{zEnd:F0}]) violations={violations}");
        GD.Print($"[TestFurnitureCollision][CLEARANCE] PASS={(violations == 0)}");
    }

    void SetupDrive()
    {
        var found = GetTree().GetNodesInGroup("ManorFurnitureCollider").OfType<StaticBody3D>().ToList();
        if (found.Count == 0)
        {
            GD.Print("[TestFurnitureCollision][DRIVE] no colliders found — skipping drive test");
            _hasDriveTarget = false;
            Finish();
            return;
        }

        var target = found[0];
        var cs = target.GetNodeOrNull<CollisionShape3D>("Box");
        var box = (BoxShape3D)cs!.Shape;
        var boxPos = cs.GlobalPosition;

        // The bookshelf's collider is a child of ManorFurniture.BuildBookshelf's
        // root, which PieceVariants rotates via WallBasis(outward) — for an
        // E/W-closed wall that's a 90 deg rotation, so the shape's LOCAL X
        // (width=2.4) lands on WORLD Z and LOCAL Z (depth=0.45) lands on
        // WORLD X. Using box.Size.X directly here would silently assume an
        // unrotated box and under/over-estimate the near face — project the
        // (possibly rotated) box onto the world X axis properly instead.
        var b = cs.GlobalTransform.Basis;
        Vector3 halfLocal = box.Size * 0.5f;
        float worldHalfX = Mathf.Abs(b.X.X) * halfLocal.X + Mathf.Abs(b.Y.X) * halfLocal.Y + Mathf.Abs(b.Z.X) * halfLocal.Z;

        // This maze run is a straight N/S corridor at column CellX, so the
        // only closed walls are E/W — drive along the world X axis, from the
        // corridor centreline toward whichever side the box sits on.
        _driveSign = Mathf.Sign(boxPos.X - _cx);
        if (_driveSign == 0f) _driveSign = 1f;
        float nearFaceU = Mathf.Abs(boxPos.X - _cx) - worldHalfX;   // collapsed 1D coord, u=0 at centreline
        _maxAllowedU = nearFaceU + CapsuleRadius + 0.15f;   // small sweep epsilon, matches TestShelfCollision

        _capsule = new CharacterBody3D { Name = "TestCapsule" };
        _capsule.AddChild(new CollisionShape3D { Shape = new CapsuleShape3D { Radius = CapsuleRadius, Height = CapsuleHeight } });
        _capsule.CollisionMask = 0xFFFFFFFF;
        _capsule.MotionMode = CharacterBody3D.MotionModeEnum.Floating;
        AddChild(_capsule);
        _capsule.GlobalPosition = new Vector3(_cx, 0.3f, boxPos.Z);
        _hasDriveTarget = true;

        GD.Print($"[TestFurnitureCollision][DRIVE] target={target.Name} boxPos=({boxPos.X:F2},{boxPos.Y:F2},{boxPos.Z:F2}) size=({box.Size.X:F2},{box.Size.Y:F2},{box.Size.Z:F2}) nearFaceU={nearFaceU:F3} maxAllowedU={_maxAllowedU:F3}");
    }

    public override void _PhysicsProcess(double delta)
    {
        if (_finished || !_hasDriveTarget) return;
        float dt = (float)delta;

        if (_settleLeft > 0)
        {
            _capsule.Velocity = Vector3.Zero;
            _capsule.MoveAndSlide();
            _settleLeft--;
            return;
        }

        _capsule.Velocity = new Vector3(DriveSpeed * _driveSign, 0f, 0f);
        _capsule.MoveAndSlide();

        _t += dt;
        float u = (_capsule.GlobalPosition.X - _cx) * _driveSign;
        if (u > _maxU) _maxU = u;

        if (_t >= TestDurationSec) Finish();
    }

    void Finish()
    {
        _finished = true;
        if (_hasDriveTarget)
        {
            bool penetrated = _maxU > _maxAllowedU;
            GD.Print($"[TestFurnitureCollision][DRIVE] maxU={_maxU:F3} maxAllowedU={_maxAllowedU:F3} penetrated={penetrated}");
            GD.Print($"[TestFurnitureCollision][DRIVE] PASS={!penetrated}");
        }
        GD.Print("[TestFurnitureCollision] ==== DONE ====");
        GetTree().Quit();
    }
}
