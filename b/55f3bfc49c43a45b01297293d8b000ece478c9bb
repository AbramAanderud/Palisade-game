        ("move_forward",  "Move Forward"),
        ("move_back",     "Move Back"),
        ("move_left",     "Move Left"),
        ("move_right",    "Move Right"),
        ("jump",          "Jump"),
        ("sprint",        "Sprint"),
        ("slide",         "Slide"),
        ("attack",        "Attack"),
        ("block",         "Block"),
        ("aim",           "Aim"),
        ("reload",        "Reload"),
        ("gun_switch",    "Switch Weapon"),
        ("weapon_primary",   "Primary Weapon"),
        ("weapon_secondary", "Secondary Weapon"),
        ("weapon_next",      "Next Weapon"),
        ("weapon_prev",      "Previous Weapon"),
        ("interact",      "Interact"),
        ("toggle_camera", "Toggle Camera"),
        ("pause",         "Pause"),
