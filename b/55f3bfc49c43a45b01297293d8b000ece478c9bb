using Godot;
using System.Collections.Generic;

/// Reusable programmatic settings panel.
/// Add to any scene; call Show() / Hide() to control visibility.
/// Fires Closed when the user clicks Close.
public partial class SettingsPanel : Control
{
    [Signal] public delegate void ClosedEventHandler();

    FontFile?    _font;
    Label?       _accountNameLabel;
    CanvasLayer? _subDialog;          // overlay for Change Name / Switch User / Sign Out

    // Tab state. Pages are stacked full-rect in one host and toggled by Visible
    // rather than added/removed, so each tab keeps its scroll position and its
    // live controls (e.g. the reticle preview) stay alive across tab switches.
    readonly List<Button>  _tabButtons = new();
    readonly List<Control> _tabPages   = new();
    HBoxContainer? _tabBar;
    Button? _saveBtn;

    // Rebind capture state. Non-null _capturingAction means the next key or mouse
    // button pressed becomes that action's binding.
    string? _capturingAction;
    Button? _capturingBtn;
    readonly Dictionary<string, Button> _bindButtons = new();

    static readonly Color TabActive   = Colors.White;
    static readonly Color TabInactive = new(0.48f, 0.48f, 0.48f);

    public override void _Ready()
    {
        _font = GD.Load<FontFile>("res://assets/fonts/Agmena Pro Book.ttf");

        SetAnchorsAndOffsetsPreset(LayoutPreset.FullRect);
        Visible = false;

        // Every entry point into this screen (title screen Show(), pause menu
        // flipping Visible) goes through here, so it is the one reliable place to
        // baseline the snapshot that Discard restores.
        VisibilityChanged += () => { if (Visible) GameSettings.Instance?.BeginEditing(); };

        // This was a 480px card floating over the scene. It is now a full settings
        // screen, so the backdrop is near-opaque -- at fullscreen a translucent dim
        // leaves the menu behind it competing with the controls for attention.
        var bg = new ColorRect { Color = new Color(0.02f, 0.02f, 0.03f, 0.96f) };
        bg.SetAnchorsAndOffsetsPreset(LayoutPreset.FullRect);
        bg.MouseFilter = MouseFilterEnum.Stop;   // block clicks behind the panel
        AddChild(bg);

        var margin = new MarginContainer();
        margin.SetAnchorsAndOffsetsPreset(LayoutPreset.FullRect);
        margin.AddThemeConstantOverride("margin_left",   72);
        margin.AddThemeConstantOverride("margin_right",  72);
        margin.AddThemeConstantOverride("margin_top",    44);
        margin.AddThemeConstantOverride("margin_bottom", 44);
        AddChild(margin);

        var vbox = new VBoxContainer();
        vbox.AddThemeConstantOverride("separation", 14);
        margin.AddChild(vbox);

        var title = new Label { Text = "SETTINGS" };
        if (_font != null) title.AddThemeFontOverride("font", _font);
        title.AddThemeFontSizeOverride("font_size", 34);
        vbox.AddChild(title);

        // -- Tab bar --
        _tabBar = new HBoxContainer();
        _tabBar.AddThemeConstantOverride("separation", 10);
        vbox.AddChild(_tabBar);
        vbox.AddChild(new HSeparator());

        // Pages live in one host that eats the remaining vertical space, so the
        // Close footer stays pinned to the bottom of the screen at any resolution.
        var host = new Control
        {
            SizeFlagsVertical   = SizeFlags.ExpandFill,
            SizeFlagsHorizontal = SizeFlags.ExpandFill,
        };
        vbox.AddChild(host);

        AddTab(host, "Account",  BuildAccountTab());
        AddTab(host, "Reticle",  BuildReticleTab(out var reticlePinned), reticlePinned);
        AddTab(host, "Display",  BuildDisplayTab());
        AddTab(host, "Controls", BuildControlsTab());
        SelectTab(0);

        // -- Footer --
        vbox.AddChild(new HSeparator());

        var footer = new HBoxContainer();
        footer.AddThemeConstantOverride("separation", 12);
        footer.AddChild(new Control { SizeFlagsHorizontal = SizeFlags.ExpandFill });

        _saveBtn = new Button { Text = "Save Changes", CustomMinimumSize = new Vector2(200, 44) };
        if (_font != null) _saveBtn.AddThemeFontOverride("font", _font);
        _saveBtn.AddThemeFontSizeOverride("font_size", 18);
        _saveBtn.AddThemeColorOverride("font_color", new Color(0.30f, 0.90f, 0.40f));
        _saveBtn.Pressed += () => { GameSettings.Instance?.SaveChanges(); ShowSavedDialog(); };
        footer.AddChild(_saveBtn);

        var close = new Button { Text = "Close", CustomMinimumSize = new Vector2(180, 44) };
        if (_font != null) close.AddThemeFontOverride("font", _font);
        close.AddThemeFontSizeOverride("font_size", 18);
        close.Pressed += RequestClose;
        footer.AddChild(close);
        vbox.AddChild(footer);
    }

    // ── Close / save flow ─────────────────────────────────────────────────────

    public override void _Process(double delta)
    {
        // Cheap enough to sync every frame, and it means the button greys out the
        // instant the last edit is saved without every setter having to poke the UI.
        if (Visible && _saveBtn != null)
            _saveBtn.Disabled = !(GameSettings.Instance?.Dirty ?? false);
    }

    /// Close, but refuse to silently throw away edits. Public so the pause menu's
    /// ESC path routes through the same guard instead of just hiding the panel.
    public void RequestClose()
    {
        if (GameSettings.Instance?.Dirty == true) { ShowUnsavedDialog(); return; }
        CloseNow();
    }

    void CloseNow()
    {
        Hide();
        EmitSignal(SignalName.Closed);
    }

    void ShowSavedDialog()
    {
        OpenSubDialog(layer =>
        {
            var vbox = MakeDialogVBox(layer, width: 380, height: 190);
            vbox.AddChild(MakeDialogLabel("Settings saved", 24));

            var sub = MakeDialogLabel(
                string.IsNullOrEmpty(AccountManager.ActiveAccount)
                    ? "Display settings saved for this PC."
                    : $"Saved to {AccountManager.ActiveAccount} — they will be here next sign-in.",
                14);
            sub.AddThemeColorOverride("font_color", new Color(0.65f, 0.65f, 0.65f));
            vbox.AddChild(sub);

            var row = MakeDialogBtnRow();
            vbox.AddChild(row);
            row.AddChild(MakeFlatBtn("OK", _font, 16, CloseSubDialog));
        });
    }

    void ShowUnsavedDialog()
    {
        OpenSubDialog(layer =>
        {
            var vbox = MakeDialogVBox(layer, width: 460, height: 220);
            vbox.AddChild(MakeDialogLabel("Unsaved changes", 24));

            var sub = MakeDialogLabel("Save them before leaving?", 14);
            sub.AddThemeColorOverride("font_color", new Color(0.65f, 0.65f, 0.65f));
            vbox.AddChild(sub);

            var row = MakeDialogBtnRow();
            vbox.AddChild(row);

            row.AddChild(MakeFlatBtn("Cancel", _font, 16, CloseSubDialog));

            var discard = MakeFlatBtn("Discard", _font, 16, () =>
            {
                // Puts window mode, reticle and key bindings all back to the
                // snapshot taken when the screen opened.
                GameSettings.Instance?.DiscardChanges();
                RefreshAllBindLabels();
                CloseSubDialog();
                CloseNow();
            });
            discard.AddThemeColorOverride("font_color", new Color(1f, 0.5f, 0.5f));
            row.AddChild(discard);

            var save = MakeFlatBtn("Save", _font, 16, () =>
            {
                GameSettings.Instance?.SaveChanges();
                CloseSubDialog();
                CloseNow();
            });
            save.AddThemeColorOverride("font_color", new Color(0.30f, 0.90f, 0.40f));
            row.AddChild(save);
        });
    }

    void RefreshAllBindLabels()
    {
        foreach (var (action, _) in BindableActions) RefreshBindLabel(action);
    }

    // -- Tabs --

    /// Wraps a tab's content in a scroll view pinned to the host, and adds its
    /// button to the bar. Scrolling is per-tab so a long Controls list never
    /// pushes the tab bar or the Close button off-screen.
    ///
    /// `pinned`, when given, sits ABOVE the scroll region and never moves. The
    /// Reticle tab uses it for the live preview: the options run past one screen,
    /// so without pinning the preview scrolls away exactly when you reach Alpha
    /// and the custom RGB sliders -- i.e. you would be editing the reticle blind.
    void AddTab(Control host, string label, Control content, Control? pinned = null)
    {
        var scroll = new ScrollContainer();
        scroll.HorizontalScrollMode = ScrollContainer.ScrollMode.Disabled;

        content.SizeFlagsHorizontal = SizeFlags.ExpandFill;
        scroll.AddChild(content);

        Control page;
        if (pinned != null)
        {
            var stack = new VBoxContainer();
            stack.AddThemeConstantOverride("separation", 12);
            stack.AddChild(pinned);
            scroll.SizeFlagsVertical = SizeFlags.ExpandFill;   // scroll takes the rest
            stack.AddChild(scroll);
            page = stack;
        }
        else page = scroll;

        host.AddChild(page);
        // Preset AFTER parenting: on an orphan control it cannot resolve the
        // parent rect and the page collapses to zero size.
        page.SetAnchorsAndOffsetsPreset(LayoutPreset.FullRect);

        var btn = new Button
        {
            Text      = label,
            Flat      = true,
            Alignment = HorizontalAlignment.Center,
            CustomMinimumSize = new Vector2(150, 42),
        };
        if (_font != null) btn.AddThemeFontOverride("font", _font);
        btn.AddThemeFontSizeOverride("font_size", 20);
        var empty = new StyleBoxEmpty();
        btn.AddThemeStyleboxOverride("normal",  empty);
        btn.AddThemeStyleboxOverride("hover",   empty);
        btn.AddThemeStyleboxOverride("pressed", empty);
        btn.AddThemeStyleboxOverride("focus",   empty);

        int idx = _tabPages.Count;
        btn.Pressed += () => SelectTab(idx);

        _tabBar!.AddChild(btn);
        _tabButtons.Add(btn);
        _tabPages.Add(page);
    }

    void SelectTab(int index)
    {
        for (int i = 0; i < _tabPages.Count; i++)
        {
            bool on = i == index;
            _tabPages[i].Visible = on;
            _tabButtons[i].AddThemeColorOverride("font_color",       on ? TabActive : TabInactive);
            _tabButtons[i].AddThemeColorOverride("font_hover_color", on ? TabActive : Colors.White);
        }
    }

    static Label SectionHeader(string text, FontFile? font)
    {
        var l = new Label { Text = text };
        if (font != null) l.AddThemeFontOverride("font", font);
        l.AddThemeFontSizeOverride("font_size", 14);
        l.AddThemeColorOverride("font_color", new Color(0.55f, 0.55f, 0.55f));
        return l;
    }

    static VBoxContainer TabColumn()
    {
        var v = new VBoxContainer();
        v.AddThemeConstantOverride("separation", 14);
        v.CustomMinimumSize = new Vector2(560, 0);
        return v;
    }

