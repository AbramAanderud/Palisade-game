    /// <param name="pinned">Header + live preview, returned separately so AddTab can
    /// park it above the scroll region and keep it on screen while you edit.</param>
    Control BuildReticleTab(out Control pinned)
    {
        // The preview calls the same ReticleRenderer the in-game crosshair does,
        // so it cannot drift from reality.
        var preview = new ReticlePreview { CustomMinimumSize = new Vector2(0, 130) };

        var head = new VBoxContainer();
        head.AddThemeConstantOverride("separation", 8);
        head.AddChild(SectionHeader("RETICLE", _font));
        head.AddChild(preview);
        pinned = head;

        var vbox = TabColumn();
        vbox.AddChild(MakeStyleRow(preview));

        vbox.AddChild(MakeSliderRow("Length", 2f, 24f, 1f,
            GameSettings.Instance?.ReticleSize ?? 9f,
            v => { GameSettings.Instance?.SetReticleSize(v); preview.QueueRedraw(); }));

        vbox.AddChild(MakeSliderRow("Thickness", 1f, 6f, 1f,
            GameSettings.Instance?.ReticleThick ?? 2f,
            v => { GameSettings.Instance?.SetReticleThick(v); preview.QueueRedraw(); }));

        vbox.AddChild(MakeSliderRow("Gap", 0f, 30f, 1f,
            GameSettings.Instance?.ReticleGap ?? 5f,
            v => { GameSettings.Instance?.SetReticleGap(v); preview.QueueRedraw(); }));

        vbox.AddChild(MakeToggleRow("Outline",
            GameSettings.Instance?.ReticleOutline ?? true,
            v => { GameSettings.Instance?.SetReticleOutline(v); preview.QueueRedraw(); }, _font));

        vbox.AddChild(MakeSliderRow("Outline Width", 0f, 4f, 1f,
            GameSettings.Instance?.ReticleOutlineThick ?? 1f,
            v => { GameSettings.Instance?.SetReticleOutlineThick(v); preview.QueueRedraw(); }));

        vbox.AddChild(MakeToggleRow("Center Dot",
            GameSettings.Instance?.ReticleCenterDot ?? true,
            v => { GameSettings.Instance?.SetReticleCenterDot(v); preview.QueueRedraw(); }, _font));

        vbox.AddChild(MakeToggleRow("T-Style (no top arm)",
            GameSettings.Instance?.ReticleTStyle ?? false,
            v => { GameSettings.Instance?.SetReticleTStyle(v); preview.QueueRedraw(); }, _font));

        vbox.AddChild(MakeToggleRow("Use Alpha",
            GameSettings.Instance?.ReticleUseAlpha ?? true,
            v => { GameSettings.Instance?.SetReticleUseAlpha(v); preview.QueueRedraw(); }, _font));

        // Alpha is edited as a percentage: MakeSliderRow's readout is integral, so
        // a raw 0-1 slider would only ever display "0" or "1".
        vbox.AddChild(MakeSliderRow("Alpha", 0f, 100f, 5f,
            (GameSettings.Instance?.ReticleAlpha ?? 0.85f) * 100f,
            v => { GameSettings.Instance?.SetReticleAlpha(v / 100f); preview.QueueRedraw(); }));

        vbox.AddChild(MakeReticleColorRow(preview));

        return vbox;
    }

    /// Style dropdown -- how much of the live weapon spread the crosshair shows.
    Control MakeStyleRow(ReticlePreview preview)
    {
        var row = new HBoxContainer();

        var lbl = new Label { Text = "Style", SizeFlagsHorizontal = SizeFlags.ExpandFill };
        if (_font != null) lbl.AddThemeFontOverride("font", _font);
        lbl.AddThemeFontSizeOverride("font_size", 18);
        row.AddChild(lbl);

        var opt = new OptionButton { CustomMinimumSize = new Vector2(200, 36) };
        if (_font != null) opt.AddThemeFontOverride("font", _font);
        opt.AddThemeFontSizeOverride("font_size", 16);
        // Item index maps 1:1 onto ReticleStyleMode, so no lookup table is needed.
        opt.AddItem("Dynamic", (int)GameSettings.ReticleStyleMode.Dynamic);
        opt.AddItem("Classic", (int)GameSettings.ReticleStyleMode.Classic);
        opt.AddItem("Static",  (int)GameSettings.ReticleStyleMode.Static);
        opt.Selected = (int)(GameSettings.Instance?.ReticleStyle ?? GameSettings.ReticleStyleMode.Dynamic);
        opt.ItemSelected += idx =>
        {
            GameSettings.Instance?.SetReticleStyle((GameSettings.ReticleStyleMode)(int)idx);
            preview.QueueRedraw();
        };
        row.AddChild(opt);

        return row;
    }

