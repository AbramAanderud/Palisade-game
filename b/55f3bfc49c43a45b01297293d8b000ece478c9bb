    /// Colour swatches. A fixed palette rather than a full picker: these are the
    /// colours that actually stay readable against dark stone and torchlight.
    /// Colour presets plus custom RGB. The swatches and the sliders drive the same
    /// setting, so picking a preset moves the sliders and vice versa -- otherwise
    /// the sliders would sit stale showing a colour you are no longer using.
    Control MakeReticleColorRow(ReticlePreview preview)
    {
        var col = new VBoxContainer();
        col.AddThemeConstantOverride("separation", 4);

        var lbl = new Label { Text = "Color" };
        if (_font != null) lbl.AddThemeFontOverride("font", _font);
        lbl.AddThemeFontSizeOverride("font_size", 18);
        col.AddChild(lbl);

        var row = new HBoxContainer();
        row.AddThemeConstantOverride("separation", 8);

        // CS:GO's preset set (green / yellow / blue / cyan / red) plus white and
        // pink. Alpha is deliberately 1 here -- transparency is the Alpha setting's
        // job, and baking it into the swatch would make them incomparable.
        (string Name, Color C)[] swatches =
        {
            ("White",  new Color(1f,    1f,    1f,    1f)),
            ("Green",  new Color(0.30f, 1f,    0.40f, 1f)),
            ("Yellow", new Color(1f,    0.90f, 0.25f, 1f)),
            ("Blue",   new Color(0.30f, 0.55f, 1f,    1f)),
            ("Cyan",   new Color(0.30f, 0.95f, 1f,    1f)),
            ("Red",    new Color(1f,    0.30f, 0.25f, 1f)),
            ("Pink",   new Color(1f,    0.40f, 0.85f, 1f)),
        };

        HSlider? rS = null, gS = null, bS = null;

        void Apply(Color c, bool moveSliders)
        {
            GameSettings.Instance?.SetReticleColor(c);
            if (moveSliders)
            {
                // SetValueNoSignal: writing Value would re-enter this handler and
                // fight the swatch that just set the colour.
                rS?.SetValueNoSignal(Mathf.Round(c.R * 255f));
                gS?.SetValueNoSignal(Mathf.Round(c.G * 255f));
                bS?.SetValueNoSignal(Mathf.Round(c.B * 255f));
            }
            preview.QueueRedraw();
        }

        foreach (var (name, c) in swatches)
        {
            var sw = new ColorRect
            {
                Color               = c,
                CustomMinimumSize   = new Vector2(0, 34),
                SizeFlagsHorizontal = SizeFlags.ExpandFill,
                TooltipText         = name,
                MouseFilter         = MouseFilterEnum.Stop,
            };
            var captured = c;
            sw.GuiInput += ev =>
            {
                if (ev is InputEventMouseButton mb && mb.Pressed
                 && mb.ButtonIndex == MouseButton.Left)
                    Apply(captured, moveSliders: true);
            };
            row.AddChild(sw);
        }

        col.AddChild(row);

        var cur = GameSettings.Instance?.ReticleColor ?? Colors.White;

        HSlider Channel(string name, float initial, System.Func<Color, float, Color> with)
        {
            var wrap = new VBoxContainer();
            wrap.AddThemeConstantOverride("separation", 2);

            var head = new HBoxContainer();
            var nameLbl = new Label { Text = name, SizeFlagsHorizontal = SizeFlags.ExpandFill };
            if (_font != null) nameLbl.AddThemeFontOverride("font", _font);
            nameLbl.AddThemeFontSizeOverride("font_size", 15);
            head.AddChild(nameLbl);

            var valLbl = new Label { Text = $"{(int)initial}" };
            if (_font != null) valLbl.AddThemeFontOverride("font", _font);
            valLbl.AddThemeFontSizeOverride("font_size", 15);
            head.AddChild(valLbl);
            wrap.AddChild(head);

            var sl = new HSlider
            {
                MinValue = 0, MaxValue = 255, Step = 1, Value = initial,
                SizeFlagsHorizontal = SizeFlags.ExpandFill,
            };
            sl.ValueChanged += v =>
            {
                valLbl.Text = $"{(int)v}";
                var c = GameSettings.Instance?.ReticleColor ?? Colors.White;
                Apply(with(c, (float)v / 255f), moveSliders: false);
            };
            wrap.AddChild(sl);
            col.AddChild(wrap);
            return sl;
        }

        rS = Channel("Custom R", Mathf.Round(cur.R * 255f), (c, v) => new Color(v, c.G, c.B, 1f));
        gS = Channel("Custom G", Mathf.Round(cur.G * 255f), (c, v) => new Color(c.R, v, c.B, 1f));
        bS = Channel("Custom B", Mathf.Round(cur.B * 255f), (c, v) => new Color(c.R, c.G, v, 1f));

        return col;
    }

    static Button MakeFlatBtn(string label, FontFile? font, int size, System.Action onClick)
    {
        var btn = new Button
        {
            Text              = label,
            CustomMinimumSize = new Vector2(0, 36),
            SizeFlagsHorizontal = SizeFlags.ExpandFill,
            FocusMode         = FocusModeEnum.All,
            MouseFilter       = MouseFilterEnum.Stop,
        };
        if (font != null) btn.AddThemeFontOverride("font", font);
        btn.AddThemeFontSizeOverride("font_size", size);
        btn.AddThemeColorOverride("font_color",       Colors.White);
        btn.AddThemeColorOverride("font_hover_color", new Color(0.6f, 0.85f, 1f));
        btn.Pressed += onClick;
        return btn;
    }
