    void OpenSubDialog(System.Action<CanvasLayer> build)
    {
        CloseSubDialog();
        _subDialog = new CanvasLayer { Layer = 110 };
        AddChild(_subDialog);

        var bg = new ColorRect
        {
            Color       = new Color(0f, 0f, 0f, 0.78f),
            MouseFilter = MouseFilterEnum.Stop,
