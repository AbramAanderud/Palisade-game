    /// Slider with a decimal readout. MakeSliderRow's readout is integral, which
    /// would render every sensitivity between 2.0 and 2.9 as a flat "2".
    Control MakeFloatSliderRow(string label, float min, float max, float step,
                               float initial, string fmt, System.Action<float> onChange)
    {
        var colv = new VBoxContainer();
        colv.AddThemeConstantOverride("separation", 4);

        var head = new HBoxContainer();
        var lbl = new Label { Text = label, SizeFlagsHorizontal = SizeFlags.ExpandFill };
        if (_font != null) lbl.AddThemeFontOverride("font", _font);
        lbl.AddThemeFontSizeOverride("font_size", 18);
        head.AddChild(lbl);

        var val = new Label { Text = initial.ToString(fmt) };
        if (_font != null) val.AddThemeFontOverride("font", _font);
        val.AddThemeFontSizeOverride("font_size", 18);
        head.AddChild(val);
        colv.AddChild(head);

        var sl = new HSlider
        {
            MinValue = min, MaxValue = max, Step = step, Value = initial,
            SizeFlagsHorizontal = SizeFlags.ExpandFill,
        };
        sl.ValueChanged += v => { val.Text = ((float)v).ToString(fmt); onChange((float)v); };
        colv.AddChild(sl);

        return colv;
    }

    /// One binding row: action name on the left, a button showing its current key
    /// on the right. Clicking the button arms capture.
    Control MakeBindRow(string label, string action)
    {
        var row = new HBoxContainer();

        var lbl = new Label { Text = label, SizeFlagsHorizontal = SizeFlags.ExpandFill };
        if (_font != null) lbl.AddThemeFontOverride("font", _font);
        lbl.AddThemeFontSizeOverride("font_size", 18);
        row.AddChild(lbl);

        var btn = new Button
        {
            Text              = DescribeBinding(action),
            CustomMinimumSize = new Vector2(220, 34),
        };
        if (_font != null) btn.AddThemeFontOverride("font", _font);
        btn.AddThemeFontSizeOverride("font_size", 16);
        btn.Pressed += () => BeginCapture(action, btn);
        row.AddChild(btn);

        _bindButtons[action] = btn;
        return row;
    }

    void BeginCapture(string action, Button btn)
    {
        // Only one capture at a time -- re-arming elsewhere cancels the first.
        if (_capturingAction != null) CancelCapture();
        _capturingAction = action;
        _capturingBtn    = btn;
        btn.Text         = "Press a key…";
    }

    void CancelCapture()
    {
        if (_capturingBtn != null && _capturingAction != null)
            _capturingBtn.Text = DescribeBinding(_capturingAction);
        _capturingAction = null;
        _capturingBtn    = null;
    }

    public override void _Input(InputEvent e)
    {
        if (!Visible || _capturingAction == null) return;

        // Escape cancels instead of binding. Allowing Escape to be captured would
        // let a player bind it over Pause and lose the only way back out.
        if (e is InputEventKey esc && esc.Pressed && esc.Keycode == Key.Escape)
        {
            CancelCapture();
            GetViewport().SetInputAsHandled();
            return;
        }

        InputEvent? chosen = e switch
        {
            InputEventKey k when k.Pressed && !k.Echo => k,
            InputEventMouseButton mb when mb.Pressed  => mb,
            _                                          => null,
        };
        if (chosen == null) return;

        string action = _capturingAction;

        // Steal the key from any other action already using it. Leaving both bound
        // would make one of them silently unreachable, which reads as a broken game
        // rather than a config choice -- so the loser is visibly cleared to "-".
        foreach (var (other, _) in BindableActions)
        {
            if (other == action) continue;
            if (!InputMap.EventIsAction(chosen, other)) continue;
            GameSettings.Instance?.ClearBinding(other);
            RefreshBindLabel(other);
        }

        GameSettings.Instance?.SetBinding(action, chosen);
        _capturingAction = null;
        _capturingBtn    = null;
        RefreshBindLabel(action);
        GetViewport().SetInputAsHandled();
    }

    void RefreshBindLabel(string action)
    {
        if (_bindButtons.TryGetValue(action, out var b)) b.Text = DescribeBinding(action);
    }

    /// First key or mouse binding for an action, in human-readable form.
    /// AsText() tags physical-keycode events -- Godot 4.6 renders that as the
    /// suffix " - Physical" (older builds used " (Physical)"), which is engine
    /// detail the player should never see. Both forms are stripped so the row
    /// reads "W", not "W - Physical".
    static string DescribeBinding(string action)
    {
        if (!InputMap.HasAction(action)) return "-";
        foreach (var ev in InputMap.ActionGetEvents(action))
        {
            if (ev is not (InputEventKey or InputEventMouseButton)) continue;
            return ev.AsText()
                     .Replace(" (Physical)", "")
                     .Replace(" - Physical", "")
                     .Trim();
        }
        return "-";
    }

    // ── Account sub-dialogs ───────────────────────────────────────────────────

    void ShowChangeNameDialog()
    {
        OpenSubDialog(layer =>
        {
            var vbox = MakeDialogVBox(layer, width: 420, height: 240);

            var prompt = MakeDialogLabel("Change account name", 24);
            vbox.AddChild(prompt);

            var sub = MakeDialogLabel($"Renames \"{OnlineGameState.PlayerName}\" — your mazes and fame come with you.", 13);
            sub.AddThemeColorOverride("font_color", new Color(0.6f, 0.6f, 0.6f));
            vbox.AddChild(sub);

            var edit = new LineEdit
            {
                Text              = OnlineGameState.PlayerName,
                MaxLength         = 24,
                CustomMinimumSize = new Vector2(360, 44),
                SizeFlagsHorizontal = SizeFlags.ShrinkCenter,
            };
            if (_font != null) edit.AddThemeFontOverride("font", _font);
            edit.AddThemeFontSizeOverride("font_size", 18);
            vbox.AddChild(edit);

            var btnRow = MakeDialogBtnRow();
            vbox.AddChild(btnRow);

            var cancelBtn = MakeFlatBtn("Cancel", _font, 16, CloseSubDialog);
            btnRow.AddChild(cancelBtn);

            var okBtn = MakeFlatBtn("Save", _font, 16, () =>
            {
                string clean = SanitizeName(edit.Text);
                if (clean == OnlineGameState.PlayerName) { CloseSubDialog(); return; }
                bool ok = AccountManager.RenameActiveAccount(clean);
                if (!ok)
                {
                    sub.Text = "Name already in use. Pick another.";
                    sub.AddThemeColorOverride("font_color", new Color(1f, 0.5f, 0.5f));
                    return;
                }
                ReloadTitleScreen();
            });
            okBtn.AddThemeColorOverride("font_color", new Color(0.4f, 1f, 0.6f));
            btnRow.AddChild(okBtn);

            edit.GrabFocus();
            edit.TextSubmitted += _ => okBtn.EmitSignal(Button.SignalName.Pressed);
        });
    }

    void ShowSwitchUserDialog()
    {
        OpenSubDialog(layer =>
        {
            var vbox = MakeDialogVBox(layer, width: 460, height: 480);

            vbox.AddChild(MakeDialogLabel("Switch user", 24));
            var sub = MakeDialogLabel("Pick an existing account or create a new one.", 13);
            sub.AddThemeColorOverride("font_color", new Color(0.6f, 0.6f, 0.6f));
            vbox.AddChild(sub);

            var listVbox = new VBoxContainer();
            listVbox.AddThemeConstantOverride("separation", 6);
            listVbox.SizeFlagsHorizontal = SizeFlags.ExpandFill;
            listVbox.SizeFlagsVertical   = SizeFlags.ExpandFill;
            var scroll = new ScrollContainer { SizeFlagsVertical = SizeFlags.ExpandFill };
            scroll.AddChild(listVbox);
            vbox.AddChild(scroll);

            var accounts = AccountManager.ListAccounts();
            foreach (var name in accounts)
            {
                bool isActive = name == AccountManager.ActiveAccount;
                string label  = isActive ? $"● {name}  (current)" : $"○ {name}";
                var btn = MakeFlatBtn(label, _font, 16, () =>
                {
                    if (isActive) { CloseSubDialog(); return; }
                    AccountManager.SwitchOrCreate(name);
                    GameSettings.Instance?.ReloadForAccount();
                    PlayerProfile.Load();
                    ReloadTitleScreen();
                });
                btn.AddThemeColorOverride("font_color",
                    isActive ? new Color(0.4f, 1f, 0.6f) : Colors.White);
                btn.SizeFlagsHorizontal = SizeFlags.ExpandFill;
                listVbox.AddChild(btn);
            }

            vbox.AddChild(new HSeparator());

            var newRow = new HBoxContainer();
            newRow.AddThemeConstantOverride("separation", 8);
            vbox.AddChild(newRow);

            var newEdit = new LineEdit
            {
                PlaceholderText     = "New account name",
                MaxLength           = 24,
                SizeFlagsHorizontal = SizeFlags.ExpandFill,
                CustomMinimumSize   = new Vector2(0, 42),
            };
            if (_font != null) newEdit.AddThemeFontOverride("font", _font);
            newEdit.AddThemeFontSizeOverride("font_size", 16);
            newRow.AddChild(newEdit);

            var createBtn = MakeFlatBtn("Create", _font, 14, () =>
            {
                string clean = SanitizeName(newEdit.Text);
                if (string.IsNullOrEmpty(clean)) return;
                AccountManager.SwitchOrCreate(clean);
                GameSettings.Instance?.ReloadForAccount();
                OnlineGameState.PlayerName = clean;
                OnlineGameState.Gold       = AccountManager.StarterRank;
                PlayerProfile.Save();
                ReloadTitleScreen();
            });
            createBtn.AddThemeColorOverride("font_color", new Color(0.4f, 1f, 0.6f));
            newRow.AddChild(createBtn);

            var btnRow = MakeDialogBtnRow();
            vbox.AddChild(btnRow);
            btnRow.AddChild(MakeFlatBtn("Cancel", _font, 16, CloseSubDialog));
        });
    }

    void ShowSignOutConfirm()
