using Godot;

/// Regression harness for the rebinding API in GameSettings.
///
/// The UI is thin; the risk lives here — a Reset that cannot restore
/// project.godot's defaults because they were never snapshotted fails silently
/// and only surfaces as "my keys are gone" after a restart.
///
/// Scope: this covers the InputMap-level behaviour (apply, conflict, clear,
/// reset). Writing to disk and surviving a sign-out belongs to
/// TestSettingsPersistence, which uses throwaway accounts so it cannot scribble
/// on a real profile.
public partial class TestKeybinds : Node
{
    public override void _Ready()
    {
        var gs = GameSettings.Instance;
        if (gs == null) { GD.Print("[TestKeybinds] PASS=False (no GameSettings autoload)"); GetTree().Quit(); return; }

        bool pass = true;

        // 1. Baseline: move_forward is W out of project.godot.
        string before = First("move_forward");
        GD.Print($"[TestKeybinds] baseline move_forward = {before}");
        pass &= Check("baseline is W", before == "W");

        // 2. Rebind to T and confirm InputMap actually changed.
        gs.SetBinding("move_forward", new InputEventKey { PhysicalKeycode = Key.T });
        string after = First("move_forward");
        GD.Print($"[TestKeybinds] after rebind        = {after}");
        pass &= Check("rebind applied", after == "T");

        // 3. Conflict: binding move_back to T as well must be detectable, which is
        //    what the panel uses to clear the loser.
        bool conflictSeen = InputMap.EventIsAction(new InputEventKey { PhysicalKeycode = Key.T }, "move_forward");
        pass &= Check("conflict detectable via EventIsAction", conflictSeen);

        // 4. ClearBinding leaves the action with no events at all.
        gs.ClearBinding("move_back");
        pass &= Check("cleared action has no binding", First("move_back") == "-");

        // 5. Rebinding must mark the settings dirty rather than writing straight to
        //    disk -- that is what lets the panel offer Save Changes / Discard.
        //    Disk persistence itself is covered by TestSettingsPersistence, which
        //    uses throwaway accounts; asserting it here would write a test binding
        //    into whatever real profile happens to be signed in.
        pass &= Check("rebinding marks settings dirty", gs.Dirty);

        // 6. Reset restores project.godot's defaults for BOTH the rebound and the
        //    cleared action.
        gs.ResetBindings();
        string fwd = First("move_forward"), back = First("move_back");
        GD.Print($"[TestKeybinds] after reset          = {fwd} / {back}");
        pass &= Check("reset restored move_forward", fwd == "W");
        pass &= Check("reset restored move_back",    back == "S");

        GD.Print($"[TestKeybinds] PASS={pass}");
        GetTree().Quit();
    }

    static bool Check(string what, bool ok)
    {
        GD.Print($"[TestKeybinds]   {(ok ? "ok  " : "FAIL")} {what}");
        return ok;
    }

    static string First(string action)
    {
        if (!InputMap.HasAction(action)) return "-";
        foreach (var ev in InputMap.ActionGetEvents(action))
            if (ev is InputEventKey or InputEventMouseButton)
                return ev.AsText().Replace(" (Physical)", "").Replace(" - Physical", "").Trim();
        return "-";
    }
}
