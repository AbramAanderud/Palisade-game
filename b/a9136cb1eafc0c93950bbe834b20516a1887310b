using System;
using System.Collections.Generic;
using System.Linq;
using Godot;

/// Headless assertion harness for Room / Pit piece metadata and connectivity.
/// Prints one line per check and quits non-zero if any check fails.
public partial class TestRoomPitLogic : Node
{
    int _failures = 0;

    void Check(bool condition, string label)
    {
        if (condition) GD.Print($"PASS  {label}");
        else { GD.Print($"FAIL  {label}"); _failures++; }
    }

    public override void _Ready()
    {
        RunPieceDbChecks();
        RunRoomGroupChecks();
        RunPitChecks();
        RunValidatorChecks();
        RunPitFanOutChecks();
        RunRoomPaintRectChecks();
        RunEditorPitPlacementChecks();
        RunRoomPaintPitProtectionChecks();
        RunOrdinaryPieceOntoPitChecks();
        RunRoomPaintStairProtectionChecks();
        RunRoomGroupDeleteChecks();

        GD.Print(_failures == 0 ? "RESULT OK" : $"RESULT {_failures} FAILURE(S)");
        GetTree().Quit(_failures == 0 ? 0 : 1);
    }

    void RunPieceDbChecks()
    {
        GD.Print("── PieceDB ──");

        // Room is open on all four faces at every rotation, so any corridor that
        // points at it connects — this is what makes "any entry way hitting the
        // open space is valid" true without special-casing the validator.
        for (int rot = 0; rot < 4; rot++)
            foreach (Dir d in new[] { Dir.N, Dir.E, Dir.S, Dir.W })
                Check(PieceDB.HasSameFloorOpening(PieceType.Room, rot, d),
                      $"Room rot={rot} has same-floor opening {d}");

        // Pit is likewise open on all faces — every perimeter slot is a doorway.
        for (int rot = 0; rot < 4; rot++)
            foreach (Dir d in new[] { Dir.N, Dir.E, Dir.S, Dir.W })
                Check(PieceDB.HasSameFloorOpening(PieceType.Pit, rot, d),
                      $"Pit rot={rot} has same-floor opening {d}");

        // Neither is a stair — they must not go down the stair code paths.
        Check(!PieceDB.IsStair(PieceType.Room), "Room is not a stair");
        Check(!PieceDB.IsStair(PieceType.Pit),  "Pit is not a stair");

        // Footprints.
        Check(PieceDB.Footprint(PieceType.Room).Length == 1,
              "Room footprint is a single cell");
        Check(PieceDB.Footprint(PieceType.Straight).Length == 1,
              "Straight footprint is a single cell");

        var pitCells = PieceDB.Footprint(PieceType.Pit);
        Check(pitCells.Length == 9, "Pit footprint covers 9 cells");
        Check(pitCells.Contains((0, 0)),   "Pit footprint includes its anchor");
        Check(pitCells.Contains((-1, -1)), "Pit footprint includes (-1,-1)");
        Check(pitCells.Contains((1, 1)),   "Pit footprint includes (1,1)");
        Check(pitCells.All(c => Math.Abs(c.dx) <= 1 && Math.Abs(c.dy) <= 1),
              "Pit footprint stays within a 3x3");
        Check(pitCells.Distinct().Count() == 9, "Pit footprint has no duplicate cells");

        // Floor spans.
        Check(PieceDB.FloorSpan(PieceType.Room).SequenceEqual(new[] { 0 }),
              "Room occupies only its own floor");
        Check(PieceDB.FloorSpan(PieceType.Straight).SequenceEqual(new[] { 0 }),
              "Straight occupies only its own floor");
        Check(PieceDB.FloorSpan(PieceType.Pit).OrderBy(f => f).SequenceEqual(new[] { -1, 0, 1 }),
              "Pit spans one floor down, its own, and one up");

        // IsMultiCell.
        Check(PieceDB.IsMultiCell(PieceType.Pit),   "Pit is multi-cell");
        Check(!PieceDB.IsMultiCell(PieceType.Room), "Room is NOT multi-cell (painted per tile)");
        Check(!PieceDB.IsMultiCell(PieceType.Cross), "Cross is not multi-cell");

        // Palette metadata must exist or the editor will throw on open.
        foreach (var pt in new[] { PieceType.Room, PieceType.Pit })
        {
            Check(PieceDB.Colors.ContainsKey(pt),      $"{pt} has a Color");
            Check(PieceDB.Labels.ContainsKey(pt),      $"{pt} has a Label");
            Check(PieceDB.ShortLabels.ContainsKey(pt), $"{pt} has a ShortLabel");
            Check(PieceDB.GoldCosts.ContainsKey(pt),   $"{pt} has a GoldCost");
        }

        Check(PieceDB.CategoryOf(PieceType.Room) == PieceCategory.Structure,
              "Room is in the Structure tab");
        Check(PieceDB.CategoryOf(PieceType.Pit) == PieceCategory.Traversal,
              "Pit is in the Traversal tab");

        RunAliasingChecks();
    }

    // Footprint/FloorSpan must hand back a fresh array every call. They are
    // backed by shared static readonly arrays (SingleCell/ThreeByThree,
    // SingleFloor/ThreeFloors) — if a caller's in-place mutation leaked into
    // that backing array, every other piece type sharing it would be
    // silently corrupted for the rest of the process's lifetime.
    void RunAliasingChecks()
    {
        GD.Print("── PieceDB aliasing (Footprint/FloorSpan return copies) ──");

        // Mutating a Footprint result must not affect a later call for the same type.
        var room1 = PieceDB.Footprint(PieceType.Room);
        room1[0] = (9, 9);
        var room2 = PieceDB.Footprint(PieceType.Room);
        Check(room2[0] == (0, 0),
              "Footprint(Room) mutation does not persist across calls");

        // Mutating a Footprint result for one type must not affect a different
        // type that shares the same backing array (Room and Straight both
        // route through SingleCell).
        var roomFootprint = PieceDB.Footprint(PieceType.Room);
        roomFootprint[0] = (7, 7);
        var straightFootprint = PieceDB.Footprint(PieceType.Straight);
        Check(straightFootprint[0] == (0, 0),
              "Footprint(Room) mutation does not leak into Footprint(Straight)");

        // Same two checks for FloorSpan.
        var span1 = PieceDB.FloorSpan(PieceType.Room);
        span1[0] = 99;
        var span2 = PieceDB.FloorSpan(PieceType.Room);
        Check(span2[0] == 0,
              "FloorSpan(Room) mutation does not persist across calls");

        var roomSpan = PieceDB.FloorSpan(PieceType.Room);
        roomSpan[0] = 42;
        var straightSpan = PieceDB.FloorSpan(PieceType.Straight);
        Check(straightSpan[0] == 0,
              "FloorSpan(Room) mutation does not leak into FloorSpan(Straight)");
    }

    static MazePiece Room(int x, int y, int floor = 0)
        => new() { Type = PieceType.Room, X = x, Y = y, Floor = floor, Rotation = 0 };

    void RunRoomGroupChecks()
    {
        GD.Print("── RoomGroups ──");

        // A 3x2 block of Room tiles must collapse into exactly one group.
        var rect = new List<MazePiece>();
        for (int x = 2; x <= 4; x++)
            for (int y = 2; y <= 3; y++)
                rect.Add(Room(x, y));
        var g = RoomGroups.Build(rect);
        Check(g.Count == 1, "3x2 block of Room tiles is one group");
        Check(g[0].Cells.Count == 6, "group holds all 6 cells");
        Check(g[0].MinX == 2 && g[0].MaxX == 4 && g[0].MinY == 2 && g[0].MaxY == 3,
              "group bounds are (2,2)-(4,3)");
        // Width 3 (X) vs depth 2 (Z): the long axis is X, so the barrel runs along X
        // and arcs across Z.
        Check(!g[0].VaultAlongZ, "3-wide x 2-deep room arcs across Z");

        // Two Room blocks that do not touch are two separate groups.
        var split = new List<MazePiece> { Room(0, 0), Room(1, 0), Room(5, 5) };
        var gs = RoomGroups.Build(split);
        Check(gs.Count == 2, "disconnected Room tiles form separate groups");

        // Diagonal-only contact is NOT contact — rooms merge on shared faces only.
        var diag = RoomGroups.Build(new List<MazePiece> { Room(0, 0), Room(1, 1) });
        Check(diag.Count == 2, "diagonally-touching Room tiles do not merge");

        // Rooms on different floors never merge, even at the same X/Y.
        var floors = RoomGroups.Build(new List<MazePiece> { Room(3, 3, 0), Room(3, 3, 1) });
        Check(floors.Count == 2, "Room tiles on different floors are separate groups");
        Check(floors.Any(r => r.Floor == 0) && floors.Any(r => r.Floor == 1),
              "each group records its own floor");

        // Non-Room pieces are ignored entirely.
        var mixed = RoomGroups.Build(new List<MazePiece>
        {
            Room(1, 1),
            new() { Type = PieceType.Straight, X = 1, Y = 2, Floor = 0, Rotation = 0 },
        });
        Check(mixed.Count == 1 && mixed[0].Cells.Count == 1,
              "non-Room pieces are excluded from groups");

        // Perimeter faces: in the 3x2 rect, (2,2) is a top-left corner.
        var r = g[0];
        Check(r.IsPerimeterFace(2, 2, Dir.N), "(2,2) north face is perimeter");
        Check(r.IsPerimeterFace(2, 2, Dir.W), "(2,2) west face is perimeter");
        Check(!r.IsPerimeterFace(2, 2, Dir.E), "(2,2) east face is interior (touches (3,2))");
        Check(!r.IsPerimeterFace(2, 2, Dir.S), "(2,2) south face is interior (touches (2,3))");
        Check(r.IsPerimeterFace(4, 3, Dir.E), "(4,3) east face is perimeter");
        Check(r.IsPerimeterFace(4, 3, Dir.S), "(4,3) south face is perimeter");

        // An L-shape is still ONE group — irregular rooms are allowed and must not
        // be silently split or rectangle-filled.
        var lshape = RoomGroups.Build(new List<MazePiece>
        {
            Room(0, 0), Room(1, 0), Room(2, 0), Room(0, 1), Room(0, 2),
        });
        Check(lshape.Count == 1, "L-shaped room is one group");
        Check(lshape[0].Cells.Count == 5, "L-shaped group keeps all 5 cells");
        Check(!lshape[0].Contains(2, 2), "L-shaped group does not fill its bounding box");
    }

    void RunPitChecks()
    {
        GD.Print("── Pit ──");

        // Floor clipping: a pit anchored at the top floor loses its upper level but
        // stays valid — the user requirement is "cut them off but keep the piece valid".
        Check(PitBuilder.OccupiedFloors(0, -3, 3).SequenceEqual(new[] { -1, 0, 1 }),
              "pit at floor 0 occupies -1, 0, 1");
        Check(PitBuilder.OccupiedFloors(3, -3, 3).SequenceEqual(new[] { 2, 3 }),
              "pit at the top floor is clipped to 2, 3");
        Check(PitBuilder.OccupiedFloors(-3, -3, 3).SequenceEqual(new[] { -3, -2 }),
              "pit at the bottom floor is clipped to -3, -2");
        Check(PitBuilder.OccupiedFloors(3, 3, 3).SequenceEqual(new[] { 3 }),
              "pit with no room above or below still yields its own floor");

        // Occupancy: the anchor's 3x3 across its clipped floor span.
        var pit = new MazePiece { Type = PieceType.Pit, X = 4, Y = 4, Floor = 0, Rotation = 0 };
        Check(PitBuilder.Occupies(pit, 4, 4, 0,  -3, 3), "pit occupies its anchor cell");
        Check(PitBuilder.Occupies(pit, 3, 3, 0,  -3, 3), "pit occupies its NW corner");
        Check(PitBuilder.Occupies(pit, 5, 5, 1,  -3, 3), "pit occupies its SE corner one floor up");
        Check(PitBuilder.Occupies(pit, 5, 5, -1, -3, 3), "pit occupies its SE corner one floor down");
        Check(!PitBuilder.Occupies(pit, 6, 4, 0,  -3, 3), "pit does not occupy x=6");
        Check(!PitBuilder.Occupies(pit, 4, 4, 2,  -3, 3), "pit does not occupy floor +2");

        // Clipped pit does not claim floors outside the world.
        var top = new MazePiece { Type = PieceType.Pit, X = 4, Y = 4, Floor = 3, Rotation = 0 };
        Check(!PitBuilder.Occupies(top, 4, 4, 4, -3, 3), "clipped pit claims nothing above FlMax");
        Check(PitBuilder.Occupies(top, 4, 4, 2, -3, 3),  "clipped pit still claims the floor below");
    }

    void RunValidatorChecks()
    {
        GD.Print("── MazeValidator ──");

        // Rooms should already work with the untouched BFS.
        var roomMaze = new MazeData { Name = "rooms", Pieces = new List<MazePiece>() };
        roomMaze.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 3, Y = 0, Floor = 0, Rotation = 0 });
        for (int y = 1; y <= 8; y++)
            for (int x = 2; x <= 4; x++)
                roomMaze.Pieces.Add(Room(x, y));
        roomMaze.Pieces.Add(new MazePiece { Type = PieceType.Exit, X = 3, Y = 9, Floor = 0, Rotation = 0 });

        bool roomsOk = MazeValidator.IsGameReady(roomMaze, out string roomErr);
        Check(roomsOk, $"Start -> room -> Exit is game-ready (error was: '{roomErr}')");

        // A pit bridging two corridors must connect them.
        var pitMaze = new MazeData { Name = "pit", Pieces = new List<MazePiece>() };
        // Start at (4,0) opens S into (4,1), which is the pit's north perimeter row.
        pitMaze.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 4, Y = 0, Floor = 0, Rotation = 0 });
        // Pit anchored at (4,2): covers x 3..5, y 1..3 on floors -1, 0, 1.
        pitMaze.Pieces.Add(new MazePiece { Type = PieceType.Pit, X = 4, Y = 2, Floor = 0, Rotation = 0 });
        // Corridor leaving the pit's south face at (4,4), running down to the Exit.
        for (int y = 4; y <= 8; y++)
            pitMaze.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 4, Y = y, Floor = 0, Rotation = 0 });
        pitMaze.Pieces.Add(new MazePiece { Type = PieceType.Exit, X = 4, Y = 9, Floor = 0, Rotation = 0 });

        bool pitOk = MazeValidator.IsGameReady(pitMaze, out string pitErr);
        Check(pitOk, $"Start -> pit -> corridor -> Exit is game-ready (error was: '{pitErr}')");

        // A maze whose Exit is unreachable must still be rejected — the pit must not
        // become a wildcard that makes everything "connected".
        var broken = new MazeData { Name = "broken", Pieces = new List<MazePiece>() };
        broken.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 0, Y = 0, Floor = 0, Rotation = 0 });
        broken.Pieces.Add(new MazePiece { Type = PieceType.Pit, X = 4, Y = 4, Floor = 0, Rotation = 0 });
        broken.Pieces.Add(new MazePiece { Type = PieceType.Exit, X = 9, Y = 9, Floor = 0, Rotation = 0 });
        Check(!MazeValidator.IsGameReady(broken, out _),
              "a disconnected pit does NOT make an unreachable Exit valid");

        RunStairRegressionChecks();
        RunTeleportPathfindingChecks();
        RunDropTrapPathfindingChecks();
    }

    // A trapdoor is a two-floor piece: dropping through it reaches its landing one
    // floor below, so pathfinding must be able to route Start -> trapdoor -> [drop] ->
    // Exit-below. FloorSpan {0,-1} makes the BFS step out from the landing cell too.
    void RunDropTrapPathfindingChecks()
    {
        GD.Print("── MazeValidator: drop-trap pathfinding ──");

        MazePiece St(int x, int y, int f) =>
            new() { Type = PieceType.Straight, X = x, Y = y, Floor = f, Rotation = 0 };

        var m = new MazeData { Name = "drop", Pieces = new List<MazePiece>() };
        m.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 4, Y = 0, Floor = 0, Rotation = 0 });
        m.Pieces.Add(St(4, 1, 0));
        m.Pieces.Add(new MazePiece { Type = PieceType.TrapDoor, X = 4, Y = 2, Floor = 0, Rotation = 0 });
        // Floor -1: a corridor south of the landing (4,2,-1) down to the Exit. The
        // ONLY route to the Exit is the trapdoor drop.
        for (int y = 3; y <= 8; y++) m.Pieces.Add(St(4, y, -1));
        m.Pieces.Add(new MazePiece { Type = PieceType.Exit, X = 4, Y = 9, Floor = -1, Rotation = 0 });

        bool ok = MazeValidator.IsGameReady(m, out string err);
        Check(ok, $"Start -> trapdoor -> drop -> Exit(F-1) is game-ready (error: '{err}')");
    }

    // Pathfinding must treat a linked teleport pair as an edge: a maze whose only
    // route from Start to Exit runs through a teleport is game-ready.
    void RunTeleportPathfindingChecks()
    {
        GD.Print("── MazeValidator: teleport pathfinding ──");

        // Start -> corridor -> pad A ... [teleport] ... pad B -> corridor -> Exit.
        // A physical gap sits between the two halves, so the ONLY link is the teleport.
        MazePiece Straight(int x, int y) =>
            new() { Type = PieceType.Straight, X = x, Y = y, Floor = 0, Rotation = 0 };

        var m = new MazeData { Name = "warp-path", Pieces = new List<MazePiece>() };
        m.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 0, Y = 0, Floor = 0, Rotation = 0 });
        m.Pieces.Add(Straight(0, 1));
        m.Pieces.Add(new MazePiece { Type = PieceType.TrapPortal, X = 0, Y = 2, Floor = 0, Rotation = 0, LinkId = 5 });
        // Far side, not physically touching the first half.
        m.Pieces.Add(new MazePiece { Type = PieceType.TrapPortal, X = 9, Y = 7, Floor = 0, Rotation = 0, LinkId = 5 });
        m.Pieces.Add(Straight(9, 8));
        m.Pieces.Add(new MazePiece { Type = PieceType.Exit, X = 9, Y = 9, Floor = 0, Rotation = 0 });

        bool warpOk = MazeValidator.IsGameReady(m, out string warpErr);
        Check(warpOk, $"Start -> teleport -> Exit is game-ready (error was: '{warpErr}')");

        // An UNPAIRED pad (LinkId 0) provides no edge — the same layout with the link
        // removed must be rejected, so the teleport edge can't become a wildcard.
        var unpaired = new MazeData { Name = "warp-unpaired", Pieces = new List<MazePiece>() };
        foreach (var p in m.Pieces)
            unpaired.Pieces.Add(new MazePiece { Type = p.Type, X = p.X, Y = p.Y, Floor = p.Floor,
                                                Rotation = p.Rotation, LinkId = 0 });
        Check(!MazeValidator.IsGameReady(unpaired, out _),
              "unpaired teleport pads (LinkId 0) do NOT bridge the gap");

        // Two DIFFERENT pairs must not cross-link: a pad only edges to a partner that
        // shares its exact LinkId.
        var crossed = new MazeData { Name = "warp-crossed", Pieces = new List<MazePiece>() };
        crossed.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 0, Y = 0, Floor = 0, Rotation = 0 });
        crossed.Pieces.Add(Straight(0, 1));
        crossed.Pieces.Add(new MazePiece { Type = PieceType.TrapPortal, X = 0, Y = 2, Floor = 0, Rotation = 0, LinkId = 1 });
        crossed.Pieces.Add(new MazePiece { Type = PieceType.TrapPortal, X = 9, Y = 7, Floor = 0, Rotation = 0, LinkId = 2 });
        crossed.Pieces.Add(Straight(9, 8));
        crossed.Pieces.Add(new MazePiece { Type = PieceType.Exit, X = 9, Y = 9, Floor = 0, Rotation = 0 });
        Check(!MazeValidator.IsGameReady(crossed, out _),
              "teleport pads with different LinkIds do NOT connect");
    }

    // The BFS loop this task edits also carries the stair cross-floor logic
    // (CLAUDE.md calls this fragile, solved architecture). The brief's own test
    // list only exercises Room and Pit, so this guards against the pit-volume
    // rewrite silently breaking stair connectivity — same-floor pieces are
    // single-cell/non-stair and would mask a broken stair guard.
    void RunStairRegressionChecks()
    {
        GD.Print("── MazeValidator: stair regression ──");

        // StairsUp rot=0: flat (same-floor) face is S, cross (climbing) face is N.
        // Start sits south of the stair with its opening rotated to N so it enters
        // through the stair's flat face; the stair's cross face lands one cell
        // further north, one floor up, where the Exit sits.
        var up = new MazeData { Name = "stairs-up", Pieces = new List<MazePiece>() };
        up.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 3, Y = 4, Floor = 0, Rotation = 2 });
        up.Pieces.Add(new MazePiece { Type = PieceType.StairsUp, X = 3, Y = 3, Floor = 0, Rotation = 0 });
        up.Pieces.Add(new MazePiece { Type = PieceType.Exit, X = 3, Y = 2, Floor = 1, Rotation = 2 });
        bool upOk = MazeValidator.IsGameReady(up, out string upErr);
        Check(upOk, $"Start -> StairsUp -> Exit (floor 0 to 1) is game-ready (error was: '{upErr}')");

        // StairsDown rot=0: flat face is N, cross (descending) face is S.
        // Start sits north of the stair with its default S opening, entering the
        // flat face; the cross face lands one cell further south, one floor down.
        var down = new MazeData { Name = "stairs-down", Pieces = new List<MazePiece>() };
        down.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 5, Y = 2, Floor = 0, Rotation = 0 });
        down.Pieces.Add(new MazePiece { Type = PieceType.StairsDown, X = 5, Y = 3, Floor = 0, Rotation = 0 });
        down.Pieces.Add(new MazePiece { Type = PieceType.Exit, X = 5, Y = 4, Floor = -1, Rotation = 0 });
        bool downOk = MazeValidator.IsGameReady(down, out string downErr);
        Check(downOk, $"Start -> StairsDown -> Exit (floor 0 to -1) is game-ready (error was: '{downErr}')");

        // A stair's cross (high) face must still refuse a same-floor neighbour —
        // this is the guard the pit-volume rewrite could most easily clobber.
        var blocked = new MazeData { Name = "stairs-blocked", Pieces = new List<MazePiece>() };
        blocked.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 3, Y = 2, Floor = 0, Rotation = 0 });
        blocked.Pieces.Add(new MazePiece { Type = PieceType.StairsUp, X = 3, Y = 3, Floor = 0, Rotation = 0 });
        blocked.Pieces.Add(new MazePiece { Type = PieceType.Exit, X = 9, Y = 9, Floor = 0, Rotation = 0 });
        Check(!MazeValidator.IsGameReady(blocked, out _),
              "approaching StairsUp from its cross (high) face at the same floor does not connect");
    }

    // A pit exposes three perimeter cells per side per floor, across up to three
    // floors, so more than one corridor can legitimately land on the same face.
    // The BFS must discover and enqueue EVERY distinct unvisited neighbour it
    // finds while stepping out of a piece's cells, not just the first hit —
    // otherwise a second (or third) corridor sharing a face silently vanishes
    // from the graph and a fully-connected maze gets rejected as broken.
    void RunPitFanOutChecks()
    {
        GD.Print("── MazeValidator: pit fans out to every attached neighbour ──");

        // Two corridors land on the pit's north face at different footprint
        // offsets on the SAME floor. Neither branch has a route back to Start
        // other than through the pit. The old code stopped at the first
        // footprint offset that matched a candidate and never looked at the
        // second, so the second corridor (and everything past it, including
        // Exit) was reported unreachable even though the maze is fully
        // connected.
        var fanOut = new MazeData { Name = "pit-fan-out", Pieces = new List<MazePiece>() };
        fanOut.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 4, Y = 4, Floor = 0, Rotation = 2 }); // opens N
        fanOut.Pieces.Add(new MazePiece { Type = PieceType.Pit,   X = 4, Y = 2, Floor = 0, Rotation = 0 }); // spans x3-5,y1-3
        // Branch A: dead end, reachable only via the pit's north face.
        fanOut.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 3, Y = 0, Floor = 0, Rotation = 0 });
        // Branch B: also reachable only via the pit's north face, and carries on to Exit.
        fanOut.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 5, Y = 0,  Floor = 0, Rotation = 0 });
        fanOut.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 5, Y = -1, Floor = 0, Rotation = 0 });
        fanOut.Pieces.Add(new MazePiece { Type = PieceType.Exit,     X = 5, Y = -2, Floor = 0, Rotation = 2 }); // opens S

        bool fanOk = MazeValidator.IsGameReady(fanOut, out string fanErr);
        Check(fanOk, $"two corridors on the same pit face (same floor, different offsets) both connect (error was: '{fanErr}')");
        Check(fanErr == "", "no error reported when both same-floor branches are reachable");

        // Same idea, but the two corridors land at the SAME footprint offset of
        // the pit's north face on two DIFFERENT floors (the pit spans
        // floor-1, floor, floor+1). The old code's outer per-floor loop broke
        // as soon as ANY floor produced a hit, so the corridor on the floor
        // examined second was never discovered.
        var fanFloors = new MazeData { Name = "pit-fan-out-floors", Pieces = new List<MazePiece>() };
        fanFloors.Pieces.Add(new MazePiece { Type = PieceType.Start, X = 4, Y = 4, Floor = 0, Rotation = 2 }); // opens N
        fanFloors.Pieces.Add(new MazePiece { Type = PieceType.Pit,   X = 4, Y = 2, Floor = 0, Rotation = 0 });
        // Branch C1 on floor -1, dead end, same footprint offset as C2 below.
        fanFloors.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 3, Y = 0, Floor = -1, Rotation = 0 });
        // Branch C2 on floor +1, same footprint offset as C1, carries on to Exit.
        fanFloors.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 3, Y = 0,  Floor = 1, Rotation = 0 });
        fanFloors.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 3, Y = -1, Floor = 1, Rotation = 0 });
        fanFloors.Pieces.Add(new MazePiece { Type = PieceType.Exit,     X = 3, Y = -2, Floor = 1, Rotation = 2 }); // opens S

        bool fanFloorsOk = MazeValidator.IsGameReady(fanFloors, out string fanFloorsErr);
        Check(fanFloorsOk, $"two corridors at the same offset on different pit floors both connect (error was: '{fanFloorsErr}')");
        Check(fanFloorsErr == "", "no error reported when both cross-floor branches are reachable");
    }

    // ── Task 7: editor room-paint gesture and pit placement ────────────────────
    // These exercise the actual editor code (not a reimplementation) via helpers
    // deliberately widened from private to internal for this purpose — see the
    // comments on RoomRectCells / _maze / IsValidPlacement / TryGetPlacedPieceOnFloor
    // in scripts/MazeEditor3D.cs. A full click/drag/UI pass is out of reach for a
    // headless test and remains a human-verification item (see the task report).
    void RunRoomPaintRectChecks()
    {
        GD.Print("── Editor: room-paint rectangle math (MazeEditor3D.RoomRectCells) ──");

        // Order independence: whichever corner the user clicks first, the filled
        // set must be identical — a drag from A to B and its reverse (B to A)
        // are the same rectangle.
        var fwd = MazeEditor3D.RoomRectCells(2, 3, 4, 5).ToHashSet();
        var rev = MazeEditor3D.RoomRectCells(4, 5, 2, 3).ToHashSet();
        Check(fwd.SetEquals(rev), "RoomRectCells(A,B) == RoomRectCells(B,A)");

        // A 3x3 drag (2,3)-(4,5) covers exactly those 9 cells.
        var expected = new HashSet<(int, int)>();
        for (int x = 2; x <= 4; x++)
            for (int y = 3; y <= 5; y++)
                expected.Add((x, y));
        Check(fwd.SetEquals(expected), "3x3 drag yields exactly the 9 cells in its bounds");
        Check(fwd.Count == 9, "3x3 drag yields 9 cells, no duplicates");

        // Mixed corner order per axis (ax > bx, ay < by) still resolves correctly —
        // exercises Min/Max independently per axis, not just a symmetric swap.
        var mixed = MazeEditor3D.RoomRectCells(4, 3, 2, 5).ToHashSet();
        Check(mixed.SetEquals(expected), "mixed corner ordering (ax>bx, ay<by) still yields the same rectangle");

        // A single click (both corners equal) paints exactly one cell.
        var single = MazeEditor3D.RoomRectCells(6, 6, 6, 6).ToList();
        Check(single.Count == 1 && single[0] == (6, 6), "degenerate A==B rectangle is a single cell");

        // Off-grid corners are clipped to the 10x10 board (GW=GH=10): a drag that
        // runs past every edge is clamped to the valid cells only, never throws,
        // and never yields an out-of-range coordinate.
        var clipped = MazeEditor3D.RoomRectCells(-5, -5, 20, 20).ToList();
        Check(clipped.Count == 100, "a rectangle overrunning every edge clips to the full 10x10 board (100 cells)");
        Check(clipped.All(c => c.x >= 0 && c.x < 10 && c.y >= 0 && c.y < 10),
              "every clipped cell stays within [0,10)");

        // Entirely off-grid drag yields nothing, not a crash.
        var offGrid = MazeEditor3D.RoomRectCells(-5, -5, -1, -1).ToList();
        Check(offGrid.Count == 0, "a rectangle entirely off-grid yields no cells");
    }

    void RunEditorPitPlacementChecks()
    {
        GD.Print("── Editor: pit footprint occupancy & placement validation ──");

        // Not added to the SceneTree and _Ready() never runs — TryGetPlacedPieceOnFloor
        // and the Pit branch of IsValidPlacement only touch _maze.Pieces and PieceDB/
        // PitBuilder statics, so this is safe. (See the `internal` comments in
        // scripts/MazeEditor3D.cs for why this widening was needed.)
        var ed = new MazeEditor3D();
        try
        {
            // Pit anchored at (4,4) floor 0: footprint x 3..5, y 3..5, floors -1,0,1.
            var pit = new MazePiece { Type = PieceType.Pit, X = 4, Y = 4, Floor = 0, Rotation = 0 };
            ed._maze.Pieces.Add(pit);

            Check(ed.TryGetPlacedPieceOnFloor(4, 4, 0, out var atAnchor) && atAnchor == pit,
                  "TryGetPlacedPieceOnFloor resolves the pit's own anchor cell");
            Check(ed.TryGetPlacedPieceOnFloor(3, 3, 0, out var atCorner) && atCorner == pit,
                  "TryGetPlacedPieceOnFloor resolves a footprint corner on the anchor floor");
            Check(ed.TryGetPlacedPieceOnFloor(5, 5, 1, out var atUpCorner) && atUpCorner == pit,
                  "TryGetPlacedPieceOnFloor resolves a footprint corner one floor up");
            Check(ed.TryGetPlacedPieceOnFloor(3, 5, -1, out var atDownCorner) && atDownCorner == pit,
                  "TryGetPlacedPieceOnFloor resolves a footprint corner one floor down");
            Check(!ed.TryGetPlacedPieceOnFloor(6, 4, 0, out _),
                  "TryGetPlacedPieceOnFloor does not claim cells outside the 3x3 footprint");
            Check(!ed.TryGetPlacedPieceOnFloor(4, 4, 2, out _),
                  "TryGetPlacedPieceOnFloor does not claim floors outside the pit's clipped span");

            // Bounds rejection: IsValidPlacement needs one clear cell on every side
            // of the 10x10 grid for a pit's footprint to fit at all.
            Check(!ed.IsValidPlacement(0, 5, PieceType.Pit, 0, silent: true),
                  "pit rejected at the west edge (cx=0)");
            Check(!ed.IsValidPlacement(9, 5, PieceType.Pit, 0, silent: true),
                  "pit rejected at the east edge (cx=GW-1)");
            Check(!ed.IsValidPlacement(5, 0, PieceType.Pit, 0, silent: true),
                  "pit rejected at the north edge (cy=0)");
            Check(!ed.IsValidPlacement(5, 9, PieceType.Pit, 0, silent: true),
                  "pit rejected at the south edge (cy=GH-1)");
            Check(ed.IsValidPlacement(1, 1, PieceType.Pit, 0, silent: true),
                  "pit accepted at the innermost still-legal corner (cx=1, cy=1)");

            // Footprint-vs-footprint blocking: a second pit whose footprint overlaps
            // the first pit's already-claimed volume is rejected, even though its own
            // anchor cell is empty.
            Check(!ed.IsValidPlacement(6, 4, PieceType.Pit, 0, silent: true),
                  "a second pit overlapping the first pit's footprint is rejected");

            // A pit anchored far enough away that the two 3x3 footprints don't
            // touch is accepted.
            Check(ed.IsValidPlacement(8, 8, PieceType.Pit, 0, silent: true),
                  "a second pit clear of the first pit's footprint is accepted");

            // An ordinary single-cell piece already sitting inside where a pit would
            // land blocks the pit too — occupancy checking isn't pit-only.
            ed._maze.Pieces.Add(new MazePiece { Type = PieceType.Straight, X = 7, Y = 7, Floor = 0, Rotation = 0 });
            Check(!ed.IsValidPlacement(8, 8, PieceType.Pit, 0, silent: true),
                  "a pit is rejected when a single-cell piece already occupies part of its footprint");
        }
        finally
        {
            ed.Free();
        }
    }

    // ── Fix-pass regression: room paint must not destroy a Pit ─────────────────
    // Review finding: PaintRoomRect's guards skip cells that are already Room, and
    // refuse to overwrite Start/Exit, but said nothing about Pit. A room rectangle
    // that only clips one corner of a pit's 3x3 footprint used to delete the whole
    // pit (RemovePiece removes the piece's entire record, across every cell and
    // floor it spans) and then paint Room tiles only in the clicked rectangle —
    // the user could lose an entire pit by clipping its corner.
    //
    // RoomPaintSkipsCell is the exact per-cell decision PaintRoomRect drives its
    // loop with (see the `internal` comment on that method) — testing it here
    // exercises the real logic, not a reimplementation, while staying headless:
    // PaintRoomRect itself calls RebuildGeometry(), which needs a live _world.
    void RunRoomPaintPitProtectionChecks()
    {
        GD.Print("── Editor: room paint refuses to destroy a Pit ──");

        var ed = new MazeEditor3D();
        try
        {
            // Pit anchored at (4,4) floor 0: footprint x 3..5, y 3..5.
            var pit = new MazePiece { Type = PieceType.Pit, X = 4, Y = 4, Floor = 0, Rotation = 0 };
            ed._maze.Pieces.Add(pit);

            Check(ed.RoomPaintSkipsCell(4, 4, out bool bAnchor, out _) && bAnchor,
                  "room paint over the pit's own anchor cell is blocked (multi-cell)");
            Check(ed.RoomPaintSkipsCell(3, 3, out bool bNW, out _) && bNW,
                  "room paint over the pit's NW footprint corner is blocked (multi-cell)");
            Check(ed.RoomPaintSkipsCell(5, 5, out bool bSE, out _) && bSE,
                  "room paint over the pit's SE footprint corner is blocked (multi-cell)");
            Check(!ed.RoomPaintSkipsCell(2, 3, out bool bOutside1, out _) && !bOutside1,
                  "room paint just outside the pit's footprint (2,3) is NOT blocked");
            Check(!ed.RoomPaintSkipsCell(6, 6, out bool bOutside2, out _) && !bOutside2,
                  "room paint well clear of the pit (6,6) is NOT blocked");

            // A rectangle that exactly covers the pit's 3x3 footprint: every one
            // of the 9 cells must be blocked-as-multi-cell, none painted.
            int painted = 0, blocked = 0;
            foreach (var (x, y) in MazeEditor3D.RoomRectCells(3, 3, 5, 5))
            {
                if (ed.RoomPaintSkipsCell(x, y, out bool destructive, out _))
                {
                    if (destructive) blocked++;
                    continue;
                }
                painted++;
            }
            Check(blocked == 9, "a room rectangle exactly covering the pit's footprint blocks all 9 cells");
            Check(painted == 0, "no cell of the pit's footprint would be painted over");

            // A rectangle that only clips the pit's NW corner (1 of its 9 cells) —
            // the exact "corner-clip" scenario from the bug report — must still
            // refuse that one cell rather than silently letting it through.
            int paintedClip = 0, blockedClip = 0;
            foreach (var (x, y) in MazeEditor3D.RoomRectCells(2, 2, 3, 3))
            {
                if (ed.RoomPaintSkipsCell(x, y, out bool destructive, out _))
                {
                    if (destructive) blockedClip++;
                    continue;
                }
                paintedClip++;
            }
            Check(blockedClip == 1, "a rectangle clipping only the pit's NW corner blocks exactly that 1 cell");
            Check(paintedClip == 3, "the other 3 cells of a corner-clipping rectangle still paint normally");

            // Evaluating the skip decision must never itself mutate _maze — the
            // pit record must still be exactly what was added.
            Check(ed._maze.Pieces.Count == 1 && ed._maze.Pieces[0] == pit,
                  "the pit record is untouched by evaluating room-paint blocking");
        }
        finally
        {
            ed.Free();
        }
    }

    // ── Fix-pass regression: dropping/placing an ordinary piece onto a Pit ─────
    // Review finding: IsValidPlacement's multi-cell footprint check only ran when
    // the piece BEING PLACED was itself a Pit. Dropping (or palette-placing) any
    // ordinary piece onto a cell of an existing pit's footprint passed validation
    // — because the general connection-scan only looks at neighbours' openings,
    // and the pit is open on every face, so it always looked "connected" — and
    // then DropPiece/PlacePiece call RemovePiece, deleting the entire pit.
    void RunOrdinaryPieceOntoPitChecks()
    {
        GD.Print("── Editor: ordinary piece placement onto a Pit's footprint is rejected ──");

        var ed = new MazeEditor3D();
        try
        {
            var pit = new MazePiece { Type = PieceType.Pit, X = 4, Y = 4, Floor = 0, Rotation = 0 };
            ed._maze.Pieces.Add(pit);

            Check(!ed.IsValidPlacement(4, 4, PieceType.Straight, 0, silent: true),
                  "an ordinary Straight is rejected on the pit's own anchor cell");
            Check(!ed.IsValidPlacement(3, 3, PieceType.Straight, 0, silent: true),
                  "an ordinary Straight is rejected on the pit's NW footprint corner");
            Check(!ed.IsValidPlacement(5, 5, PieceType.LHall, 1, silent: true),
                  "a different piece type/rotation is still rejected on the pit's SE footprint corner");
            Check(!ed.IsValidPlacement(4, 3, PieceType.Cross, 0, silent: true),
                  "a piece is rejected on a non-corner footprint cell too (4,3)");

            // Sanity check on the fixture itself: (0,0) is genuinely empty, so if
            // a future change made IsValidPlacement reject placements there too,
            // it would be for a reason unrelated to this fix (e.g. "must connect
            // to an existing piece") — not a false positive from the new
            // multi-cell guard, which only fires when TryGetPlacedPieceOnFloor
            // actually resolves an occupant.
            Check(!ed.TryGetPlacedPieceOnFloor(0, 0, 0, out _),
                  "(0,0) truly has nothing placed on it");
        }
        finally
        {
            ed.Free();
        }
    }

    // ── Fix-pass regression: room paint must not destroy a Stair (I2) ──────────
    // Review finding: RoomPaintSkipsCell resolved occupancy with the same-floor-
    // only TryGetPlacedPieceOnFloor, but PaintRoomRect's RemovePiece resolves
    // with the cross-floor-aware TryGetActiveFloorPiece — so a room rectangle
    // over a cell whose stairwell rises from the floor below (or descends from
    // the floor above) silently deleted that stair with no warning. This editor
    // has no undo, so one drag could wipe several stairs.
    //
    // A stair is visible/clickable at the SAME (x, y) as its own placed cell,
    // one floor away from the piece's own Floor (TryGetActiveFloorPiece checks
    // _floor±1 at the SAME x/y — this is deliberately the stairwell's own
    // vertical-shaft footprint, not RoomBuilder's cross-direction "landing
    // cell" concept used for C2 — see that method's doc comment). With the
    // default _floor == 0, a StairsUp placed at floor -1 is exactly what
    // TryGetActiveFloorPiece(x, y) resolves when called at floor 0.
    void RunRoomGroupDeleteChecks()
    {
        GD.Print("── Editor: drag-painted floor deletes as one slab (RoomGroup) ──");

        // Not added to the SceneTree — RemovePiece/RemoveRoomGroup only touch
        // _maze.Pieces and the _cellGeo dictionary, same rationale as the pit
        // placement checks above.
        var ed = new MazeEditor3D();

        void Seed()
        {
            ed._maze.Pieces.Clear();
            // Slab A: 3x3 at (1..3, 1..3), one drag.
            for (int x = 1; x <= 3; x++)
                for (int y = 1; y <= 3; y++)
                    ed._maze.Pieces.Add(new MazePiece
                    { Type = PieceType.Room, X = x, Y = y, Floor = 0, RoomGroup = 7 });
            // Slab B: 2x2 at (6..7, 6..7), a separate drag.
            for (int x = 6; x <= 7; x++)
                for (int y = 6; y <= 7; y++)
                    ed._maze.Pieces.Add(new MazePiece
                    { Type = PieceType.Room, X = x, Y = y, Floor = 0, RoomGroup = 9 });
            // A legacy/ungrouped Room, as loaded from a pre-RoomGroup save.
            ed._maze.Pieces.Add(new MazePiece
            { Type = PieceType.Room, X = 5, Y = 0, Floor = 0, RoomGroup = 0 });
            // An unrelated corridor that must never be touched.
            ed._maze.Pieces.Add(new MazePiece
            { Type = PieceType.Straight, X = 0, Y = 8, Floor = 0 });
        }

        int Count(Func<MazePiece, bool> f) => ed._maze.Pieces.Count(p => f(p));

        // Deleting ANY one tile of a slab removes the whole slab — the headline
        // behaviour: a 3x3 floor is one piece, not nine right-clicks.
        Seed();
        ed.RemovePiece(2, 2);
        Check(Count(p => p.RoomGroup == 7) == 0, "deleting a middle tile removes the whole 3x3 slab");
        Check(Count(p => p.RoomGroup == 9) == 4, "the other slab is untouched");
        Check(Count(p => p.Type == PieceType.Straight) == 1, "unrelated corridor is untouched");
        Check(Count(p => p.Type == PieceType.Room && p.RoomGroup == 0) == 1, "ungrouped room is untouched");

        // A corner tile behaves the same as a middle tile.
        Seed();
        ed.RemovePiece(1, 1);
        Check(Count(p => p.RoomGroup == 7) == 0, "deleting a corner tile also removes the whole slab");

        // Backward compatibility: a room from an old save (RoomGroup 0) still
        // deletes one cell at a time, rather than every ungrouped room at once.
        Seed();
        ed.RemovePiece(5, 0);
        Check(Count(p => p.Type == PieceType.Room && p.RoomGroup == 0) == 0, "ungrouped room deletes itself");
        Check(Count(p => p.RoomGroup == 7) == 9, "deleting an ungrouped room leaves slabs intact");

        // expandGroup:false is the single-cell escape hatch PaintRoomRect and
        // PickUpPiece rely on — if this regressed, painting next to a slab or
        // picking up one tile would silently delete the neighbouring floor.
        Seed();
        ed.RemovePiece(2, 2, expandGroup: false);
        Check(Count(p => p.RoomGroup == 7) == 8, "expandGroup:false removes exactly one tile of a slab");

        // Ids must not collide with slabs already in the maze, or a new drag
        // would fuse itself to an older one and they would delete together.
        Seed();
        Check(ed.NextRoomGroup() == 10, "NextRoomGroup returns max existing id + 1");
        ed._maze.Pieces.Clear();
        Check(ed.NextRoomGroup() == 1, "NextRoomGroup starts at 1 on an empty maze");
    }

    void RunRoomPaintStairProtectionChecks()
    {
        GD.Print("── Editor: room paint refuses to destroy a Stair (I2) ──");

        var ed = new MazeEditor3D();
        try
        {
            var stair = new MazePiece { Type = PieceType.StairsUp, X = 4, Y = 4, Floor = -1, Rotation = 0 };
            ed._maze.Pieces.Add(stair);

            // Sanity: nothing is placed directly on floor 0 at (4,4) — any block
            // seen below comes from the cross-floor stair resolution, not a
            // same-floor piece.
            Check(!ed.TryGetPlacedPieceOnFloor(4, 4, 0, out _),
                  "sanity: (4,4) on floor 0 has nothing placed directly on it");

            Check(ed.RoomPaintSkipsCell(4, 4, out bool byMulti, out bool byStair) && byStair && !byMulti,
                  "room paint over a stair's cross-floor cell (4,4) is blocked as a Stair, not a Pit");

            int painted = 0, blockedStair = 0;
            foreach (var (x, y) in MazeEditor3D.RoomRectCells(3, 3, 5, 5))
            {
                if (ed.RoomPaintSkipsCell(x, y, out bool _, out bool destructiveStair))
                {
                    if (destructiveStair) blockedStair++;
                    continue;
                }
                painted++;
            }
            Check(blockedStair == 1, "a room rectangle covering the stair's cell blocks exactly that 1 cell");
            Check(painted == 8, "the other 8 cells of the rectangle still paint normally");

            Check(ed._maze.Pieces.Count == 1 && ed._maze.Pieces[0] == stair,
                  "the stair record is untouched by evaluating room-paint blocking");
        }
        finally
        {
            ed.Free();
        }
    }
