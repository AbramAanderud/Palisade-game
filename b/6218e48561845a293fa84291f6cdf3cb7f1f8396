using System.Linq;
using Godot;

/// test/TestFfaMatch.cs — pure FFA match rules: placements, clock ranking, fame.
public partial class TestFfaMatch : Node
{
    int _fail;
    void Check(bool ok, string label) { GD.Print((ok ? "PASS  " : "FAIL  ") + label); if (!ok) _fail++; }
    static string S(System.Collections.Generic.IEnumerable<int> e) => string.Join(",", e);

    public override void _Ready()
    {
        // 4-seat last-standing order
        {
            var m = new FfaMatch(new[] { 0, 1, 2, 3 });
            Check(!m.IsOver && m.Alive.Count == 4, "4 seats start alive, not over");
            m.RecordDeath(2, 0); m.RecordDeath(1, 3); m.RecordDeath(3, 0);
            Check(m.IsOver && m.Alive.Count == 1, "over when one left");
            Check(S(m.EliminationOrder) == "2,1,3", "elimination order 2,1,3");
            Check(S(m.Placements(false)) == "0,3,1,2", "placements 0,3,1,2 = " + S(m.Placements(false)));
            Check(m.KillsBy(0) == 2 && m.KillsBy(3) == 1, "kills credited to killers");
            Check(m.Fame(0, false) == 300 + 100, "fame 1st + 2 kills");
            Check(m.Fame(3, false) == 150 + 50, "fame 2nd + 1 kill");
            Check(m.Fame(1, false) == 50, "fame 3rd");
            Check(m.Fame(2, false) == 0, "fame 4th");
        }
        // self / unknown death: no credit
        {
            var m = new FfaMatch(new[] { 0, 1, 2 });
            m.RecordDeath(0, 0); m.RecordDeath(1, -1);
            Check(m.KillsBy(0) == 0 && m.KillsBy(1) == 0 && m.KillsBy(2) == 0, "self/unknown death gives no kill");
            Check(m.IsOver && S(m.Placements(false)) == "2,1,0", "self/unknown placements 2,1,0");
        }
        // leave counts as elimination, no kill credit
        {
            var m = new FfaMatch(new[] { 0, 1, 2, 3 });
            m.RecordLeave(1); m.RecordLeave(1);
            Check(m.Alive.Count == 3 && !m.Alive.Contains(1), "leave eliminates once");
            Check(S(m.EliminationOrder) == "1", "leave in elimination order");
            m.RecordDeath(2, 0); m.RecordDeath(3, 0);
            Check(S(m.Placements(false)) == "0,3,2,1", "placements with leave 0,3,2,1 = " + S(m.Placements(false)));
            Check(m.KillsBy(1) == 0, "leaver has no kills");
        }
        // clock-out: 3 survivors ranked by damage
        {
            var m = new FfaMatch(new[] { 0, 1, 2, 3 });
            m.RecordDeath(3, 1);
            m.RecordDamage(0, 1, 10f); m.RecordDamage(1, 0, 30f); m.RecordDamage(2, 0, 20f);
            m.RecordDamage(-1, 0, 99f);
            Check(m.DamageBy(0) == 10f && m.DamageBy(1) == 30f && m.DamageBy(-1) == 0f, "damage tallies; by=-1 ignored");
            Check(!m.IsOver, "3 survivors not over");
            Check(S(m.Placements(true)) == "1,2,0,3", "clock ranking by damage = " + S(m.Placements(true)));
            Check(m.Fame(1, true) == 300 + 50, "clock fame 1st + kill");
            Check(m.Fame(2, true) == 150, "clock fame 2nd");
            Check(m.Fame(0, true) == 50, "clock fame 3rd");
            Check(m.Fame(3, true) == 0, "clock fame 4th");
        }
        // tie: damage, then kills, then seat
        {
            var m = new FfaMatch(new[] { 0, 1, 2, 3 });
            m.RecordDamage(0, 1, 50f); m.RecordDamage(1, 0, 50f); m.RecordDamage(2, 0, 50f); m.RecordDamage(3, 0, 10f);
            Check(S(m.Placements(true)) == "0,1,2,3", "damage tie broken by seat asc = " + S(m.Placements(true)));
            var k = new FfaMatch(new[] { 0, 1, 2, 3 });
            k.RecordDamage(0, 1, 50f); k.RecordDamage(1, 0, 50f); k.RecordDamage(2, 0, 50f);
            k.RecordDeath(3, 2);
            Check(S(k.Placements(true)) == "2,0,1,3", "damage tie broken by kills = " + S(k.Placements(true)));
        }
        // idempotent double death
        {
            var m = new FfaMatch(new[] { 0, 1, 2 });
            m.RecordDeath(1, 0); m.RecordDeath(1, 2);
            Check(m.EliminationOrder.Count == 1, "double death: one elimination");
            Check(m.KillsBy(0) == 1 && m.KillsBy(2) == 0, "double death: first killer only");
        }
        // 3 seats, non-contiguous, pickup fame
        {
            var m = new FfaMatch(new[] { 0, 2, 3 });
            Check(m.Seats.Count == 3 && m.Alive.Count == 3, "3 seats alive");
            m.RecordPickup(3);
            Check(m.HasPickup(3) && !m.HasPickup(0), "pickup flag");
            m.RecordDeath(0, 3); m.RecordDeath(3, 2);
            Check(S(m.Placements(false)) == "2,3,0", "non-contig placements 2,3,0 = " + S(m.Placements(false)));
            Check(m.Fame(2, false) == 300 + 50, "nc fame 1st + kill");
            Check(m.Fame(3, false) == 150 + 50 + 100, "nc fame 2nd + kill + pickup");
            Check(m.Fame(0, false) == 50, "nc fame 3rd");
        }

        GD.Print(_fail == 0 ? "ALL PASS" : $"{_fail} FAILED");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
