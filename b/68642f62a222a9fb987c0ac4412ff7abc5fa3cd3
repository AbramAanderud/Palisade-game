using System.Collections.Generic;
using Godot;

/// res://test/TestRoomPitConnectivity.cs — M10: geometry-connectivity suite.
///
/// TestRoomPitLogic.cs is entirely unit-level: it exercises PieceDB, RoomGroups,
/// MazeValidator's BFS and MazeEditor3D's decision helpers directly, never the
/// actual triangles DungeonBuilder/RoomBuilder/PitBuilder emit. That is exactly
/// why C1 (pit doorways coplanar with a cap wall), C2 (room floor slab omitted
/// under a stair landing) and I1 (room perimeter wall leaves a gap below the
/// vault) were all invisible to it — those are geometry-emission bugs, not
/// logic-table bugs.
///
/// This suite builds a real DungeonBuilder for a few tiny hand-built mazes and
/// inspects the ACTUAL emitted Mesh geometry, not a reimplementation of the
/// logic under test. There is no public/internal API for "is there a wall panel
/// at this boundary", so the least invasive way to get at the geometry is to
/// walk the StaticBody3D/MeshInstance3D node tree DungeonBuilder/RoomBuilder/
/// PitBuilder already produce, using the node-naming convention they already
/// document ("Cell_{x}_{y}_{floor}" bodies; "Wall_*"/"FloorRoom_*"/"WallRoom_*"
/// mesh children) and inspect the committed Mesh's triangle soup via
/// Mesh.GetFaces() — the same face list Godot uses internally for
/// CreateTrimeshShape(). No production code needed a new `internal` hook for
/// this; the existing naming convention was already precise enough.
public partial class TestRoomPitConnectivity : Node
{
    int _failures = 0;

    void Check(bool condition, string label)
    {
        if (condition) GD.Print($"PASS  {label}");
        else { GD.Print($"FAIL  {label}"); _failures++; }
    }

    const float CS = DungeonBuilder.CellSize;

    public override void _Ready()
    {
        RunPitConnectivityCheck();
        RunStairLandingFloorCheck();
        RunRoomVaultSealCheck();

        GD.Print(_failures == 0 ? "RESULT OK" : $"RESULT {_failures} FAILURE(S)");
        GetTree().Quit(_failures == 0 ? 0 : 1);
    }

    // ── geometry inspection helpers ─────────────────────────────────────────
    static MeshInstance3D? FindMesh(Node root, string bodyName, string meshName)
        => root.GetNodeOrNull<MeshInstance3D>($"{bodyName}/{meshName}");

    /// True when the mesh contains a triangle whose three vertices ALL sit on
    /// the plane Z == z — a flat wall panel spanning that boundary. A side wall
    /// that merely touches the boundary at one or two corners (but has its third
    /// vertex elsewhere) does not count; only a genuine cap-wall quad does.
    static bool HasFaceAtConstantZ(Mesh? mesh, float z, float eps = 0.05f)
    {
        if (mesh == null) return false;
        var f = mesh.GetFaces();
        for (int i = 0; i + 2 < f.Length; i += 3)
            if (Mathf.Abs(f[i].Z - z) < eps && Mathf.Abs(f[i + 1].Z - z) < eps &&
                Mathf.Abs(f[i + 2].Z - z) < eps)
                return true;
        return false;
    }

    /// Same idea as HasFaceAtConstantZ but for the Y axis — a horizontal floor
    /// slab. A plinth's vertical sides always have at least one vertex ABOVE the
    /// base (RoomPlinthH), and its top face sits AT RoomPlinthH, never at the
    /// bare floor level — so this specifically detects a true floor slab
    /// (AddCellFloor), not plinth geometry that would be present either way.
    static bool HasFaceAtConstantY(Mesh? mesh, float y, float eps = 0.05f)
    {
        if (mesh == null) return false;
        var f = mesh.GetFaces();
        for (int i = 0; i + 2 < f.Length; i += 3)
            if (Mathf.Abs(f[i].Y - y) < eps && Mathf.Abs(f[i + 1].Y - y) < eps &&
                Mathf.Abs(f[i + 2].Y - y) < eps)
                return true;
        return false;
    }

    static float MeshTopY(Mesh? mesh)
    {
        if (mesh == null) return float.NegativeInfinity;
        var aabb = mesh.GetAabb();
        return aabb.Position.Y + aabb.Size.Y;
    }

    // ── C1: a corridor adjacent to a Pit's PERIMETER cell must not get a cap
    // wall at that shared boundary ───────────────────────────────────────────
    void RunPitConnectivityCheck()
    {
        GD.Print("── Geometry: corridor next to a Pit's perimeter cell (C1) ──");

        // Pit anchored at (4,2): footprint x 3..5, y 1..3 on floors -1,0,1.
        // Straight corridor at (4,4) opens N/S; its N face is the shared
        // boundary with the pit's (4,3) perimeter cell.
        var pieces = new List<MazePiece>
        {
            new() { Type = PieceType.Pit,      X = 4, Y = 2, Floor = 0, Rotation = 0 },
            new() { Type = PieceType.Straight, X = 4, Y = 4, Floor = 0, Rotation = 0 },
        };
        var dungeon = new DungeonBuilder();
        AddChild(dungeon);
        dungeon.Build(new MazeData { Name = "C1Geo", Pieces = pieces });

        var wall = FindMesh(dungeon, "Cell_4_4_0", "Wall_4_4");
        Check(wall != null, "corridor cell (4,4) built a Wall mesh");

        float northZ = 4 * CS;   // 40 — shared boundary with the pit's (4,3) cell
        float southZ = 5 * CS;   // 50 — genuine dead end, nothing placed there

        Check(!HasFaceAtConstantZ(wall?.Mesh, northZ),
              "no cap-wall panel at the corridor/pit shared boundary (z=40) — the doorway stays open");

        // Negative control: the corridor's OTHER open end has no neighbour at
        // all, so it SHOULD still be capped. This proves the detector above
        // can actually see a cap wall when one is really there — a detector
        // that always returns false would make the check above meaningless.
        Check(HasFaceAtConstantZ(wall?.Mesh, southZ),
              "sanity: the corridor's genuine dead end (z=50, no neighbour) IS still capped");
    }

    // ── C2: a room cell that is a stair's landing cell still gets a floor slab ──
    void RunStairLandingFloorCheck()
    {
        GD.Print("── Geometry: room floor slab at a stair's landing cell (C2) ──");

        // StairsUp on floor -1 at (3,3) rot=2 crosses S -> lands at (3,4) on
        // floor 0 (see PieceDB.GetStairCrossDir / RoomBuilder's former
        // IsStairLandingCell, whose exact fixture this mirrors).
        var pieces = new List<MazePiece>
        {
            new() { Type = PieceType.StairsUp, X = 3, Y = 3, Floor = -1, Rotation = 2 },
            new() { Type = PieceType.Room,     X = 3, Y = 4, Floor = 0,  Rotation = 0 },
        };
        var dungeon = new DungeonBuilder();
        AddChild(dungeon);
        dungeon.Build(new MazeData { Name = "C2Geo", Pieces = pieces });

        var floor = FindMesh(dungeon, "Cell_3_4_0", "FloorRoom_3_4");
        Check(floor != null, "room landing cell (3,4) built a FloorRoom mesh");

        Check(HasFaceAtConstantY(floor?.Mesh, 0f),
              "room's stair-landing cell (3,4) still has a floor slab at y=0 — " +
              "the player has something to land on instead of falling through");
    }

    // ── I1: a room's perimeter wall reaches the vault with no gap ──────────────
    void RunRoomVaultSealCheck()
    {
        GD.Print("── Geometry: room perimeter wall reaches the vault, no gap (I1) ──");

        // A single 1x1 room with no neighbours: every face is solid (no
        // doorway). The finding explicitly calls out that the bug affects
        // EVERY room including a 1x1, so this is the minimal reproduction.
        var pieces = new List<MazePiece>
        {
            new() { Type = PieceType.Room, X = 3, Y = 3, Floor = 0, Rotation = 0 },
        };
        var dungeon = new DungeonBuilder();
        AddChild(dungeon);
        dungeon.Build(new MazeData { Name = "I1Geo", Pieces = pieces });

        var wall = FindMesh(dungeon, "Cell_3_3_0", "WallRoom_3_3");
        Check(wall != null, "room cell (3,3) built a WallRoom mesh");

        float topY = MeshTopY(wall?.Mesh);
        // RoomSpringY (11) is where the OLD solid-wall-only code stopped.
        // FloorHeight (18) is the fix's unconditional-panel target, safely
        // above the vault's own apex RoomPeakY (17.5). Require the wall mesh
        // to reach well past the old ceiling, proving the gap is sealed.
        Check(topY > RoomBuilder.RoomSpringY + 1f,
              $"room perimeter wall reaches past RoomSpringY+1m (top Y={topY:F2}, RoomSpringY={RoomBuilder.RoomSpringY})");
        Check(topY >= DungeonBuilder.FloorHeight - 0.1f,
              $"room perimeter wall reaches within 0.1m of FloorHeight (top Y={topY:F2}, FloorHeight={DungeonBuilder.FloorHeight})");
    }
}
