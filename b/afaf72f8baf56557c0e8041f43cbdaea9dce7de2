using Godot;

/// res://scripts/GrassInteractor.cs
/// Marks a node as something that bends nearby grass (player, enemies, projectiles...).
/// Add as a child of any moving Node3D; GrassField picks it up via the group.
public partial class GrassInteractor : Node3D
{
    public const string Group = "GrassInteractor";

    [Export] public float Radius   = 1.4f;   // world-space bend radius (m)
    [Export] public float Strength = 1.0f;   // 0..1 how hard the grass is pushed

    public override void _Ready() => AddToGroup(Group);
}
