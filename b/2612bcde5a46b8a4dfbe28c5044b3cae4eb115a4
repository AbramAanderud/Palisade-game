using System;
using System.Collections.Generic;
using System.Linq;
using Godot;

/// Headless assertions for DesignRegions — the corridor-zoning pass that groups
/// contiguous runs of 4-6 connected cells into one "design" and switches design at
/// every boundary. Prints one line per check and quits non-zero on any failure.
public partial class TestDesignRegions : Node
{
    int _failures = 0;

    void Check(bool condition, string label)
    {
        if (condition) GD.Print($"PASS  {label}");
        else { GD.Print($"FAIL  {label}"); _failures++; }
    }

    static readonly Dir[] Dirs = { Dir.N, Dir.E, Dir.S, Dir.W };

    // Same walkable-adjacency rule DesignRegions uses, recomputed here so the test
    // validates the output independently of the algorithm's internals.
    static List<(int, int, int)> Neighbours(
        (int X, int Y, int Floor) c, Dictionary<(int, int, int), MazePiece> cellAt)
    {
        var list = new List<(int, int, int)>(4);
        if (!cellAt.TryGetValue(c, out var me)) return list;
        Dir myOpen = PieceDB.GetOpenings(me.Type, me.Rotation);
        foreach (var d in Dirs)
        {
            if ((myOpen & d) == 0) continue;
            var (dx, dy) = PieceDB.Delta(d);
            var nc = (c.X + dx, c.Y + dy, c.Floor);
            if (!cellAt.TryGetValue(nc, out var nb)) continue;
            if ((PieceDB.GetOpenings(nb.Type, nb.Rotation) & PieceDB.Opposite(d)) == 0) continue;
            list.Add(nc);
        }
        return list;
    }

    public override void _Ready()
    {
        GD.Print("── DesignRegions ──");

        // A 20-cell straight corridor on floor 0 (all E|W at rotation 1, so each cell
        // opens into its horizontal neighbours) plus a room and a pit off to the side
        // that must NOT be zoned. A second chain on floor 1 checks per-floor coverage.
        var pieces = new List<MazePiece>();
        for (int x = 0; x < 20; x++)
            pieces.Add(new MazePiece { Type = PieceType.Straight, X = x, Y = 0, Floor = 0, Rotation = 1 });
        for (int x = 0; x < 8; x++)
            pieces.Add(new MazePiece { Type = PieceType.Straight, X = x, Y = 0, Floor = 1, Rotation = 1 });
        pieces.Add(new MazePiece { Type = PieceType.Room, X = 5, Y = 5, Floor = 0 });
        pieces.Add(new MazePiece { Type = PieceType.Pit,  X = 10, Y = 10, Floor = 0 });

        int designCount = PieceVariants.VariantCount;
        var map = DesignRegions.Assign(pieces, designCount);

        // Cell index for the independent adjacency recomputation below (corridor cells
        // only — the same filter DesignRegions applies).
        var cellAt = new Dictionary<(int, int, int), MazePiece>();
        foreach (var p in pieces)
            if (!PieceDB.IsMultiCell(p.Type) && p.Type != PieceType.Room)
                cellAt[(p.X, p.Y, p.Floor)] = p;

        // ── Coverage + range ────────────────────────────────────────────────
        bool coverage = true, inRange = true;
        foreach (var key in cellAt.Keys)
        {
            if (!map.TryGetValue(key, out int d)) coverage = false;
            else if (d < 0 || d >= designCount) inRange = false;
        }
        Check(coverage, "every corridor cell gets a design");
        Check(inRange, "every design id is in [0, VariantCount)");
        Check(map.Count == cellAt.Count, "the map covers exactly the corridor cells (no extras)");

        // ── Rooms and pits are excluded ─────────────────────────────────────
        Check(!map.ContainsKey((5, 5, 0)),   "a room cell is NOT zoned (keeps its per-group carpet)");
        Check(!map.ContainsKey((10, 10, 0)), "a pit is NOT zoned");

        // ── Determinism + multiplayer safety ────────────────────────────────
        var map2 = DesignRegions.Assign(pieces, designCount);
        Check(MapsEqual(map, map2), "assigning the same maze twice yields the identical map");

        var shuffled = new List<MazePiece>(pieces);
        var rng = new Random(12345);
        for (int i = shuffled.Count - 1; i > 0; i--)   // Fisher-Yates
        { int j = rng.Next(i + 1); (shuffled[i], shuffled[j]) = (shuffled[j], shuffled[i]); }
        var mapShuffled = DesignRegions.Assign(shuffled, designCount);
        Check(MapsEqual(map, mapShuffled),
              "shuffling the input order yields the identical map (order-independent)");

        // ── Zones: contiguous same-design runs, sized 4-6 ───────────────────
        // A zone is a walkable-connected run of same-design cells. Because adjacent
        // zones are forced to differ, every such run IS one zone — so its size is the
        // zone size, and it must never exceed MaxZone. If the "avoid neighbour" logic
        // were broken, two adjacent same-design zones would merge into a run > MaxZone.
        var components = ConnectedSameDesignComponents(map, cellAt);
        int maxComp = components.Count == 0 ? 0 : components.Max(c => c.Count);
        int minComp = components.Count == 0 ? 0 : components.Min(c => c.Count);
        Check(maxComp <= DesignRegions.MaxZone,
              $"no same-design run exceeds MaxZone ({DesignRegions.MaxZone})  [largest={maxComp}]");
        Check(minComp >= 1, "every zone has at least one cell");

        // On a 20-cell straight corridor at least one full zone must actually grow to
        // MinZone — proves cells connect and BFS grows, not 20 singletons.
        Check(components.Any(c => c.Count >= DesignRegions.MinZone),
              $"at least one zone grows to MinZone ({DesignRegions.MinZone}) — connectivity works");

        // ── Switching actually happens ──────────────────────────────────────
        var chainDesigns = new HashSet<int>();
        for (int x = 0; x < 20; x++) chainDesigns.Add(map[(x, 0, 0)]);
        Check(chainDesigns.Count >= 2, "the 20-cell corridor uses at least two designs (it switches)");

        // ── Boundaries switch: adjacent zones differ ────────────────────────
        // Every walkable edge between two DIFFERENT zones must cross a design change.
        // (Two same-design cells that are walkably adjacent are, by construction, the
        // same zone — so any design change lines up exactly with a zone boundary.)
        bool boundariesDiffer = true;
        var seen = new HashSet<((int, int, int), (int, int, int))>();
        foreach (var key in cellAt.Keys)
            foreach (var nb in Neighbours(key, cellAt))
            {
                if (!map.ContainsKey(key) || !map.ContainsKey(nb)) continue;
                // A zone is a same-design connected run; if two adjacent cells share a
                // design they must be in the same component. Verify that holds.
                if (map[key] == map[nb] && !SameComponent(key, nb, components))
                    boundariesDiffer = false;
            }
        Check(boundariesDiffer,
              "adjacent cells sharing a design are always the same zone (no invisible boundaries)");

        GD.Print(_failures == 0 ? "RESULT OK" : $"RESULT {_failures} FAILURE(S)");
        GetTree().Quit(_failures == 0 ? 0 : 1);
    }

    static bool MapsEqual(Dictionary<(int, int, int), int> a, Dictionary<(int, int, int), int> b)
    {
        if (a.Count != b.Count) return false;
        foreach (var (k, v) in a)
            if (!b.TryGetValue(k, out int bv) || bv != v) return false;
        return true;
    }

    // Flood-fill the map into maximal walkable-connected runs of a single design.
    static List<List<(int, int, int)>> ConnectedSameDesignComponents(
        Dictionary<(int, int, int), int> map, Dictionary<(int, int, int), MazePiece> cellAt)
    {
        var comps   = new List<List<(int, int, int)>>();
        var visited = new HashSet<(int, int, int)>();
        foreach (var start in map.Keys)
        {
            if (visited.Contains(start)) continue;
            int design = map[start];
            var comp = new List<(int, int, int)>();
            var q = new Queue<(int, int, int)>();
            q.Enqueue(start); visited.Add(start);
            while (q.Count > 0)
            {
                var cur = q.Dequeue();
                comp.Add(cur);
                foreach (var nb in Neighbours(cur, cellAt))
                    if (!visited.Contains(nb) && map.TryGetValue(nb, out int nd) && nd == design)
                    { visited.Add(nb); q.Enqueue(nb); }
            }
            comps.Add(comp);
        }
        return comps;
    }

    static bool SameComponent((int, int, int) a, (int, int, int) b,
                              List<List<(int, int, int)>> comps)
    {
        foreach (var c in comps)
            if (c.Contains(a)) return c.Contains(b);
        return false;
    }
}
