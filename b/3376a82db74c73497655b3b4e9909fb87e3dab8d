using System.Linq;
using Godot;

/// test/TestHallway.cs — hallways built from Straight pieces: continuous floor along
/// the whole axis, no cap walls at either end, side walls 3 m off the axis.
/// Also proves DeadEndOpen defaults to None (ordinary mazes still cap dead ends).
public partial class TestHallway : Node
{
    int _fail;
    void Check(bool ok, string label) { GD.Print((ok ? "PASS  " : "FAIL  ") + label); if (!ok) _fail++; }

    public override async void _Ready()
    {
        Check(new DungeonBuilder().DeadEndOpen == Dir.None, "DeadEndOpen defaults to None");

        var fps = new[] { FfaFixtures.Slab(0), FfaFixtures.Slab(9), FfaFixtures.Slab(0), FfaFixtures.Slab(9) }
                  .Select(MazeFootprint.From).ToList();
        var layout = PlusLayout.Compute(fps, ArenaBuilder.Apothem);
        Check(layout.HallCells > 0, $"worst case has a hallway ({layout.HallCells} cells)");
        var origin = new Vector3(500f, 0f, 500f);   // non-zero origin catches offset bugs
        foreach (var s in layout.Seats)
            HallwayBuilder.Build(this, s, layout.HallCells, origin, $"Hall{s.Door}");
        Check(HallwayBuilder.Build(this, layout.Seats[0], 0, origin, "None") == null, "0 cells → no hallway");

        await ToSignal(GetTree(), SceneTree.SignalName.PhysicsFrame);
        await ToSignal(GetTree(), SceneTree.SignalName.PhysicsFrame);
        var space = GetViewport().World3D.DirectSpaceState;

        foreach (var s in layout.Seats)
        {
            var a = origin + s.HallStart; var b = origin + s.HallEnd;
            var u = (b - a).Normalized();
            var side = new Vector3(-u.Z, 0f, u.X);
            bool floorOk = true;
            for (float t = 0.5f; t < layout.HallLength; t += 1f)
            {
                var p = a + u * t;
                var hit = space.IntersectRay(PhysicsRayQueryParameters3D.Create(p + Vector3.Up * 5f, p + Vector3.Down * 2f));
                floorOk &= hit.Count > 0 && Mathf.Abs(((Vector3)hit["position"]).Y - origin.Y) < 0.3f;
            }
            Check(floorOk, $"hall {s.Door}: floor under every metre of the axis");
            var through = space.IntersectRay(PhysicsRayQueryParameters3D.Create(a - u * 0.5f + Vector3.Up * 2f, b + u * 0.5f + Vector3.Up * 2f));
            Check(through.Count == 0, $"hall {s.Door}: no cap wall at either end");
            var mid = (a + b) * 0.5f + Vector3.Up * 2f;
            var wall = space.IntersectRay(PhysicsRayQueryParameters3D.Create(mid, mid + side * 8f));
            Check(wall.Count > 0 && Mathf.Abs(((Vector3)wall["position"] - mid).Length() - 3f) < 0.3f,
                  $"hall {s.Door}: side wall 3 m off the axis");
        }
        GD.Print(_fail == 0 ? "ALL PASS" : $"{_fail} FAILED");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
