using System;
using System.Collections.Generic;
using System.Linq;
using Godot;

/// Headless assertion harness for PieceDB category metadata.
/// Prints one line per check and quits non-zero if any check fails.
public partial class TestPieceCategories : Node
{
    int _failures = 0;

    void Check(bool condition, string label)
    {
        if (condition) GD.Print($"PASS  {label}");
        else { GD.Print($"FAIL  {label}"); _failures++; }
    }

    public override void _Ready()
    {
        // Every PieceType must resolve to a category without throwing.
        foreach (PieceType pt in Enum.GetValues<PieceType>())
        {
            bool ok;
            try { PieceDB.CategoryOf(pt); ok = true; }
            catch (Exception e) { GD.Print($"      threw: {e.Message}"); ok = false; }
            Check(ok, $"CategoryOf({pt}) does not throw");
        }

        // Known placements.
        Check(PieceDB.CategoryOf(PieceType.Straight)   == PieceCategory.Structure,
              "Straight is Structure");
        Check(PieceDB.CategoryOf(PieceType.Cross)      == PieceCategory.Structure,
              "Cross is Structure");
        Check(PieceDB.CategoryOf(PieceType.StairsUp)   == PieceCategory.Traversal,
              "StairsUp is Traversal");
        Check(PieceDB.CategoryOf(PieceType.StairsDown) == PieceCategory.Traversal,
              "StairsDown is Traversal");

        // CategoryOrder must list every category exactly once.
        Check(PieceDB.CategoryOrder.Length == Enum.GetValues<PieceCategory>().Length,
              "CategoryOrder covers every PieceCategory");
        Check(PieceDB.CategoryOrder.Distinct().Count() == PieceDB.CategoryOrder.Length,
              "CategoryOrder has no duplicates");

        // Every category needs a display label.
        foreach (var c in PieceDB.CategoryOrder)
            Check(PieceDB.CategoryLabels.ContainsKey(c) &&
                  !string.IsNullOrWhiteSpace(PieceDB.CategoryLabels[c]),
                  $"CategoryLabels has a non-empty label for {c}");

        // ── Palette coverage (traps-task-6 Gap 1) ────────────────────────────
        // The editor's palette bar (MazeEditor3D.Palette) is a hand-maintained
        // list separate from PieceDB — nothing forces a newly-added PieceType
        // into it. That's exactly how Room/Pit/the 8 traps went in without ever
        // reaching the palette: PieceDB knew about them, MazeEditor3D.Palette
        // didn't. These two checks catch that class of gap headlessly, without
        // a human having to click through every tab:
        //
        //   1. Every PieceCategory must have at least one Palette entry — an
        //      empty tab (like TRAPS was) fails loudly instead of just
        //      rendering blank.
        //   2. Every piece IN the Palette must carry all five PieceDB
        //      dictionary entries a palette cell reads from — a piece present
        //      in the array but missing metadata would throw at runtime
        //      instead (KeyNotFoundException from a Dictionary indexer).
        GD.Print("── Palette coverage ──");

        var paletteCats = MazeEditor3D.Palette.Select(PieceDB.CategoryOf).ToHashSet();
        foreach (var c in PieceDB.CategoryOrder)
            Check(paletteCats.Contains(c), $"Palette has at least one entry for category {c}");

        //   3. Every PieceType is EITHER in the Palette or in this explicit
        //      exclusion list. Check 1 alone only catches a wholly-empty tab —
        //      it would still pass if a 9th trap were added and forgotten,
        //      because the Traps category already has 8 other entries. This
        //      check is the one that actually catches "one new piece type
        //      forgotten", which is the likelier future regression. Adding a
        //      PieceType now forces a deliberate choice: put it in the palette,
        //      or say here why it isn't user-placeable.
        var notInPalette = new HashSet<PieceType>
        {
            PieceType.Start,   // auto-placed and row-locked; never palette-selectable
            PieceType.Exit,    // same
            PieceType.Stairs,  // legacy type, superseded by StairsUp/StairsDown
        };
        var inPalette = MazeEditor3D.Palette.ToHashSet();
        foreach (PieceType pt in Enum.GetValues<PieceType>())
            Check(inPalette.Contains(pt) ^ notInPalette.Contains(pt),
                  $"{pt} is either in the Palette or explicitly excluded (exactly one)");

        foreach (var pt in MazeEditor3D.Palette)
        {
            Check(PieceDB.Colors.ContainsKey(pt),      $"Palette entry {pt} has a Color");
            Check(PieceDB.Labels.ContainsKey(pt),      $"Palette entry {pt} has a Label");
            Check(PieceDB.ShortLabels.ContainsKey(pt), $"Palette entry {pt} has a ShortLabel");
            Check(PieceDB.GoldCosts.ContainsKey(pt),   $"Palette entry {pt} has a GoldCost");
            Check(PieceDB.Category.ContainsKey(pt),    $"Palette entry {pt} has a Category");
        }

        GD.Print(_failures == 0
            ? "RESULT OK"
            : $"RESULT {_failures} FAILURE(S)");
        GetTree().Quit(_failures == 0 ? 0 : 1);
    }
}
