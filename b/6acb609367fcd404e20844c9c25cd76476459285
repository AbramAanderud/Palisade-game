using System.Collections.Generic;
using System.Linq;
using Godot;

/// test/TestFfaWorld.cs — FfaWorld: seat naming, MazeAt round-trip, runner rule, pickups, door order.
public partial class TestFfaWorld : Node
{
    int _fail;
    void Check(bool ok, string label) { GD.Print((ok ? "PASS  " : "FAIL  ") + label); if (!ok) _fail++; }

    void Run(string name, int[] seats, int offset)
    {
        var list = FfaLocalArena.LoadMazes("worst", null);
        var by = new Dictionary<int, MazeData>();
        for (int i = 0; i < seats.Length; i++) by[seats[i]] = list[i];
        var root = new Node3D { Name = name };
        AddChild(root);
        var w = FfaWorld.Build(root, new Vector3(300f, 0f, -200f), by, offset);
        int n = seats.Length;
        foreach (int s in seats)
        {
            Check(root.GetNodeOrNull<DungeonBuilder>($"Maze{s}") != null, $"{name}: Maze{s} is a direct child");
            Check(w.MazeAt(w.StartPosition(s)) == s, $"{name}: MazeAt(StartPosition({s})) == {s}");
        }
        var order = w.SeatsInLayoutOrder;
        bool runner = true;
        for (int k = 0; k < n; k++) runner &= w.MazeSeatRunBy(order[k]) == order[(k + offset) % n];
        Check(runner, $"{name}: runner rule (k+{offset})%n");
        Check(w.Pickups.Count == n - 1, $"{name}: pickups == n-1 ({w.Pickups.Count})");
        Check(w.DoorOutward(order[0]).IsEqualApprox(new Vector3(0, 0, -1)), $"{name}: layout index 0 door is north");
    }

    public override void _Ready()
    {
        Run("four", new[] { 0, 1, 2, 3 }, 1);
        Run("three", new[] { 0, 2, 3 }, 2);
        GD.Print(_fail == 0 ? "ALL PASS" : $"{_fail} FAILED");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
