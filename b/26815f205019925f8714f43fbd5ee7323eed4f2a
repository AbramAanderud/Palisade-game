using Godot;

/// Regression harness for the training-mode ESC behaviour.
///
/// Bug: TrainingArena._Input handled the "pause" action itself and called
/// ChangeSceneToFile("TitleScreen.tscn"), so ESC dumped the player straight to
/// the main menu -- no confirmation, no Resume. The PauseMenu autoload already
/// owns ESC in every other scene (and already routes training's exit to
/// TrainingSetupScreen), it was simply being pre-empted.
///
/// This drives the real TrainingArena scene, injects a real ESC key event
/// through Input.ParseInputEvent (so it travels the normal _Input ->
/// _UnhandledInput pipeline, exactly as a keypress would), then asserts:
///   1. we are STILL in TrainingArena (the old bug would have left for the title)
///   2. the PauseMenu autoload is visible (the menu actually opened)
///   3. the cursor is released so the menu is clickable
/// and finally that Resume restores mouse capture rather than handing back a
/// free cursor -- the PauseMenu.Open() half of the fix.
public partial class TestTrainingPause : Node
{
    public override void _Ready()
    {
        // A watcher parented to /root survives ChangeSceneToFile; this node does not
        // (it IS the current scene, so it gets freed by the swap).
        var watcher = new PauseWatcher();
        GetTree().Root.CallDeferred(Node.MethodName.AddChild, watcher);
        GetTree().CallDeferred(SceneTree.MethodName.ChangeSceneToFile,
                               "res://scenes/TrainingArena.tscn");
    }
}

public partial class PauseWatcher : Node
{
    int  _frame;
    bool _done;
    string _sceneBefore = "";

    public override void _Ready() => ProcessMode = ProcessModeEnum.Always; // survive Paused=true

    public override void _Process(double delta)
    {
        if (_done) return;
        _frame++;

        // Let the arena finish building (geometry, bots, weapon equip) before poking it.
        if (_frame == 150)
        {
            _sceneBefore = GetTree().CurrentScene?.SceneFilePath ?? "";
            GD.Print($"[TestTrainingPause] scene before ESC = {_sceneBefore}");
            GD.Print($"[TestTrainingPause] mouse before ESC  = {Input.MouseMode}");
            SendEsc(true);
            SendEsc(false);
        }

        if (_frame == 180)
        {
            string scene = GetTree().CurrentScene?.SceneFilePath ?? "";
            var pm       = GetTree().Root.GetNodeOrNull<CanvasLayer>("PauseMenu");
            bool visible = pm?.Visible ?? false;
            bool stayed  = scene.Contains("TrainingArena");
            bool paused  = GetTree().Paused;

            GD.Print($"[TestTrainingPause] scene after ESC  = {scene}");
            GD.Print($"[TestTrainingPause] pauseMenuVisible = {visible}");
            GD.Print($"[TestTrainingPause] treePaused       = {paused}");
            GD.Print($"[TestTrainingPause] mouse while open = {Input.MouseMode}");
            GD.Print($"[TestTrainingPause] RESULT stayedInTraining={stayed} menuOpened={visible} paused={paused}");

            // Resume: PauseMenu.Close() must hand back a CAPTURED cursor in gameplay,
            // otherwise the player resumes with no mouse look.
            pm?.Call("Close");
            _resumeChecked = true;
        }

        if (_frame == 200 && _resumeChecked)
        {
            bool captured = Input.MouseMode == Input.MouseModeEnum.Captured;
            bool unpaused = !GetTree().Paused;
            GD.Print($"[TestTrainingPause] mouse after Resume = {Input.MouseMode} (want Captured)");
            GD.Print($"[TestTrainingPause] PASS_RESUME={captured && unpaused}");
            _done = true;
            GetTree().Quit();
        }
    }

    bool _resumeChecked;

    static void SendEsc(bool pressed)
    {
        Input.ParseInputEvent(new InputEventKey
        {
            Keycode         = Key.Escape,
            PhysicalKeycode = Key.Escape,
            Pressed         = pressed,
        });
    }
}
