using Godot;
using System;

/// res://scripts/GrassField.cs
/// Interactive stylized grass, Godot-native (inspired by Unity's "A+ Grass"):
///   - MultiMesh crossed-quad blades (single draw call, no collision)
///   - Wind: two scrolling noise layers with a blend uniform
///   - Colour: base->tip gradient, per-blade jitter, broad patch noise, base AO
///   - Interaction: nodes in the GrassInteractor group bend grass; a CPU
///     bend-map texture keeps a TRAIL that recovers over time
///   - Distance fade (alpha scissor)
/// Acts as its own manager: wind + recovery globals are exports here.
public partial class GrassField : Node3D
{
    [Export] public float Radius       = 27f;
    // Blades are rejected inside this radius. The altar sits at the arena
    // centre, and grass scattered across the full disc grows straight up
    // through its steps. Left at 0 for arenas with no altar (training).
    [Export] public float InnerRadius  = 0f;
    // Density/size are tuned together. NOTE the old guidance here ("wider
    // blades buy coverage for free, raise those first") is what produced the
    // fat-cone look: blades ended up ~0.2m wide against ~0.6m tall, a 1:3
    // width:height that reads as a solid spike rather than a blade. Coverage
    // now comes from CLUMPING (see the scatter section) instead of width.
    // Held at the pre-change value on purpose: the 3-segment blade already
    // triples vertex count on its own, so keeping count fixed makes the
    // curvature cost measurable in isolation. Raise this only after a perf
    // A/B says there is room and a screenshot says it reads too sparse.
    [Export] public int   BladeCount   = 110000;
    [Export] public float BladeHeight  = 0.95f;  // avg blade height (m) — knee-to-waist
    [Export] public Color BaseColor    = new(0.045f, 0.10f, 0.035f);
    [Export] public Color TipColor     = new(0.22f, 0.38f, 0.12f);

    // ── blade shape ───────────────────────────────────────────────────────────
    // Segments along the blade's height. 1 = a flat quad, which CANNOT curve —
    // there are no vertices between root and tip to displace, so the silhouette
    // is always a straight spike no matter what the vertex shader does. 3 is
    // the cheapest count that reads as a real arc.
    [Export] public int   BladeSegments = 3;
    [Export] public float BladeHalfWidth = 0.034f;   // was 0.095 — see note above
    // How far a blade's tip falls from vertical, as a fraction of its height.
    // Per-blade randomised 0..this; some blades stay near upright, some flop.
    [Export] public float BendMax        = 0.55f;

    // ── clumping ──────────────────────────────────────────────────────────────
    // Blades are scattered around tuft centres rather than uniformly, and the
    // tufts themselves are placed by rejection sampling against low-frequency
    // noise so the field opens into bare patches. This is what makes it read as
    // wild overgrowth instead of carpet — and it is free at runtime: same
    // instance count, same single draw call, only the positions differ.
    [Export] public int   ClumpCount   = 2600;
    [Export] public float ClumpRadius  = 0.42f;   // blade scatter sigma around a tuft centre
    [Export(PropertyHint.Range, "0,1")] public float BarePatchAmount = 0.34f;

    // ── wind globals ──────────────────────────────────────────────────────────
    [Export] public float WindStrength   = 0.22f;
    [Export] public float WindSpeed      = 1.1f;
    [Export] public Vector2 WindDir      = new(1f, 0.35f);
    [Export(PropertyHint.Range, "0,1")] public float WindNoiseBlend = 0.45f;

    // ── interaction globals ───────────────────────────────────────────────────
    [Export] public float RecoverySpeed  = 0.55f;  // trail fade-out per second (lingers ~3s)
    [Export] public float DistFadeStart  = 34f;
    [Export] public float DistFadeEnd    = 50f;

    const int MapRes = 128;                 // bend-map resolution
    float _mapWorld;                        // world size the map covers
    byte[] _bendData = null!;
    Image _bendImg = null!;
    ImageTexture _bendTex = null!;
    ShaderMaterial _mat = null!;

    const string GrassShaderSrc = @"
shader_type spatial;
render_mode cull_disabled, diffuse_burley, specular_schlick_ggx, world_vertex_coords;
uniform vec3 base_color : source_color = vec3(0.045, 0.10, 0.035);
uniform vec3 tip_color  : source_color = vec3(0.30, 0.48, 0.14);
uniform float wind_strength = 0.22;
uniform float wind_speed    = 1.1;
uniform vec2  wind_dir      = vec2(1.0, 0.35);
uniform float wind_blend    = 0.45;   // 0 = broad gusts, 1 = fine ripple
uniform float fade_start    = 34.0;
uniform float fade_end      = 50.0;
uniform sampler2D bend_map : filter_linear, repeat_disable;
uniform vec2  map_origin;             // world xz of bend map min corner
uniform float map_size = 1.0;         // world extent covered by bend map
uniform float bend_max      = 0.55;
varying float v_h;                    // 0 root .. 1 tip
varying float v_jit;                  // per-blade colour jitter
varying vec2  v_wxz;
varying float v_dist;
varying float v_dead;                 // 0 live .. 1 dry/dead blade
varying float v_hue;                  // per-blade hue shift
float hash21(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vn2(vec2 p){
    vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash21(i), hash21(i + vec2(1, 0)), f.x),
               mix(hash21(i + vec2(0, 1)), hash21(i + vec2(1, 1)), f.x), f.y);
}
void vertex() {
    float h = UV.y;
    v_h = h;
    v_jit = INSTANCE_CUSTOM.x;
    float hmul = INSTANCE_CUSTOM.y;
    v_wxz = VERTEX.xz;

    // Per-blade variation derived from the jitter value rather than spending
    // more INSTANCE_CUSTOM channels (all four are already allocated).
    v_hue  = hash21(vec2(INSTANCE_CUSTOM.x, 0.73));
    v_dead = step(0.88, hash21(vec2(INSTANCE_CUSTOM.x, 4.19)));   // ~12% dry blades

    // ── static arc ────────────────────────────────────────────────────────────
    // The blade's OWN local +X axis, in world space, pulled out of the instance
    // transform. Each blade is scattered with a random yaw, so this gives every
    // blade its own lean direction for free — no extra per-instance data.
    //
    // Displacement goes as h*h: roots stay planted, the fall accelerates toward
    // the tip, which is how a real blade bends under its own weight. This is
    // applied BEFORE wind so wind rides on top of the arc rather than replacing
    // it. Requires BladeSegments > 1 — with a single segment there are no mid
    // vertices to displace and this silently does nothing.
    vec3 bx = normalize(MODEL_MATRIX[0].xyz);
    float bend = INSTANCE_CUSTOM.w * bend_max;
    VERTEX.xz += bx.xz * bend * h * h;
    // A bent blade is shorter than an upright one — without this the tips
    // stretch and the field looks inflated.
    VERTEX.y  -= bend * bend * h * h * 0.55;

    // Every term below is scaled by h, so root verts (h == 0) are displaced by
    // exactly zero. Half of a blade's verts are roots, so skipping the block
    // there halves the noise + bend-map work - which is what pays for the
    // higher BladeCount above.
    if (h > 0.001) {
        // wind: two noise layers scrolling at different scales/speeds
        vec2 wd = normalize(wind_dir);
        float t = TIME * wind_speed;
        float n1 = vn2(VERTEX.xz * 0.10 + wd * t * 0.35);
        float n2 = vn2(VERTEX.xz * 0.55 - wd * t * 0.90 + 7.31);
        float gust = mix(n1, n2, wind_blend) - 0.35;
        vec2 sway = wd * gust * wind_strength * h * h * (0.6 + 0.8 * hmul)
                  + vec2(0.0, 1.0) * sin(t * 1.7 + INSTANCE_CUSTOM.z * 6.28) * 0.02 * h;

        // interaction: sample bend trail map (RG = dir, B = strength)
        vec2 muv = (VERTEX.xz - map_origin) / map_size;
        vec4 bm = texture(bend_map, muv);
        vec2 bdir = bm.rg * 2.0 - 1.0;
        float bstr = bm.b;
        sway += bdir * bstr * 0.85 * h;
        VERTEX.xz += sway;
        VERTEX.y -= bstr * 0.30 * h;      // squash bent grass down a bit
    }

    v_dist = length(VERTEX - CAMERA_POSITION_WORLD);
}
void fragment() {
    // Blade silhouette. The quad is now nearly blade-width already (see
    // BladeHalfWidth), so this mask only has to round off the tip rather than
    // carve a thin blade out of a fat quad — which also means far less of each
    // quad is discarded, i.e. less overdraw than the old fat-quad version.
    float w = 0.44 * (1.0 - smoothstep(0.30, 1.0, v_h)) + 0.015;
    float a = 1.0 - smoothstep(w - 0.05, w, abs(UV.x - 0.5));
    a *= 1.0 - smoothstep(fade_start, fade_end, v_dist);   // distance fade
    ALPHA = a;
    ALPHA_SCISSOR_THRESHOLD = 0.45;

    // Hue variation, not just brightness. Uniform hue across every blade was a
    // large part of why the field read as one moulded surface — real turf runs
    // from blue-green through yellow-green to straw within a few centimetres.
    vec3 lush  = mix(base_color, tip_color, pow(v_h, 1.3));
    vec3 straw = mix(vec3(0.10, 0.09, 0.035), vec3(0.42, 0.34, 0.13), pow(v_h, 1.1));
    vec3 col   = mix(lush, straw, v_dead * 0.85 + v_hue * 0.22);

    col *= 0.80 + 0.40 * v_jit;                            // per-blade jitter
    col *= 0.75 + 0.50 * vn2(v_wxz * 0.22);                // broad patches
    col *= 0.58 + 0.42 * v_h;                              // root AO
    ALBEDO = col;
    ROUGHNESS = 0.9;

    // Was: NORMAL forced to straight up, so every blade shaded identically and
    // the field lit as one flat surface — a major reason it read as moulded
    // plastic. Now blend the blade's REAL (bent, per-blade-yawed) normal toward
    // up: the up term keeps blades from going black edge-on in near-zero
    // ambient, the real term restores per-blade shading variation.
    vec3 nup = normalize(vec3(0.0, 1.0, 0.0) * mat3(VIEW_MATRIX));
    vec3 nbl = FRONT_FACING ? NORMAL : -NORMAL;            // cull_disabled: flip backfaces
    NORMAL = normalize(mix(nbl, nup, 0.62));
}";

    // CPU twin of the shader's vn2 — same hash constants, so the bare-patch
    // mask the tuft scatter rejects against matches the noise vocabulary the
    // shader already uses for its broad colour patches.
    static float Hash21(Vector2 p)
    {
        float s = MathF.Sin(p.X * 127.1f + p.Y * 311.7f) * 43758.5453f;
        return s - MathF.Floor(s);
    }

    static float Vn2(Vector2 p)
    {
        Vector2 i = new(MathF.Floor(p.X), MathF.Floor(p.Y));
        Vector2 f = p - i;
        f = f * f * (new Vector2(3f, 3f) - 2f * f);
        return Mathf.Lerp(
            Mathf.Lerp(Hash21(i), Hash21(i + new Vector2(1, 0)), f.X),
            Mathf.Lerp(Hash21(i + new Vector2(0, 1)), Hash21(i + new Vector2(1, 1)), f.X), f.Y);
    }

    public override void _Ready()
    {
        _mapWorld = Radius * 2f + 6f;

        // ── bend map (trail state) ────────────────────────────────────────────
        _bendData = new byte[MapRes * MapRes * 4];
        for (int i = 0; i < _bendData.Length; i += 4) { _bendData[i] = 127; _bendData[i + 1] = 127; }
        _bendImg = Image.CreateFromData(MapRes, MapRes, false, Image.Format.Rgba8, _bendData);
        _bendTex = ImageTexture.CreateFromImage(_bendImg);

        // ── blade mesh: two crossed quads, origin at root, 1m tall ───────────
        // Subdivided along height into BladeSegments rows. The subdivision is
        // the entire reason the blade can curve: the vertex shader's arc is an
        // h*h displacement, and with a single row the only movable vertices are
        // at h == 1, which just translates the tip and leaves a straight edge.
        int segs = Math.Max(1, BladeSegments);
        var st = new SurfaceTool();
        st.Begin(Mesh.PrimitiveType.Triangles);
        void BladeQuad(Vector3 right)
        {
            Vector3 r = right * BladeHalfWidth;
            for (int s = 0; s < segs; s++)
            {
                float y0 = (float)s / segs, y1 = (float)(s + 1) / segs;
                Vector3 a0 = -r + Vector3.Up * y0, b0 = r + Vector3.Up * y0;
                Vector3 a1 = -r + Vector3.Up * y1, b1 = r + Vector3.Up * y1;
                // two triangles per row, UV.x across width, UV.y up the blade
                st.SetUV(new(0, y0)); st.AddVertex(a0);
                st.SetUV(new(1, y0)); st.AddVertex(b0);
                st.SetUV(new(1, y1)); st.AddVertex(b1);
                st.SetUV(new(0, y0)); st.AddVertex(a0);
                st.SetUV(new(1, y1)); st.AddVertex(b1);
                st.SetUV(new(0, y1)); st.AddVertex(a1);
            }
        }
        BladeQuad(Vector3.Right);
        BladeQuad(new Vector3(0.5f, 0, 0.866f));
        st.GenerateNormals();
        var bladeMesh = st.Commit();

        _mat = new ShaderMaterial { Shader = new Shader { Code = GrassShaderSrc } };
        _mat.SetShaderParameter("base_color", BaseColor);
        _mat.SetShaderParameter("tip_color", TipColor);
        _mat.SetShaderParameter("wind_strength", WindStrength);
        _mat.SetShaderParameter("wind_speed", WindSpeed);
        _mat.SetShaderParameter("wind_dir", WindDir);
        _mat.SetShaderParameter("wind_blend", WindNoiseBlend);
        _mat.SetShaderParameter("fade_start", DistFadeStart);
        _mat.SetShaderParameter("fade_end", DistFadeEnd);
        _mat.SetShaderParameter("bend_max", BendMax);
        _mat.SetShaderParameter("bend_map", _bendTex);
        _mat.SetShaderParameter("map_size", _mapWorld);
        bladeMesh.SurfaceSetMaterial(0, _mat);

        // ── scatter instances ────────────────────────────────────────────────
        var mm = new MultiMesh
        {
            TransformFormat = MultiMesh.TransformFormatEnum.Transform3D,
            UseCustomData   = true,
            Mesh            = bladeMesh,
            InstanceCount   = BladeCount,
        };
        var rng = new Random(4242);

        // ── tuft centres ──────────────────────────────────────────────────────
        // Rejection-sampled against low-frequency value noise so tufts gather in
        // some regions and leave the field genuinely bare in others. Uniform
        // scatter (what this used to do) gives even coverage everywhere, which
        // is precisely the "carpet" read we are trying to break.
        var clumps = new Vector2[Math.Max(1, ClumpCount)];
        for (int c = 0; c < clumps.Length; c++)
        {
            Vector2 p = default;
            // Bounded attempts: a starved mask must not spin forever, so the
            // last attempt is accepted unconditionally.
            for (int attempt = 0; attempt < 12; attempt++)
            {
                float ang = (float)(rng.NextDouble() * Math.PI * 2);
                float rad = Radius * MathF.Sqrt((float)rng.NextDouble());
                p = new Vector2(MathF.Cos(ang) * rad, MathF.Sin(ang) * rad);
                if (p.Length() < InnerRadius + ClumpRadius * 2f) continue;
                if (Vn2(p * 0.09f) > BarePatchAmount) break;
            }
            clumps[c] = p;
        }

        for (int i = 0; i < BladeCount; i++)
        {
            // Blade sits near a tuft centre, gaussian-ish falloff (sum of two
            // uniforms is a cheap triangular approximation — plenty here).
            Vector2 cc = clumps[rng.Next(clumps.Length)];
            float ox = ((float)rng.NextDouble() + (float)rng.NextDouble() - 1f) * ClumpRadius * 2f;
            float oz = ((float)rng.NextDouble() + (float)rng.NextDouble() - 1f) * ClumpRadius * 2f;
            var pos = new Vector3(cc.X + ox, 0, cc.Y + oz);
            if (new Vector2(pos.X, pos.Z).Length() > Radius) { pos = new Vector3(cc.X, 0, cc.Y); ox = oz = 0f; }

            // Blades at a tuft's centre grow tallest and stand straightest;
            // edge blades are shorter and splay harder. That gradient is what
            // makes a clump read as a tuft rather than a disc of blades.
            float edge = Mathf.Clamp(MathF.Sqrt(ox * ox + oz * oz) / (ClumpRadius * 2f), 0f, 1f);

            float yaw = (float)(rng.NextDouble() * Math.PI * 2);
            float sx  = 0.8f + (float)rng.NextDouble() * 0.5f;
            float sy  = BladeHeight * (0.62f + (float)rng.NextDouble() * 0.85f) * (1f - edge * 0.42f);
            var basis = Basis.FromEuler(new Vector3(0, yaw, 0)).Scaled(new Vector3(sx, sy, sx));
            mm.SetInstanceTransform(i, new Transform3D(basis, pos));
            mm.SetInstanceCustomData(i, new Color(
                (float)rng.NextDouble(),          // colour jitter (also seeds hue + dead-blade)
                (float)rng.NextDouble(),          // wind height multiplier
                (float)rng.NextDouble(),          // sway phase
                Mathf.Clamp(0.25f + (float)rng.NextDouble() * 0.75f + edge * 0.5f, 0f, 1f)));  // arc amount
        }
        AddChild(new MultiMeshInstance3D
        {
            Name = "GrassBlades",
            Multimesh = mm,
            CastShadow = GeometryInstance3D.ShadowCastingSetting.Off,
        });
    }

    public override void _Process(double delta)
    {
        // world origin of the map follows this node
        Vector2 origin = new(GlobalPosition.X - _mapWorld * 0.5f, GlobalPosition.Z - _mapWorld * 0.5f);
        _mat.SetShaderParameter("map_origin", origin);

        // ── recovery: strength decays toward zero ────────────────────────────
        float decay = MathF.Exp(-RecoverySpeed * (float)delta);
        bool dirty = false;
        for (int i = 0; i < _bendData.Length; i += 4)
        {
            byte b = _bendData[i + 2];
            if (b == 0) continue;
            _bendData[i + 2] = (byte)(b * decay);
            dirty = true;
        }

        // ── stamp interactors ────────────────────────────────────────────────
        float pxPerM = MapRes / _mapWorld;
        foreach (var node in GetTree().GetNodesInGroup(GrassInteractor.Group))
        {
            if (node is not GrassInteractor gi || !gi.IsInsideTree()) continue;
            Vector3 gp = gi.GlobalPosition;
            float cx = (gp.X - origin.X) * pxPerM;
            float cz = (gp.Z - origin.Y) * pxPerM;
            float rPx = gi.Radius * pxPerM;
            int x0 = Math.Max(0, (int)(cx - rPx)), x1 = Math.Min(MapRes - 1, (int)(cx + rPx));
            int z0 = Math.Max(0, (int)(cz - rPx)), z1 = Math.Min(MapRes - 1, (int)(cz + rPx));
            if (x1 < 0 || z1 < 0 || x0 >= MapRes || z0 >= MapRes) continue;
            for (int z = z0; z <= z1; z++)
            for (int x = x0; x <= x1; x++)
            {
                float dx = x - cx, dz = z - cz;
                float d = MathF.Sqrt(dx * dx + dz * dz);
                if (d > rPx) continue;
                float s = (1f - d / rPx) * gi.Strength;
                int idx = (z * MapRes + x) * 4;
                byte sb = (byte)(Math.Clamp(s, 0f, 1f) * 255f);
                if (sb <= _bendData[idx + 2]) continue;      // keep strongest
                float inv = d > 0.001f ? 1f / d : 0f;        // push radially outward
                _bendData[idx]     = (byte)((dx * inv * 0.5f + 0.5f) * 255f);
                _bendData[idx + 1] = (byte)((dz * inv * 0.5f + 0.5f) * 255f);
                _bendData[idx + 2] = sb;
                dirty = true;
            }
        }

        if (dirty)
        {
            _bendImg.SetData(MapRes, MapRes, false, Image.Format.Rgba8, _bendData);
            _bendTex.Update(_bendImg);
        }
    }
}
