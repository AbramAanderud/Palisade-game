using Godot;

/// res://test/TestTpDrift.cs
/// ─────────────────────────────────────────────────────────────────────────────
/// TP grip DRIFT verification (disposable — separate file from TestTask.cs
/// because that one is in concurrent use for the FP-side fix). Pairs a Frozen
/// LOCAL player with a real IsRemotePuppet=true player, both holding mac10,
/// plus an ak47 control, viewed from a spectator camera (CullMask ~4u hides
/// the FP-only viewmodel layer) with a green ForwardVector ground arrow under
/// each — but unlike a single-frame check, this runs a LONG idle (~12s) and
/// is captured throughout, because the actual bug was SeatTpGrip latching to
/// a one-shot seat that only matched the holder's orientation on the frame it
/// was measured, then drifting diagonal/muzzle-up as the idle clip kept
/// swaying the hand bone. A single late frame looking right proves nothing;
/// frames spread across the whole idle cycle all looking the same (mag down,
/// muzzle level/forward, slide up, matching ak47 in the same shot) is the
/// actual acceptance test.
/// ─────────────────────────────────────────────────────────────────────────────
public partial class TestTpDrift : Node3D
{
    const string Gun = "mac10";
    const string RefGun = "ak47";   // known-good control, rendered alongside for direct comparison

    PlayerController? _local, _puppet, _refLocal;

    public override void _Ready()
    {
        var env = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0.07f, 0.07f, 0.09f),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(1f, 0.97f, 0.92f),
            AmbientLightEnergy = 1.0f,
        };
        AddChild(new WorldEnvironment { Environment = env });

        var key = new DirectionalLight3D { LightEnergy = 1.3f };
        key.RotationDegrees = new Vector3(-50f, 30f, 0f);
        AddChild(key);

        var floor = new StaticBody3D();
        floor.AddChild(new CollisionShape3D
        { Shape = new BoxShape3D { Size = new Vector3(60f, 1f, 60f) } });
        AddChild(floor);
        floor.GlobalPosition = new Vector3(0f, -0.5f, 0f);

        float rx = -2.6f, lx = 0f, px = 2.6f;

        _refLocal = PlayerController.Spawn(this, new Vector3(rx, 0.2f, 0f), 0f);
        _refLocal.Frozen = true;
        _refLocal.EquipStarterGun(RefGun);

        _local = PlayerController.Spawn(this, new Vector3(lx, 0.2f, 0f), 0f);
        _local.Frozen = true;
        _local.EquipStarterGun(Gun);

        _puppet = PlayerController.Spawn(this, new Vector3(px, 0.2f, 0f), 0f);
        _puppet.IsRemotePuppet = true;
        _puppet.EquipStarterGun(Gun);

        void ForwardArrow(float x)
        {
            var arrow = new MeshInstance3D
            {
                Mesh = new BoxMesh { Size = new Vector3(0.06f, 0.02f, 1.6f) },
                Position = new Vector3(x, 0.01f, -0.8f),
            };
            arrow.SetSurfaceOverrideMaterial(0, new StandardMaterial3D
            { AlbedoColor = new Color(0.2f, 1f, 0.3f) });
            AddChild(arrow);
        }
        ForwardArrow(rx); ForwardArrow(lx); ForwardArrow(px);

        void Tag(string text, float x, Color c) => AddChild(new Label3D
        {
            Text = text, FontSize = 50, Position = new Vector3(x, 2.1f, 0f),
            Billboard = BaseMaterial3D.BillboardModeEnum.Enabled,
            Modulate = c, PixelSize = 0.0024f,
        });
        Tag("AK47 (control)", rx, new Color(0.7f, 0.9f, 1f));
        Tag("LOCAL mac10", lx, new Color(0.6f, 1f, 0.7f));
        Tag("PUPPET mac10", px, new Color(1f, 0.7f, 0.6f));

        _caption = new Label3D
        {
            Text = "IDLE", FontSize = 60, Position = new Vector3(0f, 3.0f, 0f),
            Billboard = BaseMaterial3D.BillboardModeEnum.Enabled,
            Modulate = new Color(1f, 1f, 1f), PixelSize = 0.0032f,
        };
        AddChild(_caption);

        var cam = new Camera3D { Fov = 50f, CullMask = ~4u };
        AddChild(cam);
        cam.Position = new Vector3(0.2f, 2.0f, 4.0f);
        cam.LookAt(new Vector3(0f, 1.1f, -0.3f), Vector3.Up);
        cam.MakeCurrent();
    }

    // Beat schedule checks the coordinator's aim-pitch concern: continuous
    // re-seat only runs while IsSeatReferenceValid says the pose is
    // "canonical" (level pitch, not sprinting/firing) — AIM UP/DOWN fall
    // outside that window on purpose, so the hand-bone weld should carry the
    // gun through the pitch change same as any other non-canonical animation.
    static readonly (string beat, float dur)[] Beats =
    {
        ("IDLE",     4f),
        ("AIM UP",   3f),
        ("IDLE",     2f),
        ("AIM DOWN", 3f),
    };
    int _beat; float _beatT;
    Label3D? _caption;

    public override void _PhysicsProcess(double delta)
    {
        float dt = (float)delta;
        _beatT += dt;
        if (_beat < Beats.Length - 1 && _beatT >= Beats[_beat].dur) { _beatT = 0f; _beat++; }
        string b = Beats[_beat].beat;
        if (_caption != null) _caption.Text = b;

        _refLocal?.DebugDriveThirdPerson(b, dt);
        _local?.DebugDriveThirdPerson(b, dt);
        _puppet?.DebugDriveThirdPerson(b, dt);
    }
}
