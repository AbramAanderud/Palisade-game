using Godot;
using System;

/// res://scripts/SwordCombat.cs
/// ─────────────────────────────────────────────────────────────────────────────
/// THE CORNERS JOUST — committed glide-strikes vs. timed parries.
///
/// There is no block and no stamina. Combat is two verbs:
///
///   STRIKE (attack input) — one huge committed swing. The attacker glides
///     forward for the whole windup + hit window (velocity applied by the
///     controller), damage scales with launch speed (a full-momentum pass hits
///     ~2.3× a standstill swing), and the long recovery + cooldown make every
///     pass a real commitment. No combos.
///
///   PARRY (parry input) — a short active window (~0.22 s). Success staggers
///     the attacker (~0.95 s helpless) and grants the defender a RIPOSTE buff:
///     their next strike within 1.6 s has a near-instant windup and +50% damage.
///     Missing the window leaves the defender in a long whiff recovery where
///     they take bonus damage. Parry on prediction, not reflex-spam.
///
/// Hits also interrupt: taking damage during your own windup cancels the strike
/// (first hit wins — no mutual-trade fests).
///
/// Compat notes: Stamina/MaxStam/IsExhausted are kept as properties but now mean
/// strike-cooldown readiness / staggered — HUD ring + world bars + net messages
/// keep working and display cooldown instead.
/// ─────────────────────────────────────────────────────────────────────────────
public partial class SwordCombat : Node
{
    // ── Strike timings (seconds) ─────────────────────────────────────────────
    const float WindupDur      = 0.30f;   // big readable chamber (glide starts here)
    const float RiposteWindup  = 0.12f;   // near-instant chamber after a successful parry
    const float HitDurGround   = 0.30f;   // hit window: short lunge on the ground
    const float HitDurAir      = 0.45f;   // hit window: full aerial glide
    const float RecoveryDur    = 0.35f;   // long follow-through — you are open here
    const float StrikeCooldown = 1.00f;   // after recovery before the next pass

    // ── Parry timings ────────────────────────────────────────────────────────
    const float ParryActiveDur = 0.22f;   // the timing window
    const float ParryWhiffDur  = 0.70f;   // vulnerable recovery on a missed parry
    const float StaggerDur     = 0.95f;   // attacker helpless after being parried
    const float RiposteDur     = 1.60f;   // how long the riposte buff lasts

    // ── Damage ───────────────────────────────────────────────────────────────
    // dmg = Base * (1 + SpeedDmgScale * clamp(launchSpeed / SpeedForMaxDmg, 0, 1))
    // Standstill ≈ 35, full bhop pass (16 m/s) ≈ 82 → 2-3 hits kill, speed is scary.
    const float BaseDmg         = 35f;
    const float SpeedDmgScale   = 1.35f;
    const float SpeedForMaxDmg  = 16f;
    const float RiposteDmgMult  = 1.5f;
    const float WhiffTakenMult  = 1.3f;   // bonus damage taken during parry-whiff recovery

    // ── Hit location thresholds (Y relative to target origin) ────────────────
    const float HeadMinY = 1.5f;
    const float LegsMaxY = 0.4f;

    // ── Action speed (future stat hook) ──────────────────────────────────────
    public float ActionSpeed = 1.0f;

    // ── Per-weapon stat hooks (set by PlayerController when equipping) ───────
    /// Multiplied into every damage event. 0.7 = weaker spawn sword, 1.0 = arena sword.
    public float DamageMultiplier = 1.0f;
    /// Fraction of damage dealt that heals the attacker.
    public float Lifesteal        = 0.0f;

    // ── Team / AI flags ──────────────────────────────────────────────────────
    public int  CombatTeam   = 0;    // 0 = player, 1 = enemies
    public bool AiControlled = false;

    // ── State machine ────────────────────────────────────────────────────────
    enum State { Idle, Windup, Strike, Recovery, Cooldown, Parry, ParryWhiff, Staggered }
    State _state      = State.Idle;
    float _stateTimer = 0f;
    float _stateDur   = 0f;      // full duration of current state (drives arc progress)
    bool  _hitLanded  = false;
    bool  _isAirborne = false;
    bool  _strikeIsAir = false;  // locked at strike start
    bool  _riposteStrike = false;

    float _cooldownLeft = 0f;    // strike cooldown (runs during Idle/Parry states too)
    float _riposteLeft  = 0f;    // riposte buff time remaining

    /// Speed the owner was moving at when the strike launched — damage basis.
    /// Set by PlayerController / EnemyController right before or at strike start.
    public float StrikeLaunchSpeed = 0f;

    // ── AI input flags (consumed each Tick) ──────────────────────────────────
    bool _attackRequested = false;
    bool _parryRequested  = false;
    public void RequestAttack() => _attackRequested = true;
    public void RequestParry()  => _parryRequested  = true;

    // ── Public phase (drives FP sword + puppet anims + AI reads) ─────────────
    public enum Phase { Idle, Windup, HitWindow, Recovery, Cooldown, Parry, ParryWhiff, Staggered }
    public Phase CombatPhase { get; private set; } = Phase.Idle;

    // ── Public state queries ─────────────────────────────────────────────────
    /// True while this combatant's parry window is open (or the remote puppet's is).
    public bool IsParryActive => _state == State.Parry || PuppetParryHeld;
    public bool IsStaggered   => _state == State.Staggered;
    public bool IsWhiffed     => _state == State.ParryWhiff;
    /// True while the strike glide velocity should be held (windup + hit window).
    public bool IsGliding     => _state is State.Windup or State.Strike;
    public bool HasRiposte    => _riposteLeft > 0f;
    public bool StrikeReady   => _cooldownLeft <= 0f && _state is State.Idle or State.Cooldown;
    /// True when the active strike was launched airborne.
    public bool StrikeIsAerial => _strikeIsAir;

    /// Set by the network layer when the remote opponent's parry is active.
    public bool PuppetParryHeld { get; set; } = false;

    // ── Compat properties (HUD ring, world bars, net messages) ───────────────
    // "Stamina" now displays strike readiness: full = ready to strike.
    public float Stamina => _cooldownLeft <= 0f ? 150f
        : 150f * (1f - Mathf.Clamp(_cooldownLeft / StrikeCooldown, 0f, 1f));
    public float MaxStam     => 150f;
    public bool  IsExhausted => IsStaggered;
    /// Combos are gone — kept for network/API compat, always 0.
    public int   ComboStep   => 0;

    // ── Events (wired by PlayerController / EnemyController / net relay) ─────
    /// Fires at strike start. idx: 0 = grounded lunge, 1 = aerial glide.
    public Action<int>?  OnSwingStart;
    /// Fires when the parry stance begins (true) and ends (false) — anims + relay.
    public Action<bool>? OnParryChange;
    /// Fires on the DEFENDER when their parry connects (flash/sfx/AI riposte).
    public Action?       OnParrySuccess;
    /// Fires on the ATTACKER when their strike gets parried (they are now staggered).
    public Action?       OnGotParried;

    // ── Hitbox ────────────────────────────────────────────────────────────────
    Area3D? _hitbox;

    // ── Audio ─────────────────────────────────────────────────────────────────
    AudioStreamPlayer3D _swingSfx  = null!;
    AudioStreamPlayer3D _bigSwingSfx = null!;
    AudioStreamPlayer3D _clangSfx  = null!;
    AudioStreamPlayer3D _fleshSfx  = null!;

    AudioStreamPlayer3D MakeSfx3D(Node3D parent, string path)
    {
        var sfx = new AudioStreamPlayer3D { MaxDistance = 30f };
        var stream = GD.Load<AudioStream>(path);
        if (stream != null) sfx.Stream = stream;
        parent.AddChild(sfx);
        return sfx;
    }

    // ── Setup ─────────────────────────────────────────────────────────────────
    public override void _Ready()
    {
        var parent = GetParent<Node3D>();
        _hitbox = new Area3D { Name = "SwordHitbox" };
        parent.AddChild(_hitbox);

        var cs    = new CollisionShape3D();
        cs.Shape  = new CapsuleShape3D { Radius = 0.30f, Height = 1.2f };
        _hitbox.AddChild(cs);

        _hitbox.CollisionMask = 0xFFFFFFFF;
        _hitbox.Monitoring    = true;    // always on — gated by state check in Tick
        _hitbox.Monitorable   = false;

        _swingSfx    = MakeSfx3D(parent, "res://assets/audio/sfx/combat/RegularSwordSwing.wav");
        _bigSwingSfx = MakeSfx3D(parent, "res://assets/audio/sfx/combat/ThirdSwordSwing.wav");
        _clangSfx    = MakeSfx3D(parent, "res://assets/audio/sfx/combat/swordblock.wav");
        _fleshSfx    = MakeSfx3D(parent, "res://assets/audio/sfx/combat/swordfleshimpact.wav");
    }

    // ── Per-frame tick ────────────────────────────────────────────────────────
    public void Tick(float dt, bool isAirborne, bool isWallRunning, float playerYaw)
    {
        _isAirborne = isAirborne;
        if (_cooldownLeft > 0f) _cooldownLeft -= dt;
        if (_riposteLeft  > 0f) _riposteLeft  -= dt;
        UpdateHitboxPosition(playerYaw);

        // Gather inputs: humans read the keyboard, AI uses request flags.
        bool wantsAttack = AiControlled ? _attackRequested
                         : Input.IsActionJustPressed("attack");
        bool wantsParry  = AiControlled ? _parryRequested
                         : Input.IsActionJustPressed("block");
        _attackRequested = false;
        _parryRequested  = false;

        _stateTimer -= dt;

        switch (_state)
        {
            case State.Idle:
            case State.Cooldown:
                if (_state == State.Cooldown && _stateTimer <= 0f)
                    SetState(State.Idle, 0f, Phase.Idle);
                CombatPhase = _state == State.Cooldown ? Phase.Cooldown : Phase.Idle;

                if (wantsParry)
                    StartParry();
                else if (wantsAttack && StrikeReady)
                    StartStrike(playerYaw);
                break;

            case State.Windup:
                CombatPhase = Phase.Windup;
                if (_stateTimer <= 0f)
                {
                    float hitDur = (_strikeIsAir ? HitDurAir : HitDurGround) / ActionSpeed;
                    SetState(State.Strike, hitDur, Phase.HitWindow);
                    _hitLanded = false;
                }
                break;

            case State.Strike:
                CombatPhase = Phase.HitWindow;
                if (!_hitLanded && _hitbox != null)
                    CheckHits();
                if (_stateTimer <= 0f)
                    SetState(State.Recovery, RecoveryDur / ActionSpeed, Phase.Recovery);
                break;

            case State.Recovery:
                CombatPhase = Phase.Recovery;
                if (_stateTimer <= 0f)
                {
                    _cooldownLeft = StrikeCooldown;
                    SetState(State.Cooldown, StrikeCooldown, Phase.Cooldown);
                }
                break;

            case State.Parry:
                CombatPhase = Phase.Parry;
                if (_stateTimer <= 0f)
                {
                    // Window expired with no attacker caught — wide open.
                    SetState(State.ParryWhiff, ParryWhiffDur, Phase.ParryWhiff);
                    OnParryChange?.Invoke(false);
                }
                break;

            case State.ParryWhiff:
                CombatPhase = Phase.ParryWhiff;
                if (_stateTimer <= 0f)
                    SetState(State.Idle, 0f, Phase.Idle);
                break;

            case State.Staggered:
                CombatPhase = Phase.Staggered;
                if (_stateTimer <= 0f)
                    SetState(State.Idle, 0f, Phase.Idle);
                break;
        }
    }

    void SetState(State s, float dur, Phase phase)
    {
        _state      = s;
        _stateTimer = dur;
        _stateDur   = dur;
        CombatPhase = phase;
    }

    // ── Strike ────────────────────────────────────────────────────────────────
    void StartStrike(float yaw)
    {
        _strikeIsAir   = _isAirborne;
        _riposteStrike = HasRiposte;
        _riposteLeft   = 0f;   // consume the buff
        float windup   = (_riposteStrike ? RiposteWindup : WindupDur) / ActionSpeed;
        SetState(State.Windup, windup, Phase.Windup);
        _hitLanded = false;
        OnSwingStart?.Invoke(_strikeIsAir ? 1 : 0);
        (_strikeIsAir ? _bigSwingSfx : _swingSfx).Play();

        // Knock any nearby PhysicsProp clutter — cosmetic only, does not touch
        // damage logic. Fires once per swing at windup start, when the
        // player's position + facing are both in scope.
        var self = GetParent<Node3D>();
        var fwd  = new Vector3(-Mathf.Sin(yaw), 0f, -Mathf.Cos(yaw));
        PhysicsProp.ApplySwingImpulse(self, self.GlobalPosition, fwd);
    }

    // ── Parry ─────────────────────────────────────────────────────────────────
    void StartParry()
    {
        SetState(State.Parry, ParryActiveDur, Phase.Parry);
        OnParryChange?.Invoke(true);
    }

    /// Put this combatant into the helpless stagger (their strike was parried,
    /// or a remote "parried" message says so). Public for the network layer.
    public void EnterStagger()
    {
        _hitLanded = false;
        SetState(State.Staggered, StaggerDur, Phase.Staggered);
    }

    /// Grant the riposte buff (successful parry — local or confirmed remotely).
    public void GrantRiposte()
    {
        _riposteLeft = RiposteDur;
        // A successful parry ends the parry stance cleanly — no whiff recovery,
        // and the strike cooldown is cleared so the riposte is always available.
        _cooldownLeft = 0f;
        if (_state == State.Parry)
        {
            SetState(State.Idle, 0f, Phase.Idle);
            OnParryChange?.Invoke(false);
        }
    }

    /// Taking a hit during your own windup cancels the strike (first hit wins).
    public void InterruptByHit()
    {
        if (_state is State.Windup or State.Strike)
            SetState(State.Recovery, RecoveryDur * 0.6f, Phase.Recovery);
    }

    /// Play the parry clang at this character's position (also used by net relay).
    public void PlayBlockImpact()
    {
        if (_clangSfx == null) return;
        _clangSfx.GlobalPosition = GetParent<Node3D>().GlobalPosition + Vector3.Up * 1.1f;
        _clangSfx.Play();
    }

    // ── Swing arc ────────────────────────────────────────────────────────────
    // One huge horizontal sweep, right-to-left across the body, as (right, up,
    // forward) offsets. The hitbox lerps Start→End across the hit window while
    // the body itself glides forward — so the swept volume is enormous and
    // matches the "gliding cleave" visual.
    static readonly Vector3 ArcStart = new( 0.85f, 0.75f, 0.55f);
    static readonly Vector3 ArcEnd   = new(-0.85f, 0.35f, 0.90f);

    void UpdateHitboxPosition(float yaw)
    {
        if (_hitbox == null) return;
        var player = GetParent<CharacterBody3D>();
        var fwd    = new Vector3(-Mathf.Sin(yaw), 0f, -Mathf.Cos(yaw));
        var right  = new Vector3( Mathf.Cos(yaw), 0f, -Mathf.Sin(yaw));

        if (_state is State.Windup or State.Strike or State.Recovery)
        {
            float t = _state switch
            {
                State.Windup => 0f,
                State.Strike => _stateDur > 0f
                                ? Mathf.Clamp(1f - _stateTimer / _stateDur, 0f, 1f)
                                : 1f,
                _            => 1f,
            };
            var c = ArcStart.Lerp(ArcEnd, t);
            _hitbox.GlobalPosition = player.GlobalPosition
                                   + right * c.X + Vector3.Up * c.Y + fwd * c.Z;
        }
        else
        {
            // Parked in front; no hits are polled outside the strike state.
            _hitbox.GlobalPosition = player.GlobalPosition + fwd * 0.8f + Vector3.Up * 0.55f;
        }
    }

    // ── Hit detection & resolution ────────────────────────────────────────────
    void CheckHits()
    {
        var     self    = GetParent<Node3D>();
        Node3D? nearest = null;
        float   bestD2  = float.MaxValue;
        foreach (var body in _hitbox!.GetOverlappingBodies())
        {
            if (body == self) continue;
            var otherCombat = FindSwordCombat(body);
            if (otherCombat != null && otherCombat.CombatTeam == CombatTeam) continue;
            if (body.GetNodeOrNull<PlayerHealth>("PlayerHealth") == null) continue;
            float d2 = (body.GlobalPosition - _hitbox.GlobalPosition).LengthSquared();
            if (d2 < bestD2) { bestD2 = d2; nearest = body; }
        }
        if (nearest == null) return;

        var targetCombat = FindSwordCombat(nearest);

        // ── PARRIED? Active window + facing the attacker → the pass is turned ──
        if (targetCombat != null && targetCombat.IsParryActive
            && IsDirectionalParryValid(nearest, targetCombat))
        {
            _hitLanded = true;
            PlayClangAt(_hitbox.GlobalPosition);
            targetCombat.GrantRiposte();
            targetCombat.OnParrySuccess?.Invoke();
            EnterStagger();               // attacker helpless — SetState kills the strike
            OnGotParried?.Invoke();
            GD.Print("[Combat] PARRIED! Attacker staggered, defender has riposte.");
            return;
        }

        // ── Clean hit — jousting damage ───────────────────────────────────────
        _hitLanded = true;
        float speedFrac = Mathf.Clamp(StrikeLaunchSpeed / SpeedForMaxDmg, 0f, 1f);
        float dmg = BaseDmg * (1f + SpeedDmgScale * speedFrac);
        if (_riposteStrike) dmg *= RiposteDmgMult;

        // Hit location multiplier (height heuristic)
        float relY     = _hitbox.GlobalPosition.Y - nearest.GlobalPosition.Y;
        float locMult  = relY > HeadMinY ? 1.5f : relY < LegsMaxY ? 0.5f : 1.0f;
        string locName = relY > HeadMinY ? "Head" : relY < LegsMaxY ? "Legs" : "Torso";
        dmg *= locMult;

        // Punish: whiffed parry takes bonus damage
        if (targetCombat != null && targetCombat.IsWhiffed)
        {
            dmg *= WhiffTakenMult;
            locName += " (open!)";
        }

        // Hitstun-lite: cancel the victim's in-progress strike — first hit wins
        targetCombat?.InterruptByHit();

        DeliverDamage(nearest, dmg, locName);
    }

    void PlayClangAt(Vector3 pos)
    {
        _clangSfx.GlobalPosition = pos;
        _clangSfx.Play();
    }

    bool IsDirectionalParryValid(Node3D body, SwordCombat targetCombat)
    {
        var attacker   = GetParent<Node3D>();
        var toAttacker = attacker.GlobalPosition - body.GlobalPosition;
        toAttacker.Y   = 0f;
        if (toAttacker.LengthSquared() < 0.001f) return false;
        toAttacker = toAttacker.Normalized();

        Vector3 targetFwd;
        if (body is PlayerController pc)
            targetFwd = pc.ForwardVector;
        else
            targetFwd = -body.GlobalTransform.Basis.Z;
        targetFwd.Y = 0f;
        if (targetFwd.LengthSquared() < 0.001f) return false;
        targetFwd = targetFwd.Normalized();

        // Parry connects if the attacker is within 90° of the parrier's facing.
        return toAttacker.Dot(targetFwd) > 0f;
    }

    void DeliverDamage(Node3D target, float damage, string location)
    {
        float finalDmg = damage * DamageMultiplier;
        GD.Print($"[Combat] HIT {target.Name} | {location} | {finalDmg:F0} dmg (launch {StrikeLaunchSpeed:F1} m/s)");
        var hitPos = _hitbox?.GlobalPosition ?? target.GlobalPosition;
        _fleshSfx.GlobalPosition = hitPos;
        _fleshSfx.Play();
        var health = target.GetNodeOrNull<PlayerHealth>("PlayerHealth");
        health?.TakeDamage(finalDmg, hitPos);
        SpawnDamageNumber(hitPos, finalDmg);

        if (Lifesteal > 0f)
        {
            var selfHealth = GetParent<Node3D>()?.GetNodeOrNull<PlayerHealth>("PlayerHealth");
            selfHealth?.Heal(finalDmg * Lifesteal);
        }
    }

    void SpawnDamageNumber(Vector3 worldPos, float damage)
    {
        var label = new Label3D
        {
            Text        = ((int)damage).ToString(),
            FontSize    = 72,
            Modulate    = new Color(1f, 0.12f, 0.08f, 1f),
            Billboard   = BaseMaterial3D.BillboardModeEnum.Enabled,
            NoDepthTest = true,
            Position    = worldPos + new Vector3(GD.Randf() * 0.5f - 0.25f, 0f, GD.Randf() * 0.3f - 0.15f),
        };
        GetTree().Root.AddChild(label);

        var tween = label.CreateTween();
        tween.TweenProperty(label, "position:y", label.Position.Y + 1.8f, 0.85f)
             .SetEase(Tween.EaseType.Out).SetTrans(Tween.TransitionType.Quad);
        tween.Parallel()
             .TweenProperty(label, "modulate:a", 0f, 0.5f)
             .SetDelay(0.35f);
        tween.TweenCallback(Callable.From(label.QueueFree));
    }

    static SwordCombat? FindSwordCombat(Node3D body)
    {
        foreach (Node child in body.GetChildren())
            if (child is SwordCombat sc) return sc;
        return null;
    }
}
