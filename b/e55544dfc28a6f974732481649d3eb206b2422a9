        AddChild(flash);
        flash.Position = new Vector3(0f, EyeHeight * 0.85f, 0f)
                       + ForwardVector * 0.6f;
        var tw = flash.CreateTween();
        tw.TweenProperty(flash, "light_energy", 0f, 0.07f);
        tw.TweenCallback(Callable.From(flash.QueueFree));
    }

