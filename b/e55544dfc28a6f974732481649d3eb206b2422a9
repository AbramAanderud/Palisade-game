    public void EnterTrapZone(TrapZone z)
    {
    // ── Trampoline launch ───────────────────────────────────────────────────────
    // The pit trampoline flings the player up the shaft and, for a short window
    // afterward, grants much stronger directional air control so they can steer to a
    // doorway on the way up instead of just arcing ballistically. Constants live here
    // so the feel is tuned in one place.
    const float AirBoostAccel = 26f;    // vs the normal AirAccel of 4 — sharp redirect
    const float AirBoostCap   = 14f;    // lets a boosted redirect actually build speed
    float _airBoostTimer = 0f;

    /// Fling the player straight up at `upSpeed` and grant the stronger air-control
    /// window for `boostSeconds`. Horizontal velocity is preserved so a running
    /// entry still carries across. Called by the pit trampoline.
    public void LaunchUp(float upSpeed, float boostSeconds)
    {
        Velocity = new Vector3(Velocity.X, upSpeed, Velocity.Z);
        _airBoostTimer = boostSeconds;
    }

        if (_trapZones.Add(z)) RecomputeTrapModifiers();
    }

    public void ExitTrapZone(TrapZone z)
    {
        if (_trapZones.Remove(z)) RecomputeTrapModifiers();
    }

    void RecomputeTrapModifiers()
    {
        _trapFrictionMul = 1f;
        _trapSpeedMul    = 1f;
        _trapAccelMul    = 1f;
        _trapPush        = Vector3.Zero;
        _trapNoWallRun   = false;

        // A freed zone can linger in the set for a frame if its node was removed
        // while we were inside it — drop those rather than dereferencing them.
        _trapZones.RemoveWhere(z => !IsInstanceValid(z));

        foreach (var z in _trapZones)
        {
            _trapFrictionMul *= z.FrictionMul;
            _trapSpeedMul    *= z.SpeedMul;
            _trapAccelMul    *= z.AccelMul;
            _trapPush        += z.PushAccel;
            if (z.BlocksWallRun) _trapNoWallRun = true;
        }
    }

