using Godot;

/// test/TestKnife.cs
/// Headless proof for the knife (GunCombat FireMode.Melee):
///
///   FRONT    — a stab from in front, inside reach, deals 45.
///   REACH    — a target 3 m away (past the 2.2 m reach) is untouched.
///   BACK     — a stab from within ±60° behind the target kills outright.
///   NO AMMO  — swapping knife ⇄ gun never starts a reload on the knife, and R
///              does nothing while it is held.
///   POOLS    — the knife is always carried, so it is in neither roll pool.
///
/// Lanes sit 100 m apart; each lane has its own shooter body so the stab's
/// self-exclusion is exercised the way it is on a real player.
public partial class TestKnife : Node3D
{
    const float Lane = 100f;

    PlayerHealth _front = null!, _far = null!, _back = null!;
    int _tick, _fail;

    void Check(bool ok, string label)
    {
        GD.Print((ok ? "PASS  " : "FAIL  ") + label);
        if (!ok) _fail++;
    }

    /// Player-shaped opponent, same capsule as PlayerController. `yawDeg`
    /// turns its facing: 0 faces -Z (away from a shooter at +Z), 180 faces +Z.
    PlayerHealth Target(Vector3 at, float yawDeg, string name)
    {
        var b = new StaticBody3D { Name = name };
        b.AddChild(new CollisionShape3D
        {
            Shape = new CapsuleShape3D { Radius = 0.35f, Height = 1.6f },
        });
        var h = new PlayerHealth { Name = "PlayerHealth" };
        b.AddChild(h);
        AddChild(b);
        b.GlobalPosition  = at;
        b.RotationDegrees = new Vector3(0f, yawDeg, 0f);
        b.AddToGroup("players");
        return h;
    }

    GunCombat Shooter(Vector3 at, string gun)
    {
        var s = new StaticBody3D { Name = "Shooter_" + gun };
        s.AddChild(new CollisionShape3D
        {
            Shape = new CapsuleShape3D { Radius = 0.35f, Height = 1.6f },
        });
        AddChild(s);
        s.GlobalPosition = at;
        var g = new GunCombat { CombatTeam = 0 };
        s.AddChild(g);
        g.Equip(gun);
        return g;
    }

    public override void _Ready()
    {
        // Targets centred at y=1 (feet 0.2); shooters' eyes at y=1.3, mid-chest.
        _front = Target(new Vector3(Lane * 1, 1f, 0f), 180f, "Front");   // faces the shooter
        _far   = Target(new Vector3(Lane * 2, 1f, 0f), 180f, "Far");
        _back  = Target(new Vector3(Lane * 3, 1f, 0f),   0f, "Back");    // back to the shooter
    }

    void Stab(int lane, float z)
    {
        var eye = new Vector3(Lane * lane, 1.3f, z);
        var g   = Shooter(new Vector3(Lane * lane, 1f, z + 0.3f), GunCombat.KnifeId);
        g.RequestAttack();
        g.Tick(0.016f, eye, Vector3.Forward, 0f, false);
    }

    public override void _PhysicsProcess(double delta)
    {
        if (++_tick != 3) return;   // let the physics space register the bodies

        Stab(1, 1.5f);   // 1.5 m in front
        Stab(2, 3.0f);   // 3.0 m — past reach
        Stab(3, 1.5f);   // 1.5 m behind

        Check(Mathf.IsEqualApprox(_front.CurrentHealth, 55f),
              $"front stab in reach deals 45 (hp {_front.CurrentHealth})");
        Check(Mathf.IsEqualApprox(_far.CurrentHealth, 100f),
              $"target at 3 m is out of the 2.2 m reach (hp {_far.CurrentHealth})");
        Check(_back.CurrentHealth <= 0f,
              $"backstab kills outright (hp {_back.CurrentHealth})");

        // ── No ammo, no reload ──
        var g = Shooter(new Vector3(-Lane, 1f, 0f), "ak47");
        g.RequestAttack();
        g.Tick(0.016f, new Vector3(-Lane, 1.3f, 0f), Vector3.Forward, 0f, false);
        g.SwitchTo(GunCombat.KnifeId);
        Check(!g.IsReloading && g.IsMelee, "swap to knife does not start a reload");
        g.RequestReload();
        g.Tick(0.016f, new Vector3(-Lane, 1.3f, 0f), Vector3.Forward, 0f, false);
        Check(!g.IsReloading, "R does nothing while the knife is held");
        Check(!g.IsEmpty, "knife never reads empty");
        g.SwitchTo("ak47");
        g.SwitchTo(GunCombat.KnifeId);
        Check(!g.IsReloading, "knife ⇄ gun round trip never reloads the knife");

        // ── Pools ──
        bool inPool = System.Array.IndexOf(GunCombat.StarterPool, GunCombat.KnifeId) >= 0
                   || System.Array.IndexOf(GunCombat.ArenaPool,   GunCombat.KnifeId) >= 0;
        Check(!inPool, "knife is in neither roll pool");
        Check(GunCombat.Defs[GunCombat.KnifeId].Slot == GunCombat.GunSlot.Melee,
              "knife lives in the Melee slot");
        Check(ResourceLoader.Exists(GunCombat.Defs[GunCombat.KnifeId].Model),
              "placeholder knife model exists");

        GD.Print(_fail == 0 ? "RESULT OK" : $"RESULT {_fail} FAILURE(S)");
        GetTree().Quit(_fail == 0 ? 0 : 1);
    }
}
