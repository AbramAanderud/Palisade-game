    // ── UAL paths ─────────────────────────────────────────────────────────────
    const string Ual1Path =
        "res://playerModels/animations/Universal Animation Library[Standard]/Unreal-Godot/UAL1_Standard.glb";
    const string Ual2Path =
        "res://playerModels/animations/Universal Animation Library 2[Standard]/Unreal-Godot/UAL2_Standard.glb";

    // Authored in Blender from the UAL1 pistol set: same clips, but the firing
    // hand is pulled back along the barrel and the support hand pushed forward
    // onto the handguard, giving ~0.21 m of grip spacing instead of the pistol's
    // 0.10 m. A long gun held at pistol width reads as carried, not aimed.
    const string RiflePath = "res://playerModels/animations/RifleSet.glb";

    static readonly Dictionary<string, string> RifleClips = new()
    {
        // Godot's GLTF importer strips the trailing "_Loop" (see Ual1Clips).
        ["Rifle_Idle"]       = "rifle_idle",
        ["Rifle_Shoot"]      = "rifle_shoot",
        ["Rifle_Reload"]     = "rifle_reload",
        ["Rifle_Aim_Up"]     = "rifle_aim_up",
        ["Rifle_Aim_Neutral"]= "rifle_aim_mid",
        ["Rifle_Aim_Down"]   = "rifle_aim_down",
    };

    // Six fresh weapon-pose families authored together against one contract
    // (WeaponSets.glb), replacing the old one-off Gun/Rifle split with a
    // per-gun-archetype pose (GunCombat.GunDef.AnimFamily picks one). "Rifle"
    // here shares its internal clip names with the legacy RifleClips above on
    // purpose — WeaponSets.glb re-authors that family (and adds its Sprint
    // clip); loading it after RiflePath just refines the same rifle_* names.
    static readonly string[] WeaponFamilies = { "Pistol", "Smg", "Rifle", "Shotgun", "Sniper", "Rocket", "Quad" };

    const string WeaponSetsPath = "res://playerModels/animations/WeaponSets.glb";

    // Every family exports the exact same seven actions, so build the GLB clip
    // name → internal name map mechanically instead of writing 42 lines by hand.
    static readonly Dictionary<string, string> WeaponSetClips = BuildWeaponSetClips();

    static Dictionary<string, string> BuildWeaponSetClips()
    {
        var map = new Dictionary<string, string>();
        foreach (var fam in WeaponFamilies)
        {
            string f = fam.ToLowerInvariant();
            // "_Loop" suffixes are stripped by Godot's GLTF importer (see Ual1Clips).
            map[$"{fam}_Idle"]        = $"{f}_idle";
            map[$"{fam}_Aim_Up"]      = $"{f}_aim_up";
            map[$"{fam}_Aim_Neutral"] = $"{f}_aim_mid";
            map[$"{fam}_Aim_Down"]    = $"{f}_aim_down";
            map[$"{fam}_Shoot"]       = $"{f}_shoot";
            map[$"{fam}_Reload"]      = $"{f}_reload";
            map[$"{fam}_Sprint"]      = $"{f}_sprint";
        }
        return map;
    }

    // UAL1 clips to import: GLB clip name → our internal name
    static readonly Dictionary<string, string> Ual1Clips = new()
    {
        ["Idle"]       = "idle",
        ["Walk"]       = "walk",
        ["Jog_Fwd"]    = "run",
        ["Sprint"]     = "sprint",
        ["Death01"]    = "death",
        ["Sword_Idle"] = "sword_idle",
        // Pistol set — shipped in UAL1 all along, never wired up until now.
        ["Pistol_Idle"]       = "gun_idle",   // Godot's GLTF importer strips the "_Loop" suffix
        ["Pistol_Shoot"]      = "gun_shoot",
        ["Pistol_Reload"]     = "gun_reload",
        ["Pistol_Aim_Up"]     = "gun_aim_up",
        ["Pistol_Aim_Neutral"]= "gun_aim_mid",
        ["Pistol_Aim_Down"]   = "gun_aim_down",
        // Better hit reactions than UAL2's generic knockback: these let a
        // headshot actually read as a headshot.
        ["Hit_Head"]          = "hit_head",
        ["Hit_Chest"]         = "hit_chest",
    };

    // UAL2 clips to import: GLB clip name → our internal name
    static readonly Dictionary<string, string> Ual2Clips = new()
    {
        ["NinjaJump_Start"] = "jump",
        ["NinjaJump_Idle"]  = "fall",
        ["NinjaJump_Land"]  = "land",
        ["Slide_Start"]     = "slide",
        ["Slide"]           = "slide_loop",
        ["Slide_Exit"]      = "slide_exit",
        ["Sword_Regular_A"] = "attack1",
        ["Sword_Regular_B"] = "attack2",
        ["Sword_Regular_C"] = "attack3",
        ["Sword_Block"]     = "block",
        ["Sword_Dash_RM"]   = "air_slash",
        ["Hit_Knockback"]   = "hit",
    };

    Node3D?         _modelRoot;
    AnimationPlayer? _fpAp;   // FP arms AnimationPlayer (optional — null until InitFpArms is called)

    // ── Init ─────────────────────────────────────────────────────────────────
    /// Call after placing UAL1_FpArms.glb as a camera-space child.
    /// Loads the same animation aliases into the arm model's AnimationPlayer and
    /// mirrors all subsequent playback calls to it automatically.
    public void InitFpArms(Node3D fpArmsRoot)
    {
        _fpAp = FindAnimationPlayer(fpArmsRoot);
        if (_fpAp == null)
        {
            GD.PrintErr("[PlayerAnimator] FpArms: no AnimationPlayer found");
            return;
        }
        PrepareBaseLibrary(_fpAp);
        LoadUalAnimations(_fpAp);
        GD.Print("[PlayerAnimator] FpArms AnimationPlayer wired");
    }

    public void Init(Node3D modelRoot)
    {
        _modelRoot = modelRoot;
        _ap = FindAnimationPlayer(modelRoot);
        if (_ap == null)
        {
            GD.Print("[PlayerAnimator] No AnimationPlayer found — using procedural motion.");
            return;
        }

        PrepareBaseLibrary(_ap);
        LoadUalAnimations(_ap);
        DiagnoseClips(_ap);
        BuildAnimationTree(_ap);
    }

    /// Guard against a silent failure mode that cost real time to find: a clip
    /// imported from a GLB WITHOUT Godot's humanoid retarget bone-map keeps its
    /// raw track paths ("Armature/Skeleton3D:pelvis") instead of the retargeted
    /// ones ("%GeneralSkeleton:Hips"). It loads, reports the right length and
    /// track count, and animates absolutely nothing — the bones fall to rest and
    /// you get a T-pose with no error anywhere.
    ///
    /// Any new animation GLB must carry the same retarget/bone_map subresource in
    /// its .import as UAL1_Standard.glb.
    static void DiagnoseClips(AnimationPlayer ap)
    {
        var clips = new List<string> { "gun_idle", "gun_aim_mid", "gun_shoot", "gun_reload" };
        foreach (var fam in WeaponFamilies)
        {
            string f = fam.ToLowerInvariant();
            clips.Add($"{f}_idle");
            clips.Add($"{f}_aim_mid");
            clips.Add($"{f}_shoot");
            clips.Add($"{f}_reload");
            clips.Add($"{f}_sprint");
        }
        foreach (var clip in clips)
        {
            if (!ap.HasAnimation(clip)) continue;
            var a = ap.GetAnimation(clip);
            if (a.GetTrackCount() == 0) continue;
            string first = a.TrackGetPath(0).ToString();
            if (!first.StartsWith("%GeneralSkeleton"))
                GD.PrintErr($"[PlayerAnimator] '{clip}' is NOT retargeted (first track " +
                            $"'{first}'). It will animate nothing — re-import its GLB with " +
                            "the humanoid retarget bone map.");
        }
    }

    // ── Library prep ─────────────────────────────────────────────────────────
    // Make the imported library mutable. Preserve existing clips — if the character
    // IS the UAL1 mannequin it already has its locomotion clips; we only add UAL2 extras.
    void PrepareBaseLibrary(AnimationPlayer ap)
    {
        AnimationLibrary lib;
        if (ap.HasAnimationLibrary(""))
        {
            lib = (AnimationLibrary)ap.GetAnimationLibrary("").Duplicate(true);
            ap.RemoveAnimationLibrary("");
        }
        else
        {
            lib = new AnimationLibrary();
        }
        ap.AddAnimationLibrary("", lib);
    }

    // ── UAL loading ───────────────────────────────────────────────────────────
    // Add our internal-name aliases for all clips.  For UAL1 clips the character may
    // already have them under their original names; we add our lowercased aliases on top.
    void LoadUalAnimations(AnimationPlayer ap)
    {
        if (!ap.HasAnimationLibrary("")) return;
        var lib = ap.GetAnimationLibrary("");
        CopyClipsFromGlb(RiflePath, RifleClips, lib);
        CopyClipsFromGlb(Ual1Path, Ual1Clips, lib);
        CopyClipsFromGlb(Ual2Path, Ual2Clips, lib);
        // Absent until the WeaponSets clips are exported — CopyClipsFromGlb already
        // no-ops gracefully (GD.Load returns null, it prints and returns) when the
        // GLB doesn't exist yet, so every family below just falls back to legacy.
        CopyClipsFromGlb(WeaponSetsPath, WeaponSetClips, lib);
    }

    void CopyClipsFromGlb(string path, Dictionary<string, string> clipMap, AnimationLibrary lib)
    {
        var packed = GD.Load<PackedScene>(path);
        if (packed == null)
        {
            GD.PrintErr($"[PlayerAnimator] Could not load: {path}");
            return;
        }
        var tempRoot = packed.Instantiate<Node>();
        var srcAp = FindAnimationPlayer(tempRoot);
        if (srcAp == null)
        {
            GD.PrintErr($"[PlayerAnimator] No AnimationPlayer in: {path}");
            tempRoot.Free();
            return;
        }

        foreach (var (srcName, dstName) in clipMap)
        {
            if (!srcAp.HasAnimation(srcName))
            {
                GD.PrintErr($"[PlayerAnimator] Clip not found: '{srcName}' in {path}");
                continue;
            }
            var anim = (Animation)srcAp.GetAnimation(srcName).Duplicate(true);
            // Root-motion clips (_RM suffix) contain Position3D tracks that physically
            // translate the mesh away from the CharacterBody3D origin. Strip them so
            // our physics-based movement drives all translation and the mesh never drifts.
            if (dstName == "air_slash") StripPosition3DTracks(anim);
            if (lib.HasAnimation(dstName)) lib.RemoveAnimation(dstName);
            lib.AddAnimation(dstName, anim);
        }

        tempRoot.Free();
    }

    static void StripPosition3DTracks(Animation anim)
    {
        for (int i = anim.GetTrackCount() - 1; i >= 0; i--)
            if (anim.TrackGetType(i) == Animation.TrackType.Position3D)
                anim.RemoveTrack(i);
    }

    // ── AnimationTree construction ────────────────────────────────────────────
    void BuildAnimationTree(AnimationPlayer ap)
    {
        var sm = new AnimationNodeStateMachine();

        // Locomotion blend space: 0.0 → idle, 0.35 → walk, 1.0 → run/sprint
        var loco = new AnimationNodeBlendSpace1D();
        bool locoHasPoints = false;
        foreach (var (state, blendPos) in new (AnimState, float)[] {
            (AnimState.Idle, 0.0f), (AnimState.Walk, 0.35f), (AnimState.Run, 1.0f) })
        {
            if (AnimNames.TryGetValue(state, out var clip) && ap.HasAnimation(clip))
            {
                loco.AddBlendPoint(new AnimationNodeAnimation { Animation = clip }, blendPos);
                locoHasPoints = true;
            }
        }
        if (locoHasPoints)
        {
            sm.AddNode("Locomotion", loco, new Vector2(-200f, 0f));
            _validSmNodes.Add("Locomotion");
        }

        // One-shot states — only added when the clip loaded successfully
        var added = new HashSet<string>(_validSmNodes);
        foreach (var (state, nodeName) in StateToSmNode)
        {
            if (nodeName == "Locomotion" || added.Contains(nodeName)) continue;
            if (AnimNames.TryGetValue(state, out var clip) && ap.HasAnimation(clip))
            {
                sm.AddNode(nodeName, new AnimationNodeAnimation { Animation = clip }, Vector2.Zero);
                _validSmNodes.Add(nodeName);
                added.Add(nodeName);
            }
        }

        // Hub-and-spoke: every state ↔ Locomotion
        var blendReturn = new AnimationNodeStateMachineTransition { XfadeTime = 0.2f };
        var snapEnter   = new AnimationNodeStateMachineTransition { XfadeTime = 0.05f };
        foreach (var nodeName in _validSmNodes)
        {
            if (nodeName == "Locomotion") continue;
            if (_validSmNodes.Contains("Locomotion"))
            {
                sm.AddTransition("Locomotion", nodeName, snapEnter);
                sm.AddTransition(nodeName, "Locomotion", blendReturn);
            }
        }
        foreach (var (from, to) in new[] {
            ("Swing1", "Swing2"), ("Swing2", "Swing3"),
            ("Slide", "SlideLoop"), ("SlideLoop", "SlideExit") })
            if (_validSmNodes.Contains(from) && _validSmNodes.Contains(to))
                sm.AddTransition(from, to, snapEnter);

        // ── Upper-body gun layer ───────────────────────────────────────────────
        // The whole point of this layer: in a fight you must be able to read your
        // opponent's LEGS and ARMS independently. Sprinting toward you while
        // aiming, or reloading while backpedalling, are different threats — a
        // single full-body state machine cannot express either, and shooting
        // mid-sprint would snap the legs to a standing pose.
        //
        // Layer 0 (below) is locomotion, full body. Layer 1 is the gun pose, and a
        // bone filter restricts it to the spine, arms and hands, so the legs keep
        // running underneath it.
        var root = BuildUpperBodyLayer(ap, sm);

        var animTree = new AnimationTree
        {
            Name       = "AnimationTree",
            TreeRoot   = root,
            AnimPlayer = ap.GetPath(),
            Active     = true,
        };
        _modelRoot!.GetParent().AddChild(animTree);
        _animTree = animTree;

        if (_hasUpperLayer)
        {
            _upperPlayback = _animTree.Get("parameters/UpperSM/playback")
                                .As<AnimationNodeStateMachinePlayback>();
            // Gun pose fully on — the player is always holding a gun.
            _animTree.Set("parameters/GunLayer/blend_amount", 1.0f);
            _upperPlayback?.Start(RestNode);
        }
    }

    /// Bones the gun layer must NOT touch — everything else (chest up, both arms,
    /// and all thirty finger bones) belongs to the gun pose.
    ///
    /// Expressed as an exclusion list on purpose: the rig uses Godot's humanoid
    /// profile, whose upper body is ~50 bones once fingers are counted, and an
    /// inclusion list would silently drop whichever ones were forgotten. The lower
    /// body is only these eight, and `Hips` must stay with locomotion because it
    /// carries the whole body's bob and turn.
    static readonly HashSet<string> LowerBodyBones = new()
    {
        "Root", "Hips",
        "LeftUpperLeg",  "LeftLowerLeg",  "LeftFoot",  "LeftToes",
        "RightUpperLeg", "RightLowerLeg", "RightFoot", "RightToes",
    };

    bool _hasUpperLayer = false;
    AnimationNodeStateMachinePlayback? _upperPlayback;

    /// Wrap the locomotion state machine in a filtered Blend2 whose second input
    /// is a small gun state machine — one branch per weapon-pose family (aim
    /// blendspace / shoot / reload / optional sprint loop).
    AnimationRootNode BuildUpperBodyLayer(AnimationPlayer ap, AnimationNodeStateMachine locoSm)
    {
        var upper = new AnimationNodeStateMachine();
        var snap  = new AnimationNodeStateMachineTransition { XfadeTime = 0.06f };
        var ret   = new AnimationNodeStateMachineTransition { XfadeTime = 0.15f };
        var swap  = new AnimationNodeStateMachineTransition { XfadeTime = 0.20f };

        // "Gun" (the UAL1 pistol set) is the mandatory hub family — it's the one
        // every character has always shipped with. Every other family swaps
        // in/out through it (a two-hop Travel) instead of needing a direct edge
        // to every other family: O(n) edges instead of O(n^2).
        if (!BuildFamily(upper, ap, "Gun", "gun", 0f, snap, ret))
        {
            GD.Print("[PlayerAnimator] No gun-aim clips — upper-body layer disabled");
            return locoSm;
        }

        // "Rifle" is the legacy RifleSet.glb family — transparently refined (and
        // given a Sprint clip) if WeaponSets.glb has also loaded, since both
        // target the same rifle_* internal clip names. The rest only exist once
        // WeaponSets.glb is authored; each is skipped (no node added) until then.
        float y = 240f;
        foreach (var (nodeKey, clipPrefix) in new (string, string)[]
        {
            ("Rifle", "rifle"), ("Pistol", "pistol"), ("Smg", "smg"),
            ("Shotgun", "shotgun"), ("Sniper", "sniper"), ("Rocket", "rocket"),
        })
        {
            if (BuildFamily(upper, ap, nodeKey, clipPrefix, y, snap, ret))
            {
                upper.AddTransition("GunAim", nodeKey + "Aim", swap);
                upper.AddTransition(nodeKey + "Aim", "GunAim", swap);
            }
            y += 240f;
        }
        if (!_availableFamilies.Contains("rifle"))
            GD.Print("[PlayerAnimator] Rifle clip set missing — every gun uses the pistol pose");

        // A programmatically-built nested state machine has no entry point, so it
        // sits on nothing and the filtered bones fall back to the rest pose — a
        // T-pose from the chest up. This transition is what actually starts it.
        upper.AddTransition("Start", "GunAim", snap);

        var blend = new AnimationNodeBlend2 { FilterEnabled = true };
        blend.SetInputName(0, "loco");
        blend.SetInputName(1, "gun");

        // Filter paths must match the animation TRACK paths exactly, so derive
        // them from a real clip rather than guessing the skeleton's node path.
        int filtered = ApplyUpperBodyFilter(blend, ap, "gun_idle");
        if (filtered == 0)
        {
            GD.PrintErr("[PlayerAnimator] Upper-body filter matched no tracks — " +
                        "gun layer would override the legs; disabling it");
            return locoSm;
        }

        var tree = new AnimationNodeBlendTree();
        tree.AddNode("LocoSM",   locoSm, new Vector2(0f,   0f));
        tree.AddNode("UpperSM",  upper,  new Vector2(0f, 200f));
        tree.AddNode("GunLayer", blend,  new Vector2(340f, 90f));
        tree.ConnectNode("GunLayer", 0, "LocoSM");
        tree.ConnectNode("GunLayer", 1, "UpperSM");
        tree.ConnectNode("output",   0, "GunLayer");

        _hasUpperLayer = true;
        // _availableFamilies is final now — resolve once so Start(RestNode) below
        // (back in BuildAnimationTree) and every other consumer read a real value.
        ResolveFamily();
        GD.Print($"[PlayerAnimator] Upper-body gun layer active ({filtered} bone tracks filtered, " +
                 $"families: {string.Join(", ", _availableFamilies)})");
        return tree;
    }

    /// One state-machine "weapon family": an Aim blendspace, Shoot/Reload
    /// one-shots, and — only if the clip actually loaded — a Sprint loop. Every
    /// family (the legacy Gun/Rifle pair and the six WeaponSets ones) goes
    /// through this same path; a family is just a clip-name prefix (internal
    /// animation names) plus a node-name prefix (state-machine node names).
    /// Returns whether the family had enough clips to build at all.
    bool BuildFamily(AnimationNodeStateMachine upper, AnimationPlayer ap,
                      string nodeKey, string clipPrefix, float y,
                      AnimationNodeStateMachineTransition snap,
                      AnimationNodeStateMachineTransition ret)
    {
        // Vertical aim blend: -1 aiming down, 0 level, +1 aiming up. Driven by
        // camera pitch through SetAimPitch, so the barrel visibly tracks where
        // the player is looking — the main cue for reading an opponent at range.
        var aim = BuildAimBlend(ap, $"{clipPrefix}_aim_down", $"{clipPrefix}_aim_mid", $"{clipPrefix}_aim_up");

        // Without the aim clips there is no meaningful pose for this family —
        // skip it rather than blending in something broken.
        if (aim == null || !ap.HasAnimation($"{clipPrefix}_idle"))
            return false;

        string aimNode = nodeKey + "Aim";
        upper.AddNode(aimNode, aim, new Vector2(0f, y));
        _validUpperNodes.Add(aimNode);
        AddOneShots(upper, ap, nodeKey, $"{clipPrefix}_shoot", $"{clipPrefix}_reload", snap, ret, y);

        string sprintClip = $"{clipPrefix}_sprint";
        if (ap.HasAnimation(sprintClip))
        {
            string sprintNode = nodeKey + "Sprint";
            upper.AddNode(sprintNode, new AnimationNodeAnimation { Animation = sprintClip },
                          new Vector2(400f, y));
            upper.AddTransition(aimNode, sprintNode, ret);
            upper.AddTransition(sprintNode, aimNode, ret);
            _validUpperNodes.Add(sprintNode);
            _familiesWithSprint.Add(clipPrefix);
        }

        _availableFamilies.Add(clipPrefix);
        return true;
    }

    readonly HashSet<string> _validUpperNodes    = new();
    readonly HashSet<string> _availableFamilies  = new();   // lowercase clip prefixes that built a node
    readonly HashSet<string> _familiesWithSprint = new();   // subset of the above with a Sprint node too

    /// requested → resolved fallback chain. "Rifle" is listed for smg/shotgun/
    /// sniper because a shouldered-but-unauthored family should still read as
    /// "holding a long gun" rather than snapping back to the one-handed pistol
    /// pose; pistol/rocket skip straight to "gun" since neither has a shouldered
    /// analogue that reads better than the fallback pistol pose.
    static readonly Dictionary<string, string[]> FamilyFallback = new()
    {
        ["gun"]     = new[] { "gun" },
        ["pistol"]  = new[] { "pistol", "gun" },
        ["rifle"]   = new[] { "rifle", "gun" },
        ["smg"]     = new[] { "smg", "rifle", "gun" },
        ["shotgun"] = new[] { "shotgun", "rifle", "gun" },
        ["sniper"]  = new[] { "sniper", "rifle", "gun" },
        ["rocket"]  = new[] { "rocket", "gun" },
        ["quad"]    = new[] { "quad", "rocket", "gun" },
    };

    // "Requested" is whatever gameplay code last asked for (SetAnimFamily /
    // SetWeaponClass); "resolved" is what ResolveFamily fell back to once
    // _availableFamilies was known. Everything downstream (Travel targets, FP
    // arms clip names, SetAimPitch's parameter path) reads the resolved pair —
    // never the raw request.
    string _requestedFamily    = "pistol";   // matches the old default (no weapon equipped yet → pistol pose)
    string _resolvedClipPrefix = "gun";
    string _resolvedNodeKey    = "Gun";

    /// The single place the "requested family → whatever actually loaded"
    /// fallback lives (see FamilyFallback). Only needs to run when the request
    /// changes, not every frame — the result is cached in the two fields above.
    void ResolveFamily()
    {
        var chain = FamilyFallback.TryGetValue(_requestedFamily, out var c) ? c : new[] { "gun" };
        string resolved = "gun";
        foreach (var key in chain)
        {
            if (_availableFamilies.Contains(key)) { resolved = key; break; }
        }
        _resolvedClipPrefix = resolved;
        _resolvedNodeKey    = char.ToUpperInvariant(resolved[0]) + resolved[1..];
    }

    /// Node-name prefix for the resolved family's Aim state, e.g. "RifleAim".
    string AimNode => _resolvedNodeKey + "Aim";
    /// Node-name prefix for the resolved family's Shoot/Reload one-shots, e.g. "Rifle".
    string Prefix  => _resolvedNodeKey;

    /// Where the upper layer rests when no one-shot is playing: the resolved
    /// family's Sprint loop while sprinting (if that family has one), else Aim.
    string RestNode => (_sprinting && _familiesWithSprint.Contains(_resolvedClipPrefix))
        ? _resolvedNodeKey + "Sprint" : AimNode;

    /// Select a weapon-pose family by its (lowercase) key — "pistol", "smg",
    /// "rifle", "shotgun", "sniper", "rocket", or the legacy "gun". Resolves
    /// through FamilyFallback so callers never need to know which of
    /// WeaponSets.glb's families have actually been authored/loaded yet.
    public void SetAnimFamily(string family)
    {
        string key = string.IsNullOrEmpty(family) ? "gun" : family.ToLowerInvariant();
        if (key == _requestedFamily) return;
        _requestedFamily = key;
        ResolveFamily();
        if (_hasUpperLayer && _upperReturnTimer <= 0f)
            _upperPlayback?.Travel(RestNode);
    }

    /// Thin shim over SetAnimFamily for existing call sites — "rifle" for every
    /// shouldered weapon, "pistol" for the one-handed sidearm.
    public void SetWeaponClass(bool rifle) => SetAnimFamily(rifle ? "rifle" : "pistol");

    bool _sprinting = false;

    /// While sprinting the upper layer rests in the family's Sprint loop instead
    /// of Aim — legs and arms both read "moving fast" instead of the arms
    /// holding a static aim pose while the legs sprint underneath (the whole
    /// point of the two-layer split is to keep these independently readable).
    /// Families without a Sprint clip yet just stay on Aim — a no-op, not an
    /// error, since several are still mid-export.
    public void SetSprinting(bool on)
    {
        if (on == _sprinting) return;
        _sprinting = on;
        if (_hasUpperLayer && _upperReturnTimer <= 0f)
            _upperPlayback?.Travel(RestNode);
    }

    /// Upper-layer maintenance ONLY: one-shot return timer + the settle-to-rest
    /// self-heal. Remote puppets need this every frame even though full Tick()
    /// never runs for them — their locomotion is relayed via ApplyPuppetState,
    /// and driving Tick's state selection would fight that relay. Without this
    /// call the puppet's upper state machine never starts and the opponent
    /// renders REST-POSE ARMS (chest-up T-pose) for the whole match.
    public void TickUpperOnly(float dt)
    {
        if (_upperReturnTimer > 0f)
        {
            _upperReturnTimer -= dt;
            if (_upperReturnTimer <= 0f) _upperPlayback?.Travel(RestNode);
        }
        else if (_hasUpperLayer && _upperPlayback != null)
        {
            // Settle into the right rest node for the equipped weapon. Done here
            // rather than only on equip because a Travel issued before the nested
            // state machine has actually started silently goes nowhere, leaving
            // the filtered bones on the rest pose — a T-pose from the chest up.
            if (_upperPlayback.GetCurrentNode().ToString() != RestNode)
                _upperPlayback.Travel(RestNode);
        }
    }

    static AnimationNodeBlendSpace1D? BuildAimBlend(
        AnimationPlayer ap, string down, string mid, string up)
    {
        var bs = new AnimationNodeBlendSpace1D { MinSpace = -1f, MaxSpace = 1f };
        int n = 0;
        foreach (var (clip, pos) in new (string, float)[] { (down, -1f), (mid, 0f), (up, 1f) })
        {
            if (!ap.HasAnimation(clip)) continue;
            bs.AddBlendPoint(new AnimationNodeAnimation { Animation = clip }, pos);
            n++;
        }
        return n > 0 ? bs : null;
    }

    void AddOneShots(AnimationNodeStateMachine sm, AnimationPlayer ap, string prefix,
                     string shootClip, string reloadClip,
                     AnimationNodeStateMachineTransition snap,
                     AnimationNodeStateMachineTransition ret, float y)
    {
        foreach (var (clip, suffix, dy) in new (string, string, float)[] {
            (shootClip, "Shoot", -80f), (reloadClip, "Reload", 80f) })
        {
            if (!ap.HasAnimation(clip)) continue;
            string node = prefix + suffix;
            sm.AddNode(node, new AnimationNodeAnimation { Animation = clip },
                       new Vector2(240f, y + dy));
            sm.AddTransition(prefix + "Aim", node, snap);
            sm.AddTransition(node, prefix + "Aim", ret);
            _validUpperNodes.Add(node);
        }
    }

    /// Enable the Blend2 filter for every track belonging to an upper-body bone.
    /// Returns how many tracks were matched.
    static int ApplyUpperBodyFilter(AnimationNodeBlend2 blend, AnimationPlayer ap, string clip)
    {
        var anim = ap.GetAnimation(clip);
        if (anim == null) return 0;

        var seen = new HashSet<string>();
        int count = 0;
        for (int i = 0; i < anim.GetTrackCount(); i++)
        {
            var path = anim.TrackGetPath(i);          // e.g. "%GeneralSkeleton:RightHand"
            if (path.GetSubNameCount() == 0) continue;
            string bone = path.GetSubName(path.GetSubNameCount() - 1);
            seen.Add(bone);
            if (LowerBodyBones.Contains(bone)) continue;
            blend.SetFilterPath(path, true);
            count++;
        }
        GD.Print($"[PlayerAnimator] Upper-body filter: {count}/{anim.GetTrackCount()} " +
                 $"tracks routed to the gun layer ({seen.Count} bones in '{clip}')");
        return count;
    }

    AnimationPlayer? FindAnimationPlayer(Node root)
    {
        if (root is AnimationPlayer ap) return ap;
        foreach (Node child in root.GetChildren())
        {
            var found = FindAnimationPlayer(child);
            if (found != null) return found;
        }
        return null;
    }

    // ── Static NPC helpers (used by EnemyController) ──────────────────────────
    static readonly Dictionary<string, string> NpcUal1Clips = new()
    {
        ["Idle"]    = "idle",
        ["Walk"]    = "walk",
        ["Death01"] = "death",
    };
    static readonly Dictionary<string, string> NpcUal2Clips = new()
    {
        ["Sword_Regular_A"] = "attack1",
        ["Sword_Block"]     = "block",
    };

    public static AnimationPlayer? FindAnimationPlayerStatic(Node root)
    {
        if (root is AnimationPlayer ap) return ap;
        foreach (Node child in root.GetChildren())
        {
            var found = FindAnimationPlayerStatic(child);
            if (found != null) return found;
        }
        return null;
    }

    public static void SetupNpcAnimations(AnimationPlayer ap)
    {
        AnimationLibrary lib;
        if (ap.HasAnimationLibrary(""))
        {
            lib = (AnimationLibrary)ap.GetAnimationLibrary("").Duplicate(true);
            ap.RemoveAnimationLibrary("");
        }
        else
        {
            lib = new AnimationLibrary();
        }
        ap.AddAnimationLibrary("", lib);
        CopyClipsFromGlbStatic(Ual1Path, NpcUal1Clips, lib);
        CopyClipsFromGlbStatic(Ual2Path, NpcUal2Clips, lib);
    }

    static void CopyClipsFromGlbStatic(string path, Dictionary<string, string> clipMap, AnimationLibrary lib)
    {
        var packed = GD.Load<PackedScene>(path);
        if (packed == null) { GD.PrintErr($"[NpcAnim] Could not load: {path}"); return; }
        var tempRoot = packed.Instantiate<Node>();
        var srcAp    = FindAnimationPlayerStatic(tempRoot);
        if (srcAp == null) { GD.PrintErr($"[NpcAnim] No AnimationPlayer in: {path}"); tempRoot.Free(); return; }
        foreach (var (srcName, dstName) in clipMap)
        {
            if (!srcAp.HasAnimation(srcName)) { GD.PrintErr($"[NpcAnim] Clip not found: '{srcName}'"); continue; }
            var anim = (Animation)srcAp.GetAnimation(srcName).Duplicate(true);
            if (lib.HasAnimation(dstName)) lib.RemoveAnimation(dstName);
            lib.AddAnimation(dstName, anim);
        }
        tempRoot.Free();
    }

    // When BuildUpperBodyLayer wraps locomotion in the outer gun-layer BlendTree,
    // the locomotion state machine becomes a nested node named "LocoSM" instead of
    // the tree root, so its exposed parameters move from "parameters/playback" to
    // "parameters/LocoSM/playback". Without this prefix EnsurePlayback/UpdateLocoBlend
    // silently resolve nothing (Get returns null), the nested machine is never
    // Start()ed, and locomotion (idle/walk/run/jump/...) never plays at all — which
    // reads exactly like "the gun pose ate all the movement animations".
    string LocoParamPrefix => _hasUpperLayer ? "LocoSM/" : "";

    // Lazily resolved on the first Tick after AnimationTree is ready.
    void EnsurePlayback()
    {
        if (_smPlayback != null || _animTree == null) return;
        _smPlayback = _animTree.Get($"parameters/{LocoParamPrefix}playback").As<AnimationNodeStateMachinePlayback>();
        if (_smPlayback == null) return;

        string startNode = _validSmNodes.Contains("Locomotion") ? "Locomotion"
                         : _validSmNodes.Count > 0 ? System.Linq.Enumerable.First(_validSmNodes)
                         : "";
        if (startNode.Length > 0)
            _smPlayback.Start(startNode);
    }

    // ── Per-frame tick ────────────────────────────────────────────────────────
    public void Tick(float dt, bool onFloor, bool sliding, bool wallRunning,
                     float wallRollSign, bool hasWeapon, float speed, float verticalVel)
    {
        EnsurePlayback();

        bool slideJustStarted = sliding  && !_prevSliding;
        bool slideJustEnded   = !sliding && _prevSliding;
        if (slideJustStarted) _slidePhase = 0f;
        if (sliding)          _slidePhase += dt;
        _prevSliding = sliding;

        if (_combatLock)
        {
            _combatLockTimer -= dt;
            if (_combatLockTimer <= 0f)
            {
                _combatLock = false;
                // Return to locomotion once the combat animation finishes
                _state = DetermineState(onFloor, sliding, wallRunning, speed, verticalVel);
                PlayState(_state, speed);
            }
        }
        else
        {
            var next = DetermineState(onFloor, sliding, wallRunning, speed, verticalVel);
            if (slideJustEnded) next = AnimState.SlideExit;

            if (next != _state)
            {
                _state = next;
                PlayState(_state, speed);
            }
            else if (_state is AnimState.Idle or AnimState.Walk or AnimState.Run)
            {
                UpdateLocoBlend(speed);
                UpdateFpArmsLocoClip(speed);
            }
        }

        // Upper-body one-shots run on their own clock, independent of the
        // locomotion state machine below them. RestNode reflects whatever
        // _sprinting was set to when the one-shot finishes, so a shot fired
        // mid-sprint returns to Sprint rather than snapping to a static Aim.
        TickUpperOnly(dt);

        if (_modelRoot != null)
            ApplyProceduralMotion(dt, onFloor, sliding, wallRunning, wallRollSign, speed);
    }

    AnimState DetermineState(bool onFloor, bool sliding, bool wallRunning,
                              float speed, float verticalVel)
    {
        if (wallRunning)  return AnimState.WallRun;
        if (sliding)      return AnimState.SlideLoop;
        if (!onFloor)     return verticalVel > 0f ? AnimState.Jump : AnimState.Fall;
        if (speed > 7f)   return AnimState.Run;
        if (speed > 0.5f) return AnimState.Walk;
        return AnimState.Idle;
    }

    void PlayState(AnimState state, float speed = 0f)
    {
        // Restore any direct-playback freeze (block guard pose, aerial lunge hold)
        if (_ap   != null && _ap.SpeedScale   == 0f) _ap.SpeedScale   = 1f;
        if (_fpAp != null && _fpAp.SpeedScale == 0f) _fpAp.SpeedScale = 1f;
        if (_animTree != null && !_animTree.Active && !_dying)  _animTree.Active  = true;

        if (_smPlayback != null && StateToSmNode.TryGetValue(state, out var smNode))
        {
            string target = _validSmNodes.Contains(smNode) ? smNode
                          : _validSmNodes.Contains("Locomotion") ? "Locomotion" : "";
            if (target.Length > 0)
            {
                _smPlayback.Travel(target);
                if (target == "Locomotion") UpdateLocoBlend(speed);
            }
        }
        else if (_ap != null && AnimNames.TryGetValue(state, out var directName))
        {
            if (_ap.HasAnimation(directName)) _ap.Play(directName);
        }

        // Mirror to FP arms AnimationPlayer (no AnimationTree — simple clip play)
        if (_fpAp != null && AnimNames.TryGetValue(state, out var fpName))
        {
            // For locomotion, pick the closest discrete clip rather than blend-space
            if (state is AnimState.Idle or AnimState.Walk or AnimState.Run)
                UpdateFpArmsLocoClip(speed);
            // Jump/Fall borrow UAL2's NinjaJump_Start/Idle (full-body clips authored
            // for the TP skeleton's Jump/Fall states, see Ual2Clips) — on the arms-
            // only FP viewmodel that pose swings the hand/gun out of the camera's
            // frustum entirely (verified by capture: the viewmodel goes fully
            // invisible for the whole jump/fall). Same fix as the sprint carry:
            // the FP arms just hold their current pose (aim_mid) through Jump/Fall
            // instead, so the gun stays visible and on the reticle in the air too.
            else if (state is not (AnimState.Jump or AnimState.Fall) && _fpAp.HasAnimation(fpName))
                _fpAp.Play(fpName);
        }
    }

    void UpdateLocoBlend(float speed)
    {
        if (_animTree == null || !_validSmNodes.Contains("Locomotion")) return;
        _animTree.Set($"parameters/{LocoParamPrefix}Locomotion/blend_position", Mathf.Clamp(speed / 11f, 0f, 1f));
    }

    /// The first-person arms are a viewmodel, not a body: there are no legs down
    /// there to sell walking, so playing locomotion clips on them just makes the
    /// gun wobble for no reason. They hold the weapon pose (Aim-mid) instead, and
    /// the aim/shoot/reload one-shots below drive everything else the player sees.
    ///
    /// Deliberately NEVER switches to the family's Sprint clip here (unlike the
    /// TP body's RestNode, below) — that clip is what parked a raised fist mid-
    /// screen during sprint (the "take out the holding hand" complaint). The gun
    /// now stays aimed by re-seating continuously through sprint instead (see
    /// PlayerController.IsSeatReferenceValid's firstPerson branch), with only a
    /// mild holder-level nudge (FpArmsPosSprint/FpSprintTuck) for sprint feel.
    /// The opponent's third-person read is untouched: RestNode/_upperPlayback
    /// still travel to the Sprint node exactly as before.
    void UpdateFpArmsLocoClip(float speed)
    {
        if (_fpAp == null) return;
        string clip = _resolvedClipPrefix + "_aim_mid";
        if (!_fpAp.HasAnimation(clip)) clip = "gun_idle";
        if (_fpAp.HasAnimation(clip) && _fpAp.CurrentAnimation != clip)
            _fpAp.Play(clip);
    }

    // ── Slide phase tracking ─────────────────────────────────────────────────
    float _slidePhase   = 0f;
    bool  _prevSliding  = false;
    const float SlideEntryDur = 0.35f;  // seconds before transitioning to slide_loop

    // ── Death lock — prevents any re-enable of the AnimationTree after death ────
    bool _dying = false;

    // ── Combat animation lock ─────────────────────────────────────────────────
    // Prevents locomotion DetermineState from overriding a playing combat animation.
    bool  _combatLock      = false;
    float _combatLockTimer = 0f;

    // Total durations (Windup+HitWindow+Recovery) for each combo step, matching SwordCombat constants
    static readonly float[] SwingDurations = { 0.40f, 0.36f, 0.70f };

    // ── Procedural motion: bob, tilt, lean ───────────────────────────────────
    float _bobTimer   = 0f;
    float _prevBobSin = 0f;
    float _tiltAngle  = 0f;
    float _leanAngle  = 0f;

    /// Fires once per footfall with the player's horizontal speed.
    public Action<float>? StepTaken;

    void ApplyProceduralMotion(float dt, bool onFloor, bool sliding, bool wallRunning,
                               float wallRollSign, float speed)
    {
        if (_modelRoot == null) return;

        if ((onFloor || wallRunning) && !sliding && speed > 0.5f)
        {
            _bobTimer += dt * (speed > 7f ? 14f : 9f);
            float sinNow = Mathf.Sin(_bobTimer);
            float bob    = sinNow * 0.04f;
            _modelRoot.Position = _modelRoot.Position with { Y = bob };

            // Fire StepTaken once per full bob cycle (negative→positive crossing only)
            if (_prevBobSin < 0f && sinNow >= 0f)
                StepTaken?.Invoke(speed);
            _prevBobSin = sinNow;
        }
        else
        {
            _bobTimer   = 0f;
            _prevBobSin = 0f;
            _modelRoot.Position = _modelRoot.Position with
            {
                Y = Mathf.MoveToward(_modelRoot.Position.Y, 0f, 3f * dt)
            };
        }

        float targetTilt = sliding ? 0.35f : 0f;
        _tiltAngle = Mathf.MoveToward(_tiltAngle, targetTilt, 4f * dt);

        // Lean toward whichever wall we're running along.
        // wallRollSign: +1 = wall on right, lean right; -1 = wall on left, lean left.
        // Model has 180° Y rotation so Z-lean sign is negated relative to world.
        float targetLean = wallRunning ? -wallRollSign * 0.25f : 0f;
        _leanAngle = Mathf.MoveToward(_leanAngle, targetLean, 5f * dt);

        _modelRoot.Rotation = new Vector3(_tiltAngle, _modelRoot.Rotation.Y, _leanAngle);
    }

    // ── Combat animation hooks ────────────────────────────────────────────────
    public void PlayAttack(int comboStep)
    {
        var state = comboStep switch
        {
            1 => AnimState.SwordSwing2,
            2 => AnimState.SwordSwing3,
            _ => AnimState.SwordSwing
        };
        _state           = state;
        _combatLock      = true;
        _combatLockTimer = SwingDurations[Mathf.Clamp(comboStep, 0, 2)];
        PlayState(state);
    }

    // ── Gunplay ───────────────────────────────────────────────────────────────
    // These clips (Pistol_Shoot / Pistol_Reload / the Pistol_Aim_* trio) ship in
    // UAL1 and were sitting unused. Combat-lock durations are deliberately short:
    // the gun's own fire rate governs pacing, the pose just needs to read.
    const float ShootLockDur = 0.18f;

    float _upperReturnTimer = 0f;   // when >0, the upper layer is in a one-shot

    /// Shoot pose on the ARMS ONLY — the legs keep whatever locomotion they were
    /// doing, so an opponent sprinting at you while firing reads as exactly that.
    public void PlayShoot() => PlayUpper(Prefix + "Shoot", ShootLockDur);

    /// dur should be the gun's real reload duration so the pose lasts exactly as
    /// long as the mechanic does — the reload window is the opening to push, and
    /// it has to be legible from across the arena.
    public void PlayReload(float dur = 1.4f) => PlayUpper(Prefix + "Reload", dur);

    void PlayUpper(string node, float dur)
    {
        // Mirror onto the first-person arms first — they run a plain
        // AnimationPlayer with no AnimationTree, so they need the clip by name
        // rather than a state-machine Travel. Done before the early-out so the
        // viewmodel still reacts even if the body's upper layer is unavailable.
        if (_fpAp != null)
        {
            string clip = _resolvedClipPrefix + (node.EndsWith("Reload") ? "_reload" : "_shoot");
            if (_fpAp.HasAnimation(clip)) _fpAp.Play(clip);
        }

        if (!_hasUpperLayer || _upperPlayback == null || !_validUpperNodes.Contains(node))
            return;
        _upperPlayback.Travel(node);
        _upperReturnTimer = dur;
    }

    /// Vertical aim blend, driven by camera pitch in radians. Feeds the
    /// BlendSpace1D of the RESOLVED family's Aim node (AimNode, via
    /// ResolveFamily) — built from that family's Aim_Down / _Neutral / _Up
    /// clips — so the character visibly tracks its target with the barrel
    /// instead of always aiming flat. This is the main cue for "where is that
    /// player actually looking".
    public void SetAimPitch(float pitchRadians)
    {
        if (_animTree == null || !_hasUpperLayer) return;
        // ±60° maps to the full -1..1 blend range.
        float t = Mathf.Clamp(pitchRadians / (60f * Mathf.Pi / 180f), -1f, 1f);
        _animTree.Set($"parameters/UpperSM/{AimNode}/blend_position", t);
    }

    // How long to let the block animation play before freezing at the guard pose.
    // Tune this to match the rise portion of the Sword_Block clip.
    const float BlockRiseDur = 0.25f;
    bool _blockHeld = false;

    public void PlayBlock(bool blocking)
    {
        if (blocking)
        {
            if (_blockHeld) return;
            _blockHeld       = true;
            _state           = AnimState.Block;
            _combatLock      = true;
            _combatLockTimer = float.MaxValue;

            // Bypass AnimationTree so we can freeze the AnimationPlayer at the peak frame.
            // AnimationTree overrides _ap every frame, so Stop() only works with the tree off.
            if (_animTree != null) _animTree.Active = false;
            _ap?.Play("block");
            _fpAp?.Play("block");

            // After the raise completes, freeze at the guard pose using SpeedScale=0.
            // More reliable than Stop(false) for holding a mid-animation pose.
            GetTree().CreateTimer(BlockRiseDur).Timeout += () =>
            {
                if (!_blockHeld) return;   // released before timer fired
                if (_ap   != null) _ap.SpeedScale   = 0f;
                if (_fpAp != null) _fpAp.SpeedScale = 0f;
            };
        }
        else
        {
            _blockHeld       = false;
            _combatLock      = false;
            _combatLockTimer = 0f;
            if (_ap   != null) _ap.SpeedScale   = 1f;   // restore before re-enabling tree
            if (_fpAp != null) _fpAp.SpeedScale = 1f;
            if (_animTree != null && !_dying) _animTree.Active = true;
        }
    }


    public void PlayHurt()
    {
        if (_ap == null || !_ap.HasAnimation("hit")) return;
        if (_animTree != null) _animTree.Active = false;
        _ap.SpeedScale = 1f;
        _ap.Play("hit");
        float dur = Mathf.Max((float)_ap.CurrentAnimationLength, 0.15f);
        GetTree().CreateTimer(dur).Timeout += () =>
        {
            if (IsInstanceValid(this) && _animTree != null && !_dying)
                _animTree.Active = true;
        };
    }

    public void PlayAerialLunge()
    {
        _state           = AnimState.AerialLunge;
        _combatLock      = true;
        _combatLockTimer = 2.0f;

        if (_ap == null || !_ap.HasAnimation("air_slash")) return;

        // Bypass AnimationTree for precise timing control (same pattern as PlayBlock).
        if (_animTree != null) _animTree.Active = false;
        _ap.SpeedScale = 1f;
        _ap.Play("air_slash");

        // Freeze at the forward-slash peak (~40% through) before the return phase begins.
        float cutTime = (_ap.GetAnimation("air_slash")?.Length ?? 0.7f) * 0.40f;
        GetTree().CreateTimer(cutTime).Timeout += () =>
        {
            if (_state == AnimState.AerialLunge && _ap != null)
                _ap.SpeedScale = 0f;
        };
    }

    public void PlayDeath()
    {
        _dying = true;
        if (_animTree != null) _animTree.Active = false;
        if (_ap != null && _ap.HasAnimation("death"))
            _ap.Play("death");
    }
}
