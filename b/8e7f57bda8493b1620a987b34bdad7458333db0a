using System.Collections.Generic;
using Godot;

/// res://test/TestTask.cs — per-task harness (overwritten each task).
/// ─────────────────────────────────────────────────────────────────────────────
/// Visual repro/verification for "stair parallel to a large room: wallpaper
/// bleeds into the stairwell" (see test/TestRoomStairBleed.cs for the geometry-
/// level proof). Same maze: Room at (4,5), StairsUp at (5,5) rot 0 — the room's
/// east wall and the stair's west envelope wall share the exact same plane
/// (x=50). Camera sits inside the stairwell looking at that shared wall.
/// ─────────────────────────────────────────────────────────────────────────────
public partial class TestTask : Node3D
{
    Camera3D _cam = null!;
    int _frame = 0;
    const float CS = DungeonBuilder.CellSize;

    public override void _Ready()
    {
        var worldEnv = new WorldEnvironment();
        worldEnv.Environment = new Godot.Environment
        {
            BackgroundMode     = Godot.Environment.BGMode.Color,
            BackgroundColor    = new Color(0f, 0f, 0f),
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor  = new Color(0.30f, 0.26f, 0.22f),
            AmbientLightEnergy = 0.9f,
            TonemapMode        = Godot.Environment.ToneMapper.Filmic,
            TonemapExposure    = 1.3f,
        };
        AddChild(worldEnv);

        AddChild(new DirectionalLight3D
        {
            Name        = "TestSun",
            LightColor  = new Color(1f, 0.95f, 0.85f),
            LightEnergy = 1.4f,
            Rotation    = new Vector3(-0.7f, 0.5f, 0f),
        });
        // Extra local light aimed at the shared wall so the z-fighting quads
        // (or their absence, post-fix) are unambiguous, not lost in shadow.
        AddChild(new OmniLight3D
        {
            Position    = new Vector3(56f, 5f, 55f),
            LightColor  = new Color(1f, 0.95f, 0.85f),
            LightEnergy = 10f, OmniRange = 20f, OmniAttenuation = 0.7f,
        });

        var pieces = new List<MazePiece>
        {
            new() { Type = PieceType.Room,     X = 4, Y = 5, Floor = 0 },
            new() { Type = PieceType.StairsUp, X = 5, Y = 5, Floor = 0, Rotation = 0 },
            // A couple of neighbours so the stair/room aren't floating orphans —
            // not required for the bug, just a more legible scene.
            new() { Type = PieceType.Start,    X = 4, Y = 4 },
        };
        var dungeon = new DungeonBuilder();
        AddChild(dungeon);
        dungeon.Build(new MazeData { Name = "RoomStairBleedCapture", Pieces = pieces });

        _cam = new Camera3D { Fov = 75f, Current = true, Far = 200f };
        AddChild(_cam);
        // Inside the ROOM (not the stairwell — the stair's own decorative
        // shoulder wall at x=52 sits right in front of a camera placed inside
        // the walkway and blocks the view of x=50 entirely), looking east
        // (+X) at the shared boundary wall x=50 — the room's east wall /
        // stair's west envelope wall, exactly coincident (the bug). The
        // envelope wall is double-sided (GetStoneMatDoubleSided, cull_disabled)
        // so it's visible from this side too.
        _cam.Position = new Vector3(48.5f, 2f, 51f);
        _cam.Rotation = new Vector3(0f, Mathf.DegToRad(180f), 0f);
    }

    public override void _Process(double delta)
    {
        if (++_frame >= 20) GetTree().Quit();
    }
}
