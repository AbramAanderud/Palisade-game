using System.Collections.Generic;
using Godot;

/// Integration check for the shooting gate's GUN wiring. The headless TestTraps gate
/// section proves the gate's own logic by calling target.OnShot directly; this proves
/// the part TestTraps cannot see — that a real GunCombat hitscan shot actually reaches
/// a target (correct collision, target sitting in front of the wall) and that
/// FireHitscan forwards the hit through IShootable.OnShot. Three real shots that land
/// must remove the wall.
///
/// Run: --headless --fixed-fps 60 --quit-after 20000
public partial class TestGateShoot : Node3D
{
    int _failures = 0;
    void Check(bool c, string label)
    { if (c) GD.Print($"PASS  {label}"); else { GD.Print($"FAIL  {label}"); _failures++; } }

    GunCombat        _gun  = null!;
    ShootingGateNode _gate = null!;
    StaticBody3D?    _wall;
    readonly List<ShootableTargetNode> _targets = new();
    Vector3 _origin;
    int  _k    = 0;    // target currently being shot at
    int  _warm = 0;
    int  _frames = 0;
    bool _done = false;

    public override void _Ready()
    {
        // A wide floor, mirroring TestDamageProfile, so nothing odd happens if a ray
        // ever drops low.
        var floor = new StaticBody3D();
        floor.AddChild(new CollisionShape3D { Shape = new BoxShape3D { Size = new Vector3(200f, 1f, 200f) } });
        AddChild(floor);
        floor.Position = new Vector3(0f, -3f, 0f);

        // Build a real gate through the same call the dungeon uses.
        var owner = new DungeonBuilder();
        AddChild(owner);
        var body = new StaticBody3D(); AddChild(body);
        var piece = new MazePiece { Type = PieceType.TrapGate, X = 2, Y = 2, Floor = 0, Rotation = 0 };
        TrapBehaviours.Decorate(owner, body, piece, 0f, new Dictionary<(int, int, int), MazePiece>());

        foreach (var c in owner.GetChildren()) if (c is ShootingGateNode g) _gate = g;
        _wall = _gate.Wall;
        foreach (var c in _gate.GetChildren()) if (c is ShootableTargetNode t) _targets.Add(t);

        var shooter = new StaticBody3D { Name = "Shooter" };   // no shape → never blocks its own ray
        AddChild(shooter);
        _gun = new GunCombat { CombatTeam = 0 };
        shooter.AddChild(_gun);
        _gun.Equip("ak47");

        // Stand close (3.5 m) and level with the targets: at this range even a wide
        // spread cone lands on a 1.3 m target, so the check tests the WIRING, not the
        // gun's accuracy tuning.
        _origin = _targets[1].GlobalPosition + new Vector3(0f, 0f, 3.5f);
    }

    public override void _PhysicsProcess(double delta)
    {
        if (_done) return;
        if (_warm < 3) { _warm++; return; }   // let the gate bodies enter the physics space

        if (_k >= _targets.Count)
        {
            Check(_gate.DebugOpened,                       "gate opens after three real shots land");
            Check(_wall != null && !_wall.Visible,         "opened gate: wall removed");
            Finish();
            return;
        }

        // Safety valve: if a target can't be hit within a generous budget, fail loudly
        // rather than hang the suite (e.g. a future change that breaks the hook).
        if (++_frames > 900)
        {
            Check(false, $"all three targets shot within budget (stuck on target {_k})");
            Finish();
            return;
        }

        var target = _targets[_k];
        var dir = (target.GlobalPosition - _origin).Normalized();
        _gun.RequestAttack();
        _gun.Tick((float)delta, _origin, dir, 0f, false);

        if (target.DebugShot)
        {
            Check(true, $"target {_k} shot by a real GunCombat hitscan ray");
            _k++;
        }
    }

    void Finish()
    {
        _done = true;
        GD.Print(_failures == 0 ? "RESULT OK" : $"RESULT {_failures} FAILURE(S)");
        GetTree().Quit(_failures == 0 ? 0 : 1);
    }
}
