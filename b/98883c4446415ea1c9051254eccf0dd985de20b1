using System.Collections.Generic;
using System.Linq;
using Godot;

/// test/FfaLocalArena.cs — Phase 1 dev scene: the FFA plus layout with NO
/// networking. Arena at the origin, one rotated maze per door, per-match
/// hallways, n−1 pickups on the altar, optional player. Used by TestFfaCapture
/// for overhead screenshots and the light/perf census.
public partial class FfaLocalArena : Node3D
{
    public static string Fixture = "worst";
    public static int[]? Slots;
    public static int SpawnSeat = -1;
    public static bool WithPlayer = true;

    public FfaWorld World = null!;
    public PlusLayoutResult Layout = null!;
    public DungeonBuilder[] Mazes = System.Array.Empty<DungeonBuilder>();
    public Vector3 Origin = Vector3.Zero;
    Label? _zone;
    PlayerController? _player;
    float _zoneTimer;

    static void ReadArgs()
    {
        foreach (var a in OS.GetCmdlineUserArgs())
        {
            var kv = a.Split('=', 2);
            if (kv[0] != "noplayer" && kv.Length < 2) { GD.PushWarning($"[FFA] arg '{a}' needs key=value; skipped"); continue; }
            switch (kv[0])
            {
                case "fixture": Fixture = kv[1]; break;
                case "slots":   Slots = kv[1].Split(',').Select(int.Parse).ToArray(); Fixture = "slots"; break;
                case "spawn":   SpawnSeat = kv[1] == "arena" ? -1 : int.Parse(kv[1]); break;
                case "noplayer": WithPlayer = false; break;
            }
        }
    }

    public static List<MazeData> LoadMazes(string fixture, int[]? slots)
    {
        MazeData S(int c, int ef = 0, int sf = 0) => FfaFixtures.Slab(c, ef, sf);
        switch (fixture)
        {
            case "central": return new() { S(4), S(5), S(4), S(5) };
            case "mixed":   return new() { S(0), S(4), S(9), S(5) };
            case "t3":      return new() { S(0), S(9), S(9) };
            case "vsep":    return new() { S(0), S(9, 0, 2), S(0), S(9, 0, 2) };
            case "tall":    return new() { FfaFixtures.Tall(0), FfaFixtures.Tall(9), FfaFixtures.Tall(0), FfaFixtures.Tall(9) };
            case "slots":
                return slots!.Select(s => (slot: s, m: MazeSerializer.Load(s)))
                    .Where(t =>
                    {
                        bool ok = t.m != null && t.m.Pieces.Count > 0;
                        if (!ok) GD.PushWarning($"[FFA] slot {t.slot} is empty or missing; skipped");
                        return ok;
                    }).Select(t => t.m!).ToList();
            case "heaviest":
                return Enumerable.Range(0, 10).Where(MazeSerializer.Exists)
                    .Select(s => MazeSerializer.Load(s)).Where(m => m != null && m.Pieces.Count > 0)
                    .OrderByDescending(m => m!.Pieces.Count).Take(4).Select(m => m!).ToList();
            default:        return new() { S(0), S(9), S(0), S(9) };
        }
    }

    public override void _Ready()
    {
        ReadArgs();
        var mazes = LoadMazes(Fixture, Slots);
        if (mazes.Count < 3) { GD.PushError($"[FFA] need 3–4 mazes, got {mazes.Count}"); return; }
        if (mazes.Count > 4) { GD.PushError($"[FFA] at most 4 mazes supported, got {mazes.Count}"); return; }

        var worldEnv = new WorldEnvironment();
        var env = new Godot.Environment
        {
            BackgroundMode = Godot.Environment.BGMode.Color, BackgroundColor = Colors.Black,
            AmbientLightSource = Godot.Environment.AmbientSource.Color,
            AmbientLightColor = new Color(0.10f, 0.07f, 0.04f), AmbientLightEnergy = 0.25f,
            TonemapMode = Godot.Environment.ToneMapper.Filmic, TonemapExposure = 1.3f,
        };
        worldEnv.Environment = env;
        AddChild(worldEnv);

        var bySeat = new Dictionary<int, MazeData>();
        for (int i = 0; i < mazes.Count; i++) bySeat[i] = mazes[i];
        World = FfaWorld.Build(this, Origin, bySeat, 0);
        Layout = World.Layout;
        Mazes = Enumerable.Range(0, mazes.Count).Select(World.MazeBuilder).ToArray();
        foreach (var p in World.Pickups) { var pk = p; pk.ClaimAttempted += () => pk.ConfirmPickup(); }

        GD.Print($"[FFA] fixture={Fixture} seats={mazes.Count} hall={Layout.HallCells} cells ({Layout.HallLength} m) " +
                 string.Join(" ", Layout.Seats.Select((s, i) =>
                     $"{s.Door}:'{mazes[i].Name}' exit=({s.Rotated.ExitX},{s.Rotated.ExitY}) f{s.Rotated.ExitFloor}")));

        if (!WithPlayer) return;
        Vector3 pos = Origin + new Vector3(0f, 1f, AltarBuilder.BaseRadius + 3f);
        float yaw = 0f;
        if (SpawnSeat >= 0 && SpawnSeat < mazes.Count)
        {
            int ms = World.MazeSeatRunBy(SpawnSeat);
            pos = World.StartPosition(ms);
            yaw = World.StartYaw(ms);
        }
        _player = PlayerController.Spawn(this, pos, yaw);
        _player.EquipStarterGun(GunCombat.RollStarter((int)(GD.Randi() % (uint)GunCombat.StarterPool.Length)));
        var hud = new CanvasLayer();
        AddChild(hud);
        _zone = new Label { Position = new Vector2(16, 16) };
        hud.AddChild(_zone);
    }

    public override void _Process(double delta)
    {
        if (_player == null || _zone == null) return;
        _zoneTimer -= (float)delta;
        if (_zoneTimer > 0f) return;
        _zoneTimer = 0.2f;
        int seat = Layout.MazeAt(_player.GlobalPosition - Origin);
        _zone.Text = seat < 0 ? "Zone: arena" : $"Zone: {Layout.Seats[seat].Door} maze/hall";
    }
}
