using Godot;
using System.Diagnostics;

/// Prop load benchmark — the measurement behind the "GLB load hitch" ticket.
///
/// The 14-prop manor set shipped straight out of Tripo3D at ~1.4M triangles
/// EACH (626 MB of .glb, 95% of it vertex data), which is what made a cold
/// dungeon build stall for seconds and blew `.godot/imported` up past 2 GB.
/// Blender collapse-decimation cut them to game budgets; this harness is the
/// permanent A/B that proves it and catches a regression if raw Tripo output
/// is ever dropped in again.
///
/// Two paths are timed separately because they cost differently:
///   RAW    — GltfDocument.AppendFromFile, i.e. parse the .glb off disk with no
///            import cache. This is the honest apples-to-apples comparison
///            between the two asset sets, and it is also PropLibrary's real
///            fallback path for un-imported files during headless captures.
///   IMPORT — GD.Load<PackedScene>, the actual shipping path once Godot has
///            imported the .glb. Only meaningful for the live props/ dir.
///
/// The hi-res set lives in assets/glb/props_hires/ (kept out of git — the
/// originals cost Tripo credits and are not regenerable for free). If that
/// directory is absent the harness still runs and simply reports the
/// decimated numbers alone.
public partial class TestPropLoad : Node3D
{
    static readonly string[] Props =
    {
        "balustrade_a", "bookrow_a", "bookrow_b", "bookrow_c",
        "candelabra_a", "candelabra_b", "clutter_bookstack", "clutter_goblet",
        "clutter_pot", "column_a", "plant_a", "plant_b",
        "table_a", "torch_a", "torch_b",
    };

    // Per-prop triangle ceiling. A prop over its budget means raw (or
    // under-decimated) Tripo output slipped back into assets/glb/props.
    static readonly System.Collections.Generic.Dictionary<string, int> Budget = new()
    {
        { "clutter_bookstack", 1500 }, { "clutter_goblet", 1500 }, { "clutter_pot", 1500 },
        { "torch_a", 3000 }, { "torch_b", 3000 },
        { "candelabra_a", 3000 }, { "candelabra_b", 3000 },
        { "plant_a", 4000 }, { "plant_b", 4000 },
        { "bookrow_a", 3000 }, { "bookrow_b", 3000 }, { "bookrow_c", 3000 },
        { "table_a", 4000 }, { "balustrade_a", 3000 }, { "column_a", 6000 },
    };

    // Per-prop texture ceiling (largest dimension of any map on the prop).
    // Tripo3D ships every prop with three 4096x4096 maps (Color/NormalGL/ORM) --
    // ~369MB of texture cache for 46k triangles, and the dominant cost of a cold
    // prop load once geometry was decimated. These are the sizes the props are
    // actually viewed at: clutter sits on a table, most props read at corridor
    // distance, column_a is 14m tall and the player runs right past it.
    static readonly System.Collections.Generic.Dictionary<string, int> TexBudget = new()
    {
        { "clutter_bookstack", 512 }, { "clutter_goblet", 512 }, { "clutter_pot", 512 },
        { "torch_a", 1024 }, { "torch_b", 1024 },
        { "candelabra_a", 1024 }, { "candelabra_b", 1024 },
        { "plant_a", 1024 }, { "plant_b", 1024 },
        { "bookrow_a", 1024 }, { "bookrow_b", 1024 }, { "bookrow_c", 1024 },
        { "table_a", 1024 }, { "balustrade_a", 1024 }, { "column_a", 2048 },
    };

    // 10% headroom over the Blender budget: the collapse decimator lands a few
    // triangles under target, and a re-export with slightly different settings
    // shouldn't fail the gate. Raw Tripo output overshoots by ~250x, so this
    // tolerance never risks masking the actual regression.
    const float BudgetTolerance = 1.10f;

    public override void _Ready()
    {
        GD.Print("=== PROP LOAD BENCHMARK ===");

        var hires = BenchRaw("res://assets/glb/props_hires", "HI-RES (raw Tripo3D)");
        var lores = BenchRaw("res://assets/glb/props", "DECIMATED (shipping)");
        BenchImported();

        if (hires.count > 0 && lores.count > 0)
        {
            GD.Print("\n--- A/B ---");
            GD.Print($"  load   {hires.ms:F0} ms -> {lores.ms:F0} ms   "
                     + $"({hires.ms / Mathf.Max(lores.ms, 0.001):F1}x faster)");
            GD.Print($"  tris   {hires.tris:N0} -> {lores.tris:N0}   "
                     + $"({(float)hires.tris / Mathf.Max(lores.tris, 1):F0}x fewer)");
            GD.Print($"  bytes  {hires.bytes / 1048576.0:F1} MB -> {lores.bytes / 1048576.0:F1} MB   "
                     + $"({(float)hires.bytes / Mathf.Max(lores.bytes, 1):F0}x smaller)");
        }

        bool pass = true;
        foreach (var n in Props)
        {
            if (!_tris.TryGetValue(n, out int t)) continue;
            int cap = Mathf.RoundToInt(Budget[n] * BudgetTolerance);
            if (t > cap) { GD.Print($"  OVER BUDGET: {n} = {t:N0} tris (cap {cap:N0})"); pass = false; }
        }
        foreach (var n in Props)
        {
            if (!_tex.TryGetValue(n, out int px) || px == 0) continue;
            if (px > TexBudget[n]) { GD.Print($"  OVER BUDGET: {n} = {px}px tex (cap {TexBudget[n]}px)"); pass = false; }
        }
        GD.Print($"\nPASS={pass && lores.count == Props.Length}"
                 + $" (loaded {lores.count}/{Props.Length} props within budget)");

        GetTree().Quit();
    }

    readonly System.Collections.Generic.Dictionary<string, int> _tris = new();
    readonly System.Collections.Generic.Dictionary<string, int> _tex = new();

    (double ms, long tris, long bytes, int count) BenchRaw(string dir, string label)
    {
        var absDir = ProjectSettings.GlobalizePath(dir);
        if (!System.IO.Directory.Exists(absDir))
        {
            GD.Print($"\n--- {label} --- (absent, skipped)");
            return (0, 0, 0, 0);
        }

        GD.Print($"\n--- {label} ---");
        double total = 0; long tris = 0, bytes = 0; int n = 0;

        foreach (var name in Props)
        {
            var abs = System.IO.Path.Combine(absDir, name + ".glb");
            if (!System.IO.File.Exists(abs)) continue;

            var sw = Stopwatch.StartNew();
            var doc = new GltfDocument();
            var state = new GltfState();
            if (doc.AppendFromFile(abs, state) != Error.Ok) { GD.Print($"  {name}: LOAD FAILED"); continue; }
            var node = doc.GenerateScene(state);
            sw.Stop();

            long t = CountTris(node);
            int tex = MaxTexDim(node);
            long b = new System.IO.FileInfo(abs).Length;
            node.QueueFree();

            total += sw.Elapsed.TotalMilliseconds; tris += t; bytes += b; n++;
            // record only the shipping set for the budget gate
            if (dir.EndsWith("/props")) { _tris[name] = (int)t; _tex[name] = tex; }
            GD.Print($"  {name,-20} {sw.Elapsed.TotalMilliseconds,8:F0} ms  {t,10:N0} tris  "
                     + $"{tex,5}px  {b / 1048576.0,7:F2} MB");
        }

        GD.Print($"  {"TOTAL",-20} {total,8:F0} ms  {tris,10:N0} tris  {bytes / 1048576.0,7:F2} MB");
        return (total, tris, bytes, n);
    }

    void BenchImported()
    {
        GD.Print("\n--- DECIMATED via Godot import cache (shipping path) ---");
        var sw = Stopwatch.StartNew();
        int n = 0;
        foreach (var name in Props)
        {
            var path = $"res://assets/glb/props/{name}.glb";
            if (!ResourceLoader.Exists(path)) continue;
            var scene = GD.Load<PackedScene>(path);
            if (scene == null) continue;
            var inst = scene.Instantiate<Node3D>();
            inst.QueueFree();
            n++;
        }
        sw.Stop();
        GD.Print($"  {n} props in {sw.Elapsed.TotalMilliseconds:F0} ms");
    }

    /// Largest dimension of any texture bound to any surface material on the
    /// prop. Walks every BaseMaterial3D texture slot rather than just albedo --
    /// the normal and ORM maps ship at the same size and cost the same VRAM.
    static int MaxTexDim(Node root)
    {
        int max = 0;
        if (root is MeshInstance3D mi && mi.Mesh != null)
        {
            for (int s = 0; s < mi.Mesh.GetSurfaceCount(); s++)
            {
                if (mi.Mesh.SurfaceGetMaterial(s) is not BaseMaterial3D m) continue;
                foreach (BaseMaterial3D.TextureParam tp
                         in System.Enum.GetValues<BaseMaterial3D.TextureParam>())
                {
                    // TextureParam.Max is a count sentinel, not a real slot --
                    // passing it to GetTexture logs an out-of-bounds error.
                    if (tp == BaseMaterial3D.TextureParam.Max) continue;
                    var t = m.GetTexture(tp);
                    if (t != null) max = Mathf.Max(max, Mathf.Max(t.GetWidth(), t.GetHeight()));
                }
            }
        }
        foreach (var c in root.GetChildren()) max = Mathf.Max(max, MaxTexDim(c));
        return max;
    }

    static long CountTris(Node root)
    {
        long t = 0;
        if (root is MeshInstance3D mi && mi.Mesh != null)
            t += mi.Mesh.GetFaces().Length / 3;
        foreach (var c in root.GetChildren()) t += CountTris(c);
        return t;
    }
}
