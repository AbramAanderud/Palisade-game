    // ── Geometry ──────────────────────────────────────────────────────────────

    void BuildEnvironment()
    {
        var worldEnv = new WorldEnvironment();
        var env      = new Godot.Environment();
        env.BackgroundMode     = Godot.Environment.BGMode.Color;
        env.BackgroundColor    = new Color(0f, 0f, 0f);
        env.AmbientLightSource = Godot.Environment.AmbientSource.Color;
        env.AmbientLightColor  = new Color(0.10f, 0.07f, 0.04f);
        env.AmbientLightEnergy = 0.25f;
        env.TonemapMode        = Godot.Environment.ToneMapper.Filmic;
        env.TonemapExposure    = 1.3f;
        // Experimental fog + glow + grade — gated behind VisualFlair.Enabled.
        VisualFlair.ApplyEnvironment(env);
        worldEnv.Environment   = env;
        AddChild(worldEnv);
    }

    void BuildArena(MazeData dataA, MazeData dataFlipped)
    {
        var exitA = dataA.Pieces.FirstOrDefault(p => p.Type == PieceType.Exit);
        var exitB = dataFlipped.Pieces.FirstOrDefault(p => p.Type == PieceType.Exit);

        _exitAX = exitA != null ? exitA.X * CellSize + CellSize * 0.5f : MazeDepth * 0.5f;
        float exitBX = exitB != null ? exitB.X * CellSize + CellSize * 0.5f : _exitAX;
        _offsetBX = _exitAX - exitBX;
        _offsetAY = exitA != null ? -exitA.Floor * DungeonBuilder.FloorHeight : 0f;
        _offsetBY = exitB != null ? -exitB.Floor * DungeonBuilder.FloorHeight : 0f;

        var builderA = new DungeonBuilder { Name = "MazeA" };
        AddChild(builderA);
        builderA.Build(dataA, new Vector3(0f, _offsetAY, 0f), Dir.S);

        var builderB = new DungeonBuilder { Name = "MazeB" };
        AddChild(builderB);
        builderB.Build(dataFlipped, new Vector3(_offsetBX, _offsetBY, MazeBOffset), Dir.N);

        var torchA = new TorchSignalSystem { Name = "TorchSignalA" };
        AddChild(torchA);
        torchA.Init(dataA, builderA);

        var torchB = new TorchSignalSystem { Name = "TorchSignalB" };
        AddChild(torchB);
        torchB.Init(dataFlipped, builderB);

        // Soft-light toast: at TriggerDelay seconds the path starts revealing.
        // Local player navigates opponent's maze:
        //   • Host plays in MazeB (client's design, flipped) → listen on torchB
        //   • Client plays in MazeA (host's design)          → listen on torchA
        var localTorch = OnlineGameState.IsHost ? torchB : torchA;
        localTorch.FirstCellLit += OnSoftLightTriggered;

        var arenaCentre = new Vector3(_exitAX, 0f, ArenaCentreZ);
        var arena = new ArenaBuilder { Name = "Arena", GrassInnerRadius = AltarBuilder.BaseRadius };
        AddChild(arena);
        arena.Build(arenaCentre, openNorth: true, openSouth: true);

        var altar = new AltarBuilder { Name = "Altar" };
        AddChild(altar);
        altar.Build(arenaCentre);

        _swordPickup = WeaponPickup.Spawn(this, arenaCentre + AltarBuilder.WeaponAnchor);
        _swordPickup.ClaimAttempted += OnLocalSwordClaimAttempted;

        // The host rolls both guns once and broadcasts, so the two players get
        // identical weapons — matches vary, but never lopsidedly.
        if (OnlineGameState.IsHost)
        {
            int s = (int)(GD.Randi() % (uint)GunCombat.StarterPool.Length);
            int a = (int)(GD.Randi() % (uint)GunCombat.ArenaPool.Length);
            ApplyLoadout(s, a);
            _nm.SendGameData($"{{\"t\":\"loadout\",\"start\":{s},\"arena\":{a}}}");
        }
    }

    /// Apply a rolled loadout: give the local player the starter gun and set what
    /// the arena pickup will grant. Called on the host directly and on the client
    /// from the "loadout" message.
    void ApplyLoadout(int starterIdx, int arenaIdx)
    {
        _rolledStarterIdx = starterIdx;
        _rolledArenaIdx   = arenaIdx;

        string starter = GunCombat.RollStarter(starterIdx);
        string arena   = GunCombat.RollArena(arenaIdx);

        _localPlayer?.EquipStarterGun(starter);
        // The PUPPET holds the same roll — without this the opponent's avatar
        // carries the default pistol whatever they actually shoot you with,
        // wrong model AND wrong muzzle point for their replicated tracers.
        // Plain EquipGun: stats and wallhack side-effects belong to the real
        // owner's client, not the mirror.
        _puppet?.EquipGun(starter);
        if (_swordPickup != null) _swordPickup.ArenaGunId = arena;

        GD.Print($"[ARENA] Loadout — starter '{starter}', arena prize '{arena}'");
    }

    // ── Network ───────────────────────────────────────────────────────────────

    void WireHitRelay()
    {
        // ── Outgoing: damage this player dealt to opponent's puppet ─────────────
        var puppetHealth = _puppet?.GetNodeOrNull<PlayerHealth>("PlayerHealth");
        if (puppetHealth != null)
            puppetHealth.DamageDealt += dmg =>
            {
                // Stamp the claim with where we SAW them — their own
                // last-broadcast position, not our extrapolated render — so
                // their client can check it against its recent history.
                if (_puppet != null && IsInstanceValid(_puppet))
                {
                    var seen = _puppet.PuppetLastNetPos;
                    _nm.SendGameData(
                        $"{{\"t\":\"hit\",\"dmg\":{dmg:F1}," +
                        $"\"px\":{seen.X:F2},\"py\":{seen.Y:F2},\"pz\":{seen.Z:F2}}}");
                }
                else
                    _nm.SendGameData($"{{\"t\":\"hit\",\"dmg\":{dmg:F1}}}");
            };

        // ── Outgoing: every shot. Purely cosmetic — damage already travels on
        // the {"t":"hit"} relay above, so this only drives the opponent's muzzle
        // flash and shoot pose. ─────────────────────────────────────────────────
        // Every shot carries its ray endpoint so the opponent's client can draw
        // the SAME tracer / casing / rocket from their side — without it your
        // bullets exist only on your own screen.
        _localPlayer?.AddShotEndpointListener(end =>
            _nm.SendGameData($"{{\"t\":\"shot\",\"x\":{end.X:F2},\"y\":{end.Y:F2},\"z\":{end.Z:F2}}}"));

        // ── Outgoing: reload, so the opponent can SEE the window to push you ────
        _localPlayer?.AddReloadListener(() => _nm.SendGameData("{\"t\":\"reload\"}"));

        // Dry-fire click — the audible tell that they are helpless right now.
        _localPlayer?.AddDryFireListener(() => _nm.SendGameData("{\"t\":\"dryfire\"}"));

        // ── Outgoing: slot swap. After claiming the arena prize a player carries
        // BOTH guns, so the held one is no longer implied by the loadout roll —
        // the puppet must be told which gun to show. ─────────────────────────────
        if (_localPlayer != null)
            _localPlayer.WeaponSwitched += id =>
                _nm.SendGameData($"{{\"t\":\"gunsel\",\"id\":\"{id}\"}}");

        // ── Local death ─────────────────────────────────────────────────────────
        var localHealth = _localPlayer?.GetNodeOrNull<PlayerHealth>("PlayerHealth");
        if (localHealth != null)
            localHealth.OnDied += OnLocalPlayerDied;
    }

    // ── Gate destruction relay ───────────────────────────────────────────────
    // ShootingGateNode only ever destroys itself on the shooter's own client —
    // GunCombat.FireHitscan/ShootableTargetNode.OnShot is a real raycast that
    // only the LOCAL player's real weapon performs; a puppet's shots are
    // cosmetic only (TriggerPuppetShot, wired above). Without this relay the
    // opponent's screen never learns the gate came down, so the shooter can
    // fire through a gap the victim still sees as a solid wall.
    //
    // Wiring BOTH mazes uniformly (not just "whichever one is mine") is safe:
    // a puppet never fires a real hitscan, so NotifyTargetShot can only ever
    // actually run for the gate embedded in whichever maze the LOCAL real
    // player is walking through — exactly mirroring how "hit" already trusts
    // the shooter's own local resolution.
    void WireGateRelay()
    {
        // Gates are always a direct child of a maze builder ("MazeA"/"MazeB"),
        // itself always a direct child of this arena (see BuildArena) — a
        // 2-level scan, not a full tree walk. Update this alongside BuildArena
        // if that nesting ever changes.
        foreach (var side in GetChildren())
            foreach (var child in side.GetChildren())
                if (child is ShootingGateNode gate)
                    gate.Destroyed += id =>
                        _nm.SendGameData($"{{\"t\":\"gate_down\",\"id\":\"{id}\"}}");
    }

    /// Replays a remote "gate_down" locally: the same visual+collision removal
    /// a real shot causes, without re-broadcasting (RemoteOpen never raises
    /// Destroyed, so this cannot echo back across the relay). Static and
    /// root-parameterized so it needs no live NetworkManager/relay to exercise
    /// headlessly — see test/TestGateSync.cs. Returns false (never throws) for
    /// an unknown id, or a root whose mazes/gates are not built yet — either
    /// way a "gate_down" that cannot be resolved is dropped safely rather than
    /// buffered: the sender can only have shot a gate that already exists in a
    /// maze both peers built minutes earlier (see the "maze" exchange), so a
    /// receiver missing that node means a stale id, not a race worth buffering.
    internal static bool ApplyRemoteGateDown(Node root, string id)
    {
        var gate = root.GetNodeOrNull<ShootingGateNode>(id);
        if (gate == null) return false;
        gate.RemoteOpen();
        return true;
    }

    void BroadcastPosition()
    {
        if (_localPlayer == null || !_nm.IsOpen) return;
        var pos = _localPlayer.GlobalPosition;
        var vel = _localPlayer.Velocity;
        int  anim = _localPlayer.CurrentAnimStateIndex;
        _nm.SendGameData(
            $"{{\"t\":\"pos\",\"x\":{pos.X:F3},\"y\":{pos.Y:F3},\"z\":{pos.Z:F3}," +
            $"\"vx\":{vel.X:F2},\"vy\":{vel.Y:F2},\"vz\":{vel.Z:F2}," +
            $"\"yaw\":{_localPlayer.Yaw:F4},\"pitch\":{_localPlayer.Pitch:F4}," +
            $"\"stam\":{_localPlayer.PlayerStamina:F1}," +
            $"\"ex\":{(_localPlayer.IsExhausted ? 1 : 0)}," +
            // Sprint-carry and ADS ride the pos stream: both are pose truths the
            // opponent must read at a glance (lowered gun = can't fire; scoped
            // AWP = do not peek). Two bytes, 30 Hz, optional-parse on receive.
            $"\"spr\":{(_localPlayer.IsSprintCarrying ? 1 : 0)}," +
            $"\"aim\":{(_localPlayer.IsAimingNow ? 1 : 0)}," +
            $"\"as\":{anim}}}");
    }

    void OnGameData(string json)
    {
        JsonElement root;
        try
        {
            using var doc = JsonDocument.Parse(json);
            root = doc.RootElement.Clone();
        }
        catch { return; }

        if (!root.TryGetProperty("t", out var tProp)) return;

        switch (tProp.GetString())
        {
            case "maze":
                if (_opponentMaze != null) break;   // already have it
                try
                {
                    string mazeJson = root.GetProperty("json").GetString()!;
                    var data = JsonSerializer.Deserialize<MazeData>(mazeJson)!;
                    // The opponent's maze arrives as raw JSON and never touches
                    // MazeSerializer, so it needs the same normalisation — and
                    // it is deterministic, so both peers reach the same result.
                    int fixedPads = data.NormalizeTeleporters();
                    if (fixedPads > 0)
                        GD.Print($"[ARENA] opponent maze: re-paired {fixedPads} teleport pad(s)");
                    _opponentMaze = data;
                    GD.Print($"[ARENA] Received opponent's maze ({mazeJson.Length} chars).");
                    TryBuildArenaAndSpawn();
                }
                catch (Exception ex)
                {
                    GD.PushError($"[ARENA] Bad opponent maze JSON — {ex.Message}");
                }
                break;

            case "pos":
                if (_puppet != null)
                {
                    Vector3 ppos = new(
                        root.GetProperty("x").GetSingle(),
                        root.GetProperty("y").GetSingle(),
                        root.GetProperty("z").GetSingle());
                    Vector3 pvel = Vector3.Zero;
                    if (root.TryGetProperty("vx", out var vx))
                        pvel = new Vector3(
                            vx.GetSingle(),
                            root.GetProperty("vy").GetSingle(),
                            root.GetProperty("vz").GetSingle());
                    _puppet.SetPuppetTarget(
                        ppos, pvel,
                        root.GetProperty("yaw").GetSingle(),
                        root.GetProperty("pitch").GetSingle());
                    if (root.TryGetProperty("stam", out var sp))
                        _puppet.PuppetStamina = sp.GetSingle();
                    if (root.TryGetProperty("ex", out var exProp))
                        _puppet.PuppetExhausted = exProp.GetInt32() == 1;
                    if (root.TryGetProperty("spr", out var sprProp))
                        _puppet.SetPuppetSprinting(sprProp.GetInt32() == 1);
                    if (root.TryGetProperty("aim", out var aimProp))
                        _puppet.SetPuppetAiming(aimProp.GetInt32() == 1);
                    // Mirror the opponent's locomotion / combat anim so they aren't T-posed.
                    if (root.TryGetProperty("as", out var asProp))
                    {
                        float horizSpeed = new Vector2(pvel.X, pvel.Z).Length();
                        _puppet.ApplyPuppetAnimState(asProp.GetInt32(), horizSpeed);
                    }
                }
                break;

            case "hit":
                // Phase gate as well as PlayerHealth.Invulnerable: this stops
                // a stray pre-claim packet painting a phantom damage number.
                if (_localPlayer != null && !MatchOver && !_localPlayerDead)
                {
                    // There is no block against a bullet — the shooter's client
                    // already resolved the hit, so normally we just take it.
                    float incomingDmg = root.GetProperty("dmg").GetSingle();

                    // Victim-side staleness bound: the claim names where the
                    // shooter saw us (a position we ourselves broadcast). If we
                    // were never near that spot in the last ~300 ms, the shot
                    // was aimed at a ghost — lag spike or worse — reject it.
                    // Claims without a position (older builds) pass unchecked.
                    if (root.TryGetProperty("px", out var cx) &&
                        root.TryGetProperty("py", out var cy) &&
                        root.TryGetProperty("pz", out var cz))
                    {
                        var claimed = new Vector3(cx.GetSingle(), cy.GetSingle(), cz.GetSingle());
                        if (!_localPlayer.WasRecentlyNear(claimed))
                        {
                            GD.Print($"[ARENA] Rejected stale hit claim: {incomingDmg:F0} dmg " +
                                     $"@ {claimed} vs us @ {_localPlayer.GlobalPosition}");
                            break;
                        }
                    }

                    var hp = _localPlayer.GetNodeOrNull<PlayerHealth>("PlayerHealth");
                    hp?.TakeDamage(incomingDmg, Vector3.Zero);
                    SpawnIncomingDmgLabel(incomingDmg,
                        _localPlayer.GlobalPosition + Vector3.Up * 1.8f);
                }
                break;

            case "gate_down":
                // Match-scope guard mirrors "hit"/"die" — once the match is
                // Over, further world mutation is pointless. ApplyRemoteGateDown
                // itself never throws on an unknown/premature id.
                if (!MatchOver &&
                    root.TryGetProperty("id", out var gateId) &&
                    gateId.GetString() is string gid)
                    ApplyRemoteGateDown(this, gid);
                break;

            case "ready_for_maze":
                if (_ownMazePayload != null)
                {
                    GD.Print("[ARENA] Re-sending own maze on opponent's request.");
                    _nm.SendGameData(_ownMazePayload);
                }
                break;

            case "sword_claim":
                // Only the host arbitrates. If the sword is still up for grabs, give it to the client.
                if (OnlineGameState.IsHost && _phase == MatchPhase.Race)
                {
                    AwardSwordToOpponent();
                    _nm.SendGameData("{\"t\":\"sword_awarded\",\"winner\":\"client\"}");
                    GD.Print("[ARENA] Host: granted sword to client (claim arrived first).");
                }
                // If host already has it, just resend the verdict so the client stops waiting.
                else if (OnlineGameState.IsHost && _phase == MatchPhase.Hunt && _localHasSword)
                {
                    _nm.SendGameData("{\"t\":\"sword_awarded\",\"winner\":\"host\"}");
                    GD.Print("[ARENA] Host: rejecting late client claim, sword already host's.");
                }
                break;

            case "sword_awarded":
            {
                if (_phase != MatchPhase.Race) break;
                string winner = root.TryGetProperty("winner", out var wp) ? wp.GetString() ?? "" : "";
                bool iWon = (winner == "host") == OnlineGameState.IsHost;
                if (iWon) AwardSwordToLocal();
                else      AwardSwordToOpponent();
                GD.Print($"[ARENA] sword_awarded winner={winner}, I won? {iWon}");
                break;
            }

            case "shot":
                // Cosmetic only — the damage, if any, arrives as its own "hit".
                // The endpoint lets us replay the exact tracer/rocket they fired.
                if (root.TryGetProperty("x", out var sx) &&
                    root.TryGetProperty("y", out var sy) &&
                    root.TryGetProperty("z", out var sz))
                    _puppet?.TriggerPuppetShot(new Vector3(
                        sx.GetSingle(), sy.GetSingle(), sz.GetSingle()));
                else
                    _puppet?.TriggerPuppetShot();
                break;

            case "reload":
                _puppet?.TriggerPuppetReload();
                break;

            case "dryfire":
                _puppet?.TriggerPuppetDryFire();
                break;

            case "gunsel":
                // Opponent swapped loadout slots — show the gun they now hold.
                // Plain EquipGun on purpose: stats/wallhack belong to their client.
                if (root.TryGetProperty("id", out var gunSel) &&
                    gunSel.GetString() is string gunSelId)
                    _puppet?.EquipGun(gunSelId);
                break;

            case "arena_ready":
                // Opponent's arena is built and their player is spawned. Safe to
                // arrive before OUR build finishes — the flag waits for it.
                _remoteArenaReady = true;
                TryStartCountdown();
                break;

            case "loadout":
                // Host rolled the guns for this match; apply the same pair locally
                // so both players get identical weapons.
                if (root.TryGetProperty("start", out var startIdx)
                 && root.TryGetProperty("arena", out var arenaIdx))
                    ApplyLoadout(startIdx.GetInt32(), arenaIdx.GetInt32());
                break;

            case "die":
                // Combat is live from GO (truce removed 2026-09-22), so a kill
                // can genuinely land in either phase.
                if (!MatchOver)
                {
                    // Their body drops on OUR screen before the overlay lands —
                    // a kill you watch happen, not a popup.
                    _puppet?.PlayPuppetDeath();
                    _matchGold += KillFame; // I killed the opponent
                    ResolveMatch("Victory", fastExit: false);
                }
                break;

            case "forfeit":
                if (!MatchOver)
                {
                    GD.Print("[ARENA] Opponent forfeited — fast-exit.");
                    ForfeitMatch(localSurrendered: false);
                }
                break;
        }
    }

    void OnPeerDisconnected()
    {
        // Death-cam race: after we die there is a 1.5 s pause before the match
        // resolves as Defeated. A winner who exits fast disconnects inside that
        // window, and without this guard the loser's screen said "Opponent
        // left." instead of showing the death. Our death always wins.
        if (_localPlayerDead) { ResolveMatch("Defeated", fastExit: false); return; }

        // Clock race: both clients run their own 40 s hunt timers, and whoever
        // expires first resolves AND drops the relay (ResolveMatch calls
        // Disconnect) — so the slower client used to see "Opponent left."
        // instead of the clock outcome. If our clock is essentially done too,
        // this disconnect IS the clock ending: resolve it as such.
        if (_phase == MatchPhase.Hunt && _combatTimer != null && _combatTimer.TimeLeft <= 3.0)
        {
            if (!_localHasSword) _matchGold += SurviveFame;
            ResolveMatch(_localHasSword ? "Failed to kill" : "Survived", fastExit: false);
            return;
        }

        // Whatever fame they earned up to this point still counts.
        ResolveMatch("Opponent left.", fastExit: false);
    }

    // ── Game-end logic ────────────────────────────────────────────────────────

    // ── Host-authoritative sword arbitration ──────────────────────────────────
    // Host:  on local claim, immediately award to self and broadcast.
    //        on receiving a client claim, award to client (or ignore if already taken).
    // Client: on local claim, send request; wait for the host's verdict before equipping.

    void OnLocalSwordClaimAttempted()
    {
        if (_phase != MatchPhase.Race || _localPlayerDead) return;

        if (OnlineGameState.IsHost)
        {
            // Host is authoritative — grant to self instantly.
            AwardSwordToLocal();
            _nm.SendGameData("{\"t\":\"sword_awarded\",\"winner\":\"host\"}");
            GD.Print("[ARENA] Host claimed sword locally → broadcast winner=host.");
        }
        else
        {
            // Client must wait for host's verdict.
            _nm.SendGameData("{\"t\":\"sword_claim\"}");
            GD.Print("[ARENA] Client sent sword_claim, awaiting host's verdict.");
        }
    }

    void AwardSwordToLocal()
    {
        if (!TryPhase(MatchPhase.Hunt)) return;   // already claimed, or match over
        _localHasSword = true;
        _matchGold    += ClaimFame;
        _swordPickup?.ConfirmPickup();
        ShowToast("Weapon claimed — kill them within 3 minutes.", 4.5, new Color(0.3f, 1f, 0.5f));
        ShowRoleBanner("HUNTER — kill them before the timer ends", new Color(1f, 0.55f, 0.25f));
        StartCombatTimer(peerHasSword: false);
        // I escaped the opponent's maze first → my own maze (the one they were stuck in)
        // gets a trap success.
        RecordMazeOutcome(wasTrapSuccess: true);
    }

    void AwardSwordToOpponent()
    {
        if (!TryPhase(MatchPhase.Hunt)) return;   // already claimed, or match over
        _localHasSword = false;
        // Their avatar on MY screen now carries the prize they just won — read
        // the id before the pickup despawns.
        if (_swordPickup != null) _puppet?.EquipGun(_swordPickup.ArenaGunId);
        _swordPickup?.DespawnSilently();
        ShowToast("You are hunted — survive 3 minutes to win.", 4.5, new Color(1f, 0.4f, 0.3f));
        ShowRoleBanner("BEING HUNTED — survive till the end of the timer", new Color(1f, 0.35f, 0.35f));
        StartCombatTimer(peerHasSword: true);
        // Opponent escaped my maze first → my maze records an escape with the time.
        RecordMazeOutcome(wasTrapSuccess: false);
    }

    void RecordMazeOutcome(bool wasTrapSuccess)
    {
        if (_matchStartMs == 0) return;                     // arena never finished building
        int slot = OnlineGameState.SelectedMazeSlot;
        if (slot < 0) return;
        double timeSec = (Time.GetTicksMsec() - _matchStartMs) / 1000.0;
        MazeSerializer.RecordMatchOutcome(slot, wasTrapSuccess, timeSec);
    }

