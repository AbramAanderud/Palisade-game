using System.Collections.Generic;
using Godot;

/// res://scripts/RoomBuilder.cs — Geometry for one open-room group.
///
/// A room is painted as many independent Room tiles but must read as ONE space,
/// so the ARCH MATH works at group granularity: walls only on the group's outer
/// boundary, and a single continuous barrel vault whose arch profile is a
/// function of position across the WHOLE group, not per cell (see AddCellVault's
/// group-bounds ArchY calls). That is what makes a multi-cell room feel like a
/// hall instead of a row of corridors. Even so, each cell gets its own
/// StaticBody3D and floor/wall/ceiling meshes — packaging one mesh per whole
/// group would reintroduce the GL light-cap "dark corners" bug (see
/// DungeonBuilder.cs's BuildFloor doc comment); splitting per cell only changes
/// how triangles are bundled, never where their vertices sit, so the vault still
/// reads as one continuous arc with no ridge at the cell seams.
///
/// The ceiling is deliberately different from the corridor treatment: corridors
/// spring at CellHeight (14 m) and rise 4 m; a room springs at RoomSpringY (11 m)
/// and rises to RoomPeakY (17.5 m), giving a 6.5 m arc over a much wider span.
public static class RoomBuilder
{
    // ── Room proportions ──────────────────────────────────────────────────────
    /// Height of the perimeter wall — also where the vault starts curving.
    public const float RoomSpringY = 11.0f;
    /// Vault apex. Kept under DungeonBuilder.FloorHeight (18 m) so a room never
    /// punches through the floor above it.
    public const float RoomPeakY   = 17.5f;
    /// Doorway opening height. Equal to RoomSpringY so a doorway is simply an
    /// absence of wall for its full height — no lintel notch to model.
    public const float RoomDoorH   = 11.0f;
    /// Stone plinth running along the inside of every perimeter wall.
    public const float RoomPlinthW = 1.0f;
    /// Plinth height. Far below any step-up threshold, so it never affects movement.
    public const float RoomPlinthH = 0.15f;

    const float CS = DungeonBuilder.CellSize;
    const float HW = DungeonBuilder.OpeningW * 0.5f;   // 3 m — half doorway width

    static readonly Dir[] Faces = { Dir.N, Dir.E, Dir.S, Dir.W };

    /// Builds one room group into `owner` as one StaticBody3D PER CELL — see the
    /// class doc comment above for why per-cell packaging is required even though
    /// the arch profile itself is computed across the whole group.
    public static void Build(DungeonBuilder owner, RoomGroup group,
                             Dictionary<(int, int, int), MazePiece> lookup)
    {
        float yBase = group.Floor * DungeonBuilder.FloorHeight;

        foreach (var (cx, cy) in group.Cells)
        {
            var floorST = DungeonBuilder.MakeST();
            var wallST  = DungeonBuilder.MakeST();
            var ceilST  = DungeonBuilder.MakeST();
            // Corridor-facing side of the arched doorway heads. A separate surface
            // because GenerateNormals would cancel coincident opposite windings if
            // these shared wallST — see ArchedDoorHead's doc comment.
            var sealST  = DungeonBuilder.MakeST();

            // A stair from an adjacent floor lands ON TOP of this cell's floor
            // slab, it does not emerge THROUGH it: AddStairGeometry builds every
            // tread inside the STAIR's own cell, and the top tread's yHi already
            // reaches exactly yBase + FloorHeight — this cell's floor level — at
            // the stair cell's boundary. This slab IS the landing surface, not a
            // cap over the stairwell. Omitting it (the original plan's premise)
            // opened a hole the player fell through; see JOURNAL.md 2026-08-28
            // for the corrected reasoning. Always emit it, exactly like a
            // corridor cell always emits its own floor.
            AddCellFloor(floorST, cx, cy, yBase);
            // Arch math still spans the GROUP's bounds (group.MinX/MaxX or
            // MinY/MaxY inside AddCellVault) so this cell's slice of vault meets
            // its neighbors at identical heights — only the mesh is per-cell.
            AddCellVault(ceilST, group, cx, cy, yBase);

            foreach (var face in Faces)
            {
                if (!group.IsPerimeterFace(cx, cy, face)) continue;   // interior — stays open
                bool doorway = HasCorridorThrough(group, lookup, cx, cy, face);
                // A stair's PERPENDICULAR-TO-TRAVEL sides are never a doorway
                // (PieceDB gives a stair openings only along its travel axis), so
                // HasCorridorThrough is false here and this would otherwise fall
                // into the solid-wall branch below — but AddStairGeometry already
                // builds its own envelope wall on that exact same boundary plane
                // UNCONDITIONALLY (DungeonBuilder.cs, the wallExt NSWall/EWWall
                // calls in AddStairGeometry), regardless of what's next door. Two
                // independently-built wall quads on the same plane (this room's
                // wallpaper stone vs. the stair's plain stone) z-fight — reported
                // as "wallpaper bleeds into the stairwell" when a stair runs
                // parallel to a room. The stair's envelope wall always spans a
                // full two floors (taller than this room ever needs), so it's
                // safe to just not draw a duplicate here — same fix family as
                // the pit-side bleed in 65035cb, minus the offset (rooms have no
                // per-face thickness to offset; skipping the redundant wall is
                // the minimal equivalent). See test/TestRoomStairBleed.cs.
                if (!doorway && NeighborIsStair(group, lookup, cx, cy, face)) continue;
                AddPerimeterWall(wallST, sealST, group, cx, cy, yBase, face, doorway);
                AddPlinth(floorST, cx, cy, yBase, face, doorway);
            }

            var body = new StaticBody3D { Name = $"Cell_{cx}_{cy}_{group.Floor}" };
            owner.AddChild(body);
            // The "Floor" prefix on the mesh name is load-bearing: DungeonBuilder.
            // AddMesh dispatches material by name.StartsWith("Floor"/"Stair") vs
            // stone — anything not prefixed "Floor"/"Stair" silently gets the wall
            // material. This has already caused one bug; don't rename carelessly.
            owner.AddMesh(body, DungeonBuilder.Commit(floorST), $"FloorRoom_{cx}_{cy}", default);
            owner.AddMesh(body, DungeonBuilder.Commit(wallST),  $"WallRoom_{cx}_{cy}",  default);
            owner.AddMesh(body, DungeonBuilder.Commit(ceilST),  $"CeilRoom_{cx}_{cy}",  default);
            owner.AddMesh(body, DungeonBuilder.Commit(sealST),  $"WallRoomSeal_{cx}_{cy}", default);
        }
    }

    // ── Floor ─────────────────────────────────────────────────────────────────
    // Full 10 m x 10 m slab, unlike a corridor cell which is only OpeningW wide.
    // Adjacent room cells share edges exactly, so the merged floor is seamless.
    static void AddCellFloor(SurfaceTool st, int cx, int cy, float yBase)
    {
        float x0 = cx * CS, z0 = cy * CS;
        float x1 = x0 + CS, z1 = z0 + CS;
        DungeonBuilder.Quad(st, new(x0, yBase, z0), new(x1, yBase, z0),
                                new(x1, yBase, z1), new(x0, yBase, z1));
    }

    // ── Plinth ────────────────────────────────────────────────────────────────
    // A low stone bench running along the inside of each perimeter wall. This is
    // the room's floor "signature" — it instantly separates a room from a corridor
    // without changing anything the player can collide with meaningfully.
    // Skipped across a doorway so you never step over a lip in a threshold.
    static void AddPlinth(SurfaceTool st, int cx, int cy, float yBase, Dir face, bool doorway)
    {
        float x0 = cx * CS, z0 = cy * CS;
        float x1 = x0 + CS, z1 = z0 + CS;
        float xc = x0 + CS * 0.5f, zc = z0 + CS * 0.5f;
        float yTop = yBase + RoomPlinthH;
        float w = RoomPlinthW;

        // Along a doorway face the plinth is split into the two stubs either side of
        // the opening; on a solid face it runs the full 10 m.
        var spans = new List<(float a, float b)>();
        if (doorway)
        {
            if (face == Dir.N || face == Dir.S) { spans.Add((x0, xc - HW)); spans.Add((xc + HW, x1)); }
            else                                { spans.Add((z0, zc - HW)); spans.Add((zc + HW, z1)); }
        }
        else
        {
            spans.Add(face == Dir.N || face == Dir.S ? (x0, x1) : (z0, z1));
        }

        foreach (var (a, b) in spans)
        {
            if (b - a < 0.05f) continue;   // degenerate stub, skip
            switch (face)
            {
                case Dir.N:   // strip along the north edge, extending south into the room
                    Box(st, a, z0, b, z0 + w, yBase, yTop); break;
                case Dir.S:
                    Box(st, a, z1 - w, b, z1, yBase, yTop); break;
                case Dir.W:
                    Box(st, x0, a, x0 + w, b, yBase, yTop); break;
                default:      // Dir.E
                    Box(st, x1 - w, a, x1, b, yBase, yTop); break;
            }
        }
    }

    /// Axis-aligned box, top and four sides. No bottom face — it sits on the floor.
    static void Box(SurfaceTool st, float x0, float z0, float x1, float z1,
                    float y0, float y1)
    {
        DungeonBuilder.Quad(st, new(x0, y1, z0), new(x1, y1, z0),
                                new(x1, y1, z1), new(x0, y1, z1));           // top
        DungeonBuilder.EWWall(st, z0, x0, x1, y0, y1, -1);                    // north side
        DungeonBuilder.EWWall(st, z1, x0, x1, y0, y1, +1);                    // south side
        DungeonBuilder.NSWall(st, x0, z0, z1, y0, y1, -1);                    // west side
        DungeonBuilder.NSWall(st, x1, z0, z1, y0, y1, +1);                    // east side
    }

    // ── Perimeter walls ───────────────────────────────────────────────────────
    // Full cell width (10 m), sealed from the floor to FloorHeight (18 m).
    //
    // The wall must reach FloorHeight, not RoomSpringY: AddCellVault's arch is a
    // function of the GROUP's bounds, not of this one face, so on the faces
    // perpendicular to the vault's run the ceiling reaches RoomPeakY (17.5 m)
    // directly above where a RoomSpringY-tall wall would stop — leaving an
    // unsealed band up to 6.5 m tall across the full 10 m of that face (I1).
    //
    // A doorway removes the middle OpeningW (6 m), and its head is an ARCH matching
    // the corridor beyond rather than a flat RoomDoorH lintel — see ArchedDoorHead
    // for why that is both the look the hallways ask for and the only way the top of
    // the opening actually closes.
    //
    // Both flanks beside a doorway run the wall's full height, split at their own
    // jamb height so the head's end vertices have something to meet (DoorJambY).
    static void AddPerimeterWall(SurfaceTool st, SurfaceTool sealST, RoomGroup group,
                                 int cx, int cy, float yBase,
                                 Dir face, bool doorway)
    {
        float x0 = cx * CS, z0 = cy * CS;
        float x1 = x0 + CS, z1 = z0 + CS;
        float xc = x0 + CS * 0.5f, zc = z0 + CS * 0.5f;
        float y0 = yBase, yWall = yBase + RoomSpringY;
        float yTop = yBase + DungeonBuilder.FloorHeight;

        // One band of wall on this face, between two heights, spanning [a, b] along
        // the face. Degenerate bands are skipped so a jamb landing exactly on an
        // existing split does not emit a zero-height quad.
        void Band(float a, float b, float yLo, float yHi)
        {
            if (yHi - yLo < 0.001f || b - a < 0.001f) return;
            switch (face)
            {
                case Dir.N: DungeonBuilder.EWWall(st, z0, a, b, yLo, yHi, +1); break;
                case Dir.S: DungeonBuilder.EWWall(st, z1, a, b, yLo, yHi, -1); break;
                case Dir.W: DungeonBuilder.NSWall(st, x0, a, b, yLo, yHi, +1); break;
                default:    DungeonBuilder.NSWall(st, x1, a, b, yLo, yHi, -1); break;
            }
        }

        bool  alongX = face == Dir.N || face == Dir.S;
        float fLo = alongX ? x0 : z0;                 // face start
        float fHi = alongX ? x1 : z1;                 // face end
        float oLo = (alongX ? xc : zc) - HW;          // opening start
        float oHi = (alongX ? xc : zc) + HW;          // opening end

        if (!doorway)
        {
            // Solid face: sealed for its whole height, split at RoomSpringY where the
            // vault lands. (The old code emitted the same two bands, as RoomDoorH and
            // RoomSpringY are both 11 m.)
            Band(fLo, fHi, y0, yWall);
            Band(fLo, fHi, yWall, yTop);
            return;
        }

        // Doorway face. Each flank runs the wall's FULL height but is split at ITS OWN
        // jamb height, so the arched head's end vertices meet a matching vertex rather
        // than landing mid-edge — see DoorJambY for why that matters.
        System.Func<float, float, float> ceil = (x, z) => CeilingY(group, x, z, yBase);
        var (jLo, jHi) = DoorJambY(face, cx, cy, yBase, yTop, ceil);

        Band(fLo, oLo, y0, jLo);   Band(fLo, oLo, jLo, yTop);
        Band(oHi, fHi, y0, jHi);   Band(oHi, fHi, jHi, yTop);

        ArchedDoorHead(st, sealST, face, cx, cy, yBase, yTop, ceil);
    }

    /// True when the cell across `face` holds a piece, on this room's floor, whose
    /// opening points back at us. This is the "any entry way that is hitting the
    /// open space is valid" rule: no rotation matching, no piece-type whitelist —
    /// if something points at the room, the room opens a door for it.
    static bool HasCorridorThrough(RoomGroup group,
        Dictionary<(int, int, int), MazePiece> lookup, int cx, int cy, Dir face)
    {
        var (dx, dy) = PieceDB.Delta(face);
        Dir back = PieceDB.Opposite(face);
        if (lookup.TryGetValue((cx + dx, cy + dy, group.Floor), out var nb) &&
            PieceDB.HasSameFloorOpening(nb.Type, nb.Rotation, back))
            return true;

        // A stair on the floor below (up) or above (down) whose CROSS face points
        // at us lands on this room's floor — MazeValidator's cross-floor step.
        // AddStairGeometry leaves that end uncapped, so the room must open too.
        foreach (int off in new[] { -1, 1 })
            if (lookup.TryGetValue((cx + dx, cy + dy, group.Floor + off), out var st) &&
                PieceDB.IsStair(st.Type) &&
                st.Floor + PieceDB.StairFloorDelta(st.Type) == group.Floor &&
                PieceDB.GetStairCrossDir(st.Type, st.Rotation) == back)
                return true;
        return false;
    }

    /// True when the cell across `face` holds ANY stair piece, regardless of its
    /// opening direction. A stair's side (perpendicular-to-travel) faces are
    /// forced walls by design — never a doorway — and AddStairGeometry always
    /// builds its own envelope wall there unconditionally, so the room must not
    /// also build a wall on that same boundary (see the wallpaper-bleed comment
    /// at this method's call site).
    static bool NeighborIsStair(RoomGroup group,
        Dictionary<(int, int, int), MazePiece> lookup, int cx, int cy, Dir face)
    {
        var (dx, dy) = PieceDB.Delta(face);
        return lookup.TryGetValue((cx + dx, cy + dy, group.Floor), out var nb) && PieceDB.IsStair(nb.Type);
    }

    // ── Vault ─────────────────────────────────────────────────────────────────
    // ONE arch profile spans the whole group. Each cell tessellates only its own
    // 10 m slice of that global profile, so adjacent cells meet at identical
    // heights and the vault reads as continuous — including across an L-shape,
    // where a per-cell vault would produce a visible ridge at every seam.
    static void AddCellVault(SurfaceTool st, RoomGroup group, int cx, int cy, float yBase)
    {
        float x0 = cx * CS, z0 = cy * CS;
        float x1 = x0 + CS, z1 = z0 + CS;
        const int N = 12;

        if (group.VaultAlongZ)
        {
            // Barrel runs along Z; the arch is a function of X across the group.
            float gx0 = group.MinX * CS, gx1 = (group.MaxX + 1) * CS;
            for (int i = 0; i < N; i++)
            {
                float xa = x0 + (x1 - x0) * i / N;
                float xb = x0 + (x1 - x0) * (i + 1) / N;
                float ya = ArchY(xa, gx0, gx1, yBase);
                float yb = ArchY(xb, gx0, gx1, yBase);
                // Z-reversed winding → normals face down into the room
                DungeonBuilder.Quad(st, new(xa, ya, z1), new(xb, yb, z1),
                                        new(xb, yb, z0), new(xa, ya, z0));
            }
        }
        else
        {
            // Barrel runs along X; the arch is a function of Z across the group.
            float gz0 = group.MinY * CS, gz1 = (group.MaxY + 1) * CS;
            for (int i = 0; i < N; i++)
            {
                float za = z0 + (z1 - z0) * i / N;
                float zb = z0 + (z1 - z0) * (i + 1) / N;
                float ya = ArchY(za, gz0, gz1, yBase);
                float yb = ArchY(zb, gz0, gz1, yBase);
                // X-reversed winding → normals face down
                DungeonBuilder.Quad(st, new(x1, ya, za), new(x0, ya, za),
                                        new(x0, yb, zb), new(x1, yb, zb));
            }
        }
    }

    // ── Arched doorway heads ──────────────────────────────────────────────────
    //
    // A corridor's opening is NOT a rectangle: it is 6 m wide and rises 0..CellHeight
    // (14 m) flat, then arches to FloorHeight (18 m) at its centre. A room doorway
    // used to be a flat-topped hole RoomDoorH (11 m) tall, so the hallway's vault ran
    // straight into a wall above every threshold.
    //
    // Worse, the panel sealing RoomDoorH..FloorHeight faces INTO the room, and the
    // room's own vault only peaks at RoomPeakY (17.5 m) — half a metre BELOW the
    // corridor's 18 m arch peak. So a lens-shaped sliver of the corridor arch sat
    // above the room's ceiling with nothing but a backface-culled panel in the way:
    // from the corridor you looked straight through it and out of the level. That is
    // the "you can see outside" bug; see JOURNAL.md 2026-09-22 for the measurements.
    //
    // The head now follows the corridor's own vault profile, clipped to whatever
    // ceiling this space actually has at that point, and the strip above it is
    // emitted into a SECOND surface wound the other way so it reads as solid stone
    // from the corridor too.

    /// Tessellation of the arched head across the 6 m opening.
    const int HeadSegs = 12;

    /// How far BELOW the ceiling the head stops when the ceiling is what limits it.
    ///
    /// Vaults are rendered as chords between sample points, which sag a few mm under
    /// the true parabola this clip is computed from. Landing the head exactly on the
    /// analytic curve therefore leaves a hairline sliver between the wall and the
    /// ceiling MESH — measurably so: it was still leaking 6 void pixels per frame.
    /// Sinking the head slightly makes the wall overlap the ceiling instead of
    /// kissing it. Only applied to the ceiling clip: where the CORRIDOR arch is the
    /// limit, the head must stay exact so it meets the corridor's vault chords
    /// vertex-for-vertex (both tessellate the same span into HeadSegs steps).
    const float HeadCeilMargin = 0.12f;

    /// Top of the opening at parameter `t` across the doorway: the corridor's own
    /// vault profile, but never above `ceilY` — where the corridor arch would rise
    /// above our ceiling there is no space to open into, so the head stops there and
    /// the strip above it becomes the seal.
    static float HeadY(float t, float yBase, float ceilY)
        => Mathf.Min(yBase + DungeonBuilder.VaultY(t, DungeonBuilder.CellHeight),
                     ceilY - HeadCeilMargin);

    /// The vault's height at a world point in this group — mirrors AddCellVault's own
    /// ArchY call so a doorway head is clipped to the ceiling genuinely above it.
    internal static float CeilingY(RoomGroup group, float x, float z, float yBase)
        => group.VaultAlongZ
            ? ArchY(x, group.MinX * CS, (group.MaxX + 1) * CS, yBase)
            : ArchY(z, group.MinY * CS, (group.MaxY + 1) * CS, yBase);

    /// Builds the wall ABOVE a doorway as an arch matching the corridor beyond it.
    ///
    /// `ceilAt(x, z)` is this space's ceiling height at a point along the opening —
    /// the room's vault, or the pit's cap / next floor level.
    ///
    /// Emits the SAME strips into two surface tools wound opposite ways:
    ///   `inward` — the face seen from inside the room/shaft.
    ///   `seal`   — the face seen from the CORRIDOR, which is what stops the void
    ///              showing through wherever the corridor arch outruns our ceiling.
    /// They are coplanar but face opposite directions, so exactly one is ever
    /// rasterised and they cannot z-fight. They MUST go in separate meshes:
    /// DungeonBuilder.Commit calls SurfaceTool.GenerateNormals, which averages
    /// normals across coincident vertices within one surface — double-winding a quad
    /// into a single tool cancels its normal to zero and lights it black.
    /// Where a doorway sits on one face: whether the opening runs along X, the span
    /// it covers, the wall's fixed coordinate, and which way the inward face points
    /// (same sign convention as EWWall/NSWall).
    static (bool alongX, float lo, float hi, float fix, int sign)
        DoorSpan(Dir face, int cx, int cy)
    {
        float x0 = cx * CS, z0 = cy * CS;
        float x1 = x0 + CS, z1 = z0 + CS;
        float xc = x0 + CS * 0.5f, zc = z0 + CS * 0.5f;
        bool alongX = face == Dir.N || face == Dir.S;
        return (alongX,
                alongX ? xc - HW : zc - HW,
                alongX ? xc + HW : zc + HW,
                face switch { Dir.N => z0, Dir.S => z1, Dir.W => x0, _ => x1 },
                face switch { Dir.N => +1, Dir.S => -1, Dir.W => +1, _ => -1 });
    }

    /// The head's height at the two JAMBS — the ends of the opening.
    ///
    /// The flanking wall beside a doorway MUST be split at exactly these heights. The
    /// head's end vertices land here, and a flank whose edge carries no vertex at that
    /// height is a T-junction, which rasterises as a one-pixel crack straight out of
    /// the level. That is not theoretical: with the flanks split at RoomSpringY
    /// instead, the sweep in test/TestRoomArchSeal.tscn still leaked 1-2 stray void
    /// pixels per frame at grazing angles.
    internal static (float lo, float hi) DoorJambY(Dir face, int cx, int cy,
                                                   float yBase, float yTop,
                                                   System.Func<float, float, float> ceilAt)
    {
        var (alongX, lo, hi, fix, _) = DoorSpan(face, cx, cy);
        float YAt(float t, float v) =>
            Mathf.Clamp(HeadY(t, yBase, alongX ? ceilAt(v, fix) : ceilAt(fix, v)), yBase, yTop);
        return (YAt(0f, lo), YAt(1f, hi));
    }

    internal static void ArchedDoorHead(SurfaceTool inward, SurfaceTool? seal,
                                        Dir face, int cx, int cy,
                                        float yBase, float yTop,
                                        System.Func<float, float, float> ceilAt)
    {
        var (alongX, lo, hi, fix, sign) = DoorSpan(face, cx, cy);

        for (int i = 0; i < HeadSegs; i++)
        {
            float ta = (float)i / HeadSegs, tb = (float)(i + 1) / HeadSegs;
            float va = Mathf.Lerp(lo, hi, ta), vb = Mathf.Lerp(lo, hi, tb);
            float ya = HeadY(ta, yBase, alongX ? ceilAt(va, fix) : ceilAt(fix, va));
            float yb = HeadY(tb, yBase, alongX ? ceilAt(vb, fix) : ceilAt(fix, vb));
            // Clamp to the wall's own band: a very low ceiling could otherwise drive
            // the head below the floor and invert the strip.
            ya = Mathf.Clamp(ya, yBase, yTop);
            yb = Mathf.Clamp(yb, yBase, yTop);
            // The head already reaches the top of the wall here — no strip to build.
            if (ya >= yTop - 0.01f && yb >= yTop - 0.01f) continue;

            void Emit(SurfaceTool st, int s)
            {
                if (alongX)
                {
                    if (s > 0) DungeonBuilder.Quad(st, new(vb, yb, fix), new(va, ya, fix),
                                                       new(va, yTop, fix), new(vb, yTop, fix));
                    else       DungeonBuilder.Quad(st, new(va, ya, fix), new(vb, yb, fix),
                                                       new(vb, yTop, fix), new(va, yTop, fix));
                }
                else
                {
                    if (s > 0) DungeonBuilder.Quad(st, new(fix, ya, va), new(fix, yb, vb),
                                                       new(fix, yTop, vb), new(fix, yTop, va));
                    else       DungeonBuilder.Quad(st, new(fix, yb, vb), new(fix, ya, va),
                                                       new(fix, yTop, va), new(fix, yTop, vb));
                }
            }

            Emit(inward, sign);
            if (seal != null) Emit(seal, -sign);
        }
    }

    /// Parabolic arch height at world coordinate `v`, spanning [v0, v1].
    /// Peak at the span's centre, springing down to RoomSpringY at both edges.
    static float ArchY(float v, float v0, float v1, float yBase)
    {
        float half = (v1 - v0) * 0.5f;
        if (half <= 0.001f) return yBase + RoomPeakY;
        float t = (v - (v0 + half)) / half;             // -1 at one edge, +1 at the other
        t = Mathf.Clamp(t, -1f, 1f);
        return yBase + RoomPeakY - (RoomPeakY - RoomSpringY) * t * t;
    }
}
