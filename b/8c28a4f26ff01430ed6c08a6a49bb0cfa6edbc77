using Godot;

/// HUD: red HP bar (top-centre) + self-updating stamina donut ring (bottom-centre).
/// Attached as child of PlayerController; siblings are found by type, not name.
public partial class PlayerHUD : CanvasLayer
{
    const float BarW = 360f;
    const float BarH = 20f;
    const float PadY = 18f;

    ColorRect     _hpFill    = null!;
    ColorRect?    _hitFlash;
    float         _hitFlashTimer = 0f;
    const float   HitFlashDur    = 0.40f;
    PlayerHealth? _health;

    public override void _Ready()
    {
        Layer = 10;

        var root = new Control { Name = "HUDRoot" };
        root.SetAnchorsPreset(Control.LayoutPreset.FullRect);
        AddChild(root);

        // ── HP bar — top-centre, red, no outline ─────────────────────────────
        // Dim red track shows the "empty" portion
        var hpBack = new ColorRect { Color = new Color(0.7f, 0.05f, 0.05f, 0.25f) };
        hpBack.AnchorLeft     = 0.5f;
        hpBack.AnchorRight    = 0.5f;
        hpBack.AnchorTop      = 0f;
        hpBack.AnchorBottom   = 0f;
        hpBack.GrowHorizontal = Control.GrowDirection.Both;
        hpBack.OffsetLeft     = -BarW / 2f;
        hpBack.OffsetRight    =  BarW / 2f;
        hpBack.OffsetTop      =  PadY;
        hpBack.OffsetBottom   =  PadY + BarH;
        root.AddChild(hpBack);

        _hpFill = new ColorRect
        {
            Position = Vector2.Zero,
            Size     = new Vector2(BarW, BarH),
            Color    = new Color(0.88f, 0.12f, 0.12f, 1f),
        };
        hpBack.AddChild(_hpFill);

        // ── Hit vignette — full-screen red flash on taking damage ─────────────
        _hitFlash = new ColorRect
        {
            Color       = new Color(0.85f, 0f, 0f, 0f),
            MouseFilter = Control.MouseFilterEnum.Ignore,
        };
        _hitFlash.SetAnchorsPreset(Control.LayoutPreset.FullRect);
        root.AddChild(_hitFlash);

        // ── Reload ring — bottom-centre, hidden unless reloading ──────────────
        var ring = new StaminaRing();
        ring.AnchorLeft     = 0.5f;
        ring.AnchorRight    = 0.5f;
        ring.AnchorTop      = 1.0f;
        ring.AnchorBottom   = 1.0f;
        ring.GrowHorizontal = Control.GrowDirection.Both;
        ring.GrowVertical   = Control.GrowDirection.Begin;
        ring.OffsetLeft     = -44f;
        ring.OffsetRight    =  44f;
        ring.OffsetTop      = -126f;
        ring.OffsetBottom   =  -38f;
        root.AddChild(ring);

        // ── Crosshair — its gap tracks live spread, so the accuracy/speed
        // tradeoff is visible at all times instead of being an invisible stat ──
        var cross = new SpreadCrosshair();
        cross.SetAnchorsPreset(Control.LayoutPreset.FullRect);
        cross.MouseFilter = Control.MouseFilterEnum.Ignore;
        root.AddChild(cross);

        // ── Ammo counter — bottom-right ───────────────────────────────────────
        _ammoLabel = new Label
        {
            Text                = "",
            HorizontalAlignment = HorizontalAlignment.Right,
        };
        _ammoLabel.AnchorLeft     = 1f;
        _ammoLabel.AnchorRight    = 1f;
        _ammoLabel.AnchorTop      = 1f;
        _ammoLabel.AnchorBottom   = 1f;
        _ammoLabel.GrowHorizontal = Control.GrowDirection.Begin;
        _ammoLabel.GrowVertical   = Control.GrowDirection.Begin;
        _ammoLabel.OffsetLeft     = -260f;
        _ammoLabel.OffsetRight    =  -28f;
        _ammoLabel.OffsetTop      =  -84f;
        _ammoLabel.OffsetBottom   =  -28f;
        _ammoLabel.AddThemeFontSizeOverride("font_size", 34);
        _ammoLabel.AddThemeColorOverride("font_color", new Color(0.95f, 0.93f, 0.85f, 0.92f));
        root.AddChild(_ammoLabel);
    }

    Label?     _ammoLabel;
    GunCombat? _gun;

    public void TriggerHitFlash()
    {
        _hitFlashTimer = HitFlashDur;
        if (_hitFlash != null) _hitFlash.Color = new Color(0.85f, 0f, 0f, 0.50f);
    }

    public override void _Process(double delta)
    {
        // Resolve PlayerHealth by type — immune to node-name changes
        if (_health == null)
        {
            var parent = GetParent();
            if (parent != null)
                foreach (var child in parent.GetChildren())
                    if (child is PlayerHealth ph) { _health = ph; break; }
        }

        if (_health != null)
        {
            float frac = Mathf.Clamp(_health.CurrentHealth / PlayerHealth.MaxHealth, 0f, 1f);
            _hpFill.Size = new Vector2(BarW * frac, BarH);
        }

        if (_hitFlash != null && _hitFlashTimer > 0f)
        {
            _hitFlashTimer -= (float)delta;
            float alpha = Mathf.Clamp(_hitFlashTimer / HitFlashDur * 0.50f, 0f, 0.50f);
            _hitFlash.Color = new Color(0.85f, 0f, 0f, alpha);
        }

        // ── Ammo readout ──────────────────────────────────────────────────────
        if (_gun == null && GetParent() is Node parent2)
            foreach (var child in parent2.GetChildren())
                if (child is GunCombat gc) { _gun = gc; break; }

        if (_ammoLabel != null && _gun != null)
        {
            _ammoLabel.Text = _gun.IsReloading
                ? "RELOADING"
                : $"{_gun.Ammo} / {_gun.MagSize}";
            // Flash red when the mag is dry so the empty state is unmissable.
            _ammoLabel.AddThemeColorOverride("font_color",
                _gun.IsEmpty ? new Color(1f, 0.25f, 0.18f, 0.95f)
                             : new Color(0.95f, 0.93f, 0.85f, 0.92f));
        }
    }
}

/// Crosshair whose gap is driven by GunCombat's live spread. Standing still
/// closes it to a tight cross; sprinting or jumping blows it wide open. This is
/// the entire accuracy mechanic made visible — no tutorial needed.
public partial class SpreadCrosshair : Control
{
    GunCombat? _gun;

    public override void _Process(double delta)
    {
        if (_gun == null)
        {
            // StaminaRing walks Control → CanvasLayer → PlayerController; this
            // control sits at the same depth, so use the same walk.
            var playerCtrl = GetParent()?.GetParent();
            if (playerCtrl != null)
                foreach (var child in playerCtrl.GetChildren())
                    if (child is GunCombat gc) { _gun = gc; break; }
        }
        QueueRedraw();
    }

    public override void _Draw()
    {
        var center = Size / 2f;
        var s      = GameSettings.Instance;

        // Player-configurable base shape (Settings → RETICLE).
        float baseGap = s?.ReticleGap   ?? 5f;
        float len     = s?.ReticleSize  ?? 9f;
        float thick   = s?.ReticleThick ?? 2f;
        var   userCol = s?.ReticleColor ?? new Color(1f, 1f, 1f, 0.75f);
        bool  dot     = s?.ReticleCenterDot ?? true;

        // Live spread on top of the base gap. 1° ≈ 14 px is a readable slope
        // across the 0.05°–14° range the guns actually use. This part is NOT
        // configurable — it is the accuracy mechanic being shown, not decoration.
        float spread = _gun?.SpreadDegrees ?? 1f;
        float gap    = baseGap + spread * 14f;

        // Empty magazine overrides the chosen colour — you must not miss this.
        var col = _gun != null && _gun.IsEmpty
                ? new Color(1f, 0.3f, 0.2f, 0.9f)
                : userCol;

        // Four ticks around a hollow centre — the classic dynamic reticle.
        DrawLine(center + new Vector2(-gap - len, 0), center + new Vector2(-gap, 0), col, thick);
        DrawLine(center + new Vector2( gap,       0), center + new Vector2( gap + len, 0), col, thick);
        DrawLine(center + new Vector2(0, -gap - len), center + new Vector2(0, -gap), col, thick);
        DrawLine(center + new Vector2(0,  gap),       center + new Vector2(0,  gap + len), col, thick);

        // Centre dot — the actual first-bullet point of aim.
        if (dot) DrawCircle(center, Mathf.Max(thick * 0.75f, 1f), col);
    }
}

/// Donut-style RELOAD ring. Hidden while idle; appears the moment a reload starts
/// and sweeps 0→1 over the gun's real reload duration, so how long you are
/// defenceless is visible rather than guessed. Finds its own GunCombat by walking
/// up the tree and redraws every frame — no external push needed.
public partial class StaminaRing : Control
{
    const float Radius    = 34f;
    const float Thickness =  9f;
    const int   Points    = 64;

    GunCombat? _combat;

    public override void _Process(double delta)
    {
        // Walk: StaminaRing → HUDRoot (Control) → PlayerHUD (CanvasLayer) → PlayerController
        if (_combat == null)
        {
            var playerCtrl = GetParent()?.GetParent()?.GetParent();
            if (playerCtrl != null)
                foreach (var child in playerCtrl.GetChildren())
                    if (child is GunCombat gc) { _combat = gc; break; }
        }
        QueueRedraw();
    }

    public override void _Draw()
    {
        // Reload progress fills the ring; it reads 0 whenever we are not
        // reloading, and the early-out below keeps the ring invisible then.
        float used      = _combat?.ReloadProgress ?? 0f;
        bool  exhausted = _combat?.IsEmpty ?? false;

        // Use a fixed centre so the ring draws correctly even if Size hasn't
        // been resolved yet by the layout engine.
        var center = new Vector2(44f, 44f);

        // The ring exists ONLY during a reload — no idle chrome on screen. The
        // moment it appears you know you are vulnerable, and its sweep tells you
        // for exactly how much longer.
        if (_combat == null || !_combat.IsReloading) return;

        // Faint full track shows the target the sweep is filling toward.
        DrawArc(center, Radius,
                -Mathf.Pi / 2f, -Mathf.Pi / 2f + Mathf.Tau,
                Points, new Color(1f, 1f, 1f, 0.14f), Thickness, true);

        float endAngle = -Mathf.Pi / 2f + Mathf.Tau * Mathf.Clamp(used, 0f, 1f);
        // Amber while reloading, hot red if the reload was forced by a dry mag.
        Color col = exhausted
            ? new Color(1.0f, 0.40f, 0.15f, 0.95f)
            : new Color(0.96f, 0.88f, 0.60f, 0.85f);

        DrawArc(center, Radius,
                -Mathf.Pi / 2f, endAngle,
                Points, col, Thickness, true);
    }
}
