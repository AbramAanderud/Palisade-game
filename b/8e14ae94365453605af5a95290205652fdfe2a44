        var row = new HBoxContainer { MouseFilter = MouseFilterEnum.Ignore };
        row.AddThemeConstantOverride("separation", 9);
        AddChild(row);

        // Icon (with a "?" fallback for the unclaimed primary slot)
        var iconWrap = new Control
        {
            CustomMinimumSize = new Vector2(86, 48),
            MouseFilter       = MouseFilterEnum.Ignore,
        };
        _icon = new GunSlotIcon();
        _icon.SetAnchorsPreset(Control.LayoutPreset.FullRect);
        iconWrap.AddChild(_icon);
        _qmark = new Label
        {
            Text                = "?",
            HorizontalAlignment = HorizontalAlignment.Center,
            VerticalAlignment   = VerticalAlignment.Center,
        };
        _qmark.SetAnchorsPreset(Control.LayoutPreset.FullRect);
        _qmark.AddThemeFontSizeOverride("font_size", 26);
        _qmark.AddThemeColorOverride("font_color", new Color(1f, 1f, 1f, 0.35f));
        iconWrap.AddChild(_qmark);
        row.AddChild(iconWrap);

        // Slot label over gun name
        var col = new VBoxContainer
        {
            SizeFlagsHorizontal = SizeFlags.ExpandFill,
            Alignment           = BoxContainer.AlignmentMode.Center,
            MouseFilter         = MouseFilterEnum.Ignore,
        };
        col.AddThemeConstantOverride("separation", 0);
        var slotLbl = new Label { Text = _slotName };
        slotLbl.AddThemeFontSizeOverride("font_size", 11);
        slotLbl.AddThemeColorOverride("font_color", new Color(0.62f, 0.60f, 0.52f, 0.85f));
        col.AddChild(slotLbl);
