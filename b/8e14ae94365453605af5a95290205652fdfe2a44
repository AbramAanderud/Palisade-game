/// Bottom-right loadout readout: PRIMARY (arena prize) over SECONDARY (spawn
/// roll), each with a live 3D icon of the gun. The held slot is gold-framed and
/// full-bright, the holstered one dimmed with its remembered mag count; before
/// the prize is claimed the primary card sits as a dim "IN THE MIDDLE" teaser so
/// the goal is on screen from the first second.
public partial class WeaponSlotsPanel : VBoxContainer
{
    WeaponSlotCard _primary   = null!;
    WeaponSlotCard _secondary = null!;
    Label          _hint      = null!;

    public override void _Ready()
    {
        Alignment   = AlignmentMode.End;
        MouseFilter = MouseFilterEnum.Ignore;
        AddThemeConstantOverride("separation", 6);

        _primary   = new WeaponSlotCard("PRIMARY");
        _secondary = new WeaponSlotCard("SECONDARY");
        AddChild(_primary);
        AddChild(_secondary);

        _hint = new Label
        {
            Text                = "TAB — SWAP WEAPON",
            HorizontalAlignment = HorizontalAlignment.Right,
            Visible             = false,
        };
        _hint.AddThemeFontSizeOverride("font_size", 11);
        _hint.AddThemeColorOverride("font_color", new Color(0.75f, 0.72f, 0.62f, 0.55f));
        AddChild(_hint);
    }

    public void UpdateFrom(PlayerController pc, GunCombat gun)
    {
        string held = gun.Def.Id;
        bool primaryHeld = pc.PrimaryGunId == held;
        _primary.Update(pc.PrimaryGunId, primaryHeld,
                        pc.PrimaryGunId is string p ? gun.StoredAmmo(p) : 0);
        _secondary.Update(pc.SecondaryGunId, !primaryHeld && pc.SecondaryGunId == held,
                          pc.SecondaryGunId is string s ? gun.StoredAmmo(s) : 0);
        _hint.Visible = pc.HasBothGuns;
    }
}

