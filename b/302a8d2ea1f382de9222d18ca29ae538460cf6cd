using Godot;
using System.Collections.Generic;

/// The one place the crosshair is drawn.
///
/// SpreadCrosshair (in game) and ReticlePreview (in Settings → Reticle) used to
/// carry two hand-copied versions of the same draw code, which is exactly how a
/// settings preview ends up lying about what you will actually see. Both now call
/// this, so the preview is the renderer.
///
/// Deliberately NOT implemented: CS:GO's "follow recoil". That option exists
/// because CS:GO keeps the crosshair at screen centre while aim punch offsets the
/// real bullet direction. Here PlayerController.ApplyRecoil kicks the look angles
/// themselves, so the crosshair is already the true point of aim on every shot and
/// the toggle would do nothing.
public static class ReticleRenderer
{
    /// Pixels of gap added per degree of weapon spread. 1° ≈ 14 px reads well
    /// across the 0.05°–14° range the guns actually produce. This is the accuracy
    /// mechanic being shown, so it is not player-configurable — only how much of
    /// it the chosen style lets through.
    public const float PixelsPerDegree = 14f;

    /// Classic style shows spread at half weight: it still breathes when you move,
    /// but nothing like the full dynamic swing.
    const float ClassicSpreadScale = 0.5f;

    static readonly Color EmptyMagColor = new(1f, 0.3f, 0.2f, 1f);

    /// <param name="ci">Canvas to draw on (the crosshair Control or the preview).</param>
    /// <param name="center">Centre point in that canvas's local space.</param>
    /// <param name="spreadDegrees">Live weapon spread; ignored by the Static style.</param>
    /// <param name="empty">True when the magazine is dry — overrides the chosen
    /// colour with red, because missing that is worse than a custom colour.</param>
    public static void Draw(CanvasItem ci, Vector2 center, float spreadDegrees, bool empty)
    {
        var s = GameSettings.Instance;

        float len     = s?.ReticleSize  ?? 9f;
        float thick   = Mathf.Max(s?.ReticleThick ?? 2f, 1f);
        float baseGap = s?.ReticleGap   ?? 5f;
        var   mode    = s?.ReticleStyle ?? GameSettings.ReticleStyleMode.Dynamic;

        float gap = mode switch
        {
            GameSettings.ReticleStyleMode.Static  => baseGap,
            GameSettings.ReticleStyleMode.Classic => baseGap + spreadDegrees * PixelsPerDegree * ClassicSpreadScale,
            _                                     => baseGap + spreadDegrees * PixelsPerDegree,
        };

        // Colour carries RGB only; alpha comes from the separate alpha setting so
        // the swatches stay comparable and "use alpha" can be switched off wholesale.
        var  rgb   = s?.ReticleColor ?? new Color(1f, 1f, 1f, 1f);
        float alpha = (s?.ReticleUseAlpha ?? true) ? (s?.ReticleAlpha ?? 0.85f) : 1f;
        var  col   = empty
            ? new Color(EmptyMagColor.R, EmptyMagColor.G, EmptyMagColor.B, alpha)
            : new Color(rgb.R, rgb.G, rgb.B, alpha);

        bool  tStyle    = s?.ReticleTStyle       ?? false;
        bool  dot       = s?.ReticleCenterDot    ?? true;
        bool  outline   = s?.ReticleOutline      ?? true;
        float outThick  = s?.ReticleOutlineThick ?? 1f;

        // T-style drops the top arm, leaving the area above the aim point clear.
        var arms = new List<(Vector2 A, Vector2 B)>
        {
            (center + new Vector2(-gap - len, 0), center + new Vector2(-gap, 0)),
            (center + new Vector2( gap,       0), center + new Vector2( gap + len, 0)),
            (center + new Vector2(0,  gap),       center + new Vector2(0,  gap + len)),
        };
        if (!tStyle)
            arms.Add((center + new Vector2(0, -gap - len), center + new Vector2(0, -gap)));

        // Outline is a fatter black pass UNDER the arms, drawn first. This is what
        // keeps a light reticle readable against a light wall or a muzzle flash.
        if (outline && outThick > 0f)
        {
            var outCol = new Color(0f, 0f, 0f, alpha);
            float ot   = thick + outThick * 2f;
            foreach (var (a, b) in arms) ci.DrawLine(a, b, outCol, ot);
        }

        foreach (var (a, b) in arms) ci.DrawLine(a, b, col, thick);

        if (dot)
        {
            float r = Mathf.Max(thick * 0.75f, 1f);
            if (outline && outThick > 0f)
                ci.DrawCircle(center, r + outThick, new Color(0f, 0f, 0f, alpha));
            ci.DrawCircle(center, r, col);
        }
    }
}
